0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/style/IconImageCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/Builder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/PolygonBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/ImageBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/LineStringBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/format/FormatType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/TextBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/renderer/Layer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/Immediate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/Disposable.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/BuilderType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/pointer/EventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/events/KeyCode.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/structs/PriorityQueue.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/OverlayPositioning.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/TileState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/Overlay.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/MultiPoint.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/MultiLineString.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/Circle.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/MultiPolygon.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/LineString.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/flat/interpolate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/flat/center.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:21:30] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/interaction/Modify.js b/src/ol/interaction/Modify.js\nindex 117340865..12016a4e1 100644\n--- a/src/ol/interaction/Modify.js\n+++ b/src/ol/interaction/Modify.js\n@@ -717,9 +717,30 @@ class Modify extends PointerInteraction {\n   writeGeometryCollectionGeometry_(feature, geometry) {\n     const geometries = geometry.getGeometriesArray();\n     for (let i = 0; i < geometries.length; ++i) {\n-      const geometry = geometries[i];\n-      const writer = this.SEGMENT_WRITERS_[geometry.getType()];\n-      writer(feature, geometry);\n+      const subGeometry = geometries[i];\n+      const writer = this.SEGMENT_WRITERS_[subGeometry.getType()];\n+      if (writer) {\n+        // Create a temporary writer that adds depth information for GeometryCollection\n+        const originalWriter = writer;\n+        const geometryCollectionWriter = (feature, subGeom) => {\n+          // Temporarily override the rBush insert to add depth information\n+          const originalInsert = this.rBush_.insert.bind(this.rBush_);\n+          this.rBush_.insert = (extent, segmentData) => {\n+            // Add GeometryCollection depth information\n+            segmentData.depth = segmentData.depth ? [i, ...segmentData.depth] : [i];\n+            segmentData.geometry = geometry; // Reference the parent GeometryCollection\n+            originalInsert(extent, segmentData);\n+          };\n+          \n+          // Call the original writer\n+          originalWriter(feature, subGeom);\n+          \n+          // Restore the original insert method\n+          this.rBush_.insert = originalInsert;\n+        };\n+        \n+        geometryCollectionWriter(feature, subGeometry);\n+      }\n     }\n   }\n \n@@ -861,6 +882,50 @@ class Modify extends PointerInteraction {\n             this.changingFeature_ = false;\n           }\n           break;\n+        case GeometryType.GEOMETRY_COLLECTION:\n+          const geometries = geometry.getGeometriesArray();\n+          const subGeometry = geometries[depth[0]];\n+          const subGeometryType = subGeometry.getType();\n+          \n+          // Handle the sub-geometry based on its type\n+          switch (subGeometryType) {\n+            case GeometryType.POLYGON:\n+              coordinates = subGeometry.getCoordinates();\n+              coordinates[depth[1]][segmentData.index + index] = vertex;\n+              segment[index] = vertex;\n+              break;\n+            case GeometryType.LINE_STRING:\n+              coordinates = subGeometry.getCoordinates();\n+              coordinates[segmentData.index + index] = vertex;\n+              segment[index] = vertex;\n+              break;\n+            case GeometryType.POINT:\n+              coordinates = vertex;\n+              segment[0] = vertex;\n+              segment[1] = vertex;\n+              break;\n+            case GeometryType.MULTI_POINT:\n+              coordinates = subGeometry.getCoordinates();\n+              coordinates[segmentData.index] = vertex;\n+              segment[0] = vertex;\n+              segment[1] = vertex;\n+              break;\n+            case GeometryType.MULTI_LINE_STRING:\n+              coordinates = subGeometry.getCoordinates();\n+              coordinates[depth[1]][segmentData.index + index] = vertex;\n+              segment[index] = vertex;\n+              break;\n+            case GeometryType.MULTI_POLYGON:\n+              coordinates = subGeometry.getCoordinates();\n+              coordinates[depth[2]][depth[1]][segmentData.index + index] = vertex;\n+              segment[index] = vertex;\n+              break;\n+          }\n+          \n+          if (coordinates) {\n+            this.setGeometryCoordinates_(subGeometry, coordinates);\n+          }\n+          break;\n         default:\n         // pass\n       }\n@@ -1151,6 +1216,36 @@ class Modify extends PointerInteraction {\n         coordinates = geometry.getCoordinates();\n         coordinates.splice(index + 1, 0, vertex);\n         break;\n+      case GeometryType.GEOMETRY_COLLECTION:\n+        const geometries = geometry.getGeometriesArray();\n+        const subGeometry = geometries[depth[0]];\n+        const subGeometryType = subGeometry.getType();\n+        \n+        switch (subGeometryType) {\n+          case GeometryType.MULTI_LINE_STRING:\n+            coordinates = subGeometry.getCoordinates();\n+            coordinates[depth[1]].splice(index + 1, 0, vertex);\n+            break;\n+          case GeometryType.POLYGON:\n+            coordinates = subGeometry.getCoordinates();\n+            coordinates[depth[1]].splice(index + 1, 0, vertex);\n+            break;\n+          case GeometryType.MULTI_POLYGON:\n+            coordinates = subGeometry.getCoordinates();\n+            coordinates[depth[2]][depth[1]].splice(index + 1, 0, vertex);\n+            break;\n+          case GeometryType.LINE_STRING:\n+            coordinates = subGeometry.getCoordinates();\n+            coordinates.splice(index + 1, 0, vertex);\n+            break;\n+          default:\n+            return;\n+        }\n+        \n+        if (coordinates) {\n+          this.setGeometryCoordinates_(subGeometry, coordinates);\n+        }\n+        return;\n       default:\n         return;\n     }\n@@ -1287,6 +1382,51 @@ class Modify extends PointerInteraction {\n             }\n           }\n           break;\n+        case GeometryType.GEOMETRY_COLLECTION:\n+          const geometries = geometry.getGeometriesArray();\n+          const subGeometry = geometries[segmentData.depth[0]];\n+          const subGeometryType = subGeometry.getType();\n+          coordinates = subGeometry.getCoordinates();\n+          component = coordinates;\n+          \n+          switch (subGeometryType) {\n+            case GeometryType.MULTI_LINE_STRING:\n+              if (coordinates[segmentData.depth[1]].length > 2) {\n+                coordinates[segmentData.depth[1]].splice(index, 1);\n+                deleted = true;\n+              }\n+              break;\n+            case GeometryType.LINE_STRING:\n+              if (coordinates.length > 2) {\n+                coordinates.splice(index, 1);\n+                deleted = true;\n+              }\n+              break;\n+            case GeometryType.MULTI_POLYGON:\n+              component = component[segmentData.depth[2]];\n+            /* falls through */\n+            case GeometryType.POLYGON:\n+              component = component[segmentData.depth[1]];\n+              if (component.length > 4) {\n+                if (index == component.length - 1) {\n+                  index = 0;\n+                }\n+                component.splice(index, 1);\n+                deleted = true;\n+                if (index === 0) {\n+                  // close the ring again\n+                  component.pop();\n+                  component.push(component[0]);\n+                  newIndex = component.length - 1;\n+                }\n+              }\n+              break;\n+          }\n+          \n+          if (deleted) {\n+            this.setGeometryCoordinates_(subGeometry, coordinates);\n+          }\n+          break;\n         default:\n         // pass\n       }\ndiff --git a/test/spec/ol/interaction/modify_geometry_collection.test.js b/test/spec/ol/interaction/modify_geometry_collection.test.js\nnew file mode 100644\nindex 000000000..6ad8ac583\n--- /dev/null\n+++ b/test/spec/ol/interaction/modify_geometry_collection.test.js\n@@ -0,0 +1,192 @@\n+import Collection from '../../../../src/ol/Collection.js';\n+import Feature from '../../../../src/ol/Feature.js';\n+import Polygon from '../../../../src/ol/geom/Polygon.js';\n+import GeometryCollection from '../../../../src/ol/geom/GeometryCollection.js';\n+import Modify from '../../../../src/ol/interaction/Modify.js';\n+\n+describe('ol.interaction.Modify GeometryCollection', function () {\n+  \n+  it('should create segment data for GeometryCollection with proper depth tracking', function () {\n+    // Create two polygons that share a vertex at [10, 10]\n+    const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+    const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+    const polygon1 = new Polygon(polygon1Coords);\n+    const polygon2 = new Polygon(polygon2Coords);\n+    const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+    \n+    const featureWithGeometryCollection = new Feature({\n+      geometry: geometryCollection\n+    });\n+\n+    const modify = new Modify({\n+      features: new Collection([featureWithGeometryCollection])\n+    });\n+\n+    // Check the RBush entries for GeometryCollection\n+    const rbushEntries = modify.rBush_.getAll();\n+    \n+    // Should have segments for both polygons\n+    expect(rbushEntries.length).to.be.greaterThan(0);\n+    \n+    // All segments should reference the GeometryCollection, not individual polygons\n+    rbushEntries.forEach(entry => {\n+      expect(entry.geometry).to.be(geometryCollection);\n+      expect(entry.feature).to.be(featureWithGeometryCollection);\n+      expect(entry.depth).to.be.an('array');\n+      expect(entry.depth.length).to.be.greaterThan(0);\n+    });\n+    \n+    // Look for segments that contain the shared vertex [10, 10]\n+    const sharedVertex = [10, 10];\n+    const segmentsWithSharedVertex = rbushEntries.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+    \n+    // Should find segments with the shared vertex from both polygons\n+    expect(segmentsWithSharedVertex.length).to.be.greaterThan(1);\n+  });\n+\n+  it('should handle coordinate modification for GeometryCollection', function () {\n+    // Create two polygons that share a vertex at [10, 10]\n+    const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+    const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+    const polygon1 = new Polygon(polygon1Coords);\n+    const polygon2 = new Polygon(polygon2Coords);\n+    const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+    \n+    const featureWithGeometryCollection = new Feature({\n+      geometry: geometryCollection\n+    });\n+\n+    const modify = new Modify({\n+      features: new Collection([featureWithGeometryCollection])\n+    });\n+\n+    // Get the original coordinates\n+    const originalCoords1 = polygon1.getCoordinates()[0].slice();\n+    const originalCoords2 = polygon2.getCoordinates()[0].slice();\n+\n+    // Find segments with the shared vertex [10, 10]\n+    const rbushEntries = modify.rBush_.getAll();\n+    const sharedVertex = [10, 10];\n+    const segmentsWithSharedVertex = rbushEntries.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+\n+    expect(segmentsWithSharedVertex.length).to.be.greaterThan(0);\n+\n+    // Simulate dragging the shared vertex to a new position\n+    const newVertex = [15, 15];\n+    \n+    // Set up dragSegments_ as if we're dragging\n+    modify.dragSegments_ = [];\n+    segmentsWithSharedVertex.forEach(segmentData => {\n+      const segment = segmentData.segment;\n+      if (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) {\n+        modify.dragSegments_.push([segmentData, 0]);\n+      } else if (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]) {\n+        modify.dragSegments_.push([segmentData, 1]);\n+      }\n+    });\n+\n+    // Simulate the drag event\n+    const mockEvent = {\n+      coordinate: newVertex,\n+      map: {\n+        getView: () => ({\n+          getProjection: () => 'EPSG:4326'\n+        })\n+      }\n+    };\n+\n+    // This should not throw an error and should modify the coordinates\n+    modify.handleDragEvent(mockEvent);\n+\n+    // Check that the coordinates were actually modified\n+    const newCoords1 = polygon1.getCoordinates()[0];\n+    const newCoords2 = polygon2.getCoordinates()[0];\n+\n+    // The shared vertex should have been updated in both polygons\n+    let foundUpdatedVertex1 = false;\n+    let foundUpdatedVertex2 = false;\n+\n+    for (let i = 0; i < newCoords1.length; i++) {\n+      if (originalCoords1[i][0] === sharedVertex[0] && originalCoords1[i][1] === sharedVertex[1]) {\n+        expect(newCoords1[i][0]).to.be(newVertex[0]);\n+        expect(newCoords1[i][1]).to.be(newVertex[1]);\n+        foundUpdatedVertex1 = true;\n+      }\n+    }\n+\n+    for (let i = 0; i < newCoords2.length; i++) {\n+      if (originalCoords2[i][0] === sharedVertex[0] && originalCoords2[i][1] === sharedVertex[1]) {\n+        expect(newCoords2[i][0]).to.be(newVertex[0]);\n+        expect(newCoords2[i][1]).to.be(newVertex[1]);\n+        foundUpdatedVertex2 = true;\n+      }\n+    }\n+\n+    expect(foundUpdatedVertex1).to.be(true);\n+    expect(foundUpdatedVertex2).to.be(true);\n+  });\n+\n+  it('should compare behavior with separate features', function () {\n+    // Create two polygons that share a vertex at [10, 10]\n+    const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+    const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+    // Test 1: GeometryCollection\n+    const polygon1 = new Polygon(polygon1Coords);\n+    const polygon2 = new Polygon(polygon2Coords);\n+    const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+    \n+    const featureWithGeometryCollection = new Feature({\n+      geometry: geometryCollection\n+    });\n+\n+    const modify1 = new Modify({\n+      features: new Collection([featureWithGeometryCollection])\n+    });\n+\n+    // Test 2: Separate Features\n+    const feature1 = new Feature({\n+      geometry: new Polygon(polygon1Coords)\n+    });\n+    \n+    const feature2 = new Feature({\n+      geometry: new Polygon(polygon2Coords)\n+    });\n+\n+    const modify2 = new Modify({\n+      features: new Collection([feature1, feature2])\n+    });\n+\n+    // Check the RBush entries\n+    const rbushEntries1 = modify1.rBush_.getAll();\n+    const rbushEntries2 = modify2.rBush_.getAll();\n+    \n+    // Look for segments that contain the shared vertex [10, 10]\n+    const sharedVertex = [10, 10];\n+    const segmentsWithSharedVertex1 = rbushEntries1.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+    \n+    const segmentsWithSharedVertex2 = rbushEntries2.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+\n+    // Both should have the same number of segments with shared vertex\n+    expect(segmentsWithSharedVertex1.length).to.equal(segmentsWithSharedVertex2.length);\n+    expect(segmentsWithSharedVertex1.length).to.be.greaterThan(1);\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_geometry_collection_bug.js b/test_geometry_collection_bug.js\nnew file mode 100644\nindex 000000000..640a39185\n--- /dev/null\n+++ b/test_geometry_collection_bug.js\n@@ -0,0 +1,98 @@\n+import Collection from './src/ol/Collection.js';\n+import Feature from './src/ol/Feature.js';\n+import Polygon from './src/ol/geom/Polygon.js';\n+import GeometryCollection from './src/ol/geom/GeometryCollection.js';\n+import Modify from './src/ol/interaction/Modify.js';\n+\n+// Test to reproduce the GeometryCollection modify bug\n+function testGeometryCollectionModifyBug() {\n+  console.log('Testing GeometryCollection modify bug...');\n+\n+  // Create two polygons that share a vertex at [10, 10]\n+  const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+  const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+  // Test 1: GeometryCollection (BROKEN)\n+  console.log('\\n=== Test 1: GeometryCollection ===');\n+  const polygon1 = new Polygon(polygon1Coords);\n+  const polygon2 = new Polygon(polygon2Coords);\n+  const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+  \n+  const featureWithGeometryCollection = new Feature({\n+    geometry: geometryCollection\n+  });\n+\n+  const modify1 = new Modify({\n+    features: new Collection([featureWithGeometryCollection])\n+  });\n+\n+  // Check the RBush entries for GeometryCollection\n+  const rbushEntries1 = modify1.rBush_.getAll();\n+  console.log('GeometryCollection RBush entries:', rbushEntries1.length);\n+  \n+  // Look for segments that contain the shared vertex [10, 10]\n+  const sharedVertex = [10, 10];\n+  const segmentsWithSharedVertex1 = rbushEntries1.filter(entry => {\n+    const segment = entry.segment;\n+    return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+           (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+  });\n+  \n+  console.log('Segments with shared vertex [10, 10]:', segmentsWithSharedVertex1.length);\n+  segmentsWithSharedVertex1.forEach((entry, i) => {\n+    console.log(`  Segment ${i}:`, entry.segment, 'Feature:', entry.feature === featureWithGeometryCollection, 'Geometry type:', entry.geometry.getType());\n+  });\n+\n+  // Test 2: Separate Features (WORKING)\n+  console.log('\\n=== Test 2: Separate Features ===');\n+  const feature1 = new Feature({\n+    geometry: new Polygon(polygon1Coords)\n+  });\n+  \n+  const feature2 = new Feature({\n+    geometry: new Polygon(polygon2Coords)\n+  });\n+\n+  const modify2 = new Modify({\n+    features: new Collection([feature1, feature2])\n+  });\n+\n+  // Check the RBush entries for separate features\n+  const rbushEntries2 = modify2.rBush_.getAll();\n+  console.log('Separate features RBush entries:', rbushEntries2.length);\n+  \n+  // Look for segments that contain the shared vertex [10, 10]\n+  const segmentsWithSharedVertex2 = rbushEntries2.filter(entry => {\n+    const segment = entry.segment;\n+    return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+           (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+  });\n+  \n+  console.log('Segments with shared vertex [10, 10]:', segmentsWithSharedVertex2.length);\n+  segmentsWithSharedVertex2.forEach((entry, i) => {\n+    console.log(`  Segment ${i}:`, entry.segment, 'Feature:', entry.feature.getId() || 'no-id', 'Geometry type:', entry.geometry.getType());\n+  });\n+\n+  // Analysis\n+  console.log('\\n=== Analysis ===');\n+  console.log('Expected: Both tests should have the same number of segments with shared vertex');\n+  console.log('GeometryCollection segments with shared vertex:', segmentsWithSharedVertex1.length);\n+  console.log('Separate features segments with shared vertex:', segmentsWithSharedVertex2.length);\n+  \n+  if (segmentsWithSharedVertex1.length !== segmentsWithSharedVertex2.length) {\n+    console.log('BUG CONFIRMED: Different number of segments detected!');\n+    \n+    // Let's examine the geometry references\n+    console.log('\\nGeometry references in GeometryCollection:');\n+    segmentsWithSharedVertex1.forEach((entry, i) => {\n+      console.log(`  Segment ${i} geometry === polygon1:`, entry.geometry === polygon1);\n+      console.log(`  Segment ${i} geometry === polygon2:`, entry.geometry === polygon2);\n+      console.log(`  Segment ${i} geometry === geometryCollection:`, entry.geometry === geometryCollection);\n+    });\n+  } else {\n+    console.log('No obvious bug detected in segment count');\n+  }\n+}\n+\n+// Run the test\n+testGeometryCollectionModifyBug();\n\\ No newline at end of file\ndiff --git a/test_geometry_collection_fix.html b/test_geometry_collection_fix.html\nnew file mode 100644\nindex 000000000..20794ee0f\n--- /dev/null\n+++ b/test_geometry_collection_fix.html\n@@ -0,0 +1,168 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>GeometryCollection Modify Fix Test</title>\n+    <style>\n+        .map {\n+            height: 400px;\n+            width: 100%;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ccc;\n+        }\n+        .status {\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+        }\n+        .success {\n+            background-color: #d4edda;\n+            border: 1px solid #c3e6cb;\n+            color: #155724;\n+        }\n+        .error {\n+            background-color: #f8d7da;\n+            border: 1px solid #f5c6cb;\n+            color: #721c24;\n+        }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"build/ol/ol.css\" type=\"text/css\">\n+    <script src=\"build/ol/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>GeometryCollection Modify Fix Test</h1>\n+    \n+    <div id=\"test-results\"></div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test: GeometryCollection with Shared Vertices</h2>\n+        <p>This test creates a GeometryCollection with two polygons sharing a vertex. Try dragging the shared vertex - it should now work correctly.</p>\n+        <div id=\"map1\" class=\"map\"></div>\n+    </div>\n+\n+    <script>\n+        function runTests() {\n+            const results = document.getElementById('test-results');\n+            \n+            try {\n+                // Test 1: Create GeometryCollection and check segment data\n+                console.log('Running GeometryCollection segment data test...');\n+                \n+                const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+                const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+                const polygon1 = new ol.geom.Polygon(polygon1Coords);\n+                const polygon2 = new ol.geom.Polygon(polygon2Coords);\n+                const geometryCollection = new ol.geom.GeometryCollection([polygon1, polygon2]);\n+                \n+                const featureWithGeometryCollection = new ol.Feature({\n+                    geometry: geometryCollection\n+                });\n+\n+                const modify = new ol.interaction.Modify({\n+                    features: new ol.Collection([featureWithGeometryCollection])\n+                });\n+\n+                // Check the RBush entries\n+                const rbushEntries = modify.rBush_.getAll();\n+                console.log('RBush entries:', rbushEntries.length);\n+                \n+                // Check that all segments reference the GeometryCollection\n+                let allReferencesCorrect = true;\n+                let hasDepthInfo = true;\n+                \n+                rbushEntries.forEach(entry => {\n+                    if (entry.geometry !== geometryCollection) {\n+                        allReferencesCorrect = false;\n+                    }\n+                    if (!entry.depth || !Array.isArray(entry.depth) || entry.depth.length === 0) {\n+                        hasDepthInfo = false;\n+                    }\n+                });\n+                \n+                // Look for segments with shared vertex\n+                const sharedVertex = [10, 10];\n+                const segmentsWithSharedVertex = rbushEntries.filter(entry => {\n+                    const segment = entry.segment;\n+                    return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+                           (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+                });\n+                \n+                console.log('Segments with shared vertex:', segmentsWithSharedVertex.length);\n+                \n+                let testStatus = '';\n+                if (rbushEntries.length > 0 && allReferencesCorrect && hasDepthInfo && segmentsWithSharedVertex.length > 1) {\n+                    testStatus = '<div class=\"status success\">\u2713 GeometryCollection segment data test PASSED</div>';\n+                } else {\n+                    testStatus = '<div class=\"status error\">\u2717 GeometryCollection segment data test FAILED</div>';\n+                }\n+                \n+                results.innerHTML += testStatus;\n+                \n+                // Create the visual test map\n+                const source = new ol.source.Vector({\n+                    features: [featureWithGeometryCollection]\n+                });\n+\n+                const layer = new ol.layer.Vector({\n+                    source: source,\n+                    style: new ol.style.Style({\n+                        fill: new ol.style.Fill({\n+                            color: 'rgba(255, 255, 255, 0.2)'\n+                        }),\n+                        stroke: new ol.style.Stroke({\n+                            color: '#ffcc33',\n+                            width: 2\n+                        })\n+                    })\n+                });\n+\n+                const modifyInteraction = new ol.interaction.Modify({\n+                    source: source\n+                });\n+\n+                const map = new ol.Map({\n+                    target: 'map1',\n+                    layers: [layer],\n+                    view: new ol.View({\n+                        center: [10, 10],\n+                        zoom: 6\n+                    }),\n+                    interactions: ol.interaction.defaults().extend([modifyInteraction])\n+                });\n+\n+                // Add event listeners to verify modify events work\n+                let modifyStarted = false;\n+                let modifyEnded = false;\n+                \n+                modifyInteraction.on('modifystart', (e) => {\n+                    modifyStarted = true;\n+                    console.log('Modify started:', e);\n+                });\n+                \n+                modifyInteraction.on('modifyend', (e) => {\n+                    modifyEnded = true;\n+                    console.log('Modify ended:', e);\n+                    \n+                    // Check if coordinates actually changed\n+                    const newCoords1 = polygon1.getCoordinates()[0];\n+                    const newCoords2 = polygon2.getCoordinates()[0];\n+                    console.log('New polygon1 coords:', newCoords1);\n+                    console.log('New polygon2 coords:', newCoords2);\n+                });\n+                \n+                results.innerHTML += '<div class=\"status success\">\u2713 Visual test map created successfully. Try dragging the shared vertex at the center.</div>';\n+                \n+            } catch (error) {\n+                console.error('Test failed:', error);\n+                results.innerHTML += '<div class=\"status error\">\u2717 Test failed: ' + error.message + '</div>';\n+            }\n+        }\n+        \n+        // Run tests when page loads\n+        window.onload = runTests;\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_geometry_collection_modify.html b/test_geometry_collection_modify.html\nnew file mode 100644\nindex 000000000..c31562bd0\n--- /dev/null\n+++ b/test_geometry_collection_modify.html\n@@ -0,0 +1,139 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>GeometryCollection Modify Test</title>\n+    <style>\n+        .map {\n+            height: 400px;\n+            width: 100%;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ccc;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>GeometryCollection Modify Interaction Test</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: GeometryCollection (BROKEN)</h2>\n+        <p>Try to drag the shared vertex at coordinates [10, 10] - this should modify both polygons but likely won't work correctly.</p>\n+        <div id=\"map1\" class=\"map\"></div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: Separate Features (WORKING)</h2>\n+        <p>Try to drag the shared vertex at coordinates [10, 10] - this should work correctly.</p>\n+        <div id=\"map2\" class=\"map\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Polygon from './src/ol/geom/Polygon.js';\n+        import GeometryCollection from './src/ol/geom/GeometryCollection.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Modify from './src/ol/interaction/Modify.js';\n+        import {Fill, Stroke, Style} from './src/ol/style.js';\n+\n+        // Create two polygons that share a vertex at [10, 10]\n+        const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+        const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+        const style = new Style({\n+            fill: new Fill({\n+                color: 'rgba(255, 255, 255, 0.2)'\n+            }),\n+            stroke: new Stroke({\n+                color: '#ffcc33',\n+                width: 2\n+            })\n+        });\n+\n+        // Test 1: GeometryCollection\n+        const polygon1 = new Polygon(polygon1Coords);\n+        const polygon2 = new Polygon(polygon2Coords);\n+        const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+        \n+        const featureWithGeometryCollection = new Feature({\n+            geometry: geometryCollection\n+        });\n+\n+        const source1 = new VectorSource({\n+            features: [featureWithGeometryCollection]\n+        });\n+\n+        const layer1 = new VectorLayer({\n+            source: source1,\n+            style: style\n+        });\n+\n+        const modify1 = new Modify({\n+            source: source1\n+        });\n+\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [layer1],\n+            view: new View({\n+                center: [10, 10],\n+                zoom: 6\n+            }),\n+            interactions: [modify1]\n+        });\n+\n+        // Test 2: Separate Features\n+        const feature1 = new Feature({\n+            geometry: new Polygon(polygon1Coords)\n+        });\n+        \n+        const feature2 = new Feature({\n+            geometry: new Polygon(polygon2Coords)\n+        });\n+\n+        const source2 = new VectorSource({\n+            features: [feature1, feature2]\n+        });\n+\n+        const layer2 = new VectorLayer({\n+            source: source2,\n+            style: style\n+        });\n+\n+        const modify2 = new Modify({\n+            source: source2\n+        });\n+\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [layer2],\n+            view: new View({\n+                center: [10, 10],\n+                zoom: 6\n+            }),\n+            interactions: [modify2]\n+        });\n+\n+        // Add some debugging\n+        modify1.on('modifystart', (e) => {\n+            console.log('GeometryCollection modify start:', e);\n+        });\n+        \n+        modify1.on('modifyend', (e) => {\n+            console.log('GeometryCollection modify end:', e);\n+        });\n+\n+        modify2.on('modifystart', (e) => {\n+            console.log('Separate features modify start:', e);\n+        });\n+        \n+        modify2.on('modifyend', (e) => {\n+            console.log('Separate features modify end:', e);\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_geometry_collection_modify.test.js b/test_geometry_collection_modify.test.js\nnew file mode 100644\nindex 000000000..e90c0454e\n--- /dev/null\n+++ b/test_geometry_collection_modify.test.js\n@@ -0,0 +1,79 @@\n+import Collection from '../src/ol/Collection.js';\n+import Feature from '../src/ol/Feature.js';\n+import Polygon from '../src/ol/geom/Polygon.js';\n+import GeometryCollection from '../src/ol/geom/GeometryCollection.js';\n+import Modify from '../src/ol/interaction/Modify.js';\n+\n+describe('GeometryCollection Modify Bug Test', function () {\n+  \n+  it('should handle shared vertices in GeometryCollection correctly', function () {\n+    // Create two polygons that share a vertex at [10, 10]\n+    const polygon1Coords = [[[0, 0], [10, 10], [0, 20], [-10, 10], [0, 0]]];\n+    const polygon2Coords = [[[20, 0], [10, 10], [20, 20], [30, 10], [20, 0]]];\n+\n+    // Test 1: GeometryCollection\n+    const polygon1 = new Polygon(polygon1Coords);\n+    const polygon2 = new Polygon(polygon2Coords);\n+    const geometryCollection = new GeometryCollection([polygon1, polygon2]);\n+    \n+    const featureWithGeometryCollection = new Feature({\n+      geometry: geometryCollection\n+    });\n+\n+    const modify1 = new Modify({\n+      features: new Collection([featureWithGeometryCollection])\n+    });\n+\n+    // Check the RBush entries for GeometryCollection\n+    const rbushEntries1 = modify1.rBush_.getAll();\n+    \n+    // Look for segments that contain the shared vertex [10, 10]\n+    const sharedVertex = [10, 10];\n+    const segmentsWithSharedVertex1 = rbushEntries1.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+\n+    // Test 2: Separate Features\n+    const feature1 = new Feature({\n+      geometry: new Polygon(polygon1Coords)\n+    });\n+    \n+    const feature2 = new Feature({\n+      geometry: new Polygon(polygon2Coords)\n+    });\n+\n+    const modify2 = new Modify({\n+      features: new Collection([feature1, feature2])\n+    });\n+\n+    // Check the RBush entries for separate features\n+    const rbushEntries2 = modify2.rBush_.getAll();\n+    \n+    // Look for segments that contain the shared vertex [10, 10]\n+    const segmentsWithSharedVertex2 = rbushEntries2.filter(entry => {\n+      const segment = entry.segment;\n+      return (segment[0][0] === sharedVertex[0] && segment[0][1] === sharedVertex[1]) ||\n+             (segment[1][0] === sharedVertex[0] && segment[1][1] === sharedVertex[1]);\n+    });\n+\n+    console.log('GeometryCollection segments with shared vertex:', segmentsWithSharedVertex1.length);\n+    console.log('Separate features segments with shared vertex:', segmentsWithSharedVertex2.length);\n+    \n+    // Debug: Print segment details\n+    console.log('\\nGeometryCollection segments:');\n+    segmentsWithSharedVertex1.forEach((entry, i) => {\n+      console.log(`  Segment ${i}:`, entry.segment, 'Geometry type:', entry.geometry.getType());\n+    });\n+    \n+    console.log('\\nSeparate features segments:');\n+    segmentsWithSharedVertex2.forEach((entry, i) => {\n+      console.log(`  Segment ${i}:`, entry.segment, 'Geometry type:', entry.geometry.getType());\n+    });\n+\n+    // The bug: GeometryCollection should have the same number of segments with shared vertex\n+    // as separate features, but it likely doesn't due to how the segments are created\n+    expect(segmentsWithSharedVertex1.length).to.equal(segmentsWithSharedVertex2.length);\n+  });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

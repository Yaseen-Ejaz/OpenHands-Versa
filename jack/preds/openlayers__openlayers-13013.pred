{"instance_id": "openlayers__openlayers-13013", "model_patch": "diff --git a/src/ol/webgl/TileTexture.js b/src/ol/webgl/TileTexture.js\nindex 6dea0f11d..674f2e11f 100644\n--- a/src/ol/webgl/TileTexture.js\n+++ b/src/ol/webgl/TileTexture.js\n@@ -167,11 +167,62 @@ class TileTexture extends EventTarget {\n \n     const data = tile.getData();\n     const isFloat = data instanceof Float32Array;\n-    const pixelCount = this.size[0] * this.size[1];\n-    // Float arrays feature four bytes per element,\n-    //  BYTES_PER_ELEMENT throws a TypeScript exception but would handle\n-    //  this better for more varied typed arrays.\n-    this.bandCount = data.byteLength / (isFloat ? 4 : 1) / pixelCount;\n+    \n+    // Calculate actual dimensions from data if possible\n+    let actualSize = this.size;\n+    let pixelCount = this.size[0] * this.size[1];\n+    \n+    // First, try to determine band count from data\n+    const bytesPerElement = isFloat ? 4 : 1;\n+    const totalBytes = data.byteLength;\n+    \n+    // First, check if any band count gives us exact tile grid dimensions\n+    for (const testBandCount of [1, 2, 3, 4]) {\n+      const testPixelCount = totalBytes / (bytesPerElement * testBandCount);\n+      if (testPixelCount === pixelCount) {\n+        this.bandCount = testBandCount;\n+        actualSize = this.size; // Use tile grid size\n+        break;\n+      }\n+    }\n+    \n+    // If no exact match, try to find reasonable dimensions\n+    if (actualSize === this.size && pixelCount === this.size[0] * this.size[1]) {\n+      for (const testBandCount of [4, 3, 2, 1]) {\n+        const testPixelCount = totalBytes / (bytesPerElement * testBandCount);\n+        \n+        // Try the tile grid aspect ratio\n+        const aspectRatio = this.size[0] / this.size[1];\n+        const testHeight = Math.sqrt(testPixelCount / aspectRatio);\n+        const testWidth = testPixelCount / testHeight;\n+        \n+        if (Number.isInteger(testWidth) && Number.isInteger(testHeight) && \n+            testWidth > 0 && testHeight > 0) {\n+          actualSize = [Math.round(testWidth), Math.round(testHeight)];\n+          pixelCount = testPixelCount;\n+          this.bandCount = testBandCount;\n+          break;\n+        }\n+        \n+        // Try square dimensions as fallback\n+        const testSquareSize = Math.sqrt(testPixelCount);\n+        if (Number.isInteger(testSquareSize) && testSquareSize > 0) {\n+          actualSize = [testSquareSize, testSquareSize];\n+          pixelCount = testPixelCount;\n+          this.bandCount = testBandCount;\n+          break;\n+        }\n+      }\n+    }\n+    \n+    // If we couldn't determine from common band counts, fall back to original calculation\n+    if (actualSize === this.size && pixelCount === this.size[0] * this.size[1]) {\n+      this.bandCount = totalBytes / bytesPerElement / pixelCount;\n+    }\n+    \n+    // Update the size to use actual dimensions for WebGL upload\n+    this.size = actualSize;\n+    \n     const textureCount = Math.ceil(this.bandCount / 4);\n \n     if (textureCount === 1) {\ndiff --git a/test_black_tiles.html b/test_black_tiles.html\nnew file mode 100644\nindex 000000000..bc803f4aa\n--- /dev/null\n+++ b/test_black_tiles.html\n@@ -0,0 +1,163 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Black Tiles Test - DataTileSource with WebGLTileLayer</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #info {\n+            margin-top: 10px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .error {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .success {\n+            color: green;\n+            font-weight: bold;\n+        }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@latest/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@latest/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Black Tiles Test - DataTileSource with WebGLTileLayer</h1>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <p><strong>Test Configuration:</strong></p>\n+        <ul>\n+            <li>Extent: [0, -23828, 23903, 0]</li>\n+            <li>Sizes: [[1, 1], [7, 7], [25, 25], [100, 100]]</li>\n+            <li>Tile sizes: [[770, 768], [240, 240], [240, 240], [240, 240]]</li>\n+        </ul>\n+        <p id=\"status\">Loading...</p>\n+        <p id=\"errors\"></p>\n+    </div>\n+\n+    <script>\n+        // Capture console errors\n+        const originalError = console.error;\n+        const errors = [];\n+        console.error = function(...args) {\n+            errors.push(args.join(' '));\n+            document.getElementById('errors').innerHTML = '<span class=\"error\">Errors: ' + errors.join('<br>') + '</span>';\n+            originalError.apply(console, args);\n+        };\n+\n+        // Capture console warnings\n+        const originalWarn = console.warn;\n+        const warnings = [];\n+        console.warn = function(...args) {\n+            warnings.push(args.join(' '));\n+            if (document.getElementById('errors').innerHTML === '') {\n+                document.getElementById('errors').innerHTML = '<span style=\"color: orange;\">Warnings: ' + warnings.join('<br>') + '</span>';\n+            }\n+            originalWarn.apply(console, args);\n+        };\n+\n+        try {\n+            // Create custom tile grid with the problematic configuration\n+            const customTileGrid = new ol.tilegrid.TileGrid({\n+                extent: [0, -23828, 23903, 0],\n+                resolutions: [100, 50, 25, 12.5], // Calculated based on extent and sizes\n+                tileSizes: [[770, 768], [240, 240], [240, 240], [240, 240]]\n+            });\n+\n+            // Create a data loader that generates test data\n+            function createTestData(z, x, y) {\n+                return new Promise((resolve) => {\n+                    const tileSize = customTileGrid.getTileSize(z);\n+                    const width = Array.isArray(tileSize) ? tileSize[0] : tileSize;\n+                    const height = Array.isArray(tileSize) ? tileSize[1] : tileSize;\n+                    \n+                    console.log(`Loading tile [${z}, ${x}, ${y}] with expected size [${width}, ${height}]`);\n+                    \n+                    // Create test data - this is where the dimension mismatch might occur\n+                    const pixelCount = width * height;\n+                    const data = new Uint8Array(pixelCount * 4); // RGBA\n+                    \n+                    // Fill with a gradient pattern to make it visible\n+                    for (let i = 0; i < pixelCount; i++) {\n+                        const row = Math.floor(i / width);\n+                        const col = i % width;\n+                        data[i * 4] = (col / width) * 255; // Red\n+                        data[i * 4 + 1] = (row / height) * 255; // Green\n+                        data[i * 4 + 2] = 128; // Blue\n+                        data[i * 4 + 3] = 255; // Alpha\n+                    }\n+                    \n+                    resolve(data);\n+                });\n+            }\n+\n+            // Create DataTile source\n+            const dataSource = new ol.source.DataTile({\n+                tileGrid: customTileGrid,\n+                loader: createTestData,\n+                bandCount: 4\n+            });\n+\n+            // Create WebGL tile layer\n+            const webglLayer = new ol.layer.WebGLTile({\n+                source: dataSource\n+            });\n+\n+            // Create map\n+            const map = new ol.Map({\n+                target: 'map',\n+                layers: [webglLayer],\n+                view: new ol.View({\n+                    center: [11951.5, -11914], // Center of the extent\n+                    zoom: 1,\n+                    projection: new ol.proj.Projection({\n+                        code: 'CUSTOM',\n+                        units: 'pixels',\n+                        extent: [0, -23828, 23903, 0]\n+                    })\n+                })\n+            });\n+\n+            // Monitor for tile loading\n+            let tilesLoaded = 0;\n+            dataSource.on('tileloadend', function(event) {\n+                tilesLoaded++;\n+                document.getElementById('status').innerHTML = `<span class=\"success\">Tiles loaded: ${tilesLoaded}</span>`;\n+            });\n+\n+            dataSource.on('tileloaderror', function(event) {\n+                document.getElementById('status').innerHTML = '<span class=\"error\">Tile loading error occurred</span>';\n+            });\n+\n+            // Check for WebGL context\n+            setTimeout(() => {\n+                const canvas = map.getViewport().querySelector('canvas');\n+                if (canvas) {\n+                    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');\n+                    if (gl) {\n+                        console.log('WebGL context available');\n+                        document.getElementById('status').innerHTML += '<br>WebGL context: Available';\n+                    } else {\n+                        console.error('WebGL context not available');\n+                        document.getElementById('status').innerHTML += '<br><span class=\"error\">WebGL context: Not available</span>';\n+                    }\n+                }\n+            }, 1000);\n+\n+        } catch (error) {\n+            console.error('Test setup error:', error);\n+            document.getElementById('status').innerHTML = '<span class=\"error\">Test setup failed: ' + error.message + '</span>';\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_comprehensive_fix.js b/test_comprehensive_fix.js\nnew file mode 100644\nindex 000000000..955a300ad\n--- /dev/null\n+++ b/test_comprehensive_fix.js\n@@ -0,0 +1,230 @@\n+// Comprehensive test for the TileTexture fix\n+// This tests various scenarios that could cause the WebGL dimension mismatch\n+\n+// Mock the required classes and functions\n+function toSize(size) {\n+  if (Array.isArray(size)) {\n+    return size;\n+  }\n+  return [size, size];\n+}\n+\n+class MockTile {\n+  constructor(data, tileCoord) {\n+    this.data = data;\n+    this.tileCoord = tileCoord;\n+  }\n+  \n+  getData() {\n+    return this.data;\n+  }\n+}\n+\n+class MockTileGrid {\n+  constructor(tileSizes) {\n+    this.tileSizes = tileSizes;\n+  }\n+  \n+  getTileSize(z) {\n+    return this.tileSizes[z];\n+  }\n+}\n+\n+// Simulate the fixed uploadTile_ logic\n+function simulateFixedLogic(data, tileGridSize, isFloat = false) {\n+  // Calculate actual dimensions from data if possible\n+  let actualSize = tileGridSize;\n+  let pixelCount = tileGridSize[0] * tileGridSize[1];\n+  \n+  // First, try to determine band count from data\n+  const bytesPerElement = isFloat ? 4 : 1;\n+  const totalBytes = data.byteLength;\n+  \n+  let bandCount = NaN;\n+  \n+  // First, check if any band count gives us exact tile grid dimensions\n+  for (const testBandCount of [1, 2, 3, 4]) {\n+    const testPixelCount = totalBytes / (bytesPerElement * testBandCount);\n+    if (testPixelCount === pixelCount) {\n+      bandCount = testBandCount;\n+      actualSize = tileGridSize; // Use tile grid size\n+      break;\n+    }\n+  }\n+  \n+  // If no exact match, try to find reasonable dimensions\n+  if (actualSize === tileGridSize && pixelCount === tileGridSize[0] * tileGridSize[1]) {\n+    for (const testBandCount of [4, 3, 2, 1]) {\n+      const testPixelCount = totalBytes / (bytesPerElement * testBandCount);\n+      \n+      // Try the tile grid aspect ratio\n+      const aspectRatio = tileGridSize[0] / tileGridSize[1];\n+      const testHeight = Math.sqrt(testPixelCount / aspectRatio);\n+      const testWidth = testPixelCount / testHeight;\n+      \n+      if (Number.isInteger(testWidth) && Number.isInteger(testHeight) && \n+          testWidth > 0 && testHeight > 0) {\n+        actualSize = [Math.round(testWidth), Math.round(testHeight)];\n+        pixelCount = testPixelCount;\n+        bandCount = testBandCount;\n+        break;\n+      }\n+      \n+      // Try square dimensions as fallback\n+      const testSquareSize = Math.sqrt(testPixelCount);\n+      if (Number.isInteger(testSquareSize) && testSquareSize > 0) {\n+        actualSize = [testSquareSize, testSquareSize];\n+        pixelCount = testPixelCount;\n+        bandCount = testBandCount;\n+        break;\n+      }\n+    }\n+  }\n+  \n+  // If we couldn't determine from common band counts, fall back to original calculation\n+  if (actualSize === tileGridSize && pixelCount === tileGridSize[0] * tileGridSize[1]) {\n+    bandCount = totalBytes / bytesPerElement / pixelCount;\n+  }\n+  \n+  return {\n+    actualSize,\n+    pixelCount,\n+    bandCount,\n+    expectedDataLength: actualSize[0] * actualSize[1] * bandCount\n+  };\n+}\n+\n+// Test cases\n+function runTests() {\n+  console.log('Running comprehensive TileTexture fix tests...\\n');\n+  \n+  let passedTests = 0;\n+  let totalTests = 0;\n+  \n+  function test(name, testFunc) {\n+    totalTests++;\n+    console.log(`Test ${totalTests}: ${name}`);\n+    try {\n+      const result = testFunc();\n+      if (result) {\n+        console.log('  \u2713 PASSED\\n');\n+        passedTests++;\n+      } else {\n+        console.log('  \u2717 FAILED\\n');\n+      }\n+    } catch (error) {\n+      console.log(`  \u2717 FAILED: ${error.message}\\n`);\n+    }\n+  }\n+  \n+  // Test 1: Original problematic case from the issue\n+  test('Original issue case: [770, 768] tile grid with 256x256 data', () => {\n+    const tileGridSize = [770, 768];\n+    const actualData = new Uint8Array(256 * 256 * 4); // 256x256 RGBA\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    console.log(`  Data length: ${actualData.length}, Expected: ${result.expectedDataLength}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 256 && \n+           result.actualSize[1] === 256 &&\n+           result.bandCount === 4;\n+  });\n+  \n+  // Test 2: Matching tile grid and data dimensions\n+  test('Matching dimensions: [240, 240] tile grid with 240x240 data', () => {\n+    const tileGridSize = [240, 240];\n+    const actualData = new Uint8Array(240 * 240 * 4); // 240x240 RGBA\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 240 && \n+           result.actualSize[1] === 240 &&\n+           result.bandCount === 4;\n+  });\n+  \n+  // Test 3: Different aspect ratio\n+  test('Different aspect ratio: [800, 600] tile grid with 400x300 data', () => {\n+    const tileGridSize = [800, 600];\n+    const actualData = new Uint8Array(400 * 300 * 4); // 400x300 RGBA\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 400 && \n+           result.actualSize[1] === 300 &&\n+           result.bandCount === 4;\n+  });\n+  \n+  // Test 4: Single band data\n+  test('Single band data: [256, 256] tile grid with 256x256 grayscale', () => {\n+    const tileGridSize = [256, 256];\n+    const actualData = new Uint8Array(256 * 256 * 1); // 256x256 grayscale\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 256 && \n+           result.actualSize[1] === 256 &&\n+           result.bandCount === 1;\n+  });\n+  \n+  // Test 5: Float32Array data\n+  test('Float32Array data: [128, 128] tile grid with 128x128 float RGBA', () => {\n+    const tileGridSize = [128, 128];\n+    const actualData = new Float32Array(128 * 128 * 4); // 128x128 float RGBA\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize, true);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 128 && \n+           result.actualSize[1] === 128 &&\n+           result.bandCount === 4;\n+  });\n+  \n+  // Test 6: RGB data (3 bands)\n+  test('RGB data: [200, 200] tile grid with 200x200 RGB', () => {\n+    const tileGridSize = [200, 200];\n+    const actualData = new Uint8Array(200 * 200 * 3); // 200x200 RGB\n+    \n+    const result = simulateFixedLogic(actualData, tileGridSize);\n+    \n+    console.log(`  Tile grid size: [${tileGridSize[0]}, ${tileGridSize[1]}]`);\n+    console.log(`  Actual size detected: [${result.actualSize[0]}, ${result.actualSize[1]}]`);\n+    console.log(`  Band count: ${result.bandCount}`);\n+    \n+    return result.expectedDataLength === actualData.length && \n+           result.actualSize[0] === 200 && \n+           result.actualSize[1] === 200 &&\n+           result.bandCount === 3;\n+  });\n+  \n+  console.log(`\\nTest Results: ${passedTests}/${totalTests} tests passed`);\n+  return passedTests === totalTests;\n+}\n+\n+// Run the tests\n+const allTestsPassed = runTests();\n+console.log(`\\nOverall result: ${allTestsPassed ? 'ALL TESTS PASSED' : 'SOME TESTS FAILED'}`);\n+process.exit(allTestsPassed ? 0 : 1);\n\\ No newline at end of file\ndiff --git a/test_fix.js b/test_fix.js\nnew file mode 100644\nindex 000000000..4b09cf466\n--- /dev/null\n+++ b/test_fix.js\n@@ -0,0 +1,123 @@\n+// Simple test to verify the TileTexture fix\n+// This simulates the problematic scenario\n+\n+// Mock the required classes and functions\n+function toSize(size) {\n+  if (Array.isArray(size)) {\n+    return size;\n+  }\n+  return [size, size];\n+}\n+\n+class MockTile {\n+  constructor(data, tileCoord) {\n+    this.data = data;\n+    this.tileCoord = tileCoord;\n+  }\n+  \n+  getData() {\n+    return this.data;\n+  }\n+}\n+\n+class MockTileGrid {\n+  constructor(tileSizes) {\n+    this.tileSizes = tileSizes;\n+  }\n+  \n+  getTileSize(z) {\n+    return this.tileSizes[z];\n+  }\n+}\n+\n+// Simulate the problematic scenario from the issue\n+function testTileTextureFix() {\n+  console.log('Testing TileTexture fix...');\n+  \n+  // Create the problematic tile grid configuration\n+  const tileSizes = [[770, 768], [240, 240], [240, 240], [240, 240]];\n+  const mockGrid = new MockTileGrid(tileSizes);\n+  \n+  // Test case 1: Data that doesn't match tile grid size\n+  const tileCoord = [0, 0, 0]; // zoom level 0\n+  const expectedSize = mockGrid.getTileSize(0); // [770, 768]\n+  const expectedPixelCount = expectedSize[0] * expectedSize[1]; // 591,360\n+  \n+  // Create data that has different dimensions (this causes the WebGL error)\n+  const actualWidth = 256;\n+  const actualHeight = 256;\n+  const actualPixelCount = actualWidth * actualHeight; // 65,536\n+  const bandCount = 4; // RGBA\n+  const testData = new Uint8Array(actualPixelCount * bandCount);\n+  \n+  console.log(`Expected size from tile grid: [${expectedSize[0]}, ${expectedSize[1]}] = ${expectedPixelCount} pixels`);\n+  console.log(`Actual data size: [${actualWidth}, ${actualHeight}] = ${actualPixelCount} pixels`);\n+  console.log(`Data array length: ${testData.length} bytes`);\n+  \n+  // Simulate the original problematic logic\n+  const originalPixelCount = expectedSize[0] * expectedSize[1];\n+  const originalBandCount = testData.byteLength / originalPixelCount;\n+  console.log(`Original calculation would give band count: ${originalBandCount} (should be 4)`);\n+  \n+  // Simulate the fixed logic\n+  const bytesPerElement = 1; // Uint8Array\n+  const totalBytes = testData.byteLength;\n+  \n+  let actualSize = expectedSize;\n+  let pixelCount = originalPixelCount;\n+  let detectedBandCount = NaN;\n+  \n+  // Try common band counts (1, 2, 3, 4) to find actual dimensions\n+  for (const testBandCount of [4, 3, 2, 1]) {\n+    const testPixelCount = totalBytes / (bytesPerElement * testBandCount);\n+    \n+    // Check if the data size matches the expected tile grid size\n+    if (testPixelCount === pixelCount) {\n+      detectedBandCount = testBandCount;\n+      actualSize = expectedSize; // Use tile grid size\n+      break;\n+    }\n+    \n+    // If not, try to find dimensions that make sense\n+    // Try the tile grid aspect ratio first\n+    const aspectRatio = expectedSize[0] / expectedSize[1];\n+    const testHeight = Math.sqrt(testPixelCount / aspectRatio);\n+    const testWidth = testPixelCount / testHeight;\n+    \n+    if (Number.isInteger(testWidth) && Number.isInteger(testHeight) && \n+        testWidth > 0 && testHeight > 0) {\n+      actualSize = [Math.round(testWidth), Math.round(testHeight)];\n+      pixelCount = testPixelCount;\n+      detectedBandCount = testBandCount;\n+      break;\n+    }\n+    \n+    // Try square dimensions as fallback\n+    const testSquareSize = Math.sqrt(testPixelCount);\n+    if (Number.isInteger(testSquareSize) && testSquareSize > 0) {\n+      actualSize = [testSquareSize, testSquareSize];\n+      pixelCount = testPixelCount;\n+      detectedBandCount = testBandCount;\n+      break;\n+    }\n+  }\n+  \n+  console.log(`Fixed calculation:`);\n+  console.log(`  Detected band count: ${detectedBandCount}`);\n+  console.log(`  Actual size: [${actualSize[0]}, ${actualSize[1]}]`);\n+  console.log(`  Pixel count: ${pixelCount}`);\n+  \n+  // Verify the fix works\n+  const expectedDataLength = actualSize[0] * actualSize[1] * detectedBandCount;\n+  const success = expectedDataLength === testData.length;\n+  \n+  console.log(`Expected data length: ${expectedDataLength}`);\n+  console.log(`Actual data length: ${testData.length}`);\n+  console.log(`Fix successful: ${success}`);\n+  \n+  return success;\n+}\n+\n+// Run the test\n+const result = testTileTextureFix();\n+console.log(`\\nTest result: ${result ? 'PASSED' : 'FAILED'}`);\n\\ No newline at end of file\ndiff --git a/test_local_black_tiles.html b/test_local_black_tiles.html\nnew file mode 100644\nindex 000000000..84cd70bf4\n--- /dev/null\n+++ b/test_local_black_tiles.html\n@@ -0,0 +1,179 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Black Tiles Test - Local OpenLayers Build</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #info {\n+            margin-top: 10px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .error {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .success {\n+            color: green;\n+            font-weight: bold;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Black Tiles Test - Local OpenLayers Build</h1>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <p><strong>Test Configuration:</strong></p>\n+        <ul>\n+            <li>Extent: [0, -23828, 23903, 0]</li>\n+            <li>Sizes: [[1, 1], [7, 7], [25, 25], [100, 100]]</li>\n+            <li>Tile sizes: [[770, 768], [240, 240], [240, 240], [240, 240]]</li>\n+        </ul>\n+        <p id=\"status\">Loading...</p>\n+        <p id=\"errors\"></p>\n+    </div>\n+\n+    <script type=\"module\">\n+        // Import from local build\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileGrid from './src/ol/tilegrid/TileGrid.js';\n+        import DataTile from './src/ol/source/DataTile.js';\n+        import WebGLTile from './src/ol/layer/WebGLTile.js';\n+        import Projection from './src/ol/proj/Projection.js';\n+\n+        // Capture console errors and warnings\n+        const originalError = console.error;\n+        const originalWarn = console.warn;\n+        const errors = [];\n+        const warnings = [];\n+\n+        console.error = function(...args) {\n+            errors.push(args.join(' '));\n+            updateErrorDisplay();\n+            originalError.apply(console, args);\n+        };\n+\n+        console.warn = function(...args) {\n+            warnings.push(args.join(' '));\n+            updateErrorDisplay();\n+            originalWarn.apply(console, args);\n+        };\n+\n+        function updateErrorDisplay() {\n+            let html = '';\n+            if (errors.length > 0) {\n+                html += '<span class=\"error\">Errors:<br>' + errors.join('<br>') + '</span>';\n+            }\n+            if (warnings.length > 0) {\n+                if (html) html += '<br><br>';\n+                html += '<span style=\"color: orange;\">Warnings:<br>' + warnings.join('<br>') + '</span>';\n+            }\n+            document.getElementById('errors').innerHTML = html;\n+        }\n+\n+        try {\n+            // Create custom tile grid with the problematic configuration\n+            const customTileGrid = new TileGrid({\n+                extent: [0, -23828, 23903, 0],\n+                resolutions: [100, 50, 25, 12.5], // Calculated based on extent and sizes\n+                tileSizes: [[770, 768], [240, 240], [240, 240], [240, 240]]\n+            });\n+\n+            // Create a data loader that generates test data\n+            function createTestData(z, x, y) {\n+                return new Promise((resolve) => {\n+                    const tileSize = customTileGrid.getTileSize(z);\n+                    const width = Array.isArray(tileSize) ? tileSize[0] : tileSize;\n+                    const height = Array.isArray(tileSize) ? tileSize[1] : tileSize;\n+                    \n+                    console.log(`Loading tile [${z}, ${x}, ${y}] with expected size [${width}, ${height}]`);\n+                    \n+                    // Create test data - this is where the dimension mismatch might occur\n+                    const pixelCount = width * height;\n+                    const data = new Uint8Array(pixelCount * 4); // RGBA\n+                    \n+                    // Fill with a gradient pattern to make it visible\n+                    for (let i = 0; i < pixelCount; i++) {\n+                        const row = Math.floor(i / width);\n+                        const col = i % width;\n+                        data[i * 4] = (col / width) * 255; // Red\n+                        data[i * 4 + 1] = (row / height) * 255; // Green\n+                        data[i * 4 + 2] = 128; // Blue\n+                        data[i * 4 + 3] = 255; // Alpha\n+                    }\n+                    \n+                    resolve(data);\n+                });\n+            }\n+\n+            // Create DataTile source\n+            const dataSource = new DataTile({\n+                tileGrid: customTileGrid,\n+                loader: createTestData,\n+                bandCount: 4\n+            });\n+\n+            // Create WebGL tile layer\n+            const webglLayer = new WebGLTile({\n+                source: dataSource\n+            });\n+\n+            // Create map\n+            const map = new Map({\n+                target: 'map',\n+                layers: [webglLayer],\n+                view: new View({\n+                    center: [11951.5, -11914], // Center of the extent\n+                    zoom: 1,\n+                    projection: new Projection({\n+                        code: 'CUSTOM',\n+                        units: 'pixels',\n+                        extent: [0, -23828, 23903, 0]\n+                    })\n+                })\n+            });\n+\n+            // Monitor for tile loading\n+            let tilesLoaded = 0;\n+            dataSource.on('tileloadend', function(event) {\n+                tilesLoaded++;\n+                document.getElementById('status').innerHTML = `<span class=\"success\">Tiles loaded: ${tilesLoaded}</span>`;\n+            });\n+\n+            dataSource.on('tileloaderror', function(event) {\n+                document.getElementById('status').innerHTML = '<span class=\"error\">Tile loading error occurred</span>';\n+            });\n+\n+            // Check for WebGL context\n+            setTimeout(() => {\n+                const canvas = map.getViewport().querySelector('canvas');\n+                if (canvas) {\n+                    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');\n+                    if (gl) {\n+                        console.log('WebGL context available');\n+                        document.getElementById('status').innerHTML += '<br>WebGL context: Available';\n+                    } else {\n+                        console.error('WebGL context not available');\n+                        document.getElementById('status').innerHTML += '<br><span class=\"error\">WebGL context: Not available</span>';\n+                    }\n+                }\n+            }, 1000);\n+\n+        } catch (error) {\n+            console.error('Test setup error:', error);\n+            document.getElementById('status').innerHTML = '<span class=\"error\">Test setup failed: ' + error.message + '</span>';\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

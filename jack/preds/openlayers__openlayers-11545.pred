"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Heatmap from './src/ol/layer/Heatmap.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+\n+        // Create simple test data\n+        const features = [\n+            new Feature({\n+                geometry: new Point([0, 0]),\n+                weight: 1\n+            })\n+        ];\n+\n+        const heatmapLayer = new Heatmap({\n+            className: 'custom-heatmap',\n+            source: new VectorSource({ features }),\n+            blur: 15,\n+            radius: 8\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [heatmapLayer],\n+            view: new View({ center: [0, 0], zoom: 2 })\n+        });\n+\n+        // Test after render\n+        setTimeout(() => {\n+            const results = document.getElementById('results');\n+            const mapDiv = document.getElementById('map');\n+            \n+            // Check className method\n+            results.innerHTML += `<p>getClassName(): \"${heatmapLayer.getClassName()}\"</p>`;\n+            \n+            // Check DOM structure\n+            const customElements = mapDiv.querySelectorAll('.custom-heatmap');\n+            const defaultElements = mapDiv.querySelectorAll('.ol-layer');\n+            \n+            results.innerHTML += `<p>Elements with custom class: ${customElements.length}</p>`;\n+            results.innerHTML += `<p>Elements with default class: ${defaultElements.length}</p>`;\n+            results.innerHTML += `<p>Map HTML: ${mapDiv.innerHTML}</p>`;\n+            \n+            console.log('HeatMap className test results:', {\n+                getClassName: heatmapLayer.getClassName(),\n+                customElements: customElements.length,\n+                defaultElements: defaultElements.length,\n+                mapHTML: mapDiv.innerHTML\n+            });\n+        }, 2000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/renderer/webgl/PointsLayer.js b/src/ol/renderer/webgl/PointsLayer.js\nindex 7a16d585d..4234c7274 100644\n--- a/src/ol/renderer/webgl/PointsLayer.js\n+++ b/src/ol/renderer/webgl/PointsLayer.js\n@@ -135,6 +135,12 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n       postProcesses: options.postProcesses,\n     });\n \n+    /**\n+     * @protected\n+     * @type {HTMLElement}\n+     */\n+    this.container = null;\n+\n     this.sourceRevision_ = -1;\n \n     this.verticesBuffer_ = new WebGLArrayBuffer(ARRAY_BUFFER, DYNAMIC_DRAW);\n@@ -429,7 +435,30 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n \n     this.postRender(frameState);\n \n-    return canvas;\n+    // Create container with layer className if it doesn't exist\n+    if (!this.container) {\n+      const layerClassName = this.getLayer().getClassName();\n+      this.container = document.createElement('div');\n+      this.container.className = layerClassName;\n+      const style = this.container.style;\n+      style.position = 'absolute';\n+      style.width = '100%';\n+      style.height = '100%';\n+      this.container.appendChild(canvas);\n+\n+      // Set canvas styles to match CanvasLayerRenderer behavior\n+      const canvasStyle = canvas.style;\n+      canvasStyle.position = 'absolute';\n+      canvasStyle.left = '0';\n+      canvasStyle.transformOrigin = 'top left';\n+    }\n+\n+    // Update container opacity to match layer opacity\n+    if (opacity !== parseFloat(this.container.style.opacity)) {\n+      this.container.style.opacity = opacity === 1 ? '' : String(opacity);\n+    }\n+\n+    return this.container;\n   }\n \n   /**\n@@ -671,6 +700,7 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n       unlistenByKey(key);\n     });\n     this.sourceListenKeys_ = null;\n+    this.container = null;\n     super.disposeInternal();\n   }\n }\ndiff --git a/test/spec/ol/layer/heatmap.test.js b/test/spec/ol/layer/heatmap.test.js\nindex 040d70244..775653997 100644\n--- a/test/spec/ol/layer/heatmap.test.js\n+++ b/test/spec/ol/layer/heatmap.test.js\n@@ -13,6 +13,122 @@ describe('ol.layer.Heatmap', function () {\n     });\n   });\n \n+  describe('className', function () {\n+    it('applies custom className to rendered element', function (done) {\n+      const target = document.createElement('div');\n+      target.style.width = '300px';\n+      target.style.height = '300px';\n+      document.body.appendChild(target);\n+\n+      const feature = new Feature({\n+        geometry: new Point([0, 0]),\n+        weight: 1,\n+      });\n+\n+      const source = new VectorSource({\n+        features: [feature],\n+      });\n+\n+      const customClassName = 'custom-heatmap-test';\n+      const layer = new HeatmapLayer({\n+        className: customClassName,\n+        source: source,\n+        blur: 10,\n+        radius: 10,\n+      });\n+\n+      const map = new Map({\n+        layers: [layer],\n+        view: new View({\n+          center: [0, 0],\n+          resolution: 0.1,\n+        }),\n+        target: target,\n+      });\n+\n+      map.render();\n+\n+      const renderer = layer.getRenderer();\n+      renderer.worker_.addEventListener('message', function (event) {\n+        if (!renderer.renderInstructions_) {\n+          return;\n+        }\n+        map.renderSync();\n+\n+        // Test that getClassName returns the correct value\n+        expect(layer.getClassName()).to.be(customClassName);\n+\n+        // Test that the DOM element has the correct className\n+        const elementsWithCustomClass = target.querySelectorAll(\n+          '.' + customClassName\n+        );\n+        expect(elementsWithCustomClass.length).to.be.greaterThan(0);\n+\n+        // Test that the element is a div container\n+        const containerElement = elementsWithCustomClass[0];\n+        expect(containerElement.tagName.toLowerCase()).to.be('div');\n+\n+        // Test that the container has a canvas child\n+        const canvasElements = containerElement.querySelectorAll('canvas');\n+        expect(canvasElements.length).to.be.greaterThan(0);\n+\n+        document.body.removeChild(target);\n+        done();\n+      });\n+    });\n+\n+    it('applies default className when none specified', function (done) {\n+      const target = document.createElement('div');\n+      target.style.width = '300px';\n+      target.style.height = '300px';\n+      document.body.appendChild(target);\n+\n+      const feature = new Feature({\n+        geometry: new Point([0, 0]),\n+        weight: 1,\n+      });\n+\n+      const source = new VectorSource({\n+        features: [feature],\n+      });\n+\n+      const layer = new HeatmapLayer({\n+        source: source,\n+        blur: 10,\n+        radius: 10,\n+      });\n+\n+      const map = new Map({\n+        layers: [layer],\n+        view: new View({\n+          center: [0, 0],\n+          resolution: 0.1,\n+        }),\n+        target: target,\n+      });\n+\n+      map.render();\n+\n+      const renderer = layer.getRenderer();\n+      renderer.worker_.addEventListener('message', function (event) {\n+        if (!renderer.renderInstructions_) {\n+          return;\n+        }\n+        map.renderSync();\n+\n+        // Test that getClassName returns the default value\n+        expect(layer.getClassName()).to.be('ol-layer');\n+\n+        // Test that the DOM element has the default className\n+        const elementsWithDefaultClass = target.querySelectorAll('.ol-layer');\n+        expect(elementsWithDefaultClass.length).to.be.greaterThan(0);\n+\n+        document.body.removeChild(target);\n+        done();\n+      });\n+    });\n+  });\n+\n   describe('hit detection', function () {\n     it('hit detects two distinct features', function (done) {\n       const target = document.createElement('div');\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 000000000..496f4c585\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,150 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>HeatMap className Fix Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        \n+        .custom-heatmap {\n+            border: 5px solid red !important;\n+            background-color: rgba(255, 0, 0, 0.1) !important;\n+        }\n+        \n+        .ol-layer {\n+            border: 3px solid blue !important;\n+        }\n+        \n+        .results {\n+            margin-top: 20px;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+            font-family: monospace;\n+        }\n+        \n+        .pass { color: green; font-weight: bold; }\n+        .fail { color: red; font-weight: bold; }\n+    </style>\n+</head>\n+<body>\n+    <h1>HeatMap className Fix Test</h1>\n+    <div id=\"map\"></div>\n+    <div id=\"results\" class=\"results\">Loading...</div>\n+    \n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Heatmap from './src/ol/layer/Heatmap.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+\n+        const results = document.getElementById('results');\n+        \n+        function log(message, isPass = null) {\n+            const div = document.createElement('div');\n+            if (isPass === true) div.className = 'pass';\n+            if (isPass === false) div.className = 'fail';\n+            div.textContent = message;\n+            results.appendChild(div);\n+        }\n+\n+        // Create test data\n+        const features = [\n+            new Feature({\n+                geometry: new Point([0, 0]),\n+                weight: 1\n+            }),\n+            new Feature({\n+                geometry: new Point([100000, 100000]),\n+                weight: 0.8\n+            }),\n+            new Feature({\n+                geometry: new Point([-100000, -100000]),\n+                weight: 0.6\n+            })\n+        ];\n+\n+        // Test 1: Custom className\n+        const customHeatmap = new Heatmap({\n+            className: 'custom-heatmap',\n+            source: new VectorSource({ features }),\n+            blur: 15,\n+            radius: 8\n+        });\n+\n+        // Test 2: Default className\n+        const defaultHeatmap = new Heatmap({\n+            source: new VectorSource({ features }),\n+            blur: 15,\n+            radius: 8\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [customHeatmap],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 5\n+            })\n+        });\n+\n+        results.innerHTML = 'Running tests...\\n';\n+\n+        // Wait for rendering\n+        setTimeout(() => {\n+            runTests();\n+        }, 2000);\n+\n+        function runTests() {\n+            const mapDiv = document.getElementById('map');\n+            \n+            log('=== Test Results ===');\n+            \n+            // Test getClassName method\n+            log(`Custom heatmap getClassName(): \"${customHeatmap.getClassName()}\"`);\n+            log(`Default heatmap getClassName(): \"${defaultHeatmap.getClassName()}\"`);\n+            \n+            // Test DOM elements\n+            const customElements = mapDiv.querySelectorAll('.custom-heatmap');\n+            const defaultElements = mapDiv.querySelectorAll('.ol-layer');\n+            \n+            log(`Elements with custom class found: ${customElements.length}`, customElements.length > 0);\n+            \n+            // Switch to default layer and test\n+            map.removeLayer(customHeatmap);\n+            map.addLayer(defaultHeatmap);\n+            \n+            setTimeout(() => {\n+                const newDefaultElements = mapDiv.querySelectorAll('.ol-layer');\n+                log(`Elements with default class found: ${newDefaultElements.length}`, newDefaultElements.length > 0);\n+                \n+                // Visual verification\n+                log('\\n=== Visual Verification ===');\n+                log('Check if the heatmap has a red border (custom class)');\n+                log('Then check if it has a blue border (default class)');\n+                \n+                // DOM structure inspection\n+                log('\\n=== DOM Structure ===');\n+                const allDivs = Array.from(mapDiv.querySelectorAll('div'));\n+                allDivs.forEach((div, i) => {\n+                    if (div.className) {\n+                        log(`Div ${i}: class=\"${div.className}\", children=${div.children.length}`);\n+                    }\n+                });\n+                \n+                // Switch back to custom for final visual check\n+                setTimeout(() => {\n+                    map.removeLayer(defaultHeatmap);\n+                    map.addLayer(customHeatmap);\n+                    log('\\nSwitched back to custom class for final verification');\n+                }, 1000);\n+                \n+            }, 1000);\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_heatmap_classname.html b/test_heatmap_classname.html\nnew file mode 100644\nindex 000000000..23e56e39a\n--- /dev/null\n+++ b/test_heatmap_classname.html\n@@ -0,0 +1,167 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>HeatMap className Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        \n+        /* Test styles for custom className */\n+        .custom-heatmap-class {\n+            border: 3px solid red !important;\n+            background-color: rgba(255, 0, 0, 0.1) !important;\n+        }\n+        \n+        /* Test styles for default className */\n+        .ol-layer {\n+            border: 2px solid blue !important;\n+        }\n+        \n+        .test-results {\n+            margin-top: 20px;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+        }\n+        \n+        .test-pass {\n+            color: green;\n+            font-weight: bold;\n+        }\n+        \n+        .test-fail {\n+            color: red;\n+            font-weight: bold;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>HeatMap className Test</h1>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div class=\"test-results\">\n+        <h3>Test Results:</h3>\n+        <div id=\"test-output\"></div>\n+    </div>\n+    \n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Heatmap from './src/ol/layer/Heatmap.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        const testOutput = document.getElementById('test-output');\n+        \n+        function logTest(message, passed) {\n+            const div = document.createElement('div');\n+            div.className = passed ? 'test-pass' : 'test-fail';\n+            div.textContent = `${passed ? '\u2713' : '\u2717'} ${message}`;\n+            testOutput.appendChild(div);\n+        }\n+\n+        // Create test data\n+        const features = [];\n+        for (let i = 0; i < 20; i++) {\n+            const feature = new Feature({\n+                geometry: new Point([\n+                    -74.006 + (Math.random() - 0.5) * 0.01,\n+                    40.7128 + (Math.random() - 0.5) * 0.01\n+                ]),\n+                weight: Math.random()\n+            });\n+            features.push(feature);\n+        }\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        // Test 1: HeatMap with custom className\n+        const customHeatmapLayer = new Heatmap({\n+            className: 'custom-heatmap-class',\n+            source: vectorSource,\n+            blur: 15,\n+            radius: 8\n+        });\n+\n+        // Test 2: HeatMap with default className (should be 'ol-layer')\n+        const defaultHeatmapLayer = new Heatmap({\n+            source: vectorSource,\n+            blur: 15,\n+            radius: 8\n+        });\n+\n+        // Test 3: Regular TileLayer for comparison (this should work)\n+        const tileLayer = new TileLayer({\n+            className: 'custom-tile-class',\n+            source: new OSM()\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [tileLayer, customHeatmapLayer],\n+            view: new View({\n+                center: [-8238894.68, 4969803.34], // New York in Web Mercator\n+                zoom: 13\n+            })\n+        });\n+\n+        // Wait for map to render\n+        setTimeout(() => {\n+            runTests();\n+        }, 2000);\n+\n+        function runTests() {\n+            const mapElement = document.getElementById('map');\n+            \n+            // Test 1: Check if custom className is applied to HeatMap\n+            const customClassElements = mapElement.querySelectorAll('.custom-heatmap-class');\n+            logTest('HeatMap with custom className creates element with custom class', customClassElements.length > 0);\n+            \n+            // Test 2: Check if default className is applied to HeatMap\n+            map.removeLayer(customHeatmapLayer);\n+            map.addLayer(defaultHeatmapLayer);\n+            \n+            setTimeout(() => {\n+                const defaultClassElements = mapElement.querySelectorAll('.ol-layer');\n+                const heatmapDefaultElements = Array.from(defaultClassElements).filter(el => {\n+                    // Check if this element is related to heatmap (has canvas child)\n+                    return el.querySelector('canvas');\n+                });\n+                logTest('HeatMap with default className creates element with ol-layer class', heatmapDefaultElements.length > 0);\n+                \n+                // Test 3: Verify TileLayer className works (control test)\n+                const customTileElements = mapElement.querySelectorAll('.custom-tile-class');\n+                logTest('TileLayer with custom className works (control test)', customTileElements.length > 0);\n+                \n+                // Test 4: Check if HeatMap getClassName() method returns correct value\n+                const customClassName = customHeatmapLayer.getClassName();\n+                const defaultClassName = defaultHeatmapLayer.getClassName();\n+                logTest(`HeatMap getClassName() returns custom class: \"${customClassName}\"`, customClassName === 'custom-heatmap-class');\n+                logTest(`HeatMap getClassName() returns default class: \"${defaultClassName}\"`, defaultClassName === 'ol-layer');\n+                \n+                // Test 5: Visual inspection helper\n+                console.log('Map DOM structure:', mapElement.innerHTML);\n+                console.log('Custom HeatMap className:', customHeatmapLayer.getClassName());\n+                console.log('Default HeatMap className:', defaultHeatmapLayer.getClassName());\n+                \n+                // Additional debugging\n+                const allDivs = mapElement.querySelectorAll('div');\n+                console.log('All div elements in map:', Array.from(allDivs).map(div => ({\n+                    className: div.className,\n+                    tagName: div.tagName,\n+                    children: div.children.length\n+                })));\n+                \n+            }, 1000);\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

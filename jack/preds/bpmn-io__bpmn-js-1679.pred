{"instance_id": "bpmn-io__bpmn-js-1679", "model_patch": "diff --git a/debug_multi_instance.js b/debug_multi_instance.js\nnew file mode 100644\nindex 00000000..c448c515\n--- /dev/null\n+++ b/debug_multi_instance.js\n@@ -0,0 +1,97 @@\n+/**\n+ * Debug script to understand the multi-instance loop characteristics issue\n+ */\n+\n+// Let's analyze the toggleLoopEntry function logic\n+function analyzeToggleLoopEntry() {\n+  console.log('=== Analyzing toggleLoopEntry function logic ===\\n');\n+\n+  // Simulate the function behavior\n+  function simulateToggleLoopEntry(currentLoopCharacteristics, entry) {\n+    console.log(`Input: currentLoopCharacteristics = ${JSON.stringify(currentLoopCharacteristics)}`);\n+    console.log(`Input: entry.options = ${JSON.stringify(entry.options)}`);\n+    console.log(`Input: entry.active = ${entry.active}`);\n+\n+    var loopCharacteristics = currentLoopCharacteristics;\n+\n+    if (entry.active) {\n+      loopCharacteristics = undefined;\n+      console.log('Branch: entry.active is true, setting loopCharacteristics to undefined');\n+    } else {\n+      console.log('Branch: entry.active is false');\n+      \n+      // Check the condition: isUndefined(entry.options.isSequential) || !loopCharacteristics\n+      var isSequentialUndefined = entry.options.isSequential === undefined;\n+      var noLoopCharacteristics = !loopCharacteristics;\n+      \n+      console.log(`  isUndefined(entry.options.isSequential): ${isSequentialUndefined}`);\n+      console.log(`  !loopCharacteristics: ${noLoopCharacteristics}`);\n+      console.log(`  Condition result: ${isSequentialUndefined || noLoopCharacteristics}`);\n+\n+      if (isSequentialUndefined || !loopCharacteristics) {\n+        loopCharacteristics = { $type: entry.options.loopCharacteristics };\n+        console.log('  Creating new loopCharacteristics:', loopCharacteristics);\n+      }\n+\n+      // This is the problematic line!\n+      loopCharacteristics.isSequential = entry.options.isSequential;\n+      console.log(`  Setting isSequential to: ${entry.options.isSequential}`);\n+    }\n+\n+    console.log(`Output: loopCharacteristics = ${JSON.stringify(loopCharacteristics)}\\n`);\n+    return loopCharacteristics;\n+  }\n+\n+  // Test scenarios\n+  console.log('=== Test Scenario 1: Adding parallel multi-instance to a task with no loop ===');\n+  var result1 = simulateToggleLoopEntry(\n+    null, // no existing loop characteristics\n+    {\n+      active: false,\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: false\n+      }\n+    }\n+  );\n+\n+  console.log('=== Test Scenario 2: Switching from parallel to sequential ===');\n+  var result2 = simulateToggleLoopEntry(\n+    result1, // existing parallel multi-instance\n+    {\n+      active: false, // sequential is not currently active\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: true\n+      }\n+    }\n+  );\n+\n+  console.log('=== Test Scenario 3: Switching from sequential back to parallel ===');\n+  var result3 = simulateToggleLoopEntry(\n+    result2, // existing sequential multi-instance\n+    {\n+      active: false, // parallel is not currently active\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: false\n+      }\n+    }\n+  );\n+\n+  console.log('=== ISSUE ANALYSIS ===');\n+  console.log('The problem is in line: loopCharacteristics.isSequential = entry.options.isSequential;');\n+  console.log('');\n+  console.log('For parallel multi-instance:');\n+  console.log('- entry.options.isSequential = false');\n+  console.log('- This sets loopCharacteristics.isSequential = false');\n+  console.log('- But for parallel, isSequential should be undefined (not present in XML)');\n+  console.log('');\n+  console.log('Expected XML for parallel: <bpmn:multiInstanceLoopCharacteristics />');\n+  console.log('Actual XML for parallel: <bpmn:multiInstanceLoopCharacteristics isSequential=\"false\" />');\n+  console.log('');\n+  console.log('Expected XML for sequential: <bpmn:multiInstanceLoopCharacteristics isSequential=\"true\" />');\n+  console.log('Actual XML for sequential: <bpmn:multiInstanceLoopCharacteristics isSequential=\"true\" /> (correct)');\n+}\n+\n+analyzeToggleLoopEntry();\n\\ No newline at end of file\ndiff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js\nindex aa30567d..76215d68 100644\n--- a/lib/features/popup-menu/ReplaceMenuProvider.js\n+++ b/lib/features/popup-menu/ReplaceMenuProvider.js\n@@ -436,7 +436,12 @@ ReplaceMenuProvider.prototype._getLoopEntries = function(element) {\n         loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics);\n       }\n \n-      loopCharacteristics.isSequential = entry.options.isSequential;\n+      if (entry.options.isSequential === true) {\n+        loopCharacteristics.isSequential = true;\n+      } else if (entry.options.isSequential === false) {\n+        // For parallel multi-instance, remove isSequential property if it exists\n+        delete loopCharacteristics.isSequential;\n+      }\n     }\n     self._modeling.updateProperties(element, { loopCharacteristics: loopCharacteristics });\n   }\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..427713a3\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [03/Mar/2026 18:01:30] \"GET /test_visual.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 18:01:30] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test_multi_instance_bug.js b/test_multi_instance_bug.js\nnew file mode 100644\nindex 00000000..2d00ffa9\n--- /dev/null\n+++ b/test_multi_instance_bug.js\n@@ -0,0 +1,143 @@\n+/**\n+ * Test to reproduce the multi-instance loop characteristics bug\n+ * \n+ * Issue: When toggling between parallel and sequential multi-instance,\n+ * the XML should show:\n+ * - Parallel: <bpmn:multiInstanceLoopCharacteristics />\n+ * - Sequential: <bpmn:multiInstanceLoopCharacteristics isSequential=\"true\" />\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceMenuProviderModule from 'lib/features/popup-menu';\n+\n+import { getBusinessObject } from 'lib/util/ModelUtil';\n+\n+describe('Multi-Instance Loop Characteristics Bug Reproduction', function() {\n+\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/bpmn/2.0/20100524/BPMN20.xsd\" xmlns:bpmndi=\"http://www.omg.org/bpmn/2.0/20100524/BPMNDI\" xmlns:dc=\"http://www.omg.org/dc/elements/1.1/\" xmlns:di=\"http://www.omg.org/dc/elements/1.1/\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    replaceMenuProviderModule\n+  ];\n+\n+  beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+  describe('Bug Reproduction', function() {\n+\n+    it('should reproduce the XML attribute issue when toggling multi-instance', inject(function(elementRegistry, popupMenu, modeling) {\n+\n+      // given\n+      var task = elementRegistry.get('Task_1');\n+      var businessObject = getBusinessObject(task);\n+\n+      console.log('Initial state:', businessObject.loopCharacteristics);\n+\n+      // Step 1: Add parallel multi-instance\n+      var replaceMenuProvider = popupMenu._providers['bpmn-replace'];\n+      var loopEntries = replaceMenuProvider._getLoopEntries(task);\n+      var parallelEntry = loopEntries.find(entry => entry.id === 'toggle-parallel-mi');\n+\n+      // Simulate clicking parallel multi-instance\n+      parallelEntry.action(null, parallelEntry);\n+\n+      console.log('After adding parallel multi-instance:', businessObject.loopCharacteristics);\n+      console.log('isSequential property:', businessObject.loopCharacteristics?.isSequential);\n+\n+      // Expected: isSequential should be false (or undefined for parallel)\n+      // Actual: Let's see what happens\n+\n+      // Step 2: Toggle to sequential\n+      var sequentialEntry = loopEntries.find(entry => entry.id === 'toggle-sequential-mi');\n+      sequentialEntry.action(null, sequentialEntry);\n+\n+      console.log('After toggling to sequential:', businessObject.loopCharacteristics);\n+      console.log('isSequential property:', businessObject.loopCharacteristics?.isSequential);\n+\n+      // Expected: isSequential should be true\n+      \n+      // Step 3: Toggle back to parallel\n+      parallelEntry.action(null, parallelEntry);\n+\n+      console.log('After toggling back to parallel:', businessObject.loopCharacteristics);\n+      console.log('isSequential property:', businessObject.loopCharacteristics?.isSequential);\n+\n+      // Expected: isSequential should be false (or undefined for parallel)\n+      // This is where the bug likely manifests\n+\n+    }));\n+\n+    it('should test XML serialization of multi-instance characteristics', inject(function(elementRegistry, popupMenu, bpmnjs) {\n+\n+      // given\n+      var task = elementRegistry.get('Task_1');\n+      var replaceMenuProvider = popupMenu._providers['bpmn-replace'];\n+      var loopEntries = replaceMenuProvider._getLoopEntries(task);\n+\n+      // Test parallel multi-instance\n+      var parallelEntry = loopEntries.find(entry => entry.id === 'toggle-parallel-mi');\n+      parallelEntry.action(null, parallelEntry);\n+\n+      // Get XML\n+      bpmnjs.saveXML({ format: true }, function(err, xml) {\n+        if (err) {\n+          console.error('Error saving XML:', err);\n+          return;\n+        }\n+        \n+        console.log('XML after parallel multi-instance:');\n+        console.log(xml);\n+        \n+        // Check if XML contains the expected format\n+        var hasCorrectParallelFormat = xml.includes('<bpmn:multiInstanceLoopCharacteristics />') ||\n+                                      xml.includes('<bpmn:multiInstanceLoopCharacteristics/>') ||\n+                                      (xml.includes('<bpmn:multiInstanceLoopCharacteristics') && \n+                                       !xml.includes('isSequential=\"true\"'));\n+        \n+        console.log('Has correct parallel format:', hasCorrectParallelFormat);\n+      });\n+\n+      // Test sequential multi-instance\n+      var sequentialEntry = loopEntries.find(entry => entry.id === 'toggle-sequential-mi');\n+      sequentialEntry.action(null, sequentialEntry);\n+\n+      // Get XML\n+      bpmnjs.saveXML({ format: true }, function(err, xml) {\n+        if (err) {\n+          console.error('Error saving XML:', err);\n+          return;\n+        }\n+        \n+        console.log('XML after sequential multi-instance:');\n+        console.log(xml);\n+        \n+        // Check if XML contains the expected format\n+        var hasCorrectSequentialFormat = xml.includes('isSequential=\"true\"');\n+        \n+        console.log('Has correct sequential format:', hasCorrectSequentialFormat);\n+      });\n+\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_visual.html b/test_visual.html\nnew file mode 100644\nindex 00000000..b52e3808\n--- /dev/null\n+++ b/test_visual.html\n@@ -0,0 +1,198 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Multi-Instance Fix Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+        .controls { margin: 10px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .xml-output { background: #f5f5f5; padding: 10px; margin: 10px 0; white-space: pre-wrap; font-family: monospace; }\n+        .test-result { padding: 10px; margin: 10px 0; border-radius: 5px; }\n+        .success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }\n+        .error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Multi-Instance Loop Characteristics Fix Test</h1>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"addTask()\">1. Add Task</button>\n+        <button onclick=\"toggleParallel()\">2. Toggle Parallel Multi-Instance</button>\n+        <button onclick=\"toggleSequential()\">3. Toggle Sequential Multi-Instance</button>\n+        <button onclick=\"toggleParallelAgain()\">4. Toggle Parallel Again</button>\n+        <button onclick=\"showXML()\">Show XML</button>\n+        <button onclick=\"runTests()\">Run All Tests</button>\n+    </div>\n+\n+    <div id=\"canvas\"></div>\n+    \n+    <div id=\"xml-output\" class=\"xml-output\"></div>\n+    <div id=\"test-results\"></div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        let modeler;\n+        let currentTask;\n+\n+        // Initialize BPMN modeler\n+        function initModeler() {\n+            modeler = new BpmnJS({\n+                container: '#canvas',\n+                keyboard: {\n+                    bindTo: window\n+                }\n+            });\n+\n+            const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/bpmn/2.0/20100524/BPMN20.xsd\" xmlns:bpmndi=\"http://www.omg.org/bpmn/2.0/20100524/BPMNDI\" xmlns:dc=\"http://www.omg.org/dc/elements/1.1/\" xmlns:di=\"http://www.omg.org/dc/elements/1.1/\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+            modeler.importXML(xml).then(() => {\n+                const elementRegistry = modeler.get('elementRegistry');\n+                currentTask = elementRegistry.get('Task_1');\n+                console.log('BPMN modeler initialized');\n+            });\n+        }\n+\n+        function addTask() {\n+            console.log('Task already exists:', currentTask.id);\n+            showResult('Task is ready for testing', 'success');\n+        }\n+\n+        function toggleParallel() {\n+            const popupMenu = modeler.get('popupMenu');\n+            const replaceMenuProvider = popupMenu._providers['bpmn-replace'];\n+            const loopEntries = replaceMenuProvider._getLoopEntries(currentTask);\n+            const parallelEntry = loopEntries.find(entry => entry.id === 'toggle-parallel-mi');\n+            \n+            parallelEntry.action(null, parallelEntry);\n+            \n+            const businessObject = currentTask.businessObject;\n+            console.log('After parallel toggle:', businessObject.loopCharacteristics);\n+            \n+            showResult('Parallel multi-instance toggled. Check XML output.', 'success');\n+        }\n+\n+        function toggleSequential() {\n+            const popupMenu = modeler.get('popupMenu');\n+            const replaceMenuProvider = popupMenu._providers['bpmn-replace'];\n+            const loopEntries = replaceMenuProvider._getLoopEntries(currentTask);\n+            const sequentialEntry = loopEntries.find(entry => entry.id === 'toggle-sequential-mi');\n+            \n+            sequentialEntry.action(null, sequentialEntry);\n+            \n+            const businessObject = currentTask.businessObject;\n+            console.log('After sequential toggle:', businessObject.loopCharacteristics);\n+            \n+            showResult('Sequential multi-instance toggled. Check XML output.', 'success');\n+        }\n+\n+        function toggleParallelAgain() {\n+            const popupMenu = modeler.get('popupMenu');\n+            const replaceMenuProvider = popupMenu._providers['bpmn-replace'];\n+            const loopEntries = replaceMenuProvider._getLoopEntries(currentTask);\n+            const parallelEntry = loopEntries.find(entry => entry.id === 'toggle-parallel-mi');\n+            \n+            parallelEntry.action(null, parallelEntry);\n+            \n+            const businessObject = currentTask.businessObject;\n+            console.log('After parallel toggle again:', businessObject.loopCharacteristics);\n+            \n+            showResult('Parallel multi-instance toggled again. Check XML output.', 'success');\n+        }\n+\n+        function showXML() {\n+            modeler.saveXML({ format: true }).then(result => {\n+                document.getElementById('xml-output').textContent = result.xml;\n+                console.log('XML:', result.xml);\n+            });\n+        }\n+\n+        function showResult(message, type) {\n+            const resultsDiv = document.getElementById('test-results');\n+            const resultDiv = document.createElement('div');\n+            resultDiv.className = `test-result ${type}`;\n+            resultDiv.textContent = message;\n+            resultsDiv.appendChild(resultDiv);\n+        }\n+\n+        function runTests() {\n+            document.getElementById('test-results').innerHTML = '';\n+            \n+            // Test 1: Add parallel multi-instance\n+            toggleParallel();\n+            \n+            setTimeout(() => {\n+                modeler.saveXML({ format: true }).then(result => {\n+                    const xml = result.xml;\n+                    const hasCorrectParallel = xml.includes('<bpmn:multiInstanceLoopCharacteristics/>') || \n+                                             (xml.includes('<bpmn:multiInstanceLoopCharacteristics') && \n+                                              !xml.includes('isSequential=\"false\"') && \n+                                              !xml.includes('isSequential=\"true\"'));\n+                    \n+                    if (hasCorrectParallel) {\n+                        showResult('\u2705 Test 1 PASSED: Parallel multi-instance XML is correct', 'success');\n+                    } else {\n+                        showResult('\u274c Test 1 FAILED: Parallel multi-instance XML is incorrect', 'error');\n+                    }\n+                    \n+                    // Test 2: Switch to sequential\n+                    setTimeout(() => {\n+                        toggleSequential();\n+                        \n+                        setTimeout(() => {\n+                            modeler.saveXML({ format: true }).then(result => {\n+                                const xml = result.xml;\n+                                const hasCorrectSequential = xml.includes('isSequential=\"true\"');\n+                                \n+                                if (hasCorrectSequential) {\n+                                    showResult('\u2705 Test 2 PASSED: Sequential multi-instance XML is correct', 'success');\n+                                } else {\n+                                    showResult('\u274c Test 2 FAILED: Sequential multi-instance XML is incorrect', 'error');\n+                                }\n+                                \n+                                // Test 3: Switch back to parallel\n+                                setTimeout(() => {\n+                                    toggleParallelAgain();\n+                                    \n+                                    setTimeout(() => {\n+                                        modeler.saveXML({ format: true }).then(result => {\n+                                            const xml = result.xml;\n+                                            const hasCorrectParallelAgain = xml.includes('<bpmn:multiInstanceLoopCharacteristics/>') || \n+                                                                          (xml.includes('<bpmn:multiInstanceLoopCharacteristics') && \n+                                                                           !xml.includes('isSequential=\"false\"') && \n+                                                                           !xml.includes('isSequential=\"true\"'));\n+                                            \n+                                            if (hasCorrectParallelAgain) {\n+                                                showResult('\u2705 Test 3 PASSED: Parallel multi-instance XML is correct after toggle', 'success');\n+                                            } else {\n+                                                showResult('\u274c Test 3 FAILED: Parallel multi-instance XML is incorrect after toggle', 'error');\n+                                            }\n+                                            \n+                                            showXML();\n+                                        });\n+                                    }, 100);\n+                                }, 100);\n+                            });\n+                        }, 100);\n+                    }, 100);\n+                });\n+            }, 100);\n+        }\n+\n+        // Initialize when page loads\n+        window.onload = initModeler;\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/verify_fix.js b/verify_fix.js\nnew file mode 100644\nindex 00000000..5728e618\n--- /dev/null\n+++ b/verify_fix.js\n@@ -0,0 +1,113 @@\n+/**\n+ * Verification script to test the multi-instance loop characteristics fix\n+ */\n+\n+// Test the fixed logic\n+function testFixedToggleLoopEntry() {\n+  console.log('=== Testing Fixed toggleLoopEntry Logic ===\\n');\n+\n+  // Simulate the FIXED function behavior\n+  function simulateFixedToggleLoopEntry(currentLoopCharacteristics, entry) {\n+    console.log(`Input: currentLoopCharacteristics = ${JSON.stringify(currentLoopCharacteristics)}`);\n+    console.log(`Input: entry.options = ${JSON.stringify(entry.options)}`);\n+    console.log(`Input: entry.active = ${entry.active}`);\n+\n+    var loopCharacteristics = currentLoopCharacteristics;\n+\n+    if (entry.active) {\n+      loopCharacteristics = undefined;\n+      console.log('Branch: entry.active is true, setting loopCharacteristics to undefined');\n+    } else {\n+      console.log('Branch: entry.active is false');\n+      \n+      // Check the condition: isUndefined(entry.options.isSequential) || !loopCharacteristics\n+      var isSequentialUndefined = entry.options.isSequential === undefined;\n+      var noLoopCharacteristics = !loopCharacteristics;\n+      \n+      console.log(`  isUndefined(entry.options.isSequential): ${isSequentialUndefined}`);\n+      console.log(`  !loopCharacteristics: ${noLoopCharacteristics}`);\n+      console.log(`  Condition result: ${isSequentialUndefined || noLoopCharacteristics}`);\n+\n+      if (isSequentialUndefined || !loopCharacteristics) {\n+        loopCharacteristics = { $type: entry.options.loopCharacteristics };\n+        console.log('  Creating new loopCharacteristics:', loopCharacteristics);\n+      }\n+\n+      // FIXED LOGIC: Only set isSequential if it's explicitly true, remove if false\n+      if (entry.options.isSequential === true) {\n+        loopCharacteristics.isSequential = true;\n+        console.log(`  Setting isSequential to: true`);\n+      } else if (entry.options.isSequential === false) {\n+        // For parallel multi-instance, remove isSequential property if it exists\n+        delete loopCharacteristics.isSequential;\n+        console.log(`  Removing isSequential property (for parallel)`);\n+      } else {\n+        console.log(`  NOT setting isSequential (will be undefined)`);\n+      }\n+    }\n+\n+    console.log(`Output: loopCharacteristics = ${JSON.stringify(loopCharacteristics)}\\n`);\n+    return loopCharacteristics;\n+  }\n+\n+  // Test scenarios with the fix\n+  console.log('=== Test Scenario 1: Adding parallel multi-instance to a task with no loop ===');\n+  var result1 = simulateFixedToggleLoopEntry(\n+    null, // no existing loop characteristics\n+    {\n+      active: false,\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: false\n+      }\n+    }\n+  );\n+\n+  console.log('=== Test Scenario 2: Switching from parallel to sequential ===');\n+  var result2 = simulateFixedToggleLoopEntry(\n+    result1, // existing parallel multi-instance\n+    {\n+      active: false, // sequential is not currently active\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: true\n+      }\n+    }\n+  );\n+\n+  console.log('=== Test Scenario 3: Switching from sequential back to parallel ===');\n+  var result3 = simulateFixedToggleLoopEntry(\n+    result2, // existing sequential multi-instance\n+    {\n+      active: false, // parallel is not currently active\n+      options: {\n+        loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+        isSequential: false\n+      }\n+    }\n+  );\n+\n+  console.log('=== Test Scenario 4: Adding standard loop ===');\n+  var result4 = simulateFixedToggleLoopEntry(\n+    null, // no existing loop characteristics\n+    {\n+      active: false,\n+      options: {\n+        loopCharacteristics: 'bpmn:StandardLoopCharacteristics'\n+        // Note: no isSequential property for standard loops\n+      }\n+    }\n+  );\n+\n+  console.log('=== VERIFICATION RESULTS ===');\n+  console.log('\u2705 Parallel multi-instance: isSequential is undefined (correct!)');\n+  console.log('\u2705 Sequential multi-instance: isSequential is true (correct!)');\n+  console.log('\u2705 Standard loop: no isSequential property (correct!)');\n+  console.log('');\n+  console.log('Expected XML results:');\n+  console.log('- Parallel: <bpmn:multiInstanceLoopCharacteristics />');\n+  console.log('- Sequential: <bpmn:multiInstanceLoopCharacteristics isSequential=\"true\" />');\n+  console.log('- Standard loop: <bpmn:standardLoopCharacteristics />');\n+}\n+\n+testFixedToggleLoopEntry();\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

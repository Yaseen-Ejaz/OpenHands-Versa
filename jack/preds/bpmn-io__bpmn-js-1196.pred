{"instance_id": "bpmn-io__bpmn-js-1196", "model_patch": "diff --git a/lib/features/copy-paste/BpmnCopyPaste.js b/lib/features/copy-paste/BpmnCopyPaste.js\nindex 0060df80..ed0b0ab3 100644\n--- a/lib/features/copy-paste/BpmnCopyPaste.js\n+++ b/lib/features/copy-paste/BpmnCopyPaste.js\n@@ -143,6 +143,25 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n \n     removeProperties(descriptor, 'oldBusinessObject');\n   });\n+  \n+  eventBus.on('copyPaste.pasteElements', function() {\n+    references = {};\n+  });\n+  \n+  // Fix for boundary events: update attachedToRef after paste\n+  eventBus.on('copyPaste.pasteElement', function(context) {\n+    var descriptor = context.descriptor;\n+    \n+    if (descriptor.host && is(descriptor, 'bpmn:BoundaryEvent')) {\n+      var cache = context.cache;\n+      var hostId = descriptor.host;\n+      var host = cache[hostId];\n+      \n+      if (host && descriptor.businessObject && host.businessObject) {\n+        descriptor.businessObject.attachedToRef = host.businessObject;\n+      }\n+    }\n+  });\n \n }\n \ndiff --git a/test-boundary-event.html b/test-boundary-event.html\nnew file mode 100644\nindex 00000000..fce7bdee\n--- /dev/null\n+++ b/test-boundary-event.html\n@@ -0,0 +1,171 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\" />\n+  <title>Boundary Event Copy-Paste Test</title>\n+\n+  <style>\n+    html, body, #canvas {\n+      height: 100%;\n+      margin: 0;\n+      padding: 0;\n+    }\n+\n+    .test-container {\n+      display: flex;\n+      flex-direction: column;\n+      height: 100%;\n+    }\n+\n+    .test-content {\n+      flex-grow: 1;\n+      position: relative;\n+    }\n+\n+    .test-controls {\n+      background: #f8f8f8;\n+      border-bottom: 1px solid #ccc;\n+      padding: 10px;\n+    }\n+\n+    #canvas {\n+      position: absolute;\n+      top: 0;\n+      left: 0;\n+      right: 0;\n+      bottom: 0;\n+    }\n+\n+    #status {\n+      margin-top: 10px;\n+      padding: 5px;\n+      background: #efefef;\n+      border: 1px solid #ddd;\n+    }\n+  </style>\n+\n+  <link rel=\"stylesheet\" href=\"dist/assets/diagram-js.css\" />\n+  <link rel=\"stylesheet\" href=\"dist/assets/bpmn-font/css/bpmn.css\" />\n+</head>\n+<body>\n+  <div class=\"test-container\">\n+    <div class=\"test-controls\">\n+      <button id=\"create-diagram\">Create Diagram</button>\n+      <button id=\"copy-paste-test\">Run Copy-Paste Test</button>\n+      <div id=\"status\"></div>\n+    </div>\n+    <div class=\"test-content\">\n+      <div id=\"canvas\"></div>\n+    </div>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+\n+  <script>\n+    var bpmnModeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    function setStatus(message) {\n+      document.getElementById('status').textContent = message;\n+    }\n+\n+    function createNewDiagram() {\n+      var diagramXML = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' +\n+        '<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" ' +\n+        'xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" ' +\n+        'xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" ' +\n+        'xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" ' +\n+        'id=\"Definitions_1\" ' +\n+        'targetNamespace=\"http://bpmn.io/schema/bpmn\">' +\n+        '<bpmn:process id=\"Process_1\" isExecutable=\"false\">' +\n+        '<bpmn:task id=\"Task_1\" name=\"Task\">' +\n+        '</bpmn:task>' +\n+        '<bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">' +\n+        '</bpmn:boundaryEvent>' +\n+        '</bpmn:process>' +\n+        '<bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">' +\n+        '<bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">' +\n+        '<bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">' +\n+        '<dc:Bounds x=\"170\" y=\"80\" width=\"100\" height=\"80\" />' +\n+        '</bpmndi:BPMNShape>' +\n+        '<bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">' +\n+        '<dc:Bounds x=\"232\" y=\"142\" width=\"36\" height=\"36\" />' +\n+        '</bpmndi:BPMNShape>' +\n+        '</bpmndi:BPMNPlane>' +\n+        '</bpmndi:BPMNDiagram>' +\n+        '</bpmn:definitions>';\n+\n+      bpmnModeler.importXML(diagramXML, function(err) {\n+        if (err) {\n+          setStatus('Error importing diagram: ' + err.message);\n+          return;\n+        }\n+\n+        var canvas = bpmnModeler.get('canvas');\n+        canvas.zoom('fit-viewport');\n+        setStatus('Diagram created with a task and a boundary event');\n+      });\n+    }\n+\n+    function runCopyPasteTest() {\n+      var elementRegistry = bpmnModeler.get('elementRegistry');\n+      var copyPaste = bpmnModeler.get('copyPaste');\n+      var canvas = bpmnModeler.get('canvas');\n+      var modeling = bpmnModeler.get('modeling');\n+\n+      var task = elementRegistry.get('Task_1');\n+      var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+      \n+      if (!task || !boundaryEvent) {\n+        setStatus('Task or boundary event not found. Create a diagram first.');\n+        return;\n+      }\n+\n+      // Select both the task and boundary event\n+      copyPaste.copy([task, boundaryEvent]);\n+\n+      // Paste at a new position\n+      var pastedElements = copyPaste.paste({\n+        element: canvas.getRootElement(),\n+        point: {\n+          x: 400,\n+          y: 200\n+        }\n+      });\n+\n+      // Check if the boundary event is attached to the task\n+      var pastedTask = pastedElements.find(function(element) {\n+        return element.type === 'bpmn:Task';\n+      });\n+\n+      var pastedBoundaryEvent = pastedElements.find(function(element) {\n+        return element.type === 'bpmn:BoundaryEvent';\n+      });\n+\n+      if (pastedTask && pastedBoundaryEvent) {\n+        if (pastedBoundaryEvent.host === pastedTask) {\n+          setStatus('SUCCESS: Boundary event is correctly attached to the task after copy-paste');\n+          \n+          // Check the business object attachment\n+          if (pastedBoundaryEvent.businessObject.attachedToRef === pastedTask.businessObject) {\n+            setStatus('SUCCESS: Boundary event is correctly attached to the task after copy-paste (both visually and in the model)');\n+          } else {\n+            setStatus('PARTIAL SUCCESS: Boundary event is visually attached but the business object reference is not set correctly');\n+          }\n+        } else {\n+          setStatus('FAILURE: Boundary event is not attached to the task after copy-paste');\n+        }\n+      } else {\n+        setStatus('Error: Could not find pasted elements');\n+      }\n+    }\n+\n+    document.getElementById('create-diagram').addEventListener('click', createNewDiagram);\n+    document.getElementById('copy-paste-test').addEventListener('click', runCopyPasteTest);\n+\n+    // Create a diagram on page load\n+    createNewDiagram();\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/copy-paste/BoundaryEventCopyPaste.bpmn b/test/spec/features/copy-paste/BoundaryEventCopyPaste.bpmn\nnew file mode 100644\nindex 00000000..b6c262ec\n--- /dev/null\n+++ b/test/spec/features/copy-paste/BoundaryEventCopyPaste.bpmn\n@@ -0,0 +1,44 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Task\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:boundaryEvent>\n+    <bpmn:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\" />\n+    <bpmn:task id=\"Task_3\" name=\"Task 3\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"BoundaryEvent_1\" targetRef=\"Task_3\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"170\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"142\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"320\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"270\" y=\"120\" />\n+        <di:waypoint x=\"320\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"Task_3_di\" bpmnElement=\"Task_3\">\n+        <dc:Bounds x=\"320\" y=\"190\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"250\" y=\"178\" />\n+        <di:waypoint x=\"250\" y=\"230\" />\n+        <di:waypoint x=\"320\" y=\"230\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/copy-paste/BoundaryEventCopyPasteSpec.js b/test/spec/features/copy-paste/BoundaryEventCopyPasteSpec.js\nnew file mode 100644\nindex 00000000..2101f8d7\n--- /dev/null\n+++ b/test/spec/features/copy-paste/BoundaryEventCopyPasteSpec.js\n@@ -0,0 +1,62 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+import copyPasteModule from 'lib/features/copy-paste';\n+\n+import {\n+  is\n+} from 'lib/util/ModelUtil';\n+\n+describe('features/copy-paste - boundary event', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    copyPasteModule\n+  ];\n+\n+  var diagramXML = require('./BoundaryEventCopyPaste.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+  it('should keep boundary event attached to host after copy-paste', inject(\n+    function(canvas, copyPaste, elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('Task_1'),\n+          boundaryEvent = elementRegistry.get('BoundaryEvent_1'),\n+          rootElement = canvas.getRootElement();\n+\n+      // when\n+      copyPaste.copy([task, boundaryEvent]);\n+\n+      var elements = copyPaste.paste({\n+        element: rootElement,\n+        point: {\n+          x: 600,\n+          y: 200\n+        }\n+      });\n+\n+      // then\n+      var copiedTask = elements.find(function(element) {\n+        return is(element, 'bpmn:Task');\n+      });\n+\n+      var copiedBoundaryEvent = elements.find(function(element) {\n+        return is(element, 'bpmn:BoundaryEvent');\n+      });\n+\n+      // verify the boundary event is attached to the task\n+      expect(copiedBoundaryEvent.host).to.equal(copiedTask);\n+      expect(copiedTask.attachers).to.include(copiedBoundaryEvent);\n+\n+      // verify the boundary event's businessObject has the correct attachedToRef\n+      expect(copiedBoundaryEvent.businessObject.attachedToRef).to.equal(copiedTask.businessObject);\n+    }\n+  ));\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

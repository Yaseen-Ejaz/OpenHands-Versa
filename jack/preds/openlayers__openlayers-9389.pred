{"instance_id": "openlayers__openlayers-9389","model_patch": "diff --git a/rendering/cases/layer-tile-render-listener/index.html b/rendering/cases/layer-tile-render-listener/index.html\nnew file mode 100644\nindex 000000000..c0107bfd3\n--- /dev/null\n+++ b/rendering/cases/layer-tile-render-listener/index.html\n@@ -0,0 +1,17 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Layer Tile Render Listener Test</title>\n+  <style>\n+    html, body {\n+      margin: 0;\n+      padding: 0;\n+      width: 100%;\n+      height: 100%;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <script src=\"main.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/rendering/cases/layer-tile-render-listener/main.js b/rendering/cases/layer-tile-render-listener/main.js\nnew file mode 100644\nindex 000000000..4fde2b015\n--- /dev/null\n+++ b/rendering/cases/layer-tile-render-listener/main.js\n@@ -0,0 +1,69 @@\n+import Map from '../../../src/ol/Map.js';\n+import View from '../../../src/ol/View.js';\n+import Point from '../../../src/ol/geom/Point.js';\n+import TileLayer from '../../../src/ol/layer/Tile.js';\n+import {transform} from '../../../src/ol/proj.js';\n+import XYZ from '../../../src/ol/source/XYZ.js';\n+import CircleStyle from '../../../src/ol/style/Circle.js';\n+import Fill from '../../../src/ol/style/Fill.js';\n+import Stroke from '../../../src/ol/style/Stroke.js';\n+\n+// Create a target div for the map\n+const target = document.createElement('div');\n+target.style.width = '100px';\n+target.style.height = '100px';\n+document.body.appendChild(target);\n+\n+// Create the source\n+const source = new XYZ({\n+  url: '/data/tiles/osm/{z}/{x}/{y}.png',\n+  transition: 0\n+});\n+\n+// Create the map\n+const map = new Map({\n+  pixelRatio: 1,\n+  target: target,\n+  view: new View({\n+    center: transform([-122.416667, 37.783333], 'EPSG:4326', 'EPSG:3857'),\n+    zoom: 5\n+  })\n+});\n+\n+// Add a layer with render listener\n+const layer = new TileLayer({\n+  source: source\n+});\n+\n+layer.on('render', function(e) {\n+  e.vectorContext.setImageStyle(new CircleStyle({\n+    radius: 5,\n+    fill: new Fill({color: 'yellow'}),\n+    stroke: new Stroke({color: 'red', width: 1})\n+  }));\n+  e.vectorContext.drawPoint(new Point(\n+    transform([-123, 38], 'EPSG:4326', 'EPSG:3857')));\n+});\n+\n+map.addLayer(layer);\n+\n+// Wait for tiles to load\n+let tilesLoading = 0;\n+let tileLoaded = 0;\n+\n+source.on('tileloadstart', function(event) {\n+  tilesLoading++;\n+});\n+\n+source.on('tileloadend', function(event) {\n+  tileLoaded++;\n+  if (tilesLoading === tileLoaded) {\n+    // All tiles loaded, render the map and complete the test\n+    map.renderSync();\n+    render({tolerance: 1.5});\n+  }\n+});\n+\n+source.on('tileloaderror', function(event) {\n+  console.error('Tile failed to load');\n+});\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-image/index.html b/rendering/cases/reproj-image/index.html\nnew file mode 100644\nindex 000000000..643999d72\n--- /dev/null\n+++ b/rendering/cases/reproj-image/index.html\n@@ -0,0 +1,17 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Reprojection Image Test</title>\n+  <style>\n+    html, body {\n+      margin: 0;\n+      padding: 0;\n+      width: 100%;\n+      height: 100%;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <script src=\"main.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-image/main.js b/rendering/cases/reproj-image/main.js\nnew file mode 100644\nindex 000000000..ebbc7b413\n--- /dev/null\n+++ b/rendering/cases/reproj-image/main.js\n@@ -0,0 +1,43 @@\n+import {listen} from '../../../src/ol/events.js';\n+import {get as getProjection} from '../../../src/ol/proj.js';\n+import {HALF_SIZE} from '../../../src/ol/proj/epsg3857.js';\n+import ReprojImage from '../../../src/ol/reproj/Image.js';\n+import Static from '../../../src/ol/source/ImageStatic.js';\n+import {createXYZ, createForProjection} from '../../../src/ol/tilegrid.js';\n+\n+// Create source\n+const source = new Static({\n+  url: '/data/tiles/osm/5/5/12.png',\n+  imageExtent: createXYZ().getTileCoordExtent([5, 5, -13]),\n+  projection: getProjection('EPSG:3857')\n+});\n+\n+// Test case: to EPSG:4326\n+const targetExtent = createForProjection('EPSG:4326').getTileCoordExtent([6, 10, -10]);\n+const targetResolution = 360 / (256 * (1 << 4));\n+const pixelRatio = 1;\n+\n+const image = new ReprojImage(source.getProjection(), getProjection('EPSG:4326'),\n+  targetExtent, targetResolution, pixelRatio,\n+  function(extent, resolution, pixelRatio) {\n+    return source.getImage(extent, resolution, pixelRatio, source.getProjection());\n+  });\n+\n+// Load the image\n+if (image.getState() == 0) { // IDLE\n+  listen(image, 'change', function(e) {\n+    if (image.getState() == 2) { // LOADED\n+      // Display the image in a canvas\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 256;\n+      canvas.height = 256;\n+      const ctx = canvas.getContext('2d');\n+      ctx.drawImage(image.getImage(), 0, 0);\n+      document.body.appendChild(canvas);\n+      \n+      // Signal test completion\n+      render({tolerance: 1.5});\n+    }\n+  });\n+  image.load();\n+}\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-tile/index.html b/rendering/cases/reproj-tile/index.html\nnew file mode 100644\nindex 000000000..641c046af\n--- /dev/null\n+++ b/rendering/cases/reproj-tile/index.html\n@@ -0,0 +1,18 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Reprojection Tile Test</title>\n+  <style>\n+    html, body {\n+      margin: 0;\n+      padding: 0;\n+      width: 100%;\n+      height: 100%;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.6.2/proj4.js\"></script>\n+  <script src=\"main.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-tile/main.js b/rendering/cases/reproj-tile/main.js\nnew file mode 100644\nindex 000000000..affb0c6a7\n--- /dev/null\n+++ b/rendering/cases/reproj-tile/main.js\n@@ -0,0 +1,71 @@\n+import TileState from '../../../src/ol/TileState.js';\n+import {listen} from '../../../src/ol/events.js';\n+import {get as getProjection} from '../../../src/ol/proj.js';\n+import ReprojTile from '../../../src/ol/reproj/Tile.js';\n+import XYZ from '../../../src/ol/source/XYZ.js';\n+import {createForProjection} from '../../../src/ol/tilegrid.js';\n+import {register} from '../../../src/ol/proj/proj4.js';\n+\n+// Define projections\n+proj4.defs('EPSG:5070',\n+  '+proj=aea +lat_1=29.5 +lat_2=45.5 +lat_0=23 +lon_0=-96 +x_0=0 ' +\n+    '+y_0=0 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs');\n+proj4.defs('ESRI:54009',\n+  '+proj=moll +lon_0=0 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+proj4.defs('EPSG:3740',\n+  '+proj=utm +zone=10 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 ' +\n+    '+units=m +no_defs');\n+proj4.defs('merc_180', '+proj=merc +lon_0=180 +units=m +no_defs');\n+proj4.defs('EPSG:3413', '+proj=stere +lat_0=90 +lat_ts=70 +lon_0=-45 ' +\n+    '+k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+register(proj4);\n+\n+// Set extents for projections\n+const proj5070 = getProjection('EPSG:5070');\n+proj5070.setExtent([-6e6, 0, 4e6, 6e6]);\n+\n+const proj54009 = getProjection('ESRI:54009');\n+proj54009.setExtent([-18e6, -9e6, 18e6, 9e6]);\n+\n+const proj3740 = getProjection('EPSG:3740');\n+proj3740.setExtent([318499.05, 2700792.39, 4359164.89, 7149336.98]);\n+\n+const proj_merc180 = getProjection('merc_180');\n+proj_merc180.setExtent([-20026376.39, -20048966.10, 20026376.39, 20048966.10]);\n+\n+const proj3413 = getProjection('EPSG:3413');\n+proj3413.setExtent([-4194304, -4194304, 4194304, 4194304]);\n+\n+// Create source\n+const source = new XYZ({\n+  projection: 'EPSG:3857',\n+  url: '/data/tiles/osm/{z}/{x}/{y}.png'\n+});\n+\n+// Test case: to EPSG:4326\n+const tileGrid4326 = createForProjection('EPSG:4326', 7, [64, 64]);\n+const tile4326 = new ReprojTile(source.getProjection(), source.getTileGrid(),\n+  getProjection('EPSG:4326'), tileGrid4326,\n+  [7, 21, -20], null, 1, source.getGutterForProjection(source.getProjection()),\n+  function(z, x, y, pixelRatio) {\n+    return source.getTile(z, x, y, pixelRatio, source.getProjection());\n+  });\n+\n+// Load the tile\n+if (tile4326.getState() == TileState.IDLE) {\n+  listen(tile4326, 'change', function(e) {\n+    if (tile4326.getState() == TileState.LOADED) {\n+      // Display the tile in a canvas\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 256;\n+      canvas.height = 256;\n+      const ctx = canvas.getContext('2d');\n+      ctx.drawImage(tile4326.getImage(), 0, 0);\n+      document.body.appendChild(canvas);\n+      \n+      // Signal test completion\n+      render({tolerance: 7.5});\n+    }\n+  });\n+  tile4326.load();\n+}\n\\ No newline at end of file","model_name_or_path": "claude-sonnet-4"}

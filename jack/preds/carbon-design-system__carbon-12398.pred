eckbox = React.forwardRef(\n     const wrapperClasses = classNames(\n       `${prefix}--form-item`,\n       `${prefix}--checkbox-wrapper`,\n+      {\n+        [`${prefix}--checkbox-wrapper--readonly`]: readOnly,\n+      },\n       [className]\n     );\n     const innerLabelClasses = classNames(`${prefix}--checkbox-label-text`, {\n@@ -90,7 +99,14 @@ const Checkbox = React.forwardRef(\n           {...other}\n           type=\"checkbox\"\n           onChange={(evt) => {\n-            onChange && onChange(evt, { checked: evt.target.checked, id });\n+            if (!readOnly) {\n+              onChange && onChange(evt, { checked: evt.target.checked, id });\n+            }\n+          }}\n+          onClick={(evt) => {\n+            if (readOnly) {\n+              evt.preventDefault();\n+            }\n           }}\n           className={`${prefix}--checkbox`}\n           id={id}\n@@ -165,6 +181,11 @@ Checkbox.propTypes = {\n    */\n   onChange: PropTypes.func,\n \n+  /**\n+   * Specify whether the Checkbox should be read-only\n+   */\n+  readOnly: PropTypes.bool,\n+\n   /**\n    * Specify a title for the <label> node for the Checkbox\n    */\ndiff --git a/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js b/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js\nnew file mode 100644\nindex 000000000..0d537c1d7\n--- /dev/null\n+++ b/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js\n@@ -0,0 +1,90 @@\n+/**\n+ * Test file to verify read-only checkbox implementation\n+ * This will test the current behavior and our new read-only functionality\n+ */\n+\n+import React from 'react';\n+import { render, screen } from '@testing-library/react';\n+import userEvent from '@testing-library/user-event';\n+import Checkbox from '../Checkbox';\n+\n+describe('Checkbox Read-Only Implementation Tests', () => {\n+  // Test current behavior (should work)\n+  describe('Current Checkbox behavior', () => {\n+    it('should render and be interactive by default', async () => {\n+      const onChange = jest.fn();\n+      render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" onChange={onChange} />);\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toBeInTheDocument();\n+      expect(checkbox.checked).toBe(false);\n+      \n+      await userEvent.click(checkbox);\n+      expect(onChange).toHaveBeenCalled();\n+    });\n+  });\n+\n+  // Test read-only behavior (will fail initially, then pass after implementation)\n+  describe('Read-Only Checkbox behavior', () => {\n+    it('should render with readOnly prop', () => {\n+      render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly />);\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toBeInTheDocument();\n+    });\n+\n+    it('should not change state when readOnly is true', async () => {\n+      const onChange = jest.fn();\n+      render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly onChange={onChange} />);\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox.checked).toBe(false);\n+      \n+      await userEvent.click(checkbox);\n+      // Should not change state\n+      expect(checkbox.checked).toBe(false);\n+      // onChange should not be called for state changes in read-only mode\n+      expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should apply read-only CSS class', () => {\n+      const { container } = render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly />);\n+      \n+      expect(container.firstChild).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+\n+    it('should work with checked state in read-only mode', async () => {\n+      const onChange = jest.fn();\n+      render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly defaultChecked onChange={onChange} />);\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox.checked).toBe(true);\n+      \n+      await userEvent.click(checkbox);\n+      // Should remain checked (state should not change)\n+      expect(checkbox.checked).toBe(true);\n+      expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should work with indeterminate state in read-only mode', () => {\n+      render(<Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly indeterminate />);\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox.indeterminate).toBe(true);\n+    });\n+  });\n+\n+  // RTL tests\n+  describe('Checkbox Read-Only - RTL', () => {\n+    it('should apply read-only class in RTL context', () => {\n+      const { container } = render(\n+        <div dir=\"rtl\">\n+          <Checkbox id=\"test\" labelText=\"Test Checkbox\" readOnly />\n+        </div>\n+      );\n+      \n+      const wrapper = container.querySelector('.cds--checkbox-wrapper');\n+      expect(wrapper).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/Checkbox/__tests__/Checkbox-test.js b/packages/react/src/components/Checkbox/__tests__/Checkbox-test.js\nindex 05fd1dc3f..f89c21817 100644\n--- a/packages/react/src/components/Checkbox/__tests__/Checkbox-test.js\n+++ b/packages/react/src/components/Checkbox/__tests__/Checkbox-test.js\n@@ -84,4 +84,32 @@ describe('Checkbox', () => {\n       expect(screen.getByRole('checkbox').indeterminate).toBe(true);\n     });\n   });\n+\n+  describe('readOnly', () => {\n+    it('should apply read-only class when readOnly prop is provided', () => {\n+      const { container } = render(<Checkbox id=\"test\" labelText=\"test-label\" readOnly />);\n+      expect(container.firstChild).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+\n+    it('should not call onChange when readOnly is true', () => {\n+      const onChange = jest.fn();\n+      render(<Checkbox id=\"test\" labelText=\"test-label\" readOnly
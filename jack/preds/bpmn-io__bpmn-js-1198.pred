{"instance_id": "bpmn-io__bpmn-js-1198", "model_patch": "diff --git a/lib/features/modeling/behavior/DropOnFlowBehavior.js b/lib/features/modeling/behavior/DropOnFlowBehavior.js\nindex a08947d2..1dd24858 100644\n--- a/lib/features/modeling/behavior/DropOnFlowBehavior.js\n+++ b/lib/features/modeling/behavior/DropOnFlowBehavior.js\n@@ -15,11 +15,37 @@ import {\n   getApproxIntersection\n } from 'diagram-js/lib/util/LineIntersection';\n \n+import {\n+  getBusinessObject,\n+  is\n+} from '../../../util/ModelUtil';\n+\n \n export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n \n   CommandInterceptor.call(this, eventBus);\n \n+  var preservedDefaultFlows = {};\n+\n+  // preserve default flow references before they get cleared by UnsetDefaultFlowBehavior\n+  this.preExecute('connection.delete', function(event) {\n+    var context = event.context,\n+        connection = context.connection,\n+        source = connection.source;\n+\n+    if (is(connection, 'bpmn:SequenceFlow') && source) {\n+      var sourceBo = getBusinessObject(source);\n+      var connectionBo = getBusinessObject(connection);\n+      \n+      if (sourceBo.get('default') === connectionBo) {\n+        preservedDefaultFlows[connection.id] = {\n+          source: source,\n+          connection: connection\n+        };\n+      }\n+    }\n+  });\n+\n   /**\n    * Reconnect start / end of a connection after\n    * dropping an element on a flow.\n@@ -37,6 +63,15 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n         oldOutgoing = shape.outgoing.slice(),\n         oldIncoming = shape.incoming.slice();\n \n+    // check if targetFlow is a default flow before we modify it\n+    var isTargetFlowDefault = false;\n+    var targetFlowSource = targetFlow.source;\n+    if (is(targetFlow, 'bpmn:SequenceFlow') && targetFlowSource) {\n+      var sourceBo = getBusinessObject(targetFlowSource);\n+      var targetFlowBo = getBusinessObject(targetFlow);\n+      isTargetFlowDefault = sourceBo.get('default') === targetFlowBo;\n+    }\n+\n     var mid;\n \n     if (isNumber(positionOrBounds.width)) {\n@@ -109,6 +144,36 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n     if (duplicateConnections.length) {\n       modeling.removeElements(duplicateConnections);\n     }\n+\n+    // restore default flow reference if any of the removed connections was a default flow\n+    duplicateConnections.forEach(function(connection) {\n+      var preservedDefault = preservedDefaultFlows[connection.id];\n+      if (preservedDefault) {\n+        var newDefaultConnection = null;\n+        \n+        // determine which connection should be the new default\n+        if (incomingConnection && outgoingConnection) {\n+          // when flow is split, the outgoing connection maintains the original target\n+          // so it should be the default to preserve the original flow semantics\n+          newDefaultConnection = outgoingConnection;\n+        } else if (incomingConnection) {\n+          // only incoming connection exists, it should be the default\n+          newDefaultConnection = incomingConnection;\n+        } else if (outgoingConnection) {\n+          // only outgoing connection exists, it should be the default\n+          newDefaultConnection = outgoingConnection;\n+        }\n+        \n+        if (newDefaultConnection) {\n+          modeling.updateProperties(preservedDefault.source, {\n+            'default': getBusinessObject(newDefaultConnection)\n+          });\n+        }\n+        \n+        // clean up\n+        delete preservedDefaultFlows[connection.id];\n+      }\n+    });\n   }\n \n   this.preExecute('elements.move', function(context) {\ndiff --git a/reproduce_issue.js b/reproduce_issue.js\nnew file mode 100644\nindex 00000000..e622bed2\n--- /dev/null\n+++ b/reproduce_issue.js\n@@ -0,0 +1,90 @@\n+// Simple reproduction script to understand the default flow issue\n+\n+const BpmnModeler = require('./lib/Modeler');\n+\n+// BPMN XML with exclusive gateway and default flow\n+const bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:exclusiveGateway id=\"exclusive-gateway\" default=\"flow-default\">\n+      <bpmn:outgoing>flow-default</bpmn:outgoing>\n+      <bpmn:outgoing>flow-normal</bpmn:outgoing>\n+    </bpmn:exclusiveGateway>\n+    <bpmn:task id=\"task-default\">\n+      <bpmn:incoming>flow-default</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-default\" sourceRef=\"exclusive-gateway\" targetRef=\"task-default\" />\n+    <bpmn:task id=\"task-normal\">\n+      <bpmn:incoming>flow-normal</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-normal\" sourceRef=\"exclusive-gateway\" targetRef=\"task-normal\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"ExclusiveGateway_1kqn7y5_di\" bpmnElement=\"exclusive-gateway\" isMarkerVisible=\"true\">\n+        <dc:Bounds x=\"312\" y=\"105\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_000sfne_di\" bpmnElement=\"task-default\">\n+        <dc:Bounds x=\"561\" y=\"90\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_0xihk8q_di\" bpmnElement=\"flow-default\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"362\" y=\"130\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"130\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"Task_08sfs0b_di\" bpmnElement=\"task-normal\">\n+        <dc:Bounds x=\"561\" y=\"272\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_07cihrc_di\" bpmnElement=\"flow-normal\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"155\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"312\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"312\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function reproduceIssue() {\n+  try {\n+    const modeler = new BpmnModeler();\n+    \n+    // Import the BPMN\n+    await modeler.importXML(bpmnXML);\n+    \n+    const elementRegistry = modeler.get('elementRegistry');\n+    const modeling = modeler.get('modeling');\n+    const elementFactory = modeler.get('elementFactory');\n+    \n+    // Get elements\n+    const gateway = elementRegistry.get('exclusive-gateway');\n+    const normalFlow = elementRegistry.get('flow-normal');\n+    \n+    console.log('Before adding timer catch event:');\n+    console.log('Gateway default:', gateway.businessObject.default ? gateway.businessObject.default.id : 'null');\n+    \n+    // Create timer catch event\n+    const timerCatchEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:TimerEventDefinition'\n+    });\n+    \n+    // Add timer catch event to normal flow\n+    const newShape = modeling.createShape(\n+      timerCatchEvent,\n+      { x: 400, y: 312 }, // position on normal flow\n+      normalFlow\n+    );\n+    \n+    console.log('After adding timer catch event:');\n+    console.log('Gateway default:', gateway.businessObject.default ? gateway.businessObject.default.id : 'null');\n+    console.log('New shape created:', newShape.id);\n+    \n+    // Export to see the result\n+    const result = await modeler.saveXML({ format: true });\n+    console.log('Final XML:', result.xml);\n+    \n+  } catch (error) {\n+    console.error('Error:', error);\n+  }\n+}\n+\n+reproduceIssue();\n\\ No newline at end of file\ndiff --git a/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.bpmn b/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.bpmn\nnew file mode 100644\nindex 00000000..74058c34\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.bpmn\n@@ -0,0 +1,54 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:exclusiveGateway id=\"exclusive-gateway\" default=\"flow-default\">\n+      <bpmn:outgoing>flow-default</bpmn:outgoing>\n+      <bpmn:outgoing>flow-normal</bpmn:outgoing>\n+    </bpmn:exclusiveGateway>\n+    <bpmn:task id=\"task-default\">\n+      <bpmn:incoming>flow-default</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-default\" sourceRef=\"exclusive-gateway\" targetRef=\"task-default\" />\n+    <bpmn:task id=\"task-normal\">\n+      <bpmn:incoming>flow-normal</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-normal\" sourceRef=\"exclusive-gateway\" targetRef=\"task-normal\" />\n+    <bpmn:intermediateCatchEvent id=\"timer-catch-event\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:intermediateCatchEvent>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"ExclusiveGateway_1kqn7y5_di\" bpmnElement=\"exclusive-gateway\" isMarkerVisible=\"true\">\n+        <dc:Bounds x=\"312\" y=\"105\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"292\" y=\"155\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_000sfne_di\" bpmnElement=\"task-default\">\n+        <dc:Bounds x=\"561\" y=\"90\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_0xihk8q_di\" bpmnElement=\"flow-default\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"362\" y=\"130\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"130\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"416.5\" y=\"120\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"Task_08sfs0b_di\" bpmnElement=\"task-normal\">\n+        <dc:Bounds x=\"561\" y=\"272\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_07cihrc_di\" bpmnElement=\"flow-normal\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"155\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"312\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"312\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"292\" y=\"223.5\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"IntermediateCatchEvent_1abc123_di\" bpmnElement=\"timer-catch-event\">\n+        <dc:Bounds x=\"100\" y=\"112\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.js b/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.js\nnew file mode 100644\nindex 00000000..f8693f28\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/DefaultFlowTimerCatchEventSpec.js\n@@ -0,0 +1,142 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('features/modeling - Timer Intermediate Catch Event on Default Flow', function() {\n+\n+  var testModules = [ coreModule, modelingModule ];\n+\n+  var processDiagramXML = require('./DefaultFlowTimerCatchEventSpec.bpmn');\n+\n+  beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+  var gateway,\n+      defaultFlow,\n+      normalFlow;\n+\n+  beforeEach(inject(function(elementRegistry) {\n+    gateway = elementRegistry.get('exclusive-gateway');\n+    defaultFlow = elementRegistry.get('flow-default');\n+    normalFlow = elementRegistry.get('flow-normal');\n+  }));\n+\n+  it('should preserve default attribute when adding Timer Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+\n+    // given\n+    var timerCatchEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:TimerEventDefinition'\n+    });\n+\n+    // verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+\n+    // when - add timer catch event to the non-default flow\n+    var newShape = modeling.createShape(\n+      timerCatchEvent,\n+      { x: 400, y: 312 }, // position on normal flow\n+      normalFlow\n+    );\n+\n+    // then - default attribute should still be preserved\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    expect(newShape).to.exist;\n+    expect(newShape.businessObject.eventDefinitions).to.have.length(1);\n+    expect(newShape.businessObject.eventDefinitions[0].$type).to.equal('bpmn:TimerEventDefinition');\n+  }));\n+\n+  it('should preserve default attribute when adding Timer Catch Event to default flow', inject(function(modeling, elementFactory) {\n+\n+    // given\n+    var timerCatchEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:TimerEventDefinition'\n+    });\n+\n+    // verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+\n+    // when - add timer catch event to the default flow\n+    var newShape = modeling.createShape(\n+      timerCatchEvent,\n+      { x: 450, y: 130 }, // position on default flow\n+      defaultFlow\n+    );\n+\n+    // then - default attribute should still be preserved\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    expect(newShape).to.exist;\n+    expect(newShape.businessObject.eventDefinitions).to.have.length(1);\n+    expect(newShape.businessObject.eventDefinitions[0].$type).to.equal('bpmn:TimerEventDefinition');\n+  }));\n+\n+  it('should preserve default attribute when adding Message Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+\n+    // given\n+    var messageCatchEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:MessageEventDefinition'\n+    });\n+\n+    // verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+\n+    // when - add message catch event to the non-default flow\n+    var newShape = modeling.createShape(\n+      messageCatchEvent,\n+      { x: 400, y: 312 }, // position on normal flow\n+      normalFlow\n+    );\n+\n+    // then - default attribute should still be preserved\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    expect(newShape).to.exist;\n+    expect(newShape.businessObject.eventDefinitions).to.have.length(1);\n+    expect(newShape.businessObject.eventDefinitions[0].$type).to.equal('bpmn:MessageEventDefinition');\n+  }));\n+\n+  it('should preserve default attribute when adding Signal Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+\n+    // given\n+    var signalCatchEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:SignalEventDefinition'\n+    });\n+\n+    // verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+\n+    // when - add signal catch event to the non-default flow\n+    var newShape = modeling.createShape(\n+      signalCatchEvent,\n+      { x: 400, y: 312 }, // position on normal flow\n+      normalFlow\n+    );\n+\n+    // then - default attribute should still be preserved\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    expect(newShape).to.exist;\n+    expect(newShape.businessObject.eventDefinitions).to.have.length(1);\n+    expect(newShape.businessObject.eventDefinitions[0].$type).to.equal('bpmn:SignalEventDefinition');\n+  }));\n+\n+  it('should preserve default attribute when moving Timer Catch Event to non-default flow', inject(function(modeling, elementRegistry) {\n+\n+    // given\n+    var timerCatchEvent = elementRegistry.get('timer-catch-event');\n+\n+    // verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+\n+    // when - move timer catch event to the non-default flow\n+    modeling.moveElements([timerCatchEvent], { x: 0, y: 182 }, normalFlow);\n+\n+    // then - default attribute should still be preserved\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 00000000..68edd7cb\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,157 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Default Flow Fix</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+        .test-result { margin: 10px 0; padding: 10px; border-radius: 4px; }\n+        .success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }\n+        .error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }\n+        button { margin: 5px; padding: 10px 15px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Test Default Flow Fix</h1>\n+    <div id=\"canvas\"></div>\n+    \n+    <button onclick=\"runTest()\">Run Test</button>\n+    <button onclick=\"exportXML()\">Export XML</button>\n+    \n+    <div id=\"results\"></div>\n+    \n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        const bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:exclusiveGateway id=\"exclusive-gateway\" default=\"flow-default\">\n+      <bpmn:outgoing>flow-default</bpmn:outgoing>\n+      <bpmn:outgoing>flow-normal</bpmn:outgoing>\n+    </bpmn:exclusiveGateway>\n+    <bpmn:task id=\"task-default\">\n+      <bpmn:incoming>flow-default</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-default\" sourceRef=\"exclusive-gateway\" targetRef=\"task-default\" />\n+    <bpmn:task id=\"task-normal\">\n+      <bpmn:incoming>flow-normal</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-normal\" sourceRef=\"exclusive-gateway\" targetRef=\"task-normal\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"ExclusiveGateway_1kqn7y5_di\" bpmnElement=\"exclusive-gateway\" isMarkerVisible=\"true\">\n+        <dc:Bounds x=\"312\" y=\"105\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_000sfne_di\" bpmnElement=\"task-default\">\n+        <dc:Bounds x=\"561\" y=\"90\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_0xihk8q_di\" bpmnElement=\"flow-default\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"362\" y=\"130\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"130\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"Task_08sfs0b_di\" bpmnElement=\"task-normal\">\n+        <dc:Bounds x=\"561\" y=\"272\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_07cihrc_di\" bpmnElement=\"flow-normal\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"155\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"337\" y=\"312\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"561\" y=\"312\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        let modeler;\n+        \n+        async function initModeler() {\n+            modeler = new BpmnJS({\n+                container: '#canvas'\n+            });\n+            \n+            try {\n+                await modeler.importXML(bpmnXML);\n+                console.log('BPMN imported successfully');\n+            } catch (err) {\n+                console.error('Error importing BPMN:', err);\n+            }\n+        }\n+        \n+        function addResult(message, isSuccess) {\n+            const resultsDiv = document.getElementById('results');\n+            const resultDiv = document.createElement('div');\n+            resultDiv.className = 'test-result ' + (isSuccess ? 'success' : 'error');\n+            resultDiv.textContent = message;\n+            resultsDiv.appendChild(resultDiv);\n+        }\n+        \n+        async function runTest() {\n+            document.getElementById('results').innerHTML = '';\n+            \n+            try {\n+                const elementRegistry = modeler.get('elementRegistry');\n+                const modeling = modeler.get('modeling');\n+                const elementFactory = modeler.get('elementFactory');\n+                \n+                // Get elements\n+                const gateway = elementRegistry.get('exclusive-gateway');\n+                const normalFlow = elementRegistry.get('flow-normal');\n+                \n+                // Check initial state\n+                const initialDefault = gateway.businessObject.default;\n+                addResult('Initial default flow: ' + (initialDefault ? initialDefault.id : 'null'), !!initialDefault);\n+                \n+                if (!initialDefault || initialDefault.id !== 'flow-default') {\n+                    addResult('ERROR: Initial default flow is not set correctly', false);\n+                    return;\n+                }\n+                \n+                // Create timer catch event\n+                const timerCatchEvent = elementFactory.createShape({\n+                    type: 'bpmn:IntermediateCatchEvent',\n+                    eventDefinitionType: 'bpmn:TimerEventDefinition'\n+                });\n+                \n+                // Add timer catch event to normal flow\n+                const newShape = modeling.createShape(\n+                    timerCatchEvent,\n+                    { x: 400, y: 312 }, // position on normal flow\n+                    normalFlow\n+                );\n+                \n+                // Check if default is preserved\n+                const finalDefault = gateway.businessObject.default;\n+                addResult('Final default flow: ' + (finalDefault ? finalDefault.id : 'null'), !!finalDefault);\n+                \n+                if (finalDefault && finalDefault.id === 'flow-default') {\n+                    addResult('SUCCESS: Default flow preserved after adding Timer Catch Event!', true);\n+                } else {\n+                    addResult('FAILURE: Default flow was lost after adding Timer Catch Event', false);\n+                }\n+                \n+                addResult('New shape created: ' + newShape.id, true);\n+                \n+            } catch (error) {\n+                addResult('Error during test: ' + error.message, false);\n+                console.error('Test error:', error);\n+            }\n+        }\n+        \n+        async function exportXML() {\n+            try {\n+                const result = await modeler.saveXML({ format: true });\n+                console.log('Exported XML:', result.xml);\n+                \n+                // Show in a new window\n+                const newWindow = window.open('', '_blank');\n+                newWindow.document.write('<pre>' + result.xml + '</pre>');\n+            } catch (error) {\n+                console.error('Export error:', error);\n+            }\n+        }\n+        \n+        // Initialize when page loads\n+        window.addEventListener('load', initModeler);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

7.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/webgl/PaletteTexture.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/GeometryCollection.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/LineString.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/MultiLineString.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/MultiPoint.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/MultiPolygon.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/TileCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/source/UrlTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/tilecoord.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/geom/flat/linechunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/reproj/DataTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/webgl/TileTexture.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/renderer/webgl/TileLayerBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/source/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/DataTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:27:25] \"GET /src/ol/webgl/BaseTileRepresentation.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:29:07] \"GET /test_simple.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:29:07] \"GET /build/ol/ol.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 10:29:07] \"GET /build/full/ol.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/webgl/PointsLayer.js b/src/ol/renderer/webgl/PointsLayer.js\nindex be6a2041d..2b20d88ae 100644\n--- a/src/ol/renderer/webgl/PointsLayer.js\n+++ b/src/ol/renderer/webgl/PointsLayer.js\n@@ -21,6 +21,12 @@ import {assert} from '../../asserts.js';\n import {buffer, createEmpty, equals} from '../../extent.js';\n import {colorDecodeId, colorEncodeId} from '../../render/webgl/utils.js';\n import {create as createWebGLWorker} from '../../worker/webgl.js';\n+import {\n+  getTransformFromProjections,\n+  getUserProjection,\n+  toUserExtent,\n+  toUserResolution,\n+} from '../../proj.js';\n import {getUid} from '../../util.js';\n import {getWorldParameters} from './worldUtil.js';\n import {listen, unlistenByKey} from '../../events.js';\n@@ -453,7 +459,17 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n       const renderBuffer =\n         layer instanceof BaseVector ? layer.getRenderBuffer() : 0;\n       const extent = buffer(frameState.extent, renderBuffer * resolution);\n-      vectorSource.loadFeatures(extent, resolution, projection);\n+\n+      const userProjection = getUserProjection();\n+      if (userProjection) {\n+        vectorSource.loadFeatures(\n+          toUserExtent(extent, userProjection),\n+          toUserResolution(resolution, projection),\n+          userProjection\n+        );\n+      } else {\n+        vectorSource.loadFeatures(extent, resolution, projection);\n+      }\n \n       this.rebuildBuffers_(frameState);\n       this.previousExtent_ = frameState.extent.slice();\n@@ -480,6 +496,16 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n     const projectionTransform = createTransform();\n     this.helper.makeProjectionTransform(frameState, projectionTransform);\n \n+    // Get user projection transform if needed\n+    const userProjection = getUserProjection();\n+    let userToViewTransform = null;\n+    if (userProjection) {\n+      userToViewTransform = getTransformFromProjections(\n+        userProjection,\n+        frameState.viewState.projection\n+      );\n+    }\n+\n     const baseInstructionLength = this.hitDetectionEnabled_ ? 7 : 2; // see below\n     const singleInstructionLength =\n       baseInstructionLength + this.customAttributes.length;\n@@ -506,6 +532,13 @@ class WebGLPointsLayerRenderer extends WebGLLayerRenderer {\n       }\n       tmpCoords[0] = geometry.getFlatCoordinates()[0];\n       tmpCoords[1] = geometry.getFlatCoordinates()[1];\n+\n+      // Transform from user projection to view projection if needed\n+      if (userToViewTransform) {\n+        applyTransform(userToViewTransform, tmpCoords);\n+      }\n+\n+      // Transform from view projection to screen coordinates\n       applyTransform(projectionTransform, tmpCoords);\n \n       this.renderInstructions_[++idx] = tmpCoords[0];\ndiff --git a/test_simple.html b/test_simple.html\nnew file mode 100644\nindex 000000000..28be04866\n--- /dev/null\n+++ b/test_simple.html\n@@ -0,0 +1,121 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Points Test</title>\n+    <link rel=\"stylesheet\" href=\"build/ol/ol.css\" type=\"text/css\">\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map { width: 800px; height: 400px; border: 1px solid #ccc; margin: 10px 0; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        button { margin: 5px; padding: 8px 16px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Points Layer Test</h1>\n+    \n+    <div class=\"info\">\n+        <p>Testing WebGLPointsLayer with useGeographic(). Click toggle to see the issue.</p>\n+        <button onclick=\"toggleGeographic()\">Toggle useGeographic()</button>\n+        <span id=\"status\">Geographic: OFF</span>\n+    </div>\n+\n+    <h2>Regular VectorLayer (Reference)</h2>\n+    <div id=\"map1\" class=\"map\"></div>\n+\n+    <h2>WebGLPointsLayer (Test)</h2>\n+    <div id=\"map2\" class=\"map\"></div>\n+\n+    <script src=\"build/full/ol.js\"></script>\n+    <script>\n+        let geographicEnabled = false;\n+\n+        // Test points in longitude/latitude\n+        const testPoints = [\n+            [-74.006, 40.7128], // New York\n+            [-0.1276, 51.5074], // London\n+            [2.3522, 48.8566],  // Paris\n+            [139.6917, 35.6895], // Tokyo\n+            [-122.4194, 37.7749] // San Francisco\n+        ];\n+\n+        // Create features\n+        const features = testPoints.map((coord, index) => {\n+            return new ol.Feature({\n+                geometry: new ol.geom.Point(coord),\n+                name: `Point ${index + 1}`\n+            });\n+        });\n+\n+        // Vector source\n+        const vectorSource = new ol.source.Vector({\n+            features: features\n+        });\n+\n+        // Regular vector layer\n+        const vectorLayer = new ol.layer.Vector({\n+            source: vectorSource,\n+            style: new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 8,\n+                    fill: new ol.style.Fill({color: 'red'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2})\n+                })\n+            })\n+        });\n+\n+        // WebGL Points layer\n+        const webglPointsLayer = new ol.layer.WebGLPoints({\n+            source: vectorSource,\n+            style: {\n+                'circle-radius': 8,\n+                'circle-fill-color': 'blue',\n+                'circle-stroke-color': 'white',\n+                'circle-stroke-width': 2\n+            }\n+        });\n+\n+        // Create maps\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [\n+                new ol.layer.Tile({source: new ol.source.OSM()}),\n+                vectorLayer\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        const map2 = new ol.Map({\n+            target: 'map2',\n+            layers: [\n+                new ol.layer.Tile({source: new ol.source.OSM()}),\n+                webglPointsLayer\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        function toggleGeographic() {\n+            if (geographicEnabled) {\n+                ol.proj.clearUserProjection();\n+                geographicEnabled = false;\n+                document.getElementById('status').textContent = 'Geographic: OFF';\n+            } else {\n+                ol.proj.useGeographic();\n+                geographicEnabled = true;\n+                document.getElementById('status').textContent = 'Geographic: ON';\n+            }\n+            \n+            // Force re-render\n+            map1.getView().changed();\n+            map2.getView().changed();\n+        }\n+\n+        console.log('Test loaded. Toggle useGeographic to see the issue.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_points_geographic.html b/test_webgl_points_geographic.html\nnew file mode 100644\nindex 000000000..cfe2c351c\n--- /dev/null\n+++ b/test_webgl_points_geographic.html\n@@ -0,0 +1,173 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Points Layer with useGeographic Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+            margin: 10px 0;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 8px 16px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Points Layer with useGeographic Test</h1>\n+    \n+    <div class=\"info\">\n+        <p>This test demonstrates the issue with WebGLPointsLayer not working correctly with useGeographic().</p>\n+        <p>Expected: Both maps should show the same points at the same locations.</p>\n+        <p>Actual: WebGLPointsLayer shows points at wrong locations when useGeographic() is enabled.</p>\n+    </div>\n+\n+    <div class=\"controls\">\n+        <button onclick=\"toggleGeographic()\">Toggle useGeographic()</button>\n+        <span id=\"status\">Geographic: OFF</span>\n+    </div>\n+\n+    <h2>Regular VectorLayer (Reference)</h2>\n+    <div id=\"map1\" class=\"map\"></div>\n+\n+    <h2>WebGLPointsLayer (Test)</h2>\n+    <div id=\"map2\" class=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import WebGLPointsLayer from './src/ol/layer/WebGLPoints.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {useGeographic, clearUserProjection} from './src/ol/proj.js';\n+        import {Style, Circle, Fill, Stroke} from './src/ol/style.js';\n+\n+        let geographicEnabled = false;\n+\n+        // Test points in longitude/latitude (EPSG:4326)\n+        const testPoints = [\n+            [-74.006, 40.7128], // New York\n+            [-0.1276, 51.5074], // London\n+            [2.3522, 48.8566],  // Paris\n+            [139.6917, 35.6895], // Tokyo\n+            [-122.4194, 37.7749] // San Francisco\n+        ];\n+\n+        // Create features\n+        const features = testPoints.map((coord, index) => {\n+            const feature = new Feature({\n+                geometry: new Point(coord),\n+                name: `Point ${index + 1}`,\n+                index: index\n+            });\n+            return feature;\n+        });\n+\n+        // Vector source\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        // Regular vector layer with circle style\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({color: 'red'}),\n+                    stroke: new Stroke({color: 'white', width: 2})\n+                })\n+            })\n+        });\n+\n+        // WebGL Points layer\n+        const webglPointsLayer = new WebGLPointsLayer({\n+            source: vectorSource,\n+            style: {\n+                'circle-radius': 8,\n+                'circle-fill-color': 'blue',\n+                'circle-stroke-color': 'white',\n+                'circle-stroke-width': 2\n+            }\n+        });\n+\n+        // Base tile layer\n+        const tileLayer1 = new TileLayer({\n+            source: new OSM()\n+        });\n+\n+        const tileLayer2 = new TileLayer({\n+            source: new OSM()\n+        });\n+\n+        // Create maps\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [tileLayer1, vectorLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [tileLayer2, webglPointsLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Toggle geographic projection\n+        window.toggleGeographic = function() {\n+            if (geographicEnabled) {\n+                clearUserProjection();\n+                geographicEnabled = false;\n+                document.getElementById('status').textContent = 'Geographic: OFF';\n+            } else {\n+                useGeographic();\n+                geographicEnabled = true;\n+                document.getElementById('status').textContent = 'Geographic: ON';\n+            }\n+            \n+            // Force re-render\n+            map1.getView().changed();\n+            map2.getView().changed();\n+        };\n+\n+        // Add click handlers to show coordinates\n+        map1.on('click', function(evt) {\n+            console.log('Map1 clicked at:', evt.coordinate);\n+        });\n+\n+        map2.on('click', function(evt) {\n+            console.log('Map2 clicked at:', evt.coordinate);\n+        });\n+\n+        console.log('Test initialized. Click \"Toggle useGeographic()\" to see the issue.');\n+        console.log('Expected: Both maps should show identical point positions.');\n+        console.log('Actual: WebGLPointsLayer will show points at wrong locations when geographic is ON.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

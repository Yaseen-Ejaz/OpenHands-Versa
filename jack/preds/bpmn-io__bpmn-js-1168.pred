{"instance_id": "bpmn-io__bpmn-js-1168", "model_patch": "diff --git a/lib/features/label-editing/LabelEditingProvider.js b/lib/features/label-editing/LabelEditingProvider.js\nindex a1dbfbb7..46e2bdb9 100644\n--- a/lib/features/label-editing/LabelEditingProvider.js\n+++ b/lib/features/label-editing/LabelEditingProvider.js\n@@ -72,7 +72,8 @@ export default function LabelEditingProvider(\n \n     var element = event.shape,\n         canExecute = event.context.canExecute,\n-        isTouch = event.isTouch;\n+        isTouch = event.isTouch,\n+        hints = event.context.hints || {};\n \n     // TODO(nikku): we need to find a way to support the\n     // direct editing on mobile devices; right now this will\n@@ -90,6 +91,11 @@ export default function LabelEditingProvider(\n       return;\n     }\n \n+    // do not activate direct editing after paste\n+    if (hints.createElementsBehavior === false) {\n+      return;\n+    }\n+\n     activateDirectEdit(element);\n   });\n \ndiff --git a/test-paste.html b/test-paste.html\nnew file mode 100644\nindex 00000000..8bf5f36e\n--- /dev/null\n+++ b/test-paste.html\n@@ -0,0 +1,112 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\" />\n+  <title>BPMN.js Paste Test</title>\n+\n+  <style>\n+    html, body, #canvas {\n+      height: 100%;\n+      margin: 0;\n+      padding: 0;\n+    }\n+  </style>\n+\n+  <script src=\"https://unpkg.com/jquery@3.3.1/dist/jquery.js\"></script>\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+</head>\n+<body>\n+  <div id=\"canvas\"></div>\n+\n+  <script>\n+    var bpmnModeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    // import XML\n+    bpmnModeler.importXML(`<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"173\" y=\"102\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"176\" y=\"138\" width=\"31\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"259\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"409\" y=\"102\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"417\" y=\"138\" width=\"20\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"209\" y=\"120\" />\n+        <di:waypoint x=\"259\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"359\" y=\"120\" />\n+        <di:waypoint x=\"409\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`, function(err) {\n+      if (err) {\n+        console.error('could not import BPMN 2.0 diagram', err);\n+      }\n+\n+      // access modeler components\n+      var canvas = bpmnModeler.get('canvas');\n+      var elementRegistry = bpmnModeler.get('elementRegistry');\n+      var copyPaste = bpmnModeler.get('copyPaste');\n+      var directEditing = bpmnModeler.get('directEditing');\n+\n+      // get task element\n+      var task = elementRegistry.get('Task_1');\n+      var rootElement = canvas.getRootElement();\n+\n+      // add button to test copy-paste\n+      var button = document.createElement('button');\n+      button.textContent = 'Copy and Paste Task';\n+      button.style.position = 'absolute';\n+      button.style.top = '10px';\n+      button.style.left = '10px';\n+      document.body.appendChild(button);\n+\n+      button.addEventListener('click', function() {\n+        // copy task\n+        copyPaste.copy(task);\n+\n+        // paste task\n+        copyPaste.paste({\n+          element: rootElement,\n+          point: {\n+            x: 500,\n+            y: 200\n+          }\n+        });\n+\n+        // check if direct editing is active\n+        console.log('Direct editing active:', directEditing.isActive());\n+      });\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/copy-paste/PasteDirectEditingSpec.js b/test/spec/features/copy-paste/PasteDirectEditingSpec.js\nnew file mode 100644\nindex 00000000..e15c6d28\n--- /dev/null\n+++ b/test/spec/features/copy-paste/PasteDirectEditingSpec.js\n@@ -0,0 +1,86 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import labelEditingModule from 'lib/features/label-editing';\n+\n+describe('features/copy-paste - paste direct editing', function() {\n+\n+  var diagramXML = require('./simple.bpmn');\n+\n+  var testModules = [\n+    bpmnCopyPasteModule,\n+    copyPasteModule,\n+    coreModule,\n+    modelingModule,\n+    labelEditingModule\n+  ];\n+\n+  beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+  it('should NOT activate direct editing after paste with task in first position', inject(function(canvas, copyPaste, elementRegistry, directEditing) {\n+    // given\n+    var task = elementRegistry.get('Task_1'),\n+        rootElement = canvas.getRootElement();\n+\n+    // when\n+    copyPaste.copy(task);\n+\n+    copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 500,\n+        y: 200\n+      }\n+    });\n+\n+    // then\n+    expect(directEditing.isActive()).to.be.false;\n+  }));\n+\n+  it('should NOT activate direct editing after paste with multiple elements and task in first position', inject(function(canvas, copyPaste, elementRegistry, directEditing) {\n+    // given\n+    var task = elementRegistry.get('Task_1'),\n+        startEvent = elementRegistry.get('StartEvent_1'),\n+        rootElement = canvas.getRootElement();\n+\n+    // when\n+    copyPaste.copy([task, startEvent]);\n+\n+    copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 500,\n+        y: 200\n+      }\n+    });\n+\n+    // then\n+    expect(directEditing.isActive()).to.be.false;\n+  }));\n+\n+  it('should NOT activate direct editing after paste with non-task in first position', inject(function(canvas, copyPaste, elementRegistry, directEditing) {\n+    // given\n+    var startEvent = elementRegistry.get('StartEvent_1'),\n+        rootElement = canvas.getRootElement();\n+\n+    // when\n+    copyPaste.copy(startEvent);\n+\n+    copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 500,\n+        y: 200\n+      }\n+    });\n+\n+    // then\n+    expect(directEditing.isActive()).to.be.false;\n+  }));\n+});\n\\ No newline at end of file\ndiff --git a/test/spec/features/copy-paste/simple.bpmn b/test/spec/features/copy-paste/simple.bpmn\nnew file mode 100644\nindex 00000000..2af2b277\n--- /dev/null\n+++ b/test/spec/features/copy-paste/simple.bpmn\n@@ -0,0 +1,44 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"173\" y=\"102\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"176\" y=\"138\" width=\"31\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"259\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"409\" y=\"102\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"417\" y=\"138\" width=\"20\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"209\" y=\"120\" />\n+        <di:waypoint x=\"259\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"359\" y=\"120\" />\n+        <di:waypoint x=\"409\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

{"instance_id": "carbon-design-system__carbon-6964", "model_patch": "diff --git a/packages/react/src/components/Tabs/Tabs-story.js b/packages/react/src/components/Tabs/Tabs-story.js\nindex cd7a7e887..d50b12497 100644\n--- a/packages/react/src/components/Tabs/Tabs-story.js\n+++ b/packages/react/src/components/Tabs/Tabs-story.js\n@@ -35,7 +35,7 @@ const props = {\n     className: 'some-class',\n     light: boolean('Light variant (light)', false),\n     selected: number('The index of the selected tab (selected in <Tabs>)', 1),\n-    role: text('ARIA role (role in <Tabs>)', 'navigation'),\n+\n     // Disabling action logger for `<Tabs onClick onKeyDown>` for now given it seems to be significantly slowing down Storybook\n     // onClick: action('onClick'),\n     // onKeyDown: action('onKeyDown'),\ndiff --git a/packages/react/src/components/Tabs/Tabs-test.js b/packages/react/src/components/Tabs/Tabs-test.js\nindex 4d84e5b59..245a536f7 100644\n--- a/packages/react/src/components/Tabs/Tabs-test.js\n+++ b/packages/react/src/components/Tabs/Tabs-test.js\n@@ -26,14 +26,14 @@ describe('Tabs', () => {\n         </Tabs>\n       );\n \n-      it('renders [role=\"navigation\"] props on wrapping <div> by default', () => {\n+      it('does not render navigation role on wrapping <div>', () => {\n         expect(\n           wrapper\n             // TODO: uncomment and replace in next major version\n             // .find(`.${prefix}--tabs`).props().role\n             .find(`.${prefix}--tabs--scrollable .${prefix}--tabs--scrollable`)\n             .props().role\n-        ).toEqual('navigation');\n+        ).toBeUndefined();\n       });\n \n       it('renders [role=\"tablist\"] props on <ul> by default', () => {\ndiff --git a/packages/react/src/components/Tabs/Tabs.js b/packages/react/src/components/Tabs/Tabs.js\nindex 61e37ec98..39637a1a0 100644\n--- a/packages/react/src/components/Tabs/Tabs.js\n+++ b/packages/react/src/components/Tabs/Tabs.js\n@@ -24,7 +24,7 @@ export default class Tabs extends React.Component {\n     children: PropTypes.node,\n \n     /**\n-     * Provide a className that is applied to the root <nav> component for the\n+     * Provide a className that is applied to the root component for the\n      * <Tabs>\n      */\n     className: PropTypes.string,\n@@ -58,11 +58,7 @@ export default class Tabs extends React.Component {\n      */\n     onSelectionChange: PropTypes.func,\n \n-    /**\n-     * By default, this value is \"navigation\". You can also provide an alternate\n-     * role if it makes sense from the accessibility-side\n-     */\n-    role: PropTypes.string.isRequired,\n+\n \n     /**\n      * Optionally provide an index for the currently selected <Tab>\n@@ -86,7 +82,6 @@ export default class Tabs extends React.Component {\n   };\n \n   static defaultProps = {\n-    role: 'navigation',\n     type: 'default',\n     selected: 0,\n     selectionMode: 'automatic',\n@@ -332,7 +327,6 @@ export default class Tabs extends React.Component {\n   render() {\n     const {\n       className,\n-      role,\n       type,\n       light,\n       onSelectionChange,\n@@ -430,7 +424,6 @@ export default class Tabs extends React.Component {\n         <div\n           {...other}\n           className={classes.tabs}\n-          role={role}\n           onScroll={this.handleScroll}>\n           <button\n             type=\"button\"\ndiff --git a/test_navigation_issue.js b/test_navigation_issue.js\nnew file mode 100644\nindex 000000000..d75dd0dac\n--- /dev/null\n+++ b/test_navigation_issue.js\n@@ -0,0 +1,78 @@\n+/**\n+ * Test to reproduce the navigation role issue in Tabs component\n+ * This test verifies that the Tabs component currently has navigation role\n+ * and will be used to verify the fix\n+ */\n+\n+const React = require('react');\n+const { shallow, mount } = require('enzyme');\n+const { configure } = require('enzyme');\n+const Adapter = require('enzyme-adapter-react-16');\n+\n+// Configure enzyme\n+configure({ adapter: new Adapter() });\n+\n+// Import the components\n+const Tabs = require('./packages/react/src/components/Tabs/Tabs.js').default;\n+const Tab = require('./packages/react/src/components/Tab/Tab.js').default;\n+\n+describe('Navigation Role Issue Reproduction', () => {\n+  console.log('=== TESTING NAVIGATION ROLE ISSUE ===');\n+  \n+  test('Tabs component should NOT have navigation role (current issue)', () => {\n+    const wrapper = shallow(\n+      React.createElement(Tabs, { className: 'test-tabs' },\n+        React.createElement(Tab, { label: 'Tab 1' }, 'Content 1'),\n+        React.createElement(Tab, { label: 'Tab 2' }, 'Content 2')\n+      )\n+    );\n+    \n+    // Find the main tabs container\n+    const tabsContainer = wrapper.find('.bx--tabs--scrollable .bx--tabs--scrollable');\n+    \n+    console.log('Current role attribute:', tabsContainer.props().role);\n+    console.log('Tabs component props:', wrapper.props());\n+    \n+    // This test currently FAILS because the component has navigation role\n+    // After the fix, this should PASS\n+    expect(tabsContainer.props().role).not.toBe('navigation');\n+  });\n+  \n+  test('Tabs component should have proper tablist structure', () => {\n+    const wrapper = shallow(\n+      React.createElement(Tabs, { className: 'test-tabs' },\n+        React.createElement(Tab, { label: 'Tab 1' }, 'Content 1'),\n+        React.createElement(Tab, { label: 'Tab 2' }, 'Content 2')\n+      )\n+    );\n+    \n+    // The ul element should still have tablist role\n+    const tablist = wrapper.find('ul');\n+    expect(tablist.props().role).toBe('tablist');\n+    console.log('Tablist role (should remain):', tablist.props().role);\n+  });\n+  \n+  test('Tabs component should not accept role prop after fix', () => {\n+    // This test checks that role prop is not accepted\n+    const TabsComponent = Tabs;\n+    const propTypes = TabsComponent.propTypes;\n+    \n+    console.log('Current propTypes keys:', Object.keys(propTypes || {}));\n+    \n+    // After fix, role should not be in propTypes\n+    expect(propTypes).not.toHaveProperty('role');\n+  });\n+  \n+  test('Tabs component should not have navigation in defaultProps', () => {\n+    const TabsComponent = Tabs;\n+    const defaultProps = TabsComponent.defaultProps;\n+    \n+    console.log('Current defaultProps:', defaultProps);\n+    \n+    // After fix, role should not be in defaultProps\n+    expect(defaultProps).not.toHaveProperty('role');\n+  });\n+});\n+\n+// Run the tests\n+console.log('Running navigation role issue reproduction tests...');\n\\ No newline at end of file\ndiff --git a/visual_test.html b/visual_test.html\nnew file mode 100644\nindex 000000000..7e9a890c2\n--- /dev/null\n+++ b/visual_test.html\n@@ -0,0 +1,88 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Tabs Navigation Role Issue Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+            background-color: #f4f4f4;\n+        }\n+        .test-container {\n+            background: white;\n+            padding: 20px;\n+            border-radius: 8px;\n+            margin-bottom: 20px;\n+        }\n+        .highlight {\n+            background-color: yellow;\n+            padding: 2px 4px;\n+            border-radius: 3px;\n+        }\n+        .issue {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .expected {\n+            color: green;\n+            font-weight: bold;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Carbon Tabs Navigation Role Issue Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h2>Issue Description</h2>\n+        <p>The Carbon Tabs component currently uses <span class=\"highlight issue\">role=\"navigation\"</span> which is incorrect.</p>\n+        <p>According to accessibility best practices:</p>\n+        <ul>\n+            <li><span class=\"issue\">\u274c Current:</span> Tabs component has role=\"navigation\"</li>\n+            <li><span class=\"expected\">\u2705 Expected:</span> Tabs component should NOT have navigation role</li>\n+            <li><span class=\"expected\">\u2705 Expected:</span> Only the inner &lt;ul&gt; should have role=\"tablist\"</li>\n+        </ul>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h2>Current DOM Structure (Before Fix)</h2>\n+        <p>Based on the code analysis, the current structure is:</p>\n+        <pre><code>&lt;div class=\"bx--tabs--scrollable\"&gt;\n+  &lt;div class=\"bx--tabs--scrollable bx--tabs--scrollable\" <span class=\"issue\">role=\"navigation\"</span>&gt;\n+    &lt;ul role=\"tablist\" class=\"bx--tabs--scrollable__nav\"&gt;\n+      &lt;!-- Tab items --&gt;\n+    &lt;/ul&gt;\n+  &lt;/div&gt;\n+&lt;/div&gt;</code></pre>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h2>Expected DOM Structure (After Fix)</h2>\n+        <p>After the fix, the structure should be:</p>\n+        <pre><code>&lt;div class=\"bx--tabs--scrollable\"&gt;\n+  &lt;div class=\"bx--tabs--scrollable bx--tabs--scrollable\"&gt;\n+    &lt;ul role=\"tablist\" class=\"bx--tabs--scrollable__nav\"&gt;\n+      &lt;!-- Tab items --&gt;\n+    &lt;/ul&gt;\n+  &lt;/div&gt;\n+&lt;/div&gt;</code></pre>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h2>Files to be Modified</h2>\n+        <ul>\n+            <li><strong>Tabs.js</strong> - Remove role prop, defaultProps, and role attribute</li>\n+            <li><strong>Tabs-story.js</strong> - Remove navigation role from story</li>\n+            <li><strong>Tabs-test.js</strong> - Update test to expect no navigation role</li>\n+        </ul>\n+    </div>\n+\n+    <script>\n+        console.log('=== TABS NAVIGATION ROLE ISSUE TEST ===');\n+        console.log('This page demonstrates the issue with Carbon Tabs component');\n+        console.log('The component currently uses role=\"navigation\" which should be removed');\n+        console.log('Navigation landmarks should be page-level decisions, not component-level');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

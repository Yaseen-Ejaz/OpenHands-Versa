{"instance_id": "prettier__prettier-11884", "model_patch": "diff --git a/debug_ast.js b/debug_ast.js\nnew file mode 100644\nindex 000000000..352debdbc\n--- /dev/null\n+++ b/debug_ast.js\n@@ -0,0 +1,37 @@\n+const prettier = require(\"./index.js\");\n+\n+// Debug AST structure for the problematic case\n+const code = `type kjhudifkalmcnf<obj extends Record<string, unknown>, aaddffgg extends string[] = aabbccdd<obj>> = aaddffgg extends []? never: never`;\n+\n+console.log(\"=== AST Debug ===\");\n+\n+try {\n+  const ast = prettier.__debug.parse(code, { parser: \"typescript\" });\n+  \n+  function findEmptyArrays(node, path = \"\") {\n+    if (!node || typeof node !== \"object\") return;\n+    \n+    if (node.type === \"TSTupleType\" && node.elementTypes && node.elementTypes.length === 0) {\n+      console.log(`Found empty TSTupleType at ${path}:`, JSON.stringify(node, null, 2));\n+    }\n+    \n+    if (node.type === \"TSArrayType\") {\n+      console.log(`Found TSArrayType at ${path}:`, JSON.stringify(node, null, 2));\n+    }\n+    \n+    for (const [key, value] of Object.entries(node)) {\n+      if (Array.isArray(value)) {\n+        value.forEach((item, index) => {\n+          findEmptyArrays(item, `${path}.${key}[${index}]`);\n+        });\n+      } else if (value && typeof value === \"object\") {\n+        findEmptyArrays(value, `${path}.${key}`);\n+      }\n+    }\n+  }\n+  \n+  findEmptyArrays(ast, \"root\");\n+  \n+} catch (error) {\n+  console.log(\"Error:\", error.message);\n+}\n\\ No newline at end of file\ndiff --git a/debug_breaking_tuple.js b/debug_breaking_tuple.js\nnew file mode 100644\nindex 000000000..200a26f42\n--- /dev/null\n+++ b/debug_breaking_tuple.js\n@@ -0,0 +1,42 @@\n+const prettier = require(\"./index.js\");\n+\n+// Test tuples that actually break to multiple lines\n+const testCases = [\n+  {\n+    name: \"Long tuple elements that should break\",\n+    code: `type Test = [VeryLongTypeNameThatWillCauseBreaking, AnotherVeryLongTypeNameThatWillCauseBreaking, YetAnotherVeryLongTypeName]`,\n+    options: { parser: \"typescript\", printWidth: 80, trailingComma: \"all\" }\n+  },\n+  {\n+    name: \"Tuple with many elements\",\n+    code: `type Test = [string, number, boolean, object, symbol, bigint, undefined, null, any, unknown, never, void]`,\n+    options: { parser: \"typescript\", printWidth: 80, trailingComma: \"all\" }\n+  },\n+  {\n+    name: \"Empty tuple that breaks (original issue)\",\n+    code: `type kjhudifkalmcnf<obj extends Record<string, unknown>, aaddffgg extends string[] = aabbccdd<obj>> = aaddffgg extends []? never: never`,\n+    options: { parser: \"typescript\", printWidth: 120, trailingComma: \"all\" }\n+  }\n+];\n+\n+testCases.forEach((testCase, index) => {\n+  console.log(`\\n=== Test ${index + 1}: ${testCase.name} ===`);\n+  console.log(\"Input:\");\n+  console.log(testCase.code);\n+  console.log(\"\\nOutput:\");\n+  \n+  try {\n+    const formatted = prettier.format(testCase.code, testCase.options);\n+    console.log(formatted);\n+    \n+    if (formatted.includes(\",\\n]\")) {\n+      console.log(\"\u2705 Has trailing comma\");\n+    } else if (formatted.includes(\"[\\n]\") || formatted.includes(\"[\\n\\n]\")) {\n+      console.log(\"\u2705 Empty tuple correctly formatted without comma\");\n+    } else {\n+      console.log(\"\u2139\ufe0f  Tuple didn't break to multiple lines\");\n+    }\n+  } catch (error) {\n+    console.log(\"Error:\", error.message);\n+  }\n+});\n\\ No newline at end of file\ndiff --git a/debug_trailing_comma.js b/debug_trailing_comma.js\nnew file mode 100644\nindex 000000000..c5ca30943\n--- /dev/null\n+++ b/debug_trailing_comma.js\n@@ -0,0 +1,34 @@\n+const prettier = require(\"./index.js\");\n+\n+// Test to understand when trailing commas should appear in tuples\n+const testCases = [\n+  {\n+    name: \"Single element tuple that should break\",\n+    code: `type VeryLongTypeNameThatWillCauseLineBreakingForSureThisTime<T> = T extends [string] ? never : never`,\n+    options: { parser: \"typescript\", printWidth: 60, trailingComma: \"all\" }\n+  },\n+  {\n+    name: \"Multi element tuple that should break\", \n+    code: `type VeryLongTypeNameThatWillCauseLineBreakingForSureThisTime<T> = T extends [string, number, boolean] ? never : never`,\n+    options: { parser: \"typescript\", printWidth: 60, trailingComma: \"all\" }\n+  },\n+  {\n+    name: \"Array literal for comparison\",\n+    code: `const veryLongVariableNameThatWillCauseLineBreaking = [string, number, boolean];`,\n+    options: { parser: \"typescript\", printWidth: 60, trailingComma: \"all\" }\n+  }\n+];\n+\n+testCases.forEach((testCase, index) => {\n+  console.log(`\\n=== Test ${index + 1}: ${testCase.name} ===`);\n+  console.log(\"Input:\");\n+  console.log(testCase.code);\n+  console.log(\"\\nOutput:\");\n+  \n+  try {\n+    const formatted = prettier.format(testCase.code, testCase.options);\n+    console.log(formatted);\n+  } catch (error) {\n+    console.log(\"Error:\", error.message);\n+  }\n+});\n\\ No newline at end of file\ndiff --git a/final_verification.js b/final_verification.js\nnew file mode 100644\nindex 000000000..cac660c72\n--- /dev/null\n+++ b/final_verification.js\n@@ -0,0 +1,36 @@\n+const prettier = require(\"./index.js\");\n+\n+// Final verification with the exact original issue case\n+const originalCode = `type aabbccdd<a> = []\n+type kjhudifkalmcnf<obj extends Record<string, unknown>, aaddffgg extends string[] = aabbccdd<obj>> = aaddffgg extends []? never: never`;\n+\n+const options = {\n+  parser: \"typescript\",\n+  printWidth: 120,\n+  trailingComma: \"all\"\n+};\n+\n+console.log(\"=== FINAL VERIFICATION ===\");\n+console.log(\"Original issue case:\");\n+console.log(originalCode);\n+console.log(\"\\nFormatted output:\");\n+\n+const formatted = prettier.format(originalCode, options);\n+console.log(formatted);\n+\n+// Check if the issue is fixed\n+if (formatted.includes(\"[,]\") || formatted.includes(\"[\\n  ,\\n]\")) {\n+  console.log(\"\u274c ISSUE STILL EXISTS: Empty array has trailing comma!\");\n+  process.exit(1);\n+} else {\n+  console.log(\"\u2705 ISSUE FIXED: Empty array correctly formatted without trailing comma!\");\n+}\n+\n+// Verify expected output matches the issue description\n+const expectedPattern = /aaddffgg extends \\[\\s*\\]/;\n+if (expectedPattern.test(formatted)) {\n+  console.log(\"\u2705 Output matches expected format from issue description\");\n+} else {\n+  console.log(\"\u274c Output doesn't match expected format\");\n+  process.exit(1);\n+}\n\\ No newline at end of file\ndiff --git a/src/language-js/print/type-annotation.js b/src/language-js/print/type-annotation.js\nindex 7772e9099..bfd4b5c55 100644\n--- a/src/language-js/print/type-annotation.js\n+++ b/src/language-js/print/type-annotation.js\n@@ -293,7 +293,7 @@ function printTupleType(path, options, print) {\n   return group([\n     \"[\",\n     indent([softline, printArrayItems(path, options, typesField, print)]),\n-    ifBreak(shouldPrintComma(options, \"all\") && !hasRest ? \",\" : \"\"),\n+    ifBreak(shouldPrintComma(options, \"all\") && !hasRest && node[typesField].length > 0 ? \",\" : \"\"),\n     printDanglingComments(path, options, /* sameIndent */ true),\n     softline,\n     \"]\",\ndiff --git a/tests/format/typescript/tuple/__snapshots__/jsfmt.spec.js.snap b/tests/format/typescript/tuple/__snapshots__/jsfmt.spec.js.snap\nindex 9681ac3ce..1518385f4 100644\n--- a/tests/format/typescript/tuple/__snapshots__/jsfmt.spec.js.snap\n+++ b/tests/format/typescript/tuple/__snapshots__/jsfmt.spec.js.snap\n@@ -1,5 +1,142 @@\n // Jest Snapshot v1, https://goo.gl/fbAQLP\n \n+exports[`empty-tuple-no-trailing-comma.ts - {\"trailingComma\":\"all\"} format 1`] = `\n+====================================options=====================================\n+parsers: [\"typescript\"]\n+printWidth: 80\n+trailingComma: \"all\"\n+                                                                                | printWidth\n+======================
ound image tiles to ignore. By setting\n+ * this property to a non-zero value, images will be requested that are wider\n+ * and taller than the tile size by a value of `2 x gutter`.\n+ * Using a non-zero value allows artifacts of rendering at tile edges to be\n+ * ignored. If you control the tile service it is recommended to address\n+ * \"artifacts at tile edges\" issues by properly configuring the tile service.\n  * @property {number} [maxZoom=42] Optional max zoom level. Not used if `tileGrid` is provided.\n  * @property {number} [minZoom=0] Optional min zoom level. Not used if `tileGrid` is provided.\n  * @property {number|import(\"../size.js\").Size} [tileSize=[256, 256]] The pixel width and height of the tiles.\n@@ -80,6 +86,12 @@ class DataTileSource extends TileSource {\n       interpolate: options.interpolate,\n     });\n \n+    /**\n+     * @private\n+     * @type {number}\n+     */\n+    this.gutter_ = options.gutter !== undefined ? options.gutter : 0;\n+\n     /**\n      * @private\n      * @type {!Object<string, boolean>}\n@@ -107,6 +119,21 @@ class DataTileSource extends TileSource {\n     this.loader_ = loader;\n   }\n \n+  /**\n+   * @return {number} Gutter.\n+   */\n+  getGutter() {\n+    return this.gutter_;\n+  }\n+\n+  /**\n+   * @param {import(\"../proj/Projection.js\").default} projection Projection.\n+   * @return {number} Gutter.\n+   */\n+  getGutterForProjection(projection) {\n+    return this.getGutter();\n+  }\n+\n   /**\n    * @param {number} z Tile coordinate z.\n    * @param {number} x Tile coordinate x.\ndiff --git a/src/ol/source/XYZ.js b/src/ol/source/XYZ.js\nindex 15b11cb38..dbd057c83 100644\n--- a/src/ol/source/XYZ.js\n+++ b/src/ol/source/XYZ.js\n@@ -13,6 +13,12 @@ import {createXYZ, extentFromProjection} from '../tilegrid.js';\n  * @property {null|string} [crossOrigin] The `crossOrigin` attribute for loaded images.  Note that\n  * you must provide a `crossOrigin` value if you want to access pixel data with the Canvas renderer.\n  * See https://developer.mozilla.org/en-US/docs/Web/HTML/CORS_enabled_image for more detail.\n+ * @property {number} [gutter=0] The size in pixels of the gutter around image tiles to ignore. By setting\n+ * this property to a non-zero value, images will be requested that are wider\n+ * and taller than the tile size by a value of `2 x gutter`.\n+ * Using a non-zero value allows artifacts of rendering at tile edges to be\n+ * ignored. If you control the tile service it is recommended to address\n+ * \"artifacts at tile edges\" issues by properly configuring the tile service.\n  * @property {boolean} [imageSmoothing=true] Deprecated.  Use the `interpolate` option instead.\n  * @property {boolean} [interpolate=true] Use interpolated values when resampling.  By default,\n  * linear interpolation is used when resampling.  Set to false to use the nearest neighbor instead.\n@@ -114,6 +120,19 @@ class XYZ extends TileImage {\n       attributionsCollapsible: options.attributionsCollapsible,\n       zDirection: options.zDirection,\n     });\n+\n+    /**\n+     * @private\n+     * @type {number}\n+     */\n+    this.gutter_ = options.gutter !== undefined ? options.gutter : 0;\n+  }\n+\n+  /**\n+   * @return {number} Gutter.\n+   */\n+  getGutter() {\n+    return this.gutter_;\n   }\n }\n \ndiff --git a/src/ol/webgl/TileTexture.js b/src/ol/webgl/TileTexture.js\nindex 8c457639b..4298933cd 100644\n--- a/src/ol/webgl/TileTexture.js\n+++ b/src/ol/webgl/TileTexture.js\n@@ -192,15 +192,26 @@ class TileTexture extends EventTarget {\n     this.helper_ = options.helper;\n \n     const coords = new WebGLArrayBuffer(ARRAY_BUFFER, STATIC_DRAW);\n+    \n+    // Calculate texture coordinates accounting for gutter\n+    const gutter = options.gutter || 0;\n+    const tileSize = this.size[0]; // Assuming square tiles\n+    const gutterRatio = gutter / (tileSize + 2 * gutter);\n+    const contentRatio = tileSize / (tileSize + 2 * gutter);\n+    \n+    // Adjust texture coordinates to exclude gutter area\n+    const minCoord = gutterRatio;\n+    const maxCoord = gutterRatio + contentRatio;\n+    \n     coords.fromArray([\n-      0, // P0\n-      1,\n-      1, // P1\n-      1,\n-      1, // P2\n-      0,\n-      0, // P3\n-      0,\n+      minCoord, // P0\n+      maxCoord,\n+      maxCoord, // P1\n+      maxCoord,\n+      maxCoord, // P2\n+      minCoord,\n+      minCoord, // P3\n+      minCoord,\n     ]);\n     this.helper_.flushBufferData(coords);\n \n@@ -243,28 +254,8 @@ class TileTexture extends EventTarget {\n     const tile = this.tile;\n \n     if (tile instanceof ImageTile || tile instanceof ReprojTile) {\n-      let image = tile.getImage();\n-      if (this.gutter_ !== 0) {\n-        const gutter = this.tilePixelRatio_ * this.gutter_;\n-        const width = Math.round(image.width - 2 * gutter);\n-        const height = Math.round(image.height - 2 * gutter);\n-        const context = createCanvasContext2D(width, height);\n-        if (!tile.interpolate) {\n-          assign(context, IMAGE_SMOOTHING_DISABLED);\n-        }\n-        context.drawImage(\n-          image,\n-          gutter,\n-          gutter,\n-          width,\n-          height,\n-          0,\n-          0,\n-          width,\n-          height\n-        );\n-        image = context.canvas;\n-      }\n+      const image = tile.getImage();\n+      // Don't crop gutter pixels - preserve the full image and let texture coordinates handle the clipping\n       const texture = gl.createTexture();\n       this.textures.push(texture);\n       this.bandCount = 4;\ndiff --git a/test_gutter_comprehensive.js b/test_gutter_comprehensive.js\nnew file mode 100644\nindex 000000000..90b5f47d2\n--- /dev/null\n+++ b/test_gutter_comprehensive.js\n@@ -0,0 +1,103 @@\n+/**\n+ * Comprehensive test for gutter implementation\n+ */\n+\n+import XYZ from '../src/ol/source/XYZ.js';\n+import DataTile from '../src/ol/source/DataTile.js';\n+import TileWMS from '../src/ol/source/TileWMS.js';\n+\n+describe('Gutter Implementation Tests', function() {\n+  \n+  describe('XYZ Source Gutter Support', function() {\n+    it('should accept gutter option in constructor', function() {\n+      const source = new XYZ({\n+        url: 'https://example.com/{z}/{x}/{y}.png',\n+        gutter: 2\n+      });\n+      expect(source.getGutter()).to.be(2);\n+    });\n+\n+    it('should default gutter to 0', function() {\n+      const source = new XYZ({\n+        url: 'https://example.com/{z}/{x}/{y}.png'\n+      });\n+      expect(source.getGutter()).to.be(0);\n+    });\n+\n+    it('should have getGutter method', function() {\n+      const source = new XYZ();\n+      expect(typeof source.getGutter).to.be('function');\n+    });\n+  });\n+\n+  describe('DataTile Source Gutter Support', function() {\n+    it('should accept gutter option in constructor', function() {\n+      const source = new DataTile({\n+        loader: function(z, x, y) {\n+          return new Uint8Array(256 * 256 * 4);\n+        },\n+        gutter: 2\n+      });\n+      expect(source.getGutter()).to.be(2);\n+    });\n+\n+    it('should default gutter to 0', function() {\n+      const source = new DataTile({\n+        loader: function(z, x, y) {\n+          return new Uint8Array(256 * 256 * 4);\n+        }\n+      });\n+      expect(source.getGutter()).to.be(0);\n+    });\n+\n+    it('should have getGutter method', function() {\n+      const source = new DataTile({\n+        loader: function(z, x, y) {\n+          return new Uint8Array(256 * 256 * 4);\n+        }\n+      });\n+      expect(typeof source.getGutter).to.be('function');\n+    });\n+\n+    it('should have getGutterForProjection method', function() {\n+      const source = new DataTile({\n+        loader: function(z, x, y) {\n+          return new Uint8Array(256 * 256 * 4);\n+        }\n+      });\n+      expect(typeof source.getGutterForProjection).to.be('function');\n+    });\n+  });\n+\n+  describe('TileWMS Gutter Support (existing)', function() {\n+    it('should still work with gutter option', function() {\n+      const source = new TileWMS({\n+        url: 'https://example.com/wms',\n+        params: {\n+          'LAYERS': 'test'\n+        },\n+        gutter: 10\n+      });\n+      expect(source.getGutter()).to.be(10);\n+    });\n+  });\n+\n+  describe('Gutter Consistency', function() {\n+    it('should have consistent gutter API across all tile sources', function() {\n+      const xyzSource = new XYZ({ gutter: 5 });\n+      const dataTileSource = new DataTile({ \n+        loader: () => new Uint8Array(256 * 256 * 4),\n+        gutter: 5 \n+      });\n+      const wmsSource = new TileWMS({\n+        url: 'https://example.com/wms',\n+        params: { 'LAYERS': 'test' },\n+        gutter: 5\n+      });\n+\n+      expect(xyzSource.getGutter()).to.be(5);\n+      expect(dataTileSource.getGutter()).to.be(5);\n+      expect(wmsSource.getGutter()).to.be(5);\n+    });\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_gutter_implementation.html b/test_gutter_implementation.html\nnew file mode 100644\nindex 000000000..9c4667f51\n--- /dev/null\n+++ b/test_gutter_implementation.html\n@@ -0,0 +1,188 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Gutter Implementation Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .test-container { margin-bottom: 30px; }\n+        .map-container { width: 400px; height: 300px; border: 1px solid #ccc; margin: 10px 0; }\n+        .description { margin: 10px 0; font-size: 14px; }\n+        .error { color: red; }\n+        .success { color: green; }\n+    </style>\n+    <script src=\"./dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Gutter (Buffer) Implementation Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 1: TileWMS with Gutter (Current Implementation)</h2>\n+        <div class=\"description\">This should work as gutters are already implemented for TileWMS</div>\n+        <div id=\"map1\" class=\"map-container\"></div>\n+        <div id=\"result1\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 2: XYZ Source with Gutter (Should be implemented)</h2>\n+        <div class=\"description\">This should support gutter option after implementation</div>\n+        <div id=\"map2\" class=\"map-container\"></div>\n+        <div id=\"result2\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 3: DataTile Source with Gutter (Should be implemented)</h2>\n+        <div class=\"description\">This should support gutter option after implementation</div>\n+        <div id=\"map3\" class=\"map-container\"></div>\n+        <div id=\"result3\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 4: WebGL Tile Layer with Gutter</h2>\n+        <div class=\"description\">WebGL should handle gutters properly without removing them before texture creation</div>\n+        <div id=\"map4\" class=\"map-container\"></div>\n+        <div id=\"result4\"></div>\n+    </div>\n+\n+    <script>\n+        // Test 1: TileWMS with Gutter (Current Implementation)\n+        try {\n+            const wmsSource = new ol.source.TileWMS({\n+                url: 'https://ahocevar.com/geoserver/wms',\n+                params: {\n+                    'LAYERS': 'ne:ne',\n+                    'TILED': true\n+                },\n+                gutter: 10 // This should work\n+            });\n+            \n+            const map1 = new ol.Map({\n+                target: 'map1',\n+                layers: [\n+                    new ol.layer.Tile({\n+                        source: wmsSource\n+                    })\n+                ],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            // Test if gutter is accessible\n+            const gutter = wmsSource.getGutter();\n+            document.getElementById('result1').innerHTML = \n+                `<span class=\"success\">\u2713 TileWMS gutter: ${gutter}</span>`;\n+        } catch (error) {\n+            document.getElementById('result1').innerHTML = \n+                `<span class=\"error\">\u2717 TileWMS Error: ${error.message}</span>`;\n+        }\n+\n+        // Test 2: XYZ Source with Gutter\n+        try {\n+            const xyzSource = new ol.source.XYZ({\n+                url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',\n+                gutter: 2 // This should be implemented\n+            });\n+            \n+            const map2 = new ol.Map({\n+                target: 'map2',\n+                layers: [\n+                    new ol.layer.Tile({\n+                        source: xyzSource\n+                    })\n+                ],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            // Test if gutter is accessible\n+            const gutter = xyzSource.getGutter ? xyzSource.getGutter() : 'Method not available';\n+            document.getElementById('result2').innerHTML = \n+                gutter !== 'Method not available' ? \n+                `<span class=\"success\">\u2713 XYZ gutter: ${gutter}</span>` :\n+                `<span class=\"error\">\u2717 XYZ getGutter method not available</span>`;\n+        } catch (error) {\n+            document.getElementById('result2').innerHTML = \n+                `<span class=\"error\">\u2717 XYZ Error: ${error.message}</span>`;\n+        }\n+\n+        // Test 3: DataTile Source with Gutter\n+        try {\n+            const dataTileSource = new ol.source.DataTile({\n+                loader: function(z, x, y) {\n+                    // Simple test data loader\n+                    const size = 256;\n+                    const data = new Uint8Array(size * size * 4);\n+                    for (let i = 0; i < data.length; i += 4) {\n+                        data[i] = Math.random() * 255;     // R\n+                        data[i + 1] = Math.random() * 255; // G\n+                        data[i + 2] = Math.random() * 255; // B\n+                        data[i + 3] = 255;                 // A\n+                    }\n+                    return data;\n+                },\n+                gutter: 2 // This should be implemented\n+            });\n+            \n+            const map3 = new ol.Map({\n+                target: 'map3',\n+                layers: [\n+                    new ol.layer.WebGLTile({\n+                        source: dataTileSource\n+                    })\n+                ],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            // Test if gutter is accessible\n+            const gutter = dataTileSource.getGutter ? dataTileSource.getGutter() : 'Method not available';\n+            document.getElementById('result3').innerHTML = \n+                gutter !== 'Method not available' ? \n+                `<span class=\"success\">\u2713 DataTile gutter: ${gutter}</span>` :\n+                `<span class=\"error\">\u2717 DataTile getGutter method not available</span>`;\n+        } catch (error) {\n+            document.getElementById('result3').innerHTML = \n+                `<span class=\"error\">\u2717 DataTile Error: ${error.message}</span>`;\n+        }\n+\n+        // Test 4: WebGL Tile Layer with Gutter\n+        try {\n+            const webglSource = new ol.source.XYZ({\n+                url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',\n+                gutter: 2\n+            });\n+            \n+            const map4 = new ol.Map({\n+                target: 'map4',\n+                layers: [\n+                    new ol.layer.WebGLTile({\n+                        source: webglSource\n+                    })\n+                ],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            document.getElementById('result4').innerHTML = \n+                `<span class=\"success\">\u2713 WebGL layer created (gutter handling to be verified)</span>`;\n+        } catch (error) {\n+            document.getElementById('result4').innerHTML = \n+                `<span class=\"error\">\u2717 WebGL Error: ${error.message}</span>`;\n+        }\n+\n+        // Additional test to check current gutter behavior\n+        console.log('=== Gutter Implementation Test Results ===');\n+        console.log('TileWMS has getGutter method:', typeof ol.source.TileWMS.prototype.getGutter === 'function');\n+        console.log('XYZ has getGutter method:', typeof ol.source.XYZ.prototype.getGutter === 'function');\n+        console.log('DataTile has getGutter method:', typeof ol.source.DataTile.prototype.getGutter === 'function');\n+        console.log('TileImage has getGutter method:', typeof ol.source.TileImage.prototype.getGutter === 'function');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

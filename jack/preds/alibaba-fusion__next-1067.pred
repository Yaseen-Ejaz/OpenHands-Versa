{"instance_id": "alibaba-fusion__next-1067", "model_patch": "diff --git a/src/slider/slick/arrow.jsx b/src/slider/slick/arrow.jsx\nindex e8f9b6610..fb31f4c01 100644\n--- a/src/slider/slick/arrow.jsx\n+++ b/src/slider/slick/arrow.jsx\n@@ -50,9 +50,15 @@ export default class Arrow extends Component {\n             return false;\n         }\n \n-        // \u4e0b\u4e00\u4e2a index \u5927\u4e8e\u603b\u6570\uff1f\uff1f\n+        // When slideCount <= slidesToShow, check if navigation is still possible based on current position\n         if (slideCount <= slidesToShow) {\n-            return true;\n+            if (type === 'prev') {\n+                // Allow prev navigation if not at the beginning\n+                return currentSlide <= 0;\n+            } else {\n+                // Allow next navigation if not at the end (for cases where slides extend beyond view)\n+                return currentSlide >= slideCount - 1;\n+            }\n         }\n \n         // \u5411\u524d\u7bad\u5934\uff1a\u5f53\u524d\u662f\u7b2c 0 \u4e2a\ndiff --git a/test_comprehensive_slider.html b/test_comprehensive_slider.html\nnew file mode 100644\nindex 000000000..096931582\n--- /dev/null\n+++ b/test_comprehensive_slider.html\n@@ -0,0 +1,285 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Comprehensive Slider Test</title>\n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-case {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+            border-radius: 5px;\n+        }\n+        .test-result {\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 3px;\n+        }\n+        .test-pass {\n+            background: #d4edda;\n+            color: #155724;\n+            border: 1px solid #c3e6cb;\n+        }\n+        .test-fail {\n+            background: #f8d7da;\n+            color: #721c24;\n+            border: 1px solid #f5c6cb;\n+        }\n+        .slider-container {\n+            width: 400px;\n+            margin: 20px 0;\n+        }\n+        .slide {\n+            background: #f0f0f0;\n+            padding: 20px;\n+            margin: 5px;\n+            text-align: center;\n+            border-radius: 3px;\n+        }\n+        .next-slick-arrow {\n+            background: #007bff;\n+            color: white;\n+            border: none;\n+            padding: 10px;\n+            margin: 5px;\n+            cursor: pointer;\n+            border-radius: 3px;\n+        }\n+        .next-slick-arrow.disabled {\n+            background: #ccc;\n+            cursor: not-allowed;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Comprehensive Slider Arrow Logic Test</h1>\n+    \n+    <div id=\"test-results\"></div>\n+\n+    <script type=\"text/babel\">\n+        const { useState, useEffect } = React;\n+\n+        // Fixed Arrow component with the new logic\n+        const Arrow = ({ type, infinite, currentSlide, slideCount, slidesToShow, onClick }) => {\n+            const isDisabled = () => {\n+                if (infinite) {\n+                    return false;\n+                }\n+\n+                // When slideCount <= slidesToShow, check if navigation is still possible based on current position\n+                if (slideCount <= slidesToShow) {\n+                    if (type === 'prev') {\n+                        // Allow prev navigation if not at the beginning\n+                        return currentSlide <= 0;\n+                    } else {\n+                        // Allow next navigation if not at the end (for cases where slides extend beyond view)\n+                        return currentSlide >= slideCount - 1;\n+                    }\n+                }\n+\n+                if (type === 'prev') {\n+                    return currentSlide <= 0;\n+                }\n+\n+                if (currentSlide >= slideCount - slidesToShow) {\n+                    return true;\n+                }\n+\n+                return false;\n+            };\n+\n+            const disabled = isDisabled();\n+            \n+            return (\n+                <button \n+                    className={`next-slick-arrow next-slick-${type} ${disabled ? 'disabled' : ''}`}\n+                    onClick={disabled ? null : onClick}\n+                    disabled={disabled}\n+                >\n+                    {type === 'prev' ? '\u2190' : '\u2192'} {disabled ? 'disabled' : 'enabled'}\n+                </button>\n+            );\n+        };\n+\n+        // Test runner\n+        const TestRunner = () => {\n+            const [results, setResults] = useState([]);\n+\n+            const runTest = (name, testFn) => {\n+                try {\n+                    const result = testFn();\n+                    setResults(prev => [...prev, { name, result: 'PASS', message: result }]);\n+                } catch (error) {\n+                    setResults(prev => [...prev, { name, result: 'FAIL', message: error.message }]);\n+                }\n+            };\n+\n+            useEffect(() => {\n+                // Test 1: Existing test scenario - should still work\n+                runTest('Existing Test: 4 slides, infinite=false, currentSlide=0', () => {\n+                    const prevDisabled = Arrow.prototype.constructor({ \n+                        type: 'prev', infinite: false, currentSlide: 0, slideCount: 4, slidesToShow: 1 \n+                    }).props.disabled;\n+                    const nextDisabled = Arrow.prototype.constructor({ \n+                        type: 'next', infinite: false, currentSlide: 0, slideCount: 4, slidesToShow: 1 \n+                    }).props.disabled;\n+                    \n+                    // Simulate the isDisabled logic\n+                    const isDisabledPrev = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide <= 0;\n+                        }\n+                        return currentSlide <= 0;\n+                    };\n+                    \n+                    const isDisabledNext = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide >= slideCount - 1;\n+                        }\n+                        return currentSlide >= slideCount - slidesToShow;\n+                    };\n+                    \n+                    const prevDisabledActual = isDisabledPrev(4, 1, 0);\n+                    const nextDisabledActual = isDisabledNext(4, 1, 0);\n+                    const totalDisabled = (prevDisabledActual ? 1 : 0) + (nextDisabledActual ? 1 : 0);\n+                    \n+                    if (totalDisabled !== 1) {\n+                        throw new Error(`Expected 1 disabled arrow, got ${totalDisabled}`);\n+                    }\n+                    return `\u2713 Prev: ${prevDisabledActual ? 'disabled' : 'enabled'}, Next: ${nextDisabledActual ? 'disabled' : 'enabled'} (1 disabled total)`;\n+                });\n+\n+                // Test 2: Bug scenario - should be fixed\n+                runTest('Bug Fix: slidesToShow > slideCount, infinite=false, currentSlide > 0', () => {\n+                    const isDisabledPrev = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide <= 0;\n+                        }\n+                        return currentSlide <= 0;\n+                    };\n+                    \n+                    const isDisabledNext = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide >= slideCount - 1;\n+                        }\n+                        return currentSlide >= slideCount - slidesToShow;\n+                    };\n+                    \n+                    const prevDisabled = isDisabledPrev(3, 5, 2);\n+                    const nextDisabled = isDisabledNext(3, 5, 2);\n+                    \n+                    if (prevDisabled) {\n+                        throw new Error(`Prev arrow should be enabled when currentSlide=2 > 0, but it's disabled`);\n+                    }\n+                    if (!nextDisabled) {\n+                        throw new Error(`Next arrow should be disabled when currentSlide=2 >= slideCount-1=2, but it's enabled`);\n+                    }\n+                    return `\u2713 Prev: enabled (correct), Next: disabled (correct)`;\n+                });\n+\n+                // Test 3: Edge case - currentSlide at beginning\n+                runTest('Edge Case: slidesToShow > slideCount, currentSlide=0', () => {\n+                    const isDisabledPrev = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide <= 0;\n+                        }\n+                        return currentSlide <= 0;\n+                    };\n+                    \n+                    const isDisabledNext = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide >= slideCount - 1;\n+                        }\n+                        return currentSlide >= slideCount - slidesToShow;\n+                    };\n+                    \n+                    const prevDisabled = isDisabledPrev(3, 5, 0);\n+                    const nextDisabled = isDisabledNext(3, 5, 0);\n+                    \n+                    if (!prevDisabled) {\n+                        throw new Error(`Prev arrow should be disabled when currentSlide=0, but it's enabled`);\n+                    }\n+                    if (nextDisabled) {\n+                        throw new Error(`Next arrow should be enabled when currentSlide=0 < slideCount-1=2, but it's disabled`);\n+                    }\n+                    return `\u2713 Prev: disabled (correct), Next: enabled (correct)`;\n+                });\n+\n+                // Test 4: Normal case - should still work\n+                runTest('Normal Case: slidesToShow < slideCount, infinite=false', () => {\n+                    const isDisabledPrev = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide <= 0;\n+                        }\n+                        return currentSlide <= 0;\n+                    };\n+                    \n+                    const isDisabledNext = (slideCount, slidesToShow, currentSlide) => {\n+                        if (slideCount <= slidesToShow) {\n+                            return currentSlide >= slideCount - 1;\n+                        }\n+                        return currentSlide >= slideCount - slidesToShow;\n+                    };\n+                    \n+                    const prevDisabled = isDisabledPrev(5, 2, 1);\n+                    const nextDisabled = isDisabledNext(5, 2, 1);\n+                    \n+                    if (prevDisabled) {\n+                        throw new Error(`Prev arrow should be enabled when currentSlide=1 > 0, but it's disabled`);\n+                    }\n+                    if (nextDisabled) {\n+                        throw new Error(`Next arrow should be enabled when currentSlide=1 < slideCount-slidesToShow=3, but it's disabled`);\n+                    }\n+                    return `\u2713 Both arrows enabled (correct)`;\n+                });\n+\n+                // Test 5: Infinite mode - should always be enabled\n+                runTest('Infinite Mode: Both arrows should be enabled', () => {\n+                    const isDisabledPrev = (infinite) => {\n+                        if (infinite) return false;\n+                        return true; // This shouldn't be reached\n+                    };\n+                    \n+                    const isDisabledNext = (infinite) => {\n+                        if (infinite) return false;\n+                        return true; // This shouldn't be reached\n+                    };\n+                    \n+                    const prevDisabled = isDisabledPrev(true);\n+                    const nextDisabled = isDisabledNext(true);\n+                    \n+                    if (prevDisabled || nextDisabled) {\n+                        throw new Error(`Both arrows should be enabled in infinite mode`);\n+                    }\n+                    return `\u2713 Both arrows enabled in infinite mode (correct)`;\n+                });\n+\n+            }, []);\n+\n+            return (\n+                <div>\n+                    <h2>Test Results</h2>\n+                    {results.map((result, index) => (\n+                        <div key={index} className={`test-result ${result.result === 'PASS' ? 'test-pass' : 'test-fail'}`}>\n+                            <strong>{result.result}</strong>: {result.name}\n+                            <br />\n+                            <small>{result.message}</small>\n+                        </div>\n+                    ))}\n+                    {results.length === 0 && <div>Running tests...</div>}\n+                </div>\n+            );\n+        };\n+\n+        ReactDOM.render(<TestRunner />, document.getElementById('test-results'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_real_slider.html b/test_real_slider.html\nnew file mode 100644\nindex 000000000..80f78df95\n--- /dev/null\n+++ b/test_real_slider.html\n@@ -0,0 +1,248 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Real Slider Test</title>\n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <script src=\"https://unpkg.com/prop-types@15/prop-types.min.js\"></script>\n+    <script src=\"https://unpkg.com/classnames@2/index.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-case {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+            border-radius: 5px;\n+        }\n+        .slider-container {\n+            width: 400px;\n+            margin: 20px 0;\n+        }\n+        .slide {\n+            background: #f0f0f0;\n+            padding: 20px;\n+            margin: 5px;\n+            text-align: center;\n+            border-radius: 3px;\n+            min-height: 50px;\n+        }\n+        /* Basic slider styles */\n+        .next-slick-container {\n+            position: relative;\n+        }\n+        .next-slick-list {\n+            overflow: hidden;\n+            position: relative;\n+        }\n+        .next-slick-track {\n+            display: flex;\n+            transition: transform 0.3s ease;\n+        }\n+        .next-slick-slide {\n+            flex: 0 0 auto;\n+        }\n+        .next-slick-arrow {\n+            background: #007bff;\n+            color: white;\n+            border: none;\n+            padding: 10px 15px;\n+            margin: 5px;\n+            cursor: pointer;\n+            border-radius: 3px;\n+            position: absolute;\n+            top: 50%;\n+            transform: translateY(-50%);\n+            z-index: 1;\n+        }\n+        .next-slick-arrow.disabled {\n+            background: #ccc;\n+            cursor: not-allowed;\n+        }\n+        .next-slick-prev {\n+            left: 10px;\n+        }\n+        .next-slick-next {\n+            right: 10px;\n+        }\n+        .next-slick-dots {\n+            text-align: center;\n+            margin-top: 20px;\n+        }\n+        .next-slick-dots button {\n+            background: #ccc;\n+            border: none;\n+            width: 10px;\n+            height: 10px;\n+            border-radius: 50%;\n+            margin: 0 5px;\n+            cursor: pointer;\n+        }\n+        .next-slick-dots .active button {\n+            background: #007bff;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Real Slider Component Test</h1>\n+    \n+    <div class=\"test-case\">\n+        <h2>Bug Test Case: slidesToShow=5, slideCount=3, defaultActiveIndex=2</h2>\n+        <p><strong>Expected:</strong> Prev arrow should be enabled, Next arrow should be disabled</p>\n+        <div id=\"bug-test\"></div>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <h2>Control Test Case: Normal slider with 4 slides</h2>\n+        <p><strong>Expected:</strong> Prev arrow disabled at start, Next arrow enabled</p>\n+        <div id=\"control-test\"></div>\n+    </div>\n+\n+    <script type=\"text/babel\">\n+        const { useState, useEffect, useRef } = React;\n+\n+        // Simplified Slider component that uses our fixed Arrow logic\n+        const TestSlider = ({ slidesToShow = 1, infinite = false, defaultActiveIndex = 0, children }) => {\n+            const [currentSlide, setCurrentSlide] = useState(defaultActiveIndex);\n+            const slideCount = React.Children.count(children);\n+\n+            // Fixed Arrow logic from our implementation\n+            const isArrowDisabled = (type) => {\n+                if (infinite) {\n+                    return false;\n+                }\n+\n+                // When slideCount <= slidesToShow, check if navigation is still possible based on current position\n+                if (slideCount <= slidesToShow) {\n+                    if (type === 'prev') {\n+                        // Allow prev navigation if not at the beginning\n+                        return currentSlide <= 0;\n+                    } else {\n+                        // Allow next navigation if not at the end (for cases where slides extend beyond view)\n+                        return currentSlide >= slideCount - 1;\n+                    }\n+                }\n+\n+                if (type === 'prev') {\n+                    return currentSlide <= 0;\n+                }\n+\n+                if (currentSlide >= slideCount - slidesToShow) {\n+                    return true;\n+                }\n+\n+                return false;\n+            };\n+\n+            const goToPrev = () => {\n+                if (!isArrowDisabled('prev')) {\n+                    setCurrentSlide(Math.max(0, currentSlide - 1));\n+                }\n+            };\n+\n+            const goToNext = () => {\n+                if (!isArrowDisabled('next')) {\n+                    setCurrentSlide(Math.min(slideCount - 1, currentSlide + 1));\n+                }\n+            };\n+\n+            const prevDisabled = isArrowDisabled('prev');\n+            const nextDisabled = isArrowDisabled('next');\n+\n+            return (\n+                <div className=\"slider-container\">\n+                    <div style={{ marginBottom: '10px' }}>\n+                        <strong>Config:</strong> slidesToShow={slidesToShow}, slideCount={slideCount}, infinite={infinite.toString()}, currentSlide={currentSlide}\n+                    </div>\n+                    <div style={{ marginBottom: '10px' }}>\n+                        <strong>Arrow States:</strong> Prev: {prevDisabled ? 'DISABLED' : 'ENABLED'}, Next: {nextDisabled ? 'DISABLED' : 'ENABLED'}\n+                    </div>\n+                    \n+                    <div className=\"next-slick-container\" style={{ position: 'relative', height: '120px' }}>\n+                        <button \n+                            className={`next-slick-arrow next-slick-prev ${prevDisabled ? 'disabled' : ''}`}\n+                            onClick={goToPrev}\n+                            disabled={prevDisabled}\n+                        >\n+                            \u2190 Prev\n+                        </button>\n+                        \n+                        <div className=\"next-slick-list\" style={{ margin: '0 80px', height: '100px', overflow: 'hidden' }}>\n+                            <div className=\"next-slick-track\" style={{ \n+                                display: 'flex',\n+                                transform: `translateX(-${currentSlide * (300 / Math.max(slidesToShow, 1))}px)`,\n+                                transition: 'transform 0.3s ease'\n+                            }}>\n+                                {React.Children.map(children, (child, index) => (\n+                                    <div key={index} className=\"next-slick-slide\" style={{ \n+                                        minWidth: `${300 / Math.max(slidesToShow, 1)}px`,\n+                                        padding: '5px'\n+                                    }}>\n+                                        <div className=\"slide\">\n+                                            {child}\n+                                        </div>\n+                                    </div>\n+                                ))}\n+                            </div>\n+                        </div>\n+                        \n+                        <button \n+                            className={`next-slick-arrow next-slick-next ${nextDisabled ? 'disabled' : ''}`}\n+                            onClick={goToNext}\n+                            disabled={nextDisabled}\n+                        >\n+                            Next \u2192\n+                        </button>\n+                    </div>\n+                    \n+                    <div className=\"next-slick-dots\">\n+                        {Array.from({ length: slideCount }, (_, index) => (\n+                            <button\n+                                key={index}\n+                                className={currentSlide === index ? 'active' : ''}\n+                                onClick={() => setCurrentSlide(index)}\n+                                style={{\n+                                    background: currentSlide === index ? '#007bff' : '#ccc',\n+                                    border: 'none',\n+                                    width: '12px',\n+                                    height: '12px',\n+                                    borderRadius: '50%',\n+                                    margin: '0 3px',\n+                                    cursor: 'pointer'\n+                                }}\n+                            />\n+                        ))}\n+                    </div>\n+                </div>\n+            );\n+        };\n+\n+        // Bug test case\n+        const BugTestCase = () => (\n+            <TestSlider slidesToShow={5} infinite={false} defaultActiveIndex={2}>\n+                <div>Slide 1</div>\n+                <div>Slide 2</div>\n+                <div>Slide 3</div>\n+            </TestSlider>\n+        );\n+\n+        // Control test case\n+        const ControlTestCase = () => (\n+            <TestSlider slidesToShow={1} infinite={false} defaultActiveIndex={0}>\n+                <div>Slide 1</div>\n+                <div>Slide 2</div>\n+                <div>Slide 3</div>\n+                <div>Slide 4</div>\n+            </TestSlider>\n+        );\n+\n+        ReactDOM.render(<BugTestCase />, document.getElementById('bug-test'));\n+        ReactDOM.render(<ControlTestCase />, document.getElementById('control-test'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_slider_bug.html b/test_slider_bug.html\nnew file mode 100644\nindex 000000000..378acfef3\n--- /dev/null\n+++ b/test_slider_bug.html\n@@ -0,0 +1,208 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Slider Bug Test</title>\n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-case {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+            border-radius: 5px;\n+        }\n+        .slider-container {\n+            width: 400px;\n+            margin: 20px 0;\n+        }\n+        .slide {\n+            background: #f0f0f0;\n+            padding: 20px;\n+            margin: 5px;\n+            text-align: center;\n+            border-radius: 3px;\n+        }\n+        .next-slick-arrow {\n+            background: #007bff;\n+            color: white;\n+            border: none;\n+            padding: 10px;\n+            margin: 5px;\n+            cursor: pointer;\n+            border-radius: 3px;\n+        }\n+        .next-slick-arrow.disabled {\n+            background: #ccc;\n+            cursor: not-allowed;\n+        }\n+        .next-slick-prev {\n+            margin-right: 10px;\n+        }\n+        .next-slick-next {\n+            margin-left: 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Slider Bug Reproduction Test</h1>\n+    \n+    <div class=\"test-case\">\n+        <h2>Bug Case: slidesToShow > slidesCount && infinite=false && defaultActiveIndex !== 0</h2>\n+        <p>Expected: Left arrow should be enabled when defaultActiveIndex > 0</p>\n+        <p>Actual: Left arrow is disabled incorrectly</p>\n+        <div id=\"bug-case\"></div>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <h2>Control Case 1: Normal case with infinite=false</h2>\n+        <div id=\"control-case-1\"></div>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <h2>Control Case 2: Same config but with infinite=true</h2>\n+        <div id=\"control-case-2\"></div>\n+    </div>\n+\n+    <script type=\"text/babel\">\n+        // Mock Slider component to test the arrow logic\n+        const { useState, useEffect } = React;\n+\n+        // Simplified Arrow component with the FIXED logic\n+        const Arrow = ({ type, infinite, currentSlide, slideCount, slidesToShow, onClick }) => {\n+            const isDisabled = () => {\n+                if (infinite) {\n+                    return false;\n+                }\n+\n+                // When slideCount <= slidesToShow, check if navigation is still possible based on current position\n+                if (slideCount <= slidesToShow) {\n+                    if (type === 'prev') {\n+                        // Allow prev navigation if not at the beginning\n+                        return currentSlide <= 0;\n+                    } else {\n+                        // Allow next navigation if not at the end (for cases where slides extend beyond view)\n+                        return currentSlide >= slideCount - 1;\n+                    }\n+                }\n+\n+                if (type === 'prev') {\n+                    return currentSlide <= 0;\n+                }\n+\n+                if (currentSlide >= slideCount - slidesToShow) {\n+                    return true;\n+                }\n+\n+                return false;\n+            };\n+\n+            const disabled = isDisabled();\n+            \n+            return (\n+                <button \n+                    className={`next-slick-arrow next-slick-${type} ${disabled ? 'disabled' : ''}`}\n+                    onClick={disabled ? null : onClick}\n+                    disabled={disabled}\n+                >\n+                    {type === 'prev' ? '\u2190' : '\u2192'} {type} {disabled ? '(disabled)' : '(enabled)'}\n+                </button>\n+            );\n+        };\n+\n+        // Mock Slider component\n+        const TestSlider = ({ slidesToShow, infinite, defaultActiveIndex, children }) => {\n+            const [currentSlide, setCurrentSlide] = useState(defaultActiveIndex || 0);\n+            const slideCount = React.Children.count(children);\n+\n+            const goToPrev = () => {\n+                if (currentSlide > 0) {\n+                    setCurrentSlide(currentSlide - 1);\n+                }\n+            };\n+\n+            const goToNext = () => {\n+                if (currentSlide < slideCount - slidesToShow) {\n+                    setCurrentSlide(currentSlide + 1);\n+                }\n+            };\n+\n+            return (\n+                <div className=\"slider-container\">\n+                    <div>\n+                        <strong>Config:</strong> slidesToShow={slidesToShow}, slideCount={slideCount}, infinite={infinite.toString()}, currentSlide={currentSlide}\n+                    </div>\n+                    <div style={{ display: 'flex', alignItems: 'center', margin: '10px 0' }}>\n+                        <Arrow \n+                            type=\"prev\" \n+                            infinite={infinite}\n+                            currentSlide={currentSlide}\n+                            slideCount={slideCount}\n+                            slidesToShow={slidesToShow}\n+                            onClick={goToPrev}\n+                        />\n+                        <div style={{ margin: '0 20px' }}>\n+                            Current Slide: {currentSlide}\n+                        </div>\n+                        <Arrow \n+                            type=\"next\" \n+                            infinite={infinite}\n+                            currentSlide={currentSlide}\n+                            slideCount={slideCount}\n+                            slidesToShow={slidesToShow}\n+                            onClick={goToNext}\n+                        />\n+                    </div>\n+                    <div style={{ display: 'flex', overflow: 'hidden', width: '300px' }}>\n+                        {React.Children.map(children, (child, index) => (\n+                            <div key={index} className=\"slide\" style={{ \n+                                minWidth: `${300/slidesToShow}px`,\n+                                display: index >= currentSlide && index < currentSlide + slidesToShow ? 'block' : 'none'\n+                            }}>\n+                                {child}\n+                            </div>\n+                        ))}\n+                    </div>\n+                </div>\n+            );\n+        };\n+\n+        // Test cases\n+        const BugCase = () => (\n+            <TestSlider slidesToShow={5} infinite={false} defaultActiveIndex={2}>\n+                <div>Slide 1</div>\n+                <div>Slide 2</div>\n+                <div>Slide 3</div>\n+            </TestSlider>\n+        );\n+\n+        const ControlCase1 = () => (\n+            <TestSlider slidesToShow={2} infinite={false} defaultActiveIndex={1}>\n+                <div>Slide 1</div>\n+                <div>Slide 2</div>\n+                <div>Slide 3</div>\n+                <div>Slide 4</div>\n+            </TestSlider>\n+        );\n+\n+        const ControlCase2 = () => (\n+            <TestSlider slidesToShow={5} infinite={true} defaultActiveIndex={2}>\n+                <div>Slide 1</div>\n+                <div>Slide 2</div>\n+                <div>Slide 3</div>\n+            </TestSlider>\n+        );\n+\n+        // Render test cases\n+        ReactDOM.render(<BugCase />, document.getElementById('bug-case'));\n+        ReactDOM.render(<ControlCase1 />, document.getElementById('control-case-1'));\n+        ReactDOM.render(<ControlCase2 />, document.getElementById('control-case-2'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

ontrol/Control.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/interaction/DragBox.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/events/Key.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/Builder.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/TextBuilder.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/ImageBuilder.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/PolygonBuilder.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/LineStringBuilder.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/Immediate.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/source/UrlTile.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/tilecoord.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/TileCache.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/Box.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/linechunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/source/Tile.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:14:53] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 18:15:23] \"GET /test_fix_cdn.html HTTP/1.1\" 200 -\ndiff --git a/simple_test.html b/simple_test.html\nnew file mode 100644\nindex 000000000..256301591\n--- /dev/null\n+++ b/simple_test.html\n@@ -0,0 +1,80 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Rotation Test</title>\n+    <style>\n+        #map { width: 400px; height: 300px; border: 1px solid #ccc; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.2.2/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.2.2/ol.css\">\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <script>\n+        // Create a simple map to test the rotation issue\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([-80.2, 25.8]),\n+                zoom: 10\n+            })\n+        });\n+\n+        // Create vector layer with rotated text\n+        const vectorLayer = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: [\n+                    new ol.Feature({\n+                        geometry: new ol.geom.Point(ol.proj.fromLonLat([-80.2, 25.8]))\n+                    })\n+                ]\n+            }),\n+            style: new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: 'ROTATED',\n+                    font: '16px Arial',\n+                    fill: new ol.style.Fill({color: 'red'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2}),\n+                    rotation: Math.PI / 4 // 45 degrees\n+                })\n+            }),\n+            visible: false\n+        });\n+\n+        map.addLayer(vectorLayer);\n+\n+        // Add spyglass effect\n+        let mousePos = null;\n+        map.on('pointermove', (evt) => {\n+            mousePos = evt.pixel;\n+            map.render();\n+        });\n+\n+        vectorLayer.on('prerender', (evt) => {\n+            if (!mousePos) return;\n+            const ctx = evt.context;\n+            ctx.save();\n+            \n+            // Clip to small area around mouse\n+            ctx.beginPath();\n+            ctx.rect(mousePos[0] - 50, mousePos[1] - 50, 100, 100);\n+            ctx.clip();\n+            \n+            // Translate to show the issue\n+            ctx.translate(100, -50);\n+        });\n+\n+        vectorLayer.on('postrender', (evt) => {\n+            if (!mousePos) return;\n+            evt.context.restore();\n+        });\n+\n+        vectorLayer.setVisible(true);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/render/canvas.js b/src/ol/render/canvas.js\nindex d4e83b7ca..c104eb666 100644\n--- a/src/ol/render/canvas.js\n+++ b/src/ol/render/canvas.js\n@@ -439,7 +439,20 @@ export function drawImageOrLabel(\n     context.globalAlpha *= opacity;\n   }\n   if (transform) {\n-    context.setTransform.apply(context, transform);\n+    // Instead of replacing the current transformation matrix with setTransform,\n+    // we need to compose the rotation transform with the existing canvas transformation.\n+    // This is crucial for rotated text to work correctly when the canvas has been\n+    // translated (e.g., via prerender events for clipping/spyglass effects).\n+    const currentTransform = context.getTransform();\n+    const composedTransform = [\n+      currentTransform.a * transform[0] + currentTransform.c * transform[1],\n+      currentTransform.b * transform[0] + currentTransform.d * transform[1],\n+      currentTransform.a * transform[2] + currentTransform.c * transform[3],\n+      currentTransform.b * transform[2] + currentTransform.d * transform[3],\n+      currentTransform.a * transform[4] + currentTransform.c * transform[5] + currentTransform.e,\n+      currentTransform.b * transform[4] + currentTransform.d * transform[5] + currentTransform.f\n+    ];\n+    context.setTransform.apply(context, composedTransform);\n   }\n \n   if (/** @type {*} */ (labelOrImage).contextInstructions) {\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 000000000..236aa54f4\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,216 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Rotated Text Translation Fix</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin-bottom: 10px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .test-results {\n+            margin-top: 10px;\n+            padding: 10px;\n+            background: #e8f5e8;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>Test: Rotated Text Translation Fix</h3>\n+        <p>This test verifies that rotated text appears correctly when canvas is clipped and translated.</p>\n+        <p><strong>Instructions:</strong> Move your mouse over the map. You should see a spyglass effect with:</p>\n+        <ul>\n+            <li>Blue box: Original spyglass area</li>\n+            <li>Red box: Translated area where content should appear</li>\n+            <li>All text (including rotated green \"3\") should appear in the red translated area</li>\n+        </ul>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div class=\"test-results\">\n+        <h4>Expected Results:</h4>\n+        <p>\u2705 Blue \"1\" text appears in translated area (non-rotated)</p>\n+        <p>\u2705 Red \"2\" text appears in translated area (non-rotated)</p>\n+        <p>\u2705 Green \"3\" text appears in translated area (rotated 45\u00b0) - THIS WAS THE BUG</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {Style, Text, Fill, Stroke} from './src/ol/style.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([-80.2, 25.8]), // Miami coordinates\n+                zoom: 10\n+            })\n+        });\n+\n+        // Create test features\n+        const miamiCoord = fromLonLat([-80.2, 25.8]);\n+        \n+        const features = [\n+            new Feature({\n+                geometry: new Point(miamiCoord),\n+                name: '1'\n+            }),\n+            new Feature({\n+                geometry: new Point(miamiCoord),\n+                name: '2'\n+            }),\n+            new Feature({\n+                geometry: new Point(miamiCoord),\n+                name: '3'\n+            })\n+        ];\n+\n+        // Layer 1: Blue \"1\" - visible, non-rotated\n+        const layer1 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[0]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '1',\n+                    font: 'bold 24px Arial',\n+                    fill: new Fill({color: 'blue'}),\n+                    stroke: new Stroke({color: 'white', width: 3}),\n+                    rotation: 0\n+                })\n+            })\n+        });\n+\n+        // Layer 2: Red \"2\" - hidden, shown in spyglass, non-rotated\n+        const layer2 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[1]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '2',\n+                    font: 'bold 24px Arial',\n+                    fill: new Fill({color: 'red'}),\n+                    stroke: new Stroke({color: 'white', width: 3}),\n+                    rotation: 0\n+                })\n+            }),\n+            visible: false\n+        });\n+\n+        // Layer 3: Green \"3\" - hidden, shown in spyglass, ROTATED (this tests the fix)\n+        const layer3 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[2]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '3',\n+                    font: 'bold 24px Arial',\n+                    fill: new Fill({color: 'green'}),\n+                    stroke: new Stroke({color: 'white', width: 3}),\n+                    rotation: Math.PI / 4 // 45 degrees - this should now work correctly\n+                })\n+            }),\n+            visible: false\n+        });\n+\n+        map.addLayer(layer1);\n+        map.addLayer(layer2);\n+        map.addLayer(layer3);\n+\n+        // Spyglass implementation\n+        let mousePosition = null;\n+\n+        map.on('pointermove', function(evt) {\n+            mousePosition = evt.pixel;\n+            map.render();\n+        });\n+\n+        // Prerender function - clips and translates\n+        function prerender(evt) {\n+            if (!mousePosition) return;\n+\n+            const ctx = evt.context;\n+            ctx.save();\n+            \n+            // Spyglass parameters\n+            const spyglassSize = 120;\n+            const spyglassX = mousePosition[0] - spyglassSize / 2;\n+            const spyglassY = mousePosition[1] - spyglassSize / 2;\n+            \n+            // Clip to spyglass area\n+            ctx.beginPath();\n+            ctx.rect(spyglassX, spyglassY, spyglassSize, spyglassSize);\n+            ctx.clip();\n+            \n+            // Translate content to different location\n+            const translateX = 150;\n+            const translateY = -80;\n+            ctx.translate(translateX, translateY);\n+        }\n+\n+        // Postrender function - restores context and draws borders\n+        function postrender(evt) {\n+            if (!mousePosition) return;\n+\n+            const ctx = evt.context;\n+            ctx.restore();\n+            \n+            // Draw spyglass border (blue)\n+            const spyglassSize = 120;\n+            const spyglassX = mousePosition[0] - spyglassSize / 2;\n+            const spyglassY = mousePosition[1] - spyglassSize / 2;\n+            \n+            ctx.strokeStyle = 'blue';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(spyglassX, spyglassY, spyglassSize, spyglassSize);\n+            \n+            // Draw translated area border (red)\n+            const translateX = 150;\n+            const translateY = -80;\n+            ctx.strokeStyle = 'red';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(spyglassX + translateX, spyglassY + translateY, spyglassSize, spyglassSize);\n+        }\n+\n+        // Apply spyglass effect to hidden layers\n+        layer2.on('prerender', prerender);\n+        layer2.on('postrender', postrender);\n+        layer3.on('prerender', prerender);\n+        layer3.on('postrender', postrender);\n+\n+        // Make hidden layers visible for spyglass effect\n+        layer2.setVisible(true);\n+        layer3.setVisible(true);\n+\n+        console.log('Test loaded. Move mouse over map to see spyglass effect.');\n+        console.log('If fix works: rotated green \"3\" should appear in red translated area, not original location.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_cdn.html b/test_fix_cdn.html\nnew file mode 100644\nindex 000000000..742029233\n--- /dev/null\n+++ b/test_fix_cdn.html\n@@ -0,0 +1,156 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Rotated Text Translation Fix</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 400px; border: 1px solid #ccc; }\n+        .info { margin-bottom: 10px; padding: 10px; background: #f0f0f0; border-radius: 4px; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.2.2/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.2.2/ol.css\">\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>Test: Rotated Text Translation Fix</h3>\n+        <p><strong>Before Fix:</strong> Rotated green \"3\" appears at original location</p>\n+        <p><strong>After Fix:</strong> Rotated green \"3\" should appear in red translated area</p>\n+        <p><strong>Instructions:</strong> Move mouse over map to see spyglass effect</p>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script>\n+        // Create map with OSM background\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([-80.2, 25.8]), // Miami\n+                zoom: 10\n+            })\n+        });\n+\n+        // Create point feature at Miami\n+        const miamiPoint = new ol.Feature({\n+            geometry: new ol.geom.Point(ol.proj.fromLonLat([-80.2, 25.8]))\n+        });\n+\n+        // Layer 1: Blue \"1\" - always visible, non-rotated\n+        const layer1 = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: [miamiPoint.clone()]\n+            }),\n+            style: new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: '1',\n+                    font: 'bold 20px Arial',\n+                    fill: new ol.style.Fill({color: 'blue'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2}),\n+                    rotation: 0\n+                })\n+            })\n+        });\n+\n+        // Layer 2: Red \"2\" - spyglass only, non-rotated\n+        const layer2 = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: [miamiPoint.clone()]\n+            }),\n+            style: new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: '2',\n+                    font: 'bold 20px Arial',\n+                    fill: new ol.style.Fill({color: 'red'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2}),\n+                    rotation: 0\n+                })\n+            }),\n+            visible: false\n+        });\n+\n+        // Layer 3: Green \"3\" - spyglass only, ROTATED (tests the fix)\n+        const layer3 = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: [miamiPoint.clone()]\n+            }),\n+            style: new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: '3',\n+                    font: 'bold 20px Arial',\n+                    fill: new ol.style.Fill({color: 'green'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2}),\n+                    rotation: Math.PI / 4 // 45 degrees - this should work with the fix\n+                })\n+            }),\n+            visible: false\n+        });\n+\n+        map.addLayer(layer1);\n+        map.addLayer(layer2);\n+        map.addLayer(layer3);\n+\n+        // Spyglass effect\n+        let mousePos = null;\n+        map.on('pointermove', (evt) => {\n+            mousePos = evt.pixel;\n+            map.render();\n+        });\n+\n+        // Prerender: clip and translate\n+        function prerender(evt) {\n+            if (!mousePos) return;\n+            const ctx = evt.context;\n+            ctx.save();\n+            \n+            // Clip to spyglass area\n+            const size = 100;\n+            const x = mousePos[0] - size/2;\n+            const y = mousePos[1] - size/2;\n+            ctx.beginPath();\n+            ctx.rect(x, y, size, size);\n+            ctx.clip();\n+            \n+            // Translate content\n+            ctx.translate(120, -60);\n+        }\n+\n+        // Postrender: restore and draw borders\n+        function postrender(evt) {\n+            if (!mousePos) return;\n+            const ctx = evt.context;\n+            ctx.restore();\n+            \n+            // Draw borders\n+            const size = 100;\n+            const x = mousePos[0] - size/2;\n+            const y = mousePos[1] - size/2;\n+            \n+            // Blue border (original area)\n+            ctx.strokeStyle = 'blue';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(x, y, size, size);\n+            \n+            // Red border (translated area)\n+            ctx.strokeStyle = 'red';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(x + 120, y - 60, size, size);\n+        }\n+\n+        // Apply spyglass to hidden layers\n+        layer2.on('prerender', prerender);\n+        layer2.on('postrender', postrender);\n+        layer3.on('prerender', prerender);\n+        layer3.on('postrender', postrender);\n+\n+        // Show hidden layers\n+        layer2.setVisible(true);\n+        layer3.setVisible(true);\n+\n+        console.log('Test ready. Move mouse over map to test spyglass effect.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_rotation_issue.html b/test_rotation_issue.html\nnew file mode 100644\nindex 000000000..06c0ac086\n--- /dev/null\n+++ b/test_rotation_issue.html\n@@ -0,0 +1,198 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Rotated Text Translation Issue Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin-bottom: 10px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>Rotated Text Translation Issue Test</h3>\n+        <p>Hover over the map to see the spyglass effect. The issue is that rotated text (green \"3\") appears at the original location instead of the translated location.</p>\n+        <p>Expected: All text should appear in the translated spyglass area</p>\n+        <p>Actual: Non-rotated text works correctly, but rotated text appears at original location</p>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {Style, Text, Fill, Stroke} from './src/ol/style.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([-80.2, 25.8]), // Miami coordinates\n+                zoom: 10\n+            })\n+        });\n+\n+        // Create test features with different text styles\n+        const features = [\n+            // Non-rotated blue text \"1\"\n+            new Feature({\n+                geometry: new Point(fromLonLat([-80.2, 25.8])),\n+                name: '1'\n+            }),\n+            // Non-rotated red text \"2\" \n+            new Feature({\n+                geometry: new Point(fromLonLat([-80.2, 25.8])),\n+                name: '2'\n+            }),\n+            // Rotated green text \"3\" - this should demonstrate the issue\n+            new Feature({\n+                geometry: new Point(fromLonLat([-80.2, 25.8])),\n+                name: '3'\n+            })\n+        ];\n+\n+        // Create vector layers with different text styles\n+        const layer1 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[0]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '1',\n+                    font: '20px Arial',\n+                    fill: new Fill({color: 'blue'}),\n+                    stroke: new Stroke({color: 'white', width: 2}),\n+                    rotation: 0 // No rotation\n+                })\n+            })\n+        });\n+\n+        const layer2 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[1]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '2',\n+                    font: '20px Arial',\n+                    fill: new Fill({color: 'red'}),\n+                    stroke: new Stroke({color: 'white', width: 2}),\n+                    rotation: 0 // No rotation\n+                })\n+            }),\n+            visible: false // Hidden by default, shown in spyglass\n+        });\n+\n+        const layer3 = new VectorLayer({\n+            source: new VectorSource({\n+                features: [features[2]]\n+            }),\n+            style: new Style({\n+                text: new Text({\n+                    text: '3',\n+                    font: '20px Arial',\n+                    fill: new Fill({color: 'green'}),\n+                    stroke: new Stroke({color: 'white', width: 2}),\n+                    rotation: Math.PI / 4 // 45 degree rotation - this should show the issue\n+                })\n+            }),\n+            visible: false // Hidden by default, shown in spyglass\n+        });\n+\n+        map.addLayer(layer1);\n+        map.addLayer(layer2);\n+        map.addLayer(layer3);\n+\n+        // Spyglass implementation with clipping and translation\n+        let mousePosition = null;\n+\n+        map.on('pointermove', function(evt) {\n+            mousePosition = evt.pixel;\n+            map.render();\n+        });\n+\n+        // Prerender event - set up clipping and translation\n+        function prerender(evt) {\n+            if (!mousePosition) return;\n+\n+            const ctx = evt.context;\n+            const pixelRatio = evt.frameState.pixelRatio;\n+            \n+            ctx.save();\n+            \n+            // Create spyglass area (blue box)\n+            const spyglassSize = 150;\n+            const spyglassX = mousePosition[0] - spyglassSize / 2;\n+            const spyglassY = mousePosition[1] - spyglassSize / 2;\n+            \n+            // Clip to spyglass area\n+            ctx.beginPath();\n+            ctx.rect(spyglassX, spyglassY, spyglassSize, spyglassSize);\n+            ctx.clip();\n+            \n+            // Translate to show content in different location (red box)\n+            const translateX = 200;\n+            const translateY = -100;\n+            ctx.translate(translateX, translateY);\n+        }\n+\n+        // Postrender event - restore context\n+        function postrender(evt) {\n+            if (!mousePosition) return;\n+\n+            const ctx = evt.context;\n+            ctx.restore();\n+            \n+            // Draw spyglass border (blue box)\n+            const spyglassSize = 150;\n+            const spyglassX = mousePosition[0] - spyglassSize / 2;\n+            const spyglassY = mousePosition[1] - spyglassSize / 2;\n+            \n+            ctx.strokeStyle = 'blue';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(spyglassX, spyglassY, spyglassSize, spyglassSize);\n+            \n+            // Draw translated area border (red box)\n+            const translateX = 200;\n+            const translateY = -100;\n+            ctx.strokeStyle = 'red';\n+            ctx.lineWidth = 2;\n+            ctx.strokeRect(spyglassX + translateX, spyglassY + translateY, spyglassSize, spyglassSize);\n+        }\n+\n+        // Apply prerender/postrender to hidden layers to create spyglass effect\n+        layer2.on('prerender', prerender);\n+        layer2.on('postrender', postrender);\n+        layer3.on('prerender', prerender);\n+        layer3.on('postrender', postrender);\n+\n+        // Make hidden layers visible for spyglass effect\n+        layer2.setVisible(true);\n+        layer3.setVisible(true);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

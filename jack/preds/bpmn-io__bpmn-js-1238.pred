{"instance_id": "bpmn-io__bpmn-js-1238", "model_patch": "diff --git a/lib/features/modeling/BpmnUpdater.js b/lib/features/modeling/BpmnUpdater.js\nindex 28d24076..4e033b17 100644\n--- a/lib/features/modeling/BpmnUpdater.js\n+++ b/lib/features/modeling/BpmnUpdater.js\n@@ -280,6 +280,55 @@ BpmnUpdater.$inject = [\n \n // implementation //////////////////////\n \n+/**\n+ * Find the common ancestor of two elements that can contain artifacts\n+ *\n+ * @param {djs.model.Base} element1\n+ * @param {djs.model.Base} element2\n+ * @return {djs.model.Base} common ancestor or null\n+ */\n+BpmnUpdater.prototype.getCommonArtifactParent = function(element1, element2) {\n+\n+  if (!element1 || !element2) {\n+    return null;\n+  }\n+\n+  // Get all ancestors of element1 that can contain artifacts\n+  var ancestors1 = [];\n+  var current = element1;\n+\n+  while (current) {\n+    if (current.businessObject &&\n+        (is(current, 'bpmn:Process') ||\n+         is(current, 'bpmn:SubProcess') ||\n+         is(current, 'bpmn:Collaboration'))) {\n+      ancestors1.push(current);\n+    }\n+    current = current.parent;\n+  }\n+\n+  // Find the first common ancestor by traversing element2's ancestors\n+  current = element2;\n+\n+  while (current) {\n+    if (current.businessObject &&\n+        (is(current, 'bpmn:Process') ||\n+         is(current, 'bpmn:SubProcess') ||\n+         is(current, 'bpmn:Collaboration'))) {\n+\n+      // Check if this ancestor is also an ancestor of element1\n+      for (var i = 0; i < ancestors1.length; i++) {\n+        if (ancestors1[i] === current) {\n+          return current;\n+        }\n+      }\n+    }\n+    current = current.parent;\n+  }\n+\n+  return null;\n+};\n+\n BpmnUpdater.prototype.updateAttachment = function(context) {\n \n   var shape = context.shape,\n@@ -329,6 +378,18 @@ BpmnUpdater.prototype.updateParent = function(element, oldParent) {\n     }\n   }\n \n+  if (is(element, 'bpmn:Association')) {\n+    // For regular associations, find the common ancestor of source and target\n+    var commonParent = this.getCommonArtifactParent(element.source, element.target);\n+    if (commonParent) {\n+      parentBusinessObject = commonParent.businessObject;\n+      parentDi = parentBusinessObject.di;\n+    } else {\n+      parentBusinessObject = null;\n+      parentDi = null;\n+    }\n+  }\n+\n   this.updateSemanticParent(businessObject, parentBusinessObject);\n \n   if (is(element, 'bpmn:DataObjectReference') && businessObject.dataObjectRef) {\ndiff --git a/test/spec/features/modeling/behavior/AssociationParentUpdateBehavior.spec.js b/test/spec/features/modeling/behavior/AssociationParentUpdateBehavior.spec.js\nnew file mode 100644\nindex 00000000..8843f1a2\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/AssociationParentUpdateBehavior.spec.js\n@@ -0,0 +1,140 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+\n+describe('features/modeling/behavior - AssociationParentUpdateBehavior', function() {\n+\n+  var testModules = [ coreModule, modelingModule ];\n+\n+  var processDiagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd\" xmlns:bpmndi=\"http://www.omg.org/schema/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/schema/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/schema/DD/20100524/DI\" id=\"sample-diagram\" targetNamespace=\"http://bpmn.io/schema/bpmn\" xsi:schemaLocation=\"http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start Event 1\"/>\n+      <bpmn2:task id=\"Task_1\" name=\"Task 1\"/>\n+      <bpmn2:association id=\"Association_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\"/>\n+    </bpmn2:subProcess>\n+    <bpmn2:task id=\"Task_2\" name=\"Task 2\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"400\" height=\"200\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"250\" y=\"150\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"150\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"700\" y=\"150\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"286\" y=\"168\"/>\n+        <di:waypoint x=\"350\" y=\"168\"/>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+\n+  beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+\n+  describe('should update association parent when source and target are moved', function() {\n+\n+    it('should update association parent when both endpoints move to new parent', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var association = elementRegistry.get('Association_1'),\n+          startEvent = elementRegistry.get('StartEvent_1'),\n+          task1 = elementRegistry.get('Task_1'),\n+          subProcess = elementRegistry.get('SubProcess_1'),\n+          process = elementRegistry.get('Process_1');\n+\n+      // verify initial state\n+      expect(association.parent).to.equal(subProcess);\n+      expect(association.businessObject.$parent).to.equal(subProcess.businessObject);\n+\n+      // when - move both source and target out of subprocess\n+      modeling.moveElements([startEvent, task1], { x: 500, y: 0 }, process);\n+\n+      // then - association parent should be updated to process\n+      expect(association.parent).to.equal(process);\n+      expect(association.businessObject.$parent).to.equal(process.businessObject);\n+    }));\n+\n+\n+    it('should update association parent when source moves to new parent', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var association = elementRegistry.get('Association_1'),\n+          startEvent = elementRegistry.get('StartEvent_1'),\n+          subProcess = elementRegistry.get('SubProcess_1'),\n+          process = elementRegistry.get('Process_1');\n+\n+      // verify initial state\n+      expect(association.parent).to.equal(subProcess);\n+\n+      // when - move only source out of subprocess\n+      modeling.moveElements([startEvent], { x: 500, y: 0 }, process);\n+\n+      // then - association parent should be updated to process (common ancestor)\n+      expect(association.parent).to.equal(process);\n+      expect(association.businessObject.$parent).to.equal(process.businessObject);\n+    }));\n+\n+\n+    it('should update association parent when target moves to new parent', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var association = elementRegistry.get('Association_1'),\n+          startEvent = elementRegistry.get('StartEvent_1'),\n+          task1 = elementRegistry.get('Task_1'),\n+          subProcess = elementRegistry.get('SubProcess_1'),\n+          process = elementRegistry.get('Process_1');\n+\n+      // verify initial state\n+      expect(association.parent).to.equal(subProcess);\n+\n+      // when - move only target out of subprocess\n+      modeling.moveElements([task1], { x: 500, y: 0 }, process);\n+\n+      // then - association parent should be updated to process (common ancestor)\n+      expect(association.parent).to.equal(process);\n+      expect(association.businessObject.$parent).to.equal(process.businessObject);\n+    }));\n+\n+\n+    it('should keep association when subprocess is deleted after endpoints are moved', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var association = elementRegistry.get('Association_1'),\n+          startEvent = elementRegistry.get('StartEvent_1'),\n+          task1 = elementRegistry.get('Task_1'),\n+          subProcess = elementRegistry.get('SubProcess_1'),\n+          process = elementRegistry.get('Process_1');\n+\n+      // when - move both endpoints out of subprocess\n+      modeling.moveElements([startEvent, task1], { x: 500, y: 0 }, process);\n+\n+      // verify association parent is updated\n+      expect(association.parent).to.equal(process);\n+\n+      // when - delete the subprocess\n+      modeling.removeElements([subProcess]);\n+\n+      // then - association should still exist\n+      expect(elementRegistry.get('Association_1')).to.exist;\n+      expect(association.parent).to.equal(process);\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/verify_fix.html b/verify_fix.html\nnew file mode 100644\nindex 00000000..c91af363\n--- /dev/null\n+++ b/verify_fix.html\n@@ -0,0 +1,125 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Association Parent Update Fix Verification</title>\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; }\n+        #log { margin-top: 20px; padding: 10px; background: #f5f5f5; }\n+        .success { color: green; }\n+        .error { color: red; }\n+        .info { color: blue; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Association Parent Update Fix Verification</h1>\n+    <div id=\"canvas\"></div>\n+    <div id=\"log\"></div>\n+\n+    <script>\n+        const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd\" xmlns:bpmndi=\"http://www.omg.org/schema/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/schema/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/schema/DD/20100524/DI\" id=\"sample-diagram\" targetNamespace=\"http://bpmn.io/schema/bpmn\" xsi:schemaLocation=\"http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd http://www.omg.org/schema/BPMN/20100524/BPMN20.xsd\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start Event 1\"/>\n+      <bpmn2:task id=\"Task_1\" name=\"Task 1\"/>\n+      <bpmn2:association id=\"Association_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\"/>\n+    </bpmn2:subProcess>\n+    <bpmn2:task id=\"Task_2\" name=\"Task 2\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"400\" height=\"200\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"250\" y=\"150\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"150\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"700\" y=\"150\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"286\" y=\"168\"/>\n+        <di:waypoint x=\"350\" y=\"168\"/>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+        function log(message, type = 'info') {\n+            const logDiv = document.getElementById('log');\n+            const p = document.createElement('p');\n+            p.className = type;\n+            p.textContent = message;\n+            logDiv.appendChild(p);\n+            console.log(message);\n+        }\n+\n+        async function testAssociationFix() {\n+            try {\n+                const modeler = new BpmnJS({\n+                    container: '#canvas'\n+                });\n+\n+                await modeler.importXML(xml);\n+                log('\u2713 BPMN diagram imported successfully', 'success');\n+\n+                const elementRegistry = modeler.get('elementRegistry');\n+                const modeling = modeler.get('modeling');\n+\n+                const association = elementRegistry.get('Association_1');\n+                const startEvent = elementRegistry.get('StartEvent_1');\n+                const task1 = elementRegistry.get('Task_1');\n+                const subProcess = elementRegistry.get('SubProcess_1');\n+                const process = elementRegistry.get('Process_1');\n+\n+                log('Initial state:', 'info');\n+                log(`Association parent: ${association.parent.id}`, 'info');\n+                log(`Association business object parent: ${association.businessObject.$parent.id}`, 'info');\n+\n+                if (association.parent.id !== 'SubProcess_1') {\n+                    log('\u274c Unexpected initial state', 'error');\n+                    return;\n+                }\n+\n+                // Move both elements out of subprocess\n+                log('Moving elements out of subprocess...', 'info');\n+                modeling.moveElements([startEvent, task1], { x: 500, y: 0 }, process);\n+\n+                log('After moving elements:', 'info');\n+                log(`Association parent: ${association.parent.id}`, 'info');\n+                log(`Association business object parent: ${association.businessObject.$parent.id}`, 'info');\n+\n+                if (association.parent.id === 'Process_1' && association.businessObject.$parent.id === 'Process_1') {\n+                    log('\u2705 SUCCESS: Association parent correctly updated to Process_1', 'success');\n+                    \n+                    // Test deletion scenario\n+                    log('Testing subprocess deletion...', 'info');\n+                    modeling.removeElements([subProcess]);\n+                    \n+                    const associationStillExists = elementRegistry.get('Association_1');\n+                    if (associationStillExists) {\n+                        log('\u2705 SUCCESS: Association survived subprocess deletion', 'success');\n+                    } else {\n+                        log('\u274c FAILURE: Association was deleted with subprocess', 'error');\n+                    }\n+                } else {\n+                    log('\u274c FAILURE: Association parent was not updated correctly', 'error');\n+                    log(`Expected: Process_1, Got: ${association.parent.id}`, 'error');\n+                }\n+\n+            } catch (error) {\n+                log(`\u274c ERROR: ${error.message}`, 'error');\n+                console.error(error);\n+            }\n+        }\n+\n+        // Run the test when page loads\n+        window.addEventListener('load', testAssociationFix);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

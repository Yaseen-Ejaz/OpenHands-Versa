{"instance_id": "GoogleChrome__lighthouse-12067", "model_patch": "diff --git a/lighthouse-core/lib/minification-estimator.js b/lighthouse-core/lib/minification-estimator.js\nindex e40b7d1db..4deed7d81 100644\n--- a/lighthouse-core/lib/minification-estimator.js\n+++ b/lighthouse-core/lib/minification-estimator.js\n@@ -7,7 +7,7 @@\n \n // https://www.ecma-international.org/ecma-262/9.0/index.html#sec-punctuators\n // eslint-disable-next-line max-len\n-const PUNCTUATOR_REGEX = /(return|{|\\(|\\[|\\.\\.\\.|;|,|<|>|<=|>=|==|!=|===|!==|\\+|-|\\*|%|\\*\\*|\\+\\+|--|<<|>>|>>>|&|\\||\\^|!|~|&&|\\|\\||\\?|:|=|\\+=|-=|\\*=|%=|\\*\\*=|<<=|>>=|>>>=|&=|\\|=|\\^=|=>|\\/|\\/=|\\})$/;\n+const PUNCTUATOR_REGEX = /(return|case|{|\\(|\\[|\\.\\.\\.|;|,|<|>|<=|>=|==|!=|===|!==|\\+|-|\\*|%|\\*\\*|\\+\\+|--|<<|>>|>>>|&|\\||\\^|!|~|&&|\\|\\||\\?|:|=|\\+=|-=|\\*=|%=|\\*\\*=|<<=|>>=|>>>=|&=|\\|=|\\^=|=>|\\/|\\/=|\\})$/;\n const WHITESPACE_REGEX = /( |\\n|\\t)+$/;\n \n /**\ndiff --git a/lighthouse-core/test/lib/minification-estimator-case-regex-test.js b/lighthouse-core/test/lib/minification-estimator-case-regex-test.js\nnew file mode 100644\nindex 000000000..cfcae3b49\n--- /dev/null\n+++ b/lighthouse-core/test/lib/minification-estimator-case-regex-test.js\n@@ -0,0 +1,56 @@\n+/**\n+ * @license Copyright 2023 The Lighthouse Authors. All Rights Reserved.\n+ * Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0\n+ * Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.\n+ */\n+'use strict';\n+\n+const assert = require('assert').strict;\n+const {computeJSTokenLength} = require('../../lib/minification-estimator.js');\n+\n+/* eslint-env jest */\n+\n+describe('minification estimator with case regex', () => {\n+  it('should correctly handle regex after case keyword', () => {\n+    const js = `switch(true){case/^hello!/.test(\"hello!\"):document.write(\"///<any content>\");}`;\n+\n+    // The entire string should be considered as tokens (no comments)\n+    assert.equal(computeJSTokenLength(js), js.length);\n+  });\n+\n+  it('should correctly handle regex after case keyword with whitespace', () => {\n+    const js = `switch(true) { case /^hello!/.test(\"hello!\"): document.write(\"///<any>\"); }`;\n+\n+    // Only whitespace should be removed\n+    const tokensOnly = `switch(true){case/^hello!/.test(\"hello!\"):document.write(\"///<any>\");}`;\n+    assert.equal(computeJSTokenLength(js), tokensOnly.length);\n+  });\n+\n+  it('should correctly handle division after case keyword', () => {\n+    const js = `switch(true) { case 10 / 2: document.write(\"///<any>\"); }`;\n+\n+    // Only whitespace should be removed, and the division should be recognized as a division\n+    const tokensOnly = `switch(true){case10/2:document.write(\"///<any>\");}`;\n+    assert.equal(computeJSTokenLength(js), tokensOnly.length);\n+  });\n+\n+  it('should correctly handle regex with comments after case keyword', () => {\n+    const js = `switch(true) {\n+      case /^hello!/.test(\"hello!\"):\n+        // This is a comment\n+        document.write(\"///<any>\");\n+    }`;\n+\n+    // Whitespace and comments should be removed\n+    const tokensOnly = `switch(true){case/^hello!/.test(\"hello!\"):document.write(\"///<any>\");}`;\n+    assert.equal(computeJSTokenLength(js), tokensOnly.length);\n+  });\n+\n+  it('should handle the exact example from the issue description', () => {\n+    // This is the exact example from the issue description\n+    const js = `switch(true){case/^hello!/.test(\"hello!\"):document.write(\"///<any content>\");}`;\n+\n+    // The entire string should be considered as tokens (no comments)\n+    assert.equal(computeJSTokenLength(js), js.length);\n+  });\n+});", "model_name_or_path": "llm.claude_3_7"}

{"instance_id": "GoogleChrome__lighthouse-5011", "model_patch": "diff --git a/lighthouse-core/gather/computed/critical-request-chains.js b/lighthouse-core/gather/computed/critical-request-chains.js\nindex da226a8d5..3eb6d535f 100644\n--- a/lighthouse-core/gather/computed/critical-request-chains.js\n+++ b/lighthouse-core/gather/computed/critical-request-chains.js\n@@ -35,8 +35,11 @@ class CriticalRequestChains extends ComputedArtifact {\n       WebInspector.resourceTypes.Image._category,\n       WebInspector.resourceTypes.XHR._category,\n     ];\n+    // Resources loaded with rel=preload are not render-blocking\n+    const isPreload = request._isLinkPreload;\n     if (nonCriticalResourceTypes.includes(resourceTypeCategory) ||\n         isIframe ||\n+        isPreload ||\n         request.mimeType && request.mimeType.startsWith('image/')) {\n       return false;\n     }\ndiff --git a/lighthouse-core/test/gather/computed/critical-request-chains-preload-test.js b/lighthouse-core/test/gather/computed/critical-request-chains-preload-test.js\nnew file mode 100644\nindex 000000000..152bb8910\n--- /dev/null\n+++ b/lighthouse-core/test/gather/computed/critical-request-chains-preload-test.js\n@@ -0,0 +1,87 @@\n+/**\n+ * @license Copyright 2018 Google Inc. All Rights Reserved.\n+ * Licensed under the Apache License, Version 2.0 (the \"License\"); you may not use this file except in compliance with the License. You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0\n+ * Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.\n+ */\n+'use strict';\n+\n+/* eslint-env mocha */\n+\n+const CriticalRequestChains = require('../../../gather/computed/critical-request-chains');\n+const assert = require('assert');\n+\n+const HIGH = 'High';\n+const VERY_HIGH = 'VeryHigh';\n+\n+function mockRequest(requestId, url, priority, initiator, resourceType, isLinkPreload = false) {\n+  return {\n+    requestId,\n+    url,\n+    finished: true,\n+    priority: () => priority,\n+    initiatorRequest: () => initiator,\n+    _resourceType: resourceType,\n+    _isLinkPreload: isLinkPreload,\n+    frameId: 1,\n+  };\n+}\n+\n+describe('CriticalRequestChain: preload handling', () => {\n+  let mainResource;\n+  let mainDocument;\n+  let scriptA;\n+  let scriptB;\n+  let scriptC;\n+  let styleA;\n+  let styleB;\n+  let styleC;\n+  let networkRecords;\n+\n+  beforeEach(() => {\n+    mainResource = mockRequest(1, 'http://example.com/', VERY_HIGH, null,\n+      {_category: 'Document'});\n+    mainDocument = mockRequest(2, 'http://example.com/', VERY_HIGH, mainResource,\n+      {_category: 'Document'});\n+    scriptA = mockRequest(3, 'http://example.com/scriptA.js', HIGH, mainDocument,\n+      {_category: 'Script'});\n+    scriptB = mockRequest(4, 'http://example.com/scriptB.js', HIGH, scriptA,\n+      {_category: 'Script'});\n+    scriptC = mockRequest(5, 'http://example.com/scriptC.js', HIGH, scriptB,\n+      {_category: 'Script'});\n+    styleA = mockRequest(6, 'http://example.com/styleA.css', HIGH, mainDocument,\n+      {_category: 'Stylesheet'});\n+    styleB = mockRequest(7, 'http://example.com/styleB.css', HIGH, styleA,\n+      {_category: 'Stylesheet'});\n+    styleC = mockRequest(8, 'http://example.com/styleC.css', HIGH, styleB,\n+      {_category: 'Stylesheet'}, true);\n+\n+    networkRecords = [\n+      mainResource, mainDocument, scriptA, scriptB, scriptC, styleA, styleB, styleC,\n+    ];\n+  });\n+\n+  it('identifies critical requests', () => {\n+    const criticalChains = CriticalRequestChains.extractChain([networkRecords, mainResource]);\n+    assert.ok(criticalChains[mainResource.requestId], 'main resource is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId],\n+      'main document is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[scriptA.requestId], 'scriptA is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[scriptA.requestId].children[scriptB.requestId], 'scriptB is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[styleA.requestId], 'styleA is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[styleA.requestId].children[styleB.requestId], 'styleB is critical');\n+  });\n+\n+  it('does not include preloaded resources in the critical chain', () => {\n+    const criticalChains = CriticalRequestChains.extractChain([networkRecords, mainResource]);\n+    assert.ok(criticalChains[mainResource.requestId], 'main resource is critical');\n+    assert.ok(criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[styleA.requestId].children[styleB.requestId], 'styleB is critical');\n+    assert.ok(!criticalChains[mainResource.requestId].children[mainDocument.requestId]\n+      .children[styleA.requestId].children[styleB.requestId].children[styleC.requestId],\n+      'styleC is not critical because it was preloaded');\n+  });\n+});", "model_name_or_path": "llm.claude_3_7"}

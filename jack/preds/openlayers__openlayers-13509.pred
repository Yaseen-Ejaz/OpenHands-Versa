his.rendered = true;\n+      const viewState = frameState.viewState;\n+      const sources = this.getSources(frameState.extent, viewState.resolution);\n+      let ready = true;\n+      for (let i = 0, ii = sources.length; i < ii; ++i) {\n+        const source = sources[i];\n+        const sourceState = source.getState();\n+        if (sourceState == SourceState.LOADING) {\n+          const onChange = () => {\n+            if (source.getState() == SourceState.READY) {\n+              source.removeEventListener('change', onChange);\n+              this.changed();\n+            }\n+          };\n+          source.addEventListener('change', onChange);\n+        }\n+        ready = ready && sourceState == SourceState.READY;\n       }\n-      ready = ready && sourceState == SourceState.READY;\n-    }\n-    const canvas = this.renderSources(frameState, sources);\n-    if (this.getRenderer().renderComplete && ready) {\n-      // Fully rendered, done.\n-      this.renderedResolution_ = viewState.resolution;\n-      return canvas;\n-    }\n-    // Render sources from previously fully rendered frames\n-    if (this.renderedResolution_ > 0.5 * viewState.resolution) {\n-      const altSources = this.getSources(\n-        frameState.extent,\n-        this.renderedResolution_\n-      ).filter((source) => !sources.includes(source));\n-      if (altSources.length > 0) {\n-        return this.renderSources(frameState, altSources);\n+      const canvas = this.renderSources(frameState, sources);\n+      if (this.getRenderer().renderComplete && ready) {\n+        // Fully rendered, done.\n+        this.renderedResolution_ = viewState.resolution;\n+        return canvas;\n+      }\n+      // Render sources from previously fully rendered frames\n+      if (this.renderedResolution_ > 0.5 * viewState.resolution) {\n+        const altSources = this.getSources(\n+          frameState.extent,\n+          this.renderedResolution_\n+        ).filter((source) => !sources.includes(source));\n+        if (altSources.length > 0) {\n+          return this.renderSources(frameState, altSources);\n+        }\n       }\n+      return canvas;\n     }\n-    return canvas;\n   }\n \n   /**\ndiff --git a/test_webgl_visibility.html b/test_webgl_visibility.html\nnew file mode 100644\nindex 000000000..3afac0f16\n--- /dev/null\n+++ b/test_webgl_visibility.html\n@@ -0,0 +1,134 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Visibility Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+        }\n+        .status {\n+            margin: 10px 0;\n+            font-family: monospace;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"controls\">\n+        <button id=\"toggleGroup\">Toggle Group Visibility</button>\n+        <button id=\"toggleWebGL\">Toggle WebGL Layer Visibility</button>\n+        <button id=\"toggleTile\">Toggle Tile Layer Visibility</button>\n+    </div>\n+    <div class=\"status\">\n+        <div>Group Visible: <span id=\"groupStatus\">true</span></div>\n+        <div>WebGL Layer Visible: <span id=\"webglStatus\">true</span></div>\n+        <div>Tile Layer Visible: <span id=\"tileStatus\">true</span></div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import Group from './src/ol/layer/Group.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import XYZ from './src/ol/source/XYZ.js';\n+\n+        // Create sources\n+        const osmSource = new OSM();\n+        const xyzSource = new XYZ({\n+            url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png'\n+        });\n+\n+        // Create WebGL tile layer\n+        const webglLayer = new WebGLTileLayer({\n+            source: xyzSource,\n+            style: {\n+                color: ['*', ['band', 1], [255, 0, 0, 0.5]] // Red tint to distinguish\n+            }\n+        });\n+\n+        // Create regular tile layer\n+        const tileLayer = new TileLayer({\n+            source: osmSource,\n+            opacity: 0.7\n+        });\n+\n+        // Create group containing both layers\n+        const layerGroup = new Group({\n+            layers: [tileLayer, webglLayer]\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [layerGroup],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Status update functions\n+        function updateStatus() {\n+            document.getElementById('groupStatus').textContent = layerGroup.getVisible();\n+            document.getElementById('webglStatus').textContent = webglLayer.getVisible();\n+            document.getElementById('tileStatus').textContent = tileLayer.getVisible();\n+        }\n+\n+        // Event handlers\n+        document.getElementById('toggleGroup').addEventListener('click', () => {\n+            layerGroup.setVisible(!layerGroup.getVisible());\n+            updateStatus();\n+            console.log('Group visibility:', layerGroup.getVisible());\n+        });\n+\n+        document.getElementById('toggleWebGL').addEventListener('click', () => {\n+            webglLayer.setVisible(!webglLayer.getVisible());\n+            updateStatus();\n+            console.log('WebGL layer visibility:', webglLayer.getVisible());\n+        });\n+\n+        document.getElementById('toggleTile').addEventListener('click', () => {\n+            tileLayer.setVisible(!tileLayer.getVisible());\n+            updateStatus();\n+            console.log('Tile layer visibility:', tileLayer.getVisible());\n+        });\n+\n+        // Initial status\n+        updateStatus();\n+\n+        // Auto-test after 3 seconds like in the issue description\n+        setTimeout(() => {\n+            console.log('Auto-hiding group after 3 seconds...');\n+            layerGroup.setVisible(false);\n+            updateStatus();\n+            \n+            // Check if WebGL layer is still visible (this should be the bug)\n+            setTimeout(() => {\n+                const webglVisible = webglLayer.getVisible();\n+                const groupVisible = layerGroup.getVisible();\n+                console.log('After hiding group:');\n+                console.log('- Group visible:', groupVisible);\n+                console.log('- WebGL layer visible:', webglVisible);\n+                console.log('- Expected: WebGL layer should be hidden when group is hidden');\n+                \n+                if (!groupVisible && webglVisible) {\n+                    console.error('BUG REPRODUCED: WebGL layer is still visible despite group being hidden!');\n+                } else {\n+                    console.log('No bug detected - WebGL layer correctly hidden');\n+                }\n+            }, 100);\n+        }, 3000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

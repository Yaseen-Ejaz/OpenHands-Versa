{"instance_id": "bpmn-io__bpmn-js-1348", "model_patch": "diff --git a/lib/features/rules/BpmnRules.js b/lib/features/rules/BpmnRules.js\nindex a15966d0..1b245c6f 100644\n--- a/lib/features/rules/BpmnRules.js\n+++ b/lib/features/rules/BpmnRules.js\n@@ -281,7 +281,7 @@ function isMessageFlowSource(element) {\n function isMessageFlowTarget(element) {\n   return (\n     is(element, 'bpmn:InteractionNode') &&\n-    !is(element, 'bpmn:BoundaryEvent') &&\n+    (!is(element, 'bpmn:BoundaryEvent') || isMessageCatchBoundaryEvent(element)) &&\n     !isForCompensation(element) && (\n       !is(element, 'bpmn:Event') || (\n         is(element, 'bpmn:CatchEvent') &&\n@@ -291,6 +291,14 @@ function isMessageFlowTarget(element) {\n   );\n }\n \n+function isMessageCatchBoundaryEvent(element) {\n+  return (\n+    is(element, 'bpmn:BoundaryEvent') &&\n+    is(element, 'bpmn:CatchEvent') &&\n+    hasEventDefinition(element, 'bpmn:MessageEventDefinition')\n+  );\n+}\n+\n function getScopeParent(element) {\n \n   var parent = element;\ndiff --git a/test/spec/features/rules/BpmnRules.messageBoundaryEvents.bpmn b/test/spec/features/rules/BpmnRules.messageBoundaryEvents.bpmn\nnew file mode 100644\nindex 00000000..00a265ed\n--- /dev/null\n+++ b/test/spec/features/rules/BpmnRules.messageBoundaryEvents.bpmn\n@@ -0,0 +1,51 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration\">\n+    <bpmn:participant id=\"Participant_1\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"Participant_2\" processRef=\"Process_2\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"SourceTask\" name=\"Source Task\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\">\n+    <bpmn:task id=\"TargetTask\" name=\"Target Task\" />\n+    <bpmn:boundaryEvent id=\"MessageBoundaryEvent\" name=\"Message Boundary\" attachedToRef=\"TargetTask\" cancelActivity=\"true\">\n+      <bpmn:messageEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:boundaryEvent id=\"MessageBoundaryEventNonInterrupting\" name=\"Message Boundary Non-Interrupting\" attachedToRef=\"TargetTask\" cancelActivity=\"false\">\n+      <bpmn:messageEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:boundaryEvent id=\"TimerBoundaryEvent\" name=\"Timer Boundary\" attachedToRef=\"TargetTask\" cancelActivity=\"true\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:boundaryEvent id=\"PlainBoundaryEvent\" name=\"Plain Boundary\" attachedToRef=\"TargetTask\" cancelActivity=\"true\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Participant_2_di\" bpmnElement=\"Participant_2\">\n+        <dc:Bounds x=\"100\" y=\"400\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"SourceTask_di\" bpmnElement=\"SourceTask\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TargetTask_di\" bpmnElement=\"TargetTask\">\n+        <dc:Bounds x=\"200\" y=\"450\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"MessageBoundaryEvent_di\" bpmnElement=\"MessageBoundaryEvent\">\n+        <dc:Bounds x=\"232\" y=\"512\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"MessageBo
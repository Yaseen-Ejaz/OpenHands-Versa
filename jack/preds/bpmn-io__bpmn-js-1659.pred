{"instance_id": "bpmn-io__bpmn-js-1659", "model_patch": "diff --git a/debug_resize.html b/debug_resize.html\nnew file mode 100644\nindex 00000000..c84a0146\n--- /dev/null\n+++ b/debug_resize.html\n@@ -0,0 +1,179 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Resize Debug</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; width: 800px; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; font-size: 14px; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; border-radius: 4px; max-height: 300px; overflow-y: auto; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Resize Debug</h1>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"resizeSubProcess()\">Resize SubProcess</button>\n+        <button onclick=\"resetDiagram()\">Reset</button>\n+        <button onclick=\"clearLog()\">Clear Log</button>\n+    </div>\n+    \n+    <div id=\"canvas\"></div>\n+    \n+    <div id=\"log\" class=\"info\">\n+        <strong>Event Log:</strong><br>\n+        <div id=\"logContent\"></div>\n+    </div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                   xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                   xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                   xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                   xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                   id=\"simple\" \n+                   targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:startEvent>\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Event\">\n+      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+    </bpmn2:endEvent>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow 1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow 2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_1\" text=\"Test Annotation\" />\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"TextAnnotation_1\" targetRef=\"SequenceFlow_1\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_1\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_SubProcess_1\" bpmnElement=\"SubProcess_1\">\n+        <dc:Bounds x=\"200\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"118\" />\n+        <di:waypoint x=\"200\" y=\"120\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"155\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_2\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"120\" />\n+        <di:waypoint x=\"400\" y=\"118\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"335\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"120\" y=\"200\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"170\" y=\"200\" />\n+        <di:waypoint x=\"168\" y=\"119\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+        var modeler = new BpmnJS({\n+            container: '#canvas'\n+        });\n+\n+        var elementRegistry, modeling, eventBus;\n+\n+        function log(message) {\n+            var logContent = document.getElementById('logContent');\n+            var timestamp = new Date().toLocaleTimeString();\n+            logContent.innerHTML += '[' + timestamp + '] ' + message + '<br>';\n+            logContent.scrollTop = logContent.scrollHeight;\n+        }\n+\n+        function clearLog() {\n+            document.getElementById('logContent').innerHTML = '';\n+        }\n+\n+        modeler.importXML(bpmnXML).then(function(result) {\n+            log('Diagram loaded successfully');\n+            \n+            // Get services\n+            elementRegistry = modeler.get('elementRegistry');\n+            modeling = modeler.get('modeling');\n+            eventBus = modeler.get('eventBus');\n+            \n+            // Listen to all connection-related events\n+            eventBus.on('connection.layout', function(event) {\n+                log('EVENT: connection.layout - ' + event.context.connection.id);\n+            });\n+            \n+            eventBus.on('connection.updateWaypoints', function(event) {\n+                log('EVENT: connection.updateWaypoints - ' + event.context.connection.id);\n+            });\n+            \n+            eventBus.on('shape.resize', function(event) {\n+                log('EVENT: shape.resize - ' + event.context.shape.id);\n+            });\n+            \n+            eventBus.on('commandStack.shape.resize.execute', function(event) {\n+                log('EVENT: commandStack.shape.resize.execute - ' + event.context.shape.id);\n+            });\n+            \n+            eventBus.on('commandStack.shape.resize.postExecute', function(event) {\n+                log('EVENT: commandStack.shape.resize.postExecute - ' + event.context.shape.id);\n+            });\n+            \n+            eventBus.on('commandStack.connection.layout.execute', function(event) {\n+                log('EVENT: commandStack.connection.layout.execute - ' + event.context.connection.id);\n+            });\n+            \n+            eventBus.on('commandStack.connection.layout.postExecute', function(event) {\n+                log('EVENT: commandStack.connection.layout.postExecute - ' + event.context.connection.id);\n+            });\n+            \n+        }).catch(function(err) {\n+            log('Error loading diagram: ' + err.message);\n+        });\n+\n+        function resizeSubProcess() {\n+            if (!elementRegistry || !modeling) return;\n+            \n+            var subProcess = elementRegistry.get('SubProcess_1');\n+            \n+            log('=== STARTING RESIZE ===');\n+            log('SubProcess incoming: ' + subProcess.incoming.map(c => c.id).join(', '));\n+            log('SubProcess outgoing: ' + subProcess.outgoing.map(c => c.id).join(', '));\n+            \n+            // Resize the subprocess (make it larger)\n+            var newBounds = {\n+                x: subProcess.x,\n+                y: subProcess.y - 20,  // expand upward\n+                width: subProcess.width + 40,  // expand width\n+                height: subProcess.height + 40  // expand height\n+            };\n+            \n+            modeling.resizeShape(subProcess, newBounds);\n+            \n+            log('=== RESIZE COMPLETED ===');\n+        }\n+\n+        function resetDiagram() {\n+            clearLog();\n+            modeler.importXML(bpmnXML).then(function(result) {\n+                log('Diagram reset');\n+            });\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_resize_issue.js b/test_resize_issue.js\nnew file mode 100644\nindex 00000000..32ae653e\n--- /dev/null\n+++ b/test_resize_issue.js\n@@ -0,0 +1,172 @@\n+/**\n+ * Test to reproduce the issue where labels and associations don't reconnect \n+ * to SequenceFlow after resize\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('Issue Reproduction - Labels and associations after resize', function() {\n+\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                   xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                   xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                   xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                   xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                   id=\"simple\" \n+                   targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:startEvent>\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Event\">\n+      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+    </bpmn2:endEvent>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow 1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow 2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_1\" text=\"Test Annotation\" />\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"TextAnnotation_1\" targetRef=\"SequenceFlow_1\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_1\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"106\" y=\"141\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_SubProcess_1\" bpmnElement=\"SubProcess_1\">\n+        <dc:Bounds x=\"200\" y=\"80\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"225\" y=\"113\" width=\"50\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"393\" y=\"141\" width=\"51\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"118\" />\n+        <di:waypoint x=\"168\" y=\"118\" />\n+        <di:waypoint x=\"168\" y=\"120\" />\n+        <di:waypoint x=\"200\" y=\"120\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"155\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_2\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"120\" />\n+        <di:waypoint x=\"350\" y=\"120\" />\n+        <di:waypoint x=\"350\" y=\"118\" />\n+        <di:waypoint x=\"400\" y=\"118\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"335\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"120\" y=\"200\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"170\" y=\"200\" />\n+        <di:waypoint x=\"168\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      modelingModule,\n+      coreModule\n+    ]\n+  }));\n+\n+  it('should move labels and associations when subprocess is resized', inject(function(elementRegistry, modeling) {\n+\n+    // given\n+    var subProcess = elementRegistry.get('SubProcess_1');\n+    var sequenceFlow1 = elementRegistry.get('SequenceFlow_1');\n+    var sequenceFlow2 = elementRegistry.get('SequenceFlow_2');\n+    var association = elementRegistry.get('Association_1');\n+    var textAnnotation = elementRegistry.get('TextAnnotation_1');\n+\n+    // record initial positions\n+    var initialFlow1Label = sequenceFlow1.label ? { x: sequenceFlow1.label.x, y: sequenceFlow1.label.y } : null;\n+    var initialFlow2Label = sequenceFlow2.label ? { x: sequenceFlow2.label.x, y: sequenceFlow2.label.y } : null;\n+    var initialAssociationWaypoints = association.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+    var initialFlow1Waypoints = sequenceFlow1.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+    var initialFlow2Waypoints = sequenceFlow2.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+\n+    console.log('Initial state:');\n+    console.log('SubProcess bounds:', { x: subProcess.x, y: subProcess.y, width: subProcess.width, height: subProcess.height });\n+    console.log('SequenceFlow_1 waypoints:', initialFlow1Waypoints);\n+    console.log('SequenceFlow_2 waypoints:', initialFlow2Waypoints);\n+    console.log('Association waypoints:', initialAssociationWaypoints);\n+    if (initialFlow1Label) console.log('SequenceFlow_1 label:', initialFlow1Label);\n+    if (initialFlow2Label) console.log('SequenceFlow_2 label:', initialFlow2Label);\n+\n+    // when - resize the subprocess (make it larger)\n+    var newBounds = {\n+      x: subProcess.x,\n+      y: subProcess.y - 20,  // expand upward\n+      width: subProcess.width + 40,  // expand width\n+      height: subProcess.height + 40  // expand height\n+    };\n+\n+    modeling.resizeShape(subProcess, newBounds);\n+\n+    // then - check that connections were re-laid out\n+    var newFlow1Waypoints = sequenceFlow1.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+    var newFlow2Waypoints = sequenceFlow2.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+    var newAssociationWaypoints = association.waypoints.map(wp => ({ x: wp.x, y: wp.y }));\n+    var newFlow1Label = sequenceFlow1.label ? { x: sequenceFlow1.label.x, y: sequenceFlow1.label.y } : null;\n+    var newFlow2Label = sequenceFlow2.label ? { x: sequenceFlow2.label.x, y: sequenceFlow2.label.y } : null;\n+\n+    console.log('After resize:');\n+    console.log('SubProcess bounds:', { x: subProcess.x, y: subProcess.y, width: subProcess.width, height: subProcess.height });\n+    console.log('SequenceFlow_1 waypoints:', newFlow1Waypoints);\n+    console.log('SequenceFlow_2 waypoints:', newFlow2Waypoints);\n+    console.log('Association waypoints:', newAssociationWaypoints);\n+    if (newFlow1Label) console.log('SequenceFlow_1 label:', newFlow1Label);\n+    if (newFlow2Label) console.log('SequenceFlow_2 label:', newFlow2Label);\n+\n+    // Verify that connections changed (they should be re-laid out)\n+    expect(newFlow1Waypoints).to.not.deep.equal(initialFlow1Waypoints);\n+    expect(newFlow2Waypoints).to.not.deep.equal(initialFlow2Waypoints);\n+\n+    // Verify that association was updated to follow the connection\n+    expect(newAssociationWaypoints).to.not.deep.equal(initialAssociationWaypoints);\n+\n+    // Verify that labels moved with the connections\n+    if (initialFlow1Label && newFlow1Label) {\n+      expect(newFlow1Label).to.not.deep.equal(initialFlow1Label);\n+    }\n+    if (initialFlow2Label && newFlow2Label) {\n+      expect(newFlow2Label).to.not.deep.equal(initialFlow2Label);\n+    }\n+\n+    // The key test: association should still connect to the sequence flow at the right point\n+    // The association's end point should be close to one of the sequence flow waypoints\n+    var associationEndPoint = newAssociationWaypoints[newAssociationWaypoints.length - 1];\n+    var closestDistance = Math.min(...newFlow1Waypoints.map(wp => \n+      Math.sqrt(Math.pow(wp.x - associationEndPoint.x, 2) + Math.pow(wp.y - associationEndPoint.y, 2))\n+    ));\n+    \n+    // Association should connect close to the sequence flow (within 5 pixels)\n+    expect(closestDistance).to.be.lessThan(5);\n+\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_resize_visual.html b/test_resize_visual.html\nnew file mode 100644\nindex 00000000..2dc5db8b\n--- /dev/null\n+++ b/test_resize_visual.html\n@@ -0,0 +1,208 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Resize Issue Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #canvas {\n+            border: 1px solid #ccc;\n+            height: 500px;\n+            width: 800px;\n+        }\n+        .controls {\n+            margin: 20px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+            font-size: 14px;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Resize Issue Test</h1>\n+    <p>This test reproduces the issue where labels and associations don't reconnect to SequenceFlow after resize.</p>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"resizeSubProcess()\">Resize SubProcess</button>\n+        <button onclick=\"resetDiagram()\">Reset</button>\n+        <button onclick=\"logPositions()\">Log Positions</button>\n+    </div>\n+    \n+    <div id=\"info\" class=\"info\">\n+        <strong>Instructions:</strong>\n+        <ol>\n+            <li>Observe the initial positions of the sequence flow, its label, and the association</li>\n+            <li>Click \"Resize SubProcess\" to make the subprocess larger</li>\n+            <li>Check if the association and labels move correctly with the sequence flow</li>\n+        </ol>\n+    </div>\n+    \n+    <div id=\"canvas\"></div>\n+    \n+    <div id=\"log\" class=\"info\" style=\"max-height: 200px; overflow-y: auto;\">\n+        <strong>Log:</strong><br>\n+        <div id=\"logContent\"></div>\n+    </div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                   xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                   xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                   xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                   xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                   id=\"simple\" \n+                   targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:startEvent>\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Event\">\n+      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+    </bpmn2:endEvent>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow 1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow 2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_1\" text=\"Test Annotation\" />\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"TextAnnotation_1\" targetRef=\"SequenceFlow_1\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_1\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"106\" y=\"141\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_SubProcess_1\" bpmnElement=\"SubProcess_1\">\n+        <dc:Bounds x=\"200\" y=\"80\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"225\" y=\"113\" width=\"50\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"393\" y=\"141\" width=\"51\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"118\" />\n+        <di:waypoint x=\"168\" y=\"118\" />\n+        <di:waypoint x=\"168\" y=\"120\" />\n+        <di:waypoint x=\"200\" y=\"120\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"155\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_2\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"120\" />\n+        <di:waypoint x=\"350\" y=\"120\" />\n+        <di:waypoint x=\"350\" y=\"118\" />\n+        <di:waypoint x=\"400\" y=\"118\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"335\" y=\"95\" width=\"30\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"120\" y=\"200\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"170\" y=\"200\" />\n+        <di:waypoint x=\"168\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+        var modeler = new BpmnJS({\n+            container: '#canvas'\n+        });\n+\n+        var elementRegistry, modeling;\n+\n+        function log(message) {\n+            var logContent = document.getElementById('logContent');\n+            logContent.innerHTML += message + '<br>';\n+            logContent.scrollTop = logContent.scrollHeight;\n+        }\n+\n+        modeler.importXML(bpmnXML).then(function(result) {\n+            log('Diagram loaded successfully');\n+            \n+            // Get services\n+            elementRegistry = modeler.get('elementRegistry');\n+            modeling = modeler.get('modeling');\n+            \n+            logPositions();\n+        }).catch(function(err) {\n+            log('Error loading diagram: ' + err.message);\n+        });\n+\n+        function logPositions() {\n+            if (!elementRegistry) return;\n+            \n+            var subProcess = elementRegistry.get('SubProcess_1');\n+            var sequenceFlow1 = elementRegistry.get('SequenceFlow_1');\n+            var sequenceFlow2 = elementRegistry.get('SequenceFlow_2');\n+            var association = elementRegistry.get('Association_1');\n+            \n+            log('=== Current Positions ===');\n+            log('SubProcess: ' + JSON.stringify({x: subProcess.x, y: subProcess.y, width: subProcess.width, height: subProcess.height}));\n+            log('SequenceFlow_1 waypoints: ' + JSON.stringify(sequenceFlow1.waypoints));\n+            log('SequenceFlow_2 waypoints: ' + JSON.stringify(sequenceFlow2.waypoints));\n+            log('Association waypoints: ' + JSON.stringify(association.waypoints));\n+            \n+            if (sequenceFlow1.label) {\n+                log('SequenceFlow_1 label: ' + JSON.stringify({x: sequenceFlow1.label.x, y: sequenceFlow1.label.y}));\n+            }\n+            if (sequenceFlow2.label) {\n+                log('SequenceFlow_2 label: ' + JSON.stringify({x: sequenceFlow2.label.x, y: sequenceFlow2.label.y}));\n+            }\n+        }\n+\n+        function resizeSubProcess() {\n+            if (!elementRegistry || !modeling) return;\n+            \n+            var subProcess = elementRegistry.get('SubProcess_1');\n+            \n+            log('=== BEFORE RESIZE ===');\n+            logPositions();\n+            \n+            // Resize the subprocess (make it larger)\n+            var newBounds = {\n+                x: subProcess.x,\n+                y: subProcess.y - 20,  // expand upward\n+                width: subProcess.width + 40,  // expand width\n+                height: subProcess.height + 40  // expand height\n+            };\n+            \n+            modeling.resizeShape(subProcess, newBounds);\n+            \n+            log('=== AFTER RESIZE ===');\n+            logPositions();\n+        }\n+\n+        function resetDiagram() {\n+            modeler.importXML(bpmnXML).then(function(result) {\n+                log('=== DIAGRAM RESET ===');\n+                logPositions();\n+            });\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

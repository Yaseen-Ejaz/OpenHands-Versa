{"instance_id": "bpmn-io__bpmn-js-1542", "model_patch": "diff --git a/lib/features/modeling/behavior/util/LabelLayoutUtil.js b/lib/features/modeling/behavior/util/LabelLayoutUtil.js\nindex 43a50a07..d62d0d37 100644\n--- a/lib/features/modeling/behavior/util/LabelLayoutUtil.js\n+++ b/lib/features/modeling/behavior/util/LabelLayoutUtil.js\n@@ -15,6 +15,11 @@ import {\n \n export function findNewLabelLineStartIndex(oldWaypoints, newWaypoints, attachment, hints) {\n \n+  // handle case where attachment is undefined\n+  if (!attachment) {\n+    return null;\n+  }\n+\n   var index = attachment.segmentIndex;\n \n   var offset = newWaypoints.length - oldWaypoints.length;\n@@ -112,8 +117,14 @@ export function getLabelAdjustment(label, newWaypoints, oldWaypoints, hints) {\n   var labelPosition = getLabelMid(label);\n \n   // get closest attachment\n-  var attachment = getAttachment(labelPosition, oldWaypoints),\n-      oldLabelLineIndex = attachment.segmentIndex,\n+  var attachment = getAttachment(labelPosition, oldWaypoints);\n+  \n+  // handle case where attachment is undefined\n+  if (!attachment) {\n+    return { x: x, y: y };\n+  }\n+  \n+  var oldLabelLineIndex = attachment.segmentIndex,\n       newLabelLineIndex = findNewLabelLineStartIndex(oldWaypoints, newWaypoints, attachment, hints);\n \n   if (newLabelLineIndex === null) {\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 00000000..f5be3ef6\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,23 @@\n+// Simple Node.js test to verify the fix\n+const { findNewLabelLineStartIndex, getLabelAdjustment } = require('./lib/features/modeling/behavior/util/LabelLayoutUtil');\n+\n+console.log('Testing segmentIndex fix...');\n+\n+// Test 1: findNewLabelLineStartIndex with undefined attachment\n+try {\n+  const result = findNewLabelLineStartIndex([], [], undefined, {});\n+  console.log('\u2713 findNewLabelLineStartIndex with undefined attachment returns:', result);\n+  if (result === null) {\n+    console.log('\u2713 Test 1 PASSED: Returns null for undefined attachment');\n+  } else {\n+    console.log('\u2717 Test 1 FAILED: Expected null, got:', result);\n+  }\n+} catch (error) {\n+  console.log('\u2717 Test 1 FAILED: Error occurred:', error.message);\n+}\n+\n+// Test 2: getLabelAdjustment with undefined attachment (mock scenario)\n+// This would require more complex mocking, but we can test the logic conceptually\n+\n+console.log('\\nFix verification complete!');\n+console.log('The fix adds proper null checks to prevent the segmentIndex error.');\n\\ No newline at end of file\ndiff --git a/test_segmentindex_bug.js b/test_segmentindex_bug.js\nnew file mode 100644\nindex 00000000..02a23ee9\n--- /dev/null\n+++ b/test_segmentindex_bug.js\n@@ -0,0 +1,88 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from './test/TestHelper';\n+\n+import coreModule from './lib/core';\n+import modelingModule from './lib/features/modeling';\n+\n+// Test BPMN diagram with a labeled flow\n+const testDiagram = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" name=\"NO\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"173\" y=\"102\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"400\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"209\" y=\"120\" />\n+        <di:waypoint x=\"400\" y=\"120\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"295\" y=\"102\" width=\"19\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+describe('SegmentIndex Bug Reproduction', function() {\n+\n+  beforeEach(bootstrapModeler(testDiagram, {\n+    modules: [\n+      coreModule,\n+      modelingModule\n+    ]\n+  }));\n+\n+  it('should reproduce segmentIndex error when inserting gateway on flow with label', inject(\n+    function(modeling, elementRegistry, elementFactory) {\n+\n+      // given\n+      var gateway = elementFactory.createShape({\n+        type: 'bpmn:ExclusiveGateway'\n+      });\n+\n+      var sequenceFlow = elementRegistry.get('SequenceFlow_1');\n+      var dropPosition = { x: 300, y: 120 }; // position on the flow before \"NO\" label\n+\n+      console.log('SequenceFlow:', sequenceFlow);\n+      console.log('SequenceFlow label:', sequenceFlow.label);\n+      console.log('SequenceFlow waypoints:', sequenceFlow.waypoints);\n+\n+      // when - this should trigger the segmentIndex error\n+      try {\n+        var newShape = modeling.createShape(\n+          gateway,\n+          dropPosition,\n+          sequenceFlow\n+        );\n+        console.log('Gateway created successfully:', newShape);\n+      } catch (error) {\n+        console.error('Error occurred:', error.message);\n+        console.error('Stack trace:', error.stack);\n+        \n+        // Check if this is the expected segmentIndex error\n+        if (error.message.includes('segmentIndex')) {\n+          console.log('\u2713 Successfully reproduced the segmentIndex bug!');\n+          throw error; // Re-throw to fail the test as expected\n+        } else {\n+          console.log('\u2717 Different error occurred:', error.message);\n+          throw error;\n+        }\n+      }\n+    }\n+  ));\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

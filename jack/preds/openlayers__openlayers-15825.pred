ce/GeoTIFF.test.js b/test/browser/spec/ol/source/GeoTIFF.test.js\nindex 845fda41b..7501525e8 100644\n--- a/test/browser/spec/ol/source/GeoTIFF.test.js\n+++ b/test/browser/spec/ol/source/GeoTIFF.test.js\n@@ -39,7 +39,7 @@ describe('ol/source/GeoTIFF', function () {\n       expect(source.convertToRGB_).to.be('auto');\n     });\n \n-    it('defaults to wrapX: false', function () {\n+    it('defaults to wrapX: true', function () {\n       const source = new GeoTIFFSource({\n         sources: [\n           {\n@@ -47,10 +47,10 @@ describe('ol/source/GeoTIFF', function () {\n           },\n         ],\n       });\n-      expect(source.getWrapX()).to.be(false);\n+      expect(source.getWrapX()).to.be(true);\n     });\n \n-    it('allows wrapX to be set', function () {\n+    it('allows wrapX to be set to true', function () {\n       const source = new GeoTIFFSource({\n         wrapX: true,\n         sources: [\n@@ -62,6 +62,18 @@ describe('ol/source/GeoTIFF', function () {\n       expect(source.getWrapX()).to.be(true);\n     });\n \n+    it('allows wrapX to be set to false', function () {\n+      const source = new GeoTIFFSource({\n+        wrapX: false,\n+        sources: [\n+          {\n+            url: 'spec/ol/source/images/0-0-0.tif',\n+          },\n+        ],\n+      });\n+      expect(source.getWrapX()).to.be(false);\n+    });\n+\n     it('defaults to projection: null', function () {\n       const source = new GeoTIFFSource({\n         sources: [\ndiff --git a/test_antimeridian_issue.html b/test_antimeridian_issue.html\nnew file mode 100644\nindex 000000000..d368a14de\n--- /dev/null\n+++ b/test_antimeridian_issue.html\n@@ -0,0 +1,136 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Antimeridian Tile Issue Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+            margin: 20px 0;\n+        }\n+        .info {\n+            background: #f0f0f0;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 8px 16px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGLTileLayer Antimeridian Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <strong>Issue:</strong> Missing tiles in WebGLTileLayer with GeoTiff source near the antimeridian (longitude \u00b1180\u00b0) when using stereographic projection.\n+    </div>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"testWithWrapX()\">Test with wrapX: true</button>\n+        <button onclick=\"testWithoutWrapX()\">Test with wrapX: false (current issue)</button>\n+        <button onclick=\"resetView()\">Reset View</button>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div class=\"info\">\n+        <strong>Expected:</strong> No missing tiles around antimeridian<br>\n+        <strong>Current Issue:</strong> Black gaps appear near antimeridian when wrapX is false (default for GeoTIFF)\n+    </div>\n+\n+    <script src=\"https://cdn.jsdelivr.net/npm/proj4@2.9.0/dist/proj4.js\"></script>\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+        import {register, fromLonLat, getProjection} from './src/ol/proj.js';\n+\n+        // Register the stereographic projection as described in the issue\n+        proj4.defs('stereo-sib', '+proj=stere +lat_0=49 +lat_ts=-73 +lon_0=90 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+        register(proj4);\n+\n+        let map;\n+        let layer;\n+\n+        // Create a simple test GeoTIFF data URL (1x1 pixel red image)\n+        // In real scenario, this would be the provided GeoTIFF file\n+        const testGeoTiffUrl = 'data:image/tiff;base64,TU0AKgAAAAgAAAABAAEAAwABAAEAAAEBAAMAAQABAAAAAgEDAAEAAAABAAAAAwEDAAEAAAABAAAABgEDAAEAAAAAAAEXAQQAAQAAABAAAAEaAQUAAQAAAIYAAAAbAQUAAQAAAI4AAAAcAQMAAQAAAAEAAAAoAQMAAQAAAAIAAAA=';\n+\n+        function createLayer(wrapX = false) {\n+            return new WebGLTileLayer({\n+                source: new GeoTIFF({\n+                    sources: [{\n+                        url: 'https://s2downloads.eox.at/demo/EOxCloudless/2020/rgbnir/s2cloudless2020-16bits_sinlge-file_z0-4.tif'\n+                    }],\n+                    crossOrigin: 'anonymous',\n+                    transition: 0,\n+                    normalize: true,\n+                    wrapX: wrapX  // This is the key parameter\n+                }),\n+                name: 'segments',\n+                zIndex: 2,\n+                cacheSize: 2048,\n+                preload: 0\n+            });\n+        }\n+\n+        function initMap(wrapX = false) {\n+            if (map) {\n+                map.setTarget(null);\n+            }\n+\n+            layer = createLayer(wrapX);\n+            \n+            const defaultProj = getProjection('stereo-sib');\n+            \n+            map = new Map({\n+                target: 'map',\n+                layers: [layer],\n+                view: new View({\n+                    projection: defaultProj,\n+                    center: fromLonLat([-175.63918171041328, 54.36175564445709], defaultProj),\n+                    zoom: 5.370370380181835,\n+                    minZoom: 4\n+                })\n+            });\n+\n+            console.log('Map initialized with wrapX:', wrapX);\n+            console.log('View center:', map.getView().getCenter());\n+            console.log('View projection:', map.getView().getProjection().getCode());\n+        }\n+\n+        window.testWithWrapX = function() {\n+            console.log('Testing with wrapX: true');\n+            initMap(true);\n+        };\n+\n+        window.testWithoutWrapX = function() {\n+            console.log('Testing with wrapX: false (reproducing issue)');\n+            initMap(false);\n+        };\n+\n+        window.resetView = function() {\n+            if (map) {\n+                const defaultProj = getProjection('stereo-sib');\n+                map.getView().setCenter(fromLonLat([-175.63918171041328, 54.36175564445709], defaultProj));\n+                map.getView().setZoom(5.370370380181835);\n+            }\n+        };\n+\n+        // Initialize with the problematic configuration\n+        testWithoutWrapX();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_verification.html b/test_fix_verification.html\nnew file mode 100644\nindex 000000000..e75b17563\n--- /dev/null\n+++ b/test_fix_verification.html\n@@ -0,0 +1,154 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>GeoTIFF wrapX Fix Verification</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .test-result {\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+        }\n+        .pass {\n+            background: #d4edda;\n+            color: #155724;\n+            border: 1px solid #c3e6cb;\n+        }\n+        .fail {\n+            background: #f8d7da;\n+            color: #721c24;\n+            border: 1px solid #f5c6cb;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>GeoTIFF wrapX Default Value Fix Verification</h1>\n+    \n+    <div id=\"test-results\"></div>\n+\n+    <script type=\"module\">\n+        import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+\n+        function runTests() {\n+            const results = [];\n+            \n+            // Test 1: Default wrapX should be true\n+            try {\n+                const source1 = new GeoTIFF({\n+                    sources: [{url: 'test.tif'}]\n+                });\n+                \n+                // Access the wrapX property through the parent class\n+                const wrapX1 = source1.getWrapX();\n+                \n+                if (wrapX1 === true) {\n+                    results.push({\n+                        test: 'Default wrapX value',\n+                        status: 'PASS',\n+                        message: 'GeoTIFF source defaults to wrapX: true'\n+                    });\n+                } else {\n+                    results.push({\n+                        test: 'Default wrapX value',\n+                        status: 'FAIL',\n+                        message: `Expected wrapX: true, got: ${wrapX1}`\n+                    });\n+                }\n+            } catch (error) {\n+                results.push({\n+                    test: 'Default wrapX value',\n+                    status: 'FAIL',\n+                    message: `Error creating GeoTIFF source: ${error.message}`\n+                });\n+            }\n+            \n+            // Test 2: Explicit wrapX: false should still work\n+            try {\n+                const source2 = new GeoTIFF({\n+                    sources: [{url: 'test.tif'}],\n+                    wrapX: false\n+                });\n+                \n+                const wrapX2 = source2.getWrapX();\n+                \n+                if (wrapX2 === false) {\n+                    results.push({\n+                        test: 'Explicit wrapX: false',\n+                        status: 'PASS',\n+                        message: 'Explicit wrapX: false works correctly'\n+                    });\n+                } else {\n+                    results.push({\n+                        test: 'Explicit wrapX: false',\n+                        status: 'FAIL',\n+                        message: `Expected wrapX: false, got: ${wrapX2}`\n+                    });\n+                }\n+            } catch (error) {\n+                results.push({\n+                    test: 'Explicit wrapX: false',\n+                    status: 'FAIL',\n+                    message: `Error creating GeoTIFF source: ${error.message}`\n+                });\n+            }\n+            \n+            // Test 3: Explicit wrapX: true should work\n+            try {\n+                const source3 = new GeoTIFF({\n+                    sources: [{url: 'test.tif'}],\n+                    wrapX: true\n+                });\n+                \n+                const wrapX3 = source3.getWrapX();\n+                \n+                if (wrapX3 === true) {\n+                    results.push({\n+                        test: 'Explicit wrapX: true',\n+                        status: 'PASS',\n+                        message: 'Explicit wrapX: true works correctly'\n+                    });\n+                } else {\n+                    results.push({\n+                        test: 'Explicit wrapX: true',\n+                        status: 'FAIL',\n+                        message: `Expected wrapX: true, got: ${wrapX3}`\n+                    });\n+                }\n+            } catch (error) {\n+                results.push({\n+                    test: 'Explicit wrapX: true',\n+                    status: 'FAIL',\n+                    message: `Error creating GeoTIFF source: ${error.message}`\n+                });\n+            }\n+            \n+            // Display results\n+            const resultsDiv = document.getElementById('test-results');\n+            results.forEach(result => {\n+                const div = document.createElement('div');\n+                div.className = `test-result ${result.status.toLowerCase()}`;\n+                div.innerHTML = `\n+                    <strong>${result.test}:</strong> ${result.status}<br>\n+                    ${result.message}\n+                `;\n+                resultsDiv.appendChild(div);\n+            });\n+            \n+            // Summary\n+            const passed = results.filter(r => r.status === 'PASS').length;\n+            const total = results.length;\n+            const summaryDiv = document.createElement('div');\n+            summaryDiv.className = `test-result ${passed === total ? 'pass' : 'fail'}`;\n+            summaryDiv.innerHTML = `<strong>Summary:</strong> ${passed}/${total} tests passed`;\n+            resultsDiv.appendChild(summaryDiv);\n+        }\n+\n+        // Run tests when page loads\n+        runTests();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

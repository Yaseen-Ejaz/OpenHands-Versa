6 19:17:28] \"GET /src/ol/geom/flat/linechunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 19:17:28] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 19:17:28] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 19:17:28] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 19:17:28] \"GET /src/ol/render/Box.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 19:17:28] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 304 -\ndiff --git a/src/ol/renderer/canvas/VectorTileLayer.js b/src/ol/renderer/canvas/VectorTileLayer.js\nindex b6071332a..ff174342a 100644\n--- a/src/ol/renderer/canvas/VectorTileLayer.js\n+++ b/src/ol/renderer/canvas/VectorTileLayer.js\n@@ -553,7 +553,8 @@ class CanvasVectorTileLayerRenderer extends CanvasTileLayerRenderer {\n   renderDeclutter(frameState) {\n     const context = this.context;\n     const alpha = context.globalAlpha;\n-    context.globalAlpha = this.getLayer().getOpacity();\n+    const layerState = frameState.layerStatesArray[frameState.layerIndex];\n+    context.globalAlpha = layerState.opacity;\n     const viewHints = frameState.viewHints;\n     const hifi = !(\n       viewHints[ViewHint.ANIMATING] || viewHints[ViewHint.INTERACTING]\n@@ -636,7 +637,8 @@ class CanvasVectorTileLayerRenderer extends CanvasTileLayerRenderer {\n     );\n     const renderMode = layer.getRenderMode();\n     const alpha = context.globalAlpha;\n-    context.globalAlpha = layer.getOpacity();\n+    const layerState = frameState.layerStatesArray[frameState.layerIndex];\n+    context.globalAlpha = layerState.opacity;\n     const replayTypes = VECTOR_REPLAYS[renderMode];\n     const viewState = frameState.viewState;\n     const rotation = viewState.rotation;\ndiff --git a/test_group_opacity_fix.html b/test_group_opacity_fix.html\nnew file mode 100644\nindex 000000000..ee5b868d1\n--- /dev/null\n+++ b/test_group_opacity_fix.html\n@@ -0,0 +1,236 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Layer Group Opacity Fix Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        .control { margin: 10px 0; }\n+        label { display: inline-block; width: 200px; }\n+        input[type=\"range\"] { width: 200px; }\n+        .opacity-value { font-weight: bold; }\n+        .description { margin: 10px 0; color: #666; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Layer Group Opacity Fix Test</h1>\n+    <p>This test verifies that vector tile labels respect group opacity changes.</p>\n+    <div class=\"description\">\n+        <strong>Expected behavior:</strong> When you change the group opacity, both vector and vector tile labels should fade together.\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div class=\"controls\">\n+        <div class=\"control\">\n+            <label>Group Opacity:</label>\n+            <input type=\"range\" id=\"groupOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n+            <span class=\"opacity-value\" id=\"groupOpacityValue\">1.0</span>\n+        </div>\n+        <div class=\"control\">\n+            <label>Vector Layer Individual:</label>\n+            <input type=\"range\" id=\"vectorOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n+            <span class=\"opacity-value\" id=\"vectorOpacityValue\">1.0</span>\n+        </div>\n+        <div class=\"control\">\n+            <label>VectorTile Layer Individual:</label>\n+            <input type=\"range\" id=\"vectorTileOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n+            <span class=\"opacity-value\" id=\"vectorTileOpacityValue\">1.0</span>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import LayerGroup from './src/ol/layer/Group.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorTileLayer from './src/ol/layer/VectorTile.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import VectorTileSource from './src/ol/source/VectorTile.js';\n+        import MVT from './src/ol/format/MVT.js';\n+        import {Style, Fill, Stroke, Text, Circle} from './src/ol/style.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create test features with labels for vector layer\n+        const vectorFeatures = [\n+            new Feature({\n+                geometry: new Point(fromLonLat([-10, 10])),\n+                name: 'Vector Label 1'\n+            }),\n+            new Feature({\n+                geometry: new Point(fromLonLat([-5, 5])),\n+                name: 'Vector Label 2'\n+            })\n+        ];\n+\n+        // Vector layer with prominent labels\n+        const vectorLayer = new VectorLayer({\n+            source: new VectorSource({\n+                features: vectorFeatures\n+            }),\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({\n+                        color: 'rgba(255, 0, 0, 0.8)'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'darkred',\n+                        width: 2\n+                    })\n+                }),\n+                text: new Text({\n+                    font: 'bold 16px Arial',\n+                    fill: new Fill({\n+                        color: 'red'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'white',\n+                        width: 3\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle',\n+                    offsetY: -25,\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    }\n+                })\n+            })\n+        });\n+\n+        // Create mock vector tile features for testing\n+        const mockVectorTileFeatures = [\n+            new Feature({\n+                geometry: new Point(fromLonLat([10, 10])),\n+                name: 'VectorTile Label 1'\n+            }),\n+            new Feature({\n+                geometry: new Point(fromLonLat([5, 5])),\n+                name: 'VectorTile Label 2'\n+            })\n+        ];\n+\n+        // Mock vector tile layer with labels (using vector source for simplicity)\n+        const vectorTileLayer = new VectorTileLayer({\n+            source: new VectorTileSource({\n+                format: new MVT(),\n+                url: 'data:application/x-protobuf;base64,', // Empty tiles\n+                maxZoom: 14\n+            }),\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({\n+                        color: 'rgba(0, 0, 255, 0.8)'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'darkblue',\n+                        width: 2\n+                    })\n+                }),\n+                text: new Text({\n+                    font: 'bold 16px Arial',\n+                    fill: new Fill({\n+                        color: 'blue'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'white',\n+                        width: 3\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle',\n+                    text: 'VectorTile Label'\n+                })\n+            })\n+        });\n+\n+        // Add a simple vector layer to simulate vector tile behavior for testing\n+        const mockVectorTileAsVector = new VectorLayer({\n+            source: new VectorSource({\n+                features: mockVectorTileFeatures\n+            }),\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({\n+                        color: 'rgba(0, 0, 255, 0.8)'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'darkblue',\n+                        width: 2\n+                    })\n+                }),\n+                text: new Text({\n+                    font: 'bold 16px Arial',\n+                    fill: new Fill({\n+                        color: 'blue'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'white',\n+                        width: 3\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle',\n+                    offsetY: -25,\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    }\n+                })\n+            })\n+        });\n+\n+        // Create layer group\n+        const layerGroup = new LayerGroup({\n+            layers: [vectorLayer, mockVectorTileAsVector]\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [layerGroup],\n+            view: new View({\n+                center: fromLonLat([0, 7.5]),\n+                zoom: 4\n+            })\n+        });\n+\n+        // Control handlers\n+        const groupOpacitySlider = document.getElementById('groupOpacity');\n+        const groupOpacityValue = document.getElementById('groupOpacityValue');\n+        const vectorOpacitySlider = document.getElementById('vectorOpacity');\n+        const vectorOpacityValue = document.getElementById('vectorOpacityValue');\n+        const vectorTileOpacitySlider = document.getElementById('vectorTileOpacity');\n+        const vectorTileOpacityValue = document.getElementById('vectorTileOpacityValue');\n+\n+        groupOpacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            layerGroup.setOpacity(opacity);\n+            groupOpacityValue.textContent = opacity.toFixed(1);\n+            console.log('Group opacity set to:', opacity);\n+        });\n+\n+        vectorOpacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            vectorLayer.setOpacity(opacity);\n+            vectorOpacityValue.textContent = opacity.toFixed(1);\n+            console.log('Vector layer opacity set to:', opacity);\n+        });\n+\n+        vectorTileOpacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            mockVectorTileAsVector.setOpacity(opacity);\n+            vectorTileOpacityValue.textContent = opacity.toFixed(1);\n+            console.log('VectorTile layer opacity set to:', opacity);\n+        });\n+\n+        // Add some debug logging\n+        console.log('Test setup complete');\n+        console.log('Vector layer:', vectorLayer);\n+        console.log('Mock VectorTile layer:', mockVectorTileAsVector);\n+        console.log('Layer group:', layerGroup);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple_fix.html b/test_simple_fix.html\nnew file mode 100644\nindex 000000000..a539a83ab\n--- /dev/null\n+++ b/test_simple_fix.html\n@@ -0,0 +1,113 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Group Opacity Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 400px; border: 1px solid #ccc; background: #f0f0f0; }\n+        .controls { margin: 20px 0; }\n+        .control { margin: 10px 0; }\n+        label { display: inline-block; width: 150px; }\n+        input[type=\"range\"] { width: 200px; }\n+        .opacity-value { font-weight: bold; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"./src/ol/ol.css\" type=\"text/css\">\n+</head>\n+<body>\n+    <h1>Group Opacity Test</h1>\n+    <p>Testing if vector tile labels respect group opacity.</p>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div class=\"controls\">\n+        <div class=\"control\">\n+            <label>Group Opacity:</label>\n+            <input type=\"range\" id=\"groupOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n+            <span class=\"opacity-value\" id=\"groupOpacityValue\">1.0</span>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import LayerGroup from './src/ol/layer/Group.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import {Style, Fill, Stroke, Text, Circle} from './src/ol/style.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+\n+        console.log('Starting test...');\n+\n+        // Create simple test features\n+        const features = [\n+            new Feature({\n+                geometry: new Point([0, 0]),\n+                name: 'Test Label 1'\n+            }),\n+            new Feature({\n+                geometry: new Point([1000000, 1000000]),\n+                name: 'Test Label 2'\n+            })\n+        ];\n+\n+        // Create vector layer with labels\n+        const vectorLayer = new VectorLayer({\n+            source: new VectorSource({\n+                features: features\n+            }),\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 10,\n+                    fill: new Fill({\n+                        color: 'red'\n+                    })\n+                }),\n+                text: new Text({\n+                    font: '14px Arial',\n+                    fill: new Fill({\n+                        color: 'black'\n+                    }),\n+                    stroke: new Stroke({\n+                        color: 'white',\n+                        width: 2\n+                    }),\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    }\n+                })\n+            })\n+        });\n+\n+        // Create layer group\n+        const layerGroup = new LayerGroup({\n+            layers: [vectorLayer]\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [layerGroup],\n+            view: new View({\n+                center: [500000, 500000],\n+                zoom: 5\n+            })\n+        });\n+\n+        console.log('Map created:', map);\n+\n+        // Control handler\n+        const groupOpacitySlider = document.getElementById('groupOpacity');\n+        const groupOpacityValue = document.getElementById('groupOpacityValue');\n+\n+        groupOpacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            layerGroup.setOpacity(opacity);\n+            groupOpacityValue.textContent = opacity.toFixed(1);\n+            console.log('Group opacity set to:', opacity);\n+        });\n+\n+        console.log('Test setup complete');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

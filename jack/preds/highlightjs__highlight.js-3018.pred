{"instance_id": "highlightjs__highlight.js-3018", "model_patch": "diff --git a/src/languages/lib/ecmascript.js b/src/languages/lib/ecmascript.js\nindex b80f24d4..844e843b 100644\n--- a/src/languages/lib/ecmascript.js\n+++ b/src/languages/lib/ecmascript.js\n@@ -55,6 +55,7 @@ const TYPES = [\n   \"Intl\",\n   \"DataView\",\n   \"Number\",\n+  \"BigInt\",\n   \"Math\",\n   \"Date\",\n   \"String\",\n@@ -82,7 +83,9 @@ const TYPES = [\n   \"Array\",\n   \"Uint8Array\",\n   \"Uint8ClampedArray\",\n-  \"ArrayBuffer\"\n+  \"ArrayBuffer\",\n+  \"BigInt64Array\",\n+  \"BigUint64Array\"\n ];\n \n const ERROR_TYPES = [\ndiff --git a/test/bigint-test.html b/test/bigint-test.html\nnew file mode 100644\nindex 00000000..1962f89d\n--- /dev/null\n+++ b/test/bigint-test.html\n@@ -0,0 +1,42 @@\n+\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\">\n+  <title>BigInt Highlighting Test</title>\n+  <link rel=\"stylesheet\" href=\"../build/styles/default.min.css\">\n+  <script src=\"../build/lib/highlight.js\"></script>\n+  <script src=\"../build/lib/languages/javascript.js\"></script>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    pre { margin: 20px 0; }\n+    .test-case { margin-bottom: 30px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BigInt Highlighting Test</h1>\n+  \n+  <div class=\"test-case\">\n+    <h2>Current Implementation</h2>\n+    <pre><code class=\"language-javascript\">// Test for BigInt highlighting\n+let bi = BigInt('1');\n+const bi2 = 123n;\n+\n+// Test for BigInt64Array and BigUint64Array\n+const bigIntArray = new BigInt64Array(10);\n+const bigUintArray = new BigUint64Array(5);\n+\n+// Compare with existing types\n+const num = Number('42');\n+const arr = new Int32Array(10);</code></pre>\n+  </div>\n+\n+  <script>\n+    document.addEventListener('DOMContentLoaded', (event) => {\n+      document.querySelectorAll('pre code').forEach((block) => {\n+        hljs.highlightElement(block);\n+      });\n+    });\n+  </script>\n+</body>\n+</html>\ndiff --git a/test/bigint-test.js b/test/bigint-test.js\nnew file mode 100644\nindex 00000000..4c4ad959\n--- /dev/null\n+++ b/test/bigint-test.js\n@@ -0,0 +1,52 @@\n+const path = require('path');\n+const fs = require('fs');\n+\n+// Use the CLI tool to highlight the code\n+const { execSync } = require('child_process');\n+\n+// Read the test file\n+const testFilePath = path.join(__dirname, 'markup/javascript/bigint.js');\n+const testCode = fs.readFileSync(testFilePath, 'utf-8');\n+\n+// Let's use a simpler approach - write the test code to a temporary HTML file\n+// and then open it in a browser to visually inspect the highlighting\n+const tempHtmlPath = path.join(__dirname, 'bigint-test.html');\n+const htmlContent = `\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\">\n+  <title>BigInt Highlighting Test</title>\n+  <link rel=\"stylesheet\" href=\"../build/styles/default.min.css\">\n+  <script src=\"../build/lib/highlight.js\"></script>\n+  <script src=\"../build/lib/languages/javascript.js\"></script>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    pre { margin: 20px 0; }\n+    .test-case { margin-bottom: 30px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BigInt Highlighting Test</h1>\n+  \n+  <div class=\"test-case\">\n+    <h2>Current Implementation</h2>\n+    <pre><code class=\"language-javascript\">${testCode}</code></pre>\n+  </div>\n+\n+  <script>\n+    document.addEventListener('DOMContentLoaded', (event) => {\n+      document.querySelectorAll('pre code').forEach((block) => {\n+        hljs.highlightElement(block);\n+      });\n+    });\n+  </script>\n+</body>\n+</html>\n+`;\n+\n+fs.writeFileSync(tempHtmlPath, htmlContent);\n+\n+console.log(`Test HTML file created at: ${tempHtmlPath}`);\n+console.log('Open this file in a browser to visually inspect the highlighting.');\n+console.log('Now proceeding to modify the ecmascript.js file to add BigInt support.');\n\\ No newline at end of file\ndiff --git a/test/direct-test.js b/test/direct-test.js\nnew file mode 100644\nindex 00000000..67256a21\n--- /dev/null\n+++ b/test/direct-test.js\n@@ -0,0 +1,31 @@\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Read the ecmascript.js file\n+const ecmascriptPath = path.join(__dirname, '../src/languages/lib/ecmascript.js');\n+const ecmascriptContent = fs.readFileSync(ecmascriptPath, 'utf-8');\n+\n+// Check if BigInt is in the TYPES array\n+const hasBigInt = ecmascriptContent.includes('\"BigInt\",');\n+console.log('BigInt is in TYPES array:', hasBigInt);\n+\n+// Check if BigInt64Array is in the TYPES array\n+const hasBigInt64Array = ecmascriptContent.includes('\"BigInt64Array\",') || \n+                         ecmascriptContent.includes('\"BigInt64Array\"');\n+console.log('BigInt64Array is in TYPES array:', hasBigInt64Array);\n+\n+// Check if BigUint64Array is in the TYPES array\n+const hasBigUint64Array = ecmascriptContent.includes('\"BigUint64Array\",') || \n+                          ecmascriptContent.includes('\"BigUint64Array\"');\n+console.log('BigUint64Array is in TYPES array:', hasBigUint64Array);\n+\n+// All checks should be true for the fix to be complete\n+const isFixComplete = hasBigInt && hasBigInt64Array && hasBigUint64Array;\n+console.log('Fix is complete:', isFixComplete);\n+\n+if (isFixComplete) {\n+  console.log('SUCCESS: All required types have been added to the TYPES array in ecmascript.js');\n+} else {\n+  console.log('FAILURE: Some required types are missing from the TYPES array in ecmascript.js');\n+  process.exit(1);\n+}\n\\ No newline at end of file\ndiff --git a/test/markup/javascript/bigint.expect.txt b/test/markup/javascript/bigint.expect.txt\nnew file mode 100644\nindex 00000000..4583547d\n--- /dev/null\n+++ b/test/markup/javascript/bigint.expect.txt\n@@ -0,0 +1,11 @@\n+<span class=\"hljs-comment\">// Test for BigInt highlighting</span>\n+<span class=\"hljs-keyword\">let</span> bi = <span class=\"hljs-built_in\">BigInt</span>(<span class=\"hljs-string\">&#x27;1&#x27;</span>);\n+<span class=\"hljs-keyword\">const</span> bi2 = <span class=\"hljs-number\">123n</span>;\n+\n+<span class=\"hljs-comment\">// Test for BigInt64Array and BigUint64Array</span>\n+<span class=\"hljs-keyword\">const</span> bigIntArray = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigInt64Array</span>(<span class=\"hljs-number\">10</span>);\n+<span class=\"hljs-keyword\">const</span> bigUintArray = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigUint64Array</span>(<span class=\"hljs-number\">5</span>);\n+\n+<span class=\"hljs-comment\">// Compare with existing types</span>\n+<span class=\"hljs-keyword\">const</span> num = <span class=\"hljs-built_in\">Number</span>(<span class=\"hljs-string\">&#x27;42&#x27;</span>);\n+<span class=\"hljs-keyword\">const</span> arr = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">Int32Array</span>(<span class=\"hljs-number\">10</span>);\n\\ No newline at end of file\ndiff --git a/test/markup/javascript/bigint.js b/test/markup/javascript/bigint.js\nnew file mode 100644\nindex 00000000..93b0bde6\n--- /dev/null\n+++ b/test/markup/javascript/bigint.js\n@@ -0,0 +1,11 @@\n+// Test for BigInt highlighting\n+let bi = BigInt('1');\n+const bi2 = 123n;\n+\n+// Test for BigInt64Array and BigUint64Array\n+const bigIntArray = new BigInt64Array(10);\n+const bigUintArray = new BigUint64Array(5);\n+\n+// Compare with existing types\n+const num = Number('42');\n+const arr = new Int32Array(10);\n\\ No newline at end of file\ndiff --git a/test/markup/javascript/bigint.txt b/test/markup/javascript/bigint.txt\nnew file mode 100644\nindex 00000000..93b0bde6\n--- /dev/null\n+++ b/test/markup/javascript/bigint.txt\n@@ -0,0 +1,11 @@\n+// Test for BigInt highlighting\n+let bi = BigInt('1');\n+const bi2 = 123n;\n+\n+// Test for BigInt64Array and BigUint64Array\n+const bigIntArray = new BigInt64Array(10);\n+const bigUintArray = new BigUint64Array(5);\n+\n+// Compare with existing types\n+const num = Number('42');\n+const arr = new Int32Array(10);\n\\ No newline at end of file\ndiff --git a/test/simple-test.html b/test/simple-test.html\nnew file mode 100644\nindex 00000000..9967deef\n--- /dev/null\n+++ b/test/simple-test.html\n@@ -0,0 +1,75 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\">\n+  <title>BigInt Highlighting Test</title>\n+  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.6.0/styles/default.min.css\">\n+  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.6.0/highlight.min.js\"></script>\n+  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.6.0/languages/javascript.min.js\"></script>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    pre { margin: 20px 0; }\n+    .test-case { margin-bottom: 30px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BigInt Highlighting Test - Before Fix (CDN Version)</h1>\n+  \n+  <div class=\"test-case\">\n+    <h2>Current Implementation</h2>\n+    <pre><code class=\"language-javascript\">// Test for BigInt highlighting\n+let bi = BigInt('1');\n+const bi2 = 123n;\n+\n+// Test for BigInt64Array and BigUint64Array\n+const bigIntArray = new BigInt64Array(10);\n+const bigUintArray = new BigUint64Array(5);\n+\n+// Compare with existing types\n+const num = Number('42');\n+const arr = new Int32Array(10);</code></pre>\n+  </div>\n+\n+  <h1>BigInt Highlighting Test - After Fix (Local Build)</h1>\n+  \n+  <div class=\"test-case\">\n+    <h2>Fixed Implementation</h2>\n+    <pre><code class=\"language-javascript\" id=\"local-code\">// Test for BigInt highlighting\n+let bi = BigInt('1');\n+const bi2 = 123n;\n+\n+// Test for BigInt64Array and BigUint64Array\n+const bigIntArray = new BigInt64Array(10);\n+const bigUintArray = new BigUint64Array(5);\n+\n+// Compare with existing types\n+const num = Number('42');\n+const arr = new Int32Array(10);</code></pre>\n+  </div>\n+\n+  <script>\n+    document.addEventListener('DOMContentLoaded', (event) => {\n+      // Highlight with CDN version (before fix)\n+      hljs.initHighlightingOnLoad();\n+      \n+      // Load our local version (after fix)\n+      const script = document.createElement('script');\n+      script.src = '../build/lib/core.js';\n+      script.onload = function() {\n+        const jsScript = document.createElement('script');\n+        jsScript.src = '../build/lib/languages/javascript.js';\n+        jsScript.onload = function() {\n+          // Register the JavaScript language\n+          window.hljs.registerLanguage('javascript', window.javascript.default);\n+          \n+          // Highlight the local code block\n+          const localCode = document.getElementById('local-code');\n+          window.hljs.highlightBlock(localCode);\n+        };\n+        document.head.appendChild(jsScript);\n+      };\n+      document.head.appendChild(script);\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

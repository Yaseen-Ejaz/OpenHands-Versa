{"instance_id": "openlayers__openlayers-8515", "model_patch": "diff --git a/src/ol/interaction/Select.js b/src/ol/interaction/Select.js\nindex 4c123fa15..10012d3c8 100644\n--- a/src/ol/interaction/Select.js\n+++ b/src/ol/interaction/Select.js\n@@ -94,6 +94,9 @@ const SelectEventType = {\n  * @property {number} [hitTolerance=0] Hit-detection tolerance. Pixels inside\n  * the radius around the given position will be checked for features. This only\n  * works for the canvas renderer and not for WebGL.\n+ * @property {number} [overlayZIndex] The z-index for the selection overlay.\n+ * By default, the overlay will be rendered on top of all other layers. Use this\n+ * option to control the z-index of selected features relative to other layers.\n  */\n \n \n@@ -217,7 +220,8 @@ class Select extends Interaction {\n       style: options.style ? options.style :\n         getDefaultStyleFunction(),\n       updateWhileAnimating: true,\n-      updateWhileInteracting: true\n+      updateWhileInteracting: true,\n+      zIndex: options.overlayZIndex\n     });\n \n     /**\ndiff --git a/src/ol/layer/Layer.js b/src/ol/layer/Layer.js\nindex 9d361818f..7b1ccf585 100644\n--- a/src/ol/layer/Layer.js\n+++ b/src/ol/layer/Layer.js\n@@ -191,7 +191,10 @@ class Layer extends BaseLayer {\n       this.mapPrecomposeKey_ = listen(map, RenderEventType.PRECOMPOSE, function(evt) {\n         const layerState = this.getLayerState();\n         layerState.managed = false;\n-        layerState.zIndex = Infinity;\n+        // Use the layer's zIndex if set, otherwise default to Infinity for backward compatibility\n+        if (layerState.zIndex === undefined || layerState.zIndex === null) {\n+          layerState.zIndex = Infinity;\n+        }\n         evt.frameState.layerStatesArray.push(layerState);\n         evt.frameState.layerStates[getUid(this)] = layerState;\n       }, this);\ndiff --git a/test_overlay_zindex.js b/test_overlay_zindex.js\nnew file mode 100644\nindex 000000000..86e2448ab\n--- /dev/null\n+++ b/test_overlay_zindex.js\n@@ -0,0 +1,24 @@\n+// Simple test to verify overlayZIndex option works\n+const Select = require('./build/ol/interaction/Select.js').default;\n+const VectorLayer = require('./build/ol/layer/Vector.js').default;\n+const VectorSource = require('./build/ol/source/Vector.js').default;\n+\n+// Test 1: Default behavior (no overlayZIndex specified)\n+console.log('Test 1: Default behavior');\n+const select1 = new Select();\n+const overlay1 = select1.featureOverlay_;\n+console.log('Default overlay zIndex:', overlay1.getZIndex()); // Should be undefined\n+\n+// Test 2: Custom overlayZIndex specified\n+console.log('\\nTest 2: Custom overlayZIndex');\n+const select2 = new Select({ overlayZIndex: 75 });\n+const overlay2 = select2.featureOverlay_;\n+console.log('Custom overlay zIndex:', overlay2.getZIndex()); // Should be 75\n+\n+// Test 3: overlayZIndex = 0 (should work)\n+console.log('\\nTest 3: overlayZIndex = 0');\n+const select3 = new Select({ overlayZIndex: 0 });\n+const overlay3 = select3.featureOverlay_;\n+console.log('Zero overlay zIndex:', overlay3.getZIndex()); // Should be 0\n+\n+console.log('\\nAll tests completed successfully!');\n\\ No newline at end of file\ndiff --git a/test_select_zindex.html b/test_select_zindex.html\nnew file mode 100644\nindex 000000000..718d3e0c4\n--- /dev/null\n+++ b/test_select_zindex.html\n@@ -0,0 +1,113 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Select Interaction zIndex Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            font-family: Arial, sans-serif;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>Select Interaction zIndex Test</h3>\n+        <p>This test demonstrates the issue where selected features always appear on top, ignoring zIndex.</p>\n+        <p>Expected: Red dots (zIndex=100) should appear above selected blue features (zIndex=50)</p>\n+        <p>Actual: Selected blue features appear above red dots regardless of zIndex</p>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script src=\"./build/ol.js\"></script>\n+    <script>\n+        // Create base layer\n+        var baseLayer = new ol.layer.Tile({\n+            source: new ol.source.OSM(),\n+            zIndex: 0\n+        });\n+\n+        // Create features for the selectable layer\n+        var selectableFeatures = [];\n+        for (var i = 0; i < 5; i++) {\n+            var feature = new ol.Feature({\n+                geometry: new ol.geom.Point([i * 1000000, 0])\n+            });\n+            feature.setStyle(new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 20,\n+                    fill: new ol.style.Fill({color: 'blue'}),\n+                    stroke: new ol.style.Stroke({color: 'darkblue', width: 2})\n+                })\n+            }));\n+            selectableFeatures.push(feature);\n+        }\n+\n+        // Create selectable layer with zIndex 50\n+        var selectableLayer = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: selectableFeatures\n+            }),\n+            zIndex: 50\n+        });\n+\n+        // Create features for the overlay layer (should appear on top)\n+        var overlayFeatures = [];\n+        for (var i = 0; i < 5; i++) {\n+            var feature = new ol.Feature({\n+                geometry: new ol.geom.Point([i * 1000000 + 200000, 200000])\n+            });\n+            feature.setStyle(new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 15,\n+                    fill: new ol.style.Fill({color: 'red'}),\n+                    stroke: new ol.style.Stroke({color: 'darkred', width: 2})\n+                })\n+            }));\n+            overlayFeatures.push(feature);\n+        }\n+\n+        // Create overlay layer with higher zIndex (should appear on top)\n+        var overlayLayer = new ol.layer.Vector({\n+            source: new ol.source.Vector({\n+                features: overlayFeatures\n+            }),\n+            zIndex: 100  // Higher zIndex - should appear above selected features\n+        });\n+\n+        // Create map\n+        var map = new ol.Map({\n+            target: 'map',\n+            layers: [baseLayer, selectableLayer, overlayLayer],\n+            view: new ol.View({\n+                center: [2000000, 0],\n+                zoom: 6\n+            })\n+        });\n+\n+        // Add select interaction\n+        var select = new ol.interaction.Select({\n+            layers: [selectableLayer],\n+            style: new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 25,\n+                    fill: new ol.style.Fill({color: 'rgba(0, 0, 255, 0.7)'}),\n+                    stroke: new ol.style.Stroke({color: 'blue', width: 3})\n+                })\n+            })\n+        });\n+        map.addInteraction(select);\n+\n+        // Auto-select the first feature to demonstrate the issue\n+        setTimeout(function() {\n+            select.getFeatures().push(selectableFeatures[2]);\n+        }, 1000);\n+\n+        console.log('Test setup complete. The selected blue feature should appear below red dots, but it appears above them.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_select_zindex_fixed.html b/test_select_zindex_fixed.html\nnew file mode 100644\nindex 000000000..20f8ec00f\n--- /dev/null\n+++ b/test_select_zindex_fixed.html\n@@ -0,0 +1,157 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Select Interaction zIndex Fix Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            font-family: Arial, sans-serif;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 5px 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>Select Interaction zIndex Fix Test</h3>\n+        <p>This test demonstrates the fix for the zIndex issue with selected features.</p>\n+        <p>Red dots have zIndex=100, blue selectable features have zIndex=50</p>\n+        <p>With overlayZIndex=75: Selected features should appear above blue layer but below red dots</p>\n+        <p>With overlayZIndex=150: Selected features should appear above everything</p>\n+    </div>\n+    <div class=\"controls\">\n+        <button onclick=\"setOverlayZIndex(75)\">Set Overlay zIndex = 75 (between layers)</button>\n+        <button onclick=\"setOverlayZIndex(150)\">Set Overlay zIndex = 150 (above all)</button>\n+        <button onclick=\"setOverlayZIndex(undefined)\">Set Overlay zIndex = default (Infinity)</button>\n+        <button onclick=\"selectFeature()\">Select Middle Feature</button>\n+        <button onclick=\"clearSelection()\">Clear Selection</button>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script src=\"./build/ol.js\"></script>\n+    <script>\n+        var map, select, selectableLayer, overlayLayer, selectableFeatures;\n+\n+        function initMap() {\n+            // Create base layer\n+            var baseLayer = new ol.layer.Tile({\n+                source: new ol.source.OSM(),\n+                zIndex: 0\n+            });\n+\n+            // Create features for the selectable layer\n+            selectableFeatures = [];\n+            for (var i = 0; i < 5; i++) {\n+                var feature = new ol.Feature({\n+                    geometry: new ol.geom.Point([i * 1000000, 0])\n+                });\n+                feature.setStyle(new ol.style.Style({\n+                    image: new ol.style.Circle({\n+                        radius: 20,\n+                        fill: new ol.style.Fill({color: 'blue'}),\n+                        stroke: new ol.style.Stroke({color: 'darkblue', width: 2})\n+                    })\n+                }));\n+                selectableFeatures.push(feature);\n+            }\n+\n+            // Create selectable layer with zIndex 50\n+            selectableLayer = new ol.layer.Vector({\n+                source: new ol.source.Vector({\n+                    features: selectableFeatures\n+                }),\n+                zIndex: 50\n+            });\n+\n+            // Create features for the overlay layer (should appear on top)\n+            var overlayFeatures = [];\n+            for (var i = 0; i < 5; i++) {\n+                var feature = new ol.Feature({\n+                    geometry: new ol.geom.Point([i * 1000000 + 200000, 200000])\n+                });\n+                feature.setStyle(new ol.style.Style({\n+                    image: new ol.style.Circle({\n+                        radius: 15,\n+                        fill: new ol.style.Fill({color: 'red'}),\n+                        stroke: new ol.style.Stroke({color: 'darkred', width: 2})\n+                    })\n+                }));\n+                overlayFeatures.push(feature);\n+            }\n+\n+            // Create overlay layer with higher zIndex (should appear on top)\n+            overlayLayer = new ol.layer.Vector({\n+                source: new ol.source.Vector({\n+                    features: overlayFeatures\n+                }),\n+                zIndex: 100  // Higher zIndex - should appear above selected features when overlayZIndex < 100\n+            });\n+\n+            // Create map\n+            map = new ol.Map({\n+                target: 'map',\n+                layers: [baseLayer, selectableLayer, overlayLayer],\n+                view: new ol.View({\n+                    center: [2000000, 0],\n+                    zoom: 6\n+                })\n+            });\n+\n+            // Start with overlayZIndex = 75 (between the two layers)\n+            setOverlayZIndex(75);\n+        }\n+\n+        function setOverlayZIndex(zIndex) {\n+            // Remove existing select interaction\n+            if (select) {\n+                map.removeInteraction(select);\n+            }\n+\n+            // Create new select interaction with specified overlayZIndex\n+            select = new ol.interaction.Select({\n+                layers: [selectableLayer],\n+                overlayZIndex: zIndex,\n+                style: new ol.style.Style({\n+                    image: new ol.style.Circle({\n+                        radius: 25,\n+                        fill: new ol.style.Fill({color: 'rgba(0, 0, 255, 0.7)'}),\n+                        stroke: new ol.style.Stroke({color: 'blue', width: 3})\n+                    })\n+                })\n+            });\n+            map.addInteraction(select);\n+\n+            console.log('Set overlayZIndex to:', zIndex);\n+        }\n+\n+        function selectFeature() {\n+            if (select && selectableFeatures.length > 2) {\n+                select.getFeatures().clear();\n+                select.getFeatures().push(selectableFeatures[2]);\n+            }\n+        }\n+\n+        function clearSelection() {\n+            if (select) {\n+                select.getFeatures().clear();\n+            }\n+        }\n+\n+        // Initialize the map\n+        initMap();\n+\n+        // Auto-select the middle feature after a short delay\n+        setTimeout(selectFeature, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

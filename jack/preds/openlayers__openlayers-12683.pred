);\ndiff --git a/test_icon_offset_bug.html b/test_icon_offset_bug.html\nnew file mode 100644\nindex 000000000..66f97104f\n--- /dev/null\n+++ b/test_icon_offset_bug.html\n@@ -0,0 +1,161 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Offset Bug Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin-bottom: 20px; }\n+        .controls button { margin-right: 10px; padding: 5px 10px; }\n+        .info { margin-top: 10px; font-size: 14px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Icon Offset Bug Test</h1>\n+    <div class=\"controls\">\n+        <button onclick=\"setPixelRatio(1)\">Pixel Ratio 1</button>\n+        <button onclick=\"setPixelRatio(2)\">Pixel Ratio 2</button>\n+        <button onclick=\"toggleColor()\">Toggle Color</button>\n+    </div>\n+    <div class=\"info\">\n+        <div>Current Pixel Ratio: <span id=\"currentRatio\">1</span></div>\n+        <div>Color Applied: <span id=\"colorStatus\">No</span></div>\n+        <div>Expected: All icons should show the same sprite region regardless of pixel ratio or color</div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script src=\"./build/ol/index.js\" type=\"module\"></script>\n+    <script>\n+        let map;\n+        let vectorLayer;\n+        let currentPixelRatio = 1;\n+        let colorApplied = false;\n+\n+        // Create a simple sprite image with different colored squares\n+        function createSpriteImage() {\n+            const canvas = document.createElement('canvas');\n+            canvas.width = 60;\n+            canvas.height = 20;\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Red square at 0,0\n+            ctx.fillStyle = 'red';\n+            ctx.fillRect(0, 0, 20, 20);\n+            \n+            // Green square at 20,0\n+            ctx.fillStyle = 'green';\n+            ctx.fillRect(20, 0, 20, 20);\n+            \n+            // Blue square at 40,0\n+            ctx.fillStyle = 'blue';\n+            ctx.fillRect(40, 0, 20, 20);\n+            \n+            return canvas.toDataURL();\n+        }\n+\n+        function createFeatures() {\n+            const spriteUrl = createSpriteImage();\n+            \n+            // Feature 1: Red square (offset 0,0)\n+            const feature1 = new ol.Feature({\n+                geometry: new ol.geom.Point(ol.proj.fromLonLat([0, 0]))\n+            });\n+            \n+            // Feature 2: Green square (offset 20,0) \n+            const feature2 = new ol.Feature({\n+                geometry: new ol.geom.Point(ol.proj.fromLonLat([1, 0]))\n+            });\n+            \n+            // Feature 3: Blue square (offset 40,0)\n+            const feature3 = new ol.Feature({\n+                geometry: new ol.geom.Point(ol.proj.fromLonLat([2, 0]))\n+            });\n+\n+            const iconStyle1 = new ol.style.Style({\n+                image: new ol.style.Icon({\n+                    src: spriteUrl,\n+                    offset: [0, 0],\n+                    size: [20, 20],\n+                    color: colorApplied ? [255, 255, 255] : undefined\n+                })\n+            });\n+\n+            const iconStyle2 = new ol.style.Style({\n+                image: new ol.style.Icon({\n+                    src: spriteUrl,\n+                    offset: [20, 0],\n+                    size: [20, 20],\n+                    color: colorApplied ? [255, 255, 255] : undefined\n+                })\n+            });\n+\n+            const iconStyle3 = new ol.style.Style({\n+                image: new ol.style.Icon({\n+                    src: spriteUrl,\n+                    offset: [40, 0],\n+                    size: [20, 20],\n+                    color: colorApplied ? [255, 255, 255] : undefined\n+                })\n+            });\n+\n+            feature1.setStyle(iconStyle1);\n+            feature2.setStyle(iconStyle2);\n+            feature3.setStyle(iconStyle3);\n+\n+            return [feature1, feature2, feature3];\n+        }\n+\n+        function initMap() {\n+            // Override pixel ratio for testing\n+            ol.has.DEVICE_PIXEL_RATIO = currentPixelRatio;\n+            \n+            const features = createFeatures();\n+            \n+            const vectorSource = new ol.source.Vector({\n+                features: features\n+            });\n+\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+            }\n+\n+            vectorLayer = new ol.layer.Vector({\n+                source: vectorSource\n+            });\n+\n+            if (!map) {\n+                map = new ol.Map({\n+                    target: 'map',\n+                    layers: [\n+                        new ol.layer.Tile({\n+                            source: new ol.source.OSM()\n+                        }),\n+                        vectorLayer\n+                    ],\n+                    view: new ol.View({\n+                        center: ol.proj.fromLonLat([1, 0]),\n+                        zoom: 10\n+                    })\n+                });\n+            } else {\n+                map.addLayer(vectorLayer);\n+            }\n+        }\n+\n+        function setPixelRatio(ratio) {\n+            currentPixelRatio = ratio;\n+            document.getElementById('currentRatio').textContent = ratio;\n+            initMap();\n+        }\n+\n+        function toggleColor() {\n+            colorApplied = !colorApplied;\n+            document.getElementById('colorStatus').textContent = colorApplied ? 'Yes' : 'No';\n+            initMap();\n+        }\n+\n+        // Initialize\n+        initMap();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_icon_offset_fix.js b/test_icon_offset_fix.js\nnew file mode 100644\nindex 000000000..c616e8131\n--- /dev/null\n+++ b/test_icon_offset_fix.js\n@@ -0,0 +1,172 @@\n+/**\n+ * Test for icon offset bug fix with colors and pixel ratio\n+ */\n+\n+import Feature from './src/ol/Feature.js';\n+import Point from './src/ol/geom/Point.js';\n+import {Icon, Style} from './src/ol/style.js';\n+import CanvasImmediateRenderer from './src/ol/render/canvas/Immediate.js';\n+import {create as createTransform} from './src/ol/transform.js';\n+\n+function createSpriteImage() {\n+  const canvas = document.createElement('canvas');\n+  canvas.width = 60;\n+  canvas.height = 20;\n+  const ctx = canvas.getContext('2d');\n+  \n+  // Red square at 0,0\n+  ctx.fillStyle = 'red';\n+  ctx.fillRect(0, 0, 20, 20);\n+  \n+  // Green square at 20,0\n+  ctx.fillStyle = 'green';\n+  ctx.fillRect(20, 0, 20, 20);\n+  \n+  // Blue square at 40,0\n+  ctx.fillStyle = 'blue';\n+  ctx.fillRect(40, 0, 20, 20);\n+  \n+  return canvas.toDataURL();\n+}\n+\n+function runTests() {\n+  console.log('Testing icon offset bug fix...');\n+  \n+  const canvas = document.createElement('canvas');\n+  canvas.width = 100;\n+  canvas.height = 100;\n+  const context = canvas.getContext('2d');\n+  \n+  const spriteUrl = createSpriteImage();\n+  \n+  // Test 1: With color applied (the bug scenario)\n+  console.log('\\n=== Test 1: With color applied ===');\n+  const iconStyleWithColor = new Style({\n+    image: new Icon({\n+      src: spriteUrl,\n+      offset: [20, 0], // Should select GREEN square\n+      size: [20, 20],\n+      color: [255, 255, 255] // Apply white color to trigger the bug\n+    })\n+  });\n+\n+  const iconWithColor = iconStyleWithColor.getImage();\n+  \n+  // Test with pixel ratio 1\n+  const renderer1 = new CanvasImmediateRenderer(\n+    context, 1, [0, 0, 100, 100], createTransform(), 0\n+  );\n+  renderer1.setImageStyle(iconWithColor);\n+  const originX1 = renderer1.imageOriginX_;\n+  const originY1 = renderer1.imageOriginY_;\n+  \n+  // Test with pixel ratio 2\n+  const renderer2 = new CanvasImmediateRenderer(\n+    context, 2, [0, 0, 100, 100], createTransform(), 0\n+  );\n+  renderer2.setImageStyle(iconWithColor);\n+  const originX2 = renderer2.imageOriginX_;\n+  const originY2 = renderer2.imageOriginY_;\n+  \n+  console.log(`Pixel ratio 1: origin = (${originX1}, ${originY1})`);\n+  console.log(`Pixel ratio 2: origin = (${originX2}, ${originY2})`);\n+  console.log(`Expected ratio: 2:1, Actual ratio: ${originX2/originX1}:1`);\n+  \n+  const test1Pass = (originX2 === originX1 * 2) && (originY2 === originY1 * 2) && (originX1 === 20);\n+  console.log(`Test 1 result: ${test1Pass ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+  \n+  // Test 2: Without color (should be consistent)\n+  console.log('\\n=== Test 2: Without color ===');\n+  const iconStyleNoColor = new Style({\n+    image: new Icon({\n+      src: spriteUrl,\n+      offset: [20, 0], // Should select GREEN square\n+      size: [20, 20]\n+      // No color applied\n+    })\n+  });\n+\n+  const iconNoColor = iconStyleNoColor.getImage();\n+  \n+  // Test with pixel ratio 1\n+  const renderer3 = new CanvasImmediateRenderer(\n+    context, 1, [0, 0, 100, 100], createTransform(), 0\n+  );\n+  renderer3.setImageStyle(iconNoColor);\n+  const originX3 = renderer3.imageOriginX_;\n+  const originY3 = renderer3.imageOriginY_;\n+  \n+  // Test with pixel ratio 2\n+  const renderer4 = new CanvasImmediateRenderer(\n+    context, 2, [0, 0, 100, 100], createTransform(), 0\n+  );\n+  renderer4.setImageStyle(iconNoColor);\n+  const originX4 = renderer4.imageOriginX_;\n+  const originY4 = renderer4.imageOriginY_;\n+  \n+  console.log(`Pixel ratio 1: origin = (${originX3}, ${originY3})`);\n+  console.log(`Pixel ratio 2: origin = (${originX4}, ${originY4})`);\n+  \n+  const test2Pass = (originX4 === originX3) && (originY4 === originY3) && (originX3 === 20);\n+  console.log(`Test 2 result: ${test2Pass ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+  \n+  // Test 3: Different offsets with color\n+  console.log('\\n=== Test 3: Different offsets with color ===');\n+  const testOffsets = [[0, 0], [20, 0], [40, 0]];\n+  let test3Pass = true;\n+  \n+  testOffsets.forEach(([offsetX, offsetY], index) => {\n+    const iconStyle = new Style({\n+      image: new Icon({\n+        src: spriteUrl,\n+        offset: [offsetX, offsetY],\n+        size: [20, 20],\n+        color: [255, 255, 255]\n+      })\n+    });\n+\n+    const icon = iconStyle.getImage();\n+    \n+    const r1 = new CanvasImmediateRenderer(context, 1, [0, 0, 100, 100], createTransform(), 0);\n+    r1.setImageStyle(icon);\n+    \n+    const r2 = new CanvasImmediateRenderer(context, 2, [0, 0, 100, 100], createTransform(), 0);\n+    r2.setImageStyle(icon);\n+    \n+    const correctScaling = (r2.imageOriginX_ === r1.imageOriginX_ * 2) && \n+                          (r2.imageOriginY_ === r1.imageOriginY_ * 2);\n+    const correctBase = (r1.imageOriginX_ === offsetX) && (r1.imageOriginY_ === offsetY);\n+    \n+    console.log(`Offset [${offsetX}, ${offsetY}]: PR1=(${r1.imageOriginX_}, ${r1.imageOriginY_}), PR2=(${r2.imageOriginX_}, ${r2.imageOriginY_}) - ${correctScaling && correctBase ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+    \n+    if (!correctScaling || !correctBase) {\n+      test3Pass = false;\n+    }\n+  });\n+  \n+  console.log(`Test 3 result: ${test3Pass ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+  \n+  // Overall result\n+  const allTestsPass = test1Pass && test2Pass && test3Pass;\n+  console.log(`\\n=== OVERALL RESULT ===`);\n+  console.log(`All tests: ${allTestsPass ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+  \n+  if (allTestsPass) {\n+    console.log('\u2705 Icon offset bug has been successfully fixed!');\n+    console.log('The fix ensures that sprite offsets work correctly regardless of pixel ratio when colors are applied.');\n+  } else {\n+    console.log('\u274c Some tests failed. The fix may need adjustment.');\n+  }\n+  \n+  return allTestsPass;\n+}\n+\n+// Export for use in browser or node\n+if (typeof window !== 'undefined') {\n+  window.runIconOffsetTests = runTests;\n+  console.log('Test function available as window.runIconOffsetTests()');\n+} else {\n+  runTests();\n+}\n+\n+export { runTests };\n\\ No newline at end of file\ndiff --git a/test_offset_bug.html b/test_offset_bug.html\nnew file mode 100644\nindex 000000000..9ef9c8bff\n--- /dev/null\n+++ b/test_offset_bug.html\n@@ -0,0 +1,162 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Offset Bug Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 400px; border: 1px solid #ccc; }\n+        .controls { margin-bottom: 20px; }\n+        .controls button { margin-right: 10px; padding: 5px 10px; }\n+        .info { margin-top: 10px; font-size: 14px; }\n+        .test-results { margin-top: 20px; padding: 10px; border: 1px solid #ddd; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"./build/ol/ol.css\" type=\"text/css\">\n+</head>\n+<body>\n+    <h1>Icon Offset Bug Test</h1>\n+    <div class=\"controls\">\n+        <button onclick=\"testPixelRatio1()\">Test Pixel Ratio 1</button>\n+        <button onclick=\"testPixelRatio2()\">Test Pixel Ratio 2</button>\n+        <button onclick=\"testWithColor()\">Test With Color (Pixel Ratio 2)</button>\n+    </div>\n+    <div class=\"info\">\n+        <div>Current Test: <span id=\"currentTest\">Pixel Ratio 1</span></div>\n+        <div>Expected: Green square should always be visible (offset 20,0 from sprite)</div>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div class=\"test-results\">\n+        <h3>Test Results:</h3>\n+        <div id=\"results\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './build/ol/Map.js';\n+        import View from './build/ol/View.js';\n+        import {Tile as TileLayer, Vector as VectorLayer} from './build/ol/layer.js';\n+        import {OSM, Vector as VectorSource} from './build/ol/source.js';\n+        import Feature from './build/ol/Feature.js';\n+        import Point from './build/ol/geom/Point.js';\n+        import {Style, Icon} from './build/ol/style.js';\n+        import {fromLonLat} from './build/ol/proj.js';\n+\n+        let map;\n+        let vectorLayer;\n+\n+        // Create a simple sprite image with different colored squares\n+        function createSpriteImage() {\n+            const canvas = document.createElement('canvas');\n+            canvas.width = 60;\n+            canvas.height = 20;\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Red square at 0,0\n+            ctx.fillStyle = 'red';\n+            ctx.fillRect(0, 0, 20, 20);\n+            \n+            // Green square at 20,0\n+            ctx.fillStyle = 'green';\n+            ctx.fillRect(20, 0, 20, 20);\n+            \n+            // Blue square at 40,0\n+            ctx.fillStyle = 'blue';\n+            ctx.fillRect(40, 0, 20, 20);\n+            \n+            return canvas.toDataURL();\n+        }\n+\n+        function createTestFeature(pixelRatio, withColor = false) {\n+            const spriteUrl = createSpriteImage();\n+            \n+            // Create feature that should show the GREEN square (offset 20,0)\n+            const feature = new Feature({\n+                geometry: new Point(fromLonLat([0, 0]))\n+            });\n+\n+            const iconStyle = new Style({\n+                image: new Icon({\n+                    src: spriteUrl,\n+                    offset: [20, 0],  // Should select the GREEN square\n+                    size: [20, 20],\n+                    color: withColor ? [255, 255, 255] : undefined\n+                })\n+            });\n+\n+            feature.setStyle(iconStyle);\n+            return feature;\n+        }\n+\n+        function initMap(pixelRatio, withColor = false, testName) {\n+            // Simulate different pixel ratios by modifying the device pixel ratio\n+            const originalRatio = window.devicePixelRatio;\n+            Object.defineProperty(window, 'devicePixelRatio', {\n+                value: pixelRatio,\n+                writable: true\n+            });\n+            \n+            const feature = createTestFeature(pixelRatio, withColor);\n+            \n+            const vectorSource = new VectorSource({\n+                features: [feature]\n+            });\n+\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+            }\n+\n+            vectorLayer = new VectorLayer({\n+                source: vectorSource\n+            });\n+\n+            if (!map) {\n+                map = new Map({\n+                    target: 'map',\n+                    layers: [\n+                        new TileLayer({\n+                            source: new OSM()\n+                        }),\n+                        vectorLayer\n+                    ],\n+                    view: new View({\n+                        center: fromLonLat([0, 0]),\n+                        zoom: 10\n+                    })\n+                });\n+            } else {\n+                map.addLayer(vectorLayer);\n+            }\n+\n+            document.getElementById('currentTest').textContent = testName;\n+            \n+            // Restore original pixel ratio\n+            Object.defineProperty(window, 'devicePixelRatio', {\n+                value: originalRatio,\n+                writable: true\n+            });\n+        }\n+\n+        function logResult(testName, expected, actual) {\n+            const results = document.getElementById('results');\n+            const result = document.createElement('div');\n+            const status = expected === actual ? '\u2705 PASS' : '\u274c FAIL';\n+            result.innerHTML = `${status} ${testName}: Expected ${expected}, Got ${actual}`;\n+            results.appendChild(result);\n+        }\n+\n+        // Test functions\n+        window.testPixelRatio1 = function() {\n+            initMap(1, false, 'Pixel Ratio 1, No Color');\n+        };\n+\n+        window.testPixelRatio2 = function() {\n+            initMap(2, false, 'Pixel Ratio 2, No Color');\n+        };\n+\n+        window.testWithColor = function() {\n+            initMap(2, true, 'Pixel Ratio 2, With Color');\n+        };\n+\n+        // Initialize with first test\n+        testPixelRatio1();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_sprite_offset.js b/test_sprite_offset.js\nnew file mode 100644\nindex 000000000..d2c3ee012\n--- /dev/null\n+++ b/test_sprite_offset.js\n@@ -0,0 +1,108 @@\n+/**\n+ * Test to reproduce the sprite offset bug with icon colors and pixel ratio\n+ */\n+\n+import Feature from './src/ol/Feature.js';\n+import Map from './src/ol/Map.js';\n+import Point from './src/ol/geom/Point.js';\n+import VectorSource from './src/ol/source/Vector.js';\n+import View from './src/ol/View.js';\n+import {Icon, Style} from './src/ol/style.js';\n+import {Vector as VectorLayer} from './src/ol/layer.js';\n+import {fromLonLat} from './src/ol/proj.js';\n+\n+// Create a sprite image with different colored squares for testing\n+function createSpriteImage() {\n+  const canvas = document.createElement('canvas');\n+  canvas.width = 60;\n+  canvas.height = 20;\n+  const ctx = canvas.getContext('2d');\n+  \n+  // Red square at 0,0\n+  ctx.fillStyle = 'red';\n+  ctx.fillRect(0, 0, 20, 20);\n+  \n+  // Green square at 20,0\n+  ctx.fillStyle = 'green';\n+  ctx.fillRect(20, 0, 20, 20);\n+  \n+  // Blue square at 40,0\n+  ctx.fillStyle = 'blue';\n+  ctx.fillRect(40, 0, 20, 20);\n+  \n+  return canvas.toDataURL();\n+}\n+\n+// Test function to check if offset calculation is correct\n+function testSpriteOffset() {\n+  const spriteUrl = createSpriteImage();\n+  \n+  // Create an icon style that should select the GREEN square (offset 20,0)\n+  const iconStyle = new Style({\n+    image: new Icon({\n+      src: spriteUrl,\n+      offset: [20, 0],\n+      size: [20, 20],\n+      color: [255, 255, 255] // Apply white color to trigger the bug\n+    })\n+  });\n+  \n+  const feature = new Feature({\n+    geometry: new Point(fromLonLat([0, 0]))\n+  });\n+  \n+  feature.setStyle(iconStyle);\n+  \n+  // Get the icon image and check the origin calculation\n+  const icon = iconStyle.getImage();\n+  const iconImage = icon.iconImage_;\n+  \n+  console.log('Original image size:', iconImage.getSize());\n+  console.log('Icon offset:', icon.offset_);\n+  console.log('Icon size:', icon.size_);\n+  \n+  // Test with different pixel ratios\n+  console.log('\\n--- Testing with pixel ratio 1 ---');\n+  const image1 = iconImage.getImage(1);\n+  const pixelRatio1 = iconImage.getPixelRatio(1);\n+  const origin1 = icon.getOrigin();\n+  console.log('Pixel ratio:', pixelRatio1);\n+  console.log('Image dimensions:', image1.width, 'x', image1.height);\n+  console.log('Calculated origin:', origin1);\n+  \n+  console.log('\\n--- Testing with pixel ratio 2 ---');\n+  const image2 = iconImage.getImage(2);\n+  const pixelRatio2 = iconImage.getPixelRatio(2);\n+  const origin2 = icon.getOrigin();\n+  console.log('Pixel ratio:', pixelRatio2);\n+  console.log('Image dimensions:', image2.width, 'x', image2.height);\n+  console.log('Calculated origin:', origin2);\n+  \n+  // The bug: origin should be the same for both pixel ratios, but it's not\n+  // when color is applied because the canvas is scaled but origin calculation doesn't account for it\n+  \n+  console.log('\\n--- Analysis ---');\n+  console.log('Origins should be the same, but they are:', \n+    JSON.stringify(origin1) === JSON.stringify(origin2) ? 'SAME \u2713' : 'DIFFERENT \u2717');\n+  \n+  return {\n+    origin1,\n+    origin2,\n+    pixelRatio1,\n+    pixelRatio2,\n+    image1Dimensions: [image1.width, image1.height],\n+    image2Dimensions: [image2.width, image2.height]\n+  };\n+}\n+\n+// Run the test\n+if (typeof window !== 'undefined') {\n+  // Browser environment\n+  window.testSpriteOffset = testSpriteOffset;\n+  console.log('Test function available as window.testSpriteOffset()');\n+} else {\n+  // Node environment\n+  testSpriteOffset();\n+}\n+\n+export { testSpriteOffset };\n\\ No newline at end of file\ndiff --git a/verify_fix.html b/verify_fix.html\nnew file mode 100644\nindex 000000000..18bedcd6b\n--- /dev/null\n+++ b/verify_fix.html\n@@ -0,0 +1,183 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Verify Icon Offset Fix</title>\n+    <style>\n+        body { margin: 20px; font-family: Arial, sans-serif; }\n+        .test-result { margin: 10px 0; padding: 10px; border: 1px solid #ddd; }\n+        .pass { background-color: #d4edda; border-color: #c3e6cb; }\n+        .fail { background-color: #f8d7da; border-color: #f5c6cb; }\n+        pre { background: #f8f9fa; padding: 10px; margin: 10px 0; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Icon Offset Bug Fix Verification</h1>\n+    <div id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {Icon, Style} from './src/ol/style.js';\n+        import CanvasImmediateRenderer from './src/ol/render/canvas/Immediate.js';\n+        import {create as createTransform} from './src/ol/transform.js';\n+\n+        function createSpriteImage() {\n+            const canvas = document.createElement('canvas');\n+            canvas.width = 60;\n+            canvas.height = 20;\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Red square at 0,0\n+            ctx.fillStyle = 'red';\n+            ctx.fillRect(0, 0, 20, 20);\n+            \n+            // Green square at 20,0\n+            ctx.fillStyle = 'green';\n+            ctx.fillRect(20, 0, 20, 20);\n+            \n+            // Blue square at 40,0\n+            ctx.fillStyle = 'blue';\n+            ctx.fillRect(40, 0, 20, 20);\n+            \n+            return canvas.toDataURL();\n+        }\n+\n+        function addResult(testName, passed, details) {\n+            const resultsDiv = document.getElementById('results');\n+            const resultDiv = document.createElement('div');\n+            resultDiv.className = `test-result ${passed ? 'pass' : 'fail'}`;\n+            resultDiv.innerHTML = `\n+                <h3>${testName}: ${passed ? 'PASS \u2713' : 'FAIL \u2717'}</h3>\n+                <pre>${details}</pre>\n+            `;\n+            resultsDiv.appendChild(resultDiv);\n+        }\n+\n+        function runTests() {\n+            const canvas = document.createElement('canvas');\n+            canvas.width = 100;\n+            canvas.height = 100;\n+            const context = canvas.getContext('2d');\n+            \n+            const spriteUrl = createSpriteImage();\n+            \n+            // Test 1: With color applied (the bug scenario)\n+            const iconStyleWithColor = new Style({\n+                image: new Icon({\n+                    src: spriteUrl,\n+                    offset: [20, 0], // Should select GREEN square\n+                    size: [20, 20],\n+                    color: [255, 255, 255] // Apply white color to trigger the bug\n+                })\n+            });\n+\n+            const iconWithColor = iconStyleWithColor.getImage();\n+            \n+            // Test with pixel ratio 1\n+            const renderer1 = new CanvasImmediateRenderer(\n+                context, 1, [0, 0, 100, 100], createTransform(), 0\n+            );\n+            renderer1.setImageStyle(iconWithColor);\n+            const originX1 = renderer1.imageOriginX_;\n+            const originY1 = renderer1.imageOriginY_;\n+            \n+            // Test with pixel ratio 2\n+            const renderer2 = new CanvasImmediateRenderer(\n+                context, 2, [0, 0, 100, 100], createTransform(), 0\n+            );\n+            renderer2.setImageStyle(iconWithColor);\n+            const originX2 = renderer2.imageOriginX_;\n+            const originY2 = renderer2.imageOriginY_;\n+            \n+            const test1Details = `Pixel ratio 1: origin = (${originX1}, ${originY1})\n+Pixel ratio 2: origin = (${originX2}, ${originY2})\n+Expected ratio: 2:1, Actual ratio: ${originX2/originX1}:1`;\n+            \n+            const test1Pass = (originX2 === originX1 * 2) && (originY2 === originY1 * 2) && (originX1 === 20);\n+            addResult('Test 1: With color applied', test1Pass, test1Details);\n+            \n+            // Test 2: Without color (should be consistent)\n+            const iconStyleNoColor = new Style({\n+                image: new Icon({\n+                    src: spriteUrl,\n+                    offset: [20, 0], // Should select GREEN square\n+                    size: [20, 20]\n+                    // No color applied\n+                })\n+            });\n+\n+            const iconNoColor = iconStyleNoColor.getImage();\n+            \n+            // Test with pixel ratio 1\n+            const renderer3 = new CanvasImmediateRenderer(\n+                context, 1, [0, 0, 100, 100], createTransform(), 0\n+            );\n+            renderer3.setImageStyle(iconNoColor);\n+            const originX3 = renderer3.imageOriginX_;\n+            const originY3 = renderer3.imageOriginY_;\n+            \n+            // Test with pixel ratio 2\n+            const renderer4 = new CanvasImmediateRenderer(\n+                context, 2, [0, 0, 100, 100], createTransform(), 0\n+            );\n+            renderer4.setImageStyle(iconNoColor);\n+            const originX4 = renderer4.imageOriginX_;\n+            const originY4 = renderer4.imageOriginY_;\n+            \n+            const test2Details = `Pixel ratio 1: origin = (${originX3}, ${originY3})\n+Pixel ratio 2: origin = (${originX4}, ${originY4})\n+Should be same since no color is applied`;\n+            \n+            const test2Pass = (originX4 === originX3) && (originY4 === originY3) && (originX3 === 20);\n+            addResult('Test 2: Without color', test2Pass, test2Details);\n+            \n+            // Test 3: Different offsets with color\n+            const testOffsets = [[0, 0], [20, 0], [40, 0]];\n+            let test3Pass = true;\n+            let test3Details = '';\n+            \n+            testOffsets.forEach(([offsetX, offsetY], index) => {\n+                const iconStyle = new Style({\n+                    image: new Icon({\n+                        src: spriteUrl,\n+                        offset: [offsetX, offsetY],\n+                        size: [20, 20],\n+                        color: [255, 255, 255]\n+                    })\n+                });\n+\n+                const icon = iconStyle.getImage();\n+                \n+                const r1 = new CanvasImmediateRenderer(context, 1, [0, 0, 100, 100], createTransform(), 0);\n+                r1.setImageStyle(icon);\n+                \n+                const r2 = new CanvasImmediateRenderer(context, 2, [0, 0, 100, 100], createTransform(), 0);\n+                r2.setImageStyle(icon);\n+                \n+                const correctScaling = (r2.imageOriginX_ === r1.imageOriginX_ * 2) && \n+                                      (r2.imageOriginY_ === r1.imageOriginY_ * 2);\n+                const correctBase = (r1.imageOriginX_ === offsetX) && (r1.imageOriginY_ === offsetY);\n+                \n+                test3Details += `Offset [${offsetX}, ${offsetY}]: PR1=(${r1.imageOriginX_}, ${r1.imageOriginY_}), PR2=(${r2.imageOriginX_}, ${r2.imageOriginY_}) - ${correctScaling && correctBase ? 'PASS \u2713' : 'FAIL \u2717'}\\n`;\n+                \n+                if (!correctScaling || !correctBase) {\n+                    test3Pass = false;\n+                }\n+            });\n+            \n+            addResult('Test 3: Different offsets with color', test3Pass, test3Details);\n+            \n+            // Overall result\n+            const allTestsPass = test1Pass && test2Pass && test3Pass;\n+            addResult('OVERALL RESULT', allTestsPass, \n+                allTestsPass ? \n+                '\u2705 Icon offset bug has been successfully fixed!\\nThe fix ensures that sprite offsets work correctly regardless of pixel ratio when colors are applied.' :\n+                '\u274c Some tests failed. The fix may need adjustment.'\n+            );\n+        }\n+\n+        // Run tests when page loads\n+        runTests();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

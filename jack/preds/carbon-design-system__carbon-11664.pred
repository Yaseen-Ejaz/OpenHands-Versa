ges/react/src/components/OverflowMenu/OverflowMenu-deprecation-test.js\nnew file mode 100644\nindex 000000000..c730fd430\n--- /dev/null\n+++ b/packages/react/src/components/OverflowMenu/OverflowMenu-deprecation-test.js\n@@ -0,0 +1,43 @@\n+/**\n+ * Copyright IBM Corp. 2016, 2018\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import React from 'react';\n+import OverflowMenu from '../OverflowMenu';\n+import OverflowMenuItem from '../OverflowMenuItem';\n+import { render } from '@testing-library/react';\n+\n+describe('OverflowMenu Deprecation Warnings', () => {\n+  const originalConsoleWarn = console.warn;\n+  let mockWarn;\n+\n+  beforeEach(() => {\n+    mockWarn = jest.fn();\n+    console.warn = mockWarn;\n+  });\n+\n+  afterEach(() => {\n+    console.warn = originalConsoleWarn;\n+  });\n+\n+  it('should not show deprecation warning when light prop is not used', () => {\n+    render(\n+      <OverflowMenu ariaLabel=\"Test Menu\">\n+        <OverflowMenuItem itemText=\"Option 1\" />\n+      </OverflowMenu>\n+    );\n+\n+    // Check if the warning about light prop was not called\n+    const lightWarningCalled = mockWarn.mock.calls.some(\n+      (call) => \n+        call[0] && \n+        typeof call[0] === 'string' && \n+        call[0].includes('light')\n+    );\n+    \n+    expect(lightWarningCalled).toBe(false);\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/OverflowMenu/OverflowMenu.js b/packages/react/src/components/OverflowMenu/OverflowMenu.js\nindex 11c2dddfc..52388ed70 100644\n--- a/packages/react/src/components/OverflowMenu/OverflowMenu.js\n+++ b/packages/react/src/components/OverflowMenu/OverflowMenu.js\n@@ -248,7 +248,6 @@ class OverflowMenu extends Component {\n     onOpen: () => {},\n     menuOffset: getMenuOffset,\n     menuOffsetFlip: getMenuOffset,\n-    light: false,\n     selectorPrimaryFocus: '[data-overflow-menu-primary-focus]',\n   };\n \ndiff --git a/test-app/index.html b/test-app/index.html\nnew file mode 100644\nindex 000000000..6700d29ac\n--- /dev/null\n+++ b/test-app/index.html\n@@ -0,0 +1,17 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>OverflowMenu Test</title>\n+  <meta charset=\"UTF-8\" />\n+</head>\n+<body>\n+  <div id=\"root\">\n+    <h1>OverflowMenu Test</h1>\n+    <p>This is a simple test to verify the OverflowMenu deprecation warning issue.</p>\n+    <p>Please check the browser console for any warnings.</p>\n+  </div>\n+  <script>\n+    console.log(\"Test page loaded. Check for any warnings in the console.\");\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "claude-sonnet-4"}

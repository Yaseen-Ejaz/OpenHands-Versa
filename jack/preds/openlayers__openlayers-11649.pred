{"instance_id": "openlayers__openlayers-11649", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..776531c2d\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,4 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [03/Mar/2026 06:56:58] \"GET /test_proj4_issue.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 07:00:41] \"GET /test_final_verification.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 07:00:41] \"GET /build/index.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/proj/proj4.js b/src/ol/proj/proj4.js\nindex 1726c5d7c..d6acd2d47 100644\n--- a/src/ol/proj/proj4.js\n+++ b/src/ol/proj/proj4.js\n@@ -2,6 +2,7 @@\n  * @module ol/proj/proj4\n  */\n import Projection from './Projection.js';\n+import Units from './Units.js';\n import {\n   addCoordinateTransforms,\n   addEquivalentProjections,\n@@ -31,12 +32,17 @@ export function register(proj4) {\n     const code = projCodes[i];\n     if (!get(code)) {\n       const def = proj4.defs(code);\n+      // Detect if this is a geographic projection\n+      const isGeographic = def.projName === 'longlat';\n+      // Apply defaults for geographic projections when properties are undefined\n+      const units = def.units || (isGeographic ? Units.DEGREES : undefined);\n+      const axisOrientation = def.axis || (isGeographic ? 'neu' : undefined);\n       addProjection(\n         new Projection({\n           code: code,\n-          axisOrientation: def.axis,\n+          axisOrientation: axisOrientation,\n           metersPerUnit: def.to_meter,\n-          units: def.units,\n+          units: units,\n         })\n       );\n     }\ndiff --git a/test_built_fix.mjs b/test_built_fix.mjs\nnew file mode 100644\nindex 000000000..7697c37da\n--- /dev/null\n+++ b/test_built_fix.mjs\n@@ -0,0 +1,102 @@\n+// Test the actual built OpenLayers code with our fix\n+import proj4 from 'proj4';\n+\n+// Import the built OpenLayers modules\n+import { register } from './build/ol/proj/proj4.js';\n+import { get as getProjection } from './build/ol/proj.js';\n+\n+console.log('=== Testing Built OpenLayers with Proj4 Fix ===\\n');\n+\n+function testProjection(code, proj4String, expectedUnits, expectedAxis, description) {\n+    console.log(`--- Test: ${description} ---`);\n+    console.log(`Code: ${code}`);\n+    console.log(`Proj4 String: ${proj4String}`);\n+    \n+    try {\n+        // Clean up any existing definition\n+        if (proj4.defs[code]) {\n+            delete proj4.defs[code];\n+        }\n+        \n+        // Define the projection in proj4\n+        proj4.defs(code, proj4String);\n+        \n+        // Get the proj4 definition for analysis\n+        const def = proj4.defs(code);\n+        const isGeographic = def.projName === 'longlat';\n+        \n+        console.log(`Is Geographic: ${isGeographic}`);\n+        console.log('Original proj4 properties:');\n+        console.log(`  units: ${def.units}`);\n+        console.log(`  axis: ${def.axis}`);\n+        \n+        // Register with OpenLayers\n+        register(proj4);\n+        \n+        // Get the projection\n+        const projection = getProjection(code);\n+        \n+        if (!projection) {\n+            throw new Error('Failed to get projection from OpenLayers');\n+        }\n+        \n+        // Check properties\n+        const units = projection.getUnits();\n+        const axisOrientation = projection.getAxisOrientation();\n+        const metersPerUnit = projection.getMetersPerUnit();\n+        \n+        console.log('After OpenLayers registration:');\n+        console.log(`  units: ${units} (expected: ${expectedUnits})`);\n+        console.log(`  axisOrientation: ${axisOrientation} (expected: ${expectedAxis})`);\n+        console.log(`  metersPerUnit: ${metersPerUnit}`);\n+        \n+        // Verify the fix\n+        const unitsCorrect = units === expectedUnits;\n+        const axisCorrect = axisOrientation === expectedAxis;\n+        const success = unitsCorrect && axisCorrect;\n+        \n+        if (success) {\n+            console.log('\u2705 PASS: Fix works correctly');\n+        } else {\n+            console.log('\u274c FAIL: Issues found:');\n+            if (!unitsCorrect) console.log(`  - Expected units '${expectedUnits}', got '${units}'`);\n+            if (!axisCorrect) console.log(`  - Expected axis '${expectedAxis}', got '${axisOrientation}'`);\n+        }\n+        \n+        return success;\n+        \n+    } catch (error) {\n+        console.log(`\u274c ERROR: ${error.message}`);\n+        return false;\n+    } finally {\n+        console.log('');\n+    }\n+}\n+\n+// Run tests\n+let totalTests = 0;\n+let passedTests = 0;\n+\n+const tests = [\n+    ['EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu', 'EPSG:4258 (Original Issue Example)'],\n+    ['EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu', 'EPSG:4269 (NAD83 Geographic)'],\n+    ['CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'degrees', 'neu', 'Custom Geographic CRS'],\n+    ['EPSG:21781', '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 +k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs', 'm', 'enu', 'EPSG:21781 (Projected - should preserve units)'],\n+    ['TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs', 'degrees', 'neu', 'Geographic with explicit neu axis (should preserve)'],\n+    ['TEST:DEGREES', '+proj=longlat +units=degrees +datum=WGS84 +no_defs', 'degrees', 'neu', 'Geographic with explicit degrees units (should preserve)'],\n+];\n+\n+for (const test of tests) {\n+    totalTests++;\n+    if (testProjection(...test)) {\n+        passedTests++;\n+    }\n+}\n+\n+console.log('=== FINAL RESULTS ===');\n+if (passedTests === totalTests) {\n+    console.log(`\ud83c\udf89 ALL TESTS PASSED (${passedTests}/${totalTests})`);\n+    console.log('\u2705 The fix successfully resolves the proj4 geographic projection issue!');\n+} else {\n+    console.log(`\u274c ${totalTests - passedTests} TESTS FAILED (${passedTests}/${totalTests} passed)`);\n+}\n\\ No newline at end of file\ndiff --git a/test_final_verification.html b/test_final_verification.html\nnew file mode 100644\nindex 000000000..0c902872b\n--- /dev/null\n+++ b/test_final_verification.html\n@@ -0,0 +1,217 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Final Proj4 Geographic Projection Fix Verification</title>\n+    <meta charset=\"utf-8\">\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-section { margin: 20px 0; padding: 15px; border: 1px solid #ccc; }\n+        .test-result { margin: 10px 0; padding: 10px; }\n+        .pass { background-color: #d4edda; border-color: #c3e6cb; color: #155724; }\n+        .fail { background-color: #f8d7da; border-color: #f5c6cb; color: #721c24; }\n+        .map { width: 400px; height: 300px; border: 1px solid #000; margin: 10px 0; }\n+        pre { background: #f5f5f5; padding: 10px; overflow-x: auto; font-size: 12px; }\n+        .summary { font-weight: bold; font-size: 18px; margin: 20px 0; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/proj4@2.6.2/dist/proj4.js\"></script>\n+    <script src=\"./build/index.js\"></script>\n+</head>\n+<body>\n+    <h1>Final Proj4 Geographic Projection Fix Verification</h1>\n+    \n+    <div id=\"summary\" class=\"summary\"></div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: EPSG:4258 (Original Issue Example)</h2>\n+        <div id=\"test1-result\" class=\"test-result\"></div>\n+        <div id=\"map1\" class=\"map\"></div>\n+        <pre id=\"test1-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: EPSG:4269 (NAD83 Geographic)</h2>\n+        <div id=\"test2-result\" class=\"test-result\"></div>\n+        <div id=\"map2\" class=\"map\"></div>\n+        <pre id=\"test2-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 3: Custom Geographic CRS</h2>\n+        <div id=\"test3-result\" class=\"test-result\"></div>\n+        <div id=\"map3\" class=\"map\"></div>\n+        <pre id=\"test3-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 4: EPSG:21781 (Projected - should preserve units)</h2>\n+        <div id=\"test4-result\" class=\"test-result\"></div>\n+        <div id=\"map4\" class=\"map\"></div>\n+        <pre id=\"test4-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 5: Geographic with explicit axis (should preserve)</h2>\n+        <div id=\"test5-result\" class=\"test-result\"></div>\n+        <div id=\"map5\" class=\"map\"></div>\n+        <pre id=\"test5-details\"></pre>\n+    </div>\n+\n+    <script>\n+        let totalTests = 0;\n+        let passedTests = 0;\n+        \n+        function runTest(testNum, code, proj4String, expectedUnits, expectedAxis, description) {\n+            totalTests++;\n+            const resultDiv = document.getElementById(`test${testNum}-result`);\n+            const detailsDiv = document.getElementById(`test${testNum}-details`);\n+            const mapDiv = document.getElementById(`map${testNum}`);\n+            \n+            try {\n+                // Clean up any existing definition\n+                if (proj4.defs[code]) {\n+                    delete proj4.defs[code];\n+                }\n+                \n+                // Define the projection\n+                proj4.defs(code, proj4String);\n+                \n+                // Get proj4 definition for analysis\n+                const def = proj4.defs(code);\n+                const isGeographic = def.projName === 'longlat';\n+                \n+                // Register with OpenLayers\n+                ol.proj.proj4.register(proj4);\n+                \n+                // Get the projection\n+                const projection = ol.proj.get(code);\n+                \n+                if (!projection) {\n+                    throw new Error('Failed to get projection from OpenLayers');\n+                }\n+                \n+                // Check properties\n+                const units = projection.getUnits();\n+                const axisOrientation = projection.getAxisOrientation();\n+                const metersPerUnit = projection.getMetersPerUnit();\n+                \n+                let details = `Description: ${description}\\n`;\n+                details += `Code: ${code}\\n`;\n+                details += `Proj4 String: ${proj4String}\\n`;\n+                details += `Is Geographic: ${isGeographic}\\n\\n`;\n+                details += `Proj4 definition properties:\\n`;\n+                details += `  projName: ${def.projName}\\n`;\n+                details += `  units: ${def.units}\\n`;\n+                details += `  axis: ${def.axis}\\n\\n`;\n+                details += `OpenLayers projection properties:\\n`;\n+                details += `  units: ${units} (expected: ${expectedUnits})\\n`;\n+                details += `  axisOrientation: ${axisOrientation} (expected: ${expectedAxis})\\n`;\n+                details += `  metersPerUnit: ${metersPerUnit}\\n`;\n+                \n+                // Test if units and axis are correct\n+                const unitsCorrect = units === expectedUnits;\n+                const axisCorrect = axisOrientation === expectedAxis;\n+                const success = unitsCorrect && axisCorrect;\n+                \n+                if (success) {\n+                    passedTests++;\n+                    resultDiv.className = 'test-result pass';\n+                    resultDiv.textContent = `\u2713 PASS: Units and axis orientation are correct`;\n+                } else {\n+                    resultDiv.className = 'test-result fail';\n+                    let errors = [];\n+                    if (!unitsCorrect) errors.push(`units (got: ${units}, expected: ${expectedUnits})`);\n+                    if (!axisCorrect) errors.push(`axis (got: ${axisOrientation}, expected: ${expectedAxis})`);\n+                    resultDiv.textContent = `\u2717 FAIL: Incorrect ${errors.join(', ')}`;\n+                }\n+                \n+                detailsDiv.textContent = details;\n+                \n+                // Try to create a map for geographic projections\n+                if (isGeographic) {\n+                    try {\n+                        const map = new ol.Map({\n+                            target: mapDiv,\n+                            layers: [\n+                                new ol.layer.Tile({\n+                                    source: new ol.source.OSM()\n+                                })\n+                            ],\n+                            view: new ol.View({\n+                                projection: projection,\n+                                center: [0, 0],\n+                                zoom: 2\n+                            })\n+                        });\n+                        \n+                        // Add a marker at center\n+                        const marker = new ol.layer.Vector({\n+                            source: new ol.source.Vector({\n+                                features: [\n+                                    new ol.Feature({\n+                                        geometry: new ol.geom.Point([0, 0])\n+                                    })\n+                                ]\n+                            }),\n+                            style: new ol.style.Style({\n+                                image: new ol.style.Circle({\n+                                    radius: 6,\n+                                    fill: new ol.style.Fill({color: 'red'}),\n+                                    stroke: new ol.style.Stroke({color: 'white', width: 2})\n+                                })\n+                            })\n+                        });\n+                        map.addLayer(marker);\n+                        \n+                        details += `\\nMap: Successfully created and rendered`;\n+                        detailsDiv.textContent = details;\n+                        \n+                    } catch (mapError) {\n+                        details += `\\nMap Error: ${mapError.message}`;\n+                        detailsDiv.textContent = details;\n+                        mapDiv.innerHTML = `<div style=\"color: red; padding: 20px;\">Map failed to render: ${mapError.message}</div>`;\n+                    }\n+                } else {\n+                    mapDiv.innerHTML = `<div style=\"color: gray; padding: 20px;\">Non-geographic projection - map test skipped</div>`;\n+                }\n+                \n+            } catch (error) {\n+                resultDiv.className = 'test-result fail';\n+                resultDiv.textContent = `\u2717 ERROR: ${error.message}`;\n+                detailsDiv.textContent = `Error: ${error.message}\\nStack: ${error.stack}`;\n+            }\n+        }\n+        \n+        function updateSummary() {\n+            const summaryDiv = document.getElementById('summary');\n+            if (passedTests === totalTests) {\n+                summaryDiv.className = 'summary pass';\n+                summaryDiv.textContent = `\ud83c\udf89 ALL TESTS PASSED (${passedTests}/${totalTests})`;\n+            } else {\n+                summaryDiv.className = 'summary fail';\n+                summaryDiv.textContent = `\u274c ${totalTests - passedTests} TESTS FAILED (${passedTests}/${totalTests} passed)`;\n+            }\n+        }\n+        \n+        // Run tests when page loads\n+        window.onload = function() {\n+            // Test 1: EPSG:4258 (the original issue example)\n+            runTest(1, 'EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu', 'Original issue example');\n+            \n+            // Test 2: EPSG:4269 (NAD83)\n+            runTest(2, 'EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu', 'NAD83 geographic');\n+            \n+            // Test 3: Custom geographic CRS\n+            runTest(3, 'CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'degrees', 'neu', 'Custom geographic CRS');\n+            \n+            // Test 4: EPSG:21781 (projected - should preserve units)\n+            runTest(4, 'EPSG:21781', '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 +k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs', 'm', 'enu', 'Projected CRS with explicit units');\n+            \n+            // Test 5: Geographic with explicit axis (should preserve)\n+            runTest(5, 'TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs', 'degrees', 'neu', 'Geographic with explicit neu axis');\n+            \n+            // Update summary\n+            setTimeout(updateSummary, 1000);\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 000000000..8c88d2310\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,136 @@\n+// Test script to verify the proj4 geographic projection fix\n+const proj4 = require('proj4');\n+\n+console.log('=== Proj4 Geographic Projection Fix Verification ===\\n');\n+\n+// Mock the OpenLayers modules for testing\n+const Units = {\n+    DEGREES: 'degrees',\n+    METERS: 'm',\n+    FEET: 'ft',\n+    USFEET: 'us-ft'\n+};\n+\n+class MockProjection {\n+    constructor(options) {\n+        this.code_ = options.code;\n+        this.units_ = options.units;\n+        this.axisOrientation_ = options.axisOrientation || 'enu';\n+        this.metersPerUnit_ = options.metersPerUnit;\n+    }\n+    \n+    getCode() { return this.code_; }\n+    getUnits() { return this.units_; }\n+    getAxisOrientation() { return this.axisOrientation_; }\n+    getMetersPerUnit() { return this.metersPerUnit_; }\n+}\n+\n+// Mock the register function with our fix\n+function mockRegister(proj4) {\n+    const projCodes = Object.keys(proj4.defs);\n+    const results = [];\n+    \n+    for (let i = 0; i < projCodes.length; i++) {\n+        const code = projCodes[i];\n+        const def = proj4.defs(code);\n+        \n+        // Apply our fix logic\n+        const isGeographic = def.projName === 'longlat';\n+        const units = def.units || (isGeographic ? Units.DEGREES : undefined);\n+        const axisOrientation = def.axis || (isGeographic ? 'neu' : undefined);\n+        \n+        const projection = new MockProjection({\n+            code: code,\n+            axisOrientation: axisOrientation,\n+            metersPerUnit: def.to_meter,\n+            units: units,\n+        });\n+        \n+        results.push(projection);\n+    }\n+    \n+    return results;\n+}\n+\n+function testProjectionFix(code, proj4String, description) {\n+    console.log(`\\n--- Test: ${description} ---`);\n+    console.log(`Code: ${code}`);\n+    console.log(`Proj4 String: ${proj4String}`);\n+    \n+    try {\n+        // Define the projection in proj4\n+        proj4.defs(code, proj4String);\n+        \n+        // Get the proj4 definition\n+        const def = proj4.defs(code);\n+        const isGeographic = def.projName === 'longlat';\n+        \n+        console.log(`Is Geographic: ${isGeographic}`);\n+        console.log('Original proj4 properties:');\n+        console.log(`  units: ${def.units}`);\n+        console.log(`  axis: ${def.axis}`);\n+        \n+        // Test our fix\n+        const projections = mockRegister(proj4);\n+        const projection = projections[projections.length - 1]; // Get the last one (our test projection)\n+        \n+        console.log('After fix:');\n+        console.log(`  units: ${projection.getUnits()}`);\n+        console.log(`  axisOrientation: ${projection.getAxisOrientation()}`);\n+        \n+        // Verify the fix\n+        let success = true;\n+        const issues = [];\n+        \n+        if (isGeographic) {\n+            if (projection.getUnits() !== 'degrees') {\n+                success = false;\n+                issues.push(`Expected units 'degrees', got '${projection.getUnits()}'`);\n+            }\n+            if (projection.getAxisOrientation() !== 'neu') {\n+                success = false;\n+                issues.push(`Expected axis 'neu', got '${projection.getAxisOrientation()}'`);\n+            }\n+        } else {\n+            // For non-geographic projections, should preserve original values\n+            if (def.units && projection.getUnits() !== def.units) {\n+                success = false;\n+                issues.push(`Expected to preserve units '${def.units}', got '${projection.getUnits()}'`);\n+            }\n+            if (def.axis && projection.getAxisOrientation() !== def.axis) {\n+                success = false;\n+                issues.push(`Expected to preserve axis '${def.axis}', got '${projection.getAxisOrientation()}'`);\n+            }\n+        }\n+        \n+        if (success) {\n+            console.log('\u2705 PASS: Fix works correctly');\n+        } else {\n+            console.log('\u274c FAIL: Issues found:');\n+            issues.forEach(issue => console.log(`  - ${issue}`));\n+        }\n+        \n+    } catch (error) {\n+        console.log(`\u274c Error: ${error.message}`);\n+    }\n+    \n+    // Clean up\n+    delete proj4.defs[code];\n+}\n+\n+// Test cases\n+testProjectionFix('EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4258 (Issue Example)');\n+\n+testProjectionFix('EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4269 (NAD83)');\n+\n+testProjectionFix('CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'Custom Geographic CRS');\n+\n+testProjectionFix('EPSG:21781', '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 +k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs', 'EPSG:21781 (Projected - should preserve units)');\n+\n+testProjectionFix('TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs', 'Geographic with explicit neu axis (should preserve)');\n+\n+testProjectionFix('TEST:DEGREES', '+proj=longlat +units=degrees +datum=WGS84 +no_defs', 'Geographic with explicit degrees units (should preserve)');\n+\n+testProjectionFix('TEST:BOTH', '+proj=longlat +units=degrees +axis=neu +datum=WGS84 +no_defs', 'Geographic with both explicit (should preserve both)');\n+\n+console.log('\\n=== Fix Verification Complete ===');\n\\ No newline at end of file\ndiff --git a/test_geographic_proj4_fix.js b/test_geographic_proj4_fix.js\nnew file mode 100644\nindex 000000000..0c8dbb558\n--- /dev/null\n+++ b/test_geographic_proj4_fix.js\n@@ -0,0 +1,83 @@\n+// Test for the geographic proj4 fix - to be added to the existing test suite\n+// This test verifies that geographic projections get proper defaults for units and axis\n+\n+import Projection from '../../../src/ol/proj/Projection.js';\n+import Units from '../../../src/ol/proj/Units.js';\n+import {\n+  clearAllProjections,\n+  addCommon,\n+  get as getProjection,\n+} from '../../../src/ol/proj.js';\n+import {register} from '../../../src/ol/proj/proj4.js';\n+\n+describe('Proj4js geographic projection fix', function () {\n+  afterEach(function () {\n+    // Clean up test projections\n+    delete proj4.defs['EPSG:4258'];\n+    delete proj4.defs['EPSG:4269'];\n+    delete proj4.defs['CUSTOM:GEO'];\n+    delete proj4.defs['TEST:NEU'];\n+    delete proj4.defs['TEST:DEGREES'];\n+    clearAllProjections();\n+    addCommon();\n+  });\n+\n+  it('defaults to degrees units for geographic projections without units', function () {\n+    proj4.defs('EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs');\n+    register(proj4);\n+    const proj = getProjection('EPSG:4258');\n+    expect(proj.getCode()).to.eql('EPSG:4258');\n+    expect(proj.getUnits()).to.eql(Units.DEGREES);\n+  });\n+\n+  it('defaults to neu axis orientation for geographic projections without axis', function () {\n+    proj4.defs('EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs');\n+    register(proj4);\n+    const proj = getProjection('EPSG:4269');\n+    expect(proj.getCode()).to.eql('EPSG:4269');\n+    expect(proj.getAxisOrientation()).to.eql('neu');\n+  });\n+\n+  it('applies both defaults for geographic projections without units or axis', function () {\n+    proj4.defs('CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs');\n+    register(proj4);\n+    const proj = getProjection('CUSTOM:GEO');\n+    expect(proj.getCode()).to.eql('CUSTOM:GEO');\n+    expect(proj.getUnits()).to.eql(Units.DEGREES);\n+    expect(proj.getAxisOrientation()).to.eql('neu');\n+  });\n+\n+  it('preserves explicit axis orientation for geographic projections', function () {\n+    proj4.defs('TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs');\n+    register(proj4);\n+    const proj = getProjection('TEST:NEU');\n+    expect(proj.getCode()).to.eql('TEST:NEU');\n+    expect(proj.getUnits()).to.eql(Units.DEGREES); // Should still default units\n+    expect(proj.getAxisOrientation()).to.eql('neu'); // Should preserve explicit axis\n+  });\n+\n+  it('preserves explicit units for geographic projections', function () {\n+    proj4.defs('TEST:DEGREES', '+proj=longlat +units=degrees +datum=WGS84 +no_defs');\n+    register(proj4);\n+    const proj = getProjection('TEST:DEGREES');\n+    expect(proj.getCode()).to.eql('TEST:DEGREES');\n+    expect(proj.getUnits()).to.eql(Units.DEGREES); // Should preserve explicit units\n+    expect(proj.getAxisOrientation()).to.eql('neu'); // Should still default axis\n+  });\n+\n+  it('does not affect non-geographic projections', function () {\n+    proj4.defs(\n+      'EPSG:21781',\n+      '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 ' +\n+        '+k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel ' +\n+        '+towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs'\n+    );\n+    register(proj4);\n+    const proj = getProjection('EPSG:21781');\n+    expect(proj.getCode()).to.eql('EPSG:21781');\n+    expect(proj.getUnits()).to.eql('m'); // Should preserve explicit units\n+    expect(proj.getAxisOrientation()).to.eql('enu'); // Should use default for non-geographic\n+    \n+    delete proj4.defs['EPSG:21781'];\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_proj4_issue.html b/test_proj4_issue.html\nnew file mode 100644\nindex 000000000..10137c97e\n--- /dev/null\n+++ b/test_proj4_issue.html\n@@ -0,0 +1,157 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Proj4 Geographic Projection Issue Test</title>\n+    <meta charset=\"utf-8\">\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-section { margin: 20px 0; padding: 15px; border: 1px solid #ccc; }\n+        .test-result { margin: 10px 0; padding: 10px; }\n+        .pass { background-color: #d4edda; border-color: #c3e6cb; color: #155724; }\n+        .fail { background-color: #f8d7da; border-color: #f5c6cb; color: #721c24; }\n+        .map { width: 400px; height: 300px; border: 1px solid #000; margin: 10px 0; }\n+        pre { background: #f5f5f5; padding: 10px; overflow-x: auto; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"./build/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdn.jsdelivr.net/npm/proj4@2.6.2/dist/proj4.js\"></script>\n+    <script src=\"./build/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Proj4 Geographic Projection Issue Test</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: EPSG:4258 (Issue Example)</h2>\n+        <div id=\"test1-result\" class=\"test-result\"></div>\n+        <div id=\"map1\" class=\"map\"></div>\n+        <pre id=\"test1-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: EPSG:4269 (NAD83)</h2>\n+        <div id=\"test2-result\" class=\"test-result\"></div>\n+        <div id=\"map2\" class=\"map\"></div>\n+        <pre id=\"test2-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 3: EPSG:4326 (Comparison - should work)</h2>\n+        <div id=\"test3-result\" class=\"test-result\"></div>\n+        <div id=\"map3\" class=\"map\"></div>\n+        <pre id=\"test3-details\"></pre>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 4: Custom Geographic CRS without units</h2>\n+        <div id=\"test4-result\" class=\"test-result\"></div>\n+        <div id=\"map4\" class=\"map\"></div>\n+        <pre id=\"test4-details\"></pre>\n+    </div>\n+\n+    <script>\n+        function runTest(testNum, code, proj4String, expectedUnits, expectedAxis) {\n+            const resultDiv = document.getElementById(`test${testNum}-result`);\n+            const detailsDiv = document.getElementById(`test${testNum}-details`);\n+            const mapDiv = document.getElementById(`map${testNum}`);\n+            \n+            try {\n+                // Define the projection\n+                proj4.defs(code, proj4String);\n+                ol.proj.proj4.register(proj4);\n+                \n+                // Get the projection\n+                const projection = ol.proj.get(code);\n+                \n+                // Check properties\n+                const units = projection.getUnits();\n+                const axisOrientation = projection.getAxisOrientation();\n+                const metersPerUnit = projection.getMetersPerUnit();\n+                \n+                let details = `Code: ${code}\\n`;\n+                details += `Proj4 String: ${proj4String}\\n`;\n+                details += `Units: ${units} (expected: ${expectedUnits})\\n`;\n+                details += `Axis Orientation: ${axisOrientation} (expected: ${expectedAxis})\\n`;\n+                details += `Meters Per Unit: ${metersPerUnit}\\n`;\n+                \n+                // Test if units and axis are correct\n+                const unitsCorrect = units === expectedUnits;\n+                const axisCorrect = axisOrientation === expectedAxis;\n+                const success = unitsCorrect && axisCorrect;\n+                \n+                if (success) {\n+                    resultDiv.className = 'test-result pass';\n+                    resultDiv.textContent = `\u2713 PASS: Units and axis orientation are correct`;\n+                } else {\n+                    resultDiv.className = 'test-result fail';\n+                    let errors = [];\n+                    if (!unitsCorrect) errors.push(`units (got: ${units}, expected: ${expectedUnits})`);\n+                    if (!axisCorrect) errors.push(`axis (got: ${axisOrientation}, expected: ${expectedAxis})`);\n+                    resultDiv.textContent = `\u2717 FAIL: Incorrect ${errors.join(', ')}`;\n+                }\n+                \n+                detailsDiv.textContent = details;\n+                \n+                // Try to create a map\n+                try {\n+                    const map = new ol.Map({\n+                        target: mapDiv,\n+                        layers: [\n+                            new ol.layer.Tile({\n+                                source: new ol.source.OSM()\n+                            })\n+                        ],\n+                        view: new ol.View({\n+                            projection: projection,\n+                            center: [0, 0],\n+                            zoom: 2\n+                        })\n+                    });\n+                    \n+                    // Add a marker at center\n+                    const marker = new ol.layer.Vector({\n+                        source: new ol.source.Vector({\n+                            features: [\n+                                new ol.Feature({\n+                                    geometry: new ol.geom.Point([0, 0])\n+                                })\n+                            ]\n+                        }),\n+                        style: new ol.style.Style({\n+                            image: new ol.style.Circle({\n+                                radius: 6,\n+                                fill: new ol.style.Fill({color: 'red'}),\n+                                stroke: new ol.style.Stroke({color: 'white', width: 2})\n+                            })\n+                        })\n+                    });\n+                    map.addLayer(marker);\n+                    \n+                } catch (mapError) {\n+                    details += `\\nMap Error: ${mapError.message}`;\n+                    detailsDiv.textContent = details;\n+                    mapDiv.innerHTML = `<div style=\"color: red; padding: 20px;\">Map failed to render: ${mapError.message}</div>`;\n+                }\n+                \n+            } catch (error) {\n+                resultDiv.className = 'test-result fail';\n+                resultDiv.textContent = `\u2717 ERROR: ${error.message}`;\n+                detailsDiv.textContent = `Error: ${error.message}\\nStack: ${error.stack}`;\n+            }\n+        }\n+        \n+        // Run tests when page loads\n+        window.onload = function() {\n+            // Test 1: EPSG:4258 (the issue example)\n+            runTest(1, 'EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu');\n+            \n+            // Test 2: EPSG:4269 (NAD83)\n+            runTest(2, 'EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'degrees', 'neu');\n+            \n+            // Test 3: EPSG:4326 (should work as reference)\n+            runTest(3, 'EPSG:4326', '+proj=longlat +datum=WGS84 +no_defs', 'degrees', 'neu');\n+            \n+            // Test 4: Custom geographic CRS\n+            runTest(4, 'CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'degrees', 'neu');\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_proj4_issue.js b/test_proj4_issue.js\nnew file mode 100644\nindex 000000000..a7ccc0dfe\n--- /dev/null\n+++ b/test_proj4_issue.js\n@@ -0,0 +1,84 @@\n+// Test script to reproduce the proj4 geographic projection issue\n+const proj4 = require('proj4');\n+\n+// Import OpenLayers modules\n+const Projection = require('./build/ol/proj/Projection.js').default;\n+const Units = require('./build/ol/proj/Units.js').default;\n+const { register } = require('./build/ol/proj/proj4.js');\n+const { get: getProjection, addProjection } = require('./build/ol/proj.js');\n+\n+console.log('=== Proj4 Geographic Projection Issue Test ===\\n');\n+\n+function testProjection(code, proj4String, description) {\n+    console.log(`\\n--- Test: ${description} ---`);\n+    console.log(`Code: ${code}`);\n+    console.log(`Proj4 String: ${proj4String}`);\n+    \n+    try {\n+        // Define the projection in proj4\n+        proj4.defs(code, proj4String);\n+        \n+        // Get the proj4 definition to see what properties are available\n+        const def = proj4.defs(code);\n+        console.log('Proj4 definition properties:');\n+        console.log(`  proj: ${def.proj}`);\n+        console.log(`  units: ${def.units}`);\n+        console.log(`  axis: ${def.axis}`);\n+        console.log(`  to_meter: ${def.to_meter}`);\n+        \n+        // Register with OpenLayers\n+        register(proj4);\n+        \n+        // Get the OpenLayers projection\n+        const projection = getProjection(code);\n+        \n+        if (projection) {\n+            console.log('OpenLayers projection properties:');\n+            console.log(`  units: ${projection.getUnits()}`);\n+            console.log(`  axisOrientation: ${projection.getAxisOrientation()}`);\n+            console.log(`  metersPerUnit: ${projection.getMetersPerUnit()}`);\n+            \n+            // Check if this is a geographic projection\n+            const isGeographic = def.proj === 'longlat';\n+            console.log(`  isGeographic: ${isGeographic}`);\n+            \n+            // Check for issues\n+            const issues = [];\n+            if (isGeographic && projection.getUnits() === undefined) {\n+                issues.push('Units should be \"degrees\" for geographic projections but is undefined');\n+            }\n+            if (isGeographic && projection.getAxisOrientation() === 'enu') {\n+                issues.push('Axis orientation should be \"neu\" for geographic projections but is \"enu\"');\n+            }\n+            \n+            if (issues.length > 0) {\n+                console.log('ISSUES FOUND:');\n+                issues.forEach(issue => console.log(`  \u274c ${issue}`));\n+            } else {\n+                console.log('\u2705 No issues found');\n+            }\n+        } else {\n+            console.log('\u274c Failed to get OpenLayers projection');\n+        }\n+        \n+    } catch (error) {\n+        console.log(`\u274c Error: ${error.message}`);\n+    }\n+    \n+    // Clean up\n+    delete proj4.defs[code];\n+}\n+\n+// Test cases\n+testProjection('EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4258 (Issue Example)');\n+\n+testProjection('EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4269 (NAD83)');\n+\n+testProjection('CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'Custom Geographic CRS');\n+\n+testProjection('EPSG:21781', '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 +k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs', 'EPSG:21781 (Projected - should work)');\n+\n+// Test with explicit axis\n+testProjection('TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs', 'Geographic with explicit neu axis');\n+\n+console.log('\\n=== Test Complete ===');\n\\ No newline at end of file\ndiff --git a/test_proj4_issue_simple.js b/test_proj4_issue_simple.js\nnew file mode 100644\nindex 000000000..186f1ff2a\n--- /dev/null\n+++ b/test_proj4_issue_simple.js\n@@ -0,0 +1,51 @@\n+// Simple test to understand proj4 definitions\n+const proj4 = require('proj4');\n+\n+console.log('=== Proj4 Definition Analysis ===\\n');\n+\n+function analyzeProj4Definition(code, proj4String, description) {\n+    console.log(`--- ${description} ---`);\n+    console.log(`Code: ${code}`);\n+    console.log(`Proj4 String: ${proj4String}`);\n+    \n+    // Define the projection in proj4\n+    proj4.defs(code, proj4String);\n+    \n+    // Get the proj4 definition to see what properties are available\n+    const def = proj4.defs(code);\n+    console.log('Proj4 definition object:');\n+    console.log(JSON.stringify(def, null, 2));\n+    \n+    // Check if this is a geographic projection\n+    const isGeographic = def.projName === 'longlat';\n+    console.log(`Is Geographic (longlat): ${isGeographic}`);\n+    \n+    if (isGeographic) {\n+        console.log('Expected for geographic projections:');\n+        console.log('  - units should default to \"degrees\"');\n+        console.log('  - axis should default to \"neu\"');\n+        console.log('Current values:');\n+        console.log(`  - units: ${def.units} (${def.units === undefined ? 'UNDEFINED - ISSUE!' : 'OK'})`);\n+        console.log(`  - axis: ${def.axis} (${def.axis === undefined ? 'UNDEFINED - will default to enu - ISSUE!' : 'OK'})`);\n+    }\n+    \n+    console.log('');\n+    \n+    // Clean up\n+    delete proj4.defs[code];\n+}\n+\n+// Test cases\n+analyzeProj4Definition('EPSG:4258', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4258 (Issue Example)');\n+\n+analyzeProj4Definition('EPSG:4269', '+proj=longlat +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +no_defs', 'EPSG:4269 (NAD83)');\n+\n+analyzeProj4Definition('CUSTOM:GEO', '+proj=longlat +datum=WGS84 +no_defs', 'Custom Geographic CRS');\n+\n+analyzeProj4Definition('EPSG:21781', '+proj=somerc +lat_0=46.95240555555556 +lon_0=7.439583333333333 +k_0=1 +x_0=600000 +y_0=200000 +ellps=bessel +towgs84=674.374,15.056,405.346,0,0,0,0 +units=m +no_defs', 'EPSG:21781 (Projected - should work)');\n+\n+analyzeProj4Definition('TEST:NEU', '+proj=longlat +axis=neu +datum=WGS84 +no_defs', 'Geographic with explicit neu axis');\n+\n+analyzeProj4Definition('TEST:DEGREES', '+proj=longlat +units=degrees +datum=WGS84 +no_defs', 'Geographic with explicit degrees units');\n+\n+console.log('=== Analysis Complete ===');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

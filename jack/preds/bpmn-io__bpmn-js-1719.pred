{"instance_id": "bpmn-io__bpmn-js-1719", "model_patch": "diff --git a/lib/features/modeling/behavior/ToggleElementCollapseBehaviour.js b/lib/features/modeling/behavior/ToggleElementCollapseBehaviour.js\nindex 55f259fb..34db7129 100644\n--- a/lib/features/modeling/behavior/ToggleElementCollapseBehaviour.js\n+++ b/lib/features/modeling/behavior/ToggleElementCollapseBehaviour.js\n@@ -22,10 +22,10 @@ export default function ToggleElementCollapseBehaviour(\n   CommandInterceptor.call(this, eventBus);\n \n \n-  function hideEmptyLabels(children) {\n+  function hideLabels(children) {\n     if (children.length) {\n       children.forEach(function(child) {\n-        if (child.type === 'label' && !child.businessObject.name) {\n+        if (child.type === 'label') {\n           child.hidden = true;\n         }\n       });\n@@ -81,8 +81,8 @@ export default function ToggleElementCollapseBehaviour(\n \n     if (!shape.collapsed) {\n \n-      // all children got made visible through djs, hide empty labels\n-      hideEmptyLabels(shape.children);\n+      // all children got made visible through djs, hide all labels when collapsed\n+      hideLabels(shape.children);\n \n       // remove collapsed marker\n       getDi(shape).isExpanded = true;\ndiff --git a/test_label_visibility_issue.js b/test_label_visibility_issue.js\nnew file mode 100644\nindex 00000000..1858bcab\n--- /dev/null\n+++ b/test_label_visibility_issue.js\n@@ -0,0 +1,158 @@\n+/**\n+ * Test to reproduce the label visibility issue when collapsing sub processes\n+ * This test reproduces the exact steps mentioned in the issue description\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+var testModules = [\n+  modelingModule,\n+  coreModule\n+];\n+\n+describe('Label Visibility Issue - Sub Process Collapse', function() {\n+\n+  // Simple BPMN with expanded subprocess containing labeled elements\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                   xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                   xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                   xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                   xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                   id=\"test\" targetNamespace=\"http://test\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Test SubProcess\">\n+      <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start Label\">\n+        <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+      </bpmn2:startEvent>\n+      <bpmn2:task id=\"Task_1\" name=\"Task Label\">\n+        <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+        <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+      </bpmn2:task>\n+      <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Label\">\n+        <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+      </bpmn2:endEvent>\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    </bpmn2:subProcess>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"250\" y=\"180\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"240\" y=\"220\" width=\"56\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"158\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"520\" y=\"180\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"515\" y=\"220\" width=\"46\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"286\" y=\"198\" />\n+        <di:waypoint x=\"350\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"450\" y=\"198\" />\n+        <di:waypoint x=\"520\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should hide ALL labels when sub process is collapsed', \n+    inject(function(elementRegistry, bpmnReplace) {\n+\n+      // given - expanded subprocess with labeled elements\n+      var expandedSubProcess = elementRegistry.get('SubProcess_1');\n+      var startEventLabel = elementRegistry.get('StartEvent_1_label');\n+      var taskLabel = elementRegistry.get('Task_1_label'); \n+      var endEventLabel = elementRegistry.get('EndEvent_1_label');\n+\n+      // verify initial state - labels should be visible in expanded state\n+      expect(expandedSubProcess.collapsed).to.be.false;\n+      \n+      // Find labels in children\n+      var labels = expandedSubProcess.children.filter(function(child) {\n+        return child.type === 'label';\n+      });\n+      \n+      console.log('Labels found:', labels.length);\n+      labels.forEach(function(label) {\n+        console.log('Label:', label.id, 'businessObject.name:', label.businessObject.name, 'hidden:', label.hidden);\n+        expect(label.hidden).to.be.false; // Labels should be visible initially\n+      });\n+\n+      // when - collapse the subprocess\n+      var collapsedSubProcess = bpmnReplace.replaceElement(expandedSubProcess, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: false\n+      });\n+\n+      // then - ALL labels should be hidden (this is the bug - they remain visible)\n+      var labelsAfterCollapse = collapsedSubProcess.children.filter(function(child) {\n+        return child.type === 'label';\n+      });\n+      \n+      console.log('Labels after collapse:', labelsAfterCollapse.length);\n+      labelsAfterCollapse.forEach(function(label) {\n+        console.log('Label after collapse:', label.id, 'businessObject.name:', label.businessObject.name, 'hidden:', label.hidden);\n+        // This assertion should pass after the fix\n+        expect(label.hidden).to.be.true; // ALL labels should be hidden when collapsed\n+      });\n+    })\n+  );\n+\n+  it('should show labels again when sub process is expanded', \n+    inject(function(elementRegistry, bpmnReplace) {\n+\n+      // given - start with expanded, then collapse\n+      var expandedSubProcess = elementRegistry.get('SubProcess_1');\n+      var collapsedSubProcess = bpmnReplace.replaceElement(expandedSubProcess, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: false\n+      });\n+\n+      // when - expand again\n+      var reExpandedSubProcess = bpmnReplace.replaceElement(collapsedSubProcess, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: true\n+      });\n+\n+      // then - labels with names should be visible again\n+      var labelsAfterExpand = reExpandedSubProcess.children.filter(function(child) {\n+        return child.type === 'label';\n+      });\n+      \n+      labelsAfterExpand.forEach(function(label) {\n+        if (label.businessObject.name) {\n+          // Labels with names should be visible when expanded\n+          expect(label.hidden).to.be.false;\n+        } else {\n+          // Empty labels should remain hidden\n+          expect(label.hidden).to.be.true;\n+        }\n+      });\n+    })\n+  );\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_visual_verification.html b/test_visual_verification.html\nnew file mode 100644\nindex 00000000..67fed387\n--- /dev/null\n+++ b/test_visual_verification.html\n@@ -0,0 +1,164 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js Label Visibility Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; }\n+    .controls { margin: 10px 0; }\n+    button { margin: 5px; padding: 10px; }\n+    .info { background: #f0f0f0; padding: 10px; margin: 10px 0; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN.js Label Visibility Test</h1>\n+  <div class=\"info\">\n+    <p><strong>Test:</strong> This test verifies that labels inside sub processes are hidden when collapsed.</p>\n+    <p><strong>Steps:</strong></p>\n+    <ol>\n+      <li>Load the diagram with an expanded sub process containing labeled elements</li>\n+      <li>Click \"Collapse SubProcess\" to collapse it</li>\n+      <li>Verify that all labels inside are hidden (this was the bug)</li>\n+      <li>Click \"Expand SubProcess\" to expand it again</li>\n+      <li>Verify that labels with names are visible again</li>\n+    </ol>\n+  </div>\n+  \n+  <div class=\"controls\">\n+    <button id=\"collapseBtn\">Collapse SubProcess</button>\n+    <button id=\"expandBtn\">Expand SubProcess</button>\n+    <button id=\"inspectBtn\">Inspect Labels</button>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <div id=\"output\"></div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    // BPMN XML with expanded subprocess containing labeled elements\n+    var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                   xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                   xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                   xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                   xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                   id=\"test\" targetNamespace=\"http://test\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Test SubProcess\">\n+      <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start Label\">\n+        <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+      </bpmn2:startEvent>\n+      <bpmn2:task id=\"Task_1\" name=\"Task Label\">\n+        <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+        <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+      </bpmn2:task>\n+      <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Label\">\n+        <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+      </bpmn2:endEvent>\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    </bpmn2:subProcess>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"250\" y=\"180\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"240\" y=\"220\" width=\"56\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"158\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"520\" y=\"180\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"515\" y=\"220\" width=\"46\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"286\" y=\"198\" />\n+        <di:waypoint x=\"350\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"450\" y=\"198\" />\n+        <di:waypoint x=\"520\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    function log(message) {\n+      document.getElementById('output').innerHTML += '<p>' + message + '</p>';\n+    }\n+\n+    function inspectLabels() {\n+      var elementRegistry = modeler.get('elementRegistry');\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      \n+      log('<strong>Inspecting labels in SubProcess_1:</strong>');\n+      log('SubProcess collapsed: ' + !!subProcess.collapsed);\n+      \n+      var labels = subProcess.children.filter(function(child) {\n+        return child.type === 'label';\n+      });\n+      \n+      log('Found ' + labels.length + ' labels:');\n+      labels.forEach(function(label) {\n+        log('- Label ID: ' + label.id + ', Name: \"' + (label.businessObject.name || 'empty') + '\", Hidden: ' + !!label.hidden);\n+      });\n+      log('---');\n+    }\n+\n+    modeler.importXML(bpmnXML).then(function() {\n+      log('Diagram loaded successfully');\n+      inspectLabels();\n+    }).catch(function(err) {\n+      log('Error loading diagram: ' + err.message);\n+    });\n+\n+    document.getElementById('collapseBtn').addEventListener('click', function() {\n+      var bpmnReplace = modeler.get('bpmnReplace');\n+      var elementRegistry = modeler.get('elementRegistry');\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      \n+      log('Collapsing SubProcess...');\n+      bpmnReplace.replaceElement(subProcess, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: false\n+      });\n+      \n+      setTimeout(function() {\n+        inspectLabels();\n+      }, 100);\n+    });\n+\n+    document.getElementById('expandBtn').addEventListener('click', function() {\n+      var bpmnReplace = modeler.get('bpmnReplace');\n+      var elementRegistry = modeler.get('elementRegistry');\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      \n+      log('Expanding SubProcess...');\n+      bpmnReplace.replaceElement(subProcess, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: true\n+      });\n+      \n+      setTimeout(function() {\n+        inspectLabels();\n+      }, 100);\n+    });\n+\n+    document.getElementById('inspectBtn').addEventListener('click', inspectLabels);\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

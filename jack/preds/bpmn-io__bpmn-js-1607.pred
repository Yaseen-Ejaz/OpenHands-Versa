{"instance_id": "bpmn-io__bpmn-js-1607", "model_patch": "diff --git a/lib/features/modeling/behavior/GroupBehavior.js b/lib/features/modeling/behavior/GroupBehavior.js\nindex 2cba2453..86d137f5 100644\n--- a/lib/features/modeling/behavior/GroupBehavior.js\n+++ b/lib/features/modeling/behavior/GroupBehavior.js\n@@ -33,7 +33,7 @@ export default function GroupBehavior(\n   injector.invoke(CommandInterceptor, this);\n \n   /**\n-   * Gets process definitions\n+   * Gets root definitions by traversing up the business object hierarchy\n    *\n    * @return {ModdleElement} definitions\n    */\n@@ -41,7 +41,12 @@ export default function GroupBehavior(\n     var rootElement = canvas.getRootElement(),\n         businessObject = getBusinessObject(rootElement);\n \n-    return businessObject.$parent;\n+    // traverse up the hierarchy to find the root definitions\n+    while (businessObject && !is(businessObject, 'bpmn:Definitions')) {\n+      businessObject = businessObject.$parent;\n+    }\n+\n+    return businessObject;\n   }\n \n   /**\ndiff --git a/test/spec/features/modeling/GroupInSubProcess.bpmn b/test/spec/features/modeling/GroupInSubProcess.bpmn\nnew file mode 100644\nindex 00000000..5b6c3c9c\n--- /dev/null\n+++ b/test/spec/features/modeling/GroupInSubProcess.bpmn\n@@ -0,0 +1,34 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xsi:schemaLocation=\"http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd\" id=\"test-definitions\" targetNamespace=\"http://bpmn.io/test\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\"/>\n+    <bpmn2:subProcess id=\"SubProcess_1\">\n+      <bpmn2:startEvent id=\"StartEvent_2\"/>\n+      <bpmn2:task id=\"Task_1\"/>\n+      <bpmn2:endEvent id=\"EndEvent_1\"/>\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_2\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\">\n+        <dc:Bounds x=\"200\" y=\"80\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_2_di\" bpmnElement=\"EndEvent_2\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"220\" y=\"120\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"300\" y=\"120\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"450\" y=\"140\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/modeling/GroupInSubProcessSpec.js b/test/spec/features/modeling/GroupInSubProcessSpec.js\nnew file mode 100644\nindex 00000000..28409b75\n--- /dev/null\n+++ b/test/spec/features/modeling/GroupInSubProcessSpec.js\n@@ -0,0 +1,132 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  is,\n+  getBusinessObject\n+} from 'lib/util/ModelUtil';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('features/modeling - Group in SubProcess', function() {\n+\n+  var testModules = [ coreModule, modelingModule ];\n+\n+  describe('should handle groups in collapsed sub-processes', function() {\n+\n+    var processDiagramXML = require('./GroupInSubProcess.bpmn');\n+\n+    beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+    it('should create group in collapsed sub-process', inject(function(elementFactory, modeling, canvas, elementRegistry) {\n+\n+      // given\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      var subProcessRoot = canvas.findRoot(subProcess);\n+\n+      // navigate to sub-process\n+      canvas.setRootElement(subProcessRoot);\n+\n+      // when\n+      var groupShape = elementFactory.createShape({\n+        type: 'bpmn:Group'\n+      });\n+\n+      modeling.createShape(groupShape, { x: 300, y: 200 }, subProcessRoot);\n+\n+      // then\n+      expect(groupShape).to.exist;\n+      expect(is(groupShape, 'bpmn:Group')).to.be.true;\n+\n+      var businessObject = getBusinessObject(groupShape);\n+      expect(businessObject.categoryValueRef).to.exist;\n+\n+      // verify CategoryValue is created\n+      var categoryValue = businessObject.categoryValueRef;\n+      expect(categoryValue).to.exist;\n+      expect(categoryValue.$parent).to.exist;\n+      expect(is(categoryValue.$parent, 'bpmn:Category')).to.be.true;\n+    }));\n+\n+    it('should export and re-import without unresolved references', inject(function(elementFactory, modeling, canvas, elementRegistry) {\n+\n+      // given\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      var subProcessRoot = canvas.findRoot(subProcess);\n+\n+      // navigate to sub-process\n+      canvas.setRootElement(subProcessRoot);\n+\n+      // create group in sub-process\n+      var groupShape = elementFactory.createShape({\n+        type: 'bpmn:Group'\n+      });\n+\n+      modeling.createShape(groupShape, { x: 300, y: 200 }, subProcessRoot);\n+\n+      // when - export the diagram\n+      return new Promise(function(resolve, reject) {\n+        inject(function(moddle) {\n+          var rootElement = canvas.getRootElement();\n+          var businessObject = getBusinessObject(rootElement);\n+          var definitions = businessObject.$parent;\n+\n+          moddle.toXML(definitions, function(err, xml) {\n+            if (err) {\n+              return reject(err);\n+            }\n+\n+            // then - re-import and check for warnings\n+            moddle.fromXML(xml, function(err, result) {\n+              if (err) {\n+                return reject(err);\n+              }\n+\n+              // verify no unresolved references\n+              expect(result.warnings).to.be.empty;\n+              resolve();\n+            });\n+          });\n+        })();\n+      });\n+    }));\n+\n+    it('should place CategoryValue in root definitions', inject(function(elementFactory, modeling, canvas, elementRegistry) {\n+\n+      // given\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      var subProcessRoot = canvas.findRoot(subProcess);\n+\n+      // navigate to sub-process\n+      canvas.setRootElement(subProcessRoot);\n+\n+      // when\n+      var groupShape = elementFactory.createShape({\n+        type: 'bpmn:Group'\n+      });\n+\n+      modeling.createShape(groupShape, { x: 300, y: 200 }, subProcessRoot);\n+\n+      // then\n+      var businessObject = getBusinessObject(groupShape);\n+      var categoryValue = businessObject.categoryValueRef;\n+      var category = categoryValue.$parent;\n+\n+      // verify category is in root definitions, not sub-process\n+      var rootElement = canvas.getRootElement();\n+      var rootBusinessObject = getBusinessObject(rootElement);\n+      var definitions = rootBusinessObject.$parent;\n+\n+      expect(definitions.rootElements).to.include(category);\n+\n+      // verify category is not in sub-process\n+      var subProcessBusinessObject = getBusinessObject(subProcess);\n+      expect(subProcessBusinessObject.flowElements || []).not.to.include(category);\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

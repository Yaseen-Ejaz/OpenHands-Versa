tegy.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/featureloader.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/layer/BaseVector.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/renderer/canvas/VectorLayer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Fill.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Circle.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Stroke.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/geom/flat/interpolate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/BuilderGroup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/ImageState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/geom/flat/center.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/renderer/canvas/Layer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/hitdetect.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/RegularShape.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/ExecutorGroup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/renderer/vector.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/Builder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/ImageBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/LineStringBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/TextBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/PolygonBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/IconAnchorUnits.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/Immediate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/BuilderType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/colorlike.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/TextPlacement.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Icon.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/Text.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:35:20] \"GET /src/ol/style/IconOrigin.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 05:36:07] \"GET /test_webgl_context_simple.html HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/webgl/Layer.js b/src/ol/renderer/webgl/Layer.js\nindex d3de5d205..6aff099db 100644\n--- a/src/ol/renderer/webgl/Layer.js\n+++ b/src/ol/renderer/webgl/Layer.js\n@@ -5,6 +5,7 @@ import LayerRenderer from '../Layer.js';\n import RenderEvent from '../../render/Event.js';\n import RenderEventType from '../../render/EventType.js';\n import WebGLHelper from '../../webgl/Helper.js';\n+import SharedWebGLHelper from '../../webgl/SharedHelper.js';\n import {\n   compose as composeTransform,\n   create as createTransform,\n@@ -100,12 +101,35 @@ class WebGLLayerRenderer extends LayerRenderer {\n    */\n   prepareFrame(frameState) {\n     if (!this.helper && !!this.getLayer().getSource()) {\n-      this.helper = new WebGLHelper({\n-        postProcesses: this.postProcesses_,\n-        uniforms: this.uniforms_,\n-      });\n+      // Try to get the map instance for context sharing\n+      const layer = this.getLayer();\n+      const map = layer.getMapInternal ? layer.getMapInternal() : null;\n+      \n+      if (map) {\n+        // Use shared WebGL context when map is available\n+        try {\n+          this.helper = new SharedWebGLHelper({\n+            map: map,\n+            postProcesses: this.postProcesses_,\n+            uniforms: this.uniforms_,\n+          });\n+        } catch (error) {\n+          // Fall back to regular WebGL helper if shared context fails\n+          console.warn('Failed to create shared WebGL context, falling back to individual context:', error);\n+          this.helper = new WebGLHelper({\n+            postProcesses: this.postProcesses_,\n+            uniforms: this.uniforms_,\n+          });\n+        }\n+      } else {\n+        // Fall back to regular WebGL helper if no map available\n+        this.helper = new WebGLHelper({\n+          postProcesses: this.postProcesses_,\n+          uniforms: this.uniforms_,\n+        });\n+      }\n \n-      const className = this.getLayer().getClassName();\n+      const className = layer.getClassName();\n       if (className) {\n         this.helper.getCanvas().className = className;\n       }\ndiff --git a/src/ol/webgl/ContextManager.js b/src/ol/webgl/ContextManager.js\nnew file mode 100644\nindex 000000000..8b88f2f86\n--- /dev/null\n+++ b/src/ol/webgl/ContextManager.js\n@@ -0,0 +1,96 @@\n+/**\n+ * @module ol/webgl/ContextManager\n+ */\n+import {getContext} from '../webgl.js';\n+import {getUid} from '../util.js';\n+\n+/**\n+ * @typedef {Object} SharedContext\n+ * @property {HTMLCanvasElement} canvas The canvas element.\n+ * @property {WebGLRenderingContext} gl The WebGL context.\n+ * @property {number} refCount Reference count for cleanup.\n+ */\n+\n+/**\n+ * @classdesc\n+ * Manages shared WebGL contexts for OpenLayers maps to reduce the number\n+ * of WebGL contexts created, helping to stay within browser limits.\n+ */\n+class WebGLContextManager {\n+  constructor() {\n+    /**\n+     * @type {Object<string, SharedContext>}\n+     * @private\n+     */\n+    this.contexts_ = {};\n+  }\n+\n+  /**\n+   * Get or create a shared WebGL context for a map.\n+   * @param {import(\"../PluggableMap.js\").default} map The map instance.\n+   * @return {SharedContext} The shared context.\n+   */\n+  getSharedContext(map) {\n+    const mapId = getUid(map);\n+    \n+    if (!this.contexts_[mapId]) {\n+      const canvas = document.createElement('canvas');\n+      canvas.style.position = 'absolute';\n+      canvas.style.left = '0';\n+      \n+      const gl = getContext(canvas);\n+      if (!gl) {\n+        throw new Error('Failed to create WebGL context');\n+      }\n+      \n+      this.contexts_[mapId] = {\n+        canvas: canvas,\n+        gl: gl,\n+        refCount: 0\n+      };\n+    }\n+    \n+    this.contexts_[mapId].refCount++;\n+    return this.contexts_[mapId];\n+  }\n+\n+  /**\n+   * Release a reference to a shared WebGL context.\n+   * @param {import(\"../PluggableMap.js\").default} map The map instance.\n+   */\n+  releaseSharedContext(map) {\n+    const mapId = getUid(map);\n+    const context = this.contexts_[mapId];\n+    \n+    if (context) {\n+      context.refCount--;\n+      \n+      if (context.refCount <= 0) {\n+        // Clean up the context\n+        const extension = context.gl.getExtension('WEBGL_lose_context');\n+        if (extension) {\n+          extension.loseContext();\n+        }\n+        delete this.contexts_[mapId];\n+      }\n+    }\n+  }\n+\n+  /**\n+   * Check if a shared context exists for a map.\n+   * @param {import(\"../PluggableMap.js\").default} map The map instance.\n+   * @return {boolean} True if a shared context exists.\n+   */\n+  hasSharedContext(map) {\n+    const mapId = getUid(map);\n+    return mapId in this.contexts_;\n+  }\n+}\n+\n+/**\n+ * Global instance of the WebGL context manager.\n+ * @type {WebGLContextManager}\n+ */\n+const contextManager = new WebGLContextManager();\n+\n+export default contextManager;\n\\ No newline at end of file\ndiff --git a/src/ol/webgl/SharedHelper.js b/src/ol/webgl/SharedHelper.js\nnew file mode 100644\nindex 000000000..1d425c4f5\n--- /dev/null\n+++ b/src/ol/webgl/SharedHelper.js\n@@ -0,0 +1,123 @@\n+/**\n+ * @module ol/webgl/SharedHelper\n+ */\n+import WebGLHelper from './Helper.js';\n+import contextManager from './ContextManager.js';\n+import {getUid} from '../util.js';\n+\n+/**\n+ * @typedef {Object} Options\n+ * @property {import(\"../PluggableMap.js\").default} map The map instance for context sharing.\n+ * @property {Object<string,import(\"./Helper\").UniformValue>} [uniforms] Uniform definitions for the post process steps\n+ * @property {Array<import(\"./Helper\").PostProcessesOptions>} [postProcesses] Post-processes definitions\n+ */\n+\n+/**\n+ * @classdesc\n+ * A WebGL helper that shares contexts between layers within the same map.\n+ * This helps reduce the number of WebGL contexts created, staying within browser limits.\n+ */\n+class SharedWebGLHelper extends WebGLHelper {\n+  /**\n+   * @param {Options} options Options.\n+   */\n+  constructor(options) {\n+    const map = options.map;\n+    if (!map) {\n+      throw new Error('SharedWebGLHelper requires a map instance');\n+    }\n+\n+    // Get or create shared context for this map\n+    const sharedContext = contextManager.getSharedContext(map);\n+    \n+    // Create a minimal options object for the parent constructor\n+    const helperOptions = {\n+      uniforms: options.uniforms,\n+      postProcesses: options.postProcesses\n+    };\n+\n+    // Call parent constructor\n+    super(helperOptions);\n+\n+    /**\n+     * @type {import(\"../PluggableMap.js\").default}\n+     * @private\n+     */\n+    this.map_ = map;\n+\n+    /**\n+     * @type {boolean}\n+     * @private\n+     */\n+    this.usingSharedContext_ = true;\n+\n+    // Store reference to original canvas for cleanup\n+    const originalCanvas = this.canvas_;\n+    const originalGl = this.gl_;\n+\n+    // Replace the canvas and gl context with shared ones\n+    this.canvas_ = sharedContext.canvas;\n+    this.gl_ = sharedContext.gl;\n+\n+    // Clean up the original canvas created by parent constructor\n+    if (originalCanvas && originalCanvas !== sharedContext.canvas) {\n+      // Remove event listeners from old canvas\n+      originalCanvas.removeEventListener('webglcontextlost', this.boundHandleWebGLContextLost_);\n+      originalCanvas.removeEventListener('webglcontextrestored', this.boundHandleWebGLContextRestored_);\n+      \n+      // Dispose original context if it exists\n+      if (originalGl) {\n+        const extension = originalGl.getExtension('WEBGL_lose_context');\n+        if (extension) {\n+          extension.loseContext();\n+        }\n+      }\n+    }\n+\n+    // Add event listeners to shared canvas\n+    this.canvas_.addEventListener('webglcontextlost', this.boundHandleWebGLContextLost_);\n+    this.canvas_.addEventListener('webglcontextrestored', this.boundHandleWebGLContextRestored_);\n+  }\n+\n+  /**\n+   * Get the canvas element.\n+   * @return {HTMLCanvasElement} Canvas.\n+   */\n+  getCanvas() {\n+    return this.canvas_;\n+  }\n+\n+  /**\n+   * Get the WebGL rendering context.\n+   * @return {WebGLRenderingContext} The rendering context.\n+   */\n+  getGL() {\n+    return this.gl_;\n+  }\n+\n+  /**\n+   * Clean up. For shared contexts, this decrements the reference count\n+   * and only disposes the context when no more layers are using it.\n+   */\n+  disposeInternal() {\n+    if (this.usingSharedContext_ && this.map_) {\n+      // Remove event listeners\n+      this.canvas_.removeEventListener('webglcontextlost', this.boundHandleWebGLContextLost_);\n+      this.canvas_.removeEventListener('webglcontextrestored', this.boundHandleWebGLContextRestored_);\n+      \n+      // Release the shared context\n+      contextManager.releaseSharedContext(this.map_);\n+      \n+      // Don't call parent disposeInternal as it would try to dispose the shared context\n+      // Just clean up our own resources\n+      this.canvas_ = null;\n+      this.gl_ = null;\n+      this.map_ = null;\n+    } else {\n+      // Fall back to normal disposal if not using shared context\n+      super.disposeInternal();\n+    }\n+  }\n+}\n+\n+export default SharedWebGLHelper;\n\\ No newline at end of file\ndiff --git a/test_context_sharing.js b/test_context_sharing.js\nnew file mode 100644\nindex 000000000..6d9592e84\n--- /dev/null\n+++ b/test_context_sharing.js\n@@ -0,0 +1,91 @@\n+/**\n+ * Simple test to verify WebGL context sharing implementation\n+ */\n+\n+// Import the modules we need to test\n+import Map from './src/ol/Map.js';\n+import View from './src/ol/View.js';\n+import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+import DataTile from './src/ol/source/DataTile.js';\n+import contextManager from './src/ol/webgl/ContextManager.js';\n+\n+// Create a simple test\n+function testWebGLContextSharing() {\n+  console.log('Testing WebGL Context Sharing...');\n+  \n+  // Create a map\n+  const map = new Map({\n+    view: new View({\n+      center: [0, 0],\n+      zoom: 2\n+    })\n+  });\n+  \n+  // Create multiple WebGL tile layers\n+  const layers = [];\n+  for (let i = 0; i < 3; i++) {\n+    const source = new DataTile({\n+      loader: function(z, x, y) {\n+        // Simple test data\n+        const data = new Uint8Array(256 * 256 * 4);\n+        for (let j = 0; j < data.length; j += 4) {\n+          data[j] = (i * 80) % 255;     // R\n+          data[j + 1] = 100;            // G  \n+          data[j + 2] = 150;            // B\n+          data[j + 3] = 255;            // A\n+        }\n+        return data;\n+      },\n+      bandCount: 4\n+    });\n+    \n+    const layer = new WebGLTileLayer({\n+      source: source,\n+      style: {\n+        color: ['*', ['band', 1], 1.0]\n+      }\n+    });\n+    \n+    layers.push(layer);\n+    map.addLayer(layer);\n+  }\n+  \n+  console.log(`Created ${layers.length} WebGL tile layers`);\n+  \n+  // Check if context manager is working\n+  const hasSharedContext = contextManager.hasSharedContext(map);\n+  console.log(`Map has shared context: ${hasSharedContext}`);\n+  \n+  // Try to get renderers and check if they use shared context\n+  setTimeout(() => {\n+    let sharedHelperCount = 0;\n+    let regularHelperCount = 0;\n+    \n+    layers.forEach((layer, index) => {\n+      const renderer = layer.getRenderer();\n+      if (renderer && renderer.helper) {\n+        if (renderer.helper.constructor.name === 'SharedWebGLHelper') {\n+          sharedHelperCount++;\n+        } else {\n+          regularHelperCount++;\n+        }\n+        console.log(`Layer ${index}: Using ${renderer.helper.constructor.name}`);\n+      } else {\n+        console.log(`Layer ${index}: No renderer or helper yet`);\n+      }\n+    });\n+    \n+    console.log(`Shared helpers: ${sharedHelperCount}, Regular helpers: ${regularHelperCount}`);\n+    \n+    if (sharedHelperCount > 0) {\n+      console.log('\u2705 SUCCESS: WebGL context sharing is working!');\n+    } else if (regularHelperCount > 0) {\n+      console.log('\u26a0\ufe0f  FALLBACK: Using regular WebGL helpers (context sharing not active)');\n+    } else {\n+      console.log('\u2753 UNKNOWN: No helpers created yet');\n+    }\n+  }, 1000);\n+}\n+\n+// Run the test\n+testWebGLContextSharing();\n\\ No newline at end of file\ndiff --git a/test_webgl_context_sharing.html b/test_webgl_context_sharing.html\nnew file mode 100644\nindex 000000000..32ee71e65\n--- /dev/null\n+++ b/test_webgl_context_sharing.html\n@@ -0,0 +1,226 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Context Sharing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #controls {\n+            margin-bottom: 20px;\n+        }\n+        #info {\n+            margin-top: 20px;\n+            padding: 10px;\n+            background-color: #f0f0f0;\n+            border-radius: 5px;\n+        }\n+        .error {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .success {\n+            color: green;\n+            font-weight: bold;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Context Sharing Test</h1>\n+    <div id=\"controls\">\n+        <button id=\"addLayer\">Add WebGL Tile Layer</button>\n+        <button id=\"removeLayer\">Remove Last Layer</button>\n+        <button id=\"checkContexts\">Check WebGL Contexts</button>\n+        <span>Layers: <span id=\"layerCount\">0</span></span>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <h3>WebGL Context Information:</h3>\n+        <div id=\"contextInfo\">Click \"Check WebGL Contexts\" to see information</div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import DataTile from './src/ol/source/DataTile.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        let map;\n+        let layerCount = 0;\n+        const layers = [];\n+\n+        // Initialize map\n+        function initMap() {\n+            map = new Map({\n+                target: 'map',\n+                view: new View({\n+                    center: fromLonLat([0, 0]),\n+                    zoom: 2\n+                })\n+            });\n+        }\n+\n+        // Create a simple data tile source for testing\n+        function createTestDataTileSource(offset = 0) {\n+            return new DataTile({\n+                loader: function(z, x, y) {\n+                    const canvas = document.createElement('canvas');\n+                    canvas.width = 256;\n+                    canvas.height = 256;\n+                    const ctx = canvas.getContext('2d');\n+                    \n+                    // Create a simple pattern with different colors based on offset\n+                    const hue = (offset * 60) % 360;\n+                    ctx.fillStyle = `hsl(${hue}, 70%, 50%)`;\n+                    ctx.fillRect(0, 0, 256, 256);\n+                    \n+                    // Add some pattern\n+                    ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';\n+                    for (let i = 0; i < 256; i += 32) {\n+                        for (let j = 0; j < 256; j += 32) {\n+                            if ((i + j) % 64 === 0) {\n+                                ctx.fillRect(i, j, 16, 16);\n+                            }\n+                        }\n+                    }\n+                    \n+                    return ctx.getImageData(0, 0, 256, 256).data;\n+                },\n+                bandCount: 4\n+            });\n+        }\n+\n+        // Add a new WebGL tile layer\n+        function addWebGLLayer() {\n+            const source = createTestDataTileSource(layerCount);\n+            const layer = new WebGLTileLayer({\n+                source: source,\n+                style: {\n+                    color: ['*', ['band', 1], 1.0],\n+                    brightness: layerCount * 0.1 // Slight brightness variation\n+                }\n+            });\n+            \n+            layers.push(layer);\n+            map.addLayer(layer);\n+            layerCount++;\n+            updateLayerCount();\n+            \n+            console.log(`Added WebGL layer ${layerCount}`);\n+        }\n+\n+        // Remove the last layer\n+        function removeWebGLLayer() {\n+            if (layers.length > 0) {\n+                const layer = layers.pop();\n+                map.removeLayer(layer);\n+                layer.dispose(); // Important: dispose the layer to clean up WebGL resources\n+                layerCount--;\n+                updateLayerCount();\n+                console.log(`Removed WebGL layer, remaining: ${layerCount}`);\n+            }\n+        }\n+\n+        // Update layer count display\n+        function updateLayerCount() {\n+            document.getElementById('layerCount').textContent = layerCount;\n+        }\n+\n+        // Check WebGL contexts\n+        function checkWebGLContexts() {\n+            const infoDiv = document.getElementById('contextInfo');\n+            let html = '';\n+            \n+            // Get all canvas elements in the map\n+            const mapElement = document.getElementById('map');\n+            const canvases = mapElement.querySelectorAll('canvas');\n+            \n+            html += `<p>Total canvas elements found: ${canvases.length}</p>`;\n+            \n+            let webglContextCount = 0;\n+            let contextDetails = [];\n+            \n+            canvases.forEach((canvas, index) => {\n+                try {\n+                    // Try to get WebGL context\n+                    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');\n+                    if (gl) {\n+                        webglContextCount++;\n+                        const isContextLost = gl.isContextLost();\n+                        contextDetails.push({\n+                            index: index,\n+                            width: canvas.width,\n+                            height: canvas.height,\n+                            contextLost: isContextLost,\n+                            vendor: gl.getParameter(gl.VENDOR),\n+                            renderer: gl.getParameter(gl.RENDERER)\n+                        });\n+                    }\n+                } catch (e) {\n+                    console.warn(`Could not get WebGL context for canvas ${index}:`, e);\n+                }\n+            });\n+            \n+            html += `<p><strong>WebGL contexts found: ${webglContextCount}</strong></p>`;\n+            \n+            if (webglContextCount > 16) {\n+                html += `<p class=\"error\">WARNING: More than 16 WebGL contexts detected! This may cause issues.</p>`;\n+            } else if (webglContextCount > 10) {\n+                html += `<p style=\"color: orange;\">CAUTION: Getting close to the typical 16 context limit.</p>`;\n+            } else {\n+                html += `<p class=\"success\">Context count is within safe limits.</p>`;\n+            }\n+            \n+            // Show details for each context\n+            if (contextDetails.length > 0) {\n+                html += '<h4>Context Details:</h4><ul>';\n+                contextDetails.forEach(detail => {\n+                    html += `<li>Canvas ${detail.index}: ${detail.width}x${detail.height}, `;\n+                    html += `Lost: ${detail.contextLost}, `;\n+                    html += `Vendor: ${detail.vendor}</li>`;\n+                });\n+                html += '</ul>';\n+            }\n+            \n+            // Check if contexts are being shared (this is what we want to implement)\n+            if (layerCount > 1 && webglContextCount === 1) {\n+                html += `<p class=\"success\">SUCCESS: ${layerCount} layers are sharing a single WebGL context!</p>`;\n+            } else if (layerCount > 1 && webglContextCount === layerCount) {\n+                html += `<p class=\"error\">ISSUE: Each layer is using its own WebGL context (${webglContextCount} contexts for ${layerCount} layers)</p>`;\n+            }\n+            \n+            infoDiv.innerHTML = html;\n+        }\n+\n+        // Event listeners\n+        document.getElementById('addLayer').addEventListener('click', addWebGLLayer);\n+        document.getElementById('removeLayer').addEventListener('click', removeWebGLLayer);\n+        document.getElementById('checkContexts').addEventListener('click', checkWebGLContexts);\n+\n+        // Initialize the map\n+        initMap();\n+        \n+        // Add initial layer for testing\n+        addWebGLLayer();\n+        \n+        // Auto-check contexts after a short delay\n+        setTimeout(checkWebGLContexts, 1000);\n+        \n+        // Expose functions for testing\n+        window.testFunctions = {\n+            addWebGLLayer,\n+            removeWebGLLayer,\n+            checkWebGLContexts,\n+            getLayerCount: () => layerCount,\n+            getLayers: () => layers\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_context_simple.html b/test_webgl_context_simple.html\nnew file mode 100644\nindex 000000000..dc3e5b186\n--- /dev/null\n+++ b/test_webgl_context_simple.html\n@@ -0,0 +1,233 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Context Sharing Test - Simple</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #controls {\n+            margin-bottom: 20px;\n+        }\n+        #info {\n+            margin-top: 20px;\n+            padding: 10px;\n+            background-color: #f0f0f0;\n+            border-radius: 5px;\n+        }\n+        .error {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .success {\n+            color: green;\n+            font-weight: bold;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/ol.css\">\n+</head>\n+<body>\n+    <h1>WebGL Context Sharing Test - Simple</h1>\n+    <div id=\"controls\">\n+        <button id=\"addLayer\">Add WebGL Tile Layer</button>\n+        <button id=\"removeLayer\">Remove Last Layer</button>\n+        <button id=\"checkContexts\">Check WebGL Contexts</button>\n+        <span>Layers: <span id=\"layerCount\">0</span></span>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <h3>WebGL Context Information:</h3>\n+        <div id=\"contextInfo\">Click \"Check WebGL Contexts\" to see information</div>\n+    </div>\n+\n+    <script>\n+        let map;\n+        let layerCount = 0;\n+        const layers = [];\n+\n+        // Initialize map\n+        function initMap() {\n+            map = new ol.Map({\n+                target: 'map',\n+                view: new ol.View({\n+                    center: ol.proj.fromLonLat([0, 0]),\n+                    zoom: 2\n+                })\n+            });\n+        }\n+\n+        // Create a simple data tile source for testing\n+        function createTestDataTileSource(offset = 0) {\n+            return new ol.source.DataTile({\n+                loader: function(z, x, y) {\n+                    const canvas = document.createElement('canvas');\n+                    canvas.width = 256;\n+                    canvas.height = 256;\n+                    const ctx = canvas.getContext('2d');\n+                    \n+                    // Create a simple pattern with different colors based on offset\n+                    const hue = (offset * 60) % 360;\n+                    ctx.fillStyle = `hsl(${hue}, 70%, 50%)`;\n+                    ctx.fillRect(0, 0, 256, 256);\n+                    \n+                    // Add some pattern\n+                    ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';\n+                    for (let i = 0; i < 256; i += 32) {\n+                        for (let j = 0; j < 256; j += 32) {\n+                            if ((i + j) % 64 === 0) {\n+                                ctx.fillRect(i, j, 16, 16);\n+                            }\n+                        }\n+                    }\n+                    \n+                    return ctx.getImageData(0, 0, 256, 256).data;\n+                },\n+                bandCount: 4\n+            });\n+        }\n+\n+        // Add a new WebGL tile layer\n+        function addWebGLLayer() {\n+            try {\n+                const source = createTestDataTileSource(layerCount);\n+                const layer = new ol.layer.WebGLTile({\n+                    source: source,\n+                    style: {\n+                        color: ['*', ['band', 1], 1.0],\n+                        brightness: layerCount * 0.1 // Slight brightness variation\n+                    }\n+                });\n+                \n+                layers.push(layer);\n+                map.addLayer(layer);\n+                layerCount++;\n+                updateLayerCount();\n+                \n+                console.log(`Added WebGL layer ${layerCount}`);\n+            } catch (error) {\n+                console.error('Error adding WebGL layer:', error);\n+                document.getElementById('contextInfo').innerHTML = \n+                    '<p class=\"error\">Error adding WebGL layer: ' + error.message + '</p>';\n+            }\n+        }\n+\n+        // Remove the last layer\n+        function removeWebGLLayer() {\n+            if (layers.length > 0) {\n+                const layer = layers.pop();\n+                map.removeLayer(layer);\n+                if (layer.dispose) {\n+                    layer.dispose(); // Important: dispose the layer to clean up WebGL resources\n+                }\n+                layerCount--;\n+                updateLayerCount();\n+                console.log(`Removed WebGL layer, remaining: ${layerCount}`);\n+            }\n+        }\n+\n+        // Update layer count display\n+        function updateLayerCount() {\n+            document.getElementById('layerCount').textContent = layerCount;\n+        }\n+\n+        // Check WebGL contexts\n+        function checkWebGLContexts() {\n+            const infoDiv = document.getElementById('contextInfo');\n+            let html = '';\n+            \n+            // Get all canvas elements in the map\n+            const mapElement = document.getElementById('map');\n+            const canvases = mapElement.querySelectorAll('canvas');\n+            \n+            html += `<p>Total canvas elements found: ${canvases.length}</p>`;\n+            \n+            let webglContextCount = 0;\n+            let contextDetails = [];\n+            \n+            canvases.forEach((canvas, index) => {\n+                try {\n+                    // Try to get WebGL context\n+                    const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');\n+                    if (gl) {\n+                        webglContextCount++;\n+                        const isContextLost = gl.isContextLost();\n+                        contextDetails.push({\n+                            index: index,\n+                            width: canvas.width,\n+                            height: canvas.height,\n+                            contextLost: isContextLost,\n+                            vendor: gl.getParameter(gl.VENDOR),\n+                            renderer: gl.getParameter(gl.RENDERER)\n+                        });\n+                    }\n+                } catch (e) {\n+                    console.warn(`Could not get WebGL context for canvas ${index}:`, e);\n+                }\n+            });\n+            \n+            html += `<p><strong>WebGL contexts found: ${webglContextCount}</strong></p>`;\n+            \n+            if (webglContextCount > 16) {\n+                html += `<p class=\"error\">WARNING: More than 16 WebGL contexts detected! This may cause issues.</p>`;\n+            } else if (webglContextCount > 10) {\n+                html += `<p style=\"color: orange;\">CAUTION: Getting close to the typical 16 context limit.</p>`;\n+            } else {\n+                html += `<p class=\"success\">Context count is within safe limits.</p>`;\n+            }\n+            \n+            // Show details for each context\n+            if (contextDetails.length > 0) {\n+                html += '<h4>Context Details:</h4><ul>';\n+                contextDetails.forEach(detail => {\n+                    html += `<li>Canvas ${detail.index}: ${detail.width}x${detail.height}, `;\n+                    html += `Lost: ${detail.contextLost}, `;\n+                    html += `Vendor: ${detail.vendor}</li>`;\n+                });\n+                html += '</ul>';\n+            }\n+            \n+            // Check if contexts are being shared (this is what we want to implement)\n+            if (layerCount > 1 && webglContextCount === 1) {\n+                html += `<p class=\"success\">SUCCESS: ${layerCount} layers are sharing a single WebGL context!</p>`;\n+            } else if (layerCount > 1 && webglContextCount === layerCount) {\n+                html += `<p class=\"error\">ISSUE: Each layer is using its own WebGL context (${webglContextCount} contexts for ${layerCount} layers)</p>`;\n+            }\n+            \n+            infoDiv.innerHTML = html;\n+        }\n+\n+        // Event listeners\n+        document.getElementById('addLayer').addEventListener('click', addWebGLLayer);\n+        document.getElementById('removeLayer').addEventListener('click', removeWebGLLayer);\n+        document.getElementById('checkContexts').addEventListener('click', checkWebGLContexts);\n+\n+        // Initialize the map when page loads\n+        window.addEventListener('load', function() {\n+            initMap();\n+            \n+            // Add initial layer for testing\n+            setTimeout(function() {\n+                addWebGLLayer();\n+                // Auto-check contexts after a short delay\n+                setTimeout(checkWebGLContexts, 1000);\n+            }, 500);\n+        });\n+        \n+        // Expose functions for testing\n+        window.testFunctions = {\n+            addWebGLLayer,\n+            removeWebGLLayer,\n+            checkWebGLContexts,\n+            getLayerCount: () => layerCount,\n+            getLayers: () => layers\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

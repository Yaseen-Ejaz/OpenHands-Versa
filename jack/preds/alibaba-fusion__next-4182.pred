{"instance_id": "alibaba-fusion__next-4182", "model_patch": "diff --git a/src/cascader-select/cascader-select.jsx b/src/cascader-select/cascader-select.jsx\nindex 25bbe4168..f50f960d4 100644\n--- a/src/cascader-select/cascader-select.jsx\n+++ b/src/cascader-select/cascader-select.jsx\n@@ -595,13 +595,36 @@ class CascaderSelect extends Component {\n         }\n \n         const { prefix, popupProps } = this.props;\n-        const dropDownNode = this.popup\n-            .getInstance()\n-            .overlay.getInstance()\n-            .getContentNode();\n-        const cascaderNode = dropDownNode.querySelector(`.${prefix}cascader`);\n-        if (cascaderNode) {\n-            this.cascaderHeight = getStyle(cascaderNode, 'height');\n+        \n+        // Try to get content node, handling both v1 and v2 popup APIs\n+        let dropDownNode = null;\n+        try {\n+            // v1 popup API\n+            dropDownNode = this.popup\n+                .getInstance()\n+                .overlay.getInstance()\n+                .getContentNode();\n+        } catch (e) {\n+            // v2 popup API or other cases - try alternative approaches\n+            try {\n+                // Try direct access to popup ref\n+                if (this.popup.getInstance && this.popup.getInstance()) {\n+                    const instance = this.popup.getInstance();\n+                    if (instance.getContentNode) {\n+                        dropDownNode = instance.getContentNode();\n+                    }\n+                }\n+            } catch (e2) {\n+                // If all else fails, try to find the dropdown in the DOM\n+                dropDownNode = document.querySelector(`.${prefix}cascader-select-dropdown`);\n+            }\n+        }\n+        \n+        if (dropDownNode) {\n+            const cascaderNode = dropDownNode.querySelector(`.${prefix}cascader`);\n+            if (cascaderNode) {\n+                this.cascaderHeight = getStyle(cascaderNode, 'height');\n+            }\n         }\n \n         if (typeof popupProps.afterOpen === 'function') {\ndiff --git a/test-cascader-v2.html b/test-cascader-v2.html\nnew file mode 100644\nindex 000000000..ad9e9f5c2\n--- /dev/null\n+++ b/test-cascader-v2.html\n@@ -0,0 +1,78 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>CascaderSelect v2 Test</title>\n+    <script crossorigin src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script crossorigin src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <link rel=\"stylesheet\" href=\"./index.css\">\n+</head>\n+<body>\n+    <div id=\"root\"></div>\n+    \n+    <script type=\"text/babel\">\n+        const { useState } = React;\n+        \n+        // Import the components - we'll need to build them first\n+        const CascaderSelect = window.Next.CascaderSelect;\n+        \n+        function App() {\n+            const dataSource = [\n+                {\n+                    value: '1',\n+                    label: 'Option 1',\n+                    children: [\n+                        {\n+                            value: '1-1',\n+                            label: 'Option 1-1',\n+                        },\n+                        {\n+                            value: '1-2',\n+                            label: 'Option 1-2',\n+                        }\n+                    ]\n+                },\n+                {\n+                    value: '2',\n+                    label: 'Option 2',\n+                    children: [\n+                        {\n+                            value: '2-1',\n+                            label: 'Option 2-1',\n+                        }\n+                    ]\n+                }\n+            ];\n+            \n+            return (\n+                <div style={{ padding: '20px' }}>\n+                    <h1>CascaderSelect v2 Test</h1>\n+                    \n+                    <h2>Working Case (without v2):</h2>\n+                    <CascaderSelect\n+                        dataSource={dataSource}\n+                        showSearch\n+                        placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                        style={{ width: 200 }}\n+                    />\n+                    \n+                    <h2>Broken Case (with v2):</h2>\n+                    <CascaderSelect\n+                        dataSource={dataSource}\n+                        popupProps={{\n+                            v2: true,\n+                        }}\n+                        showSearch\n+                        placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                        style={{ width: 200 }}\n+                    />\n+                </div>\n+            );\n+        }\n+        \n+        ReactDOM.render(<App />, document.getElementById('root'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-cascader-v2.js b/test-cascader-v2.js\nnew file mode 100644\nindex 000000000..25dfa4c58\n--- /dev/null\n+++ b/test-cascader-v2.js\n@@ -0,0 +1,59 @@\n+const React = require('react');\n+const ReactDOMServer = require('react-dom/server');\n+\n+// Mock the environment for testing\n+global.window = {};\n+global.document = {\n+    querySelector: () => null,\n+    createElement: () => ({}),\n+    addEventListener: () => {},\n+    removeEventListener: () => {}\n+};\n+\n+try {\n+    const CascaderSelect = require('./lib/cascader-select').default;\n+    \n+    const dataSource = [\n+        {\n+            value: '1',\n+            label: 'Option 1',\n+            children: [\n+                {\n+                    value: '1-1',\n+                    label: 'Option 1-1',\n+                },\n+                {\n+                    value: '1-2',\n+                    label: 'Option 1-2',\n+                }\n+            ]\n+        }\n+    ];\n+    \n+    console.log('Testing CascaderSelect without v2...');\n+    const element1 = React.createElement(CascaderSelect, {\n+        dataSource: dataSource,\n+        showSearch: true,\n+        placeholder: \"\u641c\u7d22\u540d\u5b57\"\n+    });\n+    \n+    const html1 = ReactDOMServer.renderToString(element1);\n+    console.log('\u2713 CascaderSelect without v2 works');\n+    \n+    console.log('Testing CascaderSelect with v2...');\n+    const element2 = React.createElement(CascaderSelect, {\n+        dataSource: dataSource,\n+        popupProps: {\n+            v2: true,\n+        },\n+        showSearch: true,\n+        placeholder: \"\u641c\u7d22\u540d\u5b57\"\n+    });\n+    \n+    const html2 = ReactDOMServer.renderToString(element2);\n+    console.log('\u2713 CascaderSelect with v2 works in SSR');\n+    \n+} catch (error) {\n+    console.error('\u274c Error occurred:', error.message);\n+    console.error('Stack trace:', error.stack);\n+}\n\\ No newline at end of file\ndiff --git a/test-v2-fix.html b/test-v2-fix.html\nnew file mode 100644\nindex 000000000..183fb483e\n--- /dev/null\n+++ b/test-v2-fix.html\n@@ -0,0 +1,208 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>CascaderSelect v2 Fix Test</title>\n+    <script crossorigin src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script crossorigin src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <link rel=\"stylesheet\" href=\"./index.css\">\n+    <style>\n+        body { font-family: Arial, sans-serif; padding: 20px; }\n+        .test-section { margin: 20px 0; padding: 20px; border: 1px solid #ddd; border-radius: 4px; }\n+        .test-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }\n+        .test-description { color: #666; margin-bottom: 15px; }\n+        .error-display { color: red; background: #ffe6e6; padding: 10px; border-radius: 4px; margin-top: 10px; }\n+        .success-display { color: green; background: #e6ffe6; padding: 10px; border-radius: 4px; margin-top: 10px; }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"root\"></div>\n+    \n+    <script type=\"text/babel\">\n+        const { useState, useEffect } = React;\n+        \n+        // Mock the Next components for testing\n+        const CascaderSelect = window.Next ? window.Next.CascaderSelect : null;\n+        \n+        function TestCase({ title, description, children, onError, onSuccess }) {\n+            const [error, setError] = useState(null);\n+            const [success, setSuccess] = useState(false);\n+            \n+            useEffect(() => {\n+                const timer = setTimeout(() => {\n+                    if (!error) {\n+                        setSuccess(true);\n+                        onSuccess && onSuccess();\n+                    }\n+                }, 1000);\n+                \n+                return () => clearTimeout(timer);\n+            }, [error]);\n+            \n+            const handleError = (error) => {\n+                setError(error.message);\n+                onError && onError(error);\n+            };\n+            \n+            return (\n+                <div className=\"test-section\">\n+                    <div className=\"test-title\">{title}</div>\n+                    <div className=\"test-description\">{description}</div>\n+                    <ErrorBoundary onError={handleError}>\n+                        {children}\n+                    </ErrorBoundary>\n+                    {error && <div className=\"error-display\">\u274c Error: {error}</div>}\n+                    {success && !error && <div className=\"success-display\">\u2705 Test passed!</div>}\n+                </div>\n+            );\n+        }\n+        \n+        class ErrorBoundary extends React.Component {\n+            constructor(props) {\n+                super(props);\n+                this.state = { hasError: false };\n+            }\n+            \n+            static getDerivedStateFromError(error) {\n+                return { hasError: true };\n+            }\n+            \n+            componentDidCatch(error, errorInfo) {\n+                this.props.onError && this.props.onError(error);\n+            }\n+            \n+            render() {\n+                if (this.state.hasError) {\n+                    return null;\n+                }\n+                \n+                return this.props.children;\n+            }\n+        }\n+        \n+        function App() {\n+            const [testResults, setTestResults] = useState({});\n+            \n+            const dataSource = [\n+                {\n+                    value: '1',\n+                    label: 'Option 1',\n+                    children: [\n+                        {\n+                            value: '1-1',\n+                            label: 'Option 1-1',\n+                        },\n+                        {\n+                            value: '1-2',\n+                            label: 'Option 1-2',\n+                        }\n+                    ]\n+                },\n+                {\n+                    value: '2',\n+                    label: 'Option 2',\n+                    children: [\n+                        {\n+                            value: '2-1',\n+                            label: 'Option 2-1',\n+                        }\n+                    ]\n+                }\n+            ];\n+            \n+            const updateTestResult = (testName, result) => {\n+                setTestResults(prev => ({ ...prev, [testName]: result }));\n+            };\n+            \n+            if (!CascaderSelect) {\n+                return (\n+                    <div>\n+                        <h1>CascaderSelect v2 Fix Test</h1>\n+                        <div className=\"error-display\">\n+                            \u274c CascaderSelect component not found. Please make sure the build is complete and the component is properly exported.\n+                        </div>\n+                        <p>To test manually:</p>\n+                        <ol>\n+                            <li>Build the project: <code>npm run build</code></li>\n+                            <li>Start a development server</li>\n+                            <li>Import the CascaderSelect component</li>\n+                            <li>Test with v2 popup props</li>\n+                        </ol>\n+                    </div>\n+                );\n+            }\n+            \n+            return (\n+                <div>\n+                    <h1>CascaderSelect v2 Fix Test</h1>\n+                    \n+                    <TestCase\n+                        title=\"Test 1: CascaderSelect without v2 (baseline)\"\n+                        description=\"This should work normally as a control test\"\n+                        onSuccess={() => updateTestResult('baseline', 'pass')}\n+                        onError={() => updateTestResult('baseline', 'fail')}\n+                    >\n+                        <CascaderSelect\n+                            dataSource={dataSource}\n+                            showSearch\n+                            placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                            style={{ width: 200 }}\n+                        />\n+                    </TestCase>\n+                    \n+                    <TestCase\n+                        title=\"Test 2: CascaderSelect with v2 popup (the fix)\"\n+                        description=\"This should now work with our fix for v2 popup API\"\n+                        onSuccess={() => updateTestResult('v2fix', 'pass')}\n+                        onError={() => updateTestResult('v2fix', 'fail')}\n+                    >\n+                        <CascaderSelect\n+                            dataSource={dataSource}\n+                            popupProps={{\n+                                v2: true,\n+                            }}\n+                            showSearch\n+                            placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                            style={{ width: 200 }}\n+                        />\n+                    </TestCase>\n+                    \n+                    <TestCase\n+                        title=\"Test 3: CascaderSelect with v2 popup and defaultVisible\"\n+                        description=\"This tests the handleAfterOpen method directly by opening the popup\"\n+                        onSuccess={() => updateTestResult('v2open', 'pass')}\n+                        onError={() => updateTestResult('v2open', 'fail')}\n+                    >\n+                        <CascaderSelect\n+                            dataSource={dataSource}\n+                            popupProps={{\n+                                v2: true,\n+                            }}\n+                            showSearch\n+                            placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                            defaultVisible\n+                            style={{ width: 200 }}\n+                        />\n+                    </TestCase>\n+                    \n+                    <div style={{ marginTop: '30px', padding: '20px', background: '#f5f5f5', borderRadius: '4px' }}>\n+                        <h3>Test Results Summary:</h3>\n+                        <ul>\n+                            <li>Baseline test: {testResults.baseline || 'pending...'}</li>\n+                            <li>V2 fix test: {testResults.v2fix || 'pending...'}</li>\n+                            <li>V2 open test: {testResults.v2open || 'pending...'}</li>\n+                        </ul>\n+                        {Object.values(testResults).every(r => r === 'pass') && Object.keys(testResults).length === 3 && (\n+                            <div className=\"success-display\">\ud83c\udf89 All tests passed! The v2 popup fix is working correctly.</div>\n+                        )}\n+                    </div>\n+                </div>\n+            );\n+        }\n+        \n+        ReactDOM.render(<App />, document.getElementById('root'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-v2-fix.js b/test-v2-fix.js\nnew file mode 100644\nindex 000000000..3a1d83041\n--- /dev/null\n+++ b/test-v2-fix.js\n@@ -0,0 +1,94 @@\n+const React = require('react');\n+const { mount } = require('enzyme');\n+const Adapter = require('enzyme-adapter-react-16');\n+const { configure } = require('enzyme');\n+\n+// Configure enzyme\n+configure({ adapter: new Adapter() });\n+\n+// Mock DOM environment\n+const { JSDOM } = require('jsdom');\n+const dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');\n+global.window = dom.window;\n+global.document = dom.window.document;\n+global.navigator = dom.window.navigator;\n+\n+try {\n+    const CascaderSelect = require('./lib/cascader-select').default;\n+    \n+    const dataSource = [\n+        {\n+            value: '1',\n+            label: 'Option 1',\n+            children: [\n+                {\n+                    value: '1-1',\n+                    label: 'Option 1-1',\n+                },\n+                {\n+                    value: '1-2',\n+                    label: 'Option 1-2',\n+                }\n+            ]\n+        }\n+    ];\n+    \n+    console.log('\ud83e\uddea Testing CascaderSelect v2 fix...\\n');\n+    \n+    // Test 1: Baseline test without v2\n+    console.log('Test 1: CascaderSelect without v2 (baseline)');\n+    try {\n+        const wrapper1 = mount(React.createElement(CascaderSelect, {\n+            dataSource: dataSource,\n+            showSearch: true,\n+            placeholder: \"\u641c\u7d22\u540d\u5b57\"\n+        }));\n+        console.log('\u2705 Baseline test passed - component renders without v2');\n+        wrapper1.unmount();\n+    } catch (error) {\n+        console.log('\u274c Baseline test failed:', error.message);\n+    }\n+    \n+    // Test 2: Main test with v2 popup\n+    console.log('\\nTest 2: CascaderSelect with v2 popup (the fix)');\n+    try {\n+        const wrapper2 = mount(React.createElement(CascaderSelect, {\n+            dataSource: dataSource,\n+            popupProps: {\n+                v2: true,\n+            },\n+            showSearch: true,\n+            placeholder: \"\u641c\u7d22\u540d\u5b57\"\n+        }));\n+        console.log('\u2705 V2 popup test passed - component renders with v2');\n+        wrapper2.unmount();\n+    } catch (error) {\n+        console.log('\u274c V2 popup test failed:', error.message);\n+        console.log('Stack trace:', error.stack);\n+    }\n+    \n+    // Test 3: Test with defaultVisible to trigger handleAfterOpen\n+    console.log('\\nTest 3: CascaderSelect with v2 popup and defaultVisible');\n+    try {\n+        const wrapper3 = mount(React.createElement(CascaderSelect, {\n+            dataSource: dataSource,\n+            popupProps: {\n+                v2: true,\n+            },\n+            showSearch: true,\n+            placeholder: \"\u641c\u7d22\u540d\u5b57\",\n+            defaultVisible: true\n+        }));\n+        console.log('\u2705 V2 popup with defaultVisible test passed - handleAfterOpen works');\n+        wrapper3.unmount();\n+    } catch (error) {\n+        console.log('\u274c V2 popup with defaultVisible test failed:', error.message);\n+        console.log('Stack trace:', error.stack);\n+    }\n+    \n+    console.log('\\n\ud83c\udf89 All tests completed! If no errors were shown above, the fix is working correctly.');\n+    \n+} catch (error) {\n+    console.error('\u274c Test setup failed:', error.message);\n+    console.error('Make sure to run \"npm run build\" first to generate the lib files.');\n+}\n\\ No newline at end of file\ndiff --git a/test-v2-issue.js b/test-v2-issue.js\nnew file mode 100644\nindex 000000000..4bb87ee99\n--- /dev/null\n+++ b/test-v2-issue.js\n@@ -0,0 +1,58 @@\n+import React from 'react';\n+import ReactDOM from 'react-dom';\n+import { mount } from 'enzyme';\n+import CascaderSelect from './src/cascader-select';\n+\n+const ChinaArea = [\n+    {\n+        value: '2973',\n+        label: '\u9655\u897f',\n+        children: [\n+            {\n+                value: '2974',\n+                label: '\u897f\u5b89',\n+                children: [{ value: '2975', label: '\u897f\u5b89\u5e02' }, { value: '2976', label: '\u9ad8\u9675\u53bf' }],\n+            },\n+        ],\n+    },\n+];\n+\n+describe('CascaderSelect v2 popup issue', () => {\n+    let wrapper;\n+\n+    afterEach(() => {\n+        if (wrapper) {\n+            wrapper.unmount();\n+            wrapper = null;\n+        }\n+    });\n+\n+    it('should work with v2 popup and showSearch', (done) => {\n+        console.log('Testing CascaderSelect with v2 popup and showSearch...');\n+        \n+        try {\n+            wrapper = mount(\n+                <CascaderSelect\n+                    dataSource={ChinaArea}\n+                    popupProps={{\n+                        v2: true,\n+                    }}\n+                    showSearch\n+                    placeholder=\"\u641c\u7d22\u540d\u5b57\"\n+                    defaultVisible\n+                />\n+            );\n+            \n+            // Try to trigger the popup opening which should call handleAfterOpen\n+            setTimeout(() => {\n+                console.log('\u2713 CascaderSelect with v2 popup works');\n+                done();\n+            }, 100);\n+            \n+        } catch (error) {\n+            console.error('\u274c Error occurred:', error.message);\n+            console.error('Stack trace:', error.stack);\n+            done(error);\n+        }\n+    });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

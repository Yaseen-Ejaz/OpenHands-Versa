{"instance_id": "bpmn-io__bpmn-js-1442", "model_patch": "diff --git a/lib/features/modeling/behavior/DropOnFlowBehavior.js b/lib/features/modeling/behavior/DropOnFlowBehavior.js\nindex ef843a0a..edc0c91b 100644\n--- a/lib/features/modeling/behavior/DropOnFlowBehavior.js\n+++ b/lib/features/modeling/behavior/DropOnFlowBehavior.js\n@@ -115,10 +115,9 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n \n     var newParent = context.newParent,\n         shapes = context.shapes,\n-        delta = context.delta,\n-        shape = shapes[0];\n+        delta = context.delta;\n \n-    if (!shape || !newParent) {\n+    if (!shapes || !shapes.length || !newParent) {\n       return;\n     }\n \n@@ -128,23 +127,37 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n       context.newParent = newParent = newParent.parent;\n     }\n \n-    var shapeMid = getMid(shape);\n-    var newShapeMid = {\n-      x: shapeMid.x + delta.x,\n-      y: shapeMid.y + delta.y\n-    };\n+    // Handle multiple shapes - find connections for each shape\n+    var targetFlows = [];\n+    var positions = [];\n \n-    // find a connection which intersects with the\n-    // element's mid point\n-    var connection = find(newParent.children, function(element) {\n-      var canInsert = bpmnRules.canInsert(shapes, element);\n+    shapes.forEach(function(shape) {\n+      var shapeMid = getMid(shape);\n+      var newShapeMid = {\n+        x: shapeMid.x + delta.x,\n+        y: shapeMid.y + delta.y\n+      };\n \n-      return canInsert && getApproxIntersection(element.waypoints, newShapeMid);\n+      // find a connection which intersects with the\n+      // element's mid point\n+      var connection = find(newParent.children, function(element) {\n+        var canInsert = bpmnRules.canInsert([shape], element);\n+\n+        return canInsert && getApproxIntersection(element.waypoints, newShapeMid);\n+      });\n+\n+      targetFlows.push(connection);\n+      positions.push(newShapeMid);\n     });\n \n-    if (connection) {\n-      context.targetFlow = connection;\n-      context.position = newShapeMid;\n+    // Store arrays for multiple shapes\n+    context.targetFlows = targetFlows;\n+    context.positions = positions;\n+\n+    // Maintain backward compatibility for single shape\n+    if (shapes.length === 1) {\n+      context.targetFlow = targetFlows[0];\n+      context.position = positions[0];\n     }\n \n   }, true);\n@@ -152,10 +165,25 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n   this.postExecuted('elements.move', function(context) {\n \n     var shapes = context.shapes,\n+        targetFlows = context.targetFlows,\n+        positions = context.positions,\n         targetFlow = context.targetFlow,\n         position = context.position;\n \n-    if (targetFlow) {\n+    // Handle multiple shapes\n+    if (targetFlows && positions) {\n+      shapes.forEach(function(shape, index) {\n+        var flow = targetFlows[index];\n+        var pos = positions[index];\n+\n+        if (flow) {\n+          insertShape(shape, flow, pos);\n+        }\n+      });\n+    }\n+\n+    // Backward compatibility for single shape\n+    else if (targetFlow) {\n       insertShape(shapes[0], targetFlow, position);\n     }\n \ndiff --git a/test/spec/features/modeling/behavior/DropOnFlowBehaviorMultipleShapesSpec.js b/test/spec/features/modeling/behavior/DropOnFlowBehaviorMultipleShapesSpec.js\nnew file mode 100644\nindex 00000000..540b2b34\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/DropOnFlowBehaviorMultipleShapesSpec.js\n@@ -0,0 +1,157 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  flatten\n+} from 'min-dash';\n+\n+import coreModule from 'lib/core';\n+import moveModule from 'diagram-js/lib/features/move';\n+import modelingModule from 'lib/features/modeling';\n+\n+var noTouchInteractionModule = { touchInteractionEvents: ['value', null ] };\n+\n+import {\n+  createCanvasEvent as canvasEvent\n+} from '../../../../util/MockEvents';\n+\n+describe('modeling/behavior - drop multiple shapes on connection', function() {\n+\n+  var diagramXML = require('./DropOnFlowBehavior.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      noTouchInteractionModule,\n+      moveModule,\n+      modelingModule,\n+      coreModule\n+    ]\n+  }));\n+\n+  describe('multiple shapes move', function() {\n+\n+    beforeEach(inject(function(dragging) {\n+      dragging.setOptions({ manual: true });\n+    }));\n+\n+    it('should connect multiple shapes when moved onto connection', inject(\n+      function(dragging, move, elementRegistry, selection, elementFactory, modeling) {\n+\n+        // given - create two tasks\n+        var task1 = elementFactory.createShape({ type: 'bpmn:Task' });\n+        var task2 = elementFactory.createShape({ type: 'bpmn:Task' });\n+        \n+        var rootElement = elementRegistry.get('Process');\n+        \n+        // Create the tasks first\n+        var createdTask1 = modeling.createShape(task1, { x: 100, y: 100 }, rootElement);\n+        var createdTask2 = modeling.createShape(task2, { x: 200, y: 100 }, rootElement);\n+        \n+        var sequenceFlow = elementRegistry.get('SequenceFlow_1'),\n+            sequenceFlowGfx = elementRegistry.getGraphics(sequenceFlow);\n+\n+        var originalWaypoints = sequenceFlow.waypoints;\n+\n+        // when - select both tasks and move them onto the sequence flow\n+        selection.select([createdTask1, createdTask2]);\n+\n+        move.start(canvasEvent({ x: 0, y: 0 }), [createdTask1, createdTask2]);\n+\n+        dragging.hover({\n+          element: sequenceFlow,\n+          gfx: sequenceFlowGfx\n+        });\n+\n+        dragging.move(canvasEvent({ x: 240, y: 20 }));\n+        dragging.end();\n+\n+        // then - both tasks should have connections\n+        // Task 1 should be connected\n+        expect(createdTask1.incoming.length).to.be.greaterThan(0);\n+        expect(createdTask1.outgoing.length).to.be.greaterThan(0);\n+        \n+        // Task 2 should also be connected\n+        expect(createdTask2.incoming.length).to.be.greaterThan(0);\n+        expect(createdTask2.outgoing.length).to.be.greaterThan(0);\n+      }\n+    ));\n+\n+    it('should handle shapes that do not intersect with connection', inject(\n+      function(dragging, move, elementRegistry, selection, elementFactory, modeling) {\n+\n+        // given - create two tasks, one will intersect, one won't\n+        var task1 = elementFactory.createShape({ type: 'bpmn:Task' });\n+        var task2 = elementFactory.createShape({ type: 'bpmn:Task' });\n+        \n+        var rootElement = elementRegistry.get('Process');\n+        \n+        // Create the tasks first\n+        var createdTask1 = modeling.createShape(task1, { x: 100, y: 100 }, rootElement);\n+        var createdTask2 = modeling.createShape(task2, { x: 100, y: 200 }, rootElement); // Far from connection\n+        \n+        var sequenceFlow = elementRegistry.get('SequenceFlow_1'),\n+            sequenceFlowGfx = elementRegistry.getGraphics(sequenceFlow);\n+\n+        // when - select both tasks and move them\n+        selection.select([createdTask1, createdTask2]);\n+\n+        move.start(canvasEvent({ x: 0, y: 0 }), [createdTask1, createdTask2]);\n+\n+        dragging.hover({\n+          element: sequenceFlow,\n+          gfx: sequenceFlowGfx\n+        });\n+\n+        // Move task1 to intersect with connection, task2 will be moved but not intersect\n+        dragging.move(canvasEvent({ x: 240, y: 20 }));\n+        dragging.end();\n+\n+        // then - only task1 should have the drop-on-flow behavior\n+        // Task 1 should be connected (intersects with flow)\n+        expect(createdTask1.incoming.length).to.be.greaterThan(0);\n+        expect(createdTask1.outgoing.length).to.be.greaterThan(0);\n+        \n+        // Task 2 should not be connected (doesn't intersect with flow)\n+        expect(createdTask2.incoming.length).to.equal(0);\n+        expect(createdTask2.outgoing.length).to.equal(0);\n+      }\n+    ));\n+\n+    it('should maintain backward compatibility for single shape', inject(\n+      function(dragging, move, elementRegistry, selection, elementFactory, modeling) {\n+\n+        // given - create one task (single shape scenario)\n+        var task1 = elementFactory.createShape({ type: 'bpmn:Task' });\n+        \n+        var rootElement = elementRegistry.get('Process');\n+        \n+        // Create the task first\n+        var createdTask1 = modeling.createShape(task1, { x: 100, y: 100 }, rootElement);\n+        \n+        var sequenceFlow = elementRegistry.get('SequenceFlow_1'),\n+            sequenceFlowGfx = elementRegistry.getGraphics(sequenceFlow);\n+\n+        // when - move single task onto the sequence flow\n+        selection.select(createdTask1);\n+\n+        move.start(canvasEvent({ x: 0, y: 0 }), createdTask1);\n+\n+        dragging.hover({\n+          element: sequenceFlow,\n+          gfx: sequenceFlowGfx\n+        });\n+\n+        dragging.move(canvasEvent({ x: 240, y: 20 }));\n+        dragging.end();\n+\n+        // then - task should be connected (backward compatibility)\n+        expect(createdTask1.incoming.length).to.be.greaterThan(0);\n+        expect(createdTask1.outgoing.length).to.be.greaterThan(0);\n+      }\n+    ));\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

rc/ol/webgl/PostProcessingPass.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/vec/mat4.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/Builder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/TextBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/ImageBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/LineStringBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/PolygonBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/source/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/reproj.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/reproj/Triangulation.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:16] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:15:37] \"GET /test_simple.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:12] \"GET /examples/ HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:16] \"GET /examples/icon-negative.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/ HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/examples-info.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/resources/logo-70x70.png HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/index.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/resources/layout.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:27] \"GET /examples/Jugl.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:36] \"GET /examples/?q=icon HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 09:16:36] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 09:16:36] \"GET /examples/examples-info.js HTTP/1.1\" 404 -\ndiff --git a/src/ol/render/canvas/hitdetect.js b/src/ol/render/canvas/hitdetect.js\nindex eeddd2402..4163e60ff 100644\n--- a/src/ol/render/canvas/hitdetect.js\n+++ b/src/ol/render/canvas/hitdetect.js\n@@ -94,6 +94,16 @@ export function createHitDetectionImageData(\n         const height = imgSize ? imgSize[1] : img.height;\n         const iconContext = createCanvasContext2D(width, height);\n         iconContext.drawImage(img, 0, 0);\n+        // Handle negative scales properly for hit detection\n+        let hitDetectionScale = image.getScale();\n+        if (Array.isArray(hitDetectionScale)) {\n+          // For negative scales, we need to use absolute values for hit detection\n+          // because the hit detection canvas should match the visual bounds\n+          hitDetectionScale = [Math.abs(hitDetectionScale[0]), Math.abs(hitDetectionScale[1])];\n+        } else if (hitDetectionScale < 0) {\n+          hitDetectionScale = Math.abs(hitDetectionScale);\n+        }\n+        \n         style.setImage(\n           new Icon({\n             img: img,\n@@ -104,7 +114,7 @@ export function createHitDetectionImageData(\n             offset: image.getOrigin(),\n             size: image.getSize(),\n             opacity: image.getOpacity(),\n-            scale: image.getScale(),\n+            scale: hitDetectionScale,\n             rotation: image.getRotation(),\n             rotateWithView: image.getRotateWithView(),\n           })\ndiff --git a/test_negative_scale.html b/test_negative_scale.html\nnew file mode 100644\nindex 000000000..6c4e86880\n--- /dev/null\n+++ b/test_negative_scale.html\n@@ -0,0 +1,100 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Negative Scale Icon Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid black;\n+        }\n+        #result {\n+            margin-top: 10px;\n+            padding: 10px;\n+            border: 1px solid gray;\n+            background-color: #f0f0f0;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"result\">Click on the icon to test hit detection</div>\n+\n+    <script type=\"module\">\n+        import Feature from './src/ol/Feature.js';\n+        import Map from './src/ol/Map.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import View from './src/ol/View.js';\n+        import {Icon, Style} from './src/ol/style.js';\n+        import {Tile as TileLayer, Vector as VectorLayer} from './src/ol/layer.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        // Create a simple icon using a data URL (a red square)\n+        const iconDataUrl = 'data:image/svg+xml;base64,' + btoa(`\n+            <svg width=\"32\" height=\"32\" xmlns=\"http://www.w3.org/2000/svg\">\n+                <rect width=\"32\" height=\"32\" fill=\"red\"/>\n+                <text x=\"16\" y=\"20\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\">ICON</text>\n+            </svg>\n+        `);\n+\n+        // Create feature with negative scale icon\n+        const iconFeature = new Feature({\n+            geometry: new Point([0, 0])\n+        });\n+\n+        const iconStyle = new Style({\n+            image: new Icon({\n+                src: iconDataUrl,\n+                scale: [-1, 1], // Negative X scale\n+                rotation: 0,    // Zero rotation - this is when the bug occurs\n+                anchor: [0.5, 0.5]\n+            })\n+        });\n+\n+        iconFeature.setStyle(iconStyle);\n+\n+        const vectorSource = new VectorSource({\n+            features: [iconFeature]\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 4\n+            })\n+        });\n+\n+        const resultDiv = document.getElementById('result');\n+\n+        // Test hit detection\n+        map.on('click', function(evt) {\n+            const features = map.getFeaturesAtPixel(evt.pixel);\n+            if (features && features.length > 0) {\n+                resultDiv.innerHTML = 'HIT: Feature detected at click position';\n+                resultDiv.style.backgroundColor = '#d4edda';\n+            } else {\n+                resultDiv.innerHTML = 'MISS: No feature detected at click position';\n+                resultDiv.style.backgroundColor = '#f8d7da';\n+            }\n+        });\n+\n+        // Add cursor change on hover\n+        map.on('pointermove', function(evt) {\n+            const hit = map.hasFeatureAtPixel(evt.pixel);\n+            map.getTargetElement().style.cursor = hit ? 'pointer' : '';\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_negative_scale_fix.js b/test_negative_scale_fix.js\nnew file mode 100644\nindex 000000000..c69e40933\n--- /dev/null\n+++ b/test_negative_scale_fix.js\n@@ -0,0 +1,88 @@\n+/**\n+ * Test for negative scale icon hit detection fix\n+ */\n+\n+// Mock the necessary OpenLayers modules for testing\n+const mockIcon = {\n+  getScale: () => [-1, 1], // Negative X scale\n+  getAnchor: () => [0.5, 0.5],\n+  getOrigin: () => [0, 0],\n+  getSize: () => [32, 32],\n+  getOpacity: () => 1,\n+  getRotation: () => 0,\n+  getRotateWithView: () => false,\n+  getImageSize: () => [32, 32]\n+};\n+\n+// Test the fix logic\n+function testNegativeScaleFix() {\n+  console.log('Testing negative scale fix...');\n+  \n+  // Simulate the original problematic code\n+  const originalScale = mockIcon.getScale();\n+  console.log('Original scale:', originalScale);\n+  \n+  // Apply the fix logic\n+  let hitDetectionScale = originalScale;\n+  if (Array.isArray(hitDetectionScale)) {\n+    // For negative scales, we need to use absolute values for hit detection\n+    // because the hit detection canvas should match the visual bounds\n+    hitDetectionScale = [Math.abs(hitDetectionScale[0]), Math.abs(hitDetectionScale[1])];\n+  } else if (hitDetectionScale < 0) {\n+    hitDetectionScale = Math.abs(hitDetectionScale);\n+  }\n+  \n+  console.log('Hit detection scale after fix:', hitDetectionScale);\n+  \n+  // Verify the fix\n+  const expectedScale = [1, 1]; // Should be absolute values\n+  const isFixed = JSON.stringify(hitDetectionScale) === JSON.stringify(expectedScale);\n+  \n+  console.log('Fix verification:', isFixed ? 'PASS' : 'FAIL');\n+  \n+  return isFixed;\n+}\n+\n+// Test with different scale scenarios\n+function testVariousScales() {\n+  console.log('\\nTesting various scale scenarios...');\n+  \n+  const testCases = [\n+    { input: [-1, 1], expected: [1, 1], description: 'Negative X scale' },\n+    { input: [1, -1], expected: [1, 1], description: 'Negative Y scale' },\n+    { input: [-1, -1], expected: [1, 1], description: 'Both negative scales' },\n+    { input: [2, 2], expected: [2, 2], description: 'Positive scales' },\n+    { input: -1, expected: 1, description: 'Single negative scale' },\n+    { input: 2, expected: 2, description: 'Single positive scale' }\n+  ];\n+  \n+  let allPassed = true;\n+  \n+  testCases.forEach((testCase, index) => {\n+    let hitDetectionScale = testCase.input;\n+    \n+    // Apply fix logic\n+    if (Array.isArray(hitDetectionScale)) {\n+      hitDetectionScale = [Math.abs(hitDetectionScale[0]), Math.abs(hitDetectionScale[1])];\n+    } else if (hitDetectionScale < 0) {\n+      hitDetectionScale = Math.abs(hitDetectionScale);\n+    }\n+    \n+    const passed = JSON.stringify(hitDetectionScale) === JSON.stringify(testCase.expected);\n+    console.log(`Test ${index + 1} (${testCase.description}): ${passed ? 'PASS' : 'FAIL'}`);\n+    console.log(`  Input: ${JSON.stringify(testCase.input)}, Output: ${JSON.stringify(hitDetectionScale)}, Expected: ${JSON.stringify(testCase.expected)}`);\n+    \n+    if (!passed) allPassed = false;\n+  });\n+  \n+  return allPassed;\n+}\n+\n+// Run tests\n+const basicTest = testNegativeScaleFix();\n+const comprehensiveTest = testVariousScales();\n+\n+console.log('\\n=== TEST RESULTS ===');\n+console.log('Basic negative scale fix:', basicTest ? 'PASS' : 'FAIL');\n+console.log('Comprehensive scale tests:', comprehensiveTest ? 'PASS' : 'FAIL');\n+console.log('Overall result:', (basicTest && comprehensiveTest) ? 'ALL TESTS PASSED' : 'SOME TESTS FAILED');\n\\ No newline at end of file\ndiff --git a/test_negative_scale_repo.html b/test_negative_scale_repo.html\nnew file mode 100644\nindex 000000000..8b0f3bb59\n--- /dev/null\n+++ b/test_negative_scale_repo.html\n@@ -0,0 +1,93 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Negative Scale Test - Repository Version</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid black;\n+        }\n+        #result {\n+            margin-top: 10px;\n+            padding: 10px;\n+            border: 1px solid gray;\n+            background-color: #f0f0f0;\n+        }\n+    </style>\n+    <script src=\"./build/legacy/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"./build/legacy/ol.css\">\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"result\">Click on the icon to test hit detection</div>\n+\n+    <script>\n+        // Create a simple icon using a data URL (a red square)\n+        const iconDataUrl = 'data:image/svg+xml;base64,' + btoa(`\n+            <svg width=\"32\" height=\"32\" xmlns=\"http://www.w3.org/2000/svg\">\n+                <rect width=\"32\" height=\"32\" fill=\"red\"/>\n+                <text x=\"16\" y=\"20\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\">ICON</text>\n+            </svg>\n+        `);\n+\n+        // Create feature with negative scale icon\n+        const iconFeature = new ol.Feature({\n+            geometry: new ol.geom.Point([0, 0])\n+        });\n+\n+        const iconStyle = new ol.style.Style({\n+            image: new ol.style.Icon({\n+                src: iconDataUrl,\n+                scale: [-1, 1], // Negative X scale\n+                rotation: 0,    // Zero rotation - this is when the bug occurs\n+                anchor: [0.5, 0.5]\n+            })\n+        });\n+\n+        iconFeature.setStyle(iconStyle);\n+\n+        const vectorSource = new ol.source.Vector({\n+            features: [iconFeature]\n+        });\n+\n+        const vectorLayer = new ol.layer.Vector({\n+            source: vectorSource\n+        });\n+\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 4\n+            })\n+        });\n+\n+        const resultDiv = document.getElementById('result');\n+\n+        // Test hit detection\n+        map.on('click', function(evt) {\n+            const features = map.getFeaturesAtPixel(evt.pixel);\n+            if (features && features.length > 0) {\n+                resultDiv.innerHTML = 'HIT: Feature detected at click position';\n+                resultDiv.style.backgroundColor = '#d4edda';\n+            } else {\n+                resultDiv.innerHTML = 'MISS: No feature detected at click position';\n+                resultDiv.style.backgroundColor = '#f8d7da';\n+            }\n+        });\n+\n+        // Add cursor change on hover\n+        map.on('pointermove', function(evt) {\n+            const hit = map.hasFeatureAtPixel(evt.pixel);\n+            map.getTargetElement().style.cursor = hit ? 'pointer' : '';\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple.html b/test_simple.html\nnew file mode 100644\nindex 000000000..213d06756\n--- /dev/null\n+++ b/test_simple.html\n@@ -0,0 +1,93 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Negative Scale Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid black;\n+        }\n+        #result {\n+            margin-top: 10px;\n+            padding: 10px;\n+            border: 1px solid gray;\n+            background-color: #f0f0f0;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/ol.css\">\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"result\">Click on the icon to test hit detection</div>\n+\n+    <script>\n+        // Create a simple icon using a data URL (a red square)\n+        const iconDataUrl = 'data:image/svg+xml;base64,' + btoa(`\n+            <svg width=\"32\" height=\"32\" xmlns=\"http://www.w3.org/2000/svg\">\n+                <rect width=\"32\" height=\"32\" fill=\"red\"/>\n+                <text x=\"16\" y=\"20\" text-anchor=\"middle\" fill=\"white\" font-size=\"12\">ICON</text>\n+            </svg>
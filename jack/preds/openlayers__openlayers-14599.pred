 11:33:03] \"GET /src/ol/geom/flat/simplify.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/Tile.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/Image.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/color.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/renderer/Layer.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/reproj/common.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/reproj/Triangulation.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/Disposable.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/style/IconImageCache.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/interaction/Interaction.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/interaction/Pointer.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/interaction/DragBox.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/events/condition.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/events/KeyCode.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/source/Tile.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/geom/Geometry.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/geom/flat/transform.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/ImageBase.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/ImageState.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/render/Box.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Mar/2026 11:33:03] \"GET /src/ol/source/Source.js HTTP/1.1\" 304 -\ndiff --git a/src/ol/control/Attribution.js b/src/ol/control/Attribution.js\nindex 0ca804a3a..e007b31d3 100644\n--- a/src/ol/control/Attribution.js\n+++ b/src/ol/control/Attribution.js\n@@ -192,18 +192,18 @@ class Attribution extends Control {\n   collectSourceAttributions_(frameState) {\n     const visibleAttributions = Array.from(\n       new Set(\n-        this.getMap()\n-          .getAllLayers()\n-          .flatMap((layer) => layer.getAttributions(frameState))\n+        frameState.layerStatesArray\n+          .filter((layerState) => layerState.visible)\n+          .flatMap((layerState) => layerState.layer.getAttributions(frameState))\n       )\n     );\n \n-    const collapsible = !this.getMap()\n-      .getAllLayers()\n+    const collapsible = !frameState.layerStatesArray\n+      .filter((layerState) => layerState.visible)\n       .some(\n-        (layer) =>\n-          layer.getSource() &&\n-          layer.getSource().getAttributionsCollapsible() === false\n+        (layerState) =>\n+          layerState.layer.getSource() &&\n+          layerState.layer.getSource().getAttributionsCollapsible() === false\n       );\n     if (!this.overrideCollapsible_) {\n       this.setCollapsible(collapsible);\ndiff --git a/test_attribution_group_visibility.html b/test_attribution_group_visibility.html\nnew file mode 100644\nindex 000000000..956567d1d\n--- /dev/null\n+++ b/test_attribution_group_visibility.html\n@@ -0,0 +1,173 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Attribution Group Visibility Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        .controls button { margin: 5px; padding: 10px; }\n+        .test-results { margin: 20px 0; padding: 10px; border: 1px solid #ddd; }\n+        .error { color: red; }\n+        .success { color: green; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Attribution Group Visibility Test</h1>\n+    <div class=\"controls\">\n+        <button onclick=\"toggleGroupVisibility()\">Toggle Group Visibility</button>\n+        <button onclick=\"toggleLayerVisibility()\">Toggle Layer Visibility</button>\n+        <button onclick=\"runTest()\">Run Test</button>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div class=\"test-results\" id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import LayerGroup from './src/ol/layer/Group.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import TileWMS from './src/ol/source/TileWMS.js';\n+        import Attribution from './src/ol/control/Attribution.js';\n+\n+        // Create a mock WMS source with attributions\n+        const wmsSource = new TileWMS({\n+            url: 'https://demo.boundlessgeo.com/geoserver/wms',\n+            params: { 'LAYERS': 'ne:ne' },\n+            serverType: 'geoserver',\n+            attributions: ['Test Attribution: This should not show when group is invisible']\n+        });\n+\n+        // Create the layer with attributions\n+        const wmsLayer = new TileLayer({\n+            source: wmsSource,\n+            visible: true,\n+            title: 'WMS Layer with Attribution'\n+        });\n+\n+        // Create a group layer\n+        const groupLayer = new LayerGroup({\n+            visible: false, // Initially invisible\n+            layers: [wmsLayer]\n+        });\n+\n+        // Create base layer\n+        const baseLayer = new TileLayer({\n+            source: new OSM(),\n+            title: 'Base Layer'\n+        });\n+\n+        // Create attribution control\n+        const attributionControl = new Attribution({\n+            collapsible: false\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [baseLayer, groupLayer],\n+            controls: [attributionControl],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Global variables for testing\n+        window.map = map;\n+        window.groupLayer = groupLayer;\n+        window.wmsLayer = wmsLayer;\n+        window.attributionControl = attributionControl;\n+\n+        window.toggleGroupVisibility = function() {\n+            const visible = groupLayer.getVisible();\n+            groupLayer.setVisible(!visible);\n+            updateStatus();\n+        };\n+\n+        window.toggleLayerVisibility = function() {\n+            const visible = wmsLayer.getVisible();\n+            wmsLayer.setVisible(!visible);\n+            updateStatus();\n+        };\n+\n+        window.runTest = function() {\n+            const results = document.getElementById('results');\n+            results.innerHTML = '<h3>Test Results:</h3>';\n+            \n+            // Test case 1: Group invisible, layer visible\n+            groupLayer.setVisible(false);\n+            wmsLayer.setVisible(true);\n+            \n+            // Force attribution update\n+            map.render();\n+            \n+            // Get current attributions\n+            const frameState = map.getFrameState();\n+            const attributions = attributionControl.collectSourceAttributions_(frameState);\n+            \n+            const hasAttribution = attributions.some(attr => attr.includes('Test Attribution'));\n+            \n+            results.innerHTML += `\n+                <div>\n+                    <strong>Test Case 1:</strong> Group invisible (false), Layer visible (true)<br>\n+                    <strong>Expected:</strong> No attributions should be displayed<br>\n+                    <strong>Actual:</strong> ${hasAttribution ? 'Attributions ARE displayed' : 'No attributions displayed'}<br>\n+                    <strong>Result:</strong> <span class=\"${hasAttribution ? 'error' : 'success'}\">${hasAttribution ? 'FAIL - Bug reproduced!' : 'PASS'}</span>\n+                </div>\n+            `;\n+            \n+            // Test case 2: Group visible, layer visible\n+            groupLayer.setVisible(true);\n+            wmsLayer.setVisible(true);\n+            map.render();\n+            \n+            const frameState2 = map.getFrameState();\n+            const attributions2 = attributionControl.collectSourceAttributions_(frameState2);\n+            const hasAttribution2 = attributions2.some(attr => attr.includes('Test Attribution'));\n+            \n+            results.innerHTML += `\n+                <div style=\"margin-top: 10px;\">\n+                    <strong>Test Case 2:</strong> Group visible (true), Layer visible (true)<br>\n+                    <strong>Expected:</strong> Attributions should be displayed<br>\n+                    <strong>Actual:</strong> ${hasAttribution2 ? 'Attributions ARE displayed' : 'No attributions displayed'}<br>\n+                    <strong>Result:</strong> <span class=\"${hasAttribution2 ? 'success' : 'error'}\">${hasAttribution2 ? 'PASS' : 'FAIL'}</span>\n+                </div>\n+            `;\n+            \n+            // Test case 3: Group visible, layer invisible\n+            groupLayer.setVisible(true);\n+            wmsLayer.setVisible(false);\n+            map.render();\n+            \n+            const frameState3 = map.getFrameState();\n+            const attributions3 = attributionControl.collectSourceAttributions_(frameState3);\n+            const hasAttribution3 = attributions3.some(attr => attr.includes('Test Attribution'));\n+            \n+            results.innerHTML += `\n+                <div style=\"margin-top: 10px;\">\n+                    <strong>Test Case 3:</strong> Group visible (true), Layer invisible (false)<br>\n+                    <strong>Expected:</strong> No attributions should be displayed<br>\n+                    <strong>Actual:</strong> ${hasAttribution3 ? 'Attributions ARE displayed' : 'No attributions displayed'}<br>\n+                    <strong>Result:</strong> <span class=\"${hasAttribution3 ? 'error' : 'success'}\">${hasAttribution3 ? 'FAIL' : 'PASS'}</span>\n+                </div>\n+            `;\n+        };\n+\n+        function updateStatus() {\n+            const groupVisible = groupLayer.getVisible();\n+            const layerVisible = wmsLayer.getVisible();\n+            console.log(`Group visible: ${groupVisible}, Layer visible: ${layerVisible}`);\n+        }\n+\n+        // Initial status\n+        updateStatus();\n+        \n+        // Run test automatically after a short delay\n+        setTimeout(() => {\n+            window.runTest();\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_comprehensive_attribution.html b/test_comprehensive_attribution.html\nnew file mode 100644\nindex 000000000..70b623954\n--- /dev/null\n+++ b/test_comprehensive_attribution.html\n@@ -0,0 +1,270 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Comprehensive Attribution Group Visibility Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        .controls button { margin: 5px; padding: 10px; }\n+        .test-results { margin: 20px 0; padding: 10px; border: 1px solid #ddd; }\n+        .error { color: red; }\n+        .success { color: green; }\n+        .test-case { margin: 10px 0; padding: 10px; border: 1px solid #eee; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Comprehensive Attribution Group Visibility Test</h1>\n+    <div class=\"controls\">\n+        <button onclick=\"runAllTests()\">Run All Tests</button>\n+        <button onclick=\"toggleNestedGroup()\">Toggle Nested Group</button>\n+        <button onclick=\"toggleParentGroup()\">Toggle Parent Group</button>\n+    </div>\n+    <div id=\"map\"></div>\n+    <div class=\"test-results\" id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import LayerGroup from './src/ol/layer/Group.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import TileWMS from './src/ol/source/TileWMS.js';\n+        import Attribution from './src/ol/control/Attribution.js';\n+\n+        // Create mock WMS sources with different attributions\n+        const wmsSource1 = new TileWMS({\n+            url: 'https://demo.boundlessgeo.com/geoserver/wms',\n+            params: { 'LAYERS': 'layer1' },\n+            attributions: ['Attribution 1: Should show when parent group visible']\n+        });\n+\n+        const wmsSource2 = new TileWMS({\n+            url: 'https://demo.boundlessgeo.com/geoserver/wms',\n+            params: { 'LAYERS': 'layer2' },\n+            attributions: ['Attribution 2: Should show when nested group visible']\n+        });\n+\n+        const wmsSource3 = new TileWMS({\n+            url: 'https://demo.boundlessgeo.com/geoserver/wms',\n+            params: { 'LAYERS': 'layer3' },\n+            attributions: ['Attribution 3: Should show when both groups visible']\n+        });\n+\n+        // Create layers\n+        const layer1 = new TileLayer({\n+            source: wmsSource1,\n+            visible: true,\n+            title: 'Layer 1'\n+        });\n+\n+        const layer2 = new TileLayer({\n+            source: wmsSource2,\n+            visible: true,\n+            title: 'Layer 2'\n+        });\n+\n+        const layer3 = new TileLayer({\n+            source: wmsSource3,\n+            visible: true,\n+            title: 'Layer 3'\n+        });\n+\n+        // Create nested group structure\n+        const nestedGroup = new LayerGroup({\n+            visible: true,\n+            layers: [layer2, layer3],\n+            title: 'Nested Group'\n+        });\n+\n+        const parentGroup = new LayerGroup({\n+            visible: true,\n+            layers: [layer1, nestedGroup],\n+            title: 'Parent Group'\n+        });\n+\n+        // Create base layer\n+        const baseLayer = new TileLayer({\n+            source: new OSM(),\n+            title: 'Base Layer'\n+        });\n+\n+        // Create attribution control\n+        const attributionControl = new Attribution({\n+            collapsible: false\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [baseLayer, parentGroup],\n+            controls: [attributionControl],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Global variables for testing\n+        window.map = map;\n+        window.parentGroup = parentGroup;\n+        window.nestedGroup = nestedGroup;\n+        window.layer1 = layer1;\n+        window.layer2 = layer2;\n+        window.layer3 = layer3;\n+        window.attributionControl = attributionControl;\n+\n+        window.toggleNestedGroup = function() {\n+            const visible = nestedGroup.getVisible();\n+            nestedGroup.setVisible(!visible);\n+            console.log(`Nested group visibility: ${!visible}`);\n+        };\n+\n+        window.toggleParentGroup = function() {\n+            const visible = parentGroup.getVisible();\n+            parentGroup.setVisible(!visible);\n+            console.log(`Parent group visibility: ${!visible}`);\n+        };\n+\n+        function getAttributions() {\n+            const frameState = map.getFrameState();\n+            return attributionControl.collectSourceAttributions_(frameState);\n+        }\n+\n+        function hasAttribution(text) {\n+            const attributions = getAttributions();\n+            return attributions.some(attr => attr.includes(text));\n+        }\n+\n+        window.runAllTests = function() {\n+            const results = document.getElementById('results');\n+            results.innerHTML = '<h3>Comprehensive Test Results:</h3>';\n+            \n+            let testCount = 0;\n+            let passCount = 0;\n+\n+            function addTestResult(testName, expected, actual, passed) {\n+                testCount++;\n+                if (passed) passCount++;\n+                \n+                results.innerHTML += `\n+                    <div class=\"test-case\">\n+                        <strong>Test ${testCount}: ${testName}</strong><br>\n+                        <strong>Expected:</strong> ${expected}<br>\n+                        <strong>Actual:</strong> ${actual}<br>\n+                        <strong>Result:</strong> <span class=\"${passed ? 'success' : 'error'}\">${passed ? 'PASS' : 'FAIL'}</span>\n+                    </div>\n+                `;\n+            }\n+\n+            // Test 1: All visible\n+            parentGroup.setVisible(true);\n+            nestedGroup.setVisible(true);\n+            layer1.setVisible(true);\n+            layer2.setVisible(true);\n+            layer3.setVisible(true);\n+            map.render();\n+            \n+            const hasAttr1 = hasAttribution('Attribution 1');\n+            const hasAttr2 = hasAttribution('Attribution 2');\n+            const hasAttr3 = hasAttribution('Attribution 3');\n+            \n+            addTestResult(\n+                'All groups and layers visible',\n+                'All 3 attributions should be displayed',\n+                `Attribution 1: ${hasAttr1}, Attribution 2: ${hasAttr2}, Attribution 3: ${hasAttr3}`,\n+                hasAttr1 && hasAttr2 && hasAttr3\n+            );\n+\n+            // Test 2: Parent group invisible\n+            parentGroup.setVisible(false);\n+            nestedGroup.setVisible(true);\n+            layer1.setVisible(true);\n+            layer2.setVisible(true);\n+            layer3.setVisible(true);\n+            map.render();\n+            \n+            const hasAttr1_t2 = hasAttribution('Attribution 1');\n+            const hasAttr2_t2 = hasAttribution('Attribution 2');\n+            const hasAttr3_t2 = hasAttribution('Attribution 3');\n+            \n+            addTestResult(\n+                'Parent group invisible, nested group visible',\n+                'No attributions should be displayed',\n+                `Attribution 1: ${hasAttr1_t2}, Attribution 2: ${hasAttr2_t2}, Attribution 3: ${hasAttr3_t2}`,\n+                !hasAttr1_t2 && !hasAttr2_t2 && !hasAttr3_t2\n+            );\n+\n+            // Test 3: Parent visible, nested invisible\n+            parentGroup.setVisible(true);\n+            nestedGroup.setVisible(false);\n+            layer1.setVisible(true);\n+            layer2.setVisible(true);\n+            layer3.setVisible(true);\n+            map.render();\n+            \n+            const hasAttr1_t3 = hasAttribution('Attribution 1');\n+            const hasAttr2_t3 = hasAttribution('Attribution 2');\n+            const hasAttr3_t3 = hasAttribution('Attribution 3');\n+            \n+            addTestResult(\n+                'Parent group visible, nested group invisible',\n+                'Only Attribution 1 should be displayed',\n+                `Attribution 1: ${hasAttr1_t3}, Attribution 2: ${hasAttr2_t3}, Attribution 3: ${hasAttr3_t3}`,\n+                hasAttr1_t3 && !hasAttr2_t3 && !hasAttr3_t3\n+            );\n+\n+            // Test 4: Individual layer visibility\n+            parentGroup.setVisible(true);\n+            nestedGroup.setVisible(true);\n+            layer1.setVisible(false);\n+            layer2.setVisible(true);\n+            layer3.setVisible(false);\n+            map.render();\n+            \n+            const hasAttr1_t4 = hasAttribution('Attribution 1');\n+            const hasAttr2_t4 = hasAttribution('Attribution 2');\n+            const hasAttr3_t4 = hasAttribution('Attribution 3');\n+            \n+            addTestResult(\n+                'Groups visible, but layer1 and layer3 invisible',\n+                'Only Attribution 2 should be displayed',\n+                `Attribution 1: ${hasAttr1_t4}, Attribution 2: ${hasAttr2_t4}, Attribution 3: ${hasAttr3_t4}`,\n+                !hasAttr1_t4 && hasAttr2_t4 && !hasAttr3_t4\n+            );\n+\n+            // Test 5: Complex scenario\n+            parentGroup.setVisible(true);\n+            nestedGroup.setVisible(false);\n+            layer1.setVisible(false);\n+            layer2.setVisible(true);\n+            layer3.setVisible(true);\n+            map.render();\n+            \n+            const hasAttr1_t5 = hasAttribution('Attribution 1');\n+            const hasAttr2_t5 = hasAttribution('Attribution 2');\n+            const hasAttr3_t5 = hasAttribution('Attribution 3');\n+            \n+            addTestResult(\n+                'Parent visible, nested invisible, layer1 invisible, layer2&3 visible',\n+                'No attributions should be displayed (nested group overrides layer visibility)',\n+                `Attribution 1: ${hasAttr1_t5}, Attribution 2: ${hasAttr2_t5}, Attribution 3: ${hasAttr3_t5}`,\n+                !hasAttr1_t5 && !hasAttr2_t5 && !hasAttr3_t5\n+            );\n+\n+            // Summary\n+            results.innerHTML += `\n+                <div style=\"margin-top: 20px; padding: 10px; border: 2px solid ${passCount === testCount ? 'green' : 'red'};\">\n+                    <strong>Summary: ${passCount}/${testCount} tests passed</strong><br>\n+                    ${passCount === testCount ? 'All tests PASSED! \u2705' : 'Some tests FAILED! \u274c'}\n+                </div>\n+            `;\n+        };\n+\n+        // Run tests automatically after a short delay\n+        setTimeout(() => {\n+            window.runAllTests();\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "bpmn-io__bpmn-js-1172", "model_patch": "diff --git a/lib/import/BpmnTreeWalker.js b/lib/import/BpmnTreeWalker.js\nindex 79aef1d9..e08cacaa 100644\n--- a/lib/import/BpmnTreeWalker.js\n+++ b/lib/import/BpmnTreeWalker.js\n@@ -249,7 +249,11 @@ export default function BpmnTreeWalker(handler, translate) {\n     handleFlowElementsContainer(process, context);\n     handleIoSpecification(process.ioSpecification, context);\n \n-    handleArtifacts(process.artifacts, context);\n+    // Process artifacts after all flow elements have been processed\n+    // This ensures that boundary events are fully processed before associations\n+    deferred.push(function() {\n+      handleArtifacts(process.artifacts, context);\n+    });\n \n     // log process handled\n     handled(process);\n@@ -300,6 +304,8 @@ export default function BpmnTreeWalker(handler, translate) {\n \n     forEach(artifacts, function(e) {\n       if (is(e, 'bpmn:Association')) {\n+        // Push associations to the end of the deferred queue\n+        // to ensure they are processed after all boundary events\n         deferred.push(function() {\n           handleArtifact(e, context);\n         });\n@@ -356,8 +362,15 @@ export default function BpmnTreeWalker(handler, translate) {\n     visitIfDi(dataObject, context);\n   }\n \n-  function handleBoundaryEvent(dataObject, context) {\n-    visitIfDi(dataObject, context);\n+  function handleBoundaryEvent(boundaryEvent, context) {\n+    var childCtx = visitIfDi(boundaryEvent, context);\n+    \n+    // defer handling of associations for boundary events\n+    // similar to how it's done for other flow nodes\n+    deferred.push(function() {\n+      forEach(boundaryEvent.dataInputAssociations, contextual(handleDataAssociation, context));\n+      forEach(boundaryEvent.dataOutputAssociations, contextual(handleDataAssociation, context));\n+    });\n   }\n \n   function handleLane(lane, context) {\n@@ -391,15 +404,21 @@ export default function BpmnTreeWalker(handler, translate) {\n   }\n \n   function handleFlowElements(flowElements, context) {\n+    // First, handle all boundary events to ensure they are processed before associations\n+    forEach(flowElements, function(e) {\n+      if (is(e, 'bpmn:BoundaryEvent')) {\n+        handleBoundaryEvent(e, context);\n+      }\n+    });\n+    \n+    // Then handle the rest of the flow elements\n     forEach(flowElements, function(e) {\n       if (is(e, 'bpmn:SequenceFlow')) {\n         deferred.push(function() {\n           handleSequenceFlow(e, context);\n         });\n       } else if (is(e, 'bpmn:BoundaryEvent')) {\n-        deferred.unshift(function() {\n-          handleBoundaryEvent(e, context);\n-        });\n+        // Already handled above\n       } else if (is(e, 'bpmn:FlowNode')) {\n         handleFlowNode(e, context);\n       } else if (is(e, 'bpmn:DataObject')) {\ndiff --git a/test-boundary-association-reload.html b/test-boundary-association-reload.html\nnew file mode 100644\nindex 00000000..9ef7d378\n--- /dev/null\n+++ b/test-boundary-association-reload.html\n@@ -0,0 +1,185 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\" />\n+  <title>Boundary Event Association Test</title>\n+\n+  <style>\n+    html, body {\n+      height: 100%;\n+      margin: 0;\n+      padding: 0;\n+    }\n+    \n+    .container {\n+      display: flex;\n+      flex-direction: column;\n+      height: 100%;\n+    }\n+    \n+    .buttons {\n+      padding: 10px;\n+      background-color: #f0f0f0;\n+    }\n+    \n+    .viewers {\n+      display: flex;\n+      flex: 1;\n+    }\n+    \n+    .viewer {\n+      flex: 1;\n+      height: 100%;\n+      border-right: 1px solid #ccc;\n+    }\n+    \n+    pre {\n+      margin: 0;\n+      padding: 10px;\n+      background-color: #f5f5f5;\n+      border-top: 1px solid #ccc;\n+      max-height: 200px;\n+      overflow: auto;\n+    }\n+  </style>\n+\n+  <script src=\"https://unpkg.com/bpmn-js@5.0.0/dist/bpmn-navigated-viewer.development.js\"></script>\n+</head>\n+<body>\n+  <div class=\"container\">\n+    <div class=\"buttons\">\n+      <button id=\"export-btn\">Export XML</button>\n+      <button id=\"import-btn\">Import XML</button>\n+      <button id=\"log-elements-btn\">Log Elements</button>\n+    </div>\n+    <div class=\"viewers\">\n+      <div id=\"canvas\" class=\"viewer\"></div>\n+    </div>\n+    <pre id=\"xml-output\"></pre>\n+    <pre id=\"console-output\"></pre>\n+  </div>\n+\n+  <script>\n+    const viewer = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    const boundaryEventAssociationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:task id=\"Task_1\" name=\"Task\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:task>\n+    <bpmn2:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal\" attachedToRef=\"Task_1\">\n+      <bpmn2:signalEventDefinition id=\"SignalEventDefinition_1\"/>\n+    </bpmn2:boundaryEvent>\n+    <bpmn2:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+    </bpmn2:task>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\"/>\n+    <bpmn2:dataObjectReference id=\"DataObjectReference_1\" name=\"Data Object\" dataObjectRef=\"DataObject_1\"/>\n+    <bpmn2:dataObject id=\"DataObject_1\"/>\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObjectReference_1\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"200.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_BoundaryEvent_1\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds height=\"36.0\" width=\"36.0\" x=\"200.0\" y=\"162.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_2\" bpmnElement=\"Task_2\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"350.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\" sourceElement=\"_BPMNShape_Task_1\" targetElement=\"_BPMNShape_Task_2\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"300.0\" y=\"140.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350.0\" y=\"140.0\"/>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_DataObjectReference_1\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds height=\"50.0\" width=\"36.0\" x=\"100.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_Association_1\" bpmnElement=\"Association_1\" sourceElement=\"_BPMNShape_BoundaryEvent_1\" targetElement=\"_BPMNShape_DataObjectReference_1\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"200.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"200.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"136.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+    let currentXML = boundaryEventAssociationXML;\n+\n+    // Import the XML\n+    viewer.importXML(currentXML, function(err) {\n+      if (err) {\n+        console.error('Error importing XML:', err);\n+        return;\n+      }\n+\n+      const canvas = viewer.get('canvas');\n+      canvas.zoom('fit-viewport');\n+      \n+      logElements();\n+    });\n+    \n+    // Export XML button\n+    document.getElementById('export-btn').addEventListener('click', function() {\n+      viewer.saveXML({ format: true }, function(err, xml) {\n+        if (err) {\n+          console.error('Error exporting XML:', err);\n+          return;\n+        }\n+        \n+        currentXML = xml;\n+        document.getElementById('xml-output').textContent = xml;\n+        log('XML exported successfully');\n+      });\n+    });\n+    \n+    // Import XML button\n+    document.getElementById('import-btn').addEventListener('click', function() {\n+      viewer.importXML(currentXML, function(err) {\n+        if (err) {\n+          console.error('Error importing XML:', err);\n+          return;\n+        }\n+        \n+        const canvas = viewer.get('canvas');\n+        canvas.zoom('fit-viewport');\n+        \n+        log('XML imported successfully');\n+        logElements();\n+      });\n+    });\n+    \n+    // Log Elements button\n+    document.getElementById('log-elements-btn').addEventListener('click', function() {\n+      logElements();\n+    });\n+    \n+    function logElements() {\n+      const elementRegistry = viewer.get('elementRegistry');\n+      const association = elementRegistry.get('Association_1');\n+      const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+      const dataObject = elementRegistry.get('DataObjectReference_1');\n+      \n+      log('Association: ' + (association ? 'Found' : 'Not Found'));\n+      if (association) {\n+        log('  - Source: ' + (association.source ? association.source.id : 'None'));\n+        log('  - Target: ' + (association.target ? association.target.id : 'None'));\n+      }\n+      \n+      log('Boundary Event: ' + (boundaryEvent ? 'Found' : 'Not Found'));\n+      log('Data Object: ' + (dataObject ? 'Found' : 'Not Found'));\n+    }\n+    \n+    function log(message) {\n+      const consoleOutput = document.getElementById('console-output');\n+      consoleOutput.textContent += message + '\\n';\n+      console.log(message);\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-boundary-association.html b/test-boundary-association.html\nnew file mode 100644\nindex 00000000..fcf5cf4e\n--- /dev/null\n+++ b/test-boundary-association.html\n@@ -0,0 +1,89 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <meta charset=\"UTF-8\" />\n+  <title>Boundary Event Association Test</title>\n+\n+  <style>\n+    html, body, #canvas {\n+      height: 100%;\n+      margin: 0;\n+      padding: 0;\n+    }\n+  </style>\n+\n+  <script src=\"https://unpkg.com/bpmn-js@5.0.0/dist/bpmn-navigated-viewer.development.js\"></script>\n+</head>\n+<body>\n+  <div id=\"canvas\"></div>\n+\n+  <script>\n+    const viewer = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    const boundaryEventAssociationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:task id=\"Task_1\" name=\"Task\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:task>\n+    <bpmn2:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal\" attachedToRef=\"Task_1\">\n+      <bpmn2:signalEventDefinition id=\"SignalEventDefinition_1\"/>\n+    </bpmn2:boundaryEvent>\n+    <bpmn2:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+    </bpmn2:task>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\"/>\n+    <bpmn2:dataObjectReference id=\"DataObjectReference_1\" name=\"Data Object\" dataObjectRef=\"DataObject_1\"/>\n+    <bpmn2:dataObject id=\"DataObject_1\"/>\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObjectReference_1\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"200.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_BoundaryEvent_1\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds height=\"36.0\" width=\"36.0\" x=\"200.0\" y=\"162.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_2\" bpmnElement=\"Task_2\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"350.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\" sourceElement=\"_BPMNShape_Task_1\" targetElement=\"_BPMNShape_Task_2\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"300.0\" y=\"140.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350.0\" y=\"140.0\"/>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_DataObjectReference_1\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds height=\"50.0\" width=\"36.0\" x=\"100.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_Association_1\" bpmnElement=\"Association_1\" sourceElement=\"_BPMNShape_BoundaryEvent_1\" targetElement=\"_BPMNShape_DataObjectReference_1\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"200.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"200.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"136.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+    // Import the XML\n+    viewer.importXML(boundaryEventAssociationXML, function(err) {\n+      if (err) {\n+        console.error('Error importing XML:', err);\n+        return;\n+      }\n+\n+      const canvas = viewer.get('canvas');\n+      canvas.zoom('fit-viewport');\n+\n+      // Log all elements to check if the association is present\n+      const elementRegistry = viewer.get('elementRegistry');\n+      console.log('All elements:', elementRegistry.getAll());\n+      console.log('Association:', elementRegistry.get('Association_1'));\n+      console.log('Boundary Event:', elementRegistry.get('BoundaryEvent_1'));\n+      console.log('Data Object:', elementRegistry.get('DataObjectReference_1'));\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/import/elements/BoundaryEventAssociationSpec.bpmn b/test/spec/import/elements/BoundaryEventAssociationSpec.bpmn\nnew file mode 100644\nindex 00000000..340893d9\n--- /dev/null\n+++ b/test/spec/import/elements/BoundaryEventAssociationSpec.bpmn\n@@ -0,0 +1,44 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:task id=\"Task_1\" name=\"Task\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:task>\n+    <bpmn2:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal\" attachedToRef=\"Task_1\">\n+      <bpmn2:signalEventDefinition id=\"SignalEventDefinition_1\"/>\n+    </bpmn2:boundaryEvent>\n+    <bpmn2:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+    </bpmn2:task>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\"/>\n+    <bpmn2:dataObjectReference id=\"DataObjectReference_1\" name=\"Data Object\" dataObjectRef=\"DataObject_1\"/>\n+    <bpmn2:dataObject id=\"DataObject_1\"/>\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObjectReference_1\"/>\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"200.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_BoundaryEvent_1\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds height=\"36.0\" width=\"36.0\" x=\"200.0\" y=\"162.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_2\" bpmnElement=\"Task_2\">\n+        <dc:Bounds height=\"80.0\" width=\"100.0\" x=\"350.0\" y=\"100.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\" sourceElement=\"_BPMNShape_Task_1\" targetElement=\"_BPMNShape_Task_2\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"300.0\" y=\"140.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350.0\" y=\"140.0\"/>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_DataObjectReference_1\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds height=\"50.0\" width=\"36.0\" x=\"100.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_Association_1\" bpmnElement=\"Association_1\" sourceElement=\"_BPMNShape_BoundaryEvent_1\" targetElement=\"_BPMNShape_DataObjectReference_1\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"200.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"180.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"150.0\" y=\"200.0\"/>\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"136.0\" y=\"200.0\"/>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/import/elements/BoundaryEventAssociationSpec.js b/test/spec/import/elements/BoundaryEventAssociationSpec.js\nnew file mode 100644\nindex 00000000..774303fb\n--- /dev/null\n+++ b/test/spec/import/elements/BoundaryEventAssociationSpec.js\n@@ -0,0 +1,37 @@\n+import {\n+  bootstrapViewer,\n+  inject\n+} from 'test/TestHelper';\n+\n+describe('import - boundary event associations', function() {\n+\n+  describe('should import association from boundary event', function() {\n+\n+    it('connecting boundary event -> data object', function(done) {\n+\n+      var xml = require('./BoundaryEventAssociationSpec.bpmn');\n+\n+      // given\n+      bootstrapViewer(xml)(function(err) {\n+\n+        // when\n+        inject(function(elementRegistry) {\n+\n+          var association = elementRegistry.get('Association_1');\n+          var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+          var dataObject = elementRegistry.get('DataObjectReference_1');\n+\n+          // then\n+          expect(association).to.exist;\n+          expect(association.source).to.equal(boundaryEvent);\n+          expect(association.target).to.equal(dataObject);\n+\n+          done(err);\n+        })();\n+\n+      });\n+    });\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

{"instance_id": "openlayers__openlayers-12172", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..50de59a48\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,22 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /test_displacement_clipping.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/source/Vector.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/View.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/layer/Vector.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/Map.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/Feature.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/geom/Point.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/style/Style.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/style/RegularShape.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/style/Icon.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Mar/2026 19:56:56] code 404, message File not found\n+127.0.0.1 - - [03/Mar/2026 19:56:56] \"GET /build/ol/src/ol/style/Fill.js HTTP/1.1\" 404 -\ndiff --git a/src/ol/render/canvas/ImageBuilder.js b/src/ol/render/canvas/ImageBuilder.js\nindex 9df168dce..e7f423b00 100644\n--- a/src/ol/render/canvas/ImageBuilder.js\n+++ b/src/ol/render/canvas/ImageBuilder.js\n@@ -3,6 +3,7 @@\n  */\n import CanvasBuilder from './Builder.js';\n import CanvasInstruction from './Instruction.js';\n+import {buffer, clone} from '../../extent.js';\n \n class CanvasImageBuilder extends CanvasBuilder {\n   /**\n@@ -98,6 +99,12 @@ class CanvasImageBuilder extends CanvasBuilder {\n      * @type {import(\"../canvas.js\").DeclutterImageWithText}\n      */\n     this.declutterImageWithText_ = undefined;\n+\n+    /**\n+     * @private\n+     * @type {Array<number>}\n+     */\n+    this.displacement_ = [0, 0];\n   }\n \n   /**\n@@ -256,6 +263,37 @@ class CanvasImageBuilder extends CanvasBuilder {\n     this.scale_ = imageStyle.getScaleArray();\n     this.width_ = size[0];\n     this.declutterImageWithText_ = opt_sharedData;\n+    this.displacement_ = imageStyle.getDisplacement();\n+    // Reset buffered extent cache when image style changes\n+    this.bufferedMaxExtent_ = null;\n+  }\n+\n+  /**\n+   * @protected\n+   * @return {import(\"../../extent.js\").Extent} The buffered max extent.\n+   */\n+  getBufferedMaxExtent() {\n+    if (!this.bufferedMaxExtent_) {\n+      this.bufferedMaxExtent_ = clone(this.maxExtent);\n+      if (this.maxLineWidth > 0) {\n+        const width = (this.resolution * (this.maxLineWidth + 1)) / 2;\n+        buffer(this.bufferedMaxExtent_, width, this.bufferedMaxExtent_);\n+      }\n+      // Account for image displacement\n+      if (this.displacement_) {\n+        const displacementX = Math.abs(this.displacement_[0]) * this.resolution;\n+        const displacementY = Math.abs(this.displacement_[1]) * this.resolution;\n+        const maxDisplacement = Math.max(displacementX, displacementY);\n+        if (maxDisplacement > 0) {\n+          buffer(\n+            this.bufferedMaxExtent_,\n+            maxDisplacement,\n+            this.bufferedMaxExtent_\n+          );\n+        }\n+      }\n+    }\n+    return this.bufferedMaxExtent_;\n   }\n }\n \ndiff --git a/test_displacement_clipping.html b/test_displacement_clipping.html\nnew file mode 100644\nindex 000000000..feb14b997\n--- /dev/null\n+++ b/test_displacement_clipping.html\n@@ -0,0 +1,131 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Displacement Clipping Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 400px;\n+            border: 1px solid #ccc;\n+            margin: 10px;\n+            display: inline-block;\n+        }\n+        .description {\n+            margin: 10px;\n+            max-width: 400px;\n+            display: inline-block;\n+            vertical-align: top;\n+        }\n+    </style>\n+    <script type=\"module\">\n+        import Map from './build/ol/src/ol/Map.js';\n+        import View from './build/ol/src/ol/View.js';\n+        import VectorLayer from './build/ol/src/ol/layer/Vector.js';\n+        import VectorSource from './build/ol/src/ol/source/Vector.js';\n+        import Feature from './build/ol/src/ol/Feature.js';\n+        import Point from './build/ol/src/ol/geom/Point.js';\n+        import Style from './build/ol/src/ol/style/Style.js';\n+        import Icon from './build/ol/src/ol/style/Icon.js';\n+        import RegularShape from './build/ol/src/ol/style/RegularShape.js';\n+        import Fill from './build/ol/src/ol/style/Fill.js';\n+\n+        window.ol = {\n+            Map, View, layer: { Vector: VectorLayer }, source: { Vector: VectorSource },\n+            Feature, geom: { Point }, style: { Style, Icon, RegularShape, Fill }\n+        };\n+    </script>\n+</head>\n+<body>\n+    <h1>Icon Displacement Clipping Test</h1>\n+    \n+    <div class=\"description\">\n+        <h3>Regular Shape with Displacement (Working)</h3>\n+        <p>This should show a complete green cross shape displaced from the center.</p>\n+    </div>\n+    <div id=\"map1\" class=\"map\"></div>\n+    \n+    <div class=\"description\">\n+        <h3>Icon with Displacement (Clipped - Bug)</h3>\n+        <p>This should show a complete green cross icon displaced from the center, but it gets clipped.</p>\n+    </div>\n+    <div id=\"map2\" class=\"map\"></div>\n+\n+    <script>\n+        // Create a simple cross icon as data URL\n+        const canvas = document.createElement('canvas');\n+        canvas.width = 32;\n+        canvas.height = 32;\n+        const ctx = canvas.getContext('2d');\n+        ctx.fillStyle = 'green';\n+        ctx.fillRect(14, 0, 4, 32);  // vertical bar\n+        ctx.fillRect(0, 14, 32, 4);  // horizontal bar\n+        const crossIconSrc = canvas.toDataURL();\n+\n+        // Test 1: Regular Shape with displacement (should work)\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [\n+                new ol.layer.Vector({\n+                    source: new ol.source.Vector({\n+                        features: [\n+                            new ol.Feature({\n+                                geometry: new ol.geom.Point([0, 0])\n+                            })\n+                        ]\n+                    }),\n+                    style: new ol.style.Style({\n+                        image: new ol.style.RegularShape({\n+                            points: 4,\n+                            radius: 16,\n+                            radius2: 4,\n+                            angle: Math.PI / 4,\n+                            displacement: [50, 50],\n+                            fill: new ol.style.Fill({\n+                                color: 'green'\n+                            })\n+                        })\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 10,\n+                extent: [-100, -100, 100, 100]\n+            })\n+        });\n+\n+        // Test 2: Icon with displacement (should be clipped - this is the bug)\n+        const map2 = new ol.Map({\n+            target: 'map2',\n+            layers: [\n+                new ol.layer.Vector({\n+                    source: new ol.source.Vector({\n+                        features: [\n+                            new ol.Feature({\n+                                geometry: new ol.geom.Point([0, 0])\n+                            })\n+                        ]\n+                    }),\n+                    style: new ol.style.Style({\n+                        image: new ol.style.Icon({\n+                            src: crossIconSrc,\n+                            displacement: [50, 50],\n+                            scale: 1\n+                        })\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 10,\n+                extent: [-100, -100, 100, 100]\n+            })\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_displacement_fix.html b/test_displacement_fix.html\nnew file mode 100644\nindex 000000000..f98a28581\n--- /dev/null\n+++ b/test_displacement_fix.html\n@@ -0,0 +1,124 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Displacement Fix Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 400px;\n+            border: 1px solid #ccc;\n+            margin: 10px;\n+            display: inline-block;\n+            background: #f0f0f0;\n+        }\n+        .description {\n+            margin: 10px;\n+            max-width: 400px;\n+            display: inline-block;\n+            vertical-align: top;\n+        }\n+        .test-result {\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+        }\n+        .pass {\n+            background-color: #d4edda;\n+            color: #155724;\n+            border: 1px solid #c3e6cb;\n+        }\n+        .fail {\n+            background-color: #f8d7da;\n+            color: #721c24;\n+            border: 1px solid #f5c6cb;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Icon Displacement Fix Test</h1>\n+    \n+    <div class=\"description\">\n+        <h3>Test: Icon with Large Displacement</h3>\n+        <p>This test creates an icon with displacement [100, 100] at coordinate [0, 0] within a small extent [-50, -50, 50, 50].</p>\n+        <p><strong>Before fix:</strong> Icon would be clipped because coordinates are filtered out.</p>\n+        <p><strong>After fix:</strong> Icon should render correctly because buffered extent accounts for displacement.</p>\n+        <div id=\"test-result\" class=\"test-result\">Testing...</div>\n+    </div>\n+    <div id=\"map1\" class=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './build/ol/src/ol/Map.js';\n+        import View from './build/ol/src/ol/View.js';\n+        import VectorLayer from './build/ol/src/ol/layer/Vector.js';\n+        import VectorSource from './build/ol/src/ol/source/Vector.js';\n+        import Feature from './build/ol/src/ol/Feature.js';\n+        import Point from './build/ol/src/ol/geom/Point.js';\n+        import Style from './build/ol/src/ol/style/Style.js';\n+        import Icon from './build/ol/src/ol/style/Icon.js';\n+\n+        // Create a simple cross icon as data URL\n+        const canvas = document.createElement('canvas');\n+        canvas.width = 32;\n+        canvas.height = 32;\n+        const ctx = canvas.getContext('2d');\n+        ctx.fillStyle = 'red';\n+        ctx.fillRect(14, 0, 4, 32);  // vertical bar\n+        ctx.fillRect(0, 14, 32, 4);  // horizontal bar\n+        const crossIconSrc = canvas.toDataURL();\n+\n+        // Test: Icon with large displacement in small extent\n+        const feature = new Feature({\n+            geometry: new Point([0, 0])\n+        });\n+\n+        const iconStyle = new Style({\n+            image: new Icon({\n+                src: crossIconSrc,\n+                displacement: [100, 100],  // Large displacement\n+                scale: 1\n+            })\n+        });\n+\n+        const vectorSource = new VectorSource({\n+            features: [feature]\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            style: iconStyle\n+        });\n+\n+        const map = new Map({\n+            target: 'map1',\n+            layers: [vectorLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 10,\n+                extent: [-50, -50, 50, 50]  // Small extent\n+            })\n+        });\n+\n+        // Test if the icon renders (check if there are any features rendered)\n+        setTimeout(() => {\n+            const resultDiv = document.getElementById('test-result');\n+            \n+            // Check if the layer has features and they are within the view extent\n+            const features = vectorSource.getFeatures();\n+            const hasFeatures = features.length > 0;\n+            \n+            if (hasFeatures) {\n+                resultDiv.className = 'test-result pass';\n+                resultDiv.innerHTML = '\u2705 <strong>Test PASSED:</strong> Icon with displacement renders correctly. The fix is working!';\n+            } else {\n+                resultDiv.className = 'test-result fail';\n+                resultDiv.innerHTML = '\u274c <strong>Test FAILED:</strong> Icon with displacement is still being clipped.';\n+            }\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix.js b/test_fix.js\nnew file mode 100644\nindex 000000000..5a0b41fb2\n--- /dev/null\n+++ b/test_fix.js\n@@ -0,0 +1,43 @@\n+/**\n+ * Simple test to verify the displacement clipping fix\n+ */\n+\n+import CanvasImageBuilder from './src/ol/render/canvas/ImageBuilder.js';\n+import Icon from './src/ol/style/Icon.js';\n+\n+// Test the fix\n+console.log('Testing displacement clipping fix...');\n+\n+// Create a mock image builder\n+const builder = new CanvasImageBuilder(0, [-100, -100, 100, 100], 1, 1);\n+\n+// Create an icon with displacement\n+const icon = new Icon({\n+  src: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==',\n+  displacement: [50, 50]\n+});\n+\n+// Set the image style\n+builder.setImageStyle(icon);\n+\n+// Get the buffered extent\n+const bufferedExtent = builder.getBufferedMaxExtent();\n+\n+console.log('Original extent:', [-100, -100, 100, 100]);\n+console.log('Buffered extent with displacement:', bufferedExtent);\n+\n+// The buffered extent should be expanded to account for the displacement\n+const expectedMinX = -100 - 50; // -150\n+const expectedMinY = -100 - 50; // -150  \n+const expectedMaxX = 100 + 50;  // 150\n+const expectedMaxY = 100 + 50;  // 150\n+\n+if (bufferedExtent[0] <= expectedMinX && \n+    bufferedExtent[1] <= expectedMinY &&\n+    bufferedExtent[2] >= expectedMaxX && \n+    bufferedExtent[3] >= expectedMaxY) {\n+  console.log('\u2705 Test PASSED: Buffered extent correctly accounts for displacement');\n+} else {\n+  console.log('\u274c Test FAILED: Buffered extent does not account for displacement');\n+  console.log('Expected at least:', [expectedMinX, expectedMinY, expectedMaxX, expectedMaxY]);\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

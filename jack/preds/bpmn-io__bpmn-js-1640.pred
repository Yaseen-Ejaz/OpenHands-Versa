{"instance_id": "bpmn-io__bpmn-js-1640", "model_patch": "diff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js\nindex 2aa238e4..6f26cc99 100644\n--- a/lib/features/popup-menu/ReplaceMenuProvider.js\n+++ b/lib/features/popup-menu/ReplaceMenuProvider.js\n@@ -431,10 +431,45 @@ ReplaceMenuProvider.prototype._getLoopEntries = function(element) {\n     if (entry.active) {\n       loopCharacteristics = undefined;\n     } else {\n-      loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics);\n+      var businessObject = getBusinessObject(element);\n+      var existingLoopCharacteristics = businessObject.loopCharacteristics;\n+      \n+      // If switching between parallel and sequential multi-instance, preserve existing properties\n+      if (existingLoopCharacteristics && \n+          existingLoopCharacteristics.$type === 'bpmn:MultiInstanceLoopCharacteristics' &&\n+          entry.options.loopCharacteristics === 'bpmn:MultiInstanceLoopCharacteristics') {\n+        \n+        // Create a new loop characteristics object and copy all existing properties\n+        loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics);\n+        \n+        // Copy all properties from existing loop characteristics\n+        var propertiesToCopy = [\n+          'loopCardinality',\n+          'completionCondition', \n+          'loopDataInputRef',\n+          'loopDataOutputRef',\n+          'inputDataItem',\n+          'outputDataItem',\n+          'behavior'\n+        ];\n+        \n+        propertiesToCopy.forEach(function(prop) {\n+          if (existingLoopCharacteristics[prop] !== undefined) {\n+            loopCharacteristics[prop] = existingLoopCharacteristics[prop];\n+          }\n+        });\n+        \n+        // Set the sequential flag based on the target entry\n+        if (entry.options.isSequential !== undefined) {\n+          loopCharacteristics.isSequential = entry.options.isSequential;\n+        }\n+      } else {\n+        // Create new loop characteristics for other cases (standard loop, or first time setting multi-instance)\n+        loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics);\n \n-      if (entry.options.isSequential) {\n-        loopCharacteristics.isSequential = entry.options.isSequential;\n+        if (entry.options.isSequential !== undefined) {\n+          loopCharacteristics.isSequential = entry.options.isSequential;\n+        }\n       }\n     }\n     self._modeling.updateProperties(element, { loopCharacteristics: loopCharacteristics });\ndiff --git a/test-multi-instance-fix.js b/test-multi-instance-fix.js\nnew file mode 100644\nindex 00000000..3cadd0a5\n--- /dev/null\n+++ b/test-multi-instance-fix.js\n@@ -0,0 +1,154 @@\n+/**\n+ * Test to reproduce and verify the multi-instance properties preservation issue\n+ */\n+\n+import BpmnModeler from './lib/Modeler';\n+\n+// Create a simple BPMN diagram with a subprocess\n+const diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Test SubProcess\">\n+      <bpmn:multiInstanceLoopCharacteristics isSequential=\"false\">\n+        <bpmn:loopCardinality>5</bpmn:loopCardinality>\n+        <bpmn:completionCondition>true</bpmn:completionCondition>\n+      </bpmn:multiInstanceLoopCharacteristics>\n+      <bpmn:startEvent id=\"StartEvent_1\" />\n+      <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+      <bpmn:endEvent id=\"EndEvent_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    </bpmn:subProcess>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"350\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"280\" y=\"128\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"430\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"236\" y=\"168\" />\n+        <di:waypoint x=\"280\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"380\" y=\"168\" />\n+        <di:waypoint x=\"430\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function testMultiInstancePropertiesPreservation() {\n+  console.log('=== Testing Multi-Instance Properties Preservation ===');\n+  \n+  // Create modeler instance\n+  const modeler = new BpmnModeler({\n+    container: document.body,\n+    keyboard: {\n+      bindTo: window\n+    }\n+  });\n+\n+  try {\n+    // Import the diagram\n+    await modeler.importXML(diagramXML);\n+    console.log('\u2713 Diagram imported successfully');\n+\n+    // Get the subprocess element\n+    const elementRegistry = modeler.get('elementRegistry');\n+    const subProcess = elementRegistry.get('SubProcess_1');\n+    \n+    if (!subProcess) {\n+      throw new Error('SubProcess not found');\n+    }\n+\n+    console.log('\u2713 SubProcess found:', subProcess.id);\n+\n+    // Check initial state - should be parallel multi-instance with loop cardinality\n+    const initialBO = subProcess.businessObject;\n+    const initialLoopChar = initialBO.loopCharacteristics;\n+    \n+    console.log('Initial state:');\n+    console.log('  - Type:', initialLoopChar.$type);\n+    console.log('  - isSequential:', initialLoopChar.isSequential);\n+    console.log('  - loopCardinality:', initialLoopChar.loopCardinality ? initialLoopChar.loopCardinality.body : 'undefined');\n+    console.log('  - completionCondition:', initialLoopChar.completionCondition ? initialLoopChar.completionCondition.body : 'undefined');\n+\n+    // Verify initial state\n+    if (initialLoopChar.isSequential !== false) {\n+      throw new Error('Expected parallel multi-instance (isSequential=false)');\n+    }\n+    if (!initialLoopChar.loopCardinality || initialLoopChar.loopCardinality.body !== '5') {\n+      throw new Error('Expected loopCardinality to be 5');\n+    }\n+    if (!initialLoopChar.completionCondition || initialLoopChar.completionCondition.body !== 'true') {\n+      throw new Error('Expected completionCondition to be true');\n+    }\n+\n+    console.log('\u2713 Initial state verified - parallel multi-instance with properties');\n+\n+    // Get the replace menu provider to simulate switching to sequential\n+    const replaceMenuProvider = modeler.get('replaceMenuProvider');\n+    const modeling = modeler.get('modeling');\n+    const moddle = modeler.get('moddle');\n+\n+    // Simulate clicking the sequential multi-instance button\n+    console.log('\\nSimulating switch to sequential multi-instance...');\n+    \n+    // Create new sequential loop characteristics (this is what the current code does - and loses properties)\n+    const newLoopCharacteristics = moddle.create('bpmn:MultiInstanceLoopCharacteristics');\n+    newLoopCharacteristics.isSequential = true;\n+    \n+    // Update the element (this simulates the current buggy behavior)\n+    modeling.updateProperties(subProcess, { loopCharacteristics: newLoopCharacteristics });\n+\n+    // Check the state after switching\n+    const afterSwitchBO = subProcess.businessObject;\n+    const afterSwitchLoopChar = afterSwitchBO.loopCharacteristics;\n+    \n+    console.log('After switch to sequential:');\n+    console.log('  - Type:', afterSwitchLoopChar.$type);\n+    console.log('  - isSequential:', afterSwitchLoopChar.isSequential);\n+    console.log('  - loopCardinality:', afterSwitchLoopChar.loopCardinality ? afterSwitchLoopChar.loopCardinality.body : 'undefined');\n+    console.log('  - completionCondition:', afterSwitchLoopChar.completionCondition ? afterSwitchLoopChar.completionCondition.body : 'undefined');\n+\n+    // Verify the bug - properties should be lost\n+    if (afterSwitchLoopChar.isSequential !== true) {\n+      throw new Error('Expected sequential multi-instance (isSequential=true)');\n+    }\n+    \n+    // This is the bug - properties are lost\n+    const hasLoopCardinality = afterSwitchLoopChar.loopCardinality && afterSwitchLoopChar.loopCardinality.body === '5';\n+    const hasCompletionCondition = afterSwitchLoopChar.completionCondition && afterSwitchLoopChar.completionCondition.body === 'true';\n+    \n+    if (hasLoopCardinality && hasCompletionCondition) {\n+      console.log('\u2713 Properties preserved - fix is working!');\n+      return { success: true, propertiesPreserved: true };\n+    } else {\n+      console.log('\u2717 BUG REPRODUCED - Properties lost during switch!');\n+      console.log('  - loopCardinality lost:', !hasLoopCardinality);\n+      console.log('  - completionCondition lost:', !hasCompletionCondition);\n+      return { success: true, propertiesPreserved: false };\n+    }\n+\n+  } catch (error) {\n+    console.error('Test failed:', error);\n+    return { success: false, error: error.message };\n+  }\n+}\n+\n+// Export for use in browser\n+window.testMultiInstancePropertiesPreservation = testMultiInstancePropertiesPreservation;\n+\n+// Run test if in Node.js environment\n+if (typeof module !== 'undefined' && module.exports) {\n+  module.exports = { testMultiInstancePropertiesPreservation };\n+}\n\\ No newline at end of file\ndiff --git a/test-multi-instance-fixed.html b/test-multi-instance-fixed.html\nnew file mode 100644\nindex 00000000..a293cace\n--- /dev/null\n+++ b/test-multi-instance-fixed.html\n@@ -0,0 +1,354 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Multi-Instance Properties Test - Fixed Version</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    \n+    #container {\n+      width: 100%;\n+      height: 400px;\n+      border: 1px solid #ccc;\n+      margin: 20px 0;\n+    }\n+    \n+    #results {\n+      background: #f5f5f5;\n+      padding: 15px;\n+      border-radius: 5px;\n+      margin: 20px 0;\n+      white-space: pre-line;\n+      font-family: monospace;\n+      max-height: 300px;\n+      overflow-y: auto;\n+    }\n+    \n+    button {\n+      background: #007bff;\n+      color: white;\n+      border: none;\n+      padding: 10px 20px;\n+      border-radius: 5px;\n+      cursor: pointer;\n+      margin: 5px;\n+    }\n+    \n+    button:hover {\n+      background: #0056b3;\n+    }\n+    \n+    .success {\n+      color: green;\n+    }\n+    \n+    .error {\n+      color: red;\n+    }\n+    \n+    .warning {\n+      color: orange;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>Multi-Instance Properties Preservation Test - Fixed Version</h1>\n+  \n+  <p>This test verifies that the fix preserves multi-instance properties when switching between parallel and sequential configurations.</p>\n+  \n+  <button onclick=\"runComprehensiveTest()\">Run Comprehensive Test</button>\n+  <button onclick=\"runVisualTest()\">Run Visual Test</button>\n+  <button onclick=\"clearResults()\">Clear Results</button>\n+  \n+  <div id=\"results\"></div>\n+  <div id=\"container\"></div>\n+\n+  <!-- Include bpmn-js -->\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  \n+  <script>\n+    // BPMN diagram with a subprocess that has comprehensive multi-instance properties\n+    const diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Test SubProcess\">\n+      <bpmn:multiInstanceLoopCharacteristics isSequential=\"false\">\n+        <bpmn:loopCardinality>5</bpmn:loopCardinality>\n+        <bpmn:completionCondition>true</bpmn:completionCondition>\n+      </bpmn:multiInstanceLoopCharacteristics>\n+      <bpmn:startEvent id=\"StartEvent_1\" />\n+      <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+      <bpmn:endEvent id=\"EndEvent_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    </bpmn:subProcess>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"350\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"280\" y=\"128\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"430\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"236\" y=\"168\" />\n+        <di:waypoint x=\"280\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"380\" y=\"168\" />\n+        <di:waypoint x=\"430\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    let modeler;\n+    \n+    function log(message, type = 'info') {\n+      const results = document.getElementById('results');\n+      const timestamp = new Date().toLocaleTimeString();\n+      const className = type === 'error' ? 'error' : type === 'success' ? 'success' : type === 'warning' ? 'warning' : '';\n+      results.innerHTML += `<span class=\"${className}\">[${timestamp}] ${message}</span>\\n`;\n+      results.scrollTop = results.scrollHeight;\n+      console.log(message);\n+    }\n+    \n+    function clearResults() {\n+      document.getElementById('results').innerHTML = '';\n+    }\n+    \n+    async function initializeModeler() {\n+      if (modeler) {\n+        return modeler;\n+      }\n+      \n+      modeler = new BpmnJS({\n+        container: '#container',\n+        keyboard: {\n+          bindTo: window\n+        }\n+      });\n+      \n+      try {\n+        await modeler.importXML(diagramXML);\n+        log('\u2713 Modeler initialized and diagram imported', 'success');\n+        return modeler;\n+      } catch (error) {\n+        log('\u2717 Failed to initialize modeler: ' + error.message, 'error');\n+        throw error;\n+      }\n+    }\n+    \n+    function logLoopCharacteristics(loopChar, label) {\n+      log(label + ':');\n+      log('  - Type: ' + loopChar.$type);\n+      log('  - isSequential: ' + loopChar.isSequential);\n+      log('  - loopCardinality: ' + (loopChar.loopCardinality ? loopChar.loopCardinality.body : 'undefined'));\n+      log('  - completionCondition: ' + (loopChar.completionCondition ? loopChar.completionCondition.body : 'undefined'));\n+    }\n+    \n+    async function runComprehensiveTest() {\n+      log('=== Starting Comprehensive Multi-Instance Properties Test ===');\n+      \n+      try {\n+        const modeler = await initializeModeler();\n+        \n+        // Get required services\n+        const elementRegistry = modeler.get('elementRegistry');\n+        const replaceMenuProvider = modeler.get('replaceMenuProvider');\n+        \n+        const subProcess = elementRegistry.get('SubProcess_1');\n+        \n+        if (!subProcess) {\n+          throw new Error('SubProcess not found');\n+        }\n+        \n+        log('\u2713 SubProcess found: ' + subProcess.id, 'success');\n+        \n+        // Test 1: Check initial state (parallel multi-instance)\n+        log('\\n--- Test 1: Initial State ---');\n+        const initialBO = subProcess.businessObject;\n+        const initialLoopChar = initialBO.loopCharacteristics;\n+        \n+        logLoopCharacteristics(initialLoopChar, 'Initial state');\n+        \n+        // Verify initial state\n+        if (initialLoopChar.isSequential !== false) {\n+          throw new Error('Expected parallel multi-instance (isSequential=false)');\n+        }\n+        if (!initialLoopChar.loopCardinality || initialLoopChar.loopCardinality.body !== '5') {\n+          throw new Error('Expected loopCardinality to be 5');\n+        }\n+        if (!initialLoopChar.completionCondition || initialLoopChar.completionCondition.body !== 'true') {\n+          throw new Error('Expected completionCondition to be true');\n+        }\n+        \n+        log('\u2713 Initial state verified', 'success');\n+        \n+        // Test 2: Switch to sequential multi-instance using the actual menu provider\n+        log('\\n--- Test 2: Switch to Sequential ---');\n+        \n+        // Get the loop entries (this simulates the actual UI interaction)\n+        const loopEntries = replaceMenuProvider._getLoopEntries(subProcess);\n+        const sequentialEntry = loopEntries.find(entry => entry.id === 'toggle-sequential-mi');\n+        \n+        if (!sequentialEntry) {\n+          throw new Error('Sequential multi-instance entry not found');\n+        }\n+        \n+        // Simulate clicking the sequential multi-instance button\n+        sequentialEntry.action({}, sequentialEntry);\n+        \n+        // Check state after switching to sequential\n+        const afterSequentialBO = subProcess.businessObject;\n+        const afterSequentialLoopChar = afterSequentialBO.loopCharacteristics;\n+        \n+        logLoopCharacteristics(afterSequentialLoopChar, 'After switch to sequential');\n+        \n+        // Verify sequential state and preserved properties\n+        if (afterSequentialLoopChar.isSequential !== true) {\n+          throw new Error('Expected sequential multi-instance (isSequential=true)');\n+        }\n+        \n+        const hasLoopCardinality = afterSequentialLoopChar.loopCardinality && afterSequentialLoopChar.loopCardinality.body === '5';\n+        const hasCompletionCondition = afterSequentialLoopChar.completionCondition && afterSequentialLoopChar.completionCondition.body === 'true';\n+        \n+        if (!hasLoopCardinality) {\n+          throw new Error('loopCardinality was lost during switch to sequential');\n+        }\n+        if (!hasCompletionCondition) {\n+          throw new Error('completionCondition was lost during switch to sequential');\n+        }\n+        \n+        log('\u2713 Properties preserved when switching to sequential', 'success');\n+        \n+        // Test 3: Switch back to parallel multi-instance\n+        log('\\n--- Test 3: Switch back to Parallel ---');\n+        \n+        const parallelEntry = loopEntries.find(entry => entry.id === 'toggle-parallel-mi');\n+        \n+        if (!parallelEntry) {\n+          throw new Error('Parallel multi-instance entry not found');\n+        }\n+        \n+        // Simulate clicking the parallel multi-instance button\n+        parallelEntry.action({}, parallelEntry);\n+        \n+        // Check state after switching back to parallel\n+        const afterParallelBO = subProcess.businessObject;\n+        const afterParallelLoopChar = afterParallelBO.loopCharacteristics;\n+        \n+        logLoopCharacteristics(afterParallelLoopChar, 'After switch back to parallel');\n+        \n+        // Verify parallel state and preserved properties\n+        if (afterParallelLoopChar.isSequential !== false) {\n+          throw new Error('Expected parallel multi-instance (isSequential=false)');\n+        }\n+        \n+        const hasLoopCardinalityParallel = afterParallelLoopChar.loopCardinality && afterParallelLoopChar.loopCardinality.body === '5';\n+        const hasCompletionConditionParallel = afterParallelLoopChar.completionCondition && afterParallelLoopChar.completionCondition.body === 'true';\n+        \n+        if (!hasLoopCardinalityParallel) {\n+          throw new Error('loopCardinality was lost during switch back to parallel');\n+        }\n+        if (!hasCompletionConditionParallel) {\n+          throw new Error('completionCondition was lost during switch back to parallel');\n+        }\n+        \n+        log('\u2713 Properties preserved when switching back to parallel', 'success');\n+        \n+        // Test 4: Switch to standard loop (should create new characteristics)\n+        log('\\n--- Test 4: Switch to Standard Loop ---');\n+        \n+        const loopEntry = loopEntries.find(entry => entry.id === 'toggle-loop');\n+        \n+        if (!loopEntry) {\n+          throw new Error('Standard loop entry not found');\n+        }\n+        \n+        // Simulate clicking the standard loop button\n+        loopEntry.action({}, loopEntry);\n+        \n+        // Check state after switching to standard loop\n+        const afterLoopBO = subProcess.businessObject;\n+        const afterLoopLoopChar = afterLoopBO.loopCharacteristics;\n+        \n+        log('After switch to standard loop:');\n+        log('  - Type: ' + afterLoopLoopChar.$type);\n+        log('  - isSequential: ' + afterLoopLoopChar.isSequential);\n+        \n+        // Verify standard loop state\n+        if (afterLoopLoopChar.$type !== 'bpmn:StandardLoopCharacteristics') {\n+          throw new Error('Expected StandardLoopCharacteristics');\n+        }\n+        \n+        log('\u2713 Standard loop created correctly', 'success');\n+        \n+        // Test 5: Switch back to parallel multi-instance (should create new characteristics)\n+        log('\\n--- Test 5: Switch from Standard Loop to Parallel Multi-Instance ---');\n+        \n+        // Simulate clicking the parallel multi-instance button again\n+        parallelEntry.action({}, parallelEntry);\n+        \n+        // Check state after switching from standard loop to parallel multi-instance\n+        const finalBO = subProcess.businessObject;\n+        const finalLoopChar = finalBO.loopCharacteristics;\n+        \n+        logLoopCharacteristics(finalLoopChar, 'After switch from standard loop to parallel multi-instance');\n+        \n+        // Verify that new multi-instance characteristics were created (without the old properties)\n+        if (finalLoopChar.$type !== 'bpmn:MultiInstanceLoopCharacteristics') {\n+          throw new Error('Expected MultiInstanceLoopCharacteristics');\n+        }\n+        if (finalLoopChar.isSequential !== false) {\n+          throw new Error('Expected parallel multi-instance (isSequential=false)');\n+        }\n+        \n+        // These should be undefined since we switched from standard loop\n+        const hasOldLoopCardinality = finalLoopChar.loopCardinality && finalLoopChar.loopCardinality.body === '5';\n+        const hasOldCompletionCondition = finalLoopChar.completionCondition && finalLoopChar.completionCondition.body === 'true';\n+        \n+        if (hasOldLoopCardinality || hasOldCompletionCondition) {\n+          log('Note: Old properties were preserved (this might be unexpected behavior)', 'warning');\n+        } else {\n+          log('\u2713 New multi-instance characteristics created without old properties', 'success');\n+        }\n+        \n+        log('\\n=== All Tests Completed Successfully! ===', 'success');\n+        log('The fix correctly preserves properties when switching between parallel and sequential multi-instance.', 'success');\n+        \n+      } catch (error) {\n+        log('\u2717 Test failed: ' + error.message, 'error');\n+        console.error(error);\n+      }\n+    }\n+    \n+    async function runVisualTest() {\n+      log('=== Starting Visual Test ===');\n+      log('Instructions:');\n+      log('1. Look at the subprocess in the diagram - it should have parallel multi-instance markers (||)');\n+      log('2. Right-click on the subprocess to open the context menu');\n+      log('3. Click on the sequential multi-instance button (three horizontal lines)');\n+      log('4. The markers should change to sequential (three horizontal lines)');\n+      log('5. Right-click again and switch back to parallel');\n+      log('6. The properties should be preserved throughout the switches!');\n+      \n+      try {\n+        await initializeModeler();\n+        log('\u2713 Visual test ready - follow the instructions above', 'success');\n+      } catch (error) {\n+        log('\u2717 Failed to initialize visual test: ' + error.message, 'error');\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-multi-instance.html b/test-multi-instance.html\nnew file mode 100644\nindex 00000000..15e37635\n--- /dev/null\n+++ b/test-multi-instance.html\n@@ -0,0 +1,252 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Multi-Instance Properties Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    \n+    #container {\n+      width: 100%;\n+      height: 400px;\n+      border: 1px solid #ccc;\n+      margin: 20px 0;\n+    }\n+    \n+    #results {\n+      background: #f5f5f5;\n+      padding: 15px;\n+      border-radius: 5px;\n+      margin: 20px 0;\n+      white-space: pre-line;\n+      font-family: monospace;\n+    }\n+    \n+    button {\n+      background: #007bff;\n+      color: white;\n+      border: none;\n+      padding: 10px 20px;\n+      border-radius: 5px;\n+      cursor: pointer;\n+      margin: 5px;\n+    }\n+    \n+    button:hover {\n+      background: #0056b3;\n+    }\n+    \n+    .success {\n+      color: green;\n+    }\n+    \n+    .error {\n+      color: red;\n+    }\n+    \n+    .warning {\n+      color: orange;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>Multi-Instance Properties Preservation Test</h1>\n+  \n+  <p>This test reproduces the issue where multi-instance properties (like loop cardinality) are lost when switching between parallel and sequential multi-instance configurations.</p>\n+  \n+  <button onclick=\"runTest()\">Run Test</button>\n+  <button onclick=\"runVisualTest()\">Run Visual Test</button>\n+  <button onclick=\"clearResults()\">Clear Results</button>\n+  \n+  <div id=\"results\"></div>\n+  <div id=\"container\"></div>\n+\n+  <!-- Include bpmn-js -->\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  \n+  <script>\n+    // Simple BPMN diagram with a subprocess that has multi-instance properties\n+    const diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Test SubProcess\">\n+      <bpmn:multiInstanceLoopCharacteristics isSequential=\"false\">\n+        <bpmn:loopCardinality>5</bpmn:loopCardinality>\n+        <bpmn:completionCondition>true</bpmn:completionCondition>\n+      </bpmn:multiInstanceLoopCharacteristics>\n+      <bpmn:startEvent id=\"StartEvent_1\" />\n+      <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+      <bpmn:endEvent id=\"EndEvent_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    </bpmn:subProcess>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"350\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"280\" y=\"128\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"430\" y=\"150\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"236\" y=\"168\" />\n+        <di:waypoint x=\"280\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"380\" y=\"168\" />\n+        <di:waypoint x=\"430\" y=\"168\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    let modeler;\n+    \n+    function log(message, type = 'info') {\n+      const results = document.getElementById('results');\n+      const timestamp = new Date().toLocaleTimeString();\n+      const className = type === 'error' ? 'error' : type === 'success' ? 'success' : type === 'warning' ? 'warning' : '';\n+      results.innerHTML += `<span class=\"${className}\">[${timestamp}] ${message}</span>\\n`;\n+      results.scrollTop = results.scrollHeight;\n+      console.log(message);\n+    }\n+    \n+    function clearResults() {\n+      document.getElementById('results').innerHTML = '';\n+    }\n+    \n+    async function initializeModeler() {\n+      if (modeler) {\n+        return modeler;\n+      }\n+      \n+      modeler = new BpmnJS({\n+        container: '#container',\n+        keyboard: {\n+          bindTo: window\n+        }\n+      });\n+      \n+      try {\n+        await modeler.importXML(diagramXML);\n+        log('\u2713 Modeler initialized and diagram imported', 'success');\n+        return modeler;\n+      } catch (error) {\n+        log('\u2717 Failed to initialize modeler: ' + error.message, 'error');\n+        throw error;\n+      }\n+    }\n+    \n+    async function runTest() {\n+      log('=== Starting Multi-Instance Properties Test ===');\n+      \n+      try {\n+        const modeler = await initializeModeler();\n+        \n+        // Get the subprocess element\n+        const elementRegistry = modeler.get('elementRegistry');\n+        const subProcess = elementRegistry.get('SubProcess_1');\n+        \n+        if (!subProcess) {\n+          throw new Error('SubProcess not found');\n+        }\n+        \n+        log('\u2713 SubProcess found: ' + subProcess.id, 'success');\n+        \n+        // Check initial state\n+        const initialBO = subProcess.businessObject;\n+        const initialLoopChar = initialBO.loopCharacteristics;\n+        \n+        log('Initial state:');\n+        log('  - Type: ' + initialLoopChar.$type);\n+        log('  - isSequential: ' + initialLoopChar.isSequential);\n+        log('  - loopCardinality: ' + (initialLoopChar.loopCardinality ? initialLoopChar.loopCardinality.body : 'undefined'));\n+        log('  - completionCondition: ' + (initialLoopChar.completionCondition ? initialLoopChar.completionCondition.body : 'undefined'));\n+        \n+        // Verify initial state\n+        if (initialLoopChar.isSequential !== false) {\n+          throw new Error('Expected parallel multi-instance (isSequential=false)');\n+        }\n+        if (!initialLoopChar.loopCardinality || initialLoopChar.loopCardinality.body !== '5') {\n+          throw new Error('Expected loopCardinality to be 5');\n+        }\n+        if (!initialLoopChar.completionCondition || initialLoopChar.completionCondition.body !== 'true') {\n+          throw new Error('Expected completionCondition to be true');\n+        }\n+        \n+        log('\u2713 Initial state verified - parallel multi-instance with properties', 'success');\n+        \n+        // Simulate the current buggy behavior - switching to sequential\n+        log('Simulating switch to sequential multi-instance...');\n+        \n+        const modeling = modeler.get('modeling');\n+        const moddle = modeler.get('moddle');\n+        \n+        // This is what the current code does - creates new loop characteristics without preserving properties\n+        const newLoopCharacteristics = moddle.create('bpmn:MultiInstanceLoopCharacteristics');\n+        newLoopCharacteristics.isSequential = true;\n+        \n+        // Update the element\n+        modeling.updateProperties(subProcess, { loopCharacteristics: newLoopCharacteristics });\n+        \n+        // Check the state after switching\n+        const afterSwitchBO = subProcess.businessObject;\n+        const afterSwitchLoopChar = afterSwitchBO.loopCharacteristics;\n+        \n+        log('After switch to sequential:');\n+        log('  - Type: ' + afterSwitchLoopChar.$type);\n+        log('  - isSequential: ' + afterSwitchLoopChar.isSequential);\n+        log('  - loopCardinality: ' + (afterSwitchLoopChar.loopCardinality ? afterSwitchLoopChar.loopCardinality.body : 'undefined'));\n+        log('  - completionCondition: ' + (afterSwitchLoopChar.completionCondition ? afterSwitchLoopChar.completionCondition.body : 'undefined'));\n+        \n+        // Verify the bug\n+        if (afterSwitchLoopChar.isSequential !== true) {\n+          throw new Error('Expected sequential multi-instance (isSequential=true)');\n+        }\n+        \n+        const hasLoopCardinality = afterSwitchLoopChar.loopCardinality && afterSwitchLoopChar.loopCardinality.body === '5';\n+        const hasCompletionCondition = afterSwitchLoopChar.completionCondition && afterSwitchLoopChar.completionCondition.body === 'true';\n+        \n+        if (hasLoopCardinality && hasCompletionCondition) {\n+          log('\u2713 Properties preserved - fix is working!', 'success');\n+        } else {\n+          log('\u2717 BUG REPRODUCED - Properties lost during switch!', 'error');\n+          log('  - loopCardinality lost: ' + !hasLoopCardinality, 'warning');\n+          log('  - completionCondition lost: ' + !hasCompletionCondition, 'warning');\n+        }\n+        \n+        log('=== Test completed ===');\n+        \n+      } catch (error) {\n+        log('\u2717 Test failed: ' + error.message, 'error');\n+      }\n+    }\n+    \n+    async function runVisualTest() {\n+      log('=== Starting Visual Test ===');\n+      log('Instructions:');\n+      log('1. Look at the subprocess in the diagram - it should have parallel multi-instance markers (||)');\n+      log('2. Right-click on the subprocess to open the context menu');\n+      log('3. Click on the sequential multi-instance button (the one with three horizontal lines)');\n+      log('4. Check if the properties panel still shows the loop cardinality and completion condition');\n+      log('5. If they are missing, the bug is reproduced!');\n+      \n+      try {\n+        await initializeModeler();\n+        log('\u2713 Visual test ready - follow the instructions above', 'success');\n+      } catch (error) {\n+        log('\u2717 Failed to initialize visual test: ' + error.message, 'error');\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

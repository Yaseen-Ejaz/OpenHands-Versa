layers__/node_modules/loader-runner/lib/LoaderRunner.js:111:13)\n+    at module.exports (/workspace/openlayers__openlayers__/node_modules/buble-loader/index.js:34:7)\n+    at LOADER_EXECUTION (/workspace/openlayers__openlayers__/node_modules/loader-runner/lib/LoaderRunner.js:119:14)\n+    at runSyncOrAsync (/workspace/openlayers__openlayers__/node_modules/loader-runner/lib/LoaderRunner.js:120:4)\n+    at iterateNormalLoaders (/workspace/openlayers__openlayers__/node_modules/loader-runner/lib/LoaderRunner.js:232:2) {\n+  opensslErrorStack: [ 'error:03000086:digital envelope routines::initialization error' ],\n+  library: 'digital envelope routines',\n+  reason: 'unsupported',\n+  code: 'ERR_OSSL_EVP_UNSUPPORTED'\n+}\n+\n+Node.js v21.6.2\n+npm notice \n+npm notice New major version of npm available! 10.2.4 -> 11.11.0\n+npm notice Changelog: <https://github.com/npm/cli/releases/tag/v11.11.0>\n+npm notice Run `npm install -g npm@11.11.0` to update!\n+npm notice \ndiff --git a/simple_test.html b/simple_test.html\nnew file mode 100644\nindex 000000000..d32ab6ead\n--- /dev/null\n+++ b/simple_test.html\n@@ -0,0 +1,168 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Line Spacing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-case {\n+            border: 1px solid #ccc;\n+            padding: 20px;\n+            margin: 20px 0;\n+        }\n+        canvas {\n+            border: 1px solid #000;\n+            margin: 10px 0;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Line Spacing Issue Demonstration</h1>\n+    \n+    <div class=\"test-case\">\n+        <h3>Current OpenLayers Line Spacing Logic</h3>\n+        <p>This demonstrates the current line spacing calculation that causes the gap issue.</p>\n+        <canvas id=\"currentCanvas\" width=\"400\" height=\"200\"></canvas>\n+        <p><strong>Formula:</strong> <code>0.5 * (strokeWidth + lineHeight) + i * lineHeight</code></p>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Desired Tighter Line Spacing</h3>\n+        <p>This shows what the user wants - tighter line spacing without gaps.</p>\n+        <canvas id=\"desiredCanvas\" width=\"400\" height=\"200\"></canvas>\n+        <p><strong>Proposed Formula:</strong> <code>0.5 * strokeWidth + i * lineHeight</code> (remove extra lineHeight/2)</p>\n+    </div>\n+\n+    <script>\n+        // Simulate the measureTextHeight function\n+        function measureTextHeight(font) {\n+            const span = document.createElement('span');\n+            span.textContent = 'M';\n+            span.style.font = font;\n+            span.style.position = 'absolute';\n+            span.style.left = '-9999px';\n+            document.body.appendChild(span);\n+            const height = span.offsetHeight;\n+            document.body.removeChild(span);\n+            return height;\n+        }\n+        \n+        // Current OpenLayers approach\n+        function drawCurrentApproach() {\n+            const canvas = document.getElementById('currentCanvas');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f9f9f9';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            const font = '16px Arial';\n+            const text = '3.5\\nbar';\n+            const lines = text.split('\\n');\n+            const strokeWidth = 2;\n+            \n+            ctx.font = font;\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            \n+            const lineHeight = measureTextHeight(font);\n+            console.log('Measured line height:', lineHeight);\n+            \n+            // Current OpenLayers formula\n+            ctx.fillStyle = '#000';\n+            ctx.strokeStyle = '#666';\n+            ctx.lineWidth = strokeWidth;\n+            \n+            const x = 100;\n+            for (let i = 0; i < lines.length; i++) {\n+                const y = 0.5 * (strokeWidth + lineHeight) + i * lineHeight + 50;\n+                ctx.strokeText(lines[i], x, y);\n+                ctx.fillText(lines[i], x, y);\n+                \n+                // Draw guide lines\n+                ctx.save();\n+                ctx.strokeStyle = '#ff0000';\n+                ctx.lineWidth = 1;\n+                ctx.setLineDash([2, 2]);\n+                ctx.beginPath();\n+                ctx.moveTo(x - 50, y);\n+                ctx.lineTo(x + 50, y);\n+                ctx.stroke();\n+                ctx.restore();\n+            }\n+            \n+            // Add labels\n+            ctx.fillStyle = '#666';\n+            ctx.font = '12px Arial';\n+            ctx.textAlign = 'left';\n+            ctx.fillText('Current approach (with gap)', 150, 70);\n+            ctx.fillText('Red lines show text baseline positions', 150, 85);\n+            ctx.fillText(`Line height: ${lineHeight}px`, 150, 100);\n+            ctx.fillText(`Gap between lines: ${lineHeight}px`, 150, 115);\n+        }\n+        \n+        // Desired approach\n+        function drawDesiredApproach() {\n+            const canvas = document.getElementById('desiredCanvas');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f9f9f9';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            const font = '16px Arial';\n+            const text = '3.5\\nbar';\n+            const lines = text.split('\\n');\n+            const strokeWidth = 2;\n+            \n+            ctx.font = font;\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            \n+            const lineHeight = measureTextHeight(font);\n+            \n+            // Proposed tighter formula\n+            ctx.fillStyle = '#000';\n+            ctx.strokeStyle = '#666';\n+            ctx.lineWidth = strokeWidth;\n+            \n+            const x = 100;\n+            const tighterLineHeight = lineHeight * 0.8; // Reduce line height by 20%\n+            \n+            for (let i = 0; i < lines.length; i++) {\n+                const y = 0.5 * strokeWidth + i * tighterLineHeight + 50;\n+                ctx.strokeText(lines[i], x, y);\n+                ctx.fillText(lines[i], x, y);\n+                \n+                // Draw guide lines\n+                ctx.save();\n+                ctx.strokeStyle = '#00aa00';\n+                ctx.lineWidth = 1;\n+                ctx.setLineDash([2, 2]);\n+                ctx.beginPath();\n+                ctx.moveTo(x - 50, y);\n+                ctx.lineTo(x + 50, y);\n+                ctx.stroke();\n+                ctx.restore();\n+            }\n+            \n+            // Add labels\n+            ctx.fillStyle = '#666';\n+            ctx.font = '12px Arial';\n+            ctx.textAlign = 'left';\n+            ctx.fillText('Desired approach (tighter)', 150, 70);\n+            ctx.fillText('Green lines show text baseline positions', 150, 85);\n+            ctx.fillText(`Original line height: ${lineHeight}px`, 150, 100);\n+            ctx.fillText(`Tighter line height: ${tighterLineHeight.toFixed(1)}px`, 150, 115);\n+        }\n+        \n+        // Initialize\n+        window.onload = function() {\n+            drawCurrentApproach();\n+            drawDesiredApproach();\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/render/canvas.js b/src/ol/render/canvas.js\nindex 4e9f562ac..3e1532643 100644\n--- a/src/ol/render/canvas.js\n+++ b/src/ol/render/canvas.js\n@@ -60,6 +60,7 @@ import LabelCache from './canvas/LabelCache.js';\n  * @property {import(\"../style/Stroke.js\").default} [backgroundStroke]\n  * @property {number} [scale]\n  * @property {Array<number>} [padding]\n+ * @property {number} [lineHeight]\n  */\n \n \ndiff --git a/src/ol/render/canvas/Executor.js b/src/ol/render/canvas/Executor.js\nindex af7e326ff..1de0f742c 100644\n--- a/src/ol/render/canvas/Executor.js\n+++ b/src/ol/render/canvas/Executor.js\n@@ -190,7 +190,9 @@ class Executor extends Disposable {\n       const numLines = lines.length;\n       const widths = [];\n       const width = measureTextWidths(textState.font, lines, widths);\n-      const lineHeight = measureTextHeight(textState.font);\n+      const measuredLineHeight = measureTextHeight(textState.font);\n+      const lineHeight = textState.lineHeight !== undefined ?\n+        measuredLineHeight * textState.lineHeight : measuredLineHeight;\n       const height = lineHeight * numLines;\n       const renderWidth = (width + strokeWidth);\n       const context = createCanvasContext2D(\ndiff --git a/src/ol/render/canvas/TextBuilder.js b/src/ol/render/canvas/TextBuilder.js\nindex ab9cfc14c..2b0e86e57 100644\n--- a/src/ol/render/canvas/TextBuilder.js\n+++ b/src/ol/render/canvas/TextBuilder.js\n@@ -325,7 +325,8 @@ class CanvasTextBuilder extends CanvasBuilder {\n         font: textState.font,\n         textAlign: textState.textAlign || defaultTextAlign,\n         textBaseline: textState.textBaseline || defaultTextBaseline,\n-        scale: textState.scale\n+        scale: textState.scale,\n+        lineHeight: textState.lineHeight\n       };\n     }\n     const fillKey = this.fillKey_;\n@@ -437,6 +438,7 @@ class CanvasTextBuilder extends CanvasBuilder {\n       textState.backgroundStroke = textStyle.getBackgroundStroke();\n       textState.padding = textStyle.getPadding() || defaultPadding;\n       textState.scale = textScale === undefined ? 1 : textScale;\n+      textState.lineHeight = textStyle.getLineHeight();\n \n       const textOffsetX = textStyle.getOffsetX();\n       const textOffsetY = textStyle.getOffsetY();\ndiff --git a/src/ol/style/Text.js b/src/ol/style/Text.js\nindex 091df3e7b..63cea913a 100644\n--- a/src/ol/style/Text.js\n+++ b/src/ol/style/Text.js\n@@ -34,6 +34,9 @@ const DEFAULT_FILL_COLOR = '#333';\n  * placement where `maxAngle` is not exceeded.\n  * @property {string} [textBaseline='middle'] Text base line. Possible values: 'bottom', 'top', 'middle', 'alphabetic',\n  * 'hanging', 'ideographic'.\n+ * @property {number} [lineHeight] Line height as a ratio of the font size (e.g. 1.2 for 120% line height).\n+ * If not specified, uses the default line height based on the font metrics. Use values less than 1.0 to reduce\n+ * spacing between lines in multi-line text.\n  * @property {import(\"./Fill.js\").default} [fill] Fill style. If none is provided, we'll use a dark fill-style (#333).\n  * @property {import(\"./Stroke.js\").default} [stroke] Stroke style.\n  * @property {import(\"./Fill.js\").default} [backgroundFill] Fill style for the text background when `placement` is\n@@ -160,6 +163,12 @@ class Text {\n      * @type {Array<number>}\n      */\n     this.padding_ = options.padding === undefined ? null : options.padding;\n+\n+    /**\n+     * @private\n+     * @type {number|undefined}\n+     */\n+    this.lineHeight_ = options.lineHeight;\n   }\n \n   /**\n@@ -179,6 +188,7 @@ class Text {\n       text: this.getText(),\n       textAlign: this.getTextAlign(),\n       textBaseline: this.getTextBaseline(),\n+      lineHeight: this.getLineHeight(),\n       fill: this.getFill() ? this.getFill().clone() : undefined,\n       stroke: this.getStroke() ? this.getStroke().clone() : undefined,\n       offsetX: this.getOffsetX(),\n@@ -341,6 +351,15 @@ class Text {\n     return this.padding_;\n   }\n \n+  /**\n+   * Get the line height for multi-line text.\n+   * @return {number|undefined} Line height ratio.\n+   * @api\n+   */\n+  getLineHeight() {\n+    return this.lineHeight_;\n+  }\n+\n   /**\n    * Set the `overflow` property.\n    *\n@@ -510,6 +529,16 @@ class Text {\n   setPadding(padding) {\n     this.padding_ = padding;\n   }\n+\n+  /**\n+   * Set the line height for multi-line text.\n+   *\n+   * @param {number|undefined} lineHeight Line height ratio.\n+   * @api\n+   */\n+  setLineHeight(lineHeight) {\n+    this.lineHeight_ = lineHeight;\n+  }\n }\n \n export default Text;\ndiff --git a/test/spec/ol/style/text.test.js b/test/spec/ol/style/text.test.js\nindex 4799274e3..639e7c822 100644\n--- a/test/spec/ol/style/text.test.js\n+++ b/test/spec/ol/style/text.test.js\n@@ -58,7 +58,8 @@ describe('ol.style.Text', function() {\n         }),\n         backgroundStroke: new Stroke({\n           color: 'black'\n-        })\n+        }),\n+        lineHeight: 0.9\n       });\n       const clone = original.clone();\n       expect(original.getFont()).to.eql(clone.getFont());\n@@ -70,6 +71,7 @@ describe('ol.style.Text', function() {\n       expect(original.getText()).to.eql(clone.getText());\n       expect(original.getTextAlign()).to.eql(clone.getTextAlign());\n       expect(original.getTextBaseline()).to.eql(clone.getTextBaseline());\n+      expect(original.getLineHeight()).to.eql(clone.getLineHeight());\n       expect(original.getStroke().getColor()).to.eql(clone.getStroke().getColor());\n       expect(original.getFill().getColor()).to.eql(clone.getFill().getColor());\n       expect(original.getBackgroundStroke().getColor()).to.eql(clone.getBackgroundStroke().getColor());\n@@ -106,4 +108,45 @@ describe('ol.style.Text', function() {\n     });\n   });\n \n+  describe('#lineHeight', function() {\n+    it('has undefined lineHeight by default', function() {\n+      const textStyle = new Text();\n+      expect(textStyle.getLineHeight()).to.eql(undefined);\n+    });\n+\n+    it('can set and get lineHeight', function() {\n+      const textStyle = new Text({\n+        lineHeight: 0.8\n+      });\n+      expect(textStyle.getLineHeight()).to.eql(0.8);\n+    });\n+\n+    it('can update lineHeight with setter', function() {\n+      const textStyle = new Text();\n+      textStyle.setLineHeight(1.2);\n+      expect(textStyle.getLineHeight()).to.eql(1.2);\n+    });\n+\n+    it('clones lineHeight property correctly', function() {\n+      const original = new Text({\n+        lineHeight: 0.7,\n+        text: 'test\\nmultiline'\n+      });\n+      const clone = original.clone();\n+      expect(clone.getLineHeight()).to.eql(0.7);\n+      expect(clone.getLineHeight()).to.eql(original.getLineHeight());\n+    });\n+\n+    it('allows various lineHeight values', function() {\n+      const testValues = [0.5, 0.8, 1.0, 1.5, 2.0];\n+      testValues.forEach(function(value) {\n+        const textStyle = new Text({\n+          lineHeight: value\n+        });\n+        expect(textStyle.getLineHeight()).to.eql(value);\n+      });\n+    });\n+\n+  });\n+\n });\ndiff --git a/test_implementation.html b/test_implementation.html\nnew file mode 100644\nindex 000000000..4cb4c525f\n--- /dev/null\n+++ b/test_implementation.html\n@@ -0,0 +1,212 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>OpenLayers Line Height Implementation Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            display: flex;\n+            flex-wrap: wrap;\n+            gap: 20px;\n+        }\n+        .test-case {\n+            border: 1px solid #ccc;\n+            padding: 15px;\n+            margin: 10px 0;\n+            width: 350px;\n+        }\n+        .map {\n+            width: 100%;\n+            height: 200px;\n+            border: 1px solid #000;\n+            margin: 10px 0;\n+        }\n+        h3 {\n+            margin-top: 0;\n+            color: #333;\n+        }\n+        .success {\n+            background-color: #e8f5e8;\n+            border-left: 4px solid #4caf50;\n+        }\n+        .issue {\n+            background-color: #ffe6e6;\n+            border-left: 4px solid #ff0000;\n+        }\n+        .code {\n+            background-color: #f5f5f5;\n+            padding: 10px;\n+            font-family: monospace;\n+            font-size: 12px;\n+            margin: 5px 0;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>OpenLayers Line Height Implementation Test</h1>\n+    <p>Testing the new <code>lineHeight</code> property to control spacing between lines in multi-line text.</p>\n+    \n+    <div class=\"test-container\">\n+        <div class=\"test-case issue\">\n+            <h3>Before Fix: Default Behavior</h3>\n+            <div id=\"map1\" class=\"map\"></div>\n+            <div class=\"code\">\n+text: new ol.style.Text({\n+    text: '3.5\\nbar',\n+    font: '16px Arial'\n+    // No lineHeight specified - uses default\n+})\n+            </div>\n+            <p>Shows the original gap issue</p>\n+        </div>\n+        \n+        <div class=\"test-case success\">\n+            <h3>After Fix: Tight Line Spacing</h3>\n+            <div id=\"map2\" class=\"map\"></div>\n+            <div class=\"code\">\n+text: new ol.style.Text({\n+    text: '3.5\\nbar',\n+    font: '16px Arial',\n+    lineHeight: 0.8  // 80% line height\n+})\n+            </div>\n+            <p>Reduced gap between lines</p>\n+        </div>\n+        \n+        <div class=\"test-case success\">\n+            <h3>Very Tight Spacing</h3>\n+            <div id=\"map3\" class=\"map\"></div>\n+            <div class=\"code\">\n+text: new ol.style.Text({\n+    text: 'Line 1\\nLine 2\\nLine 3',\n+    font: '14px Arial',\n+    lineHeight: 0.6  // 60% line height\n+})\n+            </div>\n+            <p>Very tight spacing for compact text</p>\n+        </div>\n+        \n+        <div class=\"test-case success\">\n+            <h3>Increased Spacing</h3>\n+            <div id=\"map4\" class=\"map\"></div>\n+            <div class=\"code\">\n+text: new ol.style.Text({\n+    text: 'Spaced\\nOut\\nText',\n+    font: '14px Arial',\n+    lineHeight: 1.5  // 150% line height\n+})\n+            </div>\n+            <p>Increased spacing between lines</p>\n+        </div>\n+        \n+        <div class=\"test-case success\">\n+            <h3>With Stroke and Custom Spacing</h3>\n+            <div id=\"map5\" class=\"map\"></div>\n+            <div class=\"code\">\n+text: new ol.style.Text({\n+    text: 'Stroke\\nText',\n+    font: '16px Arial',\n+    lineHeight: 0.7,  // 70% line height\n+    stroke: new ol.style.Stroke({\n+        color: '#000', width: 2\n+    })\n+})\n+            </div>\n+            <p>Custom line height with stroke</p>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        // Import OpenLayers modules\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import {Style, Text, Fill, Stroke} from './src/ol/style.js';\n+        \n+        function createTestCase(mapId, textOptions) {\n+            const feature = new Feature({\n+                geometry: new Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new Style({\n+                text: new Text(textOptions)\n+            }));\n+            \n+            const vectorSource = new VectorSource({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new VectorLayer({\n+                source: vectorSource\n+            });\n+            \n+            const map = new Map({\n+                target: mapId,\n+                layers: [vectorLayer],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 1: Default behavior (original issue)\n+        createTestCase('map1', {\n+            text: '3.5\\nbar',\n+            font: '16px Arial',\n+            fill: new Fill({ color: '#000' }),\n+            textAlign: 'center',\n+            textBaseline: 'middle'\n+        });\n+        \n+        // Test Case 2: Tight line spacing (fix)\n+        createTestCase('map2', {\n+            text: '3.5\\nbar',\n+            font: '16px Arial',\n+            lineHeight: 0.8,\n+            fill: new Fill({ color: '#000' }),\n+            textAlign: 'center',\n+            textBaseline: 'middle'\n+        });\n+        \n+        // Test Case 3: Very tight spacing\n+        createTestCase('map3', {\n+            text: 'Line 1\\nLine 2\\nLine 3',\n+            font: '14px Arial',\n+            lineHeight: 0.6,\n+            fill: new Fill({ color: '#000' }),\n+            textAlign: 'center',\n+            textBaseline: 'middle'\n+        });\n+        \n+        // Test Case 4: Increased spacing\n+        createTestCase('map4', {\n+            text: 'Spaced\\nOut\\nText',\n+            font: '14px Arial',\n+            lineHeight: 1.5,\n+            fill: new Fill({ color: '#000' }),\n+            textAlign: 'center',\n+            textBaseline: 'middle'\n+        });\n+        \n+        // Test Case 5: With stroke and custom spacing\n+        createTestCase('map5', {\n+            text: 'Stroke\\nText',\n+            font: '16px Arial',\n+            lineHeight: 0.7,\n+            fill: new Fill({ color: '#fff' }),\n+            stroke: new Stroke({ color: '#000', width: 2 }),\n+            textAlign: 'center',\n+            textBaseline: 'middle'\n+        });\n+        \n+        console.log('All test cases initialized');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_line_spacing.html b/test_line_spacing.html\nnew file mode 100644\nindex 000000000..969fd7417\n--- /dev/null\n+++ b/test_line_spacing.html\n@@ -0,0 +1,221 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>OpenLayers Text Line Spacing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            display: flex;\n+            flex-wrap: wrap;\n+            gap: 20px;\n+        }\n+        .test-case {\n+            border: 1px solid #ccc;\n+            padding: 10px;\n+            margin: 10px 0;\n+            width: 300px;\n+        }\n+        .map {\n+            width: 100%;\n+            height: 200px;\n+            border: 1px solid #000;\n+        }\n+        h3 {\n+            margin-top: 0;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@latest/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@latest/ol.css\" type=\"text/css\">\n+</head>\n+<body>\n+    <h1>OpenLayers Text Line Spacing Issue Test</h1>\n+    <p>This test demonstrates the gap between lines in multi-line text labels.</p>\n+    \n+    <div class=\"test-container\">\n+        <div class=\"test-case\">\n+            <h3>Test Case 1: Basic Multi-line Text</h3>\n+            <div id=\"map1\" class=\"map\"></div>\n+            <p>Text: \"3.5\\nbar\"</p>\n+        </div>\n+        \n+        <div class=\"test-case\">\n+            <h3>Test Case 2: Three Lines</h3>\n+            <div id=\"map2\" class=\"map\"></div>\n+            <p>Text: \"Line 1\\nLine 2\\nLine 3\"</p>\n+        </div>\n+        \n+        <div class=\"test-case\">\n+            <h3>Test Case 3: Different Font Size</h3>\n+            <div id=\"map3\" class=\"map\"></div>\n+            <p>Text: \"Large\\nText\" (20px font)</p>\n+        </div>\n+        \n+        <div class=\"test-case\">\n+            <h3>Test Case 4: With Stroke</h3>\n+            <div id=\"map4\" class=\"map\"></div>\n+            <p>Text: \"Stroke\\nText\" (with stroke)</p>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Test Case 1: Basic multi-line text\n+        function createTestCase1() {\n+            const feature = new ol.Feature({\n+                geometry: new ol.geom.Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: '3.5\\nbar',\n+                    font: '14px Arial',\n+                    fill: new ol.style.Fill({\n+                        color: '#000'\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new ol.source.Vector({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new ol.layer.Vector({\n+                source: vectorSource\n+            });\n+            \n+            const map = new ol.Map({\n+                target: 'map1',\n+                layers: [vectorLayer],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 2: Three lines\n+        function createTestCase2() {\n+            const feature = new ol.Feature({\n+                geometry: new ol.geom.Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: 'Line 1\\nLine 2\\nLine 3',\n+                    font: '14px Arial',\n+                    fill: new ol.style.Fill({\n+                        color: '#000'\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new ol.source.Vector({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new ol.layer.Vector({\n+                source: vectorSource\n+            });\n+            \n+            const map = new ol.Map({\n+                target: 'map2',\n+                layers: [vectorLayer],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 3: Different font size\n+        function createTestCase3() {\n+            const feature = new ol.Feature({\n+                geometry: new ol.geom.Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: 'Large\\nText',\n+                    font: '20px Arial',\n+                    fill: new ol.style.Fill({\n+                        color: '#000'\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new ol.source.Vector({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new ol.layer.Vector({\n+                source: vectorSource\n+            });\n+            \n+            const map = new ol.Map({\n+                target: 'map3',\n+                layers: [vectorLayer],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 4: With stroke\n+        function createTestCase4() {\n+            const feature = new ol.Feature({\n+                geometry: new ol.geom.Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: 'Stroke\\nText',\n+                    font: '16px Arial',\n+                    fill: new ol.style.Fill({\n+                        color: '#fff'\n+                    }),\n+                    stroke: new ol.style.Stroke({\n+                        color: '#000',\n+                        width: 2\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new ol.source.Vector({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new ol.layer.Vector({\n+                source: vectorSource\n+            });\n+            \n+            const map = new ol.Map({\n+                target: 'map4',\n+                layers: [vectorLayer],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Initialize all test cases\n+        window.onload = function() {\n+            createTestCase1();\n+            createTestCase2();\n+            createTestCase3();\n+            createTestCase4();\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_local_line_spacing.html b/test_local_line_spacing.html\nnew file mode 100644\nindex 000000000..eb05c6959\n--- /dev/null\n+++ b/test_local_line_spacing.html\n@@ -0,0 +1,195 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>OpenLayers Local Build - Text Line Spacing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            display: flex;\n+            flex-wrap: wrap;\n+            gap: 20px;\n+        }\n+        .test-case {\n+            border: 1px solid #ccc;\n+            padding: 10px;\n+            margin: 10px 0;\n+            width: 300px;\n+        }\n+        .map {\n+            width: 100%;\n+            height: 200px;\n+            border: 1px solid #000;\n+        }\n+        h3 {\n+            margin-top: 0;\n+        }\n+        .issue-demo {\n+            background-color: #ffe6e6;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-left: 4px solid #ff0000;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>OpenLayers Local Build - Text Line Spacing Issue Test</h1>\n+    <div class=\"issue-demo\">\n+        <strong>Issue:</strong> There is unwanted gap between lines in multi-line text labels. \n+        This wasn't present in OpenLayers v2.13 but exists in v4.6.4+.\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <div class=\"test-case\">\n+            <h3>Test Case 1: Original Issue Example</h3>\n+            <div id=\"map1\" class=\"map\"></div>\n+            <p>Text: \"3.5\\nbar\" - Shows the gap issue</p>\n+        </div>\n+        \n+        <div class=\"test-case\">\n+            <h3>Test Case 2: Multiple Lines</h3>\n+            <div id=\"map2\" class=\"map\"></div>\n+            <p>Text: \"Line 1\\nLine 2\\nLine 3\" - Multiple gaps</p>\n+        </div>\n+        \n+        <div class=\"test-case\">\n+            <h3>Test Case 3: Canvas Direct Test</h3>\n+            <canvas id=\"canvas1\" width=\"300\" height=\"200\" style=\"border: 1px solid #000;\"></canvas>\n+            <p>Direct canvas rendering to compare</p>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        // Import OpenLayers modules\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import {Style, Text, Fill, Stroke} from './src/ol/style.js';\n+        \n+        // Test Case 1: Original issue example\n+        function createTestCase1() {\n+            const feature = new Feature({\n+                geometry: new Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new Style({\n+                text: new Text({\n+                    text: '3.5\\nbar',\n+                    font: '14px Arial',\n+                    fill: new Fill({\n+                        color: '#000'\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new VectorSource({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new VectorLayer({\n+                source: vectorSource\n+            });\n+            \n+            const map = new Map({\n+                target: 'map1',\n+                layers: [vectorLayer],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 2: Multiple lines\n+        function createTestCase2() {\n+            const feature = new Feature({\n+                geometry: new Point([0, 0])\n+            });\n+            \n+            feature.setStyle(new Style({\n+                text: new Text({\n+                    text: 'Line 1\\nLine 2\\nLine 3',\n+                    font: '14px Arial',\n+                    fill: new Fill({\n+                        color: '#000'\n+                    }),\n+                    textAlign: 'center',\n+                    textBaseline: 'middle'\n+                })\n+            }));\n+            \n+            const vectorSource = new VectorSource({\n+                features: [feature]\n+            });\n+            \n+            const vectorLayer = new VectorLayer({\n+                source: vectorSource\n+            });\n+            \n+            const map = new Map({\n+                target: 'map2',\n+                layers: [vectorLayer],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 10\n+                })\n+            });\n+        }\n+        \n+        // Test Case 3: Direct canvas test to show the issue\n+        function createCanvasTest() {\n+            const canvas = document.getElementById('canvas1');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f0f0f0';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            // Test current OpenLayers approach\n+            ctx.font = '14px Arial';\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            ctx.fillStyle = '#000';\n+            \n+            const text = '3.5\\nbar';\n+            const lines = text.split('\\n');\n+            const lineHeight = 16; // Approximate line height for 14px font\n+            \n+            // Current OpenLayers approach (with gap)\n+            ctx.fillText('Current OpenLayers approach:', 75, 30);\n+            for (let i = 0; i < lines.length; i++) {\n+                ctx.fillText(lines[i], 75, 60 + i * lineHeight);\n+            }\n+            \n+            // Tighter spacing approach (what user wants)\n+            ctx.fillText('Desired tighter spacing:', 225, 30);\n+            const tighterLineHeight = 12; // Reduced line height\n+            for (let i = 0; i < lines.length; i++) {\n+                ctx.fillText(lines[i], 225, 60 + i * tighterLineHeight);\n+            }\n+            \n+            // Draw comparison lines\n+            ctx.strokeStyle = '#ccc';\n+            ctx.setLineDash([5, 5]);\n+            ctx.beginPath();\n+            ctx.moveTo(150, 0);\n+            ctx.lineTo(150, canvas.height);\n+            ctx.stroke();\n+        }\n+        \n+        // Initialize all test cases\n+        window.addEventListener('load', function() {\n+            createTestCase1();\n+            createTestCase2();\n+            createCanvasTest();\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple_canvas.html b/test_simple_canvas.html\nnew file mode 100644\nindex 000000000..28b79c692\n--- /dev/null\n+++ b/test_simple_canvas.html\n@@ -0,0 +1,222 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Canvas Test - Line Height Implementation</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-case {\n+            border: 1px solid #ccc;\n+            padding: 15px;\n+            margin: 20px 0;\n+        }\n+        canvas {\n+            border: 1px solid #000;\n+            margin: 10px 0;\n+        }\n+        .success {\n+            background-color: #e8f5e8;\n+            border-left: 4px solid #4caf50;\n+        }\n+        .issue {\n+            background-color: #ffe6e6;\n+            border-left: 4px solid #ff0000;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Line Height Implementation Test - Canvas Simulation</h1>\n+    <p>This test simulates the OpenLayers line height implementation using direct canvas rendering.</p>\n+    \n+    <div class=\"test-case issue\">\n+        <h3>Before Fix: Current OpenLayers Behavior</h3>\n+        <canvas id=\"beforeCanvas\" width=\"400\" height=\"150\"></canvas>\n+        <p>Shows the current line spacing with gaps</p>\n+    </div>\n+    \n+    <div class=\"test-case success\">\n+        <h3>After Fix: With lineHeight = 0.8</h3>\n+        <canvas id=\"afterCanvas\" width=\"400\" height=\"150\"></canvas>\n+        <p>Shows reduced line spacing using lineHeight property</p>\n+    </div>\n+    \n+    <div class=\"test-case success\">\n+        <h3>Verification: Multiple Line Heights</h3>\n+        <canvas id=\"multiCanvas\" width=\"600\" height=\"200\"></canvas>\n+        <p>Comparison of different lineHeight values</p>\n+    </div>\n+\n+    <script>\n+        // Simulate the measureTextHeight function\n+        function measureTextHeight(font) {\n+            const span = document.createElement('span');\n+            span.textContent = 'M';\n+            span.style.font = font;\n+            span.style.position = 'absolute';\n+            span.style.left = '-9999px';\n+            document.body.appendChild(span);\n+            const height = span.offsetHeight;\n+            document.body.removeChild(span);\n+            return height;\n+        }\n+        \n+        // Simulate current OpenLayers behavior (before fix)\n+        function drawCurrentBehavior() {\n+            const canvas = document.getElementById('beforeCanvas');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f9f9f9';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            const font = '16px Arial';\n+            const text = '3.5\\nbar';\n+            const lines = text.split('\\n');\n+            const strokeWidth = 0;\n+            \n+            ctx.font = font;\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            ctx.fillStyle = '#000';\n+            \n+            const measuredLineHeight = measureTextHeight(font);\n+            // Current OpenLayers formula (creates gap)\n+            const lineHeight = measuredLineHeight;\n+            \n+            const x = 100;\n+            for (let i = 0; i < lines.length; i++) {\n+                const y = 0.5 * (strokeWidth + lineHeight) + i * lineHeight + 50;\n+                ctx.fillText(lines[i], x, y);\n+                \n+                // Draw guide lines\n+                ctx.save();\n+                ctx.strokeStyle = '#ff0000';\n+                ctx.lineWidth = 1;\n+                ctx.setLineDash([2, 2]);\n+                ctx.beginPath();\n+                ctx.moveTo(x - 50, y);\n+                ctx.lineTo(x + 50, y);\n+                ctx.stroke();\n+                ctx.restore();\n+            }\n+            \n+            // Add labels\n+            ctx.fillStyle = '#666';\n+            ctx.font = '12px Arial';\n+            ctx.textAlign = 'left';\n+            ctx.fillText('Current behavior (with gap)', 150, 70);\n+            ctx.fillText(`Measured line height: ${measuredLineHeight}px`, 150, 85);\n+            ctx.fillText(`Actual spacing: ${lineHeight}px`, 150, 100);\n+        }\n+        \n+        // Simulate new behavior with lineHeight property\n+        function drawNewBehavior() {\n+            const canvas = document.getElementById('afterCanvas');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f9f9f9';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            const font = '16px Arial';\n+            const text = '3.5\\nbar';\n+            const lines = text.split('\\n');\n+            const strokeWidth = 0;\n+            const lineHeightRatio = 0.8; // New property value\n+            \n+            ctx.font = font;\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            ctx.fillStyle = '#000';\n+            \n+            const measuredLineHeight = measureTextHeight(font);\n+            // New formula with lineHeight property\n+            const lineHeight = measuredLineHeight * lineHeightRatio;\n+            \n+            const x = 100;\n+            for (let i = 0; i < lines.length; i++) {\n+                const y = 0.5 * (strokeWidth + lineHeight) + i * lineHeight + 50;\n+                ctx.fillText(lines[i], x, y);\n+                \n+                // Draw guide lines\n+                ctx.save();\n+                ctx.strokeStyle = '#00aa00';\n+                ctx.lineWidth = 1;\n+                ctx.setLineDash([2, 2]);\n+                ctx.beginPath();\n+                ctx.moveTo(x - 50, y);\n+                ctx.lineTo(x + 50, y);\n+                ctx.stroke();\n+                ctx.restore();\n+            }\n+            \n+            // Add labels\n+            ctx.fillStyle = '#666';\n+            ctx.font = '12px Arial';\n+            ctx.textAlign = 'left';\n+            ctx.fillText('New behavior (lineHeight = 0.8)', 150, 70);\n+            ctx.fillText(`Measured line height: ${measuredLineHeight}px`, 150, 85);\n+            ctx.fillText(`Actual spacing: ${lineHeight.toFixed(1)}px`, 150, 100);\n+        }\n+        \n+        // Show multiple line height comparisons\n+        function drawMultipleComparisons() {\n+            const canvas = document.getElementById('multiCanvas');\n+            const ctx = canvas.getContext('2d');\n+            \n+            // Clear canvas\n+            ctx.fillStyle = '#f9f9f9';\n+            ctx.fillRect(0, 0, canvas.width, canvas.height);\n+            \n+            const font = '14px Arial';\n+            const text = 'Line 1\\nLine 2\\nLine 3';\n+            const lines = text.split('\\n');\n+            const strokeWidth = 0;\n+            const lineHeightRatios = [1.0, 0.8, 0.6, 1.5]; // Different ratios\n+            const labels = ['Default (1.0)', 'Tight (0.8)', 'Very Tight (0.6)', 'Spaced (1.5)'];\n+            const colors = ['#000', '#0066cc', '#cc6600', '#cc0066'];\n+            \n+            ctx.font = font;\n+            ctx.textAlign = 'center';\n+            ctx.textBaseline = 'middle';\n+            \n+            const measuredLineHeight = measureTextHeight(font);\n+            \n+            for (let ratio = 0; ratio < lineHeightRatios.length; ratio++) {\n+                const lineHeightRatio = lineHeightRatios[ratio];\n+                const lineHeight = measuredLineHeight * lineHeightRatio;\n+                const x = 100 + ratio * 120;\n+                \n+                ctx.fillStyle = colors[ratio];\n+                \n+                for (let i = 0; i < lines.length; i++) {\n+                    const y = 0.5 * (strokeWidth + lineHeight) + i * lineHeight + 80;\n+                    ctx.fillText(lines[i], x, y);\n+                }\n+                \n+                // Add labels\n+                ctx.fillStyle = '#666';\n+                ctx.font = '10px Arial';\n+                ctx.fillText(labels[ratio], x, 40);\n+                ctx.fillText(`${lineHeight.toFixed(1)}px`, x, 140);\n+            }\n+            \n+            // Add title\n+            ctx.fillStyle = '#333';\n+            ctx.font = '12px Arial';\n+            ctx.textAlign = 'left';\n+            ctx.fillText('Comparison of different lineHeight values:', 20, 25);\n+        }\n+        \n+        // Initialize all tests\n+        window.onload = function() {\n+            drawCurrentBehavior();\n+            drawNewBehavior();\n+            drawMultipleComparisons();\n+            console.log('Canvas tests completed successfully');\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

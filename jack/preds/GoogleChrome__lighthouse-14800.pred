{"instance_id": "GoogleChrome__lighthouse-14800", "model_patch": "diff --git a/core/lib/tracehouse/trace-processor.js b/core/lib/tracehouse/trace-processor.js\nindex eff4c6f0d..32f1c4081 100644\n--- a/core/lib/tracehouse/trace-processor.js\n+++ b/core/lib/tracehouse/trace-processor.js\n@@ -495,7 +495,13 @@ class TraceProcessor {\n \n     // \"Modern\" traces with a navigation have a FrameCommittedInBrowser event\n     const mainFramePids = frameCommittedEvts.length\n-      ? frameCommittedEvts.map(e => e?.args?.data?.processId)\n+      ? frameCommittedEvts.map(e => {\n+        // Some traces have processPseudoId instead of processId\n+        // If processId is not available but processPseudoId exists, fall back to startingPid\n+        const hasProcessId = e?.args?.data?.processId;\n+        const hasProcessPseudoId = e?.args?.data?.processPseudoId;\n+        return hasProcessId || (hasProcessPseudoId ? mainFrameInfo.startingPid : undefined);\n+      })\n       // \u2026But old traces and some timespan traces may not. In these situations, we'll assume the\n       // primary process ID remains constant (as there were no navigations).\n       : [mainFrameInfo.startingPid];\ndiff --git a/test/issue-reproduction.js b/test/issue-reproduction.js\nnew file mode 100644\nindex 000000000..57eb9284a\n--- /dev/null\n+++ b/test/issue-reproduction.js\n@@ -0,0 +1,146 @@\n+/**\n+ * Test file to reproduce the issue with processPseudoId.\n+ */\n+\n+import {TraceProcessor} from '../core/lib/tracehouse/trace-processor.js';\n+\n+// Test case 1: Create a mock trace with a FrameCommittedInBrowser event that has processPseudoId instead of processId\n+function createMockTraceWithProcessPseudoId() {\n+  const frameId = 'frame1';\n+  const startingPid = 78114;\n+  const processPseudoId = '0x1b2e22e2100';\n+  \n+  // Create a mainFrameInfo object\n+  const mainFrameInfo = {\n+    startingPid,\n+    frameId,\n+  };\n+  \n+  // Create keyEvents with a FrameCommittedInBrowser event that has processPseudoId instead of processId\n+  const keyEvents = [\n+    {\n+      name: 'FrameCommittedInBrowser',\n+      args: {\n+        data: {\n+          frame: frameId,\n+          processPseudoId: processPseudoId,\n+          // No processId field\n+        }\n+      }\n+    },\n+    // Add a thread_name event for the process\n+    {\n+      cat: '__metadata',\n+      pid: startingPid, // We'll use the startingPid since that's what should be used as fallback\n+      ph: 'M',\n+      name: 'thread_name',\n+      args: {\n+        name: 'CrRendererMain'\n+      },\n+      tid: 259\n+    }\n+  ];\n+  \n+  return { mainFrameInfo, keyEvents };\n+}\n+\n+// Test case 2: Create a mock trace with a FrameCommittedInBrowser event that has processId (normal case)\n+function createMockTraceWithProcessId() {\n+  const frameId = 'frame1';\n+  const startingPid = 78114;\n+  const processId = 78114;\n+  \n+  // Create a mainFrameInfo object\n+  const mainFrameInfo = {\n+    startingPid,\n+    frameId,\n+  };\n+  \n+  // Create keyEvents with a FrameCommittedInBrowser event that has processId\n+  const keyEvents = [\n+    {\n+      name: 'FrameCommittedInBrowser',\n+      args: {\n+        data: {\n+          frame: frameId,\n+          processId: processId,\n+        }\n+      }\n+    },\n+    // Add a thread_name event for the process\n+    {\n+      cat: '__metadata',\n+      pid: processId,\n+      ph: 'M',\n+      name: 'thread_name',\n+      args: {\n+        name: 'CrRendererMain'\n+      },\n+      tid: 259\n+    }\n+  ];\n+  \n+  return { mainFrameInfo, keyEvents };\n+}\n+\n+// Test case 3: Create a mock trace with no FrameCommittedInBrowser events (fallback to startingPid)\n+function createMockTraceWithNoFrameCommittedEvents() {\n+  const frameId = 'frame1';\n+  const startingPid = 78114;\n+  \n+  // Create a mainFrameInfo object\n+  const mainFrameInfo = {\n+    startingPid,\n+    frameId,\n+  };\n+  \n+  // Create keyEvents with no FrameCommittedInBrowser events\n+  const keyEvents = [\n+    // Add a thread_name event for the process\n+    {\n+      cat: '__metadata',\n+      pid: startingPid,\n+      ph: 'M',\n+      name: 'thread_name',\n+      args: {\n+        name: 'CrRendererMain'\n+      },\n+      tid: 259\n+    }\n+  ];\n+  \n+  return { mainFrameInfo, keyEvents };\n+}\n+\n+// Test all cases\n+function runTests() {\n+  console.log('=== Test Case 1: FrameCommittedInBrowser with processPseudoId ===');\n+  const { mainFrameInfo: info1, keyEvents: events1 } = createMockTraceWithProcessPseudoId();\n+  try {\n+    const pidToTid1 = TraceProcessor.findMainFramePidTids(info1, events1);\n+    console.log('SUCCESS: pidToTid =', pidToTid1);\n+  } catch (error) {\n+    console.error('FAILURE:', error.message);\n+  }\n+  \n+  console.log('\\n=== Test Case 2: FrameCommittedInBrowser with processId (normal case) ===');\n+  const { mainFrameInfo: info2, keyEvents: events2 } = createMockTraceWithProcessId();\n+  try {\n+    const pidToTid2 = TraceProcessor.findMainFramePidTids(info2, events2);\n+    console.log('SUCCESS: pidToTid =', pidToTid2);\n+  } catch (error) {\n+    console.error('FAILURE:', error.message);\n+  }\n+  \n+  console.log('\\n=== Test Case 3: No FrameCommittedInBrowser events (fallback to startingPid) ===');\n+  const { mainFrameInfo: info3, keyEvents: events3 } = createMockTraceWithNoFrameCommittedEvents();\n+  try {\n+    const pidToTid3 = TraceProcessor.findMainFramePidTids(info3, events3);\n+    console.log('SUCCESS: pidToTid =', pidToTid3);\n+  } catch (error) {\n+    console.error('FAILURE:', error.message);\n+  }\n+}\n+\n+// Run all tests\n+runTests();\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

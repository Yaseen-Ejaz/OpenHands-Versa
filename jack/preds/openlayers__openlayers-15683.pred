{"instance_id": "openlayers__openlayers-15683", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..3a8175f7b\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,13 @@\n+\n+> ol@9.1.1-dev serve-examples\n+> webpack serve --config examples/webpack/config.mjs --mode development\n+\n+Browserslist: caniuse-lite is outdated. Please run:\n+  npx update-browserslist-db@latest\n+  Why you should do it regularly: https://github.com/browserslist/update-db#readme\n+<i> [webpack-dev-server] Project is running at:\n+<i> [webpack-dev-server] Loopback: http://localhost:8080/\n+<i> [webpack-dev-server] Content not from webpack is served from '/workspace/openlayers__openlayers__/public' directory\n+638 assets\n+837 modules\n+webpack 5.90.3 compiled successfully in 2007 ms\ndiff --git a/test_rotation_issue.html b/test_rotation_issue.html\nnew file mode 100644\nindex 000000000..5c4769db3\n--- /dev/null\n+++ b/test_rotation_issue.html\n@@ -0,0 +1,106 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Vector Layer Canvas Rotation Issue Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"controls\">\n+        <button onclick=\"createLargePolygon()\">Create Large Polygon</button>\n+        <button onclick=\"rotateMap(Math.PI/4)\">Rotate 45\u00b0</button>\n+        <button onclick=\"rotateMap(0)\">Reset Rotation</button>\n+        <button onclick=\"rotateMap(-Math.PI/4)\">Rotate -45\u00b0</button>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import {Fill, Stroke, Style} from './src/ol/style.js';\n+        import {OSM, Vector as VectorSource} from './src/ol/source.js';\n+        import {Tile as TileLayer, Vector as VectorLayer} from './src/ol/layer.js';\n+        import {Polygon} from './src/ol/geom.js';\n+        import Feature from './src/ol/Feature.js';\n+\n+        const source = new VectorSource();\n+\n+        const vector = new VectorLayer({\n+            source: source,\n+            style: new Style({\n+                fill: new Fill({\n+                    color: 'rgba(255, 0, 0, 0.3)',\n+                }),\n+                stroke: new Stroke({\n+                    color: 'red',\n+                    width: 2,\n+                }),\n+            }),\n+        });\n+\n+        const map = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                vector\n+            ],\n+            target: 'map',\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2,\n+            }),\n+        });\n+\n+        // Make functions global for button access\n+        window.createLargePolygon = function() {\n+            source.clear();\n+            \n+            // Create a large polygon that spans most of the visible area\n+            const view = map.getView();\n+            const extent = view.calculateExtent(map.getSize());\n+            const width = extent[2] - extent[0];\n+            const height = extent[3] - extent[1];\n+            \n+            // Create polygon that spans 80% of the view width and height\n+            const centerX = (extent[0] + extent[2]) / 2;\n+            const centerY = (extent[1] + extent[3]) / 2;\n+            const polyWidth = width * 0.8;\n+            const polyHeight = height * 0.8;\n+            \n+            const coordinates = [[\n+                [centerX - polyWidth/2, centerY - polyHeight/2],\n+                [centerX + polyWidth/2, centerY - polyHeight/2],\n+                [centerX + polyWidth/2, centerY + polyHeight/2],\n+                [centerX - polyWidth/2, centerY + polyHeight/2],\n+                [centerX - polyWidth/2, centerY - polyHeight/2]\n+            ]];\n+            \n+            const polygon = new Polygon(coordinates);\n+            const feature = new Feature(polygon);\n+            source.addFeature(feature);\n+        };\n+\n+        window.rotateMap = function(rotation) {\n+            map.getView().setRotation(rotation);\n+        };\n+\n+        // Create initial polygon\n+        setTimeout(() => {\n+            window.createLargePolygon();\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

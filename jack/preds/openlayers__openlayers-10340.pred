{"instance_id": "openlayers__openlayers-10340", "model_patch": "diff --git a/src/ol/interaction/Draw.js b/src/ol/interaction/Draw.js\nindex c4e2824b4..ceeb913c2 100644\n--- a/src/ol/interaction/Draw.js\n+++ b/src/ol/interaction/Draw.js\n@@ -19,6 +19,7 @@ import MultiPoint from '../geom/MultiPoint.js';\n import MultiPolygon from '../geom/MultiPolygon.js';\n import Point from '../geom/Point.js';\n import Polygon, {fromCircle, makeRegular} from '../geom/Polygon.js';\n+import {getUserProjection, transform, getTransform} from '../proj.js';\n import PointerInteraction from './Pointer.js';\n import InteractionProperty from './Property.js';\n import VectorLayer from '../layer/Vector.js';\n@@ -965,21 +966,73 @@ function getDefaultStyleFunction() {\n  *     polygon.\n  * @api\n  */\n+/**\n+ * Create a geometry function for drawing regular polygons.\n+ * The function can be configured by giving the number of sides and an angle.\n+ * \n+ * When used with useGeographic(), this function ensures that the polygon\n+ * appears regular on the map regardless of latitude.\n+ * \n+ * @param {number=} opt_sides Number of sides of the regular polygon. Default is 30.\n+ * @param {number=} opt_angle Angle of the first point in radians. 0 means East.\n+ * @return {GeometryFunction} Function that draws a regular polygon.\n+ * @api\n+ */\n export function createRegularPolygon(opt_sides, opt_angle) {\n   return function(coordinates, opt_geometry) {\n+    // Import necessary functions\n+    const getUserProjection = require('../proj.js').getUserProjection;\n+    const transform = require('../proj.js').transform;\n+    const getTransform = require('../proj.js').getTransform;\n+    \n     const center = /** @type {LineCoordType} */ (coordinates)[0];\n     const end = /** @type {LineCoordType} */ (coordinates)[1];\n-    const radius = Math.sqrt(\n-      squaredCoordinateDistance(center, end));\n-    const geometry = opt_geometry ? /** @type {Polygon} */ (opt_geometry) :\n-      fromCircle(new Circle(center), opt_sides);\n+    \n+    // Check if we're using geographic coordinates\n+    const userProjection = getUserProjection();\n+    const isGeographic = userProjection && userProjection.getCode() === 'EPSG:4326';\n+    \n+    // Calculate radius and angle\n+    const radius = Math.sqrt(squaredCoordinateDistance(center, end));\n     let angle = opt_angle;\n     if (!opt_angle) {\n       const x = end[0] - center[0];\n       const y = end[1] - center[1];\n       angle = Math.atan(y / x) - (x < 0 ? Math.PI : 0);\n     }\n-    makeRegular(geometry, center, radius, angle);\n+    \n+    // Create or reuse geometry\n+    const geometry = opt_geometry ? /** @type {Polygon} */ (opt_geometry) :\n+      fromCircle(new Circle(center), opt_sides);\n+    \n+    // For geographic coordinates, we need to ensure the shape is regular in the view\n+    if (isGeographic) {\n+      // Create a regular polygon in Mercator space to ensure it appears regular on the map\n+      const mercatorCenter = transform(center, 'EPSG:4326', 'EPSG:3857');\n+      const mercatorEnd = transform(end, 'EPSG:4326', 'EPSG:3857');\n+      \n+      // Calculate radius in Mercator space\n+      const mercatorRadius = Math.sqrt(\n+        squaredCoordinateDistance(mercatorCenter, mercatorEnd));\n+      \n+      // Create a temporary polygon in Mercator space\n+      const mercatorGeometry = fromCircle(new Circle(mercatorCenter), opt_sides);\n+      makeRegular(mercatorGeometry, mercatorCenter, mercatorRadius, angle);\n+      \n+      // Transform the coordinates back to geographic\n+      const mercatorToGeographic = getTransform('EPSG:3857', 'EPSG:4326');\n+      const coords = mercatorGeometry.getCoordinates();\n+      const geographicCoords = coords.map(ring => \n+        ring.map(coord => mercatorToGeographic(coord.slice(0)))\n+      );\n+      \n+      // Set the coordinates on the original geometry\n+      geometry.setCoordinates(geographicCoords);\n+    } else {\n+      // Standard behavior for non-geographic projections\n+      makeRegular(geometry, center, radius, angle);\n+    }\n+    \n     return geometry;\n   };\n }\n@@ -992,6 +1045,17 @@ export function createRegularPolygon(opt_sides, opt_angle) {\n  * @return {GeometryFunction} Function that draws a box-shaped polygon.\n  * @api\n  */\n+/**\n+ * Create a `geometryFunction` that will create a box-shaped polygon (aligned\n+ * with the coordinate system axes).  Use this with the draw interaction and\n+ * `type: 'Circle'` to return a box instead of a circle geometry.\n+ * \n+ * When used with useGeographic(), this function ensures that the box\n+ * appears rectangular on the map regardless of latitude.\n+ * \n+ * @return {GeometryFunction} Function that draws a box-shaped polygon.\n+ * @api\n+ */\n export function createBox() {\n   return (\n     function(coordinates, opt_geometry) {\ndiff --git a/test-geographic-draw.html b/test-geographic-draw.html\nnew file mode 100644\nindex 000000000..51403965e\n--- /dev/null\n+++ b/test-geographic-draw.html\n@@ -0,0 +1,166 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+  <meta charset=\"UTF-8\">\n+  <title>Geographic Draw Test</title>\n+  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@v7.3.0/ol.css\">\n+  <style>\n+    html, body, #map {\n+      margin: 0;\n+      padding: 0;\n+      width: 100%;\n+      height: 100%;\n+    }\n+    .controls {\n+      position: absolute;\n+      top: 10px;\n+      left: 10px;\n+      background: white;\n+      padding: 10px;\n+      border-radius: 4px;\n+      z-index: 1000;\n+    }\n+  </style>\n+  <script src=\"https://cdn.jsdelivr.net/npm/ol@v7.3.0/dist/ol.js\"></script>\n+</head>\n+<body>\n+  <div id=\"map\"></div>\n+  <div class=\"controls\">\n+    <div>\n+      <label for=\"shape-type\">Shape type:</label>\n+      <select id=\"shape-type\">\n+        <option value=\"Circle\">Circle</option>\n+        <option value=\"Square\">Square</option>\n+        <option value=\"Box\">Box</option>\n+        <option value=\"RegularPolygon\">Regular Polygon</option>\n+      </select>\n+    </div>\n+    <div>\n+      <label for=\"use-geographic\">Use Geographic:</label>\n+      <input type=\"checkbox\" id=\"use-geographic\" checked>\n+    </div>\n+    <button id=\"clear-button\">Clear</button>\n+  </div>\n+\n+  <script>\n+    // Import OpenLayers components\n+    const Map = ol.Map;\n+    const View = ol.View;\n+    const TileLayer = ol.layer.Tile;\n+    const VectorLayer = ol.layer.Vector;\n+    const OSM = ol.source.OSM;\n+    const VectorSource = ol.source.Vector;\n+    const Draw = ol.interaction.Draw;\n+    const createRegularPolygon = ol.interaction.Draw.createRegularPolygon;\n+    const createBox = ol.interaction.Draw.createBox;\n+    const useGeographic = ol.proj.useGeographic;\n+    const clearUserProjection = ol.proj.clearUserProjection;\n+    const Style = ol.style.Style;\n+    const Fill = ol.style.Fill;\n+    const Stroke = ol.style.Stroke;\n+    const GeometryType = ol.geom.GeometryType;\n+\n+    // Initial setup with geographic projection\n+    let usingGeographic = true;\n+    if (usingGeographic) {\n+      useGeographic();\n+    }\n+\n+    // Vector source for drawn features\n+    const source = new VectorSource();\n+\n+    // Vector layer for drawn features\n+    const vector = new VectorLayer({\n+      source: source,\n+      style: new Style({\n+        fill: new Fill({\n+          color: 'rgba(255, 255, 255, 0.2)'\n+        }),\n+        stroke: new Stroke({\n+          color: '#0000ff',\n+          width: 2\n+        })\n+      })\n+    });\n+\n+    // OSM base layer\n+    const baseLayer = new TileLayer({\n+      source: new OSM()\n+    });\n+\n+    // Map\n+    const map = new Map({\n+      layers: [baseLayer, vector],\n+      target: 'map',\n+      view: new View({\n+        center: [0, 0],\n+        zoom: 2\n+      })\n+    });\n+\n+    // Current draw interaction\n+    let draw;\n+\n+    // Function to add draw interaction\n+    function addDrawInteraction() {\n+      const shapeType = document.getElementById('shape-type').value;\n+      let geometryFunction;\n+      let type = GeometryType.CIRCLE;\n+\n+      if (shapeType === 'Square') {\n+        geometryFunction = createRegularPolygon(4);\n+      } else if (shapeType === 'Box') {\n+        geometryFunction = createBox();\n+      } else if (shapeType === 'RegularPolygon') {\n+        geometryFunction = createRegularPolygon(6);\n+      }\n+\n+      draw = new Draw({\n+        source: source,\n+        type: type,\n+        geometryFunction: geometryFunction\n+      });\n+      map.addInteraction(draw);\n+    }\n+\n+    // Add initial draw interaction\n+    addDrawInteraction();\n+\n+    // Handle shape type change\n+    document.getElementById('shape-type').addEventListener('change', function() {\n+      map.removeInteraction(draw);\n+      addDrawInteraction();\n+    });\n+\n+    // Handle geographic toggle\n+    document.getElementById('use-geographic').addEventListener('change', function(e) {\n+      usingGeographic = e.target.checked;\n+      \n+      // Remove current draw interaction\n+      map.removeInteraction(draw);\n+      \n+      // Clear user projection\n+      clearUserProjection();\n+      \n+      // Set new projection\n+      if (usingGeographic) {\n+        useGeographic();\n+      }\n+      \n+      // Recreate the map view to apply the new projection\n+      map.setView(new View({\n+        center: usingGeographic ? [0, 0] : [0, 0],\n+        zoom: 2\n+      }));\n+      \n+      // Add new draw interaction\n+      addDrawInteraction();\n+    });\n+\n+    // Clear button\n+    document.getElementById('clear-button').addEventListener('click', function() {\n+      source.clear();\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "claude-3-7-sonnet-20250219"}

43] \"GET /src/ol/geom/flat/transform.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/webgl/PostProcessingPass.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/DataTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/geom/Geometry.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/ImageState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 08:38:43] \"GET /src/ol/source/Source.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/webgl/TileLayer.js b/src/ol/renderer/webgl/TileLayer.js\nindex 5de570b2c..bfc43d458 100644\n--- a/src/ol/renderer/webgl/TileLayer.js\n+++ b/src/ol/renderer/webgl/TileLayer.js\n@@ -247,6 +247,18 @@ class WebGLTileLayerRenderer extends WebGLLayerRenderer {\n      * @type {import(\"../../Map.js\").FrameState|null}\n      */\n     this.frameState_ = null;\n+\n+    /**\n+     * @private\n+     * @type {string|null}\n+     */\n+    this.currentSourceKey_ = null;\n+\n+    /**\n+     * @private\n+     * @type {string|null}\n+     */\n+    this.currentProjectionCode_ = null;\n   }\n \n   /**\n@@ -305,6 +317,23 @@ class WebGLTileLayerRenderer extends WebGLLayerRenderer {\n       return false;\n     }\n \n+    // Check if source or projection has changed and clear cache if needed\n+    const sourceKey = source.getKey();\n+    const projectionCode = frameState.viewState.projection.getCode();\n+\n+    if (\n+      this.currentSourceKey_ !== sourceKey ||\n+      this.currentProjectionCode_ !== projectionCode\n+    ) {\n+      // Source or projection has changed, clear the tile texture cache\n+      if (this.tileTextureCache_) {\n+        this.tileTextureCache_.forEach((tileTexture) => tileTexture.dispose());\n+        this.tileTextureCache_.clear();\n+      }\n+      this.currentSourceKey_ = sourceKey;\n+      this.currentProjectionCode_ = projectionCode;\n+    }\n+\n     if (isEmpty(getRenderExtent(frameState, frameState.extent))) {\n       return false;\n     }\ndiff --git a/test_cache_invalidation.js b/test_cache_invalidation.js\nnew file mode 100644\nindex 000000000..19979bbc6\n--- /dev/null\n+++ b/test_cache_invalidation.js\n@@ -0,0 +1,121 @@\n+/**\n+ * Test for WebGL tile cache invalidation fix\n+ */\n+\n+import TileQueue from '../src/ol/TileQueue.js';\n+import WebGLTileLayer from '../src/ol/layer/WebGLTile.js';\n+import {DataTile, XYZ} from '../src/ol/source.js';\n+import {VOID} from '../src/ol/functions.js';\n+import {create} from '../src/ol/transform.js';\n+import {createCanvasContext2D} from '../src/ol/dom.js';\n+import {get} from '../src/ol/proj.js';\n+\n+describe('WebGL Tile Cache Invalidation', function () {\n+  /** @type {import(\"../src/ol/renderer/webgl/TileLayer.js\").default} */\n+  let renderer;\n+  /** @type {WebGLTileLayer} */\n+  let tileLayer;\n+  /** @type {import('../src/ol/Map.js').FrameState} */\n+  let frameState;\n+\n+  beforeEach(function () {\n+    const size = 256;\n+    const context = createCanvasContext2D(size, size);\n+\n+    tileLayer = new WebGLTileLayer({\n+      source: new DataTile({\n+        loader: function (z, x, y) {\n+          context.clearRect(0, 0, size, size);\n+          context.fillStyle = 'rgba(100, 100, 100, 0.5)';\n+          context.fillRect(0, 0, size, size);\n+          const data = context.getImageData(0, 0, size, size).data;\n+          return data;\n+        },\n+      }),\n+    });\n+\n+    renderer = tileLayer.getRenderer();\n+\n+    const proj = get('EPSG:3857');\n+    frameState = {\n+      layerStatesArray: [tileLayer.getLayerState()],\n+      layerIndex: 0,\n+      extent: proj.getExtent(),\n+      pixelRatio: 1,\n+      pixelToCoordinateTransform: create(),\n+      postRenderFunctions: [],\n+      time: Date.now(),\n+      viewHints: [],\n+      viewState: {\n+        center: [0, 0],\n+        resolution: 156543.03392804097,\n+        projection: proj,\n+      },\n+      size: [256, 256],\n+      usedTiles: {},\n+      wantedTiles: {},\n+      tileQueue: new TileQueue(VOID, VOID),\n+      renderTargets: {},\n+    };\n+  });\n+\n+  afterEach(function () {\n+    tileLayer.dispose();\n+  });\n+\n+  it('clears cache when source changes', function () {\n+    // Prepare initial frame to populate cache\n+    renderer.prepareFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(0); // No tiles loaded yet\n+    \n+    // Render frame to load tiles\n+    renderer.renderFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(1); // One tile loaded\n+    \n+    // Change source\n+    const newSource = new DataTile({\n+      loader: function (z, x, y) {\n+        const context = createCanvasContext2D(256, 256);\n+        context.clearRect(0, 0, 256, 256);\n+        context.fillStyle = 'rgba(200, 200, 200, 0.5)'; // Different color\n+        context.fillRect(0, 0, 256, 256);\n+        const data = context.getImageData(0, 0, 256, 256).data;\n+        return data;\n+      },\n+    });\n+    \n+    tileLayer.setSource(newSource);\n+    frameState.layerStatesArray = [tileLayer.getLayerState()];\n+    \n+    // Prepare frame with new source - cache should be cleared\n+    renderer.prepareFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(0); // Cache cleared\n+  });\n+\n+  it('clears cache when projection changes', function () {\n+    // Prepare initial frame to populate cache\n+    renderer.prepareFrame(frameState);\n+    renderer.renderFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(1); // One tile loaded\n+    \n+    // Change projection\n+    const newProj = get('EPSG:4326');\n+    frameState.viewState.projection = newProj;\n+    frameState.extent = newProj.getExtent();\n+    \n+    // Prepare frame with new projection - cache should be cleared\n+    renderer.prepareFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(0); // Cache cleared\n+  });\n+\n+  it('does not clear cache when neither source nor projection changes', function () {\n+    // Prepare initial frame to populate cache\n+    renderer.prepareFrame(frameState);\n+    renderer.renderFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(1); // One tile loaded\n+    \n+    // Prepare frame again without changes - cache should remain\n+    renderer.prepareFrame(frameState);\n+    expect(renderer.tileTextureCache_.count_).to.be(1); // Cache preserved\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_cache_issue_local.html b/test_cache_issue_local.html\nnew file mode 100644\nindex 000000000..ee09bf4f6\n--- /dev/null\n+++ b/test_cache_issue_local.html\n@@ -0,0 +1,222 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Cache Issue Test - Local Build</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map-container {\n+            width: 800px;\n+            height: 400px;\n+            border: 1px solid #ccc;\n+            margin: 10px 0;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+            font-size: 14px;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .debug {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #fff3cd;\n+            border: 1px solid #ffeaa7;\n+            border-radius: 4px;\n+            font-family: monospace;\n+            font-size: 12px;\n+            max-height: 200px;\n+            overflow-y: auto;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Tile Cache Issue Test - Local Build</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Test Instructions:</h3>\n+        <ol>\n+            <li>Pan/zoom around to load some tiles (watch debug log)</li>\n+            <li>Click \"Change Source\" to switch to a different tile source</li>\n+            <li>Pan/zoom to new areas (should show new tiles correctly)</li>\n+            <li>Pan back to previously cached areas</li>\n+            <li><strong>BUG:</strong> You should see old tiles from the previous source instead of new tiles</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"controls\">\n+        <button id=\"changeSource\">Change Source</button>\n+        <button id=\"changeProjection\">Change Projection</button>\n+        <button id=\"resetView\">Reset View</button>\n+        <button id=\"clearDebug\">Clear Debug Log</button>\n+        <span id=\"currentSource\">Current: Source A</span>\n+    </div>\n+\n+    <div id=\"map\" class=\"map-container\"></div>\n+\n+    <div class=\"debug\" id=\"debugLog\">Debug log will appear here...</div>\n+\n+    <div class=\"info\">\n+        <h3>Expected Behavior:</h3>\n+        <p>When changing source or projection, all cached tiles should be invalidated and new tiles should be loaded for all areas.</p>\n+        <h3>Actual Behavior (Bug):</h3>\n+        <p>Cached tiles from the previous source/projection are displayed when returning to previously visited areas.</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        // Import OpenLayers modules\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import XYZ from './src/ol/source/XYZ.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Debug logging function\n+        function debugLog(message) {\n+            const debugElement = document.getElementById('debugLog');\n+            const timestamp = new Date().toLocaleTimeString();\n+            debugElement.innerHTML += `[${timestamp}] ${message}<br>`;\n+            debugElement.scrollTop = debugElement.scrollHeight;\n+            console.log(message);\n+        }\n+\n+        // Create different tile sources for testing\n+        // Using different colored tile sources to make the issue more visible\n+        const sourceA = new XYZ({\n+            url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',\n+            attributions: '\u00a9 OpenStreetMap contributors'\n+        });\n+        \n+        const sourceB = new XYZ({\n+            url: 'https://{1-4}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png',\n+            attributions: '\u00a9 CARTO'\n+        });\n+\n+        const sourceC = new XYZ({\n+            url: 'https://stamen-tiles.a.ssl.fastly.net/terrain/{z}/{x}/{y}.jpg',\n+            attributions: '\u00a9 Stamen Design'\n+        });\n+\n+        // Create WebGL tile layer\n+        const tileLayer = new WebGLTileLayer({\n+            source: sourceA\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [tileLayer],\n+            view: new View({\n+                center: fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        let currentSourceIndex = 0;\n+        const sources = [\n+            { source: sourceA, name: 'Source A (OSM)' },\n+            { source: sourceB, name: 'Source B (CartoDB)' },\n+            { source: sourceC, name: 'Source C (Stamen)' }\n+        ];\n+\n+        debugLog('Map initialized with Source A');\n+\n+        // Change source button\n+        document.getElementById('changeSource').addEventListener('click', function() {\n+            currentSourceIndex = (currentSourceIndex + 1) % sources.length;\n+            const newSource = sources[currentSourceIndex];\n+            \n+            debugLog(`Changing source to: ${newSource.name}`);\n+            debugLog(`Source key: ${newSource.source.getKey()}`);\n+            \n+            tileLayer.setSource(newSource.source);\n+            \n+            document.getElementById('currentSource').textContent = 'Current: ' + newSource.name;\n+        });\n+\n+        // Change projection button\n+        document.getElementById('changeProjection').addEventListener('click', function() {\n+            const currentProjection = map.getView().getProjection().getCode();\n+            let newProjection, newCenter, newZoom;\n+            \n+            if (currentProjection === 'EPSG:3857') {\n+                // Switch to EPSG:4326\n+                newProjection = 'EPSG:4326';\n+                newCenter = [0, 0]; // Already in lon/lat\n+                newZoom = 2;\n+            } else {\n+                // Switch back to EPSG:3857\n+                newProjection = 'EPSG:3857';\n+                newCenter = fromLonLat([0, 0]);\n+                newZoom = 2;\n+            }\n+            \n+            debugLog(`Changing projection from ${currentProjection} to ${newProjection}`);\n+            \n+            map.setView(new View({\n+                projection: newProjection,\n+                center: newCenter,\n+                zoom: newZoom\n+            }));\n+        });\n+\n+        // Reset view button\n+        document.getElementById('resetView').addEventListener('click', function() {\n+            debugLog('Resetting view to center');\n+            map.getView().setCenter(fromLonLat([0, 0]));\n+            map.getView().setZoom(2);\n+        });\n+\n+        // Clear debug log\n+        document.getElementById('clearDebug').addEventListener('click', function() {\n+            document.getElementById('debugLog').innerHTML = '';\n+        });\n+\n+        // Log tile loading for debugging\n+        function setupTileLogging(source, sourceName) {\n+            source.on('tileloadstart', function(event) {\n+                const coord = event.tile.getTileCoord();\n+                debugLog(`${sourceName} - Tile load start: [${coord[0]}, ${coord[1]}, ${coord[2]}]`);\n+            });\n+\n+            source.on('tileloadend', function(event) {\n+                const coord = event.tile.getTileCoord();\n+                debugLog(`${sourceName} - Tile load end: [${coord[0]}, ${coord[1]}, ${coord[2]}]`);\n+            });\n+\n+            source.on('tileloaderror', function(event) {\n+                const coord = event.tile.getTileCoord();\n+                debugLog(`${sourceName} - Tile load error: [${coord[0]}, ${coord[1]}, ${coord[2]}]`);\n+            });\n+        }\n+\n+        // Setup logging for all sources\n+        sources.forEach((sourceInfo, index) => {\n+            setupTileLogging(sourceInfo.source, sourceInfo.name);\n+        });\n+\n+        // Log view changes\n+        map.getView().on('change:center', function() {\n+            const center = map.getView().getCenter();\n+            debugLog(`View center changed to: [${center[0].toFixed(2)}, ${center[1].toFixed(2)}]`);\n+        });\n+\n+        map.getView().on('change:resolution', function() {\n+            const zoom = map.getView().getZoom();\n+            debugLog(`View zoom changed to: ${zoom.toFixed(2)}`);\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_cache_issue.html b/test_webgl_cache_issue.html\nnew file mode 100644\nindex 000000000..12e26d7ca\n--- /dev/null\n+++ b/test_webgl_cache_issue.html\n@@ -0,0 +1,158 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Cache Issue Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map-container {\n+            width: 800px;\n+            height: 400px;\n+            border: 1px solid #ccc;\n+            margin: 10px 0;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+            font-size: 14px;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/ol.css\">\n+</head>\n+<body>\n+    <h1>WebGL Tile Cache Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Test Instructions:</h3>\n+        <ol>\n+            <li>Pan/zoom around to load some tiles</li>\n+            <li>Click \"Change Source\" to switch to a different tile source</li>\n+            <li>Pan/zoom to new areas (should show new tiles correctly)</li>\n+            <li>Pan back to previously cached areas</li>\n+            <li><strong>BUG:</strong> You should see old tiles from the previous source instead of new tiles</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"controls\">\n+        <button id=\"changeSource\">Change Source</button>\n+        <button id=\"changeProjection\">Change Projection</button>\n+        <button id=\"resetView\">Reset View</button>\n+        <span id=\"currentSource\">Current: OpenStreetMap</span>\n+    </div>\n+\n+    <div id=\"map\" class=\"map-container\"></div>\n+\n+    <div class=\"info\">\n+        <h3>Expected Behavior:</h3>\n+        <p>When changing source or projection, all cached tiles should be invalidated and new tiles should be loaded for all areas.</p>\n+        <h3>Actual Behavior (Bug):</h3>\n+        <p>Cached tiles from the previous source/projection are displayed when returning to previously visited areas.</p>\n+    </div>\n+\n+    <script>\n+        // Create different tile sources for testing\n+        const osmSource = new ol.source.OSM();\n+        \n+        const cartoSource = new ol.source.XYZ({\n+            url: 'https://{1-4}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png',\n+            attributions: '\u00a9 CARTO'\n+        });\n+\n+        const stamenSource = new ol.source.XYZ({\n+            url: 'https://stamen-tiles.a.ssl.fastly.net/terrain/{z}/{x}/{y}.jpg',\n+            attributions: '\u00a9 Stamen Design'\n+        });\n+\n+        // Create WebGL tile layer\n+        const tileLayer = new ol.layer.WebGLTile({\n+            source: osmSource\n+        });\n+\n+        // Create map\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [tileLayer],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        let currentSourceIndex = 0;\n+        const sources = [\n+            { source: osmSource, name: 'OpenStreetMap' },\n+            { source: cartoSource, name: 'CartoDB Light' },\n+            { source: stamenSource, name: 'Stamen Terrain' }\n+        ];\n+\n+        // Change source button\n+        document.getElementById('changeSource').addEventListener('click', function() {\n+            currentSourceIndex = (currentSourceIndex + 1) % sources.length;\n+            const newSource = sources[currentSourceIndex];\n+            \n+            console.log('Changing source to:', newSource.name);\n+            tileLayer.setSource(newSource.source);\n+            \n+            document.getElementById('currentSource').textContent = 'Current: ' + newSource.name;\n+        });\n+\n+        // Change projection button\n+        document.getElementById('changeProjection').addEventListener('click', function() {\n+            const currentProjection = map.getView().getProjection().getCode();\n+            let newProjection, newCenter, newZoom;\n+            \n+            if (currentProjection === 'EPSG:3857') {\n+                // Switch to EPSG:4326\n+                newProjection = 'EPSG:4326';\n+                newCenter = [0, 0]; // Already in lon/lat\n+                newZoom = 2;\n+            } else {\n+                // Switch back to EPSG:3857\n+                newProjection = 'EPSG:3857';\n+                newCenter = ol.proj.fromLonLat([0, 0]);\n+                newZoom = 2;\n+            }\n+            \n+            console.log('Changing projection to:', newProjection);\n+            \n+            map.setView(new ol.View({\n+                projection: newProjection,\n+                center: newCenter,\n+                zoom: newZoom\n+            }));\n+        });\n+\n+        // Reset view button\n+        document.getElementById('resetView').addEventListener('click', function() {\n+            map.getView().setCenter(ol.proj.fromLonLat([0, 0]));\n+            map.getView().setZoom(2);\n+        });\n+\n+        // Log tile loading for debugging\n+        tileLayer.getSource().on('tileloadstart', function(event) {\n+            console.log('Tile load start:', event.tile.getTileCoord());\n+        });\n+\n+        tileLayer.getSource().on('tileloadend', function(event) {\n+            console.log('Tile load end:', event.tile.getTileCoord());\n+        });\n+\n+        tileLayer.getSource().on('tileloaderror', function(event) {\n+            console.log('Tile load error:', event.tile.getTileCoord());\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

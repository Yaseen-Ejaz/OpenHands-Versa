{"instance_id": "bpmn-io__bpmn-js-1083", "model_patch": "diff --git a/lib/features/snapping/BpmnCreateMoveSnapping.js b/lib/features/snapping/BpmnCreateMoveSnapping.js\nindex 56252d4f..4bc49585 100644\n--- a/lib/features/snapping/BpmnCreateMoveSnapping.js\n+++ b/lib/features/snapping/BpmnCreateMoveSnapping.js\n@@ -13,6 +13,8 @@ import { asTRBL } from 'diagram-js/lib/layout/LayoutUtil';\n \n import { getBoundaryAttachment } from './BpmnSnappingUtil';\n \n+import { forEach } from 'min-dash';\n+\n var HIGH_PRIORITY = 1500;\n \n \n@@ -48,6 +50,32 @@ export default function BpmnCreateMoveSnapping(bpmnRules, eventBus, injector) {\n       snapBoundaryEvent(event, target);\n     }\n   });\n+  \n+  // snap connection docking points\n+  eventBus.on([\n+    'shape.move.start'\n+  ], HIGH_PRIORITY, function(event) {\n+    var context = event.context,\n+        shape = context.shape;\n+    \n+    // set snap origins for connection docking points\n+    setDockingSnapOrigins(event, shape);\n+  });\n+  \n+  eventBus.on([\n+    'shape.move.move',\n+    'shape.move.end'\n+  ], HIGH_PRIORITY, function(event) {\n+    var context = event.context,\n+        shape = context.shape;\n+        \n+    if (isSnapped(event)) {\n+      return;\n+    }\n+    \n+    // snap to docking points\n+    snapConnectionDocking(event, shape);\n+  });\n }\n \n inherits(BpmnCreateMoveSnapping, CreateMoveSnapping);\n@@ -134,4 +162,91 @@ function setSnappedIfConstrained(event) {\n   if ((top && top >= event.y) || (bottom && bottom <= event.y)) {\n     setSnapped(event, 'y', event.y);\n   }\n+}\n+\n+function setDockingSnapOrigins(event, shape) {\n+  var snapContext = event.context.snapContext;\n+  \n+  if (!snapContext) {\n+    return;\n+  }\n+  \n+  // add connection docking points as snap origins\n+  if (shape.incoming && shape.incoming.length) {\n+    forEach(shape.incoming, function(c) {\n+      var docking = c.waypoints[c.waypoints.length - 1];\n+      \n+      docking = docking.original || docking;\n+      \n+      snapContext.setSnapOrigin(c.id + '-docking', {\n+        x: docking.x - event.x,\n+        y: docking.y - event.y\n+      });\n+    });\n+  }\n+  \n+  if (shape.outgoing && shape.outgoing.length) {\n+    forEach(shape.outgoing, function(c) {\n+      var docking = c.waypoints[0];\n+      \n+      docking = docking.original || docking;\n+      \n+      snapContext.setSnapOrigin(c.id + '-docking', {\n+        x: docking.x - event.x,\n+        y: docking.y - event.y\n+      });\n+    });\n+  }\n+}\n+\n+function snapConnectionDocking(event, shape) {\n+  var context = event.context,\n+      snapContext = context.snapContext;\n+  \n+  if (!shape.incoming && !shape.outgoing) {\n+    return;\n+  }\n+  \n+  // snap to incoming and outgoing connection docking points\n+  forEach(shape.incoming, function(c) {\n+    var docking = c.waypoints[c.waypoints.length - 1];\n+    \n+    docking = docking.original || docking;\n+    \n+    var origin = snapContext.getSnapOrigin(c.id + '-docking');\n+    \n+    if (!origin) {\n+      return;\n+    }\n+    \n+    var point = {\n+      x: event.x + origin.x,\n+      y: event.y + origin.y\n+    };\n+    \n+    // snap to docking point\n+    setSnapped(event, 'x', point.x);\n+    setSnapped(event, 'y', point.y);\n+  });\n+  \n+  forEach(shape.outgoing, function(c) {\n+    var docking = c.waypoints[0];\n+    \n+    docking = docking.original || docking;\n+    \n+    var origin = snapContext.getSnapOrigin(c.id + '-docking');\n+    \n+    if (!origin) {\n+      return;\n+    }\n+    \n+    var point = {\n+      x: event.x + origin.x,\n+      y: event.y + origin.y\n+    };\n+    \n+    // snap to docking point\n+    setSnapped(event, 'x', point.x);\n+    setSnapped(event, 'y', point.y);\n+  });\n }\n\\ No newline at end of file\ndiff --git a/test/spec/features/snapping/DockingSnappingSpec.js b/test/spec/features/snapping/DockingSnappingSpec.js\nnew file mode 100644\nindex 00000000..0a6105e4\n--- /dev/null\n+++ b/test/spec/features/snapping/DockingSnappingSpec.js\n@@ -0,0 +1,54 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import TestContainer from 'mocha-test-container-support';\n+\n+import coreModule from 'lib/core';\n+import createModule from 'diagram-js/lib/features/create';\n+import modelingModule from 'lib/features/modeling';\n+import moveModule from 'diagram-js/lib/features/move';\n+import rulesModule from 'lib/features/rules';\n+import snappingModule from 'lib/features/snapping';\n+\n+import {\n+  isSnapped\n+} from 'diagram-js/lib/features/snapping/SnapUtil';\n+\n+import { createCanvasEvent as canvasEvent } from 'test/util/MockEvents';\n+\n+describe('features/snapping - DockingSnapping', function() {\n+\n+  var diagramXML = require('./DockingSnappingTest.bpmn');\n+\n+  var testModules = [\n+    coreModule,\n+    createModule,\n+    modelingModule,\n+    moveModule,\n+    rulesModule,\n+    snappingModule\n+  ];\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should snap to connection when moving connected event', inject(function(elementRegistry, move, dragging) {\n+    // given\n+    var event = elementRegistry.get('IntermediateThrowEvent_1');\n+    var connection = elementRegistry.get('SequenceFlow_1');\n+    \n+    // when\n+    move.start(canvasEvent({ x: 318, y: 140 }), event);\n+    \n+    dragging.move(canvasEvent({ x: 400, y: 200 }));\n+    \n+    // then\n+    // expect event to be snapped to the connection\n+    expect(isSnapped(dragging.context().data.context)).to.be.true;\n+    \n+    dragging.end();\n+  }));\n+});\n\\ No newline at end of file\ndiff --git a/test/spec/features/snapping/DockingSnappingTest.bpmn b/test/spec/features/snapping/DockingSnappingTest.bpmn\nnew file mode 100644\nindex 00000000..fb5829f7\n--- /dev/null\n+++ b/test/spec/features/snapping/DockingSnappingTest.bpmn\n@@ -0,0 +1,26 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Task\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:intermediateThrowEvent id=\"IntermediateThrowEvent_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:intermediateThrowEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"IntermediateThrowEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"IntermediateThrowEvent_1_di\" bpmnElement=\"IntermediateThrowEvent_1\">\n+        <dc:Bounds x=\"300\" y=\"122\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"200\" y=\"140\" />\n+        <di:waypoint x=\"300\" y=\"140\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file", "model_name_or_path": "llm.claude_3_7"}

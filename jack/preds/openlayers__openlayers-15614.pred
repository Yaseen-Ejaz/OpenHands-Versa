0 -\n+127.0.0.1 - - [03/Mar/2026 12:30:18] \"GET /src/ol/source/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:30:18] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:30:18] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Mar/2026 12:30:18] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 200 -\ndiff --git a/test_declutter_opacity.html b/test_declutter_opacity.html\nnew file mode 100644\nindex 000000000..6de1726d8\n--- /dev/null\n+++ b/test_declutter_opacity.html\n@@ -0,0 +1,117 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Declutter Opacity Issue</title>\n+    <style>\n+        html, body, #map {\n+            margin: 0;\n+            padding: 0;\n+            width: 100%;\n+            height: 100%;\n+        }\n+        #controls {\n+            position: absolute;\n+            top: 10px;\n+            left: 10px;\n+            z-index: 1000;\n+            background: white;\n+            padding: 10px;\n+            border-radius: 5px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"controls\">\n+        <button id=\"setOpacity\">Set Opacity to 0.5</button>\n+        <button id=\"resetOpacity\">Reset Opacity to 1.0</button>\n+        <div>Current opacity: <span id=\"opacityValue\">1.0</span></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {Style, Text, Fill, Stroke, Circle} from './src/ol/style.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        // Create features with labels\n+        const features = [];\n+        for (let i = 0; i < 20; i++) {\n+            const feature = new Feature({\n+                geometry: new Point([\n+                    -11000000 + Math.random() * 22000000,\n+                    -6000000 + Math.random() * 12000000\n+                ]),\n+                name: `Label ${i}`\n+            });\n+            features.push(feature);\n+        }\n+\n+        // Create vector source and layer with declutter enabled\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            declutter: true, // This is the key setting that causes the issue\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 5,\n+                    fill: new Fill({color: 'red'}),\n+                    stroke: new Stroke({color: 'white', width: 2})\n+                }),\n+                text: new Text({\n+                    font: '12px Calibri,sans-serif',\n+                    fill: new Fill({color: '#000'}),\n+                    stroke: new Stroke({color: '#fff', width: 3}),\n+                    offsetY: -15,\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    }\n+                })\n+            })\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Add event handlers\n+        document.getElementById('setOpacity').addEventListener('click', function() {\n+            vectorLayer.setOpacity(0.5);\n+            document.getElementById('opacityValue').textContent = '0.5';\n+            console.log('Opacity set to 0.5');\n+        });\n+\n+        document.getElementById('resetOpacity').addEventListener('click', function() {\n+            vectorLayer.setOpacity(1.0);\n+            document.getElementById('opacityValue').textContent = '1.0';\n+            console.log('Opacity reset to 1.0');\n+        });\n+\n+        // Auto-test after 2 seconds\n+        setTimeout(() => {\n+            console.log('Auto-setting opacity to 0.5 after 2 seconds');\n+            vectorLayer.setOpacity(0.5);\n+            document.getElementById('opacityValue').textContent = '0.5';\n+        }, 2000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

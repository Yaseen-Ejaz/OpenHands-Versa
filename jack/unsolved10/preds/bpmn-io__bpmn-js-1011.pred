{"instance_id": "bpmn-io__bpmn-js-1011", "model_patch": "diff --git a/lib/features/ordering/BpmnOrderingProvider.js b/lib/features/ordering/BpmnOrderingProvider.js\nindex 58d1f4a5..8c21893b 100644\n--- a/lib/features/ordering/BpmnOrderingProvider.js\n+++ b/lib/features/ordering/BpmnOrderingProvider.js\n@@ -62,6 +62,7 @@ export default function BpmnOrderingProvider(eventBus, canvas, translate) {\n         ]\n       }\n     },\n+    { type: 'bpmn:Group', order: { level: 9.5 } },\n     { type: 'bpmn:BoundaryEvent', order: { level: 8 } },\n     { type: 'bpmn:FlowElement', order: { level: 5 } },\n     { type: 'bpmn:Participant', order: { level: -2 } },\ndiff --git a/test-group-ordering.html b/test-group-ordering.html\nnew file mode 100644\nindex 00000000..2641b76e\n--- /dev/null\n+++ b/test-group-ordering.html\n@@ -0,0 +1,84 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Group Ordering Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; }\n+    .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN Group Ordering Test</h1>\n+  <div class=\"info\">\n+    <strong>Test:</strong> Groups should render on top of all other elements (except labels).\n+    <br><strong>Expected:</strong> The dashed group border should be visible on top of the task element.\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<definitions xmlns=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+             xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+             xmlns:omgdc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+             xmlns:omgdi=\"http://www.omg.org/spec/DD/20100524/DI\" \n+             id=\"GroupOrderingTest\" \n+             targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  \n+  <category id=\"Category_1\">\n+    <categoryValue id=\"CategoryValue_1\" value=\"Test Group\"/>\n+  </category>\n+\n+  <process id=\"Process_1\" isExecutable=\"false\">\n+    <startEvent id=\"StartEvent\" name=\"Start\"/>\n+    <task id=\"Task\" name=\"Task\"/>\n+    <endEvent id=\"EndEvent\" name=\"End\"/>\n+    <sequenceFlow id=\"SequenceFlow\" sourceRef=\"StartEvent\" targetRef=\"Task\"/>\n+    <group id=\"Group\" categoryValueRef=\"CategoryValue_1\"/>\n+  </process>\n+\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      \n+      <bpmndi:BPMNShape id=\"StartEvent_di\" bpmnElement=\"StartEvent\">\n+        <omgdc:Bounds x=\"152\" y=\"102\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNShape id=\"Task_di\" bpmnElement=\"Task\">\n+        <omgdc:Bounds x=\"250\" y=\"80\" width=\"100\" height=\"80\"/>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNShape id=\"EndEvent_di\" bpmnElement=\"EndEvent\">\n+        <omgdc:Bounds x=\"400\" y=\"102\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNEdge id=\"SequenceFlow_di\" bpmnElement=\"SequenceFlow\">\n+        <omgdi:waypoint x=\"188\" y=\"120\"/>\n+        <omgdi:waypoint x=\"250\" y=\"120\"/>\n+      </bpmndi:BPMNEdge>\n+      \n+      <bpmndi:BPMNShape id=\"Group_di\" bpmnElement=\"Group\">\n+        <omgdc:Bounds x=\"200\" y=\"50\" width=\"200\" height=\"150\"/>\n+      </bpmndi:BPMNShape>\n+      \n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</definitions>`;\n+\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    modeler.importXML(xml, function(err) {\n+      if (err) {\n+        console.error('Error importing XML:', err);\n+      } else {\n+        console.log('BPMN diagram loaded successfully');\n+        console.log('The group (dashed border) should be visible on top of the task element');\n+      }\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/ordering/GroupOrderingSpec.js b/test/spec/features/ordering/GroupOrderingSpec.js\nnew file mode 100644\nindex 00000000..21196155\n--- /dev/null\n+++ b/test/spec/features/ordering/GroupOrderingSpec.js\n@@ -0,0 +1,82 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  move,\n+  add,\n+  expectZOrder\n+} from './Helper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('features/modeling - group ordering', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule\n+  ];\n+\n+  describe('groups should render on top', function() {\n+\n+    var diagramXML = require('./group-ordering.bpmn');\n+\n+    beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+    it('should render group on top of task when task is moved to group border', inject(function() {\n+\n+      // when\n+      move('Task', { x: 50, y: 0 });\n+\n+      // then\n+      expectZOrder('Task', 'Group');\n+    }));\n+\n+    it('should render group on top when new task is added on group border', inject(function() {\n+\n+      // when\n+      var newTask = add({ type: 'bpmn:Task' }, { x: 400, y: 250 });\n+\n+      // then\n+      expectZOrder(newTask.id, 'Group');\n+    }));\n+\n+    it('should render group on top of multiple elements', inject(function() {\n+\n+      // when\n+      move(['Task', 'StartEvent'], { x: 50, y: 0 });\n+\n+      // then\n+      expectZOrder('Task', 'StartEvent', 'Group');\n+    }));\n+\n+    it('should render group on top of sequence flows', inject(function() {\n+\n+      // when\n+      move('SequenceFlow', { x: 0, y: 0 });\n+\n+      // then\n+      expectZOrder('SequenceFlow', 'Group');\n+    }));\n+\n+    it('should render labels on top of groups', inject(function(elementRegistry) {\n+\n+      // when\n+      move('Task', { x: 50, y: 0 });\n+\n+      // then\n+      // Labels should be on top of everything, including groups\n+      var taskLabel = elementRegistry.get('Task_label');\n+      if (taskLabel) {\n+        expectZOrder('Task', 'Group', 'Task_label');\n+      } else {\n+        // If no label exists, just verify group is on top of task\n+        expectZOrder('Task', 'Group');\n+      }\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test/spec/features/ordering/group-ordering.bpmn b/test/spec/features/ordering/group-ordering.bpmn\nnew file mode 100644\nindex 00000000..30a1a48a\n--- /dev/null\n+++ b/test/spec/features/ordering/group-ordering.bpmn\n@@ -0,0 +1,50 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<definitions xmlns=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+             xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+             xmlns:omgdc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+             xmlns:omgdi=\"http://www.omg.org/spec/DD/20100524/DI\" \n+             id=\"GroupOrderingTest\" \n+             targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  \n+  <category id=\"Category_1\">\n+    <categoryValue id=\"CategoryValue_1\" value=\"Test Group\"/>\n+  </category>\n+\n+  <process id=\"Process_1\" isExecutable=\"false\">\n+    <startEvent id=\"StartEvent\" name=\"Start\"/>\n+    <task id=\"Task\" name=\"Task\"/>\n+    <endEvent id=\"EndEvent\" name=\"End\"/>\n+    <sequenceFlow id=\"SequenceFlow\" sourceRef=\"StartEvent\" targetRef=\"Task\"/>\n+    <group id=\"Group\" categoryValueRef=\"CategoryValue_1\"/>\n+  </process>\n+\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      \n+      <bpmndi:BPMNShape id=\"StartEvent_di\" bpmnElement=\"StartEvent\">\n+        <omgdc:Bounds x=\"152\" y=\"102\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNShape id=\"Task_di\" bpmnElement=\"Task\">\n+        <omgdc:Bounds x=\"250\" y=\"80\" width=\"100\" height=\"80\"/>\n+        <bpmndi:BPMNLabel id=\"Task_label\">\n+          <omgdc:Bounds x=\"290\" y=\"170\" width=\"20\" height=\"14\"/>\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNShape id=\"EndEvent_di\" bpmnElement=\"EndEvent\">\n+        <omgdc:Bounds x=\"400\" y=\"102\" width=\"36\" height=\"36\"/>\n+      </bpmndi:BPMNShape>\n+      \n+      <bpmndi:BPMNEdge id=\"SequenceFlow_di\" bpmnElement=\"SequenceFlow\">\n+        <omgdi:waypoint x=\"188\" y=\"120\"/>\n+        <omgdi:waypoint x=\"250\" y=\"120\"/>\n+      </bpmndi:BPMNEdge>\n+      \n+      <bpmndi:BPMNShape id=\"Group_di\" bpmnElement=\"Group\">\n+        <omgdc:Bounds x=\"200\" y=\"50\" width=\"200\" height=\"150\"/>\n+      </bpmndi:BPMNShape>\n+      \n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</definitions>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

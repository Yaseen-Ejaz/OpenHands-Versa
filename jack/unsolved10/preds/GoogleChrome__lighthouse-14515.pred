{"instance_id": "GoogleChrome__lighthouse-14515", "model_patch": "diff --git a/report/renderer/report-renderer.js b/report/renderer/report-renderer.js\nindex b50d0ed04..34f42d41e 100644\n--- a/report/renderer/report-renderer.js\n+++ b/report/renderer/report-renderer.js\n@@ -129,6 +129,13 @@ export class ReportRenderer {\n     const benchmarkIndex = report.environment.benchmarkIndex.toFixed(0);\n     const axeVersion = report.environment.credits?.['axe-core'];\n \n+    // Build screen emulation info for tooltip\n+    let screenEmulationInfo = '';\n+    const screenEmulation = report.configSettings.screenEmulation;\n+    if (screenEmulation && !screenEmulation.disabled) {\n+      screenEmulationInfo = `\\nScreen: ${screenEmulation.width} \u00d7 ${screenEmulation.height}, DPR ${screenEmulation.deviceScaleFactor}`;\n+    }\n+\n     // [CSS icon class, textContent, tooltipText]\n     const metaItems = [\n       ['date',\n@@ -137,6 +144,7 @@ export class ReportRenderer {\n         `${envValues.deviceEmulation} with Lighthouse ${report.lighthouseVersion}`,\n         `${Util.i18n.strings.runtimeSettingsBenchmark}: ${benchmarkIndex}` +\n             `\\n${Util.i18n.strings.runtimeSettingsCPUThrottling}: ${envValues.cpuThrottling}` +\n+            screenEmulationInfo +\n             (axeVersion ? `\\n${Util.i18n.strings.runtimeSettingsAxeVersion}: ${axeVersion}` : '')],\n       ['samples-one',\n         Util.i18n.strings.runtimeSingleLoad,\ndiff --git a/verify_implementation.js b/verify_implementation.js\nnew file mode 100644\nindex 000000000..31e071c97\n--- /dev/null\n+++ b/verify_implementation.js\n@@ -0,0 +1,93 @@\n+/**\n+ * Simple verification script to test screen dimensions implementation\n+ */\n+\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Use require instead of import for Node.js compatibility\n+const jsdom = require('jsdom');\n+\n+// Read the sample results\n+const sampleResultsPath = path.join(__dirname, 'core', 'test', 'results', 'sample_v2.json');\n+const sampleResults = JSON.parse(fs.readFileSync(sampleResultsPath, 'utf8'));\n+\n+// Mock the DOM and other dependencies\n+const { JSDOM } = jsdom;\n+const { window } = new JSDOM();\n+global.self = window;\n+\n+// Mock matchMedia\n+global.matchMedia = function() {\n+  return {\n+    addListener: function() {},\n+  };\n+};\n+\n+// Import the modules (using dynamic import for ES modules)\n+async function runTest() {\n+  try {\n+    const { DOM } = await import('./report/renderer/dom.js');\n+    const { ReportRenderer } = await import('./report/renderer/report-renderer.js');\n+    const { Util } = await import('./report/renderer/util.js');\n+\n+    console.log('=== Testing Screen Dimensions Implementation ===\\n');\n+\n+    // Create DOM and renderer\n+    const dom = new DOM(window.document);\n+    const renderer = new ReportRenderer(dom);\n+\n+    // Prepare the report\n+    const report = Util.prepareReportResult(sampleResults);\n+\n+    console.log('Screen emulation data from sample:');\n+    console.log('Width:', report.configSettings.screenEmulation.width);\n+    console.log('Height:', report.configSettings.screenEmulation.height);\n+    console.log('DeviceScaleFactor:', report.configSettings.screenEmulation.deviceScaleFactor);\n+    console.log('Mobile:', report.configSettings.screenEmulation.mobile);\n+    console.log('Disabled:', report.configSettings.screenEmulation.disabled);\n+\n+    // Render the report\n+    const container = window.document.body;\n+    const output = renderer.renderReport(report, container);\n+\n+    // Find the devices tooltip\n+    const devicesItem = output.querySelector('.lh-report-icon--devices');\n+    const tooltip = devicesItem ? devicesItem.querySelector('.lh-tooltip') : null;\n+\n+    if (tooltip) {\n+      console.log('\\n=== Devices Tooltip Content ===');\n+      console.log(tooltip.textContent);\n+\n+      // Check if our implementation is working\n+      const hasScreenDimensions = tooltip.textContent.includes('360') && tooltip.textContent.includes('640');\n+      const hasDeviceScaleFactor = tooltip.textContent.includes('2.625');\n+      const hasScreenLabel = tooltip.textContent.includes('Screen:');\n+      const hasDPRLabel = tooltip.textContent.includes('DPR');\n+\n+      console.log('\\n=== Verification Results ===');\n+      console.log('\u2713 Contains screen dimensions (360x640):', hasScreenDimensions);\n+      console.log('\u2713 Contains deviceScaleFactor (2.625):', hasDeviceScaleFactor);\n+      console.log('\u2713 Contains \"Screen:\" label:', hasScreenLabel);\n+      console.log('\u2713 Contains \"DPR\" label:', hasDPRLabel);\n+\n+      const allChecksPass = hasScreenDimensions && hasDeviceScaleFactor && hasScreenLabel && hasDPRLabel;\n+      console.log('\\n\ud83c\udf89 IMPLEMENTATION SUCCESS:', allChecksPass);\n+\n+      if (allChecksPass) {\n+        console.log('\\n\u2705 Screen dimensions and deviceScaleFactor are now included in the devices tooltip!');\n+        console.log('The tooltip shows: Screen: 360 \u00d7 640, DPR 2.625');\n+      } else {\n+        console.log('\\n\u274c Implementation needs review');\n+      }\n+\n+    } else {\n+      console.log('\u274c ERROR: Could not find devices tooltip');\n+    }\n+\n+  } catch (error) {\n+    console.error('Error running test:', error);\n+  }\n+}\n+\n+runTest();\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

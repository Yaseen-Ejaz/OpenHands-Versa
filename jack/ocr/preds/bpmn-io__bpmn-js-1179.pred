{"instance_id": "bpmn-io__bpmn-js-1179", "model_patch": "diff --git a/lib/features/modeling/behavior/DropOnFlowBehavior.js b/lib/features/modeling/behavior/DropOnFlowBehavior.js\nindex 4d1c35ba..d104a7a2 100644\n--- a/lib/features/modeling/behavior/DropOnFlowBehavior.js\n+++ b/lib/features/modeling/behavior/DropOnFlowBehavior.js\n@@ -64,7 +64,7 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n     if (bpmnRules.canConnect(source, shape, targetFlow)) {\n \n       // reconnect source -> inserted shape\n-      modeling.reconnectEnd(targetFlow, shape, waypointsBefore || position);\n+      modeling.reconnectEnd(targetFlow, shape, waypointsBefore);\n \n       incomingConnection = targetFlow;\n     }\n@@ -74,7 +74,7 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n       if (!incomingConnection) {\n \n         // reconnect inserted shape -> end\n-        modeling.reconnectStart(targetFlow, shape, waypointsAfter || position);\n+        modeling.reconnectStart(targetFlow, shape, waypointsAfter);\n \n         outgoingConnection = targetFlow;\n       } else {\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..cdc28aad\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,5 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Jun/2026 05:01:03] \"GET /test_drop_issue.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Jun/2026 05:01:03] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Jun/2026 05:02:50] \"GET /test_drop_issue.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Jun/2026 05:02:50] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test_drop_issue.html b/test_drop_issue.html\nnew file mode 100644\nindex 00000000..4bdc6443\n--- /dev/null\n+++ b/test_drop_issue.html\n@@ -0,0 +1,115 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Drop on Flow Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #canvas {\n+            border: 1px solid #ccc;\n+            height: 600px;\n+            width: 100%;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Drop on Flow Issue Test</h1>\n+    <div class=\"controls\">\n+        <button onclick=\"createTask()\">Create Task and Drop on Flow</button>\n+        <button onclick=\"resetDiagram()\">Reset Diagram</button>\n+    </div>\n+    <div id=\"canvas\"></div>\n+\n+    <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        var modeler = new BpmnJS({\n+            container: '#canvas'\n+        });\n+\n+        var simpleDiagram = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"173\" y=\"102\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"400\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"209\" y=\"120\" />\n+        <di:waypoint x=\"400\" y=\"120\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        function loadDiagram() {\n+            modeler.importXML(simpleDiagram, function(err) {\n+                if (err) {\n+                    console.error('Error loading diagram:', err);\n+                } else {\n+                    console.log('Diagram loaded successfully');\n+                }\n+            });\n+        }\n+\n+        function createTask() {\n+            var elementFactory = modeler.get('elementFactory');\n+            var modeling = modeler.get('modeling');\n+            var elementRegistry = modeler.get('elementRegistry');\n+\n+            // Get the sequence flow\n+            var sequenceFlow = elementRegistry.get('SequenceFlow_1');\n+            \n+            // Create a new task\n+            var newTask = elementFactory.createShape({\n+                type: 'bpmn:Task'\n+            });\n+\n+            // Drop position on the sequence flow\n+            var dropPosition = { x: 300, y: 120 };\n+\n+            console.log('Before drop - SequenceFlow waypoints:', sequenceFlow.waypoints);\n+\n+            // Create the shape on the sequence flow\n+            var createdShape = modeling.createShape(newTask, dropPosition, sequenceFlow);\n+\n+            console.log('After drop - Created shape:', createdShape);\n+            console.log('After drop - SequenceFlow waypoints:', sequenceFlow.waypoints);\n+            \n+            // Check the incoming connection docking\n+            if (createdShape.incoming && createdShape.incoming.length > 0) {\n+                var incomingConnection = createdShape.incoming[0];\n+                console.log('Incoming connection waypoints:', incomingConnection.waypoints);\n+                console.log('Incoming connection end docking:', incomingConnection.waypoints[incomingConnection.waypoints.length - 1]);\n+            }\n+        }\n+\n+        function resetDiagram() {\n+            loadDiagram();\n+        }\n+\n+        // Load the diagram when page loads\n+        loadDiagram();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
{"instance_id": "bpmn-io__bpmn-js-1679", "model_patch": "diff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js\nindex aa30567d..ddbfdd1c 100644\n--- a/lib/features/popup-menu/ReplaceMenuProvider.js\n+++ b/lib/features/popup-menu/ReplaceMenuProvider.js\n@@ -434,9 +434,25 @@ ReplaceMenuProvider.prototype._getLoopEntries = function(element) {\n     } else {\n       if (isUndefined(entry.options.isSequential) || !loopCharacteristics) {\n         loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics);\n+      } else {\n+        // For multi-instance types, preserve existing properties but ensure clean isSequential handling\n+        var existingProps = {};\n+        \n+        // Copy all existing properties except isSequential\n+        Object.keys(loopCharacteristics).forEach(function(key) {\n+          if (key !== 'isSequential' && key !== '$type' && key !== '$parent') {\n+            existingProps[key] = loopCharacteristics[key];\n+          }\n+        });\n+        \n+        // Create new object with existing properties\n+        loopCharacteristics = self._moddle.create(entry.options.loopCharacteristics, existingProps);\n       }\n \n-      loopCharacteristics.isSequential = entry.options.isSequential;\n+      // Set isSequential only if it's defined in the options\n+      if (!isUndefined(entry.options.isSequential)) {\n+        loopCharacteristics.isSequential = entry.options.isSequential;\n+      }\n     }\n     self._modeling.updateProperties(element, { loopCharacteristics: loopCharacteristics });\n   }\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..42cc994e\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,5 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [03/Jun/2026 17:25:36] \"GET /test-multi-instance.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 17:25:36] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 17:27:54] \"GET /test-multi-instance.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 17:27:54] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 304 -\ndiff --git a/test-multi-instance-fix.js b/test-multi-instance-fix.js\nnew file mode 100644\nindex 00000000..d1d5588d\n--- /dev/null\n+++ b/test-multi-instance-fix.js\n@@ -0,0 +1,127 @@\n+/**\n+ * Test to reproduce the multi-instance loop characteristics XML serialization issue\n+ */\n+\n+import BpmnModeler from './lib/Modeler';\n+\n+// Create a simple BPMN diagram with a task\n+const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/schema/bpmn/20100524/BPMN20\" xmlns:bpmndi=\"http://www.omg.org/schema/bpmn/20100524/DI\" xmlns:dc=\"http://www.omg.org/schema/bpmn/20100524/DC\" xmlns:di=\"http://www.omg.org/schema/bpmn/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function testMultiInstanceIssue() {\n+  console.log('Testing multi-instance loop characteristics issue...');\n+  \n+  // Create modeler instance\n+  const modeler = new BpmnModeler({\n+    container: document.createElement('div')\n+  });\n+\n+  try {\n+    // Import the diagram\n+    await modeler.importXML(xml);\n+    \n+    const elementRegistry = modeler.get('elementRegistry');\n+    const modeling = modeler.get('modeling');\n+    const moddle = modeler.get('moddle');\n+    \n+    // Get the task element\n+    const task = elementRegistry.get('Task_1');\n+    console.log('Task found:', task);\n+    \n+    // Test 1: Add parallel multi-instance\n+    console.log('\\n=== Test 1: Adding parallel multi-instance ===');\n+    const parallelLoopCharacteristics = moddle.create('bpmn:MultiInstanceLoopCharacteristics', {\n+      isSequential: false\n+    });\n+    \n+    modeling.updateProperties(task, { \n+      loopCharacteristics: parallelLoopCharacteristics \n+    });\n+    \n+    // Export XML and check\n+    const result1 = await modeler.saveXML({ format: true });\n+    console.log('XML after adding parallel multi-instance:');\n+    console.log(result1.xml);\n+    \n+    // Check if isSequential=\"false\" is present (it should be for parallel)\n+    const hasParallelAttribute = result1.xml.includes('isSequential=\"false\"');\n+    console.log('Has isSequential=\"false\" attribute:', hasParallelAttribute);\n+    \n+    // Test 2: Switch to sequential multi-instance\n+    console.log('\\n=== Test 2: Switching to sequential multi-instance ===');\n+    const sequentialLoopCharacteristics = moddle.create('bpmn:MultiInstanceLoopCharacteristics', {\n+      isSequential: true\n+    });\n+    \n+    modeling.updateProperties(task, { \n+      loopCharacteristics: sequentialLoopCharacteristics \n+    });\n+    \n+    // Export XML and check\n+    const result2 = await modeler.saveXML({ format: true });\n+    console.log('XML after switching to sequential multi-instance:');\n+    console.log(result2.xml);\n+    \n+    // Check if isSequential=\"true\" is present\n+    const hasSequentialAttribute = result2.xml.includes('isSequential=\"true\"');\n+    console.log('Has isSequential=\"true\" attribute:', hasSequentialAttribute);\n+    \n+    // Test 3: Switch back to parallel multi-instance\n+    console.log('\\n=== Test 3: Switching back to parallel multi-instance ===');\n+    const parallelLoopCharacteristics2 = moddle.create('bpmn:MultiInstanceLoopCharacteristics', {\n+      isSequential: false\n+    });\n+    \n+    modeling.updateProperties(task, { \n+      loopCharacteristics: parallelLoopCharacteristics2 \n+    });\n+    \n+    // Export XML and check\n+    const result3 = await modeler.saveXML({ format: true });\n+    console.log('XML after switching back to parallel multi-instance:');\n+    console.log(result3.xml);\n+    \n+    // Check if isSequential=\"false\" is present or if it's omitted (both are valid for parallel)\n+    const hasParallelAttribute2 = result3.xml.includes('isSequential=\"false\"') || \n+                                  (!result3.xml.includes('isSequential=\"true\"') && \n+                                   result3.xml.includes('multiInstanceLoopCharacteristics'));\n+    console.log('Has correct parallel representation:', hasParallelAttribute2);\n+    \n+    // Summary\n+    console.log('\\n=== Test Summary ===');\n+    console.log('Expected behavior:');\n+    console.log('- Parallel: <bpmn:multiInstanceLoopCharacteristics /> or isSequential=\"false\"');\n+    console.log('- Sequential: <bpmn:multiInstanceLoopCharacteristics isSequential=\"true\" />');\n+    \n+    return {\n+      parallelTest: hasParallelAttribute,\n+      sequentialTest: hasSequentialAttribute,\n+      parallelTest2: hasParallelAttribute2,\n+      xml1: result1.xml,\n+      xml2: result2.xml,\n+      xml3: result3.xml\n+    };\n+    \n+  } catch (error) {\n+    console.error('Error during test:', error);\n+    throw error;\n+  }\n+}\n+\n+// Export for use in browser or Node.js\n+if (typeof module !== 'undefined' && module.exports) {\n+  module.exports = testMultiInstanceIssue;\n+} else if (typeof window !== 'undefined') {\n+  window.testMultiInstanceIssue = testMultiInstanceIssue;\n+}\n\\ No newline at end of file\ndiff --git a/test-multi-instance.html b/test-multi-instance.html\nnew file mode 100644\nindex 00000000..f82fa61a\n--- /dev/null\n+++ b/test-multi-instance.html\n@@ -0,0 +1,182 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Multi-Instance Loop Characteristics Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .container { max-width: 1200px; margin: 0 auto; }\n+        .test-section { margin: 20px 0; padding: 15px; border: 1px solid #ccc; }\n+        .xml-output { background: #f5f5f5; padding: 10px; font-family: monospace; white-space: pre-wrap; max-height: 300px; overflow-y: auto; }\n+        .button { padding: 10px 15px; margin: 5px; background: #007cba; color: white; border: none; cursor: pointer; }\n+        .button:hover { background: #005a87; }\n+        .result { margin: 10px 0; padding: 10px; }\n+        .success { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; }\n+        .error { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; }\n+        #canvas { border: 1px solid #ccc; height: 400px; }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"container\">\n+        <h1>Multi-Instance Loop Characteristics Test</h1>\n+        <p>This test reproduces the issue where multi-instance loop characteristics don't update XML properly when toggling between parallel and sequential modes.</p>\n+        \n+        <div class=\"test-section\">\n+            <h2>BPMN Canvas</h2>\n+            <div id=\"canvas\"></div>\n+        </div>\n+        \n+        <div class=\"test-section\">\n+            <h2>Test Controls</h2>\n+            <button class=\"button\" onclick=\"addParallelMultiInstance()\">Add Parallel Multi-Instance</button>\n+            <button class=\"button\" onclick=\"addSequentialMultiInstance()\">Add Sequential Multi-Instance</button>\n+            <button class=\"button\" onclick=\"removeMultiInstance()\">Remove Multi-Instance</button>\n+            <button class=\"button\" onclick=\"exportXML()\">Export XML</button>\n+        </div>\n+        \n+        <div class=\"test-section\">\n+            <h2>Test Results</h2>\n+            <div id=\"results\"></div>\n+        </div>\n+        \n+        <div class=\"test-section\">\n+            <h2>Current XML</h2>\n+            <div id=\"xml-output\" class=\"xml-output\">XML will appear here...</div>\n+        </div>\n+    </div>\n+\n+    <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        let modeler;\n+        let task;\n+        \n+        // Initialize BPMN modeler\n+        async function init() {\n+            const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"bpmn-js\" exporterVersion=\"9.1.0\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn2:task id=\"Task_1\" name=\"Test Task\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+            modeler = new BpmnJS({\n+                container: '#canvas'\n+            });\n+\n+            try {\n+                await modeler.importXML(xml);\n+                \n+                const elementRegistry = modeler.get('elementRegistry');\n+                task = elementRegistry.get('Task_1');\n+                \n+                addResult('Modeler initialized successfully', 'success');\n+                exportXML();\n+            } catch (error) {\n+                addResult('Error initializing modeler: ' + error.message, 'error');\n+            }\n+        }\n+        \n+        function addResult(message, type) {\n+            const results = document.getElementById('results');\n+            const div = document.createElement('div');\n+            div.className = 'result ' + type;\n+            div.textContent = new Date().toLocaleTimeString() + ': ' + message;\n+            results.appendChild(div);\n+        }\n+        \n+        function addParallelMultiInstance() {\n+            try {\n+                const modeling = modeler.get('modeling');\n+                const moddle = modeler.get('moddle');\n+                \n+                const loopCharacteristics = moddle.create('bpmn2:MultiInstanceLoopCharacteristics', {\n+                    isSequential: false\n+                });\n+                \n+                modeling.updateProperties(task, { \n+                    loopCharacteristics: loopCharacteristics \n+                });\n+                \n+                addResult('Added parallel multi-instance (isSequential: false)', 'success');\n+                exportXML();\n+            } catch (error) {\n+                addResult('Error adding parallel multi-instance: ' + error.message, 'error');\n+            }\n+        }\n+        \n+        function addSequentialMultiInstance() {\n+            try {\n+                const modeling = modeler.get('modeling');\n+                const moddle = modeler.get('moddle');\n+                \n+                const loopCharacteristics = moddle.create('bpmn2:MultiInstanceLoopCharacteristics', {\n+                    isSequential: true\n+                });\n+                \n+                modeling.updateProperties(task, { \n+                    loopCharacteristics: loopCharacteristics \n+                });\n+                \n+                addResult('Added sequential multi-instance (isSequential: true)', 'success');\n+                exportXML();\n+            } catch (error) {\n+                addResult('Error adding sequential multi-instance: ' + error.message, 'error');\n+            }\n+        }\n+        \n+        function removeMultiInstance() {\n+            try {\n+                const modeling = modeler.get('modeling');\n+                \n+                modeling.updateProperties(task, { \n+                    loopCharacteristics: undefined \n+                });\n+                \n+                addResult('Removed multi-instance', 'success');\n+                exportXML();\n+            } catch (error) {\n+                addResult('Error removing multi-instance: ' + error.message, 'error');\n+            }\n+        }\n+        \n+        async function exportXML() {\n+            try {\n+                const result = await modeler.saveXML({ format: true });\n+                document.getElementById('xml-output').textContent = result.xml;\n+                \n+                // Check for expected XML patterns\n+                const xml = result.xml;\n+                const hasMultiInstance = xml.includes('multiInstanceLoopCharacteristics');\n+                const hasSequentialTrue = xml.includes('isSequential=\"true\"');\n+                const hasSequentialFalse = xml.includes('isSequential=\"false\"');\n+                \n+                let analysis = 'XML Analysis: ';\n+                if (hasMultiInstance) {\n+                    if (hasSequentialTrue) {\n+                        analysis += 'Sequential multi-instance detected \u2713';\n+                    } else if (hasSequentialFalse) {\n+                        analysis += 'Parallel multi-instance detected (with explicit isSequential=\"false\") \u2713';\n+                    } else {\n+                        analysis += 'Parallel multi-instance detected (without isSequential attribute) \u2713';\n+                    }\n+                } else {\n+                    analysis += 'No multi-instance characteristics';\n+                }\n+                \n+                addResult(analysis, 'success');\n+            } catch (error) {\n+                addResult('Error exporting XML: ' + error.message, 'error');\n+            }\n+        }\n+        \n+        // Initialize when page loads\n+        window.addEventListener('load', init);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/popup-menu/MultiInstanceXMLSpec.js b/test/spec/features/popup-menu/MultiInstanceXMLSpec.js\nnew file mode 100644\nindex 00000000..1082ae2b\n--- /dev/null\n+++ b/test/spec/features/popup-menu/MultiInstanceXMLSpec.js\n@@ -0,0 +1,187 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceMenuProviderModule from 'lib/features/popup-menu';\n+\n+describe('features/popup-menu - multi-instance XML serialization', function() {\n+\n+  var diagramXML = require('../../../fixtures/bpmn/draw/activity-markers-simple.bpmn');\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    replaceMenuProviderModule\n+  ];\n+\n+  beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+  function openPopup(element) {\n+    getBpmnJS().invoke(function(popupMenu) {\n+      popupMenu.open(element, 'bpmn-replace', { x: 0, y: 0 });\n+    });\n+  }\n+\n+  function triggerAction(actionId) {\n+    getBpmnJS().invoke(function(popupMenu) {\n+      var entry = popupMenu._getEntry(actionId);\n+      return entry.action();\n+    });\n+  }\n+\n+  function getBpmnJS() {\n+    return window.getBpmnJS();\n+  }\n+\n+  describe('XML serialization', function() {\n+\n+    it('should serialize parallel multi-instance correctly', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('Task');\n+\n+      openPopup(task);\n+\n+      // when\n+      triggerAction('toggle-parallel-mi');\n+\n+      // then\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // For parallel, should either have isSequential=\"false\" or no isSequential attribute\n+        var hasSequentialFalse = xml.includes('isSequential=\"false\"');\n+        var hasSequentialTrue = xml.includes('isSequential=\"true\"');\n+        \n+        // Should not have isSequential=\"true\" for parallel\n+        expect(hasSequentialTrue).to.be.false;\n+        \n+        // Either explicit false or no attribute is acceptable for parallel\n+        expect(hasSequentialFalse || !xml.includes('isSequential')).to.be.true;\n+      });\n+    }));\n+\n+    it('should serialize sequential multi-instance correctly', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('Task');\n+\n+      openPopup(task);\n+\n+      // when\n+      triggerAction('toggle-sequential-mi');\n+\n+      // then\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // For sequential, should have isSequential=\"true\"\n+        expect(xml).to.contain('isSequential=\"true\"');\n+      });\n+    }));\n+\n+    it('should update XML when switching from parallel to sequential', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('Task');\n+\n+      // first set parallel\n+      openPopup(task);\n+      triggerAction('toggle-parallel-mi');\n+\n+      // when switching to sequential\n+      openPopup(task);\n+      triggerAction('toggle-sequential-mi');\n+\n+      // then\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // Should have isSequential=\"true\" for sequential\n+        expect(xml).to.contain('isSequential=\"true\"');\n+        \n+        // Should not have isSequential=\"false\"\n+        expect(xml).not.to.contain('isSequential=\"false\"');\n+      });\n+    }));\n+\n+    it('should update XML when switching from sequential to parallel', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('Task');\n+\n+      // first set sequential\n+      openPopup(task);\n+      triggerAction('toggle-sequential-mi');\n+\n+      // when switching to parallel\n+      openPopup(task);\n+      triggerAction('toggle-parallel-mi');\n+\n+      // then\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // Should not have isSequential=\"true\" for parallel\n+        expect(xml).not.to.contain('isSequential=\"true\"');\n+        \n+        // For parallel, either explicit false or no attribute is acceptable\n+        var hasSequentialFalse = xml.includes('isSequential=\"false\"');\n+        var hasNoSequentialAttr = !xml.includes('isSequential');\n+        \n+        expect(hasSequentialFalse || hasNoSequentialAttr).to.be.true;\n+      });\n+    }));\n+\n+    it('should handle existing parallel multi-instance task correctly', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('ParallelTask');\n+\n+      // when\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // Should not have isSequential=\"true\" for parallel\n+        expect(xml).not.to.contain('isSequential=\"true\"');\n+      });\n+    }));\n+\n+    it('should handle existing sequential multi-instance task correctly', inject(function(elementRegistry) {\n+\n+      // given\n+      var task = elementRegistry.get('SequentialTask');\n+\n+      // when\n+      return getBpmnJS().saveXML({ format: true }).then(function(result) {\n+        var xml = result.xml;\n+        \n+        // Should have multiInstanceLoopCharacteristics\n+        expect(xml).to.contain('multiInstanceLoopCharacteristics');\n+        \n+        // Should have isSequential=\"true\" for sequential\n+        expect(xml).to.contain('isSequential=\"true\"');\n+      });\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/verify-fix.js b/verify-fix.js\nnew file mode 100644\nindex 00000000..23db2b79\n--- /dev/null\n+++ b/verify-fix.js\n@@ -0,0 +1,138 @@\n+/**\n+ * Simple verification script to test the multi-instance fix\n+ */\n+\n+// Mock the required dependencies\n+const mockModdle = {\n+  create: function(type, props) {\n+    const obj = { $type: type };\n+    if (props) {\n+      Object.assign(obj, props);\n+    }\n+    return obj;\n+  }\n+};\n+\n+const mockModeling = {\n+  updateProperties: function(element, props) {\n+    console.log('updateProperties called with:', props);\n+    if (props.loopCharacteristics) {\n+      element.businessObject.loopCharacteristics = props.loopCharacteristics;\n+    }\n+  }\n+};\n+\n+// Mock element\n+const mockElement = {\n+  businessObject: {\n+    loopCharacteristics: null\n+  }\n+};\n+\n+// Mock the isUndefined function\n+function isUndefined(value) {\n+  return value === undefined;\n+}\n+\n+// Mock getBusinessObject\n+function getBusinessObject(element) {\n+  return element.businessObject;\n+}\n+\n+// The fixed toggleLoopEntry function\n+function createToggleLoopEntry(moddle, modeling) {\n+  return function toggleLoopEntry(event, entry) {\n+    var loopCharacteristics = getBusinessObject(mockElement).loopCharacteristics;\n+\n+    if (entry.active) {\n+      loopCharacteristics = undefined;\n+    } else {\n+      if (isUndefined(entry.options.isSequential) || !loopCharacteristics) {\n+        loopCharacteristics = moddle.create(entry.options.loopCharacteristics);\n+      } else {\n+        // For multi-instance types, preserve existing properties but ensure clean isSequential handling\n+        var existingProps = {};\n+        \n+        // Copy all existing properties except isSequential\n+        Object.keys(loopCharacteristics).forEach(function(key) {\n+          if (key !== 'isSequential' && key !== '$type' && key !== '$parent') {\n+            existingProps[key] = loopCharacteristics[key];\n+          }\n+        });\n+        \n+        // Create new object with existing properties\n+        loopCharacteristics = moddle.create(entry.options.loopCharacteristics, existingProps);\n+      }\n+\n+      // Set isSequential only if it's defined in the options\n+      if (!isUndefined(entry.options.isSequential)) {\n+        loopCharacteristics.isSequential = entry.options.isSequential;\n+      }\n+    }\n+    modeling.updateProperties(mockElement, { loopCharacteristics: loopCharacteristics });\n+  };\n+}\n+\n+// Test scenarios\n+const toggleLoopEntry = createToggleLoopEntry(mockModdle, mockModeling);\n+\n+console.log('=== Testing Multi-Instance Fix ===\\n');\n+\n+// Test 1: Add parallel multi-instance to empty task\n+console.log('Test 1: Add parallel multi-instance to empty task');\n+mockElement.businessObject.loopCharacteristics = null;\n+const parallelEntry = {\n+  active: false,\n+  options: {\n+    loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+    isSequential: false\n+  }\n+};\n+\n+toggleLoopEntry(null, parallelEntry);\n+console.log('Result:', mockElement.businessObject.loopCharacteristics);\n+console.log('isSequential:', mockElement.businessObject.loopCharacteristics.isSequential);\n+console.log('Expected: false\\n');\n+\n+// Test 2: Switch from parallel to sequential\n+console.log('Test 2: Switch from parallel to sequential');\n+const sequentialEntry = {\n+  active: false,\n+  options: {\n+    loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+    isSequential: true\n+  }\n+};\n+\n+// Add some custom property to test preservation\n+mockElement.businessObject.loopCharacteristics.customProperty = 'test-value';\n+\n+toggleLoopEntry(null, sequentialEntry);\n+console.log('Result:', mockElement.businessObject.loopCharacteristics);\n+console.log('isSequential:', mockElement.businessObject.loopCharacteristics.isSequential);\n+console.log('customProperty preserved:', mockElement.businessObject.loopCharacteristics.customProperty);\n+console.log('Expected: isSequential=true, customProperty=test-value\\n');\n+\n+// Test 3: Switch back from sequential to parallel\n+console.log('Test 3: Switch back from sequential to parallel');\n+toggleLoopEntry(null, parallelEntry);\n+console.log('Result:', mockElement.businessObject.loopCharacteristics);\n+console.log('isSequential:', mockElement.businessObject.loopCharacteristics.isSequential);\n+console.log('customProperty preserved:', mockElement.businessObject.loopCharacteristics.customProperty);\n+console.log('Expected: isSequential=false, customProperty=test-value\\n');\n+\n+// Test 4: Remove multi-instance\n+console.log('Test 4: Remove multi-instance');\n+const removeEntry = {\n+  active: true,\n+  options: {\n+    loopCharacteristics: 'bpmn:MultiInstanceLoopCharacteristics',\n+    isSequential: false\n+  }\n+};\n+\n+toggleLoopEntry(null, removeEntry);\n+console.log('Result:', mockElement.businessObject.loopCharacteristics);\n+console.log('Expected: undefined\\n');\n+\n+console.log('=== Fix Verification Complete ===');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
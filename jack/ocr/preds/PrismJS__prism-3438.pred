  console.log('Tokens:');\n+    \n+    const tokens = Prism.tokenize(code, Prism.languages.css);\n+    \n+    function printTokens(tokens, indent = 0) {\n+        const prefix = '  '.repeat(indent);\n+        tokens.forEach(token => {\n+            if (typeof token === 'string') {\n+                console.log(`${prefix}\"${token}\"`);\n+            } else {\n+                console.log(`${prefix}[${token.type}]`);\n+                if (Array.isArray(token.content)) {\n+                    printTokens(token.content, indent + 1);\n+                } else {\n+                    console.log(`${prefix}  \"${token.content}\"`);\n+                }\n+            }\n+        });\n+    }\n+    \n+    printTokens(tokens);\n+    console.log('---\\n');\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
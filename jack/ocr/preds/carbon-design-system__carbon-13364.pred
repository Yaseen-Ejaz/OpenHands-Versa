ult;\n+\n+describe('ariaLabel to aria-label refactoring', () => {\n+  describe('TableSelectRow', () => {\n+    it('should accept ariaLabel prop (current behavior)', () => {\n+      const mockOnSelect = jest.fn();\n+      render(\n+        <table>\n+          <tbody>\n+            <tr>\n+              <TableSelectRow\n+                ariaLabel=\"Select row\"\n+                checked={false}\n+                id=\"test-row\"\n+                name=\"test-row\"\n+                onSelect={mockOnSelect}\n+              />\n+            </tr>\n+          </tbody>\n+        </table>\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('aria-label', 'Select row');\n+    });\n+\n+    it('should accept aria-label prop (new behavior)', () => {\n+      const mockOnSelect = jest.fn();\n+      render(\n+        <table>\n+          <tbody>\n+            <tr>\n+              <TableSelectRow\n+                aria-label=\"Select row\"\n+                checked={false}\n+                id=\"test-row\"\n+                name=\"test-row\"\n+                onSelect={mockOnSelect}\n+              />\n+            </tr>\n+          </tbody>\n+        </table>\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('aria-label', 'Select row');\n+    });\n+\n+    it('should prefer aria-label over ariaLabel when both are provided', () => {\n+      const mockOnSelect = jest.fn();\n+      render(\n+        <table>\n+          <tbody>\n+            <tr>\n+              <TableSelectRow\n+                aria-label=\"New aria-label\"\n+                ariaLabel=\"Old ariaLabel\"\n+                checked={false}\n+                id=\"test-row\"\n+                name=\"test-row\"\n+                onSelect={mockOnSelect}\n+              />\n+            </tr>\n+          </tbody>\n+        </table>\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('aria-label', 'New aria-label');\n+    });\n+  });\n+\n+  describe('TableSelectAll', () => {\n+    it('should accept ariaLabel prop (current behavior)', () => {\n+      const mockOnSelect = jest.fn();\n+      render(\n+        <table>\n+          <thead>\n+            <tr>\n+              <TableSelectAll\n+                ariaLabel=\"Select all rows\"\n+                checked={false}\n+                id=\"test-select-all\"\n+                name=\"test-select-all\"\n+                onSelect={mockOnSelect}\n+              />\n+            </tr>\n+          </thead>\n+        </table>\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('aria-label', 'Select all rows');\n+    });\n+\n+    it('should accept aria-label prop (new behavior)', () => {\n+      const mockOnSelect = jest.fn();\n+      render(\n+        <table>\n+          <thead>\n+            <tr>\n+              <TableSelectAll\n+                aria-label=\"Select all rows\"\n+                checked={false}\n+                id=\"test-select-all\"\n+                name=\"test-select-all\"\n+                onSelect={mockOnSelect}\n+              />\n+            </tr>\n+          </thead>\n+        </table>\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('aria-label', 'Select all rows');\n+    });\n+  });\n+\n+  describe('TableExpandRow', () => {\n+    it('should accept ariaLabel prop (current behavior)', () => {\n+      const mockOnExpand = jest.fn();\n+      render(\n+        <table>\n+          <tbody>\n+            <TableExpandRow\n+              ariaLabel=\"Expand row\"\n+              isExpanded={false}\n+              onExpand={mockOnExpand}\n+            >\n+              <td>Test content</td>\n+            </TableExpandRow>\n+          </tbody>\n+        </table>\n+      );\n+      \n+      const button = screen.getByRole('button');\n+      expect(button).toHaveAttribute('aria-label', 'Expand row');\n+    });\n+\n+    it('should accept aria-label prop (new behavior)', () => {\n+      const mockOnExpand = jest.fn();\n+      render(\n+        <table>\n+          <tbody>\n+            <TableExpandRow\n+              aria-label=\"Expand row\"\n+              isExpanded={false}\n+              onExpand={mockOnExpand}\n+            >\n+              <td>Test content</td>\n+            </TableExpandRow>\n+          </tbody>\n+        </table>\n+      );\n+      \n+      const button = screen.getByRole('button');\n+      expect(button).toHaveAttribute('aria-label', 'Expand row');\n+    });\n+  });\n+\n+  describe('TableExpandHeader', () => {\n+    it('should accept ariaLabel prop (current behavior)', () => {\n+      const mockOnExpand = jest.fn();\n+      render(\n+        <table>\n+          <thead>\n+            <tr>\n+              <TableExpandHeader\n+                ariaLabel=\"Expand all rows\"\n+                enableToggle={true}\n+                isExpanded={false}\n+                onExpand={mockOnExpand}\n+              />\n+            </tr>\n+          </thead>\n+        </table>\n+      );\n+      \n+      const button = screen.getByRole('button');\n+      expect(button).toHaveAttribute('aria-label', 'Expand all rows');\n+    });\n+\n+    it('should accept aria-label prop (new behavior)', () => {\n+      const mockOnExpand = jest.fn();\n+      render(\n+        <table>\n+          <thead>\n+            <tr>\n+              <TableExpandHeader\n+                aria-label=\"Expand all rows\"\n+                enableToggle={true}\n+                isExpanded={false}\n+                onExpand={mockOnExpand}\n+              />\n+            </tr>\n+          </thead>\n+        </table>\n+      );\n+      \n+      const button = screen.getByRole('button');\n+      expect(button).toHaveAttribute('aria-label', 'Expand all rows');\n+    });\n+  });\n+\n+  describe('InlineCheckbox', () => {\n+    it('should accept ariaLabel prop (current behavior)', () => {\n+      render(\n+        <InlineCheckbox\n+          ariaLabel=\"Test checkbox\"\n+          id=\"test-checkbox\"\n+          name=\"test-checkbox\"\n+        />\n+      );\n+      \n+      const label = screen.getByLabelText('Test checkbox');\n+      expect(label).toBeInTheDocument();\n+    });\n+\n+    it('should accept aria-label prop (new behavior)', () => {\n+      render(\n+        <InlineCheckbox\n+          aria-label=\"Test checkbox\"\n+          id=\"test-checkbox\"\n+          name=\"test-checkbox\"\n+        />\n+      );\n+      \n+      const label = screen.getByLabelText('Test checkbox');\n+      expect(label).toBeInTheDocument();\n+    });\n+  });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
{"instance_id": "highlightjs__highlight.js-3018", "model_patch": "diff --git a/src/languages/lib/ecmascript.js b/src/languages/lib/ecmascript.js\nindex b80f24d4..cc5f853b 100644\n--- a/src/languages/lib/ecmascript.js\n+++ b/src/languages/lib/ecmascript.js\n@@ -82,7 +82,10 @@ const TYPES = [\n   \"Array\",\n   \"Uint8Array\",\n   \"Uint8ClampedArray\",\n-  \"ArrayBuffer\"\n+  \"ArrayBuffer\",\n+  \"BigInt\",\n+  \"BigInt64Array\",\n+  \"BigUint64Array\"\n ];\n \n const ERROR_TYPES = [\ndiff --git a/test_bigint_reproduction.js b/test_bigint_reproduction.js\nnew file mode 100644\nindex 00000000..dc61fb19\n--- /dev/null\n+++ b/test_bigint_reproduction.js\n@@ -0,0 +1,61 @@\n+// Test file to reproduce BigInt highlighting issue\n+// This file will be used to verify the issue and test the fix\n+\n+const hljs = require('./build');\n+\n+// Test cases for BigInt types\n+const testCases = [\n+  {\n+    name: \"BigInt constructor\",\n+    code: \"let bi = BigInt('1');\",\n+    expected: \"BigInt should be highlighted as built_in\"\n+  },\n+  {\n+    name: \"BigInt64Array\",\n+    code: \"let arr = new BigInt64Array(10);\",\n+    expected: \"BigInt64Array should be highlighted as built_in\"\n+  },\n+  {\n+    name: \"BigUint64Array\", \n+    code: \"let arr = new BigUint64Array(10);\",\n+    expected: \"BigUint64Array should be highlighted as built_in\"\n+  },\n+  {\n+    name: \"Comparison with Number\",\n+    code: \"let num = Number('42'); let big = BigInt('42');\",\n+    expected: \"Both Number and BigInt should be highlighted as built_in\"\n+  },\n+  {\n+    name: \"BigInt literal\",\n+    code: \"let big = 123n;\",\n+    expected: \"BigInt literal should be highlighted as number\"\n+  }\n+];\n+\n+console.log(\"=== BigInt Highlighting Test ===\\n\");\n+\n+testCases.forEach((testCase, index) => {\n+  console.log(`Test ${index + 1}: ${testCase.name}`);\n+  console.log(`Code: ${testCase.code}`);\n+  \n+  const result = hljs.highlight('javascript', testCase.code);\n+  console.log(`Highlighted: ${result.value}`);\n+  \n+  // Check if BigInt types are highlighted as built_in\n+  const hasBigIntBuiltIn = result.value.includes('hljs-built_in\">BigInt');\n+  const hasBigInt64ArrayBuiltIn = result.value.includes('hljs-built_in\">BigInt64Array');\n+  const hasBigUint64ArrayBuiltIn = result.value.includes('hljs-built_in\">BigUint64Array');\n+  const hasNumberBuiltIn = result.value.includes('hljs-built_in\">Number');\n+  \n+  console.log(`BigInt highlighted as built_in: ${hasBigIntBuiltIn}`);\n+  console.log(`Number highlighted as built_in: ${hasNumberBuiltIn}`);\n+  if (testCase.code.includes('BigInt64Array')) {\n+    console.log(`BigInt64Array highlighted as built_in: ${hasBigInt64ArrayBuiltIn}`);\n+  }\n+  if (testCase.code.includes('BigUint64Array')) {\n+    console.log(`BigUint64Array highlighted as built_in: ${hasBigUint64ArrayBuiltIn}`);\n+  }\n+  \n+  console.log(`Expected: ${testCase.expected}`);\n+  console.log(\"---\\n\");\n+});\n\\ No newline at end of file\ndiff --git a/test_bigint_visual.html b/test_bigint_visual.html\nnew file mode 100644\nindex 00000000..7c5a8c8a\n--- /dev/null\n+++ b/test_bigint_visual.html\n@@ -0,0 +1,67 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BigInt Highlighting Test</title>\n+    <link rel=\"stylesheet\" href=\"./build/styles/default.css\">\n+    <script src=\"./build/lib/core.js\"></script>\n+    <script src=\"./build/lib/languages/javascript.js\"></script>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin: 20px 0; padding: 15px; border: 1px solid #ccc; }\n+        .test-title { font-weight: bold; margin-bottom: 10px; }\n+        .code-block { background: #f5f5f5; padding: 10px; margin: 10px 0; }\n+        .expected { color: #666; font-style: italic; }\n+        .issue { background-color: #ffe6e6; }\n+        .working { background-color: #e6ffe6; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BigInt Highlighting Issue Reproduction</h1>\n+    <p>This page demonstrates the BigInt highlighting issue in highlight.js</p>\n+\n+    <div class=\"test-case issue\">\n+        <div class=\"test-title\">\u274c Issue: BigInt constructor not highlighted</div>\n+        <div class=\"expected\">Expected: BigInt should be highlighted as built_in (like Number)</div>\n+        <pre><code class=\"javascript\">let bi = BigInt('1');</code></pre>\n+    </div>\n+\n+    <div class=\"test-case working\">\n+        <div class=\"test-title\">\u2705 Working: Number constructor highlighted correctly</div>\n+        <div class=\"expected\">Expected: Number should be highlighted as built_in</div>\n+        <pre><code class=\"javascript\">let num = Number('42');</code></pre>\n+    </div>\n+\n+    <div class=\"test-case issue\">\n+        <div class=\"test-title\">\u274c Issue: BigInt64Array not highlighted</div>\n+        <div class=\"expected\">Expected: BigInt64Array should be highlighted as built_in</div>\n+        <pre><code class=\"javascript\">let arr = new BigInt64Array(10);</code></pre>\n+    </div>\n+\n+    <div class=\"test-case issue\">\n+        <div class=\"test-title\">\u274c Issue: BigUint64Array not highlighted</div>\n+        <div class=\"expected\">Expected: BigUint64Array should be highlighted as built_in</div>\n+        <pre><code class=\"javascript\">let arr = new BigUint64Array(10);</code></pre>\n+    </div>\n+\n+    <div class=\"test-case working\">\n+        <div class=\"test-title\">\u2705 Working: BigInt literal highlighted correctly</div>\n+        <div class=\"expected\">Expected: 123n should be highlighted as number</div>\n+        <pre><code class=\"javascript\">let big = 123n;</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <div class=\"test-title\">\ud83d\udd0d Comparison: All together</div>\n+        <div class=\"expected\">Expected: Number, BigInt, BigInt64Array, BigUint64Array should all be highlighted as built_in</div>\n+        <pre><code class=\"javascript\">let num = Number('42');\n+let big = BigInt('42');\n+let arr1 = new BigInt64Array(10);\n+let arr2 = new BigUint64Array(10);\n+let literal = 123n;</code></pre>\n+    </div>\n+\n+    <script>\n+        // Initialize highlight.js\n+        hljs.highlightAll();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_bigint_visual_fixed.html b/test_bigint_visual_fixed.html\nnew file mode 100644\nindex 00000000..3ce617c9\n--- /dev/null\n+++ b/test_bigint_visual_fixed.html\n@@ -0,0 +1,68 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BigInt Highlighting Test</title>\n+    <link rel=\"stylesheet\" href=\"./build/styles/default.css\">\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin: 20px 0; padding: 15px; border: 1px solid #ccc; }\n+        .test-title { font-weight: bold; margin-bottom: 10px; }\n+        .code-block { background: #f5f5f5; padding: 10px; margin: 10px 0; }\n+        .expected { color: #666; font-style: italic; }\n+        .issue { background-color: #ffe6e6; }\n+        .working { background-color: #e6ffe6; }\n+        .fixed { background-color: #e6f3ff; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BigInt Highlighting Test - After Fix</h1>\n+    <p>This page demonstrates that the BigInt highlighting issue has been fixed</p>\n+\n+    <div class=\"test-case fixed\">\n+        <div class=\"test-title\">\u2705 FIXED: BigInt constructor now highlighted</div>\n+        <div class=\"expected\">Expected: BigInt should be highlighted as built_in (like Number)</div>\n+        <pre><code class=\"javascript\">let bi = BigInt('1');</code></pre>\n+    </div>\n+\n+    <div class=\"test-case working\">\n+        <div class=\"test-title\">\u2705 Working: Number constructor highlighted correctly</div>\n+        <div class=\"expected\">Expected: Number should be highlighted as built_in</div>\n+        <pre><code class=\"javascript\">let num = Number('42');</code></pre>\n+    </div>\n+\n+    <div class=
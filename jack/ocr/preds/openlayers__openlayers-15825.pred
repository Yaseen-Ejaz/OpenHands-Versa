{"instance_id": "openlayers__openlayers-15825", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..ef1155854\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [03/Jun/2026 19:58:50] \"GET /test_antimeridian_issue.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 19:58:50] \"GET /dist/ol.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/reproj/Triangulation.js b/src/ol/reproj/Triangulation.js\nindex 4dde2dab3..2e07c9e8e 100644\n--- a/src/ol/reproj/Triangulation.js\n+++ b/src/ol/reproj/Triangulation.js\n@@ -488,6 +488,44 @@ class Triangulation {\n       extendCoordinate(extent, src[2]);\n     });\n \n+    // When triangulation wraps X coordinates, we need to ensure the extent\n+    // doesn't span incorrectly across the antimeridian\n+    if (this.wrapsXInSource_ && this.sourceWorldWidth_) {\n+      const extentWidth = extent[2] - extent[0];\n+      if (extentWidth > this.sourceWorldWidth_ / 2) {\n+        // The extent spans too wide, likely due to wrapped coordinates\n+        // Find the actual bounds by considering wrapped coordinates\n+        let minX = Infinity;\n+        let maxX = -Infinity;\n+\n+        this.triangles_.forEach((triangle) => {\n+          const src = triangle.source;\n+          for (let i = 0; i < 3; i++) {\n+            const x = src[i][0];\n+            // Normalize coordinates to the same \"side\" of the world\n+            const normalizedX =\n+              x < extent[0] + this.sourceWorldWidth_ / 2\n+                ? x + this.sourceWorldWidth_\n+                : x;\n+            minX = Math.min(minX, normalizedX);\n+            maxX = Math.max(maxX, normalizedX);\n+          }\n+        });\n+\n+        // If the normalized extent is smaller, use it\n+        if (maxX - minX < extentWidth) {\n+          extent[0] = minX;\n+          extent[2] = maxX;\n+\n+          // Wrap back to the original coordinate space if needed\n+          if (extent[0] >= this.sourceWorldWidth_) {\n+            extent[0] -= this.sourceWorldWidth_;\n+            extent[2] -= this.sourceWorldWidth_;\n+          }\n+        }\n+      }\n+    }\n+\n     return extent;\n   }\n \ndiff --git a/test_antimeridian_fix.js b/test_antimeridian_fix.js\nnew file mode 100644\nindex 000000000..4ab6b9be0\n--- /dev/null\n+++ b/test_antimeridian_fix.js\n@@ -0,0 +1,134 @@\n+/**\n+ * Test for antimeridian missing tiles fix\n+ */\n+\n+import Triangulation from './src/ol/reproj/Triangulation.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+import proj4 from 'proj4';\n+import {register} from './src/ol/proj/proj4.js';\n+\n+// Register proj4\n+proj4.defs('EPSG:4326', '+proj=longlat +datum=WGS84 +no_defs');\n+proj4.defs('stereo-sib', '+proj=stere +lat_0=49 +lat_ts=-73 +lon_0=90 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+register(proj4);\n+\n+// Test the triangulation fix\n+function testAntimeridianTriangulation() {\n+  console.log('Testing antimeridian triangulation fix...');\n+  \n+  const sourceProj = getProjection('EPSG:4326');\n+  const targetProj = getProjection('stereo-sib');\n+  \n+  // Create a target extent that would cause issues near the antimeridian\n+  // This simulates the coordinates from the bug report\n+  const targetExtent = [-2000000, 6000000, 2000000, 10000000]; // Approximate stereographic coordinates\n+  \n+  // Source extent that spans the antimeridian\n+  const maxSourceExtent = [-180, -90, 180, 90];\n+  \n+  const errorThreshold = 1000; // 1km error threshold\n+  const destinationResolution = 1000; // 1km per pixel\n+  \n+  try {\n+    const triangulation = new Triangulation(\n+      sourceProj,\n+      targetProj,\n+      targetExtent,\n+      maxSourceExtent,\n+      errorThreshold,\n+      destinationResolution\n+    );\n+    \n+    const sourceExtent = triangulation.calculateSourceExtent();\n+    const triangles = triangulation.getTriangles();\n+    \n+    console.log('Triangulation completed successfully');\n+    console.log('Number of triangles:', triangles.length);\n+    console.log('Source extent:', sourceExtent);\n+    console.log('Source extent width:', sourceExtent[2] - sourceExtent[0]);\n+    console.log('Wraps X in source:', triangulation.wrapsXInSource_);\n+    \n+    // Check if the extent is reasonable (not spanning the entire world incorrectly)\n+    const extentWidth = sourceExtent[2] - sourceExtent[0];\n+    if (extentWidth > 300) { // More than 300 degrees is likely wrong\n+      console.error('ERROR: Source extent spans too wide:', extentWidth, 'degrees');\n+      return false;\n+    }\n+    \n+    // Check if we have triangles\n+    if (triangles.length === 0) {\n+      console.error('ERROR: No triangles generated');\n+      return false;\n+    }\n+    \n+    console.log('\u2713 Test passed: Triangulation handles antimeridian correctly');\n+    return true;\n+    \n+  } catch (error) {\n+    console.error('ERROR: Triangulation failed:', error);\n+    return false;\n+  }\n+}\n+\n+// Test with coordinates from the bug report\n+function testBugReportCoordinates() {\n+  console.log('\\nTesting with bug report coordinates...');\n+  \n+  const sourceProj = getProjection('EPSG:4326');\n+  const targetProj = getProjection('stereo-sib');\n+  \n+  // Convert the bug report coordinates to target projection\n+  const centerLonLat = [-175.63918171041328, 54.36175564445709];\n+  \n+  // Create a small extent around the center\n+  const targetExtent = [\n+    centerLonLat[0] - 5, centerLonLat[1] - 5,\n+    centerLonLat[0] + 5, centerLonLat[1] + 5\n+  ];\n+  \n+  const maxSourceExtent = [-180, -90, 180, 90];\n+  const errorThreshold = 100;\n+  const destinationResolution = 100;\n+  \n+  try {\n+    const triangulation = new Triangulation(\n+      sourceProj,\n+      targetProj,\n+      targetExtent,\n+      maxSourceExtent,\n+      errorThreshold,\n+      destinationResolution\n+    );\n+    \n+    const sourceExtent = triangulation.calculateSourceExtent();\n+    const triangles = triangulation.getTriangles();\n+    \n+    console.log('Bug report test completed');\n+    console.log('Source extent:', sourceExtent);\n+    console.log('Number of triangles:', triangles.length);\n+    \n+    // The extent should be reasonable for the antimeridian area\n+    const extentWidth = sourceExtent[2] - sourceExtent[0];\n+    if (extentWidth > 100) { // More than 100 degrees is likely wrong for this small area\n+      console.error('ERROR: Source extent spans too wide for bug report coordinates:', extentWidth, 'degrees');\n+      return false;\n+    }\n+    \n+    console.log('\u2713 Bug report test passed');\n+    return true;\n+    \n+  } catch (error) {\n+    console.error('ERROR: Bug report test failed:', error);\n+    return false;\n+  }\n+}\n+\n+// Run tests\n+const test1 = testAntimeridianTriangulation();\n+const test2 = testBugReportCoordinates();\n+\n+if (test1 && test2) {\n+  console.log('\\n\u2713 All tests passed! The antimeridian fix appears to be working.');\n+} else {\n+  console.log('\\n\u2717 Some tests failed. The fix may need adjustment.');\n+}\n\\ No newline at end of file\ndiff --git a/test_antimeridian_issue.html b/test_antimeridian_issue.html\nnew file mode 100644\nindex 000000000..d1136c2a0\n--- /dev/null\n+++ b/test_antimeridian_issue.html\n@@ -0,0 +1,98 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Antimeridian Missing Tiles Test</title>\n+    <meta charset=\"utf-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 100%;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #info {\n+            margin-bottom: 10px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/proj4@2.8.0/dist/proj4.js\"></script>\n+    <script src=\"./dist/ol.js\"></script>\n+</head>\n+<body>\n+    <div id=\"info\">\n+        <h3>Antimeridian Missing Tiles Test</h3>\n+        <p>This test reproduces the issue where tiles near the antimeridian are missing when using WebGLTileLayer with GeoTIFF source in stereographic projection.</p>\n+        <p><strong>Expected:</strong> No missing tiles around the antimeridian</p>\n+        <p><strong>Actual:</strong> Black gaps where tiles should be rendered</p>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script>\n+        // Register the stereographic projection\n+        proj4.defs('stereo-sib', '+proj=stere +lat_0=49 +lat_ts=-73 +lon_0=90 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+        ol.proj.proj4.register(proj4);\n+\n+        // Get the projection\n+        const defaultProj = ol.proj.get('stereo-sib');\n+\n+        // Create a simple test GeoTIFF source (we'll use a placeholder URL for now)\n+        // In a real test, this would be the actual GeoTIFF file\n+        const testGeoTiffUrl = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==';\n+\n+        // Create the WebGLTileLayer with GeoTIFF source\n+        const webglLayer = new ol.layer.WebGLTile({\n+            source: new ol.source.XYZ({\n+                // Using XYZ as a placeholder since we don't have the actual GeoTIFF file\n+                // In the real test, this would be: new ol.source.GeoTIFF({sources: [{url: testGeoTiffUrl}], crossOrigin: 'anonymous', transition: 0, normalize: true})\n+                url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',\n+                crossOrigin: 'anonymous'\n+            }),\n+            name: 'segments',\n+            zIndex: 2,\n+            cacheSize: 2048,\n+            preload: 0\n+        });\n+\n+        // Initialize View with the exact coordinates from the bug report\n+        const view = new ol.View({\n+            projection: defaultProj,\n+            center: ol.proj.fromLonLat([-175.63918171041328, 54.36175564445709], defaultProj),\n+            zoom: 5.370370380181835,\n+            minZoom: 4\n+        });\n+\n+        // Create the map\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [webglLayer],\n+            view: view\n+        });\n+\n+        // Add some debugging info\n+        console.log('Projection:', defaultProj);\n+        console.log('View center:', view.getCenter());\n+        console.log('View zoom:', view.getZoom());\n+        console.log('Layer source:', webglLayer.getSource());\n+\n+        // Add event listeners to monitor tile loading\n+        webglLayer.getSource().on('tileloadstart', function(event) {\n+            console.log('Tile load start:', event.tile.getTileCoord());\n+        });\n+\n+        webglLayer.getSource().on('tileloadend', function(event) {\n+            console.log('Tile load end:', event.tile.getTileCoord());\n+        });\n+\n+        webglLayer.getSource().on('tileloaderror', function(event) {\n+            console.log('Tile load error:', event.tile.getTileCoord());\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_triangulation_fix.js b/test_triangulation_fix.js\nnew file mode 100644\nindex 000000000..2272bb590\n--- /dev/null\n+++ b/test_triangulation_fix.js\n@@ -0,0 +1,170 @@\n+/**\n+ * Comprehensive test for the antimeridian triangulation fix\n+ */\n+\n+import Triangulation from './src/ol/reproj/Triangulation.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+import proj4 from 'proj4';\n+import {register} from './src/ol/proj/proj4.js';\n+\n+// Register proj4\n+proj4.defs('EPSG:4326', '+proj=longlat +datum=WGS84 +no_defs');\n+proj4.defs('stereo-sib', '+proj=stere +lat_0=49 +lat_ts=-73 +lon_0=90 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs');\n+register(proj4);\n+\n+function testTriangulationExtentCalculation() {\n+  console.log('Testing triangulation extent calculation...');\n+  \n+  const sourceProj = getProjection('EPSG:4326');\n+  const targetProj = getProjection('stereo-sib');\n+  \n+  // Test case 1: Normal case (no wrapping)\n+  console.log('\\n1. Testing normal case (no wrapping)...');\n+  const normalTargetExtent = [1000000, 5000000, 2000000, 6000000];\n+  const normalTriangulation = new Triangulation(\n+    sourceProj,\n+    targetProj,\n+    normalTargetExtent,\n+    [-180, -90, 180, 90],\n+    1000,\n+    1000\n+  );\n+  \n+  const normalExtent = normalTriangulation.calculateSourceExtent();\n+  console.log('Normal extent:', normalExtent);\n+  console.log('Normal extent width:', normalExtent[2] - normalExtent[0]);\n+  console.log('Wraps X:', normalTriangulation.wrapsXInSource_);\n+  \n+  // Test case 2: Antimeridian case (should wrap)\n+  console.log('\\n2. Testing antimeridian case (should wrap)...');\n+  const antimeridianTargetExtent = [-2000000, 6000000, 2000000, 10000000];\n+  const antimeridianTriangulation = new Triangulation(\n+    sourceProj,\n+    targetProj,\n+    antimeridianTargetExtent,\n+    [-180, -90, 180, 90],\n+    1000,\n+    1000\n+  );\n+  \n+  const antimeridianExtent = antimeridianTriangulation.calculateSourceExtent();\n+  console.log('Antimeridian extent:', antimeridianExtent);\n+  console.log('Antimeridian extent width:', antimeridianExtent[2] - antimeridianExtent[0]);\n+  console.log('Wraps X:', antimeridianTriangulation.wrapsXInSource_);\n+  \n+  // Test case 3: Bug report coordinates\n+  console.log('\\n3. Testing bug report coordinates...');\n+  const bugReportCenter = [-175.63918171041328, 54.36175564445709];\n+  // Create a small extent around the bug report center in geographic coordinates\n+  const bugReportTargetExtent = [\n+    bugReportCenter[0] - 2, bugReportCenter[1] - 2,\n+    bugReportCenter[0] + 2, bugReportCenter[1] + 2\n+  ];\n+  \n+  const bugReportTriangulation = new Triangulation(\n+    sourceProj,\n+    targetProj,\n+    bugReportTargetExtent,\n+    [-180, -90, 180, 90],\n+    100,\n+    100\n+  );\n+  \n+  const bugReportExtent = bugReportTriangulation.calculateSourceExtent();\n+  console.log('Bug report extent:', bugReportExtent);\n+  console.log('Bug report extent width:', bugReportExtent[2] - bugReportExtent[0]);\n+  console.log('Wraps X:', bugReportTriangulation.wrapsXInSource_);\n+  \n+  // Validation\n+  let allTestsPassed = true;\n+  \n+  // Check that normal case doesn't have excessive width\n+  if (normalExtent[2] - normalExtent[0] > 180) {\n+    console.error('ERROR: Normal case extent too wide');\n+    allTestsPassed = false;\n+  }\n+  \n+  // Check that antimeridian case doesn't span the entire world\n+  if (antimeridianExtent[2] - antimeridianExtent[0] > 300) {\n+    console.error('ERROR: Antimeridian case extent spans too wide (likely broken)');\n+    allTestsPassed = false;\n+  }\n+  \n+  // Check that bug report case is reasonable\n+  if (bugReportExtent[2] - bugReportExtent[0] > 50) {\n+    console.error('ERROR: Bug report case extent too wide for small area');\n+    allTestsPassed = false;\n+  }\n+  \n+  // Check that all triangulations produced triangles\n+  if (normalTriangulation.getTriangles().length === 0 ||\n+      antimeridianTriangulation.getTriangles().length === 0 ||\n+      bugReportTriangulation.getTriangles().length === 0) {\n+    console.error('ERROR: Some triangulations produced no triangles');\n+    allTestsPassed = false;\n+  }\n+  \n+  return allTestsPassed;\n+}\n+\n+function testExtentWrappingLogic() {\n+  console.log('\\n\\nTesting extent wrapping logic specifically...');\n+  \n+  const sourceProj = getProjection('EPSG:4326');\n+  const targetProj = getProjection('stereo-sib');\n+  \n+  // Create a triangulation that we know will wrap\n+  const targetExtent = [-3000000, 7000000, 3000000, 11000000];\n+  const triangulation = new Triangulation(\n+    sourceProj,\n+    targetProj,\n+    targetExtent,\n+    [-180, -90, 180, 90],\n+    1000,\n+    1000\n+  );\n+  \n+  const extent = triangulation.calculateSourceExtent();\n+  const triangles = triangulation.getTriangles();\n+  \n+  console.log('Wrapping test results:');\n+  console.log('- Wraps X:', triangulation.wrapsXInSource_);\n+  console.log('- Number of triangles:', triangles.length);\n+  console.log('- Calculated extent:', extent);\n+  console.log('- Extent width:', extent[2] - extent[0]);\n+  \n+  // Check if any triangles have coordinates that would cause wrapping issues\n+  let hasNegativeCoords = false;\n+  let hasLargeCoords = false;\n+  \n+  triangles.forEach(triangle => {\n+    triangle.source.forEach(coord => {\n+      if (coord[0] < -180) hasNegativeCoords = true;\n+      if (coord[0] > 180) hasLargeCoords = true;\n+    });\n+  });\n+  \n+  console.log('- Has negative coordinates (< -180):', hasNegativeCoords);\n+  console.log('- Has large coordinates (> 180):', hasLargeCoords);\n+  \n+  // The fix should handle this case properly\n+  const isReasonable = extent[2] - extent[0] < 300; // Less than 300 degrees\n+  console.log('- Extent is reasonable:', isReasonable);\n+  \n+  return isReasonable;\n+}\n+\n+// Run all tests\n+console.log('=== TRIANGULATION FIX VERIFICATION ===');\n+\n+const test1Passed = testTriangulationExtentCalculation();\n+const test2Passed = testExtentWrappingLogic();\n+\n+console.log('\\n=== RESULTS ===');\n+if (test1Passed && test2Passed) {\n+  console.log('\u2713 ALL TESTS PASSED - The antimeridian fix is working correctly!');\n+  process.exit(0);\n+} else {\n+  console.log('\u2717 SOME TESTS FAILED - The fix may need adjustment.');\n+  process.exit(1);\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
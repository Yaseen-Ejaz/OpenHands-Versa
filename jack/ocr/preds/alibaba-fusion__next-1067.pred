   | Number   | 0                                                |\ndiff --git a/src/slider/slick/arrow.jsx b/src/slider/slick/arrow.jsx\nindex e8f9b6610..a59a45cc1 100644\n--- a/src/slider/slick/arrow.jsx\n+++ b/src/slider/slick/arrow.jsx\n@@ -50,9 +50,15 @@ export default class Arrow extends Component {\n             return false;\n         }\n \n-        // \u4e0b\u4e00\u4e2a index \u5927\u4e8e\u603b\u6570\uff1f\uff1f\n+        // When slidesToShow >= slideCount, check if navigation is still possible\n         if (slideCount <= slidesToShow) {\n-            return true;\n+            if (type === 'prev') {\n+                // Enable prev arrow if we can go back (currentSlide > 0)\n+                return currentSlide <= 0;\n+            } else {\n+                // Enable next arrow if we can go forward (currentSlide < slideCount - 1)\n+                return currentSlide >= slideCount - 1;\n+            }\n         }\n \n         // \u5411\u524d\u7bad\u5934\uff1a\u5f53\u524d\u662f\u7b2c 0 \u4e2a", "model_name_or_path": "llm.claude4"}
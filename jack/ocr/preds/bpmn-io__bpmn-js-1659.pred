{"instance_id": "bpmn-io__bpmn-js-1659", "model_patch": "diff --git a/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.bpmn b/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.bpmn\nnew file mode 100644\nindex 00000000..8f421b24\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.bpmn\n@@ -0,0 +1,94 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"simple\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"5.0.0-rc.0\" xsi:schemaLocation=\"http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:startEvent>\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+      <bpmn2:startEvent id=\"StartEvent_2\" name=\"Start Event 2\">\n+        <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>\n+      </bpmn2:startEvent>\n+      <bpmn2:task id=\"Task_1\" name=\"Task\">\n+        <bpmn2:incoming>SequenceFlow_3</bpmn2:incoming>\n+      </bpmn2:task>\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_3\" sourceRef=\"StartEvent_2\" targetRef=\"Task_1\" />\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Event\">\n+      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+    </bpmn2:endEvent>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow 2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_1\" />\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"TextAnnotation_1\" targetRef=\"SequenceFlow_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_2\" />\n+    <bpmn2:association id=\"Association_2\" sourceRef=\"SequenceFlow_2\" targetRef=\"TextAnnotation_2\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_1\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"132\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"106\" y=\"173\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_SubProcess_1\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"350\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"359\" y=\"107\" width=\"67\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"240\" y=\"182\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"225\" y=\"225\" width=\"67\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"160\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"395\" y=\"196\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"600\" y=\"132\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"593\" y=\"175\" width=\"51\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"120\" y=\"50\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_2_di\" bpmnElement=\"TextAnnotation_2\">\n+        <dc:Bounds x=\"620\" y=\"50\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"150\" />\n+        <di:waypoint x=\"200\" y=\"150\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"159\" y=\"128\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_2\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"550\" y=\"150\" />\n+        <di:waypoint x=\"600\" y=\"150\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"565\" y=\"128\" width=\"33\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_3\" bpmnElement=\"SequenceFlow_3\">\n+        <di:waypoint x=\"276\" y=\"200\" />\n+        <di:waypoint x=\"350\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"170\" y=\"80\" />\n+        <di:waypoint x=\"168\" y=\"150\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Association_2_di\" bpmnElement=\"Association_2\">\n+        <di:waypoint x=\"575\" y=\"150\" />\n+        <di:waypoint x=\"670\" y=\"80\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.spec.js b/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.spec.js\nnew file mode 100644\nindex 00000000..f391d2cd\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/LayoutConnectionBehavior.resize.spec.js\n@@ -0,0 +1,142 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  assign,\n+  map,\n+} from 'min-dash';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('behavior - LayoutConnectionBehavior - Shape Resize', function() {\n+\n+  var diagramXML = require('./LayoutConnectionBehavior.resize.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      modelingModule,\n+      coreModule\n+    ]\n+  }));\n+\n+  describe('shape resize', function() {\n+\n+    it('should reconnect associations when shape is resized', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      var sequenceFlow1 = elementRegistry.get('SequenceFlow_1');\n+      var sequenceFlow2 = elementRegistry.get('SequenceFlow_2');\n+      var association1 = elementRegistry.get('Association_1');\n+      var association2 = elementRegistry.get('Association_2');\n+\n+      // record original association waypoints\n+      var originalAssociation1Waypoints = copyWaypoints(association1);\n+      var originalAssociation2Waypoints = copyWaypoints(association2);\n+\n+      console.log('Original Association 1 waypoints:', originalAssociation1Waypoints);\n+      console.log('Original Association 2 waypoints:', originalAssociation2Waypoints);\n+\n+      // when - resize the subprocess (make it wider)\n+      modeling.resizeShape(subProcess, { \n+        x: 200, \n+        y: 100, \n+        width: 450,  // increased from 350\n+        height: 200 \n+      });\n+\n+      // then - check that sequence flows were re-laid out\n+      console.log('SequenceFlow_1 waypoints after resize:', sequenceFlow1.waypoints);\n+      console.log('SequenceFlow_2 waypoints after resize:', sequenceFlow2.waypoints);\n+\n+      // and associations should have been updated too\n+      console.log('Association 1 waypoints after resize:', association1.waypoints);\n+      console.log('Association 2 waypoints after resize:', association2.waypoints);\n+\n+      // The associations should have moved to follow the new connection positions\n+      // Association 1 should still connect to SequenceFlow_1 at the new position\n+      // Association 2 should still connect to SequenceFlow_2 at the new position\n+      \n+      // For now, let's just check that the associations have changed\n+      expect(association1.waypoints).to.not.eql(originalAssociation1Waypoints);\n+      expect(association2.waypoints).to.not.eql(originalAssociation2Waypoints);\n+    }));\n+\n+    it('should reconnect labels when shape is resized', inject(function(elementRegistry, modeling) {\n+\n+      // given\n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      var sequenceFlow1 = elementRegistry.get('SequenceFlow_1');\n+      var sequenceFlow2 = elementRegistry.get('SequenceFlow_2');\n+\n+      // record original label positions\n+      var originalLabel1Position = sequenceFlow1.label ? { x: sequenceFlow1.label.x, y: sequenceFlow1.label.y } : null;\n+      var originalLabel2Position = sequenceFlow2.label ? { x: sequenceFlow2.label.x, y: sequenceFlow2.label.y } : null;\n+\n+      console.log('Original Label 1 position:', originalLabel1Position);\n+      console.log('Original Label 2 position:', originalLabel2Position);\n+\n+      // when - resize the subprocess (make it wider)\n+      modeling.resizeShape(subProcess, { \n+        x: 200, \n+        y: 100, \n+        width: 450,  // increased from 350\n+        height: 200 \n+      });\n+\n+      // then - check that labels were moved\n+      var newLabel1Position = sequenceFlow1.label ? { x: sequenceFlow1.label.x, y: sequenceFlow1.label.y } : null;\n+      var newLabel2Position = sequenceFlow2.label ? { x: sequenceFlow2.label.x, y: sequenceFlow2.label.y } : null;\n+\n+      console.log('New Label 1 position:', newLabel1Position);\n+      console.log('New Label 2 position:', newLabel2Position);\n+\n+      // Labels should have moved to follow the new connection positions\n+      if (originalLabel1Position && newLabel1Position) {\n+        expect(newLabel1Position).to.not.eql(originalLabel1Position);\n+      }\n+      if (originalLabel2Position && newLabel2Position) {\n+        expect(newLabel2Position).to.not.eql(originalLabel2Position);\n+      }\n+    }));\n+\n+  });\n+\n+});\n+\n+// helpers //////////\n+\n+function copyWaypoint(waypoint) {\n+  return assign({}, waypoint);\n+}\n+\n+function copyWaypoints(connection) {\n+  return map(connection.waypoints, function(waypoint) {\n+\n+    waypoint = copyWaypoint(waypoint);\n+\n+    if (waypoint.original) {\n+      waypoint.original = copyWaypoint(waypoint.original);\n+    }\n+\n+    return waypoint;\n+  });\n+}\n+\n+function expectWaypoints(connection, expectedWaypoints) {\n+\n+  var actualWaypoints = connection.waypoints;\n+\n+  expect(actualWaypoints).to.exist;\n+  expect(expectedWaypoints).to.exist;\n+\n+  expect(connection.waypoints.length).to.eql(expectedWaypoints.length);\n+\n+  for (var i in actualWaypoints) {\n+    expect(actualWaypoints[i].x).to.eql(expectedWaypoints[i].x);\n+    expect(actualWaypoints[i].y).to.eql(expectedWaypoints[i].y);\n+  }\n+}\n\\ No newline at end of file\ndiff --git a/test_resize_issue.html b/test_resize_issue.html\nnew file mode 100644\nindex 00000000..93e2cb37\n--- /dev/null\n+++ b/test_resize_issue.html\n@@ -0,0 +1,197 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js Resize Issue Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    #canvas {\n+      border: 1px solid #ccc;\n+      height: 600px;\n+    }\n+    .controls {\n+      margin: 20px 0;\n+    }\n+    button {\n+      margin: 5px;\n+      padding: 10px;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN.js Resize Issue Test</h1>\n+  <div class=\"controls\">\n+    <button onclick=\"resizeSubProcess()\">Resize SubProcess (Wider)</button>\n+    <button onclick=\"resetSubProcess()\">Reset SubProcess</button>\n+    <button onclick=\"logPositions()\">Log Positions</button>\n+  </div>\n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"simple\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn2:startEvent id=\"StartEvent_1\" name=\"Start\">\n+      <bpmn2:outgoing>SequenceFlow_1</bpmn2:outgoing>\n+    </bpmn2:startEvent>\n+    <bpmn2:subProcess id=\"SubProcess_1\" name=\"Sub Process\">\n+      <bpmn2:incoming>SequenceFlow_1</bpmn2:incoming>\n+      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>\n+      <bpmn2:startEvent id=\"StartEvent_2\" name=\"Start Event 2\">\n+        <bpmn2:outgoing>SequenceFlow_3</bpmn2:outgoing>\n+      </bpmn2:startEvent>\n+      <bpmn2:task id=\"Task_1\" name=\"Task\">\n+        <bpmn2:incoming>SequenceFlow_3</bpmn2:incoming>\n+      </bpmn2:task>\n+      <bpmn2:sequenceFlow id=\"SequenceFlow_3\" sourceRef=\"StartEvent_2\" targetRef=\"Task_1\" />\n+    </bpmn2:subProcess>\n+    <bpmn2:endEvent id=\"EndEvent_1\" name=\"End Event\">\n+      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>\n+    </bpmn2:endEvent>\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn2:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow 2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_1\" />\n+    <bpmn2:association id=\"Association_1\" sourceRef=\"TextAnnotation_1\" targetRef=\"SequenceFlow_1\" />\n+    <bpmn2:textAnnotation id=\"TextAnnotation_2\" />\n+    <bpmn2:association id=\"Association_2\" sourceRef=\"SequenceFlow_2\" targetRef=\"TextAnnotation_2\" />\n+  </bpmn2:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_1\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"132\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"106\" y=\"173\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_SubProcess_1\" bpmnElement=\"SubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"350\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"359\" y=\"107\" width=\"67\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"240\" y=\"182\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"225\" y=\"225\" width=\"67\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_Task_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"350\" y=\"160\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"395\" y=\"196\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"600\" y=\"132\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"593\" y=\"175\" width=\"51\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"120\" y=\"50\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_2_di\" bpmnElement=\"TextAnnotation_2\">\n+        <dc:Bounds x=\"620\" y=\"50\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_1\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"150\" />\n+        <di:waypoint x=\"200\" y=\"150\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"159\" y=\"128\" width=\"24\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_2\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"550\" y=\"150\" />\n+        <di:waypoint x=\"600\" y=\"150\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"565\" y=\"128\" width=\"33\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"BPMNEdge_SequenceFlow_3\" bpmnElement=\"SequenceFlow_3\">\n+        <di:waypoint x=\"276\" y=\"200\" />\n+        <di:waypoint x=\"350\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"170\" y=\"80\" />\n+        <di:waypoint x=\"168\" y=\"150\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Association_2_di\" bpmnElement=\"Association_2\">\n+        <di:waypoint x=\"575\" y=\"150\" />\n+        <di:waypoint x=\"670\" y=\"80\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn2:definitions>`;\n+\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    var originalBounds = { x: 200, y: 100, width: 350, height: 200 };\n+\n+    modeler.importXML(bpmnXML).then(function() {\n+      console.log('BPMN diagram loaded successfully');\n+      logPositions();\n+    }).catch(function(err) {\n+      console.error('Error loading BPMN diagram:', err);\n+    });\n+\n+    function resizeSubProcess() {\n+      var modeling = modeler.get('modeling');\n+      var elementRegistry = modeler.get('elementRegistry');\n+      \n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      \n+      console.log('Before resize:');\n+      logPositions();\n+      \n+      // Make the subprocess wider\n+      modeling.resizeShape(subProcess, { \n+        x: 200, \n+        y: 100, \n+        width: 450,  // increased from 350\n+        height: 200 \n+      });\n+      \n+      console.log('After resize:');\n+      logPositions();\n+    }\n+\n+    function resetSubProcess() {\n+      var modeling = modeler.get('modeling');\n+      var elementRegistry = modeler.get('elementRegistry');\n+      \n+      var subProcess = elementRegistry.get('SubProcess_1');\n+      \n+      modeling.resizeShape(subProcess, originalBounds);\n+      \n+      console.log('After reset:');\n+      logPositions();\n+    }\n+\n+    function logPositions() {\n+      var elementRegistry = modeler.get('elementRegistry');\n+      \n+      var sequenceFlow1 = elementRegistry.get('SequenceFlow_1');\n+      var sequenceFlow2 = elementRegistry.get('SequenceFlow_2');\n+      var association1 = elementRegistry.get('Association_1');\n+      var association2 = elementRegistry.get('Association_2');\n+      \n+      console.log('SequenceFlow_1 waypoints:', sequenceFlow1.waypoints);\n+      console.log('SequenceFlow_2 waypoints:', sequenceFlow2.waypoints);\n+      console.log('Association_1 waypoints:', association1.waypoints);\n+      console.log('Association_2 waypoints:', association2.waypoints);\n+      \n+      if (sequenceFlow1.label) {\n+        console.log('SequenceFlow_1 label position:', { x: sequenceFlow1.label.x, y: sequenceFlow1.label.y });\n+      }\n+      if (sequenceFlow2.label) {\n+        console.log('SequenceFlow_2 label position:', { x: sequenceFlow2.label.x, y: sequenceFlow2.label.y });\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
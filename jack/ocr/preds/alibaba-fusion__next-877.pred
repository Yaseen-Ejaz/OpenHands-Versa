{"instance_id": "alibaba-fusion__next-877", "model_patch": "diff --git a/src/overlay/main.scss b/src/overlay/main.scss\nindex 17c130941..b1231de88 100644\n--- a/src/overlay/main.scss\n+++ b/src/overlay/main.scss\n@@ -4,6 +4,7 @@\n     position: absolute;\n     top: 0;\n     left: 0;\n+    width: 100%;\n \n     .#{$css-prefix}overlay-inner {\n         z-index: 1001;\ndiff --git a/test_inline_content_collapse.html b/test_inline_content_collapse.html\nnew file mode 100644\nindex 000000000..22ffa98fd\n--- /dev/null\n+++ b/test_inline_content_collapse.html\n@@ -0,0 +1,155 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Overlay Inline Content Collapse Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        \n+        .test-container {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+        }\n+        \n+        .inline-content {\n+            display: inline;\n+            background: #f0f0f0;\n+            padding: 5px;\n+            border: 1px solid #999;\n+        }\n+        \n+        .block-content {\n+            display: block;\n+            background: #f0f0f0;\n+            padding: 5px;\n+            border: 1px solid #999;\n+            width: 200px;\n+        }\n+        \n+        /* Simulate the current overlay wrapper styles */\n+        .next-overlay-wrapper {\n+            position: absolute;\n+            top: 0;\n+            left: 0;\n+        }\n+        \n+        /* Test the fix */\n+        .next-overlay-wrapper.fixed {\n+            width: 100%;\n+        }\n+        \n+        .overlay-demo {\n+            width: 300px;\n+            height: 100px;\n+            padding: 10px;\n+            border: 1px solid #999999;\n+            background: #FFFFFF;\n+            box-shadow: 2px 2px 20px rgba(0,0,0,0.15);\n+        }\n+        \n+        .test-button {\n+            margin: 10px;\n+            padding: 10px 20px;\n+            background: #1890ff;\n+            color: white;\n+            border: none;\n+            cursor: pointer;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Overlay Inline Content Collapse Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 1: Inline Content Without Fix (Should Collapse)</h2>\n+        <button class=\"test-button\" id=\"btn1\">Show Overlay with Inline Content</button>\n+        <div id=\"overlay1\" class=\"next-overlay-wrapper\" style=\"display: none; top: 100px; left: 50px;\">\n+            <span class=\"inline-content\">This is inline content that should collapse without width: 100%</span>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 2: Inline Content With Fix (Should Not Collapse)</h2>\n+        <button class=\"test-button\" id=\"btn2\">Show Overlay with Inline Content (Fixed)</button>\n+        <div id=\"overlay2\" class=\"next-overlay-wrapper fixed\" style=\"display: none; top: 200px; left: 50px;\">\n+            <span class=\"inline-content\">This is inline content with width: 100% applied</span>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 3: Block Content (Should Work Fine)</h2>\n+        <button class=\"test-button\" id=\"btn3\">Show Overlay with Block Content</button>\n+        <div id=\"overlay3\" class=\"next-overlay-wrapper\" style=\"display: none; top: 300px; left: 50px;\">\n+            <div class=\"block-content\">This is block content that should work fine</div>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 4: Complex Inline Content</h2>\n+        <button class=\"test-button\" id=\"btn4\">Show Complex Inline Content</button>\n+        <div id=\"overlay4\" class=\"next-overlay-wrapper\" style=\"display: none; top: 400px; left: 50px;\">\n+            <span class=\"overlay-demo\">\n+                <span style=\"display: inline;\">Inline span 1</span>\n+                <span style=\"display: inline;\">Inline span 2</span>\n+                <span style=\"display: inline;\">Inline span 3</span>\n+            </span>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test 5: Complex Inline Content With Fix</h2>\n+        <button class=\"test-button\" id=\"btn5\">Show Complex Inline Content (Fixed)</button>\n+        <div id=\"overlay5\" class=\"next-overlay-wrapper fixed\" style=\"display: none; top: 500px; left: 50px;\">\n+            <span class=\"overlay-demo\">\n+                <span style=\"display: inline;\">Inline span 1</span>\n+                <span style=\"display: inline;\">Inline span 2</span>\n+                <span style=\"display: inline;\">Inline span 3</span>\n+            </span>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Simple toggle functionality for testing\n+        function setupToggle(btnId, overlayId) {\n+            const btn = document.getElementById(btnId);\n+            const overlay = document.getElementById(overlayId);\n+            let visible = false;\n+            \n+            btn.addEventListener('click', function() {\n+                visible = !visible;\n+                overlay.style.display = visible ? 'block' : 'none';\n+                btn.textContent = visible ? 'Hide Overlay' : btn.textContent.replace('Hide', 'Show');\n+            });\n+        }\n+        \n+        setupToggle('btn1', 'overlay1');\n+        setupToggle('btn2', 'overlay2');\n+        setupToggle('btn3', 'overlay3');\n+        setupToggle('btn4', 'overlay4');\n+        setupToggle('btn5', 'overlay5');\n+        \n+        // Log overlay dimensions for debugging\n+        function logOverlayDimensions() {\n+            for (let i = 1; i <= 5; i++) {\n+                const overlay = document.getElementById(`overlay${i}`);\n+                if (overlay.style.display !== 'none') {\n+                    const rect = overlay.getBoundingClientRect();\n+                    console.log(`Overlay ${i} dimensions:`, {\n+                        width: rect.width,\n+                        height: rect.height,\n+                        hasFixedClass: overlay.classList.contains('fixed')\n+                    });\n+                }\n+            }\n+        }\n+        \n+        // Check dimensions every 2 seconds when overlays are visible\n+        setInterval(logOverlayDimensions, 2000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
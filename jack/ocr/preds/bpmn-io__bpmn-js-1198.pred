{"instance_id": "bpmn-io__bpmn-js-1198", "model_patch": "diff --git a/lib/features/modeling/behavior/DropOnFlowBehavior.js b/lib/features/modeling/behavior/DropOnFlowBehavior.js\nindex a08947d2..205ae79f 100644\n--- a/lib/features/modeling/behavior/DropOnFlowBehavior.js\n+++ b/lib/features/modeling/behavior/DropOnFlowBehavior.js\n@@ -15,6 +15,11 @@ import {\n   getApproxIntersection\n } from 'diagram-js/lib/util/LineIntersection';\n \n+import {\n+  getBusinessObject,\n+  is\n+} from '../../../util/ModelUtil';\n+\n \n export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n \n@@ -72,6 +77,9 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n     source = targetFlow.source;\n     target = targetFlow.target;\n \n+    // Check if the target flow is a default flow before modifying connections\n+    var isDefaultFlow = isDefaultSequenceFlow(targetFlow, source);\n+\n     if (bpmnRules.canConnect(source, shape, targetFlow)) {\n \n       // reconnect source -> inserted shape\n@@ -95,6 +103,15 @@ export default function DropOnFlowBehavior(eventBus, bpmnRules, modeling) {\n       }\n     }\n \n+    // Preserve default flow reference: if the original flow was a default flow,\n+    // update the source gateway to point to the outgoing connection that maintains\n+    // the path to the original target\n+    if (isDefaultFlow && outgoingConnection) {\n+      modeling.updateProperties(source, {\n+        'default': getBusinessObject(outgoingConnection)\n+      });\n+    }\n+\n     var duplicateConnections = [].concat(\n \n       incomingConnection && filter(oldIncoming, function(connection) {\n@@ -209,3 +226,14 @@ function copy(obj) {\n   return assign({}, obj);\n }\n \n+function isDefaultSequenceFlow(connection, source) {\n+  if (!is(connection, 'bpmn:SequenceFlow')) {\n+    return false;\n+  }\n+\n+  var sourceBo = getBusinessObject(source),\n+      sequenceFlow = getBusinessObject(connection);\n+\n+  return sourceBo.get('default') === sequenceFlow;\n+}\n+\ndiff --git a/test/spec/features/modeling/behavior/DefaultFlowBugSpec.js b/test/spec/features/modeling/behavior/DefaultFlowBugSpec.js\nnew file mode 100644\nindex 00000000..8587ebd1\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/DefaultFlowBugSpec.js\n@@ -0,0 +1,177 @@\n+var {\n+  bootstrapModeler,\n+  inject\n+} = require('test/TestHelper');\n+\n+var modelingModule = require('lib/features/modeling');\n+var coreModule = require('lib/core');\n+\n+describe('Default Flow Bug Reproduction', function() {\n+\n+  var testModules = [ coreModule, modelingModule ];\n+\n+  // Create a simple BPMN with exclusive gateway and default flow\n+  var processDiagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"start\">\n+      <bpmn:outgoing>flow-to-gateway</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:exclusiveGateway id=\"exclusive-gateway\" default=\"flow-default\">\n+      <bpmn:incoming>flow-to-gateway</bpmn:incoming>\n+      <bpmn:outgoing>flow-default</bpmn:outgoing>\n+      <bpmn:outgoing>flow-normal</bpmn:outgoing>\n+    </bpmn:exclusiveGateway>\n+    <bpmn:task id=\"task-default\">\n+      <bpmn:incoming>flow-default</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:task id=\"task-normal\">\n+      <bpmn:incoming>flow-normal</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-to-gateway\" sourceRef=\"start\" targetRef=\"exclusive-gateway\" />\n+    <bpmn:sequenceFlow id=\"flow-default\" sourceRef=\"exclusive-gateway\" targetRef=\"task-default\" />\n+    <bpmn:sequenceFlow id=\"flow-normal\" sourceRef=\"exclusive-gateway\" targetRef=\"task-normal\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"start\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"ExclusiveGateway_1_di\" bpmnElement=\"exclusive-gateway\" isMarkerVisible=\"true\">\n+        <dc:Bounds x=\"200\" y=\"93\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"task-default\">\n+        <dc:Bounds x=\"350\" y=\"78\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"task-normal\">\n+        <dc:Bounds x=\"350\" y=\"200\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"flow-to-gateway\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"136\" y=\"118\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"200\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"flow-default\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"250\" y=\"118\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_3_di\" bpmnElement=\"flow-normal\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"225\" y=\"143\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"225\" y=\"240\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350\" y=\"240\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+  var gateway,\n+      defaultFlow,\n+      normalFlow;\n+\n+  beforeEach(inject(function(elementRegistry) {\n+    gateway = elementRegistry.get('exclusive-gateway');\n+    defaultFlow = elementRegistry.get('flow-default');\n+    normalFlow = elementRegistry.get('flow-normal');\n+  }));\n+\n+  it('should preserve default attribute when adding Timer Intermediate Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+    \n+    // Verify initial state - gateway should have default attribute\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    \n+    // Create a Timer Intermediate Catch Event\n+    var timerEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:TimerEventDefinition'\n+    });\n+    \n+    // Calculate position on the normal flow (non-default flow)\n+    var normalFlowMid = {\n+      x: (normalFlow.waypoints[0].x + normalFlow.waypoints[1].x) / 2,\n+      y: (normalFlow.waypoints[0].y + normalFlow.waypoints[1].y) / 2\n+    };\n+    \n+    // Create the timer event on the normal flow\n+    modeling.createShape(timerEvent, normalFlowMid, normalFlow);\n+    \n+    // BUG: The default attribute should still be present on the gateway\n+    // but it gets removed incorrectly\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+  }));\n+\n+  it('should preserve default attribute when adding Message Intermediate Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+    \n+    // Verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    \n+    // Create a Message Intermediate Catch Event\n+    var messageEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:MessageEventDefinition'\n+    });\n+    \n+    // Calculate position on the normal flow\n+    var normalFlowMid = {\n+      x: (normalFlow.waypoints[0].x + normalFlow.waypoints[1].x) / 2,\n+      y: (normalFlow.waypoints[0].y + normalFlow.waypoints[1].y) / 2\n+    };\n+    \n+    // Create the message event on the normal flow\n+    modeling.createShape(messageEvent, normalFlowMid, normalFlow);\n+    \n+    // The default attribute should still be present\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+  }));\n+\n+  it('should preserve default attribute when adding Signal Intermediate Catch Event to non-default flow', inject(function(modeling, elementFactory) {\n+    \n+    // Verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    \n+    // Create a Signal Intermediate Catch Event\n+    var signalEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:SignalEventDefinition'\n+    });\n+    \n+    // Calculate position on the normal flow\n+    var normalFlowMid = {\n+      x: (normalFlow.waypoints[0].x + normalFlow.waypoints[1].x) / 2,\n+      y: (normalFlow.waypoints[0].y + normalFlow.waypoints[1].y) / 2\n+    };\n+    \n+    // Create the signal event on the normal flow\n+    modeling.createShape(signalEvent, normalFlowMid, normalFlow);\n+    \n+    // The default attribute should still be present\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+  }));\n+\n+  it('should preserve default attribute when adding event to default flow itself', inject(function(modeling, elementFactory) {\n+    \n+    // Verify initial state\n+    expect(gateway.businessObject.default).to.eql(defaultFlow.businessObject);\n+    \n+    // Create a Timer Intermediate Catch Event\n+    var timerEvent = elementFactory.createShape({\n+      type: 'bpmn:IntermediateCatchEvent',\n+      eventDefinitionType: 'bpmn:TimerEventDefinition'\n+    });\n+    \n+    // Calculate position on the default flow\n+    var defaultFlowMid = {\n+      x: (defaultFlow.waypoints[0].x + defaultFlow.waypoints[1].x) / 2,\n+      y: (defaultFlow.waypoints[0].y + defaultFlow.waypoints[1].y) / 2\n+    };\n+    \n+    // Create the timer event on the default flow\n+    modeling.createShape(timerEvent, defaultFlowMid, defaultFlow);\n+    \n+    // The default attribute should still be present and point to the new connection\n+    // from gateway to the timer event\n+    expect(gateway.businessObject.default).to.not.be.null;\n+    expect(gateway.businessObject.default).to.not.be.undefined;\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 00000000..b4e9a17d\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,150 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Default Flow Bug Fix Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; }\n+        .controls { margin: 10px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .status { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Default Flow Bug Fix Test</h1>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"createDiagram()\">Create Test Diagram</button>\n+        <button onclick=\"addTimerEvent()\">Add Timer Event to Non-Default Flow</button>\n+        <button onclick=\"checkDefaultAttribute()\">Check Default Attribute</button>\n+    </div>\n+    \n+    <div id=\"canvas\"></div>\n+    \n+    <div class=\"status\" id=\"status\">\n+        Ready to test. Click \"Create Test Diagram\" to start.\n+    </div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        let modeler;\n+        let gateway, defaultFlow, normalFlow;\n+        \n+        const testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"start\">\n+      <bpmn:outgoing>flow-to-gateway</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:exclusiveGateway id=\"exclusive-gateway\" default=\"flow-default\">\n+      <bpmn:incoming>flow-to-gateway</bpmn:incoming>\n+      <bpmn:outgoing>flow-default</bpmn:outgoing>\n+      <bpmn:outgoing>flow-normal</bpmn:outgoing>\n+    </bpmn:exclusiveGateway>\n+    <bpmn:task id=\"task-default\">\n+      <bpmn:incoming>flow-default</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:task id=\"task-normal\">\n+      <bpmn:incoming>flow-normal</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"flow-to-gateway\" sourceRef=\"start\" targetRef=\"exclusive-gateway\" />\n+    <bpmn:sequenceFlow id=\"flow-default\" sourceRef=\"exclusive-gateway\" targetRef=\"task-default\" />\n+    <bpmn:sequenceFlow id=\"flow-normal\" sourceRef=\"exclusive-gateway\" targetRef=\"task-normal\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"start\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"ExclusiveGateway_1_di\" bpmnElement=\"exclusive-gateway\" isMarkerVisible=\"true\">\n+        <dc:Bounds x=\"200\" y=\"93\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"task-default\">\n+        <dc:Bounds x=\"350\" y=\"78\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"task-normal\">\n+        <dc:Bounds x=\"350\" y=\"200\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"flow-to-gateway\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"136\" y=\"118\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"200\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"flow-default\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"250\" y=\"118\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_3_di\" bpmnElement=\"flow-normal\">\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"225\" y=\"143\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"225\" y=\"240\" />\n+        <di:waypoint xsi:type=\"dc:Point\" x=\"350\" y=\"240\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        function createDiagram() {\n+            modeler = new BpmnJS({\n+                container: '#canvas'\n+            });\n+            \n+            modeler.importXML(testXML).then(() => {\n+                const elementRegistry = modeler.get('elementRegistry');\n+                gateway = elementRegistry.get('exclusive-gateway');\n+                defaultFlow = elementRegistry.get('flow-default');\n+                normalFlow = elementRegistry.get('flow-normal');\n+                \n+                updateStatus('Diagram created. Gateway default attribute: ' + \n+                    (gateway.businessObject.default ? gateway.businessObject.default.id : 'null'));\n+            }).catch(err => {\n+                updateStatus('Error creating diagram: ' + err.message);\n+            });\n+        }\n+        \n+        function addTimerEvent() {\n+            if (!modeler) {\n+                updateStatus('Please create diagram first');\n+                return;\n+            }\n+            \n+            const modeling = modeler.get('modeling');\n+            const elementFactory = modeler.get('elementFactory');\n+            \n+            // Create Timer Intermediate Catch Event\n+            const timerEvent = elementFactory.createShape({\n+                type: 'bpmn:IntermediateCatchEvent',\n+                eventDefinitionType: 'bpmn:TimerEventDefinition'\n+            });\n+            \n+            // Calculate position on normal flow\n+            const normalFlowMid = {\n+                x: (normalFlow.waypoints[0].x + normalFlow.waypoints[1].x) / 2,\n+                y: (normalFlow.waypoints[0].y + normalFlow.waypoints[1].y) / 2\n+            };\n+            \n+            // Create the timer event on the normal flow\n+            modeling.createShape(timerEvent, normalFlowMid, normalFlow);\n+            \n+            updateStatus('Timer event added to non-default flow');\n+        }\n+        \n+        function checkDefaultAttribute() {\n+            if (!gateway) {\n+                updateStatus('Please create diagram first');\n+                return;\n+            }\n+            \n+            const defaultAttr = gateway.businessObject.default;\n+            if (defaultAttr) {\n+                updateStatus('SUCCESS: Default attribute preserved! Points to: ' + defaultAttr.id);\n+            } else {\n+                updateStatus('FAILURE: Default attribute was removed!');\n+            }\n+        }\n+        \n+        function updateStatus(message) {\n+            document.getElementById('status').textContent = message;\n+            console.log(message);\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 00000000..c26df3d2\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,20 @@\n+// Simple test to verify the default flow bug fix\n+// This test can be run in a browser environment\n+\n+console.log('Testing Default Flow Bug Fix...');\n+\n+// Test will be implemented using the browser environment\n+// since the karma test runner has issues\n+\n+function testDefaultFlowPreservation() {\n+  console.log('Test: Default flow preservation when adding intermediate catch events');\n+  \n+  // This test would:\n+  // 1. Create a BPMN diagram with exclusive gateway and default flow\n+  // 2. Add a Timer Intermediate Catch Event to the non-default flow\n+  // 3. Verify that the default attribute is preserved on the gateway\n+  \n+  console.log('Test setup complete - manual verification needed in browser');\n+}\n+\n+testDefaultFlowPreservation();\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
{"instance_id": "bpmn-io__bpmn-js-1083", "model_patch": "diff --git a/lib/features/snapping/BpmnCreateMoveSnapping.js b/lib/features/snapping/BpmnCreateMoveSnapping.js\nindex 56252d4f..83f369cf 100644\n--- a/lib/features/snapping/BpmnCreateMoveSnapping.js\n+++ b/lib/features/snapping/BpmnCreateMoveSnapping.js\n@@ -25,6 +25,8 @@ var HIGH_PRIORITY = 1500;\n  */\n export default function BpmnCreateMoveSnapping(bpmnRules, eventBus, injector) {\n   injector.invoke(CreateMoveSnapping, this);\n+  \n+  this._connectionDocking = injector.get('connectionDocking', false);\n \n   // creating first participant\n   eventBus.on([ 'create.move', 'create.end' ], HIGH_PRIORITY, setSnappedIfConstrained);\n@@ -80,6 +82,9 @@ BpmnCreateMoveSnapping.prototype.addSnapTargetPoints = function(snapPoints, shap\n     snapPoints = this.addSnapTargetPoints(snapPoints, shape, target.parent);\n   }\n \n+  // add docking points of connected elements for snapping\n+  this.addConnectionDockingPoints(snapPoints, shape);\n+\n   return snapPoints;\n };\n \n@@ -92,6 +97,30 @@ BpmnCreateMoveSnapping.prototype.getSnapTargets = function(shape, target) {\n     });\n };\n \n+BpmnCreateMoveSnapping.prototype.addConnectionDockingPoints = function(snapPoints, shape) {\n+  var self = this;\n+  var connections = [].concat(shape.incoming || [], shape.outgoing || []);\n+  \n+  if (!self._connectionDocking) {\n+    return;\n+  }\n+  \n+  connections.forEach(function(connection) {\n+    // Get docking points for the connection\n+    var sourceDocking = self._connectionDocking.getDockingPoint(connection, connection.source, true);\n+    var targetDocking = self._connectionDocking.getDockingPoint(connection, connection.target, false);\n+    \n+    // Add docking points as snap targets\n+    if (sourceDocking && sourceDocking.actual) {\n+      snapPoints.add('mid', sourceDocking.actual);\n+    }\n+    \n+    if (targetDocking && targetDocking.actual) {\n+      snapPoints.add('mid', targetDocking.actual);\n+    }\n+  });\n+};\n+\n // helpers //////////\n \n function snapBoundaryEvent(event, target) {\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..e536b864\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,8 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [03/Jun/2026 20:55:51] \"GET /test_docking_snapping.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 20:55:51] code 404, message File not found\n+127.0.0.1 - - [03/Jun/2026 20:55:51] \"GET /node_modules/bpmn-js/dist/bpmn-modeler.development.js HTTP/1.1\" 404 -\n+127.0.0.1 - - [03/Jun/2026 20:56:46] \"GET /test_docking_snapping.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 20:56:46] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [03/Jun/2026 20:58:24] \"GET /test_docking_snapping.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [03/Jun/2026 20:58:24] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test_docking_snapping.html b/test_docking_snapping.html\nnew file mode 100644\nindex 00000000..9952c128\n--- /dev/null\n+++ b/test_docking_snapping.html\n@@ -0,0 +1,106 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js Docking Snapping Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    #canvas {\n+      border: 1px solid #ccc;\n+      height: 600px;\n+      width: 100%;\n+    }\n+    .info {\n+      margin-bottom: 20px;\n+      padding: 10px;\n+      background-color: #f0f0f0;\n+      border-radius: 5px;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <div class=\"info\">\n+    <h2>Docking Snapping Test</h2>\n+    <p>This test reproduces the docking snapping issue described in the GitHub issue.</p>\n+    <p><strong>Instructions:</strong></p>\n+    <ol>\n+      <li>Try to move the connected elements (events, tasks)</li>\n+      <li>Observe if they snap to docking points of their connections</li>\n+      <li>In v3.x, elements should snap to connection docking points when moved</li>\n+      <li>In v4-beta, this snapping is missing</li>\n+    </ol>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    // Test BPMN diagram with connected elements\n+    var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"78\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"118\" />\n+        <di:waypoint x=\"200\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"118\" />\n+        <di:waypoint x=\"350\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    // Initialize BPMN.js modeler\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    // Import the diagram\n+    modeler.importXML(bpmnXML, function(err) {\n+      if (err) {\n+        console.error('Error importing BPMN diagram:', err);\n+      } else {\n+        console.log('BPMN diagram imported successfully');\n+        \n+        // Add some debugging to observe snapping behavior\n+        var eventBus = modeler.get('eventBus');\n+        \n+        eventBus.on('shape.move.move', function(event) {\n+          console.log('Shape move:', event.shape.id, 'to', event.x, event.y);\n+        });\n+        \n+        eventBus.on('shape.move.end', function(event) {\n+          console.log('Shape move end:', event.shape.id, 'final position', event.x, event.y);\n+        });\n+      }\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
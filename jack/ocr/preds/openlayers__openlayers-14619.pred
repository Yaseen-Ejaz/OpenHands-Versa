{"instance_id": "openlayers__openlayers-14619", "model_patch": "diff --git a/src/ol/style/Icon.js b/src/ol/style/Icon.js\nindex 4ab59049f..8115933a6 100644\n--- a/src/ol/style/Icon.js\n+++ b/src/ol/style/Icon.js\n@@ -233,6 +233,12 @@ class Icon extends ImageStyle {\n      */\n     this.height_ = options.height;\n \n+    /**\n+     * @private\n+     * @type {boolean}\n+     */\n+    this.widthHeightFromScale_ = false;\n+\n     /**\n      * Recalculate the scale if width or height were given.\n      */\n@@ -257,8 +263,17 @@ class Icon extends ImageStyle {\n   clone() {\n     let scale = this.getScale();\n     scale = Array.isArray(scale) ? scale.slice() : scale;\n-    // if either width or height are defined, do not pass scale.\n-    if (this.width_ !== undefined || this.height_ !== undefined) {\n+    let width = this.width_;\n+    let height = this.height_;\n+\n+    // If width/height were set from scale (not explicitly by user),\n+    // preserve the original scale and don't pass width/height to avoid\n+    // converting the scale to an array in the constructor\n+    if (this.widthHeightFromScale_) {\n+      width = undefined;\n+      height = undefined;\n+    } else if (this.width_ !== undefined || this.height_ !== undefined) {\n+      // if either width or height are explicitly defined by user, do not pass scale.\n       scale = undefined;\n     }\n     return new Icon({\n@@ -282,8 +297,8 @@ class Icon extends ImageStyle {\n       src: this.getSrc(),\n       displacement: this.getDisplacement().slice(),\n       declutterMode: this.getDeclutterMode(),\n-      width: this.width_,\n-      height: this.height_,\n+      width: width,\n+      height: height,\n     });\n   }\n \n@@ -507,6 +522,7 @@ class Icon extends ImageStyle {\n    */\n   setWidth(width) {\n     this.width_ = width;\n+    this.widthHeightFromScale_ = false; // Explicitly set by user\n     this.updateScaleFromWidthAndHeight(width, this.height_);\n   }\n \n@@ -517,6 +533,7 @@ class Icon extends ImageStyle {\n    */\n   setHeight(height) {\n     this.height_ = height;\n+    this.widthHeightFromScale_ = false; // Explicitly set by user\n     this.updateScaleFromWidthAndHeight(this.width_, height);\n   }\n \n@@ -534,10 +551,12 @@ class Icon extends ImageStyle {\n       const widthScale = Array.isArray(scale) ? scale[0] : scale;\n       if (widthScale !== undefined) {\n         this.width_ = widthScale * image.width;\n+        this.widthHeightFromScale_ = true;\n       }\n       const heightScale = Array.isArray(scale) ? scale[1] : scale;\n       if (heightScale !== undefined) {\n         this.height_ = heightScale * image.height;\n+        this.widthHeightFromScale_ = true;\n       }\n     }\n   }\ndiff --git a/test/browser/spec/ol/style/icon.test.js b/test/browser/spec/ol/style/icon.test.js\nindex 2516763a1..4de9fbfd7 100644\n--- a/test/browser/spec/ol/style/icon.test.js\n+++ b/test/browser/spec/ol/style/icon.test.js\n@@ -171,6 +171,32 @@ describe('ol.style.Icon', function () {\n       expect(original.getHeight()).to.eql(clone.getHeight());\n       expect(original.getScale()).to.eql(clone.getScale());\n     });\n+\n+    it('preserves number scale type when cloning after setScale', function () {\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 10;\n+      canvas.height = 10;\n+      \n+      const original = new Icon({\n+        img: canvas,\n+        imgSize: [10, 10],\n+        scale: 1,\n+      });\n+      \n+      // Call setScale with a number - this used to cause the bug\n+      original.setScale(2.5);\n+      \n+      // Verify original scale is still a number\n+      expect(typeof original.getScale()).to.be('number');\n+      expect(original.getScale()).to.be(2.5);\n+      \n+      // Clone the icon\n+      const clone = original.clone();\n+      \n+      // Verify cloned scale is also a number (this was the bug)\n+      expect(typeof clone.getScale()).to.be('number');\n+      expect(clone.getScale()).to.be(2.5);\n+    });\n   });\n \n   describe('#getAnchor', function () {\ndiff --git a/test_bug.html b/test_bug.html\nnew file mode 100644\nindex 000000000..f5221d20e\n--- /dev/null\n+++ b/test_bug.html\n@@ -0,0 +1,88 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Clone Scale Bug Test</title>\n+</head>\n+<body>\n+    <h1>Icon Clone Scale Bug Test</h1>\n+    <div id=\"output\"></div>\n+    \n+    <script type=\"module\">\n+        import Icon from './src/ol/style/Icon.js';\n+        \n+        const output = document.getElementById('output');\n+        \n+        function log(message) {\n+            output.innerHTML += message + '<br>';\n+            console.log(message);\n+        }\n+        \n+        log('=== Testing setScale + clone bug ===');\n+        \n+        // Create a canvas element\n+        const canvas = document.createElement('canvas');\n+        canvas.width = 10;\n+        canvas.height = 10;\n+        \n+        try {\n+            log('Test: setScale(number) + clone issue');\n+            \n+            const originalIcon = new Icon({\n+                img: canvas,\n+                imgSize: [10, 10],\n+                scale: 1  // Start with number scale\n+            });\n+            \n+            log('1. Original icon after creation:');\n+            log('   Scale: ' + JSON.stringify(originalIcon.getScale()));\n+            log('   Scale type: ' + typeof originalIcon.getScale());\n+            log('   Scale is array: ' + Array.isArray(originalIcon.getScale()));\n+            log('   Width: ' + originalIcon.getWidth());\n+            log('   Height: ' + originalIcon.getHeight());\n+            \n+            // Call setScale with a number - this should trigger the bug\n+            originalIcon.setScale(2.5);\n+            \n+            log('');\n+            log('2. Original icon after setScale(2.5):');\n+            log('   Scale: ' + JSON.stringify(originalIcon.getScale()));\n+            log('   Scale type: ' + typeof originalIcon.getScale());\n+            log('   Scale is array: ' + Array.isArray(originalIcon.getScale()));\n+            log('   Width: ' + originalIcon.getWidth());\n+            log('   Height: ' + originalIcon.getHeight());\n+            \n+            // Now clone - this should show the bug\n+            const clonedIcon = originalIcon.clone();\n+            \n+            log('');\n+            log('3. Cloned icon:');\n+            log('   Scale: ' + JSON.stringify(clonedIcon.getScale()));\n+            log('   Scale type: ' + typeof clonedIcon.getScale());\n+            log('   Scale is array: ' + Array.isArray(clonedIcon.getScale()));\n+            log('   Width: ' + clonedIcon.getWidth());\n+            log('   Height: ' + clonedIcon.getHeight());\n+            \n+            // Check if the bug exists\n+            const originalIsNumber = typeof originalIcon.getScale() === 'number';\n+            const clonedIsArray = Array.isArray(clonedIcon.getScale());\n+            \n+            log('');\n+            if (originalIsNumber && clonedIsArray) {\n+                log('\u274c BUG CONFIRMED: Original scale is number but cloned scale is array!');\n+                log('   This is the exact issue described in the bug report.');\n+            } else if (originalIsNumber && typeof clonedIcon.getScale() === 'number') {\n+                log('\u2705 GOOD: Both original and cloned scales are numbers');\n+            } else {\n+                log('\u26a0\ufe0f  UNEXPECTED: Original scale is not a number');\n+            }\n+            \n+        } catch (error) {\n+            log('Error in test: ' + error.message);\n+            console.error('Error in test:', error);\n+        }\n+        \n+        log('');\n+        log('=== Test Complete ===');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_verification.html b/test_fix_verification.html\nnew file mode 100644\nindex 000000000..15a612d56\n--- /dev/null\n+++ b/test_fix_verification.html\n@@ -0,0 +1,171 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Clone Scale Bug Fix Verification</title>\n+</head>\n+<body>\n+    <h1>Icon Clone Scale Bug Fix Verification</h1>\n+    <div id=\"output\"></div>\n+    \n+    <script type=\"module\">\n+        import Icon from './src/ol/style/Icon.js';\n+        \n+        const output = document.getElementById('output');\n+        \n+        function log(message) {\n+            output.innerHTML += message + '<br>';\n+            console.log(message);\n+        }\n+        \n+        function runTest(testName, testFn) {\n+            log('<br><strong>' + testName + '</strong>');\n+            try {\n+                testFn();\n+                log('\u2705 PASSED');\n+            } catch (error) {\n+                log('\u274c FAILED: ' + error.message);\n+                console.error(error);\n+            }\n+        }\n+        \n+        log('=== Icon Clone Scale Bug Fix Verification ===');\n+        \n+        // Create a canvas element\n+        const canvas = document.createElement('canvas');\n+        canvas.width = 10;\n+        canvas.height = 10;\n+        \n+        // Test 1: setScale(number) + clone should preserve number type\n+        runTest('Test 1: setScale(number) + clone preserves number type', () => {\n+            const originalIcon = new Icon({\n+                img: canvas,\n+                imgSize: [10, 10],\n+                scale: 1\n+            });\n+            \n+            // Call setScale with a number\n+            originalIcon.setScale(2.5);\n+            \n+            // Verify original scale is still a number\n+            if (typeof originalIcon.getScale() !== 'number') {\n+                throw new Error('Original scale should be number, got ' + typeof originalIcon.getScale());\n+            }\n+            if (originalIcon.getScale() !== 2.5) {\n+                throw new Error('Original scale should be 2.5, got ' + originalIcon.getScale());\n+            }\n+            \n+            // Clone the icon\n+            const clonedIcon = originalIcon.clone();\n+            \n+            // Verify cloned scale is also a number (this was the bug)\n+            if (typeof clonedIcon.getScale() !== 'number') {\n+                throw new Error('Cloned scale should be number, got ' + typeof clonedIcon.getScale() + ' with value ' + JSON.stringify(clonedIcon.getScale()));\n+            }\n+            if (clonedIcon.getScale() !== 2.5) {\n+                throw new Error('Cloned scale should be 2.5, got ' + clonedIcon.getScale());\n+            }\n+            \n+            log('  Original scale: ' + originalIcon.getScale() + ' (type: ' + typeof originalIcon.getScale() + ')');\n+            log('  Cloned scale: ' + clonedIcon.getScale() + ' (type: ' + typeof clonedIcon.getScale() + ')');\n+        });\n+        \n+        // Test 2: setScale(array) + clone should preserve array type\n+        runTest('Test 2: setScale(array) + clone preserves array type', () => {\n+            const originalIcon = new Icon({\n+                img: canvas,\n+                imgSize: [10, 10],\n+                scale: 1\n+            });\n+            \n+            // Call setScale with an array\n+            originalIcon.setScale([2.0, 3.0]);\n+            \n+            // Verify original scale is an array\n+            if (!Array.isArray(originalIcon.getScale())) {\n+                throw new Error('Original scale should be array, got ' + typeof originalIcon.getScale());\n+            }\n+            \n+            // Clone the icon\n+            const clonedIcon = originalIcon.clone();\n+            \n+            // Verify cloned scale is also an array\n+            if (!Array.isArray(clonedIcon.getScale())) {\n+                throw new Error('Cloned scale should be array, got ' + typeof clonedIcon.getScale());\n+            }\n+            \n+            const originalScale = originalIcon.getScale();\n+            const clonedScale = clonedIcon.getScale();\n+            if (originalScale[0] !== clonedScale[0] || originalScale[1] !== clonedScale[1]) {\n+                throw new Error('Cloned scale values should match original');\n+            }\n+            \n+            log('  Original scale: [' + originalScale.join(', ') + ']');\n+            log('  Cloned scale: [' + clonedScale.join(', ') + ']');\n+        });\n+        \n+        // Test 3: Explicit width/height should still work as before\n+        runTest('Test 3: Explicit width/height behavior unchanged', () => {\n+            const originalIcon = new Icon({\n+                img: canvas,\n+                imgSize: [10, 10],\n+                width: 20,\n+                height: 30\n+            });\n+            \n+            // Clone the icon\n+            const clonedIcon = originalIcon.clone();\n+            \n+            // Both should have array scales due to explicit width/height\n+            if (!Array.isArray(originalIcon.getScale())) {\n+                throw new Error('Original scale should be array when width/height set');\n+            }\n+            if (!Array.isArray(clonedIcon.getScale())) {\n+                throw new Error('Cloned scale should be array when width/height set');\n+            }\n+            \n+            // Width and height should be preserved\n+            if (clonedIcon.getWidth() !== 20) {\n+                throw new Error('Cloned width should be 20, got ' + clonedIcon.getWidth());\n+            }\n+            if (clonedIcon.getHeight() !== 30) {\n+                throw new Error('Cloned height should be 30, got ' + clonedIcon.getHeight());\n+            }\n+            \n+            log('  Original scale: [' + originalIcon.getScale().join(', ') + ']');\n+            log('  Cloned scale: [' + clonedIcon.getScale().join(', ') + ']');\n+            log('  Width: ' + clonedIcon.getWidth() + ', Height: ' + clonedIcon.getHeight());\n+        });\n+        \n+        // Test 4: setWidth/setHeight should reset the scale tracking\n+        runTest('Test 4: setWidth/setHeight resets scale tracking', () => {\n+            const originalIcon = new Icon({\n+                img: canvas,\n+                imgSize: [10, 10],\n+                scale: 2.5\n+            });\n+            \n+            // First verify it's a number\n+            if (typeof originalIcon.getScale() !== 'number') {\n+                throw new Error('Initial scale should be number');\n+            }\n+            \n+            // Set width explicitly - this should change behavior\n+            originalIcon.setWidth(25);\n+            \n+            // Clone the icon\n+            const clonedIcon = originalIcon.clone();\n+            \n+            // Now both should have array scales because width was explicitly set\n+            if (!Array.isArray(clonedIcon.getScale())) {\n+                throw new Error('Cloned scale should be array after explicit setWidth');\n+            }\n+            \n+            log('  After setWidth(25):');\n+            log('  Original scale: ' + JSON.stringify(originalIcon.getScale()));\n+            log('  Cloned scale: ' + JSON.stringify(clonedIcon.getScale()));\n+        });\n+        \n+        log('<br>=== All Tests Complete ===');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_icon_clone_scale.js b/test_icon_clone_scale.js\nnew file mode 100644\nindex 000000000..c030b5203\n--- /dev/null\n+++ b/test_icon_clone_scale.js\n@@ -0,0 +1,120 @@\n+/**\n+ * Test file to reproduce the Icon clone scale issue\n+ * This test demonstrates the problem where cloning an Icon with a number scale\n+ * results in an array scale instead of preserving the original number type.\n+ */\n+\n+// Import required modules\n+import Icon from './src/ol/style/Icon.js';\n+\n+console.log('=== Icon Clone Scale Issue Test ===\\n');\n+\n+// Test 1: Create an Icon with number scale and clone it\n+console.log('Test 1: Icon with number scale');\n+try {\n+  // Create an icon with a number scale (not width/height)\n+  const originalIcon = new Icon({\n+    src: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==', // 1x1 transparent PNG\n+    scale: 2.5  // This should be a number\n+  });\n+\n+  console.log('Original icon scale:', originalIcon.getScale());\n+  console.log('Original icon scale type:', typeof originalIcon.getScale());\n+  console.log('Original icon scale is array:', Array.isArray(originalIcon.getScale()));\n+\n+  // Clone the icon\n+  const clonedIcon = originalIcon.clone();\n+\n+  console.log('\\nCloned icon scale:', clonedIcon.getScale());\n+  console.log('Cloned icon scale type:', typeof clonedIcon.getScale());\n+  console.log('Cloned icon scale is array:', Array.isArray(clonedIcon.getScale()));\n+\n+  // Check if the issue exists\n+  const originalIsNumber = typeof originalIcon.getScale() === 'number';\n+  const clonedIsNumber = typeof clonedIcon.getScale() === 'number';\n+  \n+  if (originalIsNumber && !clonedIsNumber) {\n+    console.log('\\n\u274c BUG CONFIRMED: Original scale is number but cloned scale is not!');\n+  } else if (originalIsNumber && clonedIsNumber) {\n+    console.log('\\n\u2705 GOOD: Both original and cloned scales are numbers');\n+  } else {\n+    console.log('\\n\u26a0\ufe0f  UNEXPECTED: Original scale is not a number');\n+  }\n+\n+} catch (error) {\n+  console.error('Error in Test 1:', error);\n+}\n+\n+console.log('\\n' + '='.repeat(50) + '\\n');\n+\n+// Test 2: Create an Icon with array scale and clone it\n+console.log('Test 2: Icon with array scale');\n+try {\n+  const originalIcon2 = new Icon({\n+    src: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==',\n+    scale: [2.0, 3.0]  // This should be an array\n+  });\n+\n+  console.log('Original icon scale:', originalIcon2.getScale());\n+  console.log('Original icon scale type:', typeof originalIcon2.getScale());\n+  console.log('Original icon scale is array:', Array.isArray(originalIcon2.getScale()));\n+\n+  const clonedIcon2 = originalIcon2.clone();\n+\n+  console.log('\\nCloned icon scale:', clonedIcon2.getScale());\n+  console.log('Cloned icon scale type:', typeof clonedIcon2.getScale());\n+  console.log('Cloned icon scale is array:', Array.isArray(clonedIcon2.getScale()));\n+\n+  // Check if arrays are preserved correctly\n+  const originalIsArray = Array.isArray(originalIcon2.getScale());\n+  const clonedIsArray = Array.isArray(clonedIcon2.getScale());\n+  \n+  if (originalIsArray && clonedIsArray) {\n+    console.log('\\n\u2705 GOOD: Both original and cloned scales are arrays');\n+  } else {\n+    console.log('\\n\u274c ISSUE: Array scale not preserved correctly');\n+  }\n+\n+} catch (error) {\n+  console.error('Error in Test 2:', error);\n+}\n+\n+console.log('\\n' + '='.repeat(50) + '\\n');\n+\n+// Test 3: Test with setScale method after creation\n+console.log('Test 3: Icon with setScale method');\n+try {\n+  const originalIcon3 = new Icon({\n+    src: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=='\n+  });\n+\n+  // Set scale using setScale method\n+  originalIcon3.setScale(1.8);\n+\n+  console.log('Original icon scale after setScale(1.8):', originalIcon3.getScale());\n+  console.log('Original icon scale type:', typeof originalIcon3.getScale());\n+  console.log('Original icon scale is array:', Array.isArray(originalIcon3.getScale()));\n+\n+  const clonedIcon3 = originalIcon3.clone();\n+\n+  console.log('\\nCloned icon scale:', clonedIcon3.getScale());\n+  console.log('Cloned icon scale type:', typeof clonedIcon3.getScale());\n+  console.log('Cloned icon scale is array:', Array.isArray(clonedIcon3.getScale()));\n+\n+  // Check if the issue exists after setScale\n+  const originalIsNumber = typeof originalIcon3.getScale() === 'number';\n+  const clonedIsNumber = typeof clonedIcon3.getScale() === 'number';\n+  \n+  if (originalIsNumber && !clonedIsNumber) {\n+    console.log('\\n\u274c BUG CONFIRMED: setScale with number preserved in original but not in clone!');\n+  } else if (originalIsNumber && clonedIsNumber) {\n+    console.log('\\n\u2705 GOOD: Both original and cloned scales are numbers after setScale');\n+  } else {\n+    console.log('\\n\u26a0\ufe0f  UNEXPECTED: Original scale is not a number after setScale');\n+  }\n+\n+} catch (error) {\n+  console.error('Error in Test 3:', error);\n+}\n+\n+console.log('\\n=== Test Complete ===');\n\\ No newline at end of file\ndiff --git a/test_icon_fix.js b/test_icon_fix.js\nnew file mode 100644\nindex 000000000..06d420f84\n--- /dev/null\n+++ b/test_icon_fix.js\n@@ -0,0 +1,121 @@\n+/**\n+ * Simple test to verify the Icon clone scale fix\n+ */\n+\n+import Icon from './src/ol/style/Icon.js';\n+\n+// Mock DOM elements for Node.js environment\n+global.document = {\n+  createElement: function(tagName) {\n+    if (tagName === 'canvas') {\n+      return {\n+        width: 10,\n+        height: 10,\n+        addEventListener: function() {},\n+        removeEventListener: function() {}\n+      };\n+    }\n+    return {};\n+  }\n+};\n+\n+global.Image = function() {\n+  this.width = 10;\n+  this.height = 10;\n+  this.addEventListener = function() {};\n+  this.removeEventListener = function() {};\n+};\n+\n+console.log('=== Testing Icon Clone Scale Fix ===\\n');\n+\n+try {\n+  // Test 1: setScale(number) + clone should preserve number type\n+  console.log('Test 1: setScale(number) + clone preserves number type');\n+  \n+  const canvas = document.createElement('canvas');\n+  const originalIcon = new Icon({\n+    img: canvas,\n+    imgSize: [10, 10],\n+    scale: 1\n+  });\n+  \n+  // Call setScale with a number\n+  originalIcon.setScale(2.5);\n+  \n+  console.log('Original scale after setScale(2.5):', originalIcon.getScale(), 'type:', typeof originalIcon.getScale());\n+  \n+  // Clone the icon\n+  const clonedIcon = originalIcon.clone();\n+  \n+  console.log('Cloned scale:', clonedIcon.getScale(), 'type:', typeof clonedIcon.getScale());\n+  \n+  // Verify the fix\n+  const originalIsNumber = typeof originalIcon.getScale() === 'number';\n+  const clonedIsNumber = typeof clonedIcon.getScale() === 'number';\n+  \n+  if (originalIsNumber && clonedIsNumber && originalIcon.getScale() === clonedIcon.getScale()) {\n+    console.log('\u2705 SUCCESS: Both original and cloned scales are numbers with same value');\n+  } else {\n+    console.log('\u274c FAILED: Scale types or values don\\'t match');\n+    console.log('  Original:', originalIcon.getScale(), typeof originalIcon.getScale());\n+    console.log('  Cloned:', clonedIcon.getScale(), typeof clonedIcon.getScale());\n+  }\n+  \n+  console.log('\\n' + '='.repeat(50) + '\\n');\n+  \n+  // Test 2: Explicit width/height should still work as before\n+  console.log('Test 2: Explicit width/height behavior unchanged');\n+  \n+  const iconWithSize = new Icon({\n+    img: canvas,\n+    imgSize: [10, 10],\n+    width: 20,\n+    height: 30\n+  });\n+  \n+  const clonedIconWithSize = iconWithSize.clone();\n+  \n+  const originalIsArray = Array.isArray(iconWithSize.getScale());\n+  const clonedIsArray = Array.isArray(clonedIconWithSize.getScale());\n+  \n+  if (originalIsArray && clonedIsArray) {\n+    console.log('\u2705 SUCCESS: Both original and cloned scales are arrays when width/height set');\n+    console.log('  Original scale:', iconWithSize.getScale());\n+    console.log('  Cloned scale:', clonedIconWithSize.getScale());\n+    console.log('  Cloned width:', clonedIconWithSize.getWidth(), 'height:', clonedIconWithSize.getHeight());\n+  } else {\n+    console.log('\u274c FAILED: Array scale behavior changed');\n+  }\n+  \n+  console.log('\\n' + '='.repeat(50) + '\\n');\n+  \n+  // Test 3: setScale(array) + clone should preserve array type\n+  console.log('Test 3: setScale(array) + clone preserves array type');\n+  \n+  const iconForArray = new Icon({\n+    img: canvas,\n+    imgSize: [10, 10],\n+    scale: 1\n+  });\n+  \n+  iconForArray.setScale([2.0, 3.0]);\n+  \n+  const clonedArrayIcon = iconForArray.clone();\n+  \n+  const originalArrayScale = iconForArray.getScale();\n+  const clonedArrayScale = clonedArrayIcon.getScale();\n+  \n+  if (Array.isArray(originalArrayScale) && Array.isArray(clonedArrayScale) &&\n+      originalArrayScale[0] === clonedArrayScale[0] && originalArrayScale[1] === clonedArrayScale[1]) {\n+    console.log('\u2705 SUCCESS: Array scales preserved correctly');\n+    console.log('  Original scale:', originalArrayScale);\n+    console.log('  Cloned scale:', clonedArrayScale);\n+  } else {\n+    console.log('\u274c FAILED: Array scale not preserved correctly');\n+  }\n+  \n+} catch (error) {\n+  console.error('Error in test:', error);\n+}\n+\n+console.log('\\n=== Test Complete ===');\n\\ No newline at end of file\ndiff --git a/test_setscale_bug.test.js b/test_setscale_bug.test.js\nnew file mode 100644\nindex 000000000..2243ec519\n--- /dev/null\n+++ b/test_setscale_bug.test.js\n@@ -0,0 +1,49 @@\n+/**\n+ * Test to reproduce the setScale + clone bug\n+ * This test should be added to the existing icon.test.js file\n+ */\n+\n+import Icon from '../../../../../src/ol/style/Icon.js';\n+\n+describe('Icon setScale + clone bug', function () {\n+  it('preserves number scale type when cloning after setScale', function () {\n+    // Create a canvas to avoid image loading issues\n+    const canvas = document.createElement('canvas');\n+    canvas.width = 10;\n+    canvas.height = 10;\n+    \n+    // Create icon with number scale\n+    const originalIcon = new Icon({\n+      img: canvas,\n+      imgSize: [10, 10],\n+      scale: 1\n+    });\n+    \n+    // Verify initial state\n+    expect(typeof originalIcon.getScale()).to.be('number');\n+    expect(originalIcon.getScale()).to.be(1);\n+    \n+    // Call setScale with a number - this triggers the bug\n+    originalIcon.setScale(2.5);\n+    \n+    // Verify scale is still a number after setScale\n+    expect(typeof originalIcon.getScale()).to.be('number');\n+    expect(originalIcon.getScale()).to.be(2.5);\n+    \n+    // Check that width and height were set (this is the root cause)\n+    expect(originalIcon.getWidth()).to.be(25); // 2.5 * 10\n+    expect(originalIcon.getHeight()).to.be(25); // 2.5 * 10\n+    \n+    // Clone the icon - this should preserve the number scale type\n+    const clonedIcon = originalIcon.clone();\n+    \n+    // BUG: The cloned icon should have the same scale type as original\n+    // Currently it becomes an array because width/height are passed to constructor\n+    console.log('Original scale:', originalIcon.getScale(), 'type:', typeof originalIcon.getScale());\n+    console.log('Cloned scale:', clonedIcon.getScale(), 'type:', typeof clonedIcon.getScale());\n+    \n+    // This test will currently FAIL, demonstrating the bug\n+    expect(typeof clonedIcon.getScale()).to.be('number');\n+    expect(clonedIcon.getScale()).to.be(2.5);\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_setscale_clone_bug.js b/test_setscale_clone_bug.js\nnew file mode 100644\nindex 000000000..cfda3d877\n--- /dev/null\n+++ b/test_setscale_clone_bug.js\n@@ -0,0 +1,68 @@\n+/**\n+ * Test to reproduce the specific setScale + clone bug\n+ */\n+\n+import Icon from './src/ol/style/Icon.js';\n+\n+console.log('=== Testing setScale + clone bug ===\\n');\n+\n+// Create a canvas element to avoid image loading issues\n+const canvas = document.createElement('canvas');\n+canvas.width = 10;\n+canvas.height = 10;\n+\n+try {\n+  // Test: Create icon, call setScale with number, then clone\n+  console.log('Test: setScale(number) + clone issue');\n+  \n+  const originalIcon = new Icon({\n+    img: canvas,\n+    imgSize: [10, 10],\n+    scale: 1  // Start with number scale\n+  });\n+\n+  console.log('1. Original icon after creation:');\n+  console.log('   Scale:', originalIcon.getScale());\n+  console.log('   Scale type:', typeof originalIcon.getScale());\n+  console.log('   Scale is array:', Array.isArray(originalIcon.getScale()));\n+  console.log('   Width:', originalIcon.getWidth());\n+  console.log('   Height:', originalIcon.getHeight());\n+\n+  // Call setScale with a number - this should trigger the bug\n+  originalIcon.setScale(2.5);\n+\n+  console.log('\\n2. Original icon after setScale(2.5):');\n+  console.log('   Scale:', originalIcon.getScale());\n+  console.log('   Scale type:', typeof originalIcon.getScale());\n+  console.log('   Scale is array:', Array.isArray(originalIcon.getScale()));\n+  console.log('   Width:', originalIcon.getWidth());\n+  console.log('   Height:', originalIcon.getHeight());\n+\n+  // Now clone - this should show the bug\n+  const clonedIcon = originalIcon.clone();\n+\n+  console.log('\\n3. Cloned icon:');\n+  console.log('   Scale:', clonedIcon.getScale());\n+  console.log('   Scale type:', typeof clonedIcon.getScale());\n+  console.log('   Scale is array:', Array.isArray(clonedIcon.getScale()));\n+  console.log('   Width:', clonedIcon.getWidth());\n+  console.log('   Height:', clonedIcon.getHeight());\n+\n+  // Check if the bug exists\n+  const originalIsNumber = typeof originalIcon.getScale() === 'number';\n+  const clonedIsArray = Array.isArray(clonedIcon.getScale());\n+  \n+  if (originalIsNumber && clonedIsArray) {\n+    console.log('\\n\u274c BUG CONFIRMED: Original scale is number but cloned scale is array!');\n+    console.log('   This is the exact issue described in the bug report.');\n+  } else if (originalIsNumber && typeof clonedIcon.getScale() === 'number') {\n+    console.log('\\n\u2705 GOOD: Both original and cloned scales are numbers');\n+  } else {\n+    console.log('\\n\u26a0\ufe0f  UNEXPECTED: Original scale is not a number');\n+  }\n+\n+} catch (error) {\n+  console.error('Error in test:', error);\n+}\n+\n+console.log('\\n=== Test Complete ===');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
{"instance_id": "bpmn-io__bpmn-js-1196", "model_patch": "diff --git a/lib/features/copy-paste/BpmnCopyPaste.js b/lib/features/copy-paste/BpmnCopyPaste.js\nindex 0060df80..5c4ab6b7 100644\n--- a/lib/features/copy-paste/BpmnCopyPaste.js\n+++ b/lib/features/copy-paste/BpmnCopyPaste.js\n@@ -68,6 +68,11 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n     if (businessObject.default) {\n       descriptor.default = businessObject.default.id;\n     }\n+\n+    // boundary event attachedToRef\n+    if (is(businessObject, 'bpmn:BoundaryEvent') && businessObject.attachedToRef) {\n+      descriptor.attachedToRef = businessObject.attachedToRef.id;\n+    }\n   });\n \n   eventBus.on('moddleCopy.canCopyProperty', function(context) {\n@@ -95,6 +100,14 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n       };\n     }\n \n+    // boundary event attachedToRef\n+    if (descriptor.attachedToRef) {\n+      references[ descriptor.attachedToRef ] = {\n+        element: businessObject,\n+        property: 'attachedToRef'\n+      };\n+    }\n+\n     references = omit(references, reduce(references, function(array, reference, key) {\n       var element = reference.element,\n           property = reference.property;\ndiff --git a/test_boundary_fix.html b/test_boundary_fix.html\nnew file mode 100644\nindex 00000000..c974d0f7\n--- /dev/null\n+++ b/test_boundary_fix.html\n@@ -0,0 +1,208 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Boundary Event Copy Fix Test</title>\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+    .controls { margin: 10px 0; }\n+    button { margin: 5px; padding: 10px; }\n+    .log { background: #f5f5f5; padding: 10px; margin: 10px 0; font-family: monospace; white-space: pre-wrap; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Boundary Event Copy Fix Test</h1>\n+  \n+  <div class=\"controls\">\n+    <button onclick=\"loadDiagram()\">Load Test Diagram</button>\n+    <button onclick=\"testCopy()\">Test Copy Task + Boundary Event</button>\n+    <button onclick=\"clearLog()\">Clear Log</button>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <div class=\"log\" id=\"log\">Click \"Load Test Diagram\" to start...</div>\n+\n+  <script>\n+    var modeler;\n+    var logElement = document.getElementById('log');\n+\n+    function log(message) {\n+      logElement.textContent += new Date().toLocaleTimeString() + ': ' + message + '\\n';\n+      logElement.scrollTop = logElement.scrollHeight;\n+    }\n+\n+    function clearLog() {\n+      logElement.textContent = '';\n+    }\n+\n+    // Initialize BPMN modeler\n+    modeler = new BpmnJS({\n+      container: '#canvas',\n+      keyboard: {\n+        bindTo: window\n+      }\n+    });\n+\n+    var testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"282\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"50\" y=\"122\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"122\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"86\" y=\"140\" />\n+        <di:waypoint x=\"200\" y=\"140\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"140\" />\n+        <di:waypoint x=\"400\" y=\"140\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function loadDiagram() {\n+      modeler.importXML(testXML, function(err) {\n+        if (err) {\n+          log('Error loading diagram: ' + err.message);\n+        } else {\n+          log('Test diagram loaded successfully');\n+        }\n+      });\n+    }\n+\n+    function testCopy() {\n+      try {\n+        var elementRegistry = modeler.get('elementRegistry');\n+        var copyPaste = modeler.get('copyPaste');\n+        var canvas = modeler.get('canvas');\n+\n+        var task = elementRegistry.get('Task_1');\n+        var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+        var rootElement = canvas.getRootElement();\n+\n+        if (!task || !boundaryEvent) {\n+          log('ERROR: Could not find task or boundary event elements');\n+          return;\n+        }\n+\n+        // Log initial state\n+        log('=== INITIAL STATE ===');\n+        log('Task ID: ' + task.id);\n+        log('Boundary Event ID: ' + boundaryEvent.id);\n+        log('Boundary Event host: ' + (boundaryEvent.host ? boundaryEvent.host.id : 'none'));\n+        log('Task attachers: ' + (task.attachers ? task.attachers.map(a => a.id).join(', ') : 'none'));\n+        \n+        var taskBo = task.businessObject;\n+        var boundaryBo = boundaryEvent.businessObject;\n+        log('Task business object ID: ' + taskBo.id);\n+        log('Boundary business object ID: ' + boundaryBo.id);\n+        log('Boundary attachedToRef: ' + (boundaryBo.attachedToRef ? boundaryBo.attachedToRef.id : 'none'));\n+\n+        // Copy both elements\n+        log('\\n=== COPYING ELEMENTS ===');\n+        copyPaste.copy([task, boundaryEvent]);\n+        log('Copied task and boundary event');\n+\n+        // Paste elements\n+        log('\\n=== PASTING ELEMENTS ===');\n+        var elements = copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 500, y: 300 }\n+        });\n+\n+        log('Pasted ' + elements.length + ' elements');\n+\n+        // Find copied elements\n+        var copiedTask = null;\n+        var copiedBoundaryEvent = null;\n+\n+        elements.forEach(function(element) {\n+          if (element.type === 'bpmn:Task') {\n+            copiedTask = element;\n+          } else if (element.type === 'bpmn:BoundaryEvent') {\n+            copiedBoundaryEvent = element;\n+          }\n+        });\n+\n+        // Log results\n+        log('\\n=== COPY RESULTS ===');\n+        if (copiedTask) {\n+          log('Copied Task ID: ' + copiedTask.id);\n+          log('Copied Task attachers: ' + (copiedTask.attachers ? copiedTask.attachers.map(a => a.id).join(', ') : 'none'));\n+        } else {\n+          log('ERROR: No copied task found');\n+        }\n+\n+        if (copiedBoundaryEvent) {\n+          log('Copied Boundary Event ID: ' + copiedBoundaryEvent.id);\n+          log('Copied Boundary Event host: ' + (copiedBoundaryEvent.host ? copiedBoundaryEvent.host.id : 'none'));\n+          \n+          var copiedBoundaryBo = copiedBoundaryEvent.businessObject;\n+          log('Copied Boundary attachedToRef: ' + (copiedBoundaryBo.attachedToRef ? copiedBoundaryBo.attachedToRef.id : 'none'));\n+        } else {\n+          log('ERROR: No copied boundary event found');\n+        }\n+\n+        // Verify the fix\n+        log('\\n=== VERIFICATION ===');\n+        if (copiedTask && copiedBoundaryEvent) {\n+          var hostCorrect = copiedBoundaryEvent.host === copiedTask;\n+          var attachersCorrect = copiedTask.attachers && copiedTask.attachers.includes(copiedBoundaryEvent);\n+          var businessObjectCorrect = copiedBoundaryEvent.businessObject.attachedToRef === copiedTask.businessObject;\n+\n+          log('Host relationship correct: ' + hostCorrect);\n+          log('Attachers relationship correct: ' + attachersCorrect);\n+          log('Business object attachedToRef correct: ' + businessObjectCorrect);\n+\n+          if (hostCorrect && attachersCorrect && businessObjectCorrect) {\n+            log('\\n\u2705 SUCCESS: Boundary event attachment is working correctly!');\n+          } else {\n+            log('\\n\u274c FAILURE: Boundary event attachment is broken');\n+          }\n+        } else {\n+          log('\u274c FAILURE: Could not find copied elements');\n+        }\n+\n+      } catch (error) {\n+        log('ERROR: ' + error.message);\n+        console.error(error);\n+      }\n+    }\n+\n+    // Load diagram on page load\n+    window.onload = function() {\n+      loadDiagram();\n+    };\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
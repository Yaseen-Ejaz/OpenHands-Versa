{"instance_id": "openlayers__openlayers-14414", "model_patch": "diff --git a/src/ol/layer/WebGLTile.js b/src/ol/layer/WebGLTile.js\nindex 2cf948e0e..31a7a0ece 100644\n--- a/src/ol/layer/WebGLTile.js\n+++ b/src/ol/layer/WebGLTile.js\n@@ -514,6 +514,10 @@ class WebGLTileLayer extends BaseTileLayer {\n    */\n   updateStyleVariables(variables) {\n     Object.assign(this.styleVariables_, variables);\n+    // Clear the WebGL tile cache to ensure style changes are applied\n+    if (this.hasRenderer()) {\n+      this.getRenderer().clearCache();\n+    }\n     this.changed();\n   }\n }\ndiff --git a/test/browser/spec/ol/layer/WebGLTile.test.js b/test/browser/spec/ol/layer/WebGLTile.test.js\nindex a17bb1aae..a8f7b473d 100644\n--- a/test/browser/spec/ol/layer/WebGLTile.test.js\n+++ b/test/browser/spec/ol/layer/WebGLTile.test.js\n@@ -557,6 +557,20 @@ describe('ol/layer/WebGLTile', function () {\n         done();\n       });\n     });\n+\n+    it('clears renderer cache when updating style variables', function () {\n+      const renderer = layer.getRenderer();\n+      const clearCacheSpy = sinon.spy(renderer, 'clearCache');\n+      \n+      layer.updateStyleVariables({\n+        r: 128,\n+        g: 128,\n+        b: 128,\n+      });\n+      \n+      expect(clearCacheSpy.called).to.be(true);\n+      clearCacheSpy.restore();\n+    });\n   });\n \n   describe('multiple sources', () => {\ndiff --git a/test_region_growing.html b/test_region_growing.html\nnew file mode 100644\nindex 000000000..c73024731\n--- /dev/null\n+++ b/test_region_growing.html\n@@ -0,0 +1,37 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+\n+<head>\n+  <meta charset=\"UTF-8\">\n+  <title>Region Growing Test</title>\n+  <style>\n+    @import \"node_modules/ol/ol.css\";\n+\n+    .map {\n+      width: 100%;\n+      height: 500px;\n+      cursor: pointer;\n+    }\n+    \n+  </style>\n+</head>\n+\n+<body>\n+  <div id=\"map\" class=\"map\"></div>\n+  <div>\n+    <label>\n+      Sea level\n+      <input id=\"level\" type=\"range\" min=\"0\" max=\"20\" value=\"5.00\" step=\"0.05\" />\n+      +<span id=\"output\"></span> m\n+    </label>\n+  </div>\n+  <div>\n+    <button id=\"test-increase\">Test Increase</button>\n+    <button id=\"test-decrease\">Test Decrease</button>\n+    <span id=\"status\"></span>\n+  </div>\n+  \n+  <script type=\"module\" src=\"test_region_growing.js\"></script>\n+</body>\n+\n+</html>\n\\ No newline at end of file\ndiff --git a/test_region_growing.js b/test_region_growing.js\nnew file mode 100644\nindex 000000000..a1d9e5863\n--- /dev/null\n+++ b/test_region_growing.js\n@@ -0,0 +1,146 @@\n+import { GeoTIFF } from 'ol/source';\n+import RasterSource from 'ol/source/Raster';\n+import Map from 'ol/Map';\n+import { WebGLTile as TileLayer } from 'ol/layer';\n+import ImageLayer from 'ol/layer/Image';\n+import View from 'ol/View';\n+import OSM from 'ol/source/OSM';\n+import DataTile from 'ol/source/DataTile';\n+\n+// Create a simple test data source with known elevation values\n+const createTestDataSource = () => {\n+  const size = 256;\n+  const data = new Uint16Array(size * size);\n+  \n+  // Fill with test elevation data - create a gradient from 0 to 20\n+  for (let y = 0; y < size; y++) {\n+    for (let x = 0; x < size; x++) {\n+      const index = y * size + x;\n+      // Create a simple elevation pattern: higher in the center\n+      const centerX = size / 2;\n+      const centerY = size / 2;\n+      const distance = Math.sqrt((x - centerX) ** 2 + (y - centerY) ** 2);\n+      const maxDistance = Math.sqrt(centerX ** 2 + centerY ** 2);\n+      const elevation = Math.round(20 * (1 - distance / maxDistance));\n+      data[index] = Math.max(0, elevation);\n+    }\n+  }\n+  \n+  return new DataTile({\n+    loader: function (z, x, y) {\n+      return Promise.resolve(data);\n+    },\n+    bandCount: 1,\n+    projection: 'EPSG:3857',\n+    tileGrid: null,\n+  });\n+};\n+\n+const control = document.getElementById('level');\n+const FloodStyle = {\n+        variables: {\n+                level: parseFloat(control.value),\n+        },\n+        color: [\n+                'case',\n+                ['==', ['band', 2], 0],  //se la banda2 == 0 (indica i nodata)\n+                '#00000000',             //allora pixel trasparente\n+                [\"case\", [\"<=\", [\"band\", 1], [\"var\", \"level\"]], \"#ffffffff\", '#00000000']  //se la banda1 \u00e8 <= livello \u00e8 blu altrimenti trasparente\n+        ],\n+}\n+\n+// Functions called inside this operation are visible only if they're provided in \"lib\" option\n+function floodRegion(inputs, data) {\n+        const image = inputs[0];\n+        const inputData = image.data;\n+        const width = image.width;\n+        const height = image.height;\n+        let seed = data.pixel;\n+\n+        if (seed) {\n+                seed = seed.map(Math.round);\n+                const seedIdx = (seed[1] * width + seed[0]) * 4;\n+                console.log(\"Value: \" + inputData[seedIdx]);\n+        }\n+\n+        return { data: image.data, width: width, height: height };\n+}\n+\n+const elevation = createTestDataSource();\n+\n+const elevationTile = new TileLayer({\n+        source: elevation,\n+        style: FloodStyle\n+})\n+\n+const raster = new RasterSource({\n+        sources: [elevationTile],\n+        operationType: \"image\",\n+        operation: floodRegion\n+});\n+\n+const dem = new ImageLayer({\n+        source: raster,\n+        opacity: 1.0,\n+})\n+\n+const osm = new TileLayer({\n+        visible: true,\n+        preload: Infinity,\n+        source: new OSM({ wrapX: true })\n+})\n+\n+const map = new Map({\n+        target: 'map',\n+        layers: [\n+                osm,\n+                dem,\n+        ],\n+        view: new View({\n+                center: [0, 0],\n+                zoom: 2,\n+        }),\n+})\n+\n+// Set a default extent for the test data\n+// dem.setExtent([-20037508.34, -20037508.34, 20037508.34, 20037508.34]);\n+\n+const outputLevel = document.getElementById('output');\n+const statusElement = document.getElementById('status');\n+\n+control.addEventListener('input', () => {\n+        outputLevel.innerText = control.value;\n+        console.log('Updating style variables to level:', parseFloat(control.value));\n+        elevationTile.updateStyleVariables({ level: parseFloat(control.value) });\n+        statusElement.innerText = `Level updated to ${control.value}`;\n+})\n+outputLevel.innerText = control.value;\n+\n+// Test buttons\n+document.getElementById('test-increase').addEventListener('click', () => {\n+        control.value = parseFloat(control.value) + 1;\n+        control.dispatchEvent(new Event('input'));\n+});\n+\n+document.getElementById('test-decrease').addEventListener('click', () => {\n+        control.value = parseFloat(control.value) - 1;\n+        control.dispatchEvent(new Event('input'));\n+});\n+\n+let coordinate = null;\n+\n+map.on('click', (event) => {\n+        coordinate = event.coordinate;\n+        console.log('Clicked at coordinate:', coordinate);\n+        raster.changed();\n+})\n+\n+raster.on('beforeoperations', function (event) {\n+        // the event.data object will be passed to operations\n+        const data = event.data;\n+\n+        if (coordinate) {\n+                data.pixel = map.getPixelFromCoordinate(coordinate);\n+                console.log('Pixel from coordinate:', data.pixel);\n+        }\n+});\n\\ No newline at end of file\ndiff --git a/test_webgl_style_variables.js b/test_webgl_style_variables.js\nnew file mode 100644\nindex 000000000..3900509d9\n--- /dev/null\n+++ b/test_webgl_style_variables.js\n@@ -0,0 +1,154 @@\n+/**\n+ * Test for WebGL Tile Layer Style Variables Update Issue\n+ * \n+ * This test verifies that:\n+ * 1. Style variables can be updated bidirectionally (increase/decrease)\n+ * 2. The WebGL tile cache is properly invalidated when style variables change\n+ */\n+\n+import { WebGLTile as TileLayer } from 'ol/layer';\n+import DataTile from 'ol/source/DataTile';\n+import Map from 'ol/Map';\n+import View from 'ol/View';\n+\n+// Create a simple test data source\n+function createTestDataSource() {\n+  const size = 256;\n+  const data = new Uint16Array(size * size);\n+  \n+  // Fill with test elevation data - create a simple pattern\n+  for (let y = 0; y < size; y++) {\n+    for (let x = 0; x < size; x++) {\n+      const index = y * size + x;\n+      // Create a simple elevation pattern: value based on position\n+      data[index] = Math.floor((x + y) / 10) % 20;\n+    }\n+  }\n+  \n+  return new DataTile({\n+    loader: function (z, x, y) {\n+      return Promise.resolve(data);\n+    },\n+    bandCount: 1,\n+    projection: 'EPSG:3857',\n+  });\n+}\n+\n+// Test style with variable\n+const testStyle = {\n+  variables: {\n+    level: 5,\n+  },\n+  color: [\n+    'case',\n+    ['<=', ['band', 1], ['var', 'level']], \n+    '#ff0000',  // Red for pixels below level\n+    '#00ff00'   // Green for pixels above level\n+  ],\n+};\n+\n+// Create test layer\n+const testSource = createTestDataSource();\n+const testLayer = new TileLayer({\n+  source: testSource,\n+  style: testStyle\n+});\n+\n+// Create a minimal map\n+const map = new Map({\n+  target: document.createElement('div'),\n+  layers: [testLayer],\n+  view: new View({\n+    center: [0, 0],\n+    zoom: 2,\n+  }),\n+});\n+\n+// Test function to verify style variable updates work bidirectionally\n+function testStyleVariableUpdates() {\n+  console.log('Testing WebGL Tile Layer Style Variable Updates...');\n+  \n+  let testsPassed = 0;\n+  let totalTests = 0;\n+  \n+  // Test 1: Initial state\n+  totalTests++;\n+  const initialLevel = testLayer.styleVariables_.level;\n+  if (initialLevel === 5) {\n+    console.log('\u2713 Test 1 passed: Initial level is correct');\n+    testsPassed++;\n+  } else {\n+    console.log('\u2717 Test 1 failed: Initial level is incorrect', initialLevel);\n+  }\n+  \n+  // Test 2: Increase level\n+  totalTests++;\n+  testLayer.updateStyleVariables({ level: 10 });\n+  const increasedLevel = testLayer.styleVariables_.level;\n+  if (increasedLevel === 10) {\n+    console.log('\u2713 Test 2 passed: Level increased correctly');\n+    testsPassed++;\n+  } else {\n+    console.log('\u2717 Test 2 failed: Level not increased correctly', increasedLevel);\n+  }\n+  \n+  // Test 3: Decrease level (this was the problematic case)\n+  totalTests++;\n+  testLayer.updateStyleVariables({ level: 3 });\n+  const decreasedLevel = testLayer.styleVariables_.level;\n+  if (decreasedLevel === 3) {\n+    console.log('\u2713 Test 3 passed: Level decreased correctly');\n+    testsPassed++;\n+  } else {\n+    console.log('\u2717 Test 3 failed: Level not decreased correctly', decreasedLevel);\n+  }\n+  \n+  // Test 4: Verify renderer cache is cleared when style variables change\n+  totalTests++;\n+  const renderer = testLayer.getRenderer();\n+  if (renderer && typeof renderer.clearCache === 'function') {\n+    // Mock the clearCache method to track if it's called\n+    let cacheClearCalled = false;\n+    const originalClearCache = renderer.clearCache;\n+    renderer.clearCache = function() {\n+      cacheClearCalled = true;\n+      return originalClearCache.call(this);\n+    };\n+    \n+    testLayer.updateStyleVariables({ level: 7 });\n+    \n+    if (cacheClearCalled) {\n+      console.log('\u2713 Test 4 passed: Renderer cache cleared on style variable update');\n+      testsPassed++;\n+    } else {\n+      console.log('\u2717 Test 4 failed: Renderer cache not cleared on style variable update');\n+    }\n+    \n+    // Restore original method\n+    renderer.clearCache = originalClearCache;\n+  } else {\n+    console.log('\u2717 Test 4 failed: Renderer or clearCache method not available');\n+  }\n+  \n+  // Summary\n+  console.log(`\\nTest Results: ${testsPassed}/${totalTests} tests passed`);\n+  \n+  if (testsPassed === totalTests) {\n+    console.log('\ud83c\udf89 All tests passed! The WebGL style variable update issue is fixed.');\n+    return true;\n+  } else {\n+    console.log('\u274c Some tests failed. The issue may not be fully resolved.');\n+    return false;\n+  }\n+}\n+\n+// Export for use in other tests\n+export { testStyleVariableUpdates, testLayer, testSource };\n+\n+// Run the test if this file is executed directly\n+if (typeof window !== 'undefined') {\n+  // Wait for the layer to be ready\n+  setTimeout(() => {\n+    testStyleVariableUpdates();\n+  }, 100);\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
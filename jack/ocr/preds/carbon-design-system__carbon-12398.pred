{"instance_id": "carbon-design-system__carbon-12398", "model_patch": "diff --git a/packages/react/src/components/Checkbox/Checkbox.stories.js b/packages/react/src/components/Checkbox/Checkbox.stories.js\nindex c4b90689c..aed8cbbdd 100644\n--- a/packages/react/src/components/Checkbox/Checkbox.stories.js\n+++ b/packages/react/src/components/Checkbox/Checkbox.stories.js\n@@ -36,6 +36,17 @@ export const Default = () => {\n \n export const Skeleton = () => <CheckboxSkeleton />;\n \n+export const ReadOnly = () => {\n+  return (\n+    <fieldset className={`${prefix}--fieldset`}>\n+      <legend className={`${prefix}--label`}>Read-only checkboxes</legend>\n+      <Checkbox labelText={`Unchecked read-only`} id=\"readonly-unchecked\" readOnly />\n+      <Checkbox labelText={`Checked read-only`} id=\"readonly-checked\" readOnly checked />\n+      <Checkbox labelText={`Indeterminate read-only`} id=\"readonly-indeterminate\" readOnly indeterminate />\n+    </fieldset>\n+  );\n+};\n+\n export const Playground = (args) => (\n   <fieldset className={`${prefix}--fieldset`}>\n     <legend className={`${prefix}--label`}>Group label</legend>\n@@ -77,4 +88,9 @@ Playground.argTypes = {\n   labelText: {\n     control: false,\n   },\n+  readOnly: {\n+    control: {\n+      type: 'boolean',\n+    },\n+  },\n };\ndiff --git a/packages/react/src/components/Checkbox/Checkbox.tsx b/packages/react/src/components/Checkbox/Checkbox.tsx\nindex 6c2e55def..771683ba6 100644\n--- a/packages/react/src/components/Checkbox/Checkbox.tsx\n+++ b/packages/react/src/components/Checkbox/Checkbox.tsx\n@@ -58,6 +58,11 @@ export interface CheckboxProps\n     evt: React.ChangeEvent<HTMLInputElement>,\n     data: { checked: boolean; id: string }\n   ) => void;\n+\n+  /**\n+   * Specify whether the Checkbox should be read-only\n+   */\n+  readOnly?: boolean;\n }\n \n const Checkbox = React.forwardRef(\n@@ -69,6 +74,7 @@ const Checkbox = React.forwardRef(\n       onChange,\n       indeterminate,\n       hideLabel,\n+      readOnly,\n       title = '',\n       ...other\n     }: CheckboxProps,\n@@ -78,6 +84,9 @@ const Checkbox = React.forwardRef(\n     const wrapperClasses = classNames(\n       `${prefix}--form-item`,\n       `${prefix}--checkbox-wrapper`,\n+      {\n+        [`${prefix}--checkbox-wrapper--readonly`]: readOnly,\n+      },\n       [className]\n     );\n     const innerLabelClasses = classNames(`${prefix}--checkbox-label-text`, {\n@@ -90,10 +99,14 @@ const Checkbox = React.forwardRef(\n           {...other}\n           type=\"checkbox\"\n           onChange={(evt) => {\n-            onChange && onChange(evt, { checked: evt.target.checked, id });\n+            if (!readOnly) {\n+              onChange && onChange(evt, { checked: evt.target.checked, id });\n+            }\n           }}\n           className={`${prefix}--checkbox`}\n           id={id}\n+          readOnly={readOnly}\n+          aria-readonly={readOnly ? 'true' : undefined}\n           ref={(el) => {\n             if (el && indeterminate) {\n               el.indeterminate = indeterminate;\n@@ -165,6 +178,11 @@ Checkbox.propTypes = {\n    */\n   onChange: PropTypes.func,\n \n+  /**\n+   * Specify whether the Checkbox should be read-only\n+   */\n+  readOnly: PropTypes.bool,\n+\n   /**\n    * Specify a title for the <label> node for the Checkbox\n    */\ndiff --git a/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js b/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js\nnew file mode 100644\nindex 000000000..8ad9a0964\n--- /dev/null\n+++ b/packages/react/src/components/Checkbox/__tests__/Checkbox-readonly-test.js\n@@ -0,0 +1,148 @@\n+/**\n+ * Test file for read-only Checkbox implementation\n+ * This file tests the read-only functionality before and after implementation\n+ */\n+\n+import React from 'react';\n+import { render, screen } from '@testing-library/react';\n+import userEvent from '@testing-library/user-event';\n+import Checkbox from '../Checkbox';\n+\n+describe('Checkbox readOnly functionality', () => {\n+  describe('before implementation', () => {\n+    it('should not have readOnly prop available yet', () => {\n+      // This test should initially fail, showing the prop doesn't exist\n+      const { container } = render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+        />\n+      );\n+      \n+      const input = screen.getByRole('checkbox');\n+      // This should fail initially as readOnly prop is not implemented\n+      expect(input).toHaveAttribute('readonly');\n+    });\n+  });\n+\n+  describe('after implementation', () => {\n+    it('should accept readOnly prop', () => {\n+      const { container } = render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+        />\n+      );\n+      \n+      const input = screen.getByRole('checkbox');\n+      expect(input).toHaveAttribute('readonly');\n+    });\n+\n+    it('should apply read-only CSS class to wrapper', () => {\n+      const { container } = render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+        />\n+      );\n+      \n+      expect(container.firstChild).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+\n+    it('should not be interactive when readOnly is true', async () => {\n+      const onChange = jest.fn();\n+      render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+          onChange={onChange}\n+        />\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      await userEvent.click(checkbox);\n+      \n+      // onChange should not be called for read-only checkbox\n+      expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should work with checked state when readOnly', () => {\n+      render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+          checked={true}\n+        />\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toBeChecked();\n+      expect(checkbox).toHaveAttribute('readonly');\n+    });\n+\n+    it('should work with indeterminate state when readOnly', () => {\n+      render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+          indeterminate={true}\n+        />\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox.indeterminate).toBe(true);\n+      expect(checkbox).toHaveAttribute('readonly');\n+    });\n+\n+    it('should support custom className with readOnly', () => {\n+      const { container } = render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+          className=\"custom-class\"\n+        />\n+      );\n+      \n+      expect(container.firstChild).toHaveClass('custom-class');\n+      expect(container.firstChild).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+\n+    it('should have proper accessibility attributes when readOnly', () => {\n+      render(\n+        <Checkbox \n+          id=\"test-readonly\" \n+          labelText=\"Read-only checkbox\" \n+          readOnly={true}\n+        />\n+      );\n+      \n+      const checkbox = screen.getByRole('checkbox');\n+      expect(checkbox).toHaveAttribute('readonly');\n+      expect(checkbox).toHaveAttribute('aria-readonly', 'true');\n+    });\n+  });\n+\n+  describe('RTL support', () => {\n+    it('should apply read-only class correctly in RTL context', () => {\n+      const { container } = render(\n+        <div dir=\"rtl\">\n+          <Checkbox \n+            id=\"test-readonly-rtl\" \n+            labelText=\"Read-only checkbox RTL\" \n+            readOnly={true}\n+          />\n+        </div>\n+      );\n+      \n+      const wrapper = container.querySelector('.cds--checkbox-wrapper');\n+      expect(wrapper).toHaveClass('cds--checkbox-wrapper--readonly');\n+    });\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/packages/styles/scss/components/checkbox/_checkbox.scss b/packages/styles/scss/components/checkbox/_checkbox.scss\nindex f2dcc9afb..c4b434972 100644\n--- a/packages/styles/scss/components/checkbox/_checkbox.scss\n+++ b/packages/styles/scss/components/checkbox/_checkbox.scss\n@@ -180,6 +180,29 @@\n     background-color: $icon-disabled;\n   }\n \n+  //----------------------------------------------\n+  // Read-only\n+  // ---------------------------------------------\n+\n+  .#{$prefix}--checkbox-wrapper--readonly .#{$prefix}--checkbox-label {\n+    color: $text-primary;\n+    cursor: default;\n+  }\n+\n+  .#{$prefix}--checkbox-wrapper--readonly .#{$prefix}--checkbox-label::before {\n+    border-color: $icon-disabled;\n+  }\n+\n+  .#{$prefix}--checkbox-wrapper--readonly\n+    .#{$prefix}--checkbox:checked\n+    + .#{$prefix}--checkbox-label::before,\n+  .#{$prefix}--checkbox-wrapper--readonly\n+    .#{$prefix}--checkbox:indeterminate\n+    + .#{$prefix}--checkbox-label::before {\n+    background-color: $icon-disabled;\n+    border-color: $icon-disabled;\n+  }\n+\n   //-----------------------------------------------\n   // Skeleton\n   //-----------------------------------------------", "model_name_or_path": "llm.claude4"}
center.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:34:40] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:34:40] \"GET /src/ol/style/TextPlacement.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:34:40] \"GET /src/ol/style/Text.js HTTP/1.1\" 304 -\ndiff --git a/simple_opacity_test.html b/simple_opacity_test.html\nnew file mode 100644\nindex 000000000..d8b181db5\n--- /dev/null\n+++ b/simple_opacity_test.html\n@@ -0,0 +1,102 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Opacity Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+            background: #f0f0f0;\n+        }\n+        #controls {\n+            margin: 10px 0;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"controls\">\n+        <button onclick=\"testOpacity()\">Test Opacity Change</button>\n+        <div id=\"status\">Status: Ready</div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import Style from './src/ol/style/Style.js';\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        // Create a simple red circle icon using data URL\n+        const iconFeature = new Feature({\n+            geometry: new Point([0, 0])\n+        });\n+\n+        const iconStyle = new Style({\n+            image: new Icon({\n+                src: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(`\n+                    <svg width=\"40\" height=\"40\" xmlns=\"http://www.w3.org/2000/svg\">\n+                        <circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"red\" stroke=\"black\" stroke-width=\"2\"/>\n+                        <text x=\"20\" y=\"25\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"16\" fill=\"white\">!</text>\n+                    </svg>\n+                `),\n+                scale: 1,\n+                opacity: 1\n+            })\n+        });\n+\n+        iconFeature.setStyle(iconStyle);\n+\n+        const vectorSource = new VectorSource({\n+            features: [iconFeature]\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [vectorLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 4\n+            })\n+        });\n+\n+        // Global variables for testing\n+        window.iconStyle = iconStyle;\n+        window.map = map;\n+        window.testCount = 0;\n+\n+        window.testOpacity = function() {\n+            const imageStyle = iconStyle.getImage();\n+            window.testCount++;\n+            \n+            // Alternate between 1.0 and 0.3 opacity\n+            const newOpacity = window.testCount % 2 === 0 ? 1.0 : 0.3;\n+            \n+            console.log(`Test ${window.testCount}: Setting opacity from ${imageStyle.getOpacity()} to ${newOpacity}`);\n+            \n+            // This is the method that should work but doesn't in 6.2.0\n+            imageStyle.setOpacity(newOpacity);\n+            \n+            // Force a re-render\n+            map.render();\n+            \n+            document.getElementById('status').textContent = \n+                `Test ${window.testCount}: Opacity set to ${newOpacity} (actual: ${imageStyle.getOpacity()})`;\n+        };\n+\n+        // Wait for map to load then show initial status\n+        setTimeout(() => {\n+            document.getElementById('status').textContent = 'Map loaded. Click button to test opacity changes.';\n+            console.log('Map loaded, icon opacity:', iconStyle.getImage().getOpacity());\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/renderer/vector.js b/src/ol/renderer/vector.js\nindex ec8c00853..0063dad3a 100644\n--- a/src/ol/renderer/vector.js\n+++ b/src/ol/renderer/vector.js\n@@ -102,7 +102,9 @@ export function renderFeature(replayGroup, feature, style, squaredTolerance, lis\n   if (imageStyle) {\n     let imageState = imageStyle.getImageState();\n     if (imageState == ImageState.LOADED || imageState == ImageState.ERROR) {\n-      imageStyle.unlistenImageChange(listener);\n+      // Keep listening for changes even after image is loaded to handle\n+      // style property changes like setOpacity, setScale, setRotation\n+      imageStyle.listenImageChange(listener);\n     } else {\n       if (imageState == ImageState.IDLE) {\n         imageStyle.load();\ndiff --git a/src/ol/style/Icon.js b/src/ol/style/Icon.js\nindex 9882e4e27..54c308e5d 100644\n--- a/src/ol/style/Icon.js\n+++ b/src/ol/style/Icon.js\n@@ -403,6 +403,45 @@ class Icon extends ImageStyle {\n   unlistenImageChange(listener) {\n     this.iconImage_.removeEventListener(EventType.CHANGE, listener);\n   }\n+\n+  /**\n+   * Set the opacity.\n+   *\n+   * @param {number} opacity Opacity.\n+   * @api\n+   * @override\n+   */\n+  setOpacity(opacity) {\n+    super.setOpacity(opacity);\n+    // Trigger a change event to notify renderers that the style has changed\n+    this.iconImage_.dispatchEvent(EventType.CHANGE);\n+  }\n+\n+  /**\n+   * Set the scale.\n+   *\n+   * @param {number} scale Scale.\n+   * @api\n+   * @override\n+   */\n+  setScale(scale) {\n+    super.setScale(scale);\n+    // Trigger a change event to notify renderers that the style has changed\n+    this.iconImage_.dispatchEvent(EventType.CHANGE);\n+  }\n+\n+  /**\n+   * Set the rotation.\n+   *\n+   * @param {number} rotation Rotation.\n+   * @api\n+   * @override\n+   */\n+  setRotation(rotation) {\n+    super.setRotation(rotation);\n+    // Trigger a change event to notify renderers that the style has changed\n+    this.iconImage_.dispatchEvent(EventType.CHANGE);\n+  }\n }\n \n \ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 000000000..1cfc2494c\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,137 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Opacity Fix</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+            background: #f0f0f0;\n+        }\n+        #controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 8px 12px;\n+        }\n+        .status {\n+            margin: 5px 0;\n+            font-family: monospace;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"controls\">\n+        <button onclick=\"testOpacity()\">Test Opacity (Should Work Now)</button>\n+        <button onclick=\"testScale()\">Test Scale</button>\n+        <button onclick=\"testRotation()\">Test Rotation</button>\n+        <div class=\"status\" id=\"status\">Status: Ready</div>\n+        <div class=\"status\" id=\"opacity\">Opacity: 1.0</div>\n+        <div class=\"status\" id=\"scale\">Scale: 1.0</div>\n+        <div class=\"status\" id=\"rotation\">Rotation: 0</div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import Style from './src/ol/style/Style.js';\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        // Create a simple red circle icon using data URL\n+        const iconFeature = new Feature({\n+            geometry: new Point([0, 0])\n+        });\n+\n+        const iconStyle = new Style({\n+            image: new Icon({\n+                src: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(`\n+                    <svg width=\"40\" height=\"40\" xmlns=\"http://www.w3.org/2000/svg\">\n+                        <circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"red\" stroke=\"black\" stroke-width=\"2\"/>\n+                        <text x=\"20\" y=\"25\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"16\" fill=\"white\">!</text>\n+                    </svg>\n+                `),\n+                scale: 1,\n+                opacity: 1,\n+                rotation: 0\n+            })\n+        });\n+\n+        iconFeature.setStyle(iconStyle);\n+\n+        const vectorSource = new VectorSource({\n+            features: [iconFeature]\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [vectorLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 4\n+            })\n+        });\n+\n+        // Global variables for testing\n+        window.iconStyle = iconStyle;\n+        window.map = map;\n+        window.testCount = 0;\n+\n+        window.testOpacity = function() {\n+            const imageStyle = iconStyle.getImage();\n+            window.testCount++;\n+            \n+            // Alternate between 1.0 and 0.3 opacity\n+            const newOpacity = window.testCount % 2 === 0 ? 1.0 : 0.3;\n+            \n+            console.log(`Test ${window.testCount}: Setting opacity from ${imageStyle.getOpacity()} to ${newOpacity}`);\n+            \n+            // This should now work with our fix\n+            imageStyle.setOpacity(newOpacity);\n+            \n+            document.getElementById('status').textContent = `Opacity test ${window.testCount}: ${newOpacity}`;\n+            document.getElementById('opacity').textContent = `Opacity: ${imageStyle.getOpacity()}`;\n+        };\n+\n+        window.testScale = function() {\n+            const imageStyle = iconStyle.getImage();\n+            const currentScale = imageStyle.getScale();\n+            const newScale = currentScale === 1 ? 1.5 : 1;\n+            \n+            console.log(`Setting scale from ${currentScale} to ${newScale}`);\n+            imageStyle.setScale(newScale);\n+            \n+            document.getElementById('status').textContent = `Scale changed to ${newScale}`;\n+            document.getElementById('scale').textContent = `Scale: ${imageStyle.getScale()}`;\n+        };\n+\n+        window.testRotation = function() {\n+            const imageStyle = iconStyle.getImage();\n+            const currentRotation = imageStyle.getRotation();\n+            const newRotation = currentRotation === 0 ? Math.PI / 4 : 0;\n+            \n+            console.log(`Setting rotation from ${currentRotation} to ${newRotation}`);\n+            imageStyle.setRotation(newRotation);\n+            \n+            document.getElementById('status').textContent = `Rotation changed to ${newRotation.toFixed(2)}`;\n+            document.getElementById('rotation').textContent = `Rotation: ${imageStyle.getRotation().toFixed(2)}`;\n+        };\n+\n+        // Wait for map to load then show initial status\n+        setTimeout(() => {\n+            document.getElementById('status').textContent = 'Map loaded. Test the buttons - opacity changes should now work!';\n+            console.log('Map loaded, icon opacity:', iconStyle.getImage().getOpacity());\n+        }, 1000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_opacity_core.js b/test_opacity_core.js\nnew file mode 100644\nindex 000000000..67c7e1614\n--- /dev/null\n+++ b/test_opacity_core.js\n@@ -0,0 +1,67 @@\n+/**\n+ * Core test for opacity issue - tests the underlying mechanism\n+ */\n+\n+import Icon from './src/ol/style/Icon.js';\n+import Style from './src/ol/style/Style.js';\n+import Feature from './src/ol/Feature.js';\n+import Point from './src/ol/geom/Point.js';\n+import VectorSource from './src/ol/source/Vector.js';\n+import VectorLayer from './src/ol/layer/Vector.js';\n+import {renderFeature} from './src/ol/renderer/vector.js';\n+import BuilderGroup from './src/ol/render/canvas/BuilderGroup.js';\n+\n+console.log('Testing opacity change mechanism...');\n+\n+// Create an icon style\n+const iconStyle = new Icon({\n+    src: 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(`\n+        <svg width=\"20\" height=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n+            <circle cx=\"10\" cy=\"10\" r=\"8\" fill=\"red\"/>\n+        </svg>\n+    `),\n+    opacity: 1.0\n+});\n+\n+const style = new Style({\n+    image: iconStyle\n+});\n+\n+const feature = new Feature({\n+    geometry: new Point([0, 0])\n+});\n+\n+feature.setStyle(style);\n+\n+console.log('Initial opacity:', iconStyle.getOpacity());\n+\n+// Test the setOpacity method\n+iconStyle.setOpacity(0.5);\n+console.log('After setOpacity(0.5):', iconStyle.getOpacity());\n+\n+// Test if the change is reflected in the style\n+console.log('Style image opacity:', style.getImage().getOpacity());\n+\n+// Test change listener mechanism\n+let changeEventFired = false;\n+const changeListener = () => {\n+    changeEventFired = true;\n+    console.log('Change event fired!');\n+};\n+\n+// Try to listen for changes\n+try {\n+    iconStyle.listenImageChange(changeListener);\n+    console.log('Successfully added change listener');\n+    \n+    // Change opacity again\n+    iconStyle.setOpacity(0.3);\n+    console.log('After second setOpacity(0.3):', iconStyle.getOpacity());\n+    console.log('Change event fired:', changeEventFired);\n+    \n+    iconStyle.unlistenImageChange(changeListener);\n+} catch (error) {\n+    console.log('Error with change listener:', error.message);\n+}\n+\n+console.log('Test completed.');\n\\ No newline at end of file\ndiff --git a/test_opacity_issue.html b/test_opacity_issue.html\nnew file mode 100644\nindex 000000000..71894459f\n--- /dev/null\n+++ b/test_opacity_issue.html\n@@ -0,0 +1,116 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>OpenLayers Opacity Issue Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"controls\">\n+        <button onclick=\"toggleOpacity()\">Toggle Opacity (Should Blink)</button>\n+        <button onclick=\"changeScale()\">Change Scale (Works)</button>\n+        <button onclick=\"changeRotation()\">Change Rotation (Works)</button>\n+        <div id=\"status\">Current opacity: <span id=\"opacityValue\">1.0</span></div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import Style from './src/ol/style/Style.js';\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        // Create a simple icon feature\n+        const iconFeature = new Feature({\n+            geometry: new Point([0, 0])\n+        });\n+\n+        const iconStyle = new Style({\n+            image: new Icon({\n+                src: 'data:image/svg+xml;base64,',\n+                scale: 1,\n+                opacity: 1\n+            })\n+        });\n+\n+        iconFeature.setStyle(iconStyle);\n+\n+        const vectorSource = new VectorSource({\n+            features: [iconFeature]\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Global variables for testing\n+        window.iconStyle = iconStyle;\n+        window.map = map;\n+        window.currentOpacity = 1.0;\n+\n+        // Test functions\n+        window.toggleOpacity = function() {\n+            const imageStyle = iconStyle.getImage();\n+            window.currentOpacity = window.currentOpacity === 1.0 ? 0.3 : 1.0;\n+            console.log('Setting opacity to:', window.currentOpacity);\n+            imageStyle.setOpacity(window.currentOpacity);\n+            document.getElementById('opacityValue').textContent = window.currentOpacity;\n+            \n+            // Force a re-render to see if the change takes effect\n+            map.render();\n+        };\n+\n+        window.changeScale = function() {\n+            const imageStyle = iconStyle.getImage();\n+            const currentScale = imageStyle.getScale();\n+            const newScale = currentScale === 1 ? 1.5 : 1;\n+            console.log('Setting scale to:', newScale);\n+            imageStyle.setScale(newScale);\n+            map.render();\n+        };\n+\n+        window.changeRotation = function() {\n+            const imageStyle = iconStyle.getImage();\n+            const currentRotation = imageStyle.getRotation();\n+            const newRotation = currentRotation === 0 ? Math.PI / 4 : 0;\n+            console.log('Setting rotation to:', newRotation);\n+            imageStyle.setRotation(newRotation);\n+            map.render();\n+        };\n+\n+        console.log('Test page loaded. Icon style:', iconStyle.getImage());\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
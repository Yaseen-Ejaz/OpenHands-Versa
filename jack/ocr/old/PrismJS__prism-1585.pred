{"instance_id": "PrismJS__prism-1585", "model_patch": "diff --git a/components/prism-css.js b/components/prism-css.js\nindex e6fdf6f6..aed4ede9 100644\n--- a/components/prism-css.js\n+++ b/components/prism-css.js\n@@ -1,52 +1,52 @@\n Prism.languages.css = {\n-\t'comment': /\\/\\*[\\s\\S]*?\\*\\//,\n-\t'atrule': {\n-\t\tpattern: /@[\\w-]+?.*?(?:;|(?=\\s*\\{))/i,\n-\t\tinside: {\n-\t\t\t'rule': /@[\\w-]+/\n-\t\t\t// See rest below\n-\t\t}\n-\t},\n-\t'url': /url\\((?:([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1|.*?)\\)/i,\n-\t'selector': /[^{}\\s][^{};]*?(?=\\s*\\{)/,\n-\t'string': {\n-\t\tpattern: /(\"|')(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1/,\n-\t\tgreedy: true\n-\t},\n-\t'property': /[-_a-z\\xA0-\\uFFFF][-\\w\\xA0-\\uFFFF]*(?=\\s*:)/i,\n-\t'important': /\\B!important\\b/i,\n-\t'function': /[-a-z0-9]+(?=\\()/i,\n-\t'punctuation': /[(){};:]/\n+        'comment': /\\/\\*[\\s\\S]*?\\*\\//,\n+        'atrule': {\n+                pattern: /@[\\w-]+?.*?(?:;|(?=\\s*\\{))/i,\n+                inside: {\n+                        'rule': /@[\\w-]+/\n+                        // See rest below\n+                }\n+        },\n+        'url': /url\\((?:([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1|.*?)\\)/i,\n+        'selector': /[^{}\\s][^{};]*?(?=\\s*\\{)/,\n+        'string': {\n+                pattern: /(\"|')(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1/,\n+                greedy: true\n+        },\n+        'property': /[-_a-z\\xA0-\\uFFFF][-\\w\\xA0-\\uFFFF]*(?=\\s*:)/i,\n+        'important': /!important\\b/i,\n+        'function': /[-a-z0-9]+(?=\\()/i,\n+        'punctuation': /[(){};:]/\n };\n \n Prism.languages.css['atrule'].inside.rest = Prism.languages.css;\n \n if (Prism.languages.markup) {\n-\tPrism.languages.insertBefore('markup', 'tag', {\n-\t\t'style': {\n-\t\t\tpattern: /(<style[\\s\\S]*?>)[\\s\\S]*?(?=<\\/style>)/i,\n-\t\t\tlookbehind: true,\n-\t\t\tinside: Prism.languages.css,\n-\t\t\talias: 'language-css',\n-\t\t\tgreedy: true\n-\t\t}\n-\t});\n+        Prism.languages.insertBefore('markup', 'tag', {\n+                'style': {\n+                        pattern: /(<style[\\s\\S]*?>)[\\s\\S]*?(?=<\\/style>)/i,\n+                        lookbehind: true,\n+                        inside: Prism.languages.css,\n+                        alias: 'language-css',\n+                        greedy: true\n+                }\n+        });\n \n-\tPrism.languages.insertBefore('inside', 'attr-value', {\n-\t\t'style-attr': {\n-\t\t\tpattern: /\\s*style=(\"|')(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\1/i,\n-\t\t\tinside: {\n-\t\t\t\t'attr-name': {\n-\t\t\t\t\tpattern: /^\\s*style/i,\n-\t\t\t\t\tinside: Prism.languages.markup.tag.inside\n-\t\t\t\t},\n-\t\t\t\t'punctuation': /^\\s*=\\s*['\"]|['\"]\\s*$/,\n-\t\t\t\t'attr-value': {\n-\t\t\t\t\tpattern: /.+/i,\n-\t\t\t\t\tinside: Prism.languages.css\n-\t\t\t\t}\n-\t\t\t},\n-\t\t\talias: 'language-css'\n-\t\t}\n-\t}, Prism.languages.markup.tag);\n+        Prism.languages.insertBefore('inside', 'attr-value', {\n+                'style-attr': {\n+                        pattern: /\\s*style=(\"|')(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\1/i,\n+                        inside: {\n+                                'attr-name': {\n+                                        pattern: /^\\s*style/i,\n+                                        inside: Prism.languages.markup.tag.inside\n+                                },\n+                                'punctuation': /^\\s*=\\s*['\"]|['\"]\\s*$/,\n+                                'attr-value': {\n+                                        pattern: /.+/i,\n+                                        inside: Prism.languages.css\n+                                }\n+                        },\n+                        alias: 'language-css'\n+                }\n+        }, Prism.languages.markup.tag);\n }\n\\ No newline at end of file\ndiff --git a/comprehensive_important_test.js b/comprehensive_important_test.js\nnew file mode 100644\nindex 00000000..d36e8ccb\n--- /dev/null\n+++ b/comprehensive_important_test.js\n@@ -0,0 +1,100 @@\n+'use strict';\n+\n+// Comprehensive test for CSS !important tokenization fix\n+var fs = require('fs');\n+\n+// Load Prism components\n+eval(fs.readFileSync('./components/prism-core.js', 'utf8'));\n+eval(fs.readFileSync('./components/prism-css.js', 'utf8'));\n+\n+function testImportantTokenization(testName, cssCode, expectedImportantCount) {\n+    console.log('\\n=== ' + testName + ' ===');\n+    console.log('CSS: ' + cssCode);\n+    \n+    var tokens = Prism.tokenize(cssCode, Prism.languages.css);\n+    \n+    // Count important tokens\n+    var importantCount = 0;\n+    function countImportant(tokenArray) {\n+        for (var i = 0; i < tokenArray.length; i++) {\n+            var token = tokenArray[i];\n+            if (typeof token === 'object' && token.type === 'important') {\n+                importantCount++;\n+            } else if (typeof token === 'object' && Array.isArray(token.content)) {\n+                countImportant(token.content);\n+            }\n+        }\n+    }\n+    countImportant(tokens);\n+    \n+    console.log('Expected important tokens: ' + expectedImportantCount + ', Found: ' + importantCount);\n+    console.log('Tokens:', JSON.stringify(tokens, null, 2));\n+    \n+    if (importantCount === expectedImportantCount) {\n+        console.log('\u2705 PASS');\n+        return true;\n+    } else {\n+        console.log('\u274c FAIL');\n+        return false;\n+    }\n+}\n+\n+// Test cases\n+var tests = [\n+    // Basic cases\n+    ['Simple with space', 'color: red !important;', 1],\n+    ['No space before important', 'color: red!important;', 1],\n+    ['Multiple spaces', 'color: red   !important;', 1],\n+    \n+    // Multiple properties\n+    ['Multiple properties with space', 'color: red !important; background: blue !important;', 2],\n+    ['Multiple properties mixed spacing', 'color: red!important; background: blue !important;', 2],\n+    ['Multiple properties no space', 'color: red!important; background: blue!important;', 2],\n+    \n+    // Complex values\n+    ['Complex value with function', 'background: linear-gradient(to right, red, blue) !important;', 1],\n+    ['Complex value no space', 'background: linear-gradient(to right, red, blue)!important;', 1],\n+    ['Multiple values', 'margin: 10px 20px 30px 40px !important;', 1],\n+    ['Multiple values no space', 'margin: 10px 20px 30px 40px!important;', 1],\n+    \n+    // Edge cases\n+    ['URL with important', 'background: url(\"image.jpg\") !important;', 1],\n+    ['URL no space', 'background: url(\"image.jpg\")!important;', 1],\n+    ['Calc function', 'width: calc(100% - 20px) !important;', 1],\n+    ['Calc function no space', 'width: calc(100% - 20px)!important;', 1],\n+    \n+    // CSS block\n+    ['CSS block', '.test { color: red!important; background: blue !important; }', 2],\n+    \n+    // False positive prevention\n+    ['No false positive in string', 'content: \"This is !important text\";', 0],\n+    ['No false positive in comment', '/* This is !important comment */ color: red;', 0],\n+];\n+\n+var passCount = 0;\n+var totalTests = tests.length;\n+\n+console.log('Running comprehensive CSS !important tokenization tests...\\n');\n+\n+for (var i = 0; i < tests.length; i++) {\n+    var test = tests[i];\n+    var testName = test[0];\n+    var cssCode = test[1];\n+    var expectedCount = test[2];\n+    \n+    if (testImportantTokenization(testName, cssCode, expectedCount)) {\n+        passCount++;\n+    }\n+}\n+\n+console.log('\\n=== SUMMARY ===');\n+console.log('Passed: ' + passCount + '/' + totalTests);\n+console.log('Success rate: ' + (passCount/totalTests*100).toFixed(1) + '%');\n+\n+if (passCount === totalTests) {\n+    console.log('\ud83c\udf89 All tests passed! The fix is working correctly.');\n+    process.exit(0);\n+} else {\n+    console.log('\u274c Some tests failed. Please review the implementation.');\n+    process.exit(1);\n+}\n\\ No newline at end of file\ndiff --git a/debug_tokenization.html b/debug_tokenization.html\nnew file mode 100644\nindex 00000000..2bed8098\n--- /dev/null\n+++ b/debug_tokenization.html\n@@ -0,0 +1,56 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Debug CSS Tokenization</title>\n+    <style>\n+        .token.important { background: yellow; font-weight: bold; }\n+        .token.property { color: blue; }\n+        .token.punctuation { color: gray; }\n+        pre { border: 1px solid #ccc; padding: 10px; margin: 10px 0; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Debug CSS Tokenization</h1>\n+    \n+    <h2>Test 1: Simple case (should work)</h2>\n+    <pre><code class=\"language-css\">color: red !important;</code></pre>\n+    \n+    <h2>Test 2: No space before !important</h2>\n+    <pre><code class=\"language-css\">color: red!important;</code></pre>\n+    \n+    <h2>Test 3: Multiple values with important</h2>\n+    <pre><code class=\"language-css\">margin: 10px 20px !important;</code></pre>\n+    \n+    <h2>Test 4: Function with important</h2>\n+    <pre><code class=\"language-css\">background: url(image.jpg) !important;</code></pre>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-css.js\"></script>\n+    \n+    <script>\n+        // Debug function to show tokenization\n+        function debugTokens() {\n+            const codes = document.querySelectorAll('code.language-css');\n+            codes.forEach((code, index) => {\n+                const text = code.textContent;\n+                const tokens = Prism.tokenize(text, Prism.languages.css);\n+                console.log(`Test ${index + 1} tokens:`, tokens);\n+                \n+                // Create debug output\n+                const debugDiv = document.createElement('div');\n+                debugDiv.innerHTML = '<strong>Tokens:</strong> ' + JSON.stringify(tokens, null, 2);\n+                debugDiv.style.background = '#f0f0f0';\n+                debugDiv.style.padding = '10px';\n+                debugDiv.style.marginTop = '5px';\n+                debugDiv.style.fontSize = '12px';\n+                debugDiv.style.fontFamily = 'monospace';\n+                debugDiv.style.whiteSpace = 'pre-wrap';\n+                code.parentNode.parentNode.appendChild(debugDiv);\n+            });\n+        }\n+        \n+        // Run debug after highlighting\n+        setTimeout(debugTokens, 100);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_important_issue.html b/test_important_issue.html\nnew file mode 100644\nindex 00000000..eec6da2f\n--- /dev/null\n+++ b/test_important_issue.html\n@@ -0,0 +1,52 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>CSS Important Token Issue Test</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+</head>\n+<body>\n+    <h1>CSS Important Token Issue Test</h1>\n+    \n+    <h2>Test Case 1: Simple case (should work)</h2>\n+    <pre><code class=\"language-css\">color: red !important;</code></pre>\n+    \n+    <h2>Test Case 2: Value and statement together (issue case)</h2>\n+    <pre><code class=\"language-css\">color: red; background: blue !important;</code></pre>\n+    \n+    <h2>Test Case 3: Multiple properties with important</h2>\n+    <pre><code class=\"language-css\">\n+.test {\n+    color: red !important;\n+    background: blue !important;\n+    margin: 10px !important;\n+}\n+    </code></pre>\n+    \n+    <h2>Test Case 4: Complex CSS with functions and important</h2>\n+    <pre><code class=\"language-css\">\n+.complex {\n+    background: linear-gradient(to right, red, blue) !important;\n+    transform: translateX(10px) !important;\n+    box-shadow: 0 0 10px rgba(0,0,0,0.5) !important;\n+}\n+    </code></pre>\n+    \n+    <h2>Test Case 5: Inline styles</h2>\n+    <div style=\"color: red !important; background: blue !important;\">Inline styled element</div>\n+    \n+    <h2>Test Case 6: Edge cases</h2>\n+    <pre><code class=\"language-css\">\n+/* Various spacing around !important */\n+.edge-cases {\n+    color: red!important;\n+    background: blue !important ;\n+    margin: 10px  !important  ;\n+    padding: 5px   !important;\n+}\n+    </code></pre>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-css.js\"></script>\n+    <script src=\"components/prism-markup.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}
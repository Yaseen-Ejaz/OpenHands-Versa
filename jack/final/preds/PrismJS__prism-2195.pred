(?:[^\\S\\r\\n]_[^\\S\\r\\n]*(?:\\r\\n?|\\n)|.)+/i,\n+\t\talias: 'comment',\n+\t\tgreedy: true\n+\t},\n+\t'string': {\n+\t\tpattern: /\\$?[\"\u201c\u201d](?:[\"\u201c\u201d]{2}|[^\"\u201c\u201d])*[\"\u201c\u201d]C?/i,\n+\t\tgreedy: true\n+\t},\n+\t'date': {\n+\t\tpattern: /#[^\\S\\r\\n]*(?:\\d+([/-])\\d+\\1\\d+(?:[^\\S\\r\\n]+(?:\\d+[^\\S\\r\\n]*(?:AM|PM)|\\d+:\\d+(?::\\d+)?(?:[^\\S\\r\\n]*(?:AM|PM))?))?|(?:\\d+[^\\S\\r\\n]*(?:AM|PM)|\\d+:\\d+(?::\\d+)?(?:[^\\S\\r\\n]*(?:AM|PM))?))[^\\S\\r\\n]*#/i,\n+\t\talias: 'builtin'\n+\t},\n+\t'number': /(?:(?:\\b\\d+(?:\\.\\d+)?|\\.\\d+)(?:E[+-]?\\d+)?|&[HO][\\dA-F]+)(?:U?[ILS]|[FRD])?/i,\n+\t'boolean': /\\b(?:True|False|Nothing)\\b/i,\n+\t'keyword': /\\b(?:AddHandler|AddressOf|Alias|And(?:Also)?|As|Boolean|ByRef|Byte|ByVal|Call|Case|Catch|C(?:Bool|Byte|Char|Date|Dbl|Dec|Int|Lng|Obj|SByte|Short|Sng|Str|Type|UInt|ULng|UShort)|Char|Class|Const|Continue|Date|Decimal|Declare|Default|Delegate|Dim|DirectCast|Do|Double|Each|Else(?:If)?|End(?:If)?|Enum|Erase|Error|Event|Exit|Finally|For|Friend|Function|Get(?:Type|XMLNamespace)?|Global|GoSub|GoTo|Handles|If|Implements|Imports|In|Inherits|Integer|Interface|Is|IsNot|Let|Lib|Like|Long|Loop|Me|Mod|Module|Must(?:Inherit|Override)|My(?:Base|Class)|Namespace|Narrowing|New|Next|Not(?:Inheritable|Overridable)?|Object|Of|On|Operator|Option(?:al)?|Or(?:Else)?|Out|Overloads|Overridable|Overrides|ParamArray|Partial|Private|Property|Protected|Public|RaiseEvent|ReadOnly|ReDim|RemoveHandler|Resume|Return|SByte|Select|Set|Shadows|Shared|short|Single|Static|Step|Stop|String|Structure|Sub|SyncLock|Then|Throw|To|Try|TryCast|TypeOf|U(?:Integer|Long|Short)|Using|Variant|Wend|When|While|Widening|With(?:Events)?|WriteOnly|Xor)\\b/i,\n+\t'operator': [\n+\t\t/[+\\-*/\\\\^<=>&#@$%!]/,\n+\t\t{\n+\t\t\tpattern: /([^\\S\\r\\n])_(?=[^\\S\\r\\n]*[\\r\\n])/,\n+\t\t\tlookbehind: true\n+\t\t}\n+\t],\n+\t'punctuation': /[{}().,:?]/\n+};\n+\n+Prism.languages.vb = Prism.languages['visual-basic'];\n\\ No newline at end of file\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..d20ff6ce\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,14 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [06/Mar/2026 17:28:13] \"GET / HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:28:16] \"GET /test_vb_line_continuation.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:28:16] \"GET /components/prism-core.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:28:16] \"GET /components/prism-visual-basic.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:28:16] \"GET /themes/prism.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:30:14] \"GET /test_vb_line_continuation.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 17:30:14] \"GET /components/prism-visual-basic.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:30:14] \"GET /themes/prism.css HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 17:30:14] \"GET /components/prism-core.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 17:31:32] \"GET /test_vb_line_continuation.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 17:31:32] \"GET /components/prism-core.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 17:31:32] \"GET /components/prism-visual-basic.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:31:32] \"GET /themes/prism.css HTTP/1.1\" 304 -\ndiff --git a/test_comment_line_continuation.test b/test_comment_line_continuation.test\nnew file mode 100644\nindex 00000000..2f674d1e\n--- /dev/null\n+++ b/test_comment_line_continuation.test\n@@ -0,0 +1,25 @@\n+' Comment with line continuation _\n+continues here\n+REM Comment with line continuation _\n+also continues here\n+' Multiple line continuation _\n+spans _\n+multiple lines\n+Dim x As Integer\n+\n+----------------------------------------------------\n+\n+[\n+\t[\"comment\", [\"' Comment with line continuation _\\ncontinues here\"]],\n+\t[\"comment\", [[\"keyword\", \"REM\"], \" Comment with line continuation _\\nalso continues here\"]],\n+\t[\"comment\", [\"' Multiple line continuation _\\nspans _\\nmultiple lines\"]],\n+\t[\"keyword\", \"Dim\"],\n+\t\" x \",\n+\t[\"keyword\", \"As\"],\n+\t\" \",\n+\t[\"keyword\", \"Integer\"]\n+]\n+\n+----------------------------------------------------\n+\n+Checks for comments with line continuation.\n\\ No newline at end of file\ndiff --git a/test_line_continuation_comprehensive.js b/test_line_continuation_comprehensive.js\nnew file mode 100644\nindex 00000000..820c7ee1\n--- /dev/null\n+++ b/test_line_continuation_comprehensive.js\n@@ -0,0 +1,66 @@\n+// Test script to verify Visual Basic comment line continuation fix\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Load Prism\n+const Prism = require('./components/prism-core.js');\n+require('./components/prism-visual-basic.js');\n+\n+// Test cases\n+const testCases = [\n+    {\n+        name: \"Single quote comment with line continuation\",\n+        code: \"' This is a comment _\\nthat continues on the next line\\nDim x As Integer\",\n+        expected: \"comment should span two lines\"\n+    },\n+    {\n+        name: \"REM comment with line continuation\", \n+        code: \"REM This is a REM comment _\\nthat continues on the next line\\nDim y As String\",\n+        expected: \"REM comment should span two lines\"\n+    },\n+    {\n+        name: \"Multiple line continuations\",\n+        code: \"' This comment _\\nspans _\\nmultiple _\\nlines\\nDim z As Boolean\",\n+        expected: \"comment should span four lines\"\n+    },\n+    {\n+        name: \"Regular comment without continuation\",\n+        code: \"' Regular comment\\nDim a As Integer\",\n+        expected: \"comment should be single line\"\n+    },\n+    {\n+        name: \"REM without continuation\",\n+        code: \"REM Regular REM comment\\nDim b As String\", \n+        expected: \"REM comment should be single line\"\n+    }\n+];\n+\n+console.log(\"Testing Visual Basic comment line continuation fix...\\n\");\n+\n+testCases.forEach((testCase, index) => {\n+    console.log(`Test ${index + 1}: ${testCase.name}`);\n+    console.log(`Code: ${JSON.stringify(testCase.code)}`);\n+    \n+    try {\n+        const tokens = Prism.tokenize(testCase.code, Prism.languages['visual-basic']);\n+        console.log(\"Tokens:\", JSON.stringify(tokens, null, 2));\n+        \n+        // Check if comment tokens contain newlines (indicating line continuation worked)\n+        const commentTokens = tokens.filter(token => \n+            typeof token === 'object' && token.type === 'comment'\n+        );\n+        \n+        if (commentTokens.length > 0) {\n+            const hasLineContinuation = commentTokens.some(token => \n+                typeof token.content === 'string' && token.content.includes('\\n')\n+            );\n+            console.log(`Line continuation detected: ${hasLineContinuation}`);\n+        }\n+        \n+        console.log(\"\u2713 Test completed\\n\");\n+    } catch (error) {\n+        console.log(`\u2717 Test failed: ${error.message}\\n`);\n+    }\n+});\n+\n+console.log(\"All tests completed!\");\n\\ No newline at end of file\ndiff --git a/test_vb_line_continuation.html b/test_vb_line_continuation.html\nnew file mode 100644\nindex 00000000..e85074e1\n--- /dev/null\n+++ b/test_vb_line_continuation.html\n@@ -0,0 +1,43 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Visual Basic Line Continuation Test</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+</head>\n+<body>\n+    <h1>Visual Basic Comment Line Continuation Test</h1>\n+    \n+    <h2>Test Case 1: Single quote comment with line continuation</h2>\n+    <pre><code class=\"language-visual-basic\">' This is a comment _\n+that continues on the next line\n+Dim x As Integer</code></pre>\n+\n+    <h2>Test Case 2: REM comment with line continuation</h2>\n+    <pre><code class=\"language-visual-basic\">REM This is a REM comment _\n+that continues on the next line\n+Dim y As String</code></pre>\n+\n+    <h2>Test Case 3: Multiple line continuations</h2>\n+    <pre><code class=\"language-visual-basic\">' This comment _\n+spans _\n+multiple _\n+lines\n+Dim z As Boolean</code></pre>\n+\n+    <h2>Test Case 4: Mixed content</h2>\n+    <pre><code class=\"language-visual-basic\">Dim a As Integer\n+' Comment with continuation _\n+still part of comment\n+Dim b As String\n+REM Another comment _\n+also continues here\n+Dim c As Boolean</code></pre>\n+\n+    <h2>Test Case 5: Line continuation without comment (should work normally)</h2>\n+    <pre><code class=\"language-visual-basic\">Dim longVariableName As String = _\n+    \"This is a long string\"</code></pre>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-visual-basic.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

language-javascript\">const complex = `Hello ${name}, today is ${new Date().toDateString()}!`;\n+const nested = `Outer ${`inner ${variable}`} template`;\n+const multiline = `\n+  Line 1\n+  Line 2 ${expression}\n+  Line 3\n+`;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case pass\">\n+        <h3>Test 3: Mixed Quotes and Regex</h3>\n+        <pre><code class=\"language-javascript\">const regex1 = /test'quote/g;\n+const template1 = `template with 'single' and \"double\" quotes`;\n+const regex2 = /\"double\"/;\n+const template2 = `another template`;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case pass\">\n+        <h3>Test 4: Edge Cases</h3>\n+        <pre><code class=\"language-javascript\">// Escaped backticks\n+const escaped = `This has \\`escaped\\` backticks`;\n+\n+// Empty template\n+const empty = ``;\n+\n+// Template with only interpolation\n+const onlyInterp = `${value}`;\n+\n+// Regex followed immediately by template\n+const pattern = /abc/g; const tmpl = `template`;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case pass\">\n+        <h3>Test 5: Comments with Various Quote Types</h3>\n+        <pre><code class=\"language-javascript\">// Comment with `backticks`\n+/* Block comment with `backticks` */\n+// Comment with 'single quotes'\n+/* Block comment with \"double quotes\" */\n+\n+const afterComments = `should work fine`;</code></pre>\n+    </div>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-clike.js\"></script>\n+    <script src=\"components/prism-javascript.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/debug_test.html b/debug_test.html\nnew file mode 100644\nindex 00000000..5d7df63b\n--- /dev/null\n+++ b/debug_test.html\n@@ -0,0 +1,51 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Debug Template Literal Bug</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin: 20px 0; padding: 10px; border: 1px solid #ccc; }\n+        .token { border: 1px solid #999; margin: 2px; padding: 2px; display: inline-block; }\n+        .regex { background-color: #ffcccc; }\n+        .template-string { background-color: #ccffcc; }\n+        .string { background-color: #ccccff; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Debug Template Literal Bug</h1>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 1: Just the problematic line</h3>\n+        <pre><code class=\"language-javascript\">replace(/'/, `'`)</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 2: Add one template after</h3>\n+        <pre><code class=\"language-javascript\">replace(/'/, `'`)\n+const test = `should work`;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 3: Add comment with template</h3>\n+        <pre><code class=\"language-javascript\">replace(/'/, `'`)\n+// `comment template`\n+const test = `should break`;</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <h3>Test 4: Full reproduction</h3>\n+        <pre><code class=\"language-javascript\">replace(/'/, `'`)\n+\n+const var1 = `this is fine`;\n+\n+// `load bearing comment`\n+\n+const var3 = `break starts here`;</code></pre>\n+    </div>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-clike.js\"></script>\n+    <script src=\"components/prism-javascript.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/debug_test2.html b/debug_test2.html\nnew file mode 100644\nindex 00000000..567dedc7\n--- /dev/null\n+++ b/debug_test2.html\n@@ -0,0 +1,44 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Debug Template Literal Bug - Detailed</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin
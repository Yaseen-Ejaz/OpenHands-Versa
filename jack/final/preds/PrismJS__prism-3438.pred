nts/prism-core');\n+require('./components/prism-css');\n+\n+// Test cases for the issue\n+const testCases = [\n+    // The problematic case from the issue\n+    \"@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\",\n+    \n+    // Additional test cases\n+    \"@import url(\\\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\\\");\",\n+    \"@import url(https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap);\",\n+    \n+    // Simpler cases\n+    \"@import url('foo.css');\",\n+    \"@import url(\\\"foo.css\\\");\",\n+    \"@import url(foo.css);\",\n+];\n+\n+console.log('Testing CSS @import url() highlighting...\\n');\n+\n+testCases.forEach((testCase, index) => {\n+    console.log(`Test Case ${index + 1}: ${testCase}`);\n+    console.log('Tokens:');\n+    \n+    try {\n+        const tokens = Prism.tokenize(testCase, Prism.languages.css);\n+        console.log(JSON.stringify(tokens, null, 2));\n+    } catch (error) {\n+        console.log('Error:', error.message);\n+    }\n+    \n+    console.log('---\\n');\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

27.0.0.1 - - [06/Mar/2026 17:56:31] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 17:56:31] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/source/ImageArcGISRest.js b/src/ol/source/ImageArcGISRest.js\nindex 084d585b7..095966506 100644\n--- a/src/ol/source/ImageArcGISRest.js\n+++ b/src/ol/source/ImageArcGISRest.js\n@@ -31,7 +31,7 @@ import {createCanvasContext2D} from '../dom.js';\n  * @property {import(\"../proj.js\").ProjectionLike} [projection] Projection. Default is the view projection.\n  * The projection code must contain a numeric end portion separated by :\n  * or the entire code must form a valid ArcGIS SpatialReference definition.\n- * @property {number} [ratio=1.5] Ratio. `1` means image requests are the size of the map viewport,\n+ * @property {number} [ratio=1] Ratio. `1` means image requests are the size of the map viewport,\n  * `2` means twice the size of the map viewport, and so on.\n  * @property {Array<number>} [resolutions] Resolutions. If specified, requests will be made for\n  * these resolutions only.\n@@ -127,7 +127,7 @@ class ImageArcGISRest extends ImageSource {\n      * @private\n      * @type {number}\n      */\n-    this.ratio_ = options.ratio !== undefined ? options.ratio : 1.5;\n+    this.ratio_ = options.ratio !== undefined ? options.ratio : 1;\n   }\n \n   /**\ndiff --git a/test/browser/spec/ol/source/ImageArcGISRest.test.js b/test/browser/spec/ol/source/ImageArcGISRest.test.js\nindex 03001410e..28ec1e800 100644\n--- a/test/browser/spec/ol/source/ImageArcGISRest.test.js\n+++ b/test/browser/spec/ol/source/ImageArcGISRest.test.js\n@@ -214,4 +214,47 @@ describe('ol/source/ImageArcGISRest', function () {\n       expect(url).to.eql('http://test2.com/MapServer');\n     });\n   });\n+\n+  describe('ratio property', function () {\n+    it('has default ratio of 1 (fixed from 1.5)', function () {\n+      const source = new ImageArcGISRest(options);\n+      expect(source.ratio_).to.be(1);\n+    });\n+\n+    it('allows explicit ratio to be set', function () {\n+      const sourceWith15 = new ImageArcGISRest(\n+        Object.assign({ratio: 1.5}, options)\n+      );\n+      expect(sourceWith15.ratio_).to.be(1.5);\n+\n+      const sourceWith2 = new ImageArcGISRest(\n+        Object.assign({ratio: 2}, options)\n+      );\n+      expect(sourceWith2.ratio_).to.be(2);\n+    });\n+\n+    it('uses ratio 1 to preserve original extent (no scaling)', function () {\n+      const source = new ImageArcGISRest(options);\n+      const originalExtent = [0, 0, 1000, 1000];\n+      \n+      // Simulate the extent calculation logic from getImageInternal\n+      const extent = originalExtent.slice();\n+      const centerX = (extent[0] + extent[2]) / 2;\n+      const centerY = (extent[1] + extent[3]) / 2;\n+      \n+      if (source.ratio_ != 1) {\n+        const width = extent[2] - extent[0];\n+        const height = extent[3] - extent[1];\n+        const halfWidth = (source.ratio_ * width) / 2;\n+        const halfHeight = (source.ratio_ * height) / 2;\n+        extent[0] = centerX - halfWidth;\n+        extent[1] = centerY - halfHeight;\n+        extent[2] = centerX + halfWidth;\n+        extent[3] = centerY + halfHeight;\n+      }\n+      \n+      // With ratio 1, extent should remain unchanged\n+      expect(extent).to.eql(originalExtent);\n+    });\n+  });\n });\ndiff --git a/test_ratio_fix.js b/test_ratio_fix.js\nnew file mode 100644\nindex 000000000..31b0ee683\n--- /dev/null\n+++ b/test_ratio_fix.js\n@@ -0,0 +1,93 @@\n+/**\n+ * Test to verify the ImageArcGISRest ratio fix\n+ * This test verifies that the default ratio is now 1 instead of 1.5\n+ */\n+\n+import ImageArcGISRest from './src/ol/source/ImageArcGISRest.js';\n+\n+console.log('=== Testing ImageArcGISRest Ratio Fix ===');\n+\n+// Test 1: Verify default ratio is now 1 (fixed)\n+console.log('\\n1. Testing default ratio value after fix:');\n+const sourceDefault = new ImageArcGISRest({\n+  url: 'http://example.com/MapServer'\n+});\n+console.log('Default ratio after fix:', sourceDefault.ratio_);\n+\n+if (sourceDefault.ratio_ === 1) {\n+  console.log('\u2705 SUCCESS: Default ratio is now 1 (fixed)');\n+} else {\n+  console.log('\u274c FAILURE: Default ratio is still', sourceDefault.ratio_, '(should be 1)');\n+  process.exit(1);\n+}\n+\n+// Test 2: Verify explicit ratio setting still works\n+console.log('\\n2. Testing explicit ratio setting still works:');\n+const sourceExplicit15 = new ImageArcGISRest({\n+  url: 'http://example.com/MapServer',\n+  ratio: 1.5\n+});\n+console.log('Explicit ratio (set to 1.5):', sourceExplicit15.ratio_);\n+\n+if (sourceExplicit15.ratio_ === 1.5) {\n+  console.log('\u2705 SUCCESS: Explicit ratio setting works');\n+} else {\n+  console.log('\u274c FAILURE: Explicit ratio setting failed');\n+  process.exit(1);\n+}\n+\n+// Test 3: Verify explicit ratio setting to 2 works\n+const sourceExplicit2 = new ImageArcGISRest({\n+  url: 'http://example.com/MapServer',\n+  ratio: 2\n+});\n+console.log('Explicit ratio (set to 2):', sourceExplicit2.ratio_);\n+\n+if (sourceExplicit2.ratio_ === 2) {\n+  console.log('\u2705 SUCCESS: Explicit ratio setting to 2 works');\n+} else {\n+  console.log('\u274c FAILURE: Explicit ratio setting to 2 failed');\n+  process.exit(1);\n+}\n+\n+// Test 4: Test extent calculation with ratio 1 (should not modify extent)\n+console.log('\\n3. Testing extent calculations with ratio 1:');\n+function calculateExtentWithRatio(extent, ratio) {\n+  const extentCopy = extent.slice();\n+  const centerX = (extentCopy[0] + extentCopy[2]) / 2;\n+  const centerY = (extentCopy[1] + extentCopy[3]) / 2;\n+  \n+  if (ratio != 1) {\n+    const width = extentCopy[2] - extentCopy[0];\n+    const height = extentCopy[3] - extentCopy[1];\n+    const halfWidth = (ratio * width) / 2;\n+    const halfHeight = (ratio * height) / 2;\n+    extentCopy[0] = centerX - halfWidth;\n+    extentCopy[1] = centerY - halfHeight;\n+    extentCopy[2] = centerX + halfWidth;\n+    extentCopy[3] = centerY + halfHeight;\n+  }\n+  \n+  return extentCopy;\n+}\n+\n+const originalExtent = [0, 0, 1000, 1000];\n+const extentWithRatio1 = calculateExtentWithRatio(originalExtent, 1);\n+\n+console.log('Original extent:', originalExtent);\n+console.log('Extent with ratio 1:', extentWithRatio1);\n+\n+// With ratio 1, extent should remain unchanged\n+const extentsEqual = JSON.stringify(originalExtent) === JSON.stringify(extentWithRatio1);\n+if (extentsEqual) {\n+  console.log('\u2705 SUCCESS: Ratio 1 preserves original extent (no scaling)');\n+} else {\n+  console.log('\u274c FAILURE: Ratio 1 should preserve original extent');\n+  process.exit(1);\n+}\n+\n+console.log('\\n=== All Tests Passed! ===');\n+console.log('\u2705 Default ratio changed from 1.5 to 1');\n+console.log('\u2705 Explicit ratio setting still works');\n+console.log('\u2705 Ratio 1 preserves extent (fixes alignment issues)');\n+console.log('\u2705 Fix should resolve layer-map mismatch with scaling and rotation');\n\\ No newline at end of file\ndiff --git a/test_ratio_issue.html b/test_ratio_issue.html\nnew file mode 100644\nindex 000000000..fbade9378\n--- /dev/null\n+++ b/test_ratio_issue.html\n@@ -0,0 +1,235 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>ImageArcGISRest Ratio Issue Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            margin-bottom: 30px;\n+            border: 1px solid #ccc;\n+            padding: 15px;\n+        }\n+        .map-container {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #000;\n+            margin: 10px 0;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 5px 10px;\n+        }\n+        .info {\n+            background: #f0f0f0;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 5px;\n+        }\n+        .error {\n+            background: #ffebee;\n+            color: #c62828;\n+        }\n+        .success {\n+            background: #e8f5e8;\n+            color: #2e7d32;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>ImageArcGISRest Ratio Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Test Purpose:</h3>\n+        <p>This test reproduces the ImageArcGISRest ratio bug where:</p>\n+        <ul>\n+            <li>Default ratio of 1.5 causes layer-map mismatch with non-100% computer scaling</li>\n+            <li>Layer-map mismatch occurs after map rotation even with ratio 1.5</li>\n+            <li>Setting ratio to 1 fixes these issues</li>\n+        </ul>\n+    </div>\n+\n+    <!-- Test 1: Default Ratio (1.5) -->\n+    <div class=\"test-container\">\n+        <h3>Test 1: Default Ratio (1.5) - Should Show Issues</h3>\n+        <div id=\"map1\" class=\"map-container\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap1()\">Rotate Map</button>\n+            <button onclick=\"resetMap1()\">Reset</button>\n+            <span id=\"rotation1\">Rotation: 0\u00b0</span>\n+        </div>\n+        <div id=\"info1\" class=\"info\">\n+            Using default ratio (1.5). Check for layer-map alignment issues, especially after rotation.\n+        </div>\n+    </div>\n+\n+    <!-- Test 2: Fixed Ratio (1) -->\n+    <div class=\"test-container\">\n+        <h3>Test 2: Fixed Ratio (1) - Should Work Correctly</h3>\n+        <div id=\"map2\" class=\"map-container\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap2()\">Rotate Map</button>\n+            <button onclick=\"resetMap2()\">Reset</button>\n+            <span id=\"rotation2\">Rotation: 0\u00b0</span>\n+        </div>\n+        <div id=\"info2\" class=\"info\">\n+            Using ratio = 1. Should maintain proper layer-map alignment even after rotation.\n+        </div>\n+    </div>\n+\n+    <!-- Test 3: Ratio 2 -->\n+    <div class=\"test-container\">\n+        <h3>Test 3: Ratio (2) - Should Show Issues</h3>\n+        <div id=\"map3\" class=\"map-container\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap3()\">Rotate Map</button>\n+            <button onclick=\"resetMap3()\">Reset</button>\n+            <span id=\"rotation3\">Rotation: 0\u00b0</span>\n+        </div>\n+        <div id=\"info3\" class=\"info\">\n+            Using ratio = 2. Should show layer-map mismatch issues similar to default ratio.\n+        </div>\n+    </div>\n+\n+    <div class=\"info\">\n+        <h3>How to Test:</h3>\n+        <ol>\n+            <li>Set your browser zoom to 150% (Ctrl/Cmd + Plus) to simulate non-100% computer scaling</li>\n+            <li>Compare the three maps - look for alignment between the base OSM layer and ArcGIS layer</li>\n+            <li>Click \"Rotate Map\" on each test and observe if layers stay aligned</li>\n+            <li>The map with ratio=1 should maintain better alignment</li>\n+        </ol>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from '../src/ol/Map.js';\n+        import View from '../src/ol/View.js';\n+        import {ImageArcGISRest, OSM} from '../src/ol/source.js';\n+        import {Image as ImageLayer, Tile as TileLayer} from '../src/ol/layer.js';\n+\n+        const arcgisUrl = 'https://sampleserver6.arcgisonline.com/ArcGIS/rest/services/USA/MapServer';\n+        const center = [-10997148, 4569099];\n+        const zoom = 4;\n+\n+        let map1, map2, map3;\n+        let rotation1 = 0, rotation2 = 0, rotation3 = 0;\n+\n+        // Test 1: Default ratio (1.5)\n+        map1 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        // Using default ratio (1.5)\n+                        params: {},\n+                        url: arcgisUrl,\n+                    }),\n+                }),\n+            ],\n+            target: 'map1',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+\n+        // Test 2: Fixed ratio (1)\n+        map2 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        ratio: 1, // Fixed ratio\n+                        params: {},\n+                        url: arcgisUrl,\n+                    }),\n+                }),\n+            ],\n+            target: 'map2',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+\n+        // Test 3: Ratio 2\n+        map3 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        ratio: 2, // Higher ratio\n+                        params: {},\n+                        url: arcgisUrl,\n+                    }),\n+                }),\n+            ],\n+            target: 'map3',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+\n+        // Rotation functions\n+        window.rotateMap1 = function() {\n+            rotation1 += Math.PI / 4; // 45 degrees\n+            map1.getView().setRotation(rotation1);\n+            document.getElementById('rotation1').textContent = `Rotation: ${Math.round(rotation1 * 180 / Math.PI)}\u00b0`;\n+        };\n+\n+        window.resetMap1 = function() {\n+            rotation1 = 0;\n+            map1.getView().setRotation(rotation1);\n+            map1.getView().setCenter(center);\n+            map1.getView().setZoom(zoom);\n+            document.getElementById('rotation1').textContent = `Rotation: 0\u00b0`;\n+        };\n+\n+        window.rotateMap2 = function() {\n+            rotation2 += Math.PI / 4; // 45 degrees\n+            map2.getView().setRotation(rotation2);\n+            document.getElementById('rotation2').textContent = `Rotation: ${Math.round(rotation2 * 180 / Math.PI)}\u00b0`;\n+        };\n+\n+        window.resetMap2 = function() {\n+            rotation2 = 0;\n+            map2.getView().setRotation(rotation2);\n+            map2.getView().setCenter(center);\n+            map2.getView().setZoom(zoom);\n+            document.getElementById('rotation2').textContent = `Rotation: 0\u00b0`;\n+        };\n+\n+        window.rotateMap3 = function() {\n+            rotation3 += Math.PI / 4; // 45 degrees\n+            map3.getView().setRotation(rotation3);\n+            document.getElementById('rotation3').textContent = `Rotation: ${Math.round(rotation3 * 180 / Math.PI)}\u00b0`;\n+        };\n+\n+        window.resetMap3 = function() {\n+            rotation3 = 0;\n+            map3.getView().setRotation(rotation3);\n+            map3.getView().setCenter(center);\n+            map3.getView().setZoom(zoom);\n+            document.getElementById('rotation3').textContent = `Rotation: 0\u00b0`;\n+        };\n+\n+        // Add some debugging info\n+        console.log('Test setup complete');\n+        console.log('Map 1 (default ratio):', map1.getLayers().getArray()[1].getSource().ratio_);\n+        console.log('Map 2 (ratio=1):', map2.getLayers().getArray()[1].getSource().ratio_);\n+        console.log('Map 3 (ratio=2):', map3.getLayers().getArray()[1].getSource().ratio_);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_ratio_unit.js b/test_ratio_unit.js\nnew file mode 100644\nindex 000000000..c82620368\n--- /dev/null\n+++ b/test_ratio_unit.js\n@@ -0,0 +1,83 @@\n+/**\n+ * Unit test to verify the ImageArcGISRest ratio issue\n+ * This test checks the default ratio value and extent calculations\n+ */\n+\n+import ImageArcGISRest from './src/ol/source/ImageArcGISRest.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+\n+console.log('=== ImageArcGISRest Ratio Issue Test ===');\n+\n+// Test 1: Verify default ratio is 1.5 (current problematic behavior)\n+console.log('\\n1. Testing default ratio value:');\n+const sourceDefault = new ImageArcGISRest({\n+  url: 'http://example.com/MapServer'\n+});\n+console.log('Default ratio:', sourceDefault.ratio_);\n+console.log('Expected: 1.5 (current problematic default)');\n+console.log('Should be: 1 (after fix)');\n+\n+// Test 2: Verify explicit ratio setting works\n+console.log('\\n2. Testing explicit ratio setting:');\n+const sourceExplicit = new ImageArcGISRest({\n+  url: 'http://example.com/MapServer',\n+  ratio: 1\n+});\n+console.log('Explicit ratio (set to 1):', sourceExplicit.ratio_);\n+\n+// Test 3: Test extent calculation differences\n+console.log('\\n3. Testing extent calculations:');\n+const projection = getProjection('EPSG:3857');\n+const originalExtent = [0, 0, 1000, 1000]; // 1000x1000 extent\n+const resolution = 1;\n+const pixelRatio = 1;\n+\n+// Mock the getImageInternal method behavior for extent calculation\n+function calculateExtentWithRatio(extent, ratio) {\n+  const extentCopy = extent.slice();\n+  const centerX = (extentCopy[0] + extentCopy[2]) / 2;\n+  const centerY = (extentCopy[1] + extentCopy[3]) / 2;\n+  \n+  if (ratio != 1) {\n+    const width = extentCopy[2] - extentCopy[0];\n+    const height = extentCopy[3] - extentCopy[1];\n+    const halfWidth = (ratio * width) / 2;\n+    const halfHeight = (ratio * height) / 2;\n+    extentCopy[0] = centerX - halfWidth;\n+    extentCopy[1] = centerY - halfHeight;\n+    extentCopy[2] = centerX + halfWidth;\n+    extentCopy[3] = centerY + halfHeight;\n+  }\n+  \n+  return extentCopy;\n+}\n+\n+const extentRatio1 = calculateExtentWithRatio(originalExtent, 1);\n+const extentRatio15 = calculateExtentWithRatio(originalExtent, 1.5);\n+const extentRatio2 = calculateExtentWithRatio(originalExtent, 2);\n+\n+console.log('Original extent:', originalExtent);\n+console.log('With ratio 1.0:', extentRatio1);\n+console.log('With ratio 1.5:', extentRatio15);\n+console.log('With ratio 2.0:', extentRatio2);\n+\n+// Calculate the differences\n+const widthOriginal = originalExtent[2] - originalExtent[0];\n+const heightOriginal = originalExtent[3] - originalExtent[1];\n+const width15 = extentRatio15[2] - extentRatio15[0];\n+const height15 = extentRatio15[3] - extentRatio15[1];\n+\n+console.log('\\nExtent size analysis:');\n+console.log('Original size: ' + widthOriginal + 'x' + heightOriginal);\n+console.log('Ratio 1.5 size: ' + width15 + 'x' + height15);\n+console.log('Size increase with ratio 1.5: ' + (width15/widthOriginal) + 'x');\n+\n+console.log('\\n=== Test Results ===');\n+console.log('\u2713 Default ratio is currently 1.5 (problematic)');\n+console.log('\u2713 Explicit ratio setting works');\n+console.log('\u2713 Ratio 1.5 increases requested image size by 1.5x');\n+console.log('\u2713 This larger image size can cause alignment issues with scaling and rotation');\n+\n+console.log('\\n=== Recommended Fix ===');\n+console.log('Change default ratio from 1.5 to 1 in ImageArcGISRest constructor');\n+console.log('Line 130: this.ratio_ = options.ratio !== undefined ? options.ratio : 1;');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

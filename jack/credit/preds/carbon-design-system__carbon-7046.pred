{"instance_id": "carbon-design-system__carbon-7046", "model_patch": "diff --git a/packages/react/src/components/TimePicker/TimePicker-story.js b/packages/react/src/components/TimePicker/TimePicker-story.js\nindex 2bb1c7667..550f7e8dc 100644\n--- a/packages/react/src/components/TimePicker/TimePicker-story.js\n+++ b/packages/react/src/components/TimePicker/TimePicker-story.js\n@@ -8,7 +8,7 @@\n import React from 'react';\n import { action } from '@storybook/addon-actions';\n \n-import { withKnobs, boolean, number, text } from '@storybook/addon-knobs';\n+import { withKnobs, boolean, number, text, select } from '@storybook/addon-knobs';\n import TimePicker from '../TimePicker';\n import TimePickerSelect from '../TimePickerSelect';\n import SelectItem from '../SelectItem';\n@@ -36,6 +36,15 @@ const props = {\n       'A valid value is required'\n     ),\n     maxLength: number('Maximum length (maxLength in <TimePicker>)', 5),\n+    size: select(\n+      'Size (size in <TimePicker>)',\n+      {\n+        'Default (40px)': undefined,\n+        'Small (32px)': 'sm',\n+        'Extra Large (48px)': 'xl',\n+      },\n+      undefined\n+    ),\n     onClick: action('onClick'),\n     onChange: action('onChange'),\n     onBlur: action('onBlur'),\ndiff --git a/packages/react/src/components/TimePicker/TimePicker.js b/packages/react/src/components/TimePicker/TimePicker.js\nindex 1d2c597a4..2c4339a86 100644\n--- a/packages/react/src/components/TimePicker/TimePicker.js\n+++ b/packages/react/src/components/TimePicker/TimePicker.js\n@@ -95,6 +95,11 @@ export default class TimePicker extends Component {\n      */\n     placeholder: PropTypes.string,\n \n+    /**\n+     * Specify the size of the TimePicker. Currently supports either `sm` or `xl` as an option.\n+     */\n+    size: PropTypes.oneOf(['sm', 'xl']),\n+\n     /**\n      * Specify the type of the `<input>`\n      */\n@@ -147,6 +152,7 @@ export default class TimePicker extends Component {\n       invalid,\n       hideLabel,\n       light,\n+      size,\n       ...other\n     } = this.props;\n \n@@ -157,6 +163,7 @@ export default class TimePicker extends Component {\n         className,\n         {\n           [`${prefix}--text-input--light`]: light,\n+          [`${prefix}--text-input--${size}`]: size,\n         }\n       ),\n \ndiff --git a/test-timepicker-sizes.js b/test-timepicker-sizes.js\nnew file mode 100644\nindex 000000000..2572053fc\n--- /dev/null\n+++ b/test-timepicker-sizes.js\n@@ -0,0 +1,113 @@\n+/**\n+ * Test file for TimePicker size variants\n+ * This file tests the implementation of 32px and 48px size variants for TimePicker\n+ */\n+\n+import React from 'react';\n+import { render } from '@testing-library/react';\n+import TimePicker from './packages/react/src/components/TimePicker/TimePicker';\n+import TimePickerSelect from './packages/react/src/components/TimePickerSelect/TimePickerSelect';\n+import SelectItem from './packages/react/src/components/SelectItem/SelectItem';\n+\n+describe('TimePicker Size Variants', () => {\n+  const defaultProps = {\n+    id: 'test-time-picker',\n+    labelText: 'Select a time',\n+  };\n+\n+  it('should render default TimePicker without size prop', () => {\n+    const { container } = render(<TimePicker {...defaultProps} />);\n+    const input = container.querySelector('.bx--time-picker__input-field');\n+    \n+    // Current implementation should have default height (40px)\n+    expect(input).toBeTruthy();\n+    console.log('Default TimePicker classes:', input.className);\n+  });\n+\n+  it('should render TimePicker with sm size (32px)', () => {\n+    const { container } = render(<TimePicker {...defaultProps} size=\"sm\" />);\n+    const input = container.querySelector('.bx--time-picker__input-field');\n+    \n+    // Should have sm size class\n+    expect(input).toBeTruthy();\n+    expect(input.className).toContain('bx--text-input--sm');\n+    console.log('Small TimePicker classes:', input.className);\n+  });\n+\n+  it('should render TimePicker with xl size (48px)', () => {\n+    const { container } = render(<TimePicker {...defaultProps} size=\"xl\" />);\n+    const input = container.querySelector('.bx--time-picker__input-field');\n+    \n+    // Should have xl size class\n+    expect(input).toBeTruthy();\n+    expect(input.className).toContain('bx--text-input--xl');\n+    console.log('Large TimePicker classes:', input.className);\n+  });\n+\n+  it('should render TimePicker with TimePickerSelect and maintain size consistency', () => {\n+    const { container } = render(\n+      <TimePicker {...defaultProps} size=\"sm\">\n+        <TimePickerSelect id=\"time-picker-select-1\" labelText=\"AM/PM\">\n+          <SelectItem value=\"AM\" text=\"AM\" />\n+          <SelectItem value=\"PM\" text=\"PM\" />\n+        </TimePickerSelect>\n+      </TimePicker>\n+    );\n+    \n+    const input = container.querySelector('.bx--time-picker__input-field');\n+    const select = container.querySelector('.bx--select-input');\n+    \n+    expect(input).toBeTruthy();\n+    expect(select).toBeTruthy();\n+    console.log('TimePicker with select - input classes:', input.className);\n+    console.log('TimePicker with select - select classes:', select.className);\n+  });\n+\n+  it('should handle invalid size prop gracefully', () => {\n+    const { container } = render(<TimePicker {...defaultProps} size=\"invalid\" />);\n+    const input = container.querySelector('.bx--time-picker__input-field');\n+    \n+    // Should fallback to default behavior\n+    expect(input).toBeTruthy();\n+    console.log('Invalid size TimePicker classes:', input.className);\n+  });\n+});\n+\n+// Visual test component for manual verification\n+export const TimePicerSizeTestComponent = () => {\n+  return (\n+    <div style={{ padding: '20px', fontFamily: 'IBM Plex Sans' }}>\n+      <h2>TimePicker Size Variants Test</h2>\n+      \n+      <div style={{ marginBottom: '20px' }}>\n+        <h3>Default Size (40px)</h3>\n+        <TimePicker id=\"default\" labelText=\"Default TimePicker\">\n+          <TimePickerSelect id=\"default-select\" labelText=\"AM/PM\">\n+            <SelectItem value=\"AM\" text=\"AM\" />\n+            <SelectItem value=\"PM\" text=\"PM\" />\n+          </TimePickerSelect>\n+        </TimePicker>\n+      </div>\n+\n+      <div style={{ marginBottom: '20px' }}>\n+        <h3>Small Size (32px)</h3>\n+        <TimePicker id=\"small\" labelText=\"Small TimePicker\" size=\"sm\">\n+          <TimePickerSelect id=\"small-select\" labelText=\"AM/PM\">\n+            <SelectItem value=\"AM\" text=\"AM\" />\n+            <SelectItem value=\"PM\" text=\"PM\" />\n+          </TimePickerSelect>\n+        </TimePicker>\n+      </div>\n+\n+      <div style={{ marginBottom: '20px' }}>\n+        <h3>Extra Large Size (48px)</h3>\n+        <TimePicker id=\"large\" labelText=\"Large TimePicker\" size=\"xl\">\n+          <TimePickerSelect id=\"large-select\" labelText=\"AM/PM\">\n+            <SelectItem value=\"AM\" text=\"AM\" />\n+            <SelectItem value=\"PM\" text=\"PM\" />\n+          </TimePickerSelect>\n+        </TimePicker>\n+      </div>\n+    </div>\n+  );\n+};\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

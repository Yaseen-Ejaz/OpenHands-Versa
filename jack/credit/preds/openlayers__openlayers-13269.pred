te.projection\n           );\n           if (!tileTexture) {\n-            tileTexture = new TileTexture(tile, tileGrid, this.helper);\n+            const gutter = tileSource.getGutterForProjection ? \n+              tileSource.getGutterForProjection(viewState.projection) : 0;\n+            tileTexture = new TileTexture(tile, tileGrid, this.helper, gutter);\n             tileTextureCache.set(cacheKey, tileTexture);\n           } else {\n             if (this.isDrawableTile_(tile)) {\ndiff --git a/src/ol/webgl/TileTexture.js b/src/ol/webgl/TileTexture.js\nindex 8bba95b87..836248e8e 100644\n--- a/src/ol/webgl/TileTexture.js\n+++ b/src/ol/webgl/TileTexture.js\n@@ -9,6 +9,7 @@ import ReprojTile from '../reproj/Tile.js';\n import TileState from '../TileState.js';\n import WebGLArrayBuffer from './Buffer.js';\n import {ARRAY_BUFFER, STATIC_DRAW} from '../webgl.js';\n+import {createCanvasContext2D} from '../dom.js';\n import {toSize} from '../size.js';\n \n /**\n@@ -123,8 +124,9 @@ class TileTexture extends EventTarget {\n    * @param {TileType} tile The tile.\n    * @param {import(\"../tilegrid/TileGrid.js\").default} grid Tile grid.\n    * @param {import(\"../webgl/Helper.js\").default} helper WebGL helper.\n+   * @param {number} [gutter=0] Gutter size in pixels.\n    */\n-  constructor(tile, grid, helper) {\n+  constructor(tile, grid, helper, gutter) {\n     super();\n \n     /**\n@@ -144,6 +146,12 @@ class TileTexture extends EventTarget {\n \n     this.helper_ = helper;\n \n+    /**\n+     * @type {number}\n+     * @private\n+     */\n+    this.gutter_ = gutter || 0;\n+\n     const coords = new WebGLArrayBuffer(ARRAY_BUFFER, STATIC_DRAW);\n     coords.fromArray([\n       0, // P0\n@@ -195,7 +203,15 @@ class TileTexture extends EventTarget {\n       const texture = gl.createTexture();\n       this.textures.push(texture);\n       this.bandCount = 4;\n-      uploadImageTexture(gl, texture, tile.getImage(), tile.interpolate);\n+      \n+      let image = tile.getImage();\n+      \n+      // Apply gutter clipping if gutter is specified\n+      if (this.gutter_ > 0) {\n+        image = this.clipImageGutter_(image);\n+      }\n+      \n+      uploadImageTexture(gl, texture, image, tile.interpolate);\n       return;\n     }\n \n@@ -268,6 +284,40 @@ class TileTexture extends EventTarget {\n     }\n   }\n \n+  /**\n+   * Clip the gutter from an image.\n+   * @param {HTMLImageElement|HTMLCanvasElement|HTMLVideoElement} image The image to clip.\n+   * @return {HTMLCanvasElement} The clipped image.\n+   * @private\n+   */\n+  clipImageGutter_(image) {\n+    const gutter = this.gutter_;\n+    const sourceWidth = image.width || image.naturalWidth;\n+    const sourceHeight = image.height || image.naturalHeight;\n+    \n+    // Calculate clipped dimensions\n+    const clippedWidth = sourceWidth - 2 * gutter;\n+    const clippedHeight = sourceHeight - 2 * gutter;\n+    \n+    // Create a canvas to draw the clipped image\n+    const context = createCanvasContext2D(clippedWidth, clippedHeight);\n+    \n+    // Draw the image with gutter clipped\n+    context.drawImage(\n+      image,\n+      gutter, // source x\n+      gutter, // source y\n+      clippedWidth, // source width\n+      clippedHeight, // source height\n+      0, // destination x\n+      0, // destination y\n+      clippedWidth, // destination width\n+      clippedHeight // destination height\n+    );\n+    \n+    return context.canvas;\n+  }\n+\n   handleTileChange_() {\n     if (this.tile.getState() === TileState.LOADED) {\n       this.loaded = true;\ndiff --git a/test_gutter_issue.html b/test_gutter_issue.html\nnew file mode 100644\nindex 000000000..21aab5ead\n--- /dev/null\n+++ b/test_gutter_issue.html\n@@ -0,0 +1,88 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Gutter Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map-container { \n+            display: flex; \n+            gap: 20px; \n+            margin-bottom: 20px;\n+        }\n+        .map { \n+            width: 400px; \n+            height: 300px; \n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin-bottom: 10px;\n+            font-weight: bold;\n+        }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@6.12.0/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@6.12.0/ol.css\">\n+</head>\n+<body>\n+    <h1>WebGL Tile Gutter Issue Test</h1>\n+    \n+    <div class=\"info\">Left: Regular Tile Layer (should work correctly)</div>\n+    <div class=\"info\">Right: WebGL Tile Layer (should show gutter issue)</div>\n+    \n+    <div class=\"map-container\">\n+        <div id=\"map1\" class=\"map\"></div>\n+        <div id=\"map2\" class=\"map\"></div>\n+    </div>\n+\n+    <script>\n+        // Test WMS source with gutter\n+        const wmsSource = new ol.source.TileWMS({\n+            url: 'https://ahocevar.com/geoserver/wms',\n+            params: {\n+                'LAYERS': 'ne:ne',\n+                'TILED': true\n+            },\n+            gutter: 20, // This should cause issues in WebGL layer\n+            serverType: 'geoserver'\n+        });\n+\n+        // Regular Tile Layer (should work correctly)\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: wmsSource\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        // WebGL Tile Layer (should show gutter issue)\n+        const map2 = new ol.Map({\n+            target: 'map2',\n+            layers: [\n+                new ol.layer.WebGLTile({\n+                    source: new ol.source.TileWMS({\n+                        url: 'https://ahocevar.com/geoserver/wms',\n+                        params: {\n+                            'LAYERS': 'ne:ne',\n+                            'TILED': true\n+                        },\n+                        gutter: 20, // This should cause issues in WebGL layer\n+                        serverType: 'geoserver'\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        console.log('Test maps created. Compare the rendering between regular Tile layer (left) and WebGL Tile layer (right)');\n+        console.log('The WebGL layer should show misplacement/duplication due to gutter not being clipped');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_gutter_fix.js b/test_webgl_gutter_fix.js\nnew file mode 100644\nindex 000000000..40a9440e2\n--- /dev/null\n+++ b/test_webgl_gutter_fix.js\n@@ -0,0 +1,107 @@\n+/**\n+ * Test for WebGL Tile Gutter Fix\n+ */\n+\n+import TileTexture from '../src/ol/webgl/TileTexture.js';\n+import ImageTile from '../src/ol/ImageTile.js';\n+import TileGrid from '../src/ol/tilegrid/TileGrid.js';\n+import TileState from '../src/ol/TileState.js';\n+import {createCanvasContext2D} from '../src/ol/dom.js';\n+\n+// Mock WebGL helper\n+const mockHelper = {\n+  getGL: () => ({\n+    createTexture: () => ({}),\n+    bindTexture: () => {},\n+    texParameteri: () => {},\n+    texImage2D: () => {},\n+    TEXTURE_2D: 'TEXTURE_2D',\n+    CLAMP_TO_EDGE: 'CLAMP_TO_EDGE',\n+    TEXTURE_WRAP_S: 'TEXTURE_WRAP_S',\n+    TEXTURE_WRAP_T: 'TEXTURE_WRAP_T',\n+    TEXTURE_MIN_FILTER: 'TEXTURE_MIN_FILTER',\n+    TEXTURE_MAG_FILTER: 'TEXTURE_MAG_FILTER',\n+    LINEAR: 'LINEAR',\n+    NEAREST: 'NEAREST',\n+    RGBA: 'RGBA',\n+    UNSIGNED_BYTE: 'UNSIGNED_BYTE'\n+  }),\n+  flushBufferData: () => {},\n+  deleteBuffer: () => {}\n+};\n+\n+// Create a test image with gutter\n+function createTestImageWithGutter(tileSize, gutter) {\n+  const totalSize = tileSize + 2 * gutter;\n+  const context = createCanvasContext2D(totalSize, totalSize);\n+  \n+  // Fill the entire image with red (gutter area)\n+  context.fillStyle = 'red';\n+  context.fillRect(0, 0, totalSize, totalSize);\n+  \n+  // Fill the center (actual tile content) with blue\n+  context.fillStyle = 'blue';\n+  context.fillRect(gutter, gutter, tileSize, tileSize);\n+  \n+  return context.canvas;\n+}\n+\n+// Test function\n+function testGutterClipping() {\n+  console.log('Testing WebGL Tile Gutter Clipping...');\n+  \n+  const tileSize = 256;\n+  const gutter = 20;\n+  const tileGrid = new TileGrid({\n+    tileSize: [tileSize, tileSize],\n+    resolutions: [1]\n+  });\n+  \n+  // Create a test image with gutter\n+  const testImage = createTestImageWithGutter(tileSize, gutter);\n+  \n+  // Create a mock tile\n+  const tile = new ImageTile([0, 0, 0], TileState.LOADED, '', null, () => {});\n+  tile.setImage(testImage);\n+  \n+  // Test without gutter (should use original image)\n+  const tileTextureNoGutter = new TileTexture(tile, tileGrid, mockHelper, 0);\n+  console.log('Without gutter - image dimensions:', testImage.width, 'x', testImage.height);\n+  \n+  // Test with gutter (should clip the image)\n+  const tileTextureWithGutter = new TileTexture(tile, tileGrid, mockHelper, gutter);\n+  \n+  // Access the private method for testing\n+  const clippedImage = tileTextureWithGutter.clipImageGutter_(testImage);\n+  console.log('With gutter - clipped image dimensions:', clippedImage.width, 'x', clippedImage.height);\n+  \n+  // Verify the clipped image has correct dimensions\n+  const expectedWidth = testImage.width - 2 * gutter;\n+  const expectedHeight = testImage.height - 2 * gutter;\n+  \n+  if (clippedImage.width === expectedWidth && clippedImage.height === expectedHeight) {\n+    console.log('\u2713 Gutter clipping test PASSED');\n+    console.log(`  Original: ${testImage.width}x${testImage.height}`);\n+    console.log(`  Clipped: ${clippedImage.width}x${clippedImage.height}`);\n+    console.log(`  Expected: ${expectedWidth}x${expectedHeight}`);\n+    return true;\n+  } else {\n+    console.log('\u2717 Gutter clipping test FAILED');\n+    console.log(`  Original: ${testImage.width}x${testImage.height}`);\n+    console.log(`  Clipped: ${clippedImage.width}x${clippedImage.height}`);\n+    console.log(`  Expected: ${expectedWidth}x${expectedHeight}`);\n+    return false;\n+  }\n+}\n+\n+// Run the test\n+if (typeof window !== 'undefined') {\n+  // Browser environment\n+  window.testGutterClipping = testGutterClipping;\n+  console.log('Test function available as window.testGutterClipping()');\n+} else {\n+  // Node environment\n+  testGutterClipping();\n+}\n+\n+export { testGutterClipping };\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

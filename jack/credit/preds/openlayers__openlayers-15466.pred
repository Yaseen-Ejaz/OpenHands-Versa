n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/webgl/PostProcessingPass.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/webgl/ContextEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/webgl/BaseTileRepresentation.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/control/Control.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/interaction/Interaction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/interaction/Pointer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/events/condition.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/interaction/DragBox.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/events/Key.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/geom/flat/linechunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:58:59] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:59:45] \"GET /test_ignorePlacement_simple.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:59:45] \"GET /build/ol/ol.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:59:45] \"GET /build/full/ol.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/style/Image.js b/src/ol/style/Image.js\nindex be788cd4d..284a851c1 100644\n--- a/src/ol/style/Image.js\n+++ b/src/ol/style/Image.js\n@@ -11,7 +11,9 @@ import {toSize} from '../size.js';\n  * @property {number} rotation Rotation.\n  * @property {number|import(\"../size.js\").Size} scale Scale.\n  * @property {Array<number>} displacement Displacement.\n- * @property {\"declutter\"|\"obstacle\"|\"none\"|undefined} declutterMode Declutter mode: `declutter`, `obstacle`, 'none */\n+ * @property {\"declutter\"|\"obstacle\"|\"none\"|undefined} declutterMode Declutter mode: `declutter`, `obstacle`, 'none'\n+ * @property {boolean} [ignorePlacement=false] Ignore placement of other elements during decluttering.\n+ */\n \n /**\n  * @classdesc\n@@ -67,6 +69,12 @@ class ImageStyle {\n      * @type {\"declutter\"|\"obstacle\"|\"none\"|undefined}\n      */\n     this.declutterMode_ = options.declutterMode;\n+\n+    /**\n+     * @private\n+     * @type {boolean}\n+     */\n+    this.ignorePlacement_ = options.ignorePlacement !== undefined ? options.ignorePlacement : false;\n   }\n \n   /**\n@@ -83,6 +91,7 @@ class ImageStyle {\n       rotateWithView: this.getRotateWithView(),\n       displacement: this.getDisplacement().slice(),\n       declutterMode: this.getDeclutterMode(),\n+      ignorePlacement: this.getIgnorePlacement(),\n     });\n   }\n \n@@ -148,6 +157,15 @@ class ImageStyle {\n     return this.declutterMode_;\n   }\n \n+  /**\n+   * Get the ignore placement setting.\n+   * @return {boolean} Ignore placement.\n+   * @api\n+   */\n+  getIgnorePlacement() {\n+    return this.ignorePlacement_;\n+  }\n+\n   /**\n    * Get the anchor point in pixels. The anchor determines the center point for the\n    * symbolizer.\ndiff --git a/src/ol/style/Text.js b/src/ol/style/Text.js\nindex d76110b7c..449590665 100644\n--- a/src/ol/style/Text.js\n+++ b/src/ol/style/Text.js\n@@ -62,6 +62,7 @@ const DEFAULT_FILL_COLOR = '#333';\n  * is `'point'`. Default is no stroke.\n  * @property {Array<number>} [padding=[0, 0, 0, 0]] Padding in pixels around the text for decluttering and background. The order of\n  * values in the array is `[top, right, bottom, left]`.\n+ * @property {boolean} [ignorePlacement=false] Ignore placement of other elements during decluttering.\n  */\n \n /**\n@@ -204,6 +205,12 @@ class Text {\n      * @type {Array<number>|null}\n      */\n     this.padding_ = options.padding === undefined ? null : options.padding;\n+\n+    /**\n+     * @private\n+     * @type {boolean}\n+     */\n+    this.ignorePlacement_ = options.ignorePlacement !== undefined ? options.ignorePlacement : false;\n   }\n \n   /**\n@@ -237,6 +244,7 @@ class Text {\n         ? this.getBackgroundStroke().clone()\n         : undefined,\n       padding: this.getPadding() || undefined,\n+      ignorePlacement: this.getIgnorePlacement(),\n     });\n   }\n \n@@ -419,6 +427,15 @@ class Text {\n     return this.padding_;\n   }\n \n+  /**\n+   * Get the ignore placement setting.\n+   * @return {boolean} Ignore placement.\n+   * @api\n+   */\n+  getIgnorePlacement() {\n+    return this.ignorePlacement_;\n+  }\n+\n   /**\n    * Set the `overflow` property.\n    *\n@@ -608,6 +625,16 @@ class Text {\n   setPadding(padding) {\n     this.padding_ = padding;\n   }\n+\n+  /**\n+   * Set the ignore placement setting.\n+   *\n+   * @param {boolean} ignorePlacement Ignore placement.\n+   * @api\n+   */\n+  setIgnorePlacement(ignorePlacement) {\n+    this.ignorePlacement_ = ignorePlacement;\n+  }\n }\n \n export default Text;\ndiff --git a/test_ignorePlacement.html b/test_ignorePlacement.html\nnew file mode 100644\nindex 000000000..715f405e3\n--- /dev/null\n+++ b/test_ignorePlacement.html\n@@ -0,0 +1,176 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test ignorePlacement Option</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map-container { \n+            width: 800px; \n+            height: 600px; \n+            border: 1px solid #ccc; \n+            margin: 10px 0;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+            background: #f9f9f9;\n+        }\n+        h2 { color: #333; }\n+        h3 { color: #666; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Test ignorePlacement Option for Image+Text Combinations</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: Current Behavior (Both Image and Text Decluttered)</h2>\n+        <p>This shows the current behavior where both image and text are decluttered together.</p>\n+        <div id=\"map1\" class=\"map-container\"></div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: Desired Behavior (Only Text Decluttered, Images Always Visible)</h2>\n+        <p>This should show images always visible but text decluttered when ignorePlacement is implemented.</p>\n+        <div id=\"map2\" class=\"map-container\"></div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 3: Desired Behavior (Only Images Decluttered, Text Always Visible)</h2>\n+        <p>This should show text always visible but images decluttered when ignorePlacement is implemented.</p>\n+        <div id=\"map3\" class=\"map-container\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import {Feature, Map, View} from './src/ol/index.js';\n+        import {Vector as VectorLayer} from './src/ol/layer.js';\n+        import {Vector as VectorSource} from './src/ol/source.js';\n+        import {Point} from './src/ol/geom.js';\n+        import {Icon, Style, Text, Fill, Stroke} from './src/ol/style.js';\n+\n+        // Create test features with overlapping points\n+        const features = [];\n+        const positions = [\n+            [0, 0], [10, 10], [5, 5], [15, 15], [8, 8], [12, 12],\n+            [20, 20], [25, 25], [22, 22], [18, 18], [30, 30], [35, 35]\n+        ];\n+        \n+        positions.forEach((pos, index) => {\n+            features.push(new Feature({\n+                geometry: new Point(pos),\n+                name: `Point ${index + 1}`\n+            }));\n+        });\n+\n+        const source = new VectorSource({features});\n+\n+        // Test 1: Current behavior - both image and text decluttered\n+        const layer1 = new VectorLayer({\n+            source: source,\n+            declutter: true,\n+            style: new Style({\n+                image: new Icon({\n+                    anchor: [0.5, 1],\n+                    anchorXUnits: 'fraction',\n+                    anchorYUnits: 'fraction',\n+                    src: 'data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHZpZXdCb3g9IjAgMCAyMCAyMCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iOCIgZmlsbD0iIzAwN2NmZiIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utd2lkdGg9IjIiLz4KPC9zdmc+',\n+                    scale: 1.5\n+                }),\n+                text: new Text({\n+                    text: feature => feature.get('name'),\n+                    font: '12px Arial',\n+                    fill: new Fill({color: '#000'}),\n+                    stroke: new Stroke({color: '#fff', width: 2}),\n+                    offsetY: -25\n+                })\n+            })\n+        });\n+\n+        // Test 2: Desired behavior - only text decluttered (images always visible)\n+        const layer2 = new VectorLayer({\n+            source: source,\n+            declutter: true,\n+            style: new Style({\n+                image: new Icon({\n+                    anchor: [0.5, 1],\n+                    anchorXUnits: 'fraction',\n+                    anchorYUnits: 'fraction',\n+                    src: 'data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHZpZXdCb3g9IjAgMCAyMCAyMCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iOCIgZmlsbD0iIzAwN2NmZiIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utd2lkdGg9IjIiLz4KPC9zdmc+',\n+                    scale: 1.5,\n+                    // This should make images ignore decluttering when implemented\n+                    ignorePlacement: true\n+                }),\n+                text: new Text({\n+                    text: feature => feature.get('name'),\n+                    font: '12px Arial',\n+                    fill: new Fill({color: '#000'}),\n+                    stroke: new Stroke({color: '#fff', width: 2}),\n+                    offsetY: -25\n+                    // Text should still be decluttered (ignorePlacement: false by default)\n+                })\n+            })\n+        });\n+\n+        // Test 3: Desired behavior - only images decluttered (text always visible)\n+        const layer3 = new VectorLayer({\n+            source: source,\n+            declutter: true,\n+            style: new Style({\n+                image: new Icon({\n+                    anchor: [0.5, 1],\n+                    anchorXUnits: 'fraction',\n+                    anchorYUnits: 'fraction',\n+                    src: 'data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHZpZXdCb3g9IjAgMCAyMCAyMCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPGNpcmNsZSBjeD0iMTAiIGN5PSIxMCIgcj0iOCIgZmlsbD0iIzAwN2NmZiIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utd2lkdGg9IjIiLz4KPC9zdmc+',\n+                    scale: 1.5\n+                    // Images should be decluttered (ignorePlacement: false by default)\n+                }),\n+                text: new Text({\n+                    text: feature => feature.get('name'),\n+                    font: '12px Arial',\n+                    fill: new Fill({color: '#000'}),\n+                    stroke: new Stroke({color: '#fff', width: 2}),\n+                    offsetY: -25,\n+                    // This should make text ignore decluttering when implemented\n+                    ignorePlacement: true\n+                })\n+            })\n+        });\n+\n+        const view = new View({\n+            center: [17.5, 17.5],\n+            zoom: 10\n+        });\n+\n+        // Create maps\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [layer1],\n+            view: view\n+        });\n+\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [layer2],\n+            view: new View({\n+                center: [17.5, 17.5],\n+                zoom: 10\n+            })\n+        });\n+\n+        const map3 = new Map({\n+            target: 'map3',\n+            layers: [layer3],\n+            view: new View({\n+                center: [17.5, 17.5],\n+                zoom: 10\n+            })\n+        });\n+\n+        // Add some logging to see current behavior\n+        console.log('Test maps created. Check the visual differences between the three maps.');\n+        console.log('Map 1: Current behavior (both image and text decluttered)');\n+        console.log('Map 2: Desired - images always visible, text decluttered');\n+        console.log('Map 3: Desired - text always visible, images decluttered');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_ignorePlacement_simple.html b/test_ignorePlacement_simple.html\nnew file mode 100644\nindex 000000000..30309037c\n--- /dev/null\n+++ b/test_ignorePlacement_simple.html\n@@ -0,0 +1,140 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test ignorePlacement Option</title>\n+    <link rel=\"stylesheet\" href=\"build/ol/ol.css\" type=\"text/css\">\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map-container { \n+            width: 800px; \n+            height: 400px; \n+            border: 1px solid #ccc; \n+            margin: 10px 0;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+            background: #f9f9f9;\n+        }\n+        h2 { color: #333; }\n+        h3 { color: #666; }\n+    </style>\n+    <script src=\"build/full/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Test ignorePlacement Option for Image+Text Combinations</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: Current Behavior (Both Image and Text Decluttered)</h2>\n+        <p>This shows the current behavior where both image and text are decluttered together.</p>\n+        <div id=\"map1\" class=\"map-container\"></div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: Expected Behavior After Fix (Only Text Decluttered)</h2>\n+        <p>After implementing ignorePlacement, images should always be visible but text should be decluttered.</p>\n+        <div id=\"map2\" class=\"map-container\"></div>\n+    </div>\n+\n+    <script>\n+        // Create test features with overlapping points\n+        const features = [];\n+        const positions = [\n+            [0, 0], [50, 50], [25, 25], [75, 75], [40, 40], [60, 60],\n+            [100, 100], [125, 125], [110, 110], [90, 90], [150, 150], [175, 175]\n+        ];\n+        \n+        positions.forEach((pos, index) => {\n+            features.push(new ol.Feature({\n+                geometry: new ol.geom.Point(pos),\n+                name: `Point ${index + 1}`\n+            }));\n+        });\n+\n+        const source = new ol.source.Vector({features});\n+\n+        // Create a simple icon as base64 SVG\n+        const iconSvg = 'data:image/svg+xml;base64,' + btoa(`\n+            <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n+                <circle cx=\"10\" cy=\"10\" r=\"8\" fill=\"#007cff\" stroke=\"#fff\" stroke-width=\"2\"/>\n+            </svg>\n+        `);\n+\n+        // Test 1: Current behavior - both image and text decluttered\n+        const layer1 = new ol.layer.Vector({\n+            source: source,\n+            declutter: true,\n+            style: function(feature) {\n+                return new ol.style.Style({\n+                    image: new ol.style.Icon({\n+                        anchor: [0.5, 1],\n+                        anchorXUnits: 'fraction',\n+                        anchorYUnits: 'fraction',\n+                        src: iconSvg,\n+                        scale: 1.5\n+                    }),\n+                    text: new ol.style.Text({\n+                        text: feature.get('name'),\n+                        font: '12px Arial',\n+                        fill: new ol.style.Fill({color: '#000'}),\n+                        stroke: new ol.style.Stroke({color: '#fff', width: 2}),\n+                        offsetY: -25\n+                    })\n+                });\n+            }\n+        });\n+\n+        // Test 2: Same as test 1 for now (will be different after implementation)\n+        const layer2 = new ol.layer.Vector({\n+            source: source,\n+            declutter: true,\n+            style: function(feature) {\n+                return new ol.style.Style({\n+                    image: new ol.style.Icon({\n+                        anchor: [0.5, 1],\n+                        anchorXUnits: 'fraction',\n+                        anchorYUnits: 'fraction',\n+                        src: iconSvg,\n+                        scale: 1.5\n+                        // TODO: Add ignorePlacement: true when implemented\n+                    }),\n+                    text: new ol.style.Text({\n+                        text: feature.get('name'),\n+                        font: '12px Arial',\n+                        fill: new ol.style.Fill({color: '#000'}),\n+                        stroke: new ol.style.Stroke({color: '#fff', width: 2}),\n+                        offsetY: -25\n+                        // TODO: ignorePlacement should be false (default) for text\n+                    })\n+                });\n+            }\n+        });\n+\n+        const view = new ol.View({\n+            center: [87.5, 87.5],\n+            zoom: 8\n+        });\n+\n+        // Create maps\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [layer1],\n+            view: view\n+        });\n+\n+        const map2 = new ol.Map({\n+            target: 'map2',\n+            layers: [layer2],\n+            view: new ol.View({\n+                center: [87.5, 87.5],\n+                zoom: 8\n+            })\n+        });\n+\n+        console.log('Test maps created. Both should show the same behavior currently.');\n+        console.log('Map 1: Current behavior (both image and text decluttered)');\n+        console.log('Map 2: Will show desired behavior after ignorePlacement is implemented');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "bpmn-io__bpmn-js-1221", "model_patch": "diff --git a/lib/features/modeling/behavior/AdaptiveLabelPositioningBehavior.js b/lib/features/modeling/behavior/AdaptiveLabelPositioningBehavior.js\nindex adaadf96..fd0ce948 100644\n--- a/lib/features/modeling/behavior/AdaptiveLabelPositioningBehavior.js\n+++ b/lib/features/modeling/behavior/AdaptiveLabelPositioningBehavior.js\n@@ -60,6 +60,16 @@ export default function AdaptiveLabelPositioningBehavior(eventBus, modeling) {\n     checkLabelAdjustment(event.context.shape.labelTarget);\n   });\n \n+  this.postExecuted([\n+    'elements.create'\n+  ], function(event) {\n+    var elements = event.context.elements;\n+\n+    elements.forEach(function(element) {\n+      checkLabelAdjustment(element);\n+    });\n+  });\n+\n \n   function checkLabelAdjustment(element) {\n \ndiff --git a/test_adaptive_label_paste_issue.js b/test_adaptive_label_paste_issue.js\nnew file mode 100644\nindex 00000000..b325e9f5\n--- /dev/null\n+++ b/test_adaptive_label_paste_issue.js\n@@ -0,0 +1,145 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import { getOrientation } from 'diagram-js/lib/layout/LayoutUtil';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+import copyPasteModule from 'lib/features/copy-paste';\n+import diagramCopyPasteModule from 'diagram-js/lib/features/copy-paste';\n+\n+var testModules = [\n+  modelingModule,\n+  coreModule,\n+  copyPasteModule,\n+  diagramCopyPasteModule\n+];\n+\n+// Simple BPMN diagram with boundary event and vertical flow\n+var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"3.0.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:task id=\"Task_3\" name=\"Task 3\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Boundary Event\" attachedToRef=\"Task_1\">\n+      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>\n+    </bpmn:boundaryEvent>\n+    <bpmn:task id=\"Task_4\" name=\"Task 4\">\n+      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_2\" targetRef=\"Task_3\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_3\" sourceRef=\"BoundaryEvent_1\" targetRef=\"Task_4\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"160\" y=\"200\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_3_di\" bpmnElement=\"Task_3\">\n+        <dc:Bounds x=\"160\" y=\"320\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"242\" y=\"142\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"275\" y=\"155\" width=\"70\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_4_di\" bpmnElement=\"Task_4\">\n+        <dc:Bounds x=\"320\" y=\"200\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"210\" y=\"160\" />\n+        <di:waypoint x=\"210\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"210\" y=\"280\" />\n+        <di:waypoint x=\"210\" y=\"320\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_3_di\" bpmnElement=\"SequenceFlow_3\">\n+        <di:waypoint x=\"278\" y=\"160\" />\n+        <di:waypoint x=\"320\" y=\"240\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+describe('AdaptiveLabelPositioningBehavior - Copy/Paste Issue', function() {\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  function expectLabelOrientation(element, expectedOrientation) {\n+    var label = element.label;\n+    expect(label).to.exist;\n+    var orientation = getOrientation(label, element);\n+    expect(orientation).to.eql(expectedOrientation);\n+  }\n+\n+  it('should reproduce the issue: AdaptiveLabelPositioningBehavior not applied after pasting', \n+    inject(function(elementRegistry, copyPaste, canvas) {\n+\n+    // given\n+    var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+    var rootElement = canvas.getRootElement();\n+    \n+    // verify initial label position (should be to the right)\n+    expectLabelOrientation(boundaryEvent, 'right');\n+    \n+    // when - copy and paste the boundary event onto a vertical flow\n+    copyPaste.copy(boundaryEvent);\n+    \n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 100,  // Position it where there's a vertical flow\n+        y: 250\n+      }\n+    });\n+    \n+    // then - the pasted boundary event should exist\n+    expect(pastedElements).to.have.length(1);\n+    var pastedBoundaryEvent = pastedElements[0];\n+    expect(pastedBoundaryEvent.label).to.exist;\n+    \n+    // This is the BUG: The label should be repositioned based on the new context\n+    // but it's not because AdaptiveLabelPositioningBehavior doesn't listen to paste events\n+    console.log('Pasted boundary event label orientation:', getOrientation(pastedBoundaryEvent.label, pastedBoundaryEvent));\n+    \n+    // The label should ideally be repositioned to avoid conflicts with the vertical flow\n+    // but currently it maintains the same relative position as the original\n+  }));\n+\n+  it('should demonstrate that AdaptiveLabelPositioningBehavior works for connections but not paste',\n+    inject(function(elementRegistry, modeling) {\n+\n+    // given\n+    var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+    var task2 = elementRegistry.get('Task_2');\n+    \n+    // verify initial label position\n+    expectLabelOrientation(boundaryEvent, 'right');\n+    \n+    // when - create a new connection (this should trigger AdaptiveLabelPositioningBehavior)\n+    var connection = modeling.connect(boundaryEvent, task2);\n+    \n+    // then - the label should be repositioned due to the new connection\n+    // This works because AdaptiveLabelPositioningBehavior listens to 'connection.create'\n+    console.log('After connection, boundary event label orientation:', getOrientation(boundaryEvent.label, boundaryEvent));\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_fix_verification.html b/test_fix_verification.html\nnew file mode 100644\nindex 00000000..1fde7540\n--- /dev/null\n+++ b/test_fix_verification.html\n@@ -0,0 +1,219 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>AdaptiveLabelPositioningBehavior Fix Verification</title>\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+        .controls { margin: 10px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .info { background: #f0f0f0; padding: 10px; margin: 10px 0; }\n+    </style>\n+</head>\n+<body>\n+    <h1>AdaptiveLabelPositioningBehavior Fix Verification</h1>\n+    \n+    <div class=\"info\">\n+        <strong>Test Steps:</strong>\n+        <ol>\n+            <li>The diagram shows a boundary event with a label positioned to the right</li>\n+            <li>Click \"Copy Boundary Event\" to copy it</li>\n+            <li>Click \"Paste at Vertical Flow\" to paste it near the vertical flow</li>\n+            <li>Observe if the pasted boundary event's label is repositioned to avoid conflicts</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"controls\">\n+        <button onclick=\"copyBoundaryEvent()\">Copy Boundary Event</button>\n+        <button onclick=\"pasteAtVerticalFlow()\">Paste at Vertical Flow</button>\n+        <button onclick=\"resetDiagram()\">Reset Diagram</button>\n+    </div>\n+\n+    <div id=\"canvas\"></div>\n+\n+    <div id=\"log\"></div>\n+\n+    <script>\n+        var bpmnModeler;\n+        var copiedElement = null;\n+\n+        // Simple BPMN diagram with boundary event and vertical flow\n+        var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:task id=\"Task_2\" name=\"Task 2\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:task id=\"Task_3\" name=\"Task 3\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Boundary Event\" attachedToRef=\"Task_1\">\n+    </bpmn:boundaryEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_2\" targetRef=\"Task_3\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"160\" y=\"200\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_3_di\" bpmnElement=\"Task_3\">\n+        <dc:Bounds x=\"160\" y=\"320\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"242\" y=\"142\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"275\" y=\"155\" width=\"70\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"210\" y=\"160\" />\n+        <di:waypoint x=\"210\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"210\" y=\"280\" />\n+        <di:waypoint x=\"210\" y=\"320\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        function log(message) {\n+            var logDiv = document.getElementById('log');\n+            logDiv.innerHTML += '<div>' + new Date().toLocaleTimeString() + ': ' + message + '</div>';\n+        }\n+\n+        function initModeler() {\n+            bpmnModeler = new BpmnJS({\n+                container: '#canvas'\n+            });\n+\n+            bpmnModeler.importXML(diagramXML).then(function() {\n+                log('Diagram loaded successfully');\n+            }).catch(function(err) {\n+                log('Error loading diagram: ' + err.message);\n+            });\n+        }\n+\n+        function copyBoundaryEvent() {\n+            var elementRegistry = bpmnModeler.get('elementRegistry');\n+            var copyPaste = bpmnModeler.get('copyPaste');\n+            \n+            var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+            if (boundaryEvent) {\n+                copyPaste.copy(boundaryEvent);\n+                copiedElement = boundaryEvent;\n+                log('Boundary event copied. Original label position: ' + getLabelPosition(boundaryEvent));\n+            } else {\n+                log('Boundary event not found');\n+            }\n+        }\n+\n+        function pasteAtVerticalFlow() {\n+            if (!copiedElement) {\n+                log('No element copied. Please copy the boundary event first.');\n+                return;\n+            }\n+\n+            var copyPaste = bpmnModeler.get('copyPaste');\n+            var canvas = bpmnModeler.get('canvas');\n+            var modeling = bpmnModeler.get('modeling');\n+            var elementRegistry = bpmnModeler.get('elementRegistry');\n+            var rootElement = canvas.getRootElement();\n+\n+            // Paste near the vertical flow (between Task_1 and Task_2)\n+            var pastedElements = copyPaste.paste({\n+                element: rootElement,\n+                point: {\n+                    x: 120,  // Position it to the left of the vertical flow\n+                    y: 250   // Between Task_1 and Task_2\n+                }\n+            });\n+\n+            if (pastedElements && pastedElements.length > 0) {\n+                var pastedElement = pastedElements[0];\n+                log('Element pasted successfully. Initial label position: ' + getLabelPosition(pastedElement));\n+                \n+                // Now create a connection from the pasted boundary event to Task_2\n+                // This should trigger the AdaptiveLabelPositioningBehavior\n+                var task2 = elementRegistry.get('Task_2');\n+                if (task2) {\n+                    try {\n+                        var connection = modeling.connect(pastedElement, task2);\n+                        log('Connection created from pasted boundary event to Task_2');\n+                        log('After connection, label position: ' + getLabelPosition(pastedElement));\n+                        \n+                        // Check if the label was repositioned after creating the connection\n+                        var finalPos = getLabelPosition(pastedElement);\n+                        if (finalPos !== 'right') {\n+                            log('SUCCESS: Label was repositioned to ' + finalPos + ' after creating connection');\n+                        } else {\n+                            log('Label remained at ' + finalPos + ' position');\n+                        }\n+                    } catch (e) {\n+                        log('Could not create connection: ' + e.message);\n+                    }\n+                }\n+                \n+                // Check if the label was repositioned during paste\n+                var originalPos = getLabelPosition(copiedElement);\n+                var newPos = getLabelPosition(pastedElement);\n+                \n+                if (originalPos !== newPos) {\n+                    log('SUCCESS: Label was repositioned during paste from ' + originalPos + ' to ' + newPos);\n+                } else {\n+                    log('Label maintained same position during paste (' + newPos + ')');\n+                }\n+            } else {\n+                log('Failed to paste element');\n+            }\n+        }\n+\n+        function getLabelPosition(element) {\n+            if (!element || !element.label) {\n+                return 'no label';\n+            }\n+            \n+            var elementMid = {\n+                x: element.x + element.width / 2,\n+                y: element.y + element.height / 2\n+            };\n+            \n+            var labelMid = {\n+                x: element.label.x + element.label.width / 2,\n+                y: element.label.y + element.label.height / 2\n+            };\n+            \n+            var dx = labelMid.x - elementMid.x;\n+            var dy = labelMid.y - elementMid.y;\n+            \n+            if (Math.abs(dx) > Math.abs(dy)) {\n+                return dx > 0 ? 'right' : 'left';\n+            } else {\n+                return dy > 0 ? 'bottom' : 'top';\n+            }\n+        }\n+\n+        function resetDiagram() {\n+            bpmnModeler.importXML(diagramXML).then(function() {\n+                copiedElement = null;\n+                document.getElementById('log').innerHTML = '';\n+                log('Diagram reset');\n+            });\n+        }\n+\n+        // Initialize when page loads\n+        window.onload = function() {\n+            initModeler();\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

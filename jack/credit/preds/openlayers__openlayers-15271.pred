{"instance_id": "openlayers__openlayers-15271", "model_patch": "diff --git a/src/ol/style/expressions.js b/src/ol/style/expressions.js\nindex 79be2d6ec..3337e63de 100644\n--- a/src/ol/style/expressions.js\n+++ b/src/ol/style/expressions.js\n@@ -24,6 +24,7 @@ import {asArray, fromString, isStringColor} from '../color.js';\n  *   * `['get', 'attributeName', typeHint]` fetches a feature property value, similar to `feature.get('attributeName')`\n  *     A type hint can optionally be specified, in case the resulting expression contains a type ambiguity which\n  *     will make it invalid. Type hints can be one of: 'string', 'color', 'number', 'boolean', 'number[]'\n+ *   * `['id']` returns a feature's identifier, similar to `feature.getId()`\n  *   * `['geometry-type']` returns a feature's geometry type as string, either: 'LineString', 'Point' or 'Polygon'\n  *     `Multi*` values are returned as their singular equivalent\n  *     `Circle` geometries are returned as 'Polygon'\n@@ -742,6 +743,29 @@ Operators['geometry-type'] = {\n   },\n };\n \n+Operators['id'] = {\n+  getReturnType: function () {\n+    return ValueTypes.STRING;\n+  },\n+  toGlsl: function (context, args) {\n+    assertArgsCount(args, 0);\n+    const name = 'featureId';\n+    const existing = context.attributes.find((a) => a.name === name);\n+    if (!existing) {\n+      context.attributes.push({\n+        name: name,\n+        type: ValueTypes.STRING,\n+        callback: (feature) => {\n+          const id = feature.getId();\n+          return id !== undefined ? String(id) : '';\n+        },\n+      });\n+    }\n+    const prefix = context.inFragmentShader ? 'v_' : 'a_';\n+    return prefix + name;\n+  },\n+};\n+\n Operators['*'] = {\n   getReturnType: function (args) {\n     let outputType = ValueTypes.NUMBER | ValueTypes.COLOR;\ndiff --git a/test_feature_id_expression.js b/test_feature_id_expression.js\nnew file mode 100644\nindex 000000000..6210b2861\n--- /dev/null\n+++ b/test_feature_id_expression.js\n@@ -0,0 +1,78 @@\n+/**\n+ * Test file to reproduce the issue and test the feature ID expression operator\n+ */\n+\n+import Feature from './src/ol/Feature.js';\n+import Point from './src/ol/geom/Point.js';\n+import {\n+  ValueTypes,\n+  expressionToGlsl,\n+  getValueType,\n+} from './src/ol/style/expressions.js';\n+\n+// Test 1: Verify that feature.getId() works\n+console.log('=== Test 1: Basic feature.getId() functionality ===');\n+const feature1 = new Feature({\n+  name: 'Test Feature',\n+  population: 1000000\n+});\n+feature1.setId('feature-123');\n+feature1.setGeometry(new Point([0, 0]));\n+\n+console.log('Feature ID:', feature1.getId()); // Should print: feature-123\n+console.log('Feature name:', feature1.get('name')); // Should print: Test Feature\n+\n+// Test 2: Try to use ['id'] expression (should fail currently)\n+console.log('\\n=== Test 2: Try to use id expression (should fail) ===');\n+try {\n+  const context = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  // This should fail because 'id' operator doesn't exist yet\n+  const result = expressionToGlsl(context, ['id']);\n+  console.log('Unexpected success:', result);\n+} catch (error) {\n+  console.log('Expected error:', error.message);\n+}\n+\n+// Test 3: Try to use ['get', 'id'] (won't work for feature ID)\n+console.log('\\n=== Test 3: Try to use get expression for id (limited) ===');\n+try {\n+  const context = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  // This will work but only if 'id' is in properties, not the actual feature ID\n+  const result = expressionToGlsl(context, ['get', 'id']);\n+  console.log('Get id expression result:', result);\n+  console.log('Context attributes:', context.attributes);\n+} catch (error) {\n+  console.log('Error:', error.message);\n+}\n+\n+// Test 4: Test with GeoJSON-like feature that has ID in root\n+console.log('\\n=== Test 4: GeoJSON feature with root ID ===');\n+const geoJsonFeature = new Feature({\n+  name: 'GeoJSON Feature',\n+  type: 'city'\n+});\n+geoJsonFeature.setId('geojson-456');\n+geoJsonFeature.setGeometry(new Point([10, 20]));\n+\n+console.log('GeoJSON Feature ID:', geoJsonFeature.getId());\n+console.log('GeoJSON Feature properties:', geoJsonFeature.getProperties());\n+\n+// Test 5: Verify the issue - no way to access feature ID in expressions\n+console.log('\\n=== Test 5: Demonstrate the problem ===');\n+console.log('We can access properties with [\"get\", \"name\"]:', ['get', 'name']);\n+console.log('But we cannot access feature ID with expressions');\n+console.log('Feature ID is:', geoJsonFeature.getId());\n+console.log('Feature properties are:', geoJsonFeature.getProperties());\n+console.log('Notice: ID is not in properties, it\\'s separate');\n\\ No newline at end of file\ndiff --git a/test_id_operator_comprehensive.js b/test_id_operator_comprehensive.js\nnew file mode 100644\nindex 000000000..0ab995c02\n--- /dev/null\n+++ b/test_id_operator_comprehensive.js\n@@ -0,0 +1,123 @@\n+/**\n+ * Comprehensive test for the new 'id' expression operator\n+ */\n+\n+import Feature from './src/ol/Feature.js';\n+import Point from './src/ol/geom/Point.js';\n+import Polygon from './src/ol/geom/Polygon.js';\n+import {\n+  ValueTypes,\n+  expressionToGlsl,\n+  getValueType,\n+} from './src/ol/style/expressions.js';\n+\n+console.log('=== Comprehensive ID Operator Tests ===\\n');\n+\n+// Test data setup\n+const features = [\n+  // Feature with string ID\n+  (() => {\n+    const f = new Feature({ name: 'String ID Feature' });\n+    f.setId('string-id-123');\n+    f.setGeometry(new Point([0, 0]));\n+    return f;\n+  })(),\n+  \n+  // Feature with numeric ID\n+  (() => {\n+    const f = new Feature({ name: 'Numeric ID Feature' });\n+    f.setId(42);\n+    f.setGeometry(new Point([1, 1]));\n+    return f;\n+  })(),\n+  \n+  // Feature with no ID\n+  (() => {\n+    const f = new Feature({ name: 'No ID Feature' });\n+    f.setGeometry(new Point([2, 2]));\n+    return f;\n+  })(),\n+  \n+  // Feature with complex geometry\n+  (() => {\n+    const f = new Feature({ name: 'Polygon Feature' });\n+    f.setId('polygon-456');\n+    f.setGeometry(new Polygon([[[0, 0], [1, 0], [1, 1], [0, 1], [0, 0]]]));\n+    return f;\n+  })()\n+];\n+\n+// Test 1: Verify current state (should fail)\n+console.log('Test 1: Current state - id operator should not exist');\n+try {\n+  const context = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  const result = expressionToGlsl(context, ['id']);\n+  console.log('\u274c Unexpected success - id operator already exists:', result);\n+} catch (error) {\n+  console.log('\u2705 Expected error:', error.message);\n+}\n+\n+// Test 2: Test getValueType for id operator (should fail currently)\n+console.log('\\nTest 2: getValueType for id operator');\n+try {\n+  const valueType = getValueType(['id']);\n+  console.log('\u274c Unexpected success - getValueType worked:', valueType);\n+} catch (error) {\n+  console.log('\u2705 Expected error:', error.message);\n+}\n+\n+// Test 3: Demonstrate feature.getId() works\n+console.log('\\nTest 3: Verify feature.getId() functionality');\n+features.forEach((feature, index) => {\n+  console.log(`Feature ${index + 1}:`, {\n+    id: feature.getId(),\n+    name: feature.get('name'),\n+    geometryType: feature.getGeometry().getType()\n+  });\n+});\n+\n+// Test 4: Show that ['get', 'id'] doesn't access feature ID\n+console.log('\\nTest 4: Show that [\"get\", \"id\"] is different from feature.getId()');\n+const testFeature = new Feature({ \n+  id: 'property-id',  // This is a property named 'id'\n+  name: 'Test Feature' \n+});\n+testFeature.setId('actual-feature-id');  // This is the actual feature ID\n+testFeature.setGeometry(new Point([0, 0]));\n+\n+console.log('Feature ID (getId()):', testFeature.getId());\n+console.log('Property \"id\" (get(\"id\")):', testFeature.get('id'));\n+console.log('These are different!');\n+\n+// Test 5: Expected behavior after implementation\n+console.log('\\nTest 5: Expected behavior after implementing id operator');\n+console.log('After implementation, we should be able to:');\n+console.log('- Use [\"id\"] to get feature.getId() value');\n+console.log('- Use [\"get\", \"id\"] to get feature.get(\"id\") value (property)');\n+console.log('- Handle cases where feature has no ID (should return undefined/null)');\n+\n+// Test 6: Edge cases to consider\n+console.log('\\nTest 6: Edge cases to handle');\n+console.log('- Features with string IDs');\n+console.log('- Features with numeric IDs');\n+console.log('- Features with no ID (undefined)');\n+console.log('- Features with null ID');\n+console.log('- Features with empty string ID');\n+\n+const edgeCaseFeatures = [\n+  (() => { const f = new Feature({}); f.setId(''); return f; })(),  // Empty string\n+  (() => { const f = new Feature({}); f.setId(0); return f; })(),   // Zero\n+  (() => { const f = new Feature({}); f.setId(null); return f; })(), // Null\n+];\n+\n+edgeCaseFeatures.forEach((feature, index) => {\n+  console.log(`Edge case ${index + 1} - ID:`, feature.getId(), `(type: ${typeof feature.getId()})`);\n+});\n+\n+console.log('\\n=== Test completed ===');\n\\ No newline at end of file\ndiff --git a/test_id_operator_final.js b/test_id_operator_final.js\nnew file mode 100644\nindex 000000000..b4e1a0025\n--- /dev/null\n+++ b/test_id_operator_final.js\n@@ -0,0 +1,209 @@\n+/**\n+ * Final comprehensive test for the new 'id' expression operator\n+ */\n+\n+import Feature from './src/ol/Feature.js';\n+import Point from './src/ol/geom/Point.js';\n+import {\n+  ValueTypes,\n+  expressionToGlsl,\n+  getValueType,\n+} from './src/ol/style/expressions.js';\n+\n+console.log('=== Final ID Operator Verification ===\\n');\n+\n+// Test 1: Basic functionality\n+console.log('Test 1: Basic id operator functionality');\n+try {\n+  const context = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  const result = expressionToGlsl(context, ['id']);\n+  console.log('\u2705 ID operator works:', result);\n+  console.log('\u2705 Context attributes:', context.attributes);\n+  \n+  // Verify the callback function is set correctly\n+  const idAttribute = context.attributes.find(a => a.name === 'featureId');\n+  if (idAttribute && idAttribute.callback) {\n+    console.log('\u2705 Callback function exists');\n+  } else {\n+    console.log('\u274c Callback function missing');\n+  }\n+} catch (error) {\n+  console.log('\u274c Error:', error.message);\n+}\n+\n+// Test 2: Return type verification\n+console.log('\\nTest 2: Return type verification');\n+try {\n+  const valueType = getValueType(['id']);\n+  console.log('\u2705 Return type:', valueType, '(should be', ValueTypes.STRING, ')');\n+  if (valueType === ValueTypes.STRING) {\n+    console.log('\u2705 Correct return type');\n+  } else {\n+    console.log('\u274c Incorrect return type');\n+  }\n+} catch (error) {\n+  console.log('\u274c Error:', error.message);\n+}\n+\n+// Test 3: Test callback function with different feature types\n+console.log('\\nTest 3: Test callback with different feature IDs');\n+\n+const testFeatures = [\n+  // String ID\n+  (() => {\n+    const f = new Feature({ name: 'String ID' });\n+    f.setId('string-123');\n+    return f;\n+  })(),\n+  \n+  // Numeric ID\n+  (() => {\n+    const f = new Feature({ name: 'Numeric ID' });\n+    f.setId(42);\n+    return f;\n+  })(),\n+  \n+  // Zero ID\n+  (() => {\n+    const f = new Feature({ name: 'Zero ID' });\n+    f.setId(0);\n+    return f;\n+  })(),\n+  \n+  // Empty string ID\n+  (() => {\n+    const f = new Feature({ name: 'Empty String ID' });\n+    f.setId('');\n+    return f;\n+  })(),\n+  \n+  // Undefined ID\n+  (() => {\n+    const f = new Feature({ name: 'No ID' });\n+    return f;\n+  })(),\n+  \n+  // Null ID\n+  (() => {\n+    const f = new Feature({ name: 'Null ID' });\n+    f.setId(null);\n+    return f;\n+  })()\n+];\n+\n+// Get the callback function\n+const context = {\n+  variables: [],\n+  attributes: [],\n+  functions: {},\n+  style: {},\n+};\n+expressionToGlsl(context, ['id']);\n+const callback = context.attributes.find(a => a.name === 'featureId').callback;\n+\n+testFeatures.forEach((feature, index) => {\n+  const originalId = feature.getId();\n+  const callbackResult = callback(feature);\n+  console.log(`Feature ${index + 1}:`, {\n+    name: feature.get('name'),\n+    originalId: originalId,\n+    originalType: typeof originalId,\n+    callbackResult: callbackResult,\n+    callbackType: typeof callbackResult\n+  });\n+});\n+\n+// Test 4: Fragment shader context\n+console.log('\\nTest 4: Fragment shader context');\n+try {\n+  const fragmentContext = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+    inFragmentShader: true\n+  };\n+  \n+  const result = expressionToGlsl(fragmentContext, ['id']);\n+  console.log('\u2705 Fragment shader result:', result, '(should start with v_)');\n+  if (result.startsWith('v_')) {\n+    console.log('\u2705 Correct fragment shader prefix');\n+  } else {\n+    console.log('\u274c Incorrect fragment shader prefix');\n+  }\n+} catch (error) {\n+  console.log('\u274c Error:', error.message);\n+}\n+\n+// Test 5: Vertex shader context (default)\n+console.log('\\nTest 5: Vertex shader context');\n+try {\n+  const vertexContext = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+    inFragmentShader: false\n+  };\n+  \n+  const result = expressionToGlsl(vertexContext, ['id']);\n+  console.log('\u2705 Vertex shader result:', result, '(should start with a_)');\n+  if (result.startsWith('a_')) {\n+    console.log('\u2705 Correct vertex shader prefix');\n+  } else {\n+    console.log('\u274c Incorrect vertex shader prefix');\n+  }\n+} catch (error) {\n+  console.log('\u274c Error:', error.message);\n+}\n+\n+// Test 6: Multiple calls should reuse the same attribute\n+console.log('\\nTest 6: Multiple calls reuse attribute');\n+try {\n+  const reuseContext = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  const result1 = expressionToGlsl(reuseContext, ['id']);\n+  const result2 = expressionToGlsl(reuseContext, ['id']);\n+  \n+  console.log('\u2705 First call result:', result1);\n+  console.log('\u2705 Second call result:', result2);\n+  console.log('\u2705 Attributes count:', reuseContext.attributes.length, '(should be 1)');\n+  \n+  if (result1 === result2 && reuseContext.attributes.length === 1) {\n+    console.log('\u2705 Correctly reuses attribute');\n+  } else {\n+    console.log('\u274c Does not reuse attribute correctly');\n+  }\n+} catch (error) {\n+  console.log('\u274c Error:', error.message);\n+}\n+\n+// Test 7: Argument validation\n+console.log('\\nTest 7: Argument validation');\n+try {\n+  const argContext = {\n+    variables: [],\n+    attributes: [],\n+    functions: {},\n+    style: {},\n+  };\n+  \n+  // Should fail with arguments\n+  expressionToGlsl(argContext, ['id', 'extra-arg']);\n+  console.log('\u274c Should have failed with extra arguments');\n+} catch (error) {\n+  console.log('\u2705 Correctly rejects extra arguments:', error.message);\n+}\n+\n+console.log('\\n=== Final verification completed ===');\n\\ No newline at end of file\ndiff --git a/test_visual_id_operator.html b/test_visual_id_operator.html\nnew file mode 100644\nindex 000000000..7308f0a94\n--- /dev/null\n+++ b/test_visual_id_operator.html\n@@ -0,0 +1,158 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Feature ID Expression Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #map { width: 100%; height: 400px; border: 1px solid #ccc; }\n+        .test-section { margin: 20px 0; padding: 10px; border: 1px solid #ddd; }\n+        .error { color: red; }\n+        .success { color: green; }\n+        .info { color: blue; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Feature ID Expression Operator Test</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Issue Demonstration</h2>\n+        <p>This test demonstrates the current limitation and the need for an 'id' expression operator.</p>\n+        <div id=\"test-results\"></div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Map with Features</h2>\n+        <div id=\"map\"></div>\n+        <p>The map above shows features with IDs. Currently, we cannot style them based on their feature ID using expressions.</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Feature from './src/ol/Feature.js';\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import {Circle, Fill, Stroke, Style} from './src/ol/style.js';\n+        import {\n+            ValueTypes,\n+            expressionToGlsl,\n+            getValueType,\n+        } from './src/ol/style/expressions.js';\n+\n+        const resultsDiv = document.getElementById('test-results');\n+        \n+        function addResult(message, type = 'info') {\n+            const div = document.createElement('div');\n+            div.className = type;\n+            div.textContent = message;\n+            resultsDiv.appendChild(div);\n+        }\n+\n+        // Test 1: Try to use id operator (should fail)\n+        addResult('Test 1: Attempting to use [\"id\"] expression operator...');\n+        try {\n+            const context = {\n+                variables: [],\n+                attributes: [],\n+                functions: {},\n+                style: {},\n+            };\n+            \n+            const result = expressionToGlsl(context, ['id']);\n+            addResult(`\u274c Unexpected success: ${result}`, 'error');\n+        } catch (error) {\n+            addResult(`\u2705 Expected error: ${error.message}`, 'success');\n+        }\n+\n+        // Test 2: Show the difference between feature ID and property\n+        addResult('\\nTest 2: Demonstrating the difference between feature.getId() and feature.get(\"id\")...');\n+        \n+        const testFeature = new Feature({\n+            id: 'property-id-value',  // This is a property\n+            name: 'Test Feature'\n+        });\n+        testFeature.setId('actual-feature-id');  // This is the feature ID\n+        testFeature.setGeometry(new Point([0, 0]));\n+        \n+        addResult(`Feature ID (getId()): ${testFeature.getId()}`);\n+        addResult(`Property \"id\" (get(\"id\")): ${testFeature.get('id')}`);\n+        addResult('These are different values!', 'info');\n+\n+        // Test 3: Create map with features that have IDs\n+        addResult('\\nTest 3: Creating map with features that have IDs...');\n+        \n+        const features = [\n+            (() => {\n+                const f = new Feature({ name: 'Feature A', type: 'important' });\n+                f.setId('feature-a');\n+                f.setGeometry(new Point([0, 0]));\n+                return f;\n+            })(),\n+            (() => {\n+                const f = new Feature({ name: 'Feature B', type: 'normal' });\n+                f.setId('feature-b');\n+                f.setGeometry(new Point([1000000, 1000000]));\n+                return f;\n+            })(),\n+            (() => {\n+                const f = new Feature({ name: 'Feature C', type: 'important' });\n+                f.setId('feature-c');\n+                f.setGeometry(new Point([-1000000, -1000000]));\n+                return f;\n+            })()\n+        ];\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        // Current styling - we can only style based on properties, not feature ID\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            style: function(feature) {\n+                // We can access feature.getId() in a function, but not in expressions\n+                const featureId = feature.getId();\n+                const isImportant = feature.get('type') === 'important';\n+                \n+                return new Style({\n+                    image: new Circle({\n+                        radius: isImportant ? 10 : 6,\n+                        fill: new Fill({\n+                            // We'd like to use ['id'] in expressions here, but we can't\n+                            color: featureId.includes('a') ? 'red' : 'blue'\n+                        }),\n+                        stroke: new Stroke({\n+                            color: 'white',\n+                            width: 2\n+                        })\n+                    })\n+                });\n+            }\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [vectorLayer],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        addResult('\u2705 Map created with features having IDs');\n+        addResult('Note: Currently styling based on feature ID requires a function, not expressions');\n+        \n+        // Test 4: Show what we want to achieve\n+        addResult('\\nTest 4: What we want to achieve with the id operator...');\n+        addResult('After implementation, we should be able to use expressions like:');\n+        addResult('- [\"==\", [\"id\"], \"feature-a\"] to check if feature ID equals \"feature-a\"');\n+        addResult('- [\"in\", [\"id\"], [\"literal\", [\"feature-a\", \"feature-c\"]]] to check if ID is in a list');\n+        addResult('- This would enable declarative styling based on feature IDs');\n+\n+        features.forEach(feature => {\n+            addResult(`Feature: ${feature.get('name')}, ID: ${feature.getId()}, Type: ${feature.get('type')}`);\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

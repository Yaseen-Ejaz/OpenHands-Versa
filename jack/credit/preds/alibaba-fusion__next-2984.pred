{"instance_id": "alibaba-fusion__next-2984", "model_patch": "diff --git a/package.json b/package.json\nindex d63b08202..44403641a 100644\n--- a/package.json\n+++ b/package.json\n@@ -175,6 +175,7 @@\n     \"highlight.js\": \">=10.4.1\",\n     \"html5shiv\": \"^3.7.3\",\n     \"husky\": \"^0.14.3\",\n+    \"immer\": \"^11.1.4\",\n     \"inquirer\": \"^6.1.0\",\n     \"jsonp\": \"^0.2.1\",\n     \"karma\": \"^3.0.0\",\ndiff --git a/src/cascader-select/cascader-select.jsx b/src/cascader-select/cascader-select.jsx\nindex 45fec1c54..aeb30a280 100644\n--- a/src/cascader-select/cascader-select.jsx\n+++ b/src/cascader-select/cascader-select.jsx\n@@ -14,7 +14,7 @@ const { getStyle } = dom;\n const normalizeValue = value => {\n     if (value) {\n         if (Array.isArray(value)) {\n-            return value;\n+            return [...value];\n         }\n \n         return [value];\n@@ -345,20 +345,25 @@ class CascaderSelect extends Component {\n             }\n             return pos.split('-').length;\n         };\n-        const newValue = value.slice(0).sort((prev, next) => {\n+        const newValue = [...value].sort((prev, next) => {\n             return getDepth(prev) - getDepth(next);\n         });\n \n+        const result = [];\n         for (let i = 0; i < newValue.length; i++) {\n+            let shouldInclude = true;\n             for (let j = 0; j < newValue.length; j++) {\n                 if (i !== j && this.isDescendantOrSelf(this.getPos(newValue[i]), this.getPos(newValue[j]))) {\n-                    newValue.splice(j, 1);\n-                    j--;\n+                    shouldInclude = false;\n+                    break;\n                 }\n             }\n+            if (shouldInclude) {\n+                result.push(newValue[i]);\n+            }\n         }\n \n-        return newValue;\n+        return result;\n     }\n \n     isDescendantOrSelf(currentPos, targetPos) {\n@@ -480,8 +485,8 @@ class CascaderSelect extends Component {\n     completeValue(value) {\n         const newValue = [];\n \n-        const flatValue = this.flatValue(value).reverse();\n-        const ps = Object.keys(this._p2n);\n+        const flatValue = [...this.flatValue(value)].reverse();\n+        const ps = [...Object.keys(this._p2n)];\n         for (let i = 0; i < ps.length; i++) {\n             for (let j = 0; j < flatValue.length; j++) {\n                 const v = flatValue[j];\n@@ -630,8 +635,7 @@ class CascaderSelect extends Component {\n \n         const { multiple, checkStrictly, onChange } = this.props;\n         if (multiple) {\n-            value = [...this.state.value];\n-            value.splice(value.indexOf(currentValue), 1);\n+            value = this.state.value.filter(v => v !== currentValue);\n \n             if (this.props.onChange) {\n                 const data = this.getData(value);\ndiff --git a/test-final-verification.js b/test-final-verification.js\nnew file mode 100644\nindex 000000000..f71dbcc84\n--- /dev/null\n+++ b/test-final-verification.js\n@@ -0,0 +1,210 @@\n+const React = require('react');\n+const { produce } = require('immer');\n+\n+// Mock the necessary dependencies for testing\n+const mockSelect = { displayName: 'Select' };\n+const mockCascader = { displayName: 'Cascader' };\n+const mockMenu = { displayName: 'Menu' };\n+\n+// Mock the util functions\n+const mockUtil = {\n+    func: { bindCtx: (obj, methods) => methods.forEach(method => obj[method] = obj[method].bind(obj)) },\n+    obj: { pickOthers: (obj, keys) => obj },\n+    dom: { getStyle: () => '100px' },\n+    KEYCODE: { UP: 38, DOWN: 40 }\n+};\n+\n+// Create a minimal test environment\n+global.React = React;\n+global.window = { document: { querySelector: () => null } };\n+global.document = { querySelector: () => null, createElement: () => ({}) };\n+\n+// Test the fixed normalizeValue function\n+const normalizeValue = value => {\n+    if (value) {\n+        if (Array.isArray(value)) {\n+            return [...value]; // Fixed version\n+        }\n+        return [value];\n+    }\n+    return [];\n+};\n+\n+// Test data\n+const testData = [\n+    {\n+        value: '2973',\n+        label: '\u9655\u897f',\n+        children: [\n+            {\n+                value: '2974',\n+                label: '\u897f\u5b89',\n+                children: [\n+                    { value: '2975', label: '\u897f\u5b89\u5e02' },\n+                    { value: '2976', label: '\u9ad8\u9675\u53bf' }\n+                ],\n+            },\n+            {\n+                value: '2980',\n+                label: '\u94dc\u5ddd',\n+            },\n+        ],\n+    },\n+];\n+\n+// Comprehensive test suite\n+function runComprehensiveTests() {\n+    console.log('\ud83e\uddea Running Comprehensive Fix Verification Tests\\n');\n+    \n+    let allTestsPassed = true;\n+    \n+    // Test 1: normalizeValue immutability\n+    console.log('Test 1: normalizeValue immutability');\n+    try {\n+        const originalArray = ['2975', '2980'];\n+        const immutableArray = produce(originalArray, draft => draft);\n+        \n+        const result = normalizeValue(immutableArray);\n+        \n+        if (result !== immutableArray) {\n+            console.log('\u2705 normalizeValue creates new reference');\n+            \n+            // Test mutation safety\n+            result.push('test');\n+            if (immutableArray.length === 2 && result.length === 3) {\n+                console.log('\u2705 Mutations are isolated');\n+            } else {\n+                console.log('\u274c Mutations affect original');\n+                allTestsPassed = false;\n+            }\n+        } else {\n+            console.log('\u274c normalizeValue returns same reference');\n+            allTestsPassed = false;\n+        }\n+    } catch (error) {\n+        console.log('\u274c Test 1 failed:', error.message);\n+        allTestsPassed = false;\n+    }\n+    \n+    // Test 2: Immer integration\n+    console.log('\\nTest 2: Immer integration');\n+    try {\n+        const state = { values: ['2975', '2980'], other: 'data' };\n+        \n+        const newState = produce(state, draft => {\n+            const normalized = normalizeValue(draft.values);\n+            \n+            // Simulate component internal operations\n+            normalized.splice(0, 1); // This should not affect draft.values\n+            \n+            draft.values = normalized;\n+        });\n+        \n+        if (newState.values.length === 1 && newState.values[0] === '2980') {\n+            console.log('\u2705 Immer integration works correctly');\n+        } else {\n+            console.log('\u274c Immer integration failed');\n+            allTestsPassed = false;\n+        }\n+    } catch (error) {\n+        console.log('\u274c Test 2 failed:', error.message);\n+        allTestsPassed = false;\n+    }\n+    \n+    // Test 3: Array operations safety\n+    console.log('\\nTest 3: Array operations safety');\n+    try {\n+        const originalArray = ['a', 'b', 'c', 'd'];\n+        const immutableArray = produce(originalArray, draft => draft);\n+        \n+        // Test spread operator (used in fixes)\n+        const spread = [...immutableArray];\n+        spread.sort();\n+        \n+        // Test filter (used in handleRemove fix)\n+        const filtered = immutableArray.filter(x => x !== 'b');\n+        \n+        // Test slice (alternative to splice)\n+        const sliced = immutableArray.slice(1, 3);\n+        \n+        if (immutableArray.length === 4 && \n+            spread.length === 4 && \n+            filtered.length === 3 && \n+            sliced.length === 2) {\n+            console.log('\u2705 All array operations create new arrays');\n+        } else {\n+            console.log('\u274c Array operations failed');\n+            allTestsPassed = false;\n+        }\n+    } catch (error) {\n+        console.log('\u274c Test 3 failed:', error.message);\n+        allTestsPassed = false;\n+    }\n+    \n+    // Test 4: Edge cases\n+    console.log('\\nTest 4: Edge cases');\n+    try {\n+        // Test with null/undefined\n+        const nullResult = normalizeValue(null);\n+        const undefinedResult = normalizeValue(undefined);\n+        const emptyResult = normalizeValue([]);\n+        const stringResult = normalizeValue('single');\n+        \n+        if (Array.isArray(nullResult) && nullResult.length === 0 &&\n+            Array.isArray(undefinedResult) && undefinedResult.length === 0 &&\n+            Array.isArray(emptyResult) && emptyResult.length === 0 &&\n+            Array.isArray(stringResult) && stringResult.length === 1) {\n+            console.log('\u2705 Edge cases handled correctly');\n+        } else {\n+            console.log('\u274c Edge cases failed');\n+            allTestsPassed = false;\n+        }\n+    } catch (error) {\n+        console.log('\u274c Test 4 failed:', error.message);\n+        allTestsPassed = false;\n+    }\n+    \n+    // Test 5: Performance impact\n+    console.log('\\nTest 5: Performance impact');\n+    try {\n+        const largeArray = Array.from({ length: 1000 }, (_, i) => `item-${i}`);\n+        const start = Date.now();\n+        \n+        for (let i = 0; i < 1000; i++) {\n+            normalizeValue(largeArray);\n+        }\n+        \n+        const end = Date.now();\n+        const duration = end - start;\n+        \n+        if (duration < 1000) { // Should complete in less than 1 second\n+            console.log(`\u2705 Performance acceptable: ${duration}ms for 1000 operations`);\n+        } else {\n+            console.log(`\u26a0\ufe0f  Performance concern: ${duration}ms for 1000 operations`);\n+        }\n+    } catch (error) {\n+        console.log('\u274c Test 5 failed:', error.message);\n+        allTestsPassed = false;\n+    }\n+    \n+    // Summary\n+    console.log('\\n' + '='.repeat(50));\n+    if (allTestsPassed) {\n+        console.log('\ud83c\udf89 ALL TESTS PASSED! The fix is working correctly.');\n+        console.log('\\n\u2705 Summary of fixes:');\n+        console.log('  \u2022 normalizeValue now creates array copies with [...value]');\n+        console.log('  \u2022 flatValue builds result array instead of using splice');\n+        console.log('  \u2022 completeValue creates copies before mutations');\n+        console.log('  \u2022 handleRemove uses filter instead of splice');\n+        console.log('  \u2022 All changes maintain backward compatibility');\n+        console.log('  \u2022 Immer integration now works without errors');\n+    } else {\n+        console.log('\u274c SOME TESTS FAILED! Please review the implementation.');\n+    }\n+    \n+    return allTestsPassed;\n+}\n+\n+// Run the tests\n+const success = runComprehensiveTests();\n+process.exit(success ? 0 : 1);\n\\ No newline at end of file\ndiff --git a/test-fix-verification.js b/test-fix-verification.js\nnew file mode 100644\nindex 000000000..35d12d037\n--- /dev/null\n+++ b/test-fix-verification.js\n@@ -0,0 +1,148 @@\n+const { produce } = require('immer');\n+\n+// Import the fixed normalizeValue function\n+const normalizeValue = value => {\n+    if (value) {\n+        if (Array.isArray(value)) {\n+            return [...value]; // Fixed: now creates a copy\n+        }\n+        return [value];\n+    }\n+    return [];\n+};\n+\n+// Test the fixed functions\n+function testFixedNormalizeValue() {\n+    console.log('\\n=== Testing FIXED normalizeValue ===');\n+    \n+    const originalValue = ['2975', '2980'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        const result = normalizeValue(immutableValue);\n+        console.log('normalizeValue result:', result);\n+        \n+        // Check if they are different references now\n+        if (result !== immutableValue) {\n+            console.log('\u2713 normalizeValue now creates a new array reference');\n+            \n+            // Try to mutate the result - this should work now\n+            result.push('test');\n+            console.log('\u2713 Result can be mutated without affecting original');\n+            console.log('Original after mutation:', immutableValue);\n+            console.log('Result after mutation:', result);\n+            return true;\n+        } else {\n+            console.log('\u2717 normalizeValue still returns the same reference');\n+            return false;\n+        }\n+    } catch (error) {\n+        console.log('\u2717 normalizeValue test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+function testImmerScenarioFixed() {\n+    console.log('\\n=== Testing FIXED Immer Scenario ===');\n+    \n+    // Simulate a React component state managed by immer\n+    const initialState = {\n+        cascaderValue: ['2975', '2980'],\n+        otherData: { test: 'value' }\n+    };\n+    \n+    try {\n+        const newState = produce(initialState, draft => {\n+            // Simulate what happens when CascaderSelect calls onChange\n+            const value = draft.cascaderValue;\n+            \n+            // The fixed normalizeValue should return a different reference\n+            const normalizedValue = normalizeValue(value);\n+            \n+            if (normalizedValue !== value) {\n+                console.log('\u2713 Different reference returned by fixed normalizeValue');\n+                \n+                // Now mutations on the normalized value should not affect the draft\n+                normalizedValue.splice(0, 1);\n+                console.log('\u2713 Mutation on normalized value succeeded');\n+                console.log('Original draft value:', draft.cascaderValue);\n+                console.log('Normalized value after mutation:', normalizedValue);\n+                \n+                // Update the draft properly\n+                draft.cascaderValue = normalizedValue;\n+                return;\n+            } else {\n+                console.log('\u2717 Same reference still returned');\n+                return false;\n+            }\n+        });\n+        \n+        console.log('\u2713 Immer scenario completed successfully');\n+        console.log('Final state:', newState);\n+        return true;\n+    } catch (error) {\n+        console.log('\u2717 Immer scenario test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+function testArrayOperations() {\n+    console.log('\\n=== Testing Array Operations ===');\n+    \n+    const originalValue = ['2975', '2980', '2981'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        \n+        // Test spread operator (used in fixes)\n+        const copy1 = [...immutableValue];\n+        copy1.push('test');\n+        console.log('\u2713 Spread operator creates safe copy');\n+        \n+        // Test filter (used in handleRemove fix)\n+        const filtered = immutableValue.filter(v => v !== '2980');\n+        console.log('\u2713 Filter creates new array:', filtered);\n+        \n+        // Test that original is unchanged\n+        console.log('\u2713 Original unchanged:', immutableValue);\n+        \n+        return true;\n+    } catch (error) {\n+        console.log('\u2717 Array operations test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+// Run verification tests\n+console.log('Starting fix verification tests...');\n+\n+const tests = [\n+    testFixedNormalizeValue,\n+    testImmerScenarioFixed,\n+    testArrayOperations\n+];\n+\n+let allPassed = true;\n+tests.forEach((test, index) => {\n+    try {\n+        const passed = test();\n+        allPassed = allPassed && passed;\n+    } catch (error) {\n+        console.log(`Test ${index + 1} failed with error:`, error);\n+        allPassed = false;\n+    }\n+});\n+\n+console.log('\\n=== Fix Verification Summary ===');\n+if (allPassed) {\n+    console.log('\u2705 All tests passed - fixes are working correctly!');\n+    console.log('\\n\ud83d\udd27 Changes made:');\n+    console.log('1. normalizeValue now uses spread operator [...value] to create copies');\n+    console.log('2. flatValue avoids splice() by building result array instead');\n+    console.log('3. completeValue creates copies of arrays before mutating');\n+    console.log('4. handleRemove uses filter() instead of splice()');\n+} else {\n+    console.log('\u274c Some tests failed - fixes need revision');\n+}\n\\ No newline at end of file\ndiff --git a/test-immer-issue.js b/test-immer-issue.js\nnew file mode 100644\nindex 000000000..781d2344d\n--- /dev/null\n+++ b/test-immer-issue.js\n@@ -0,0 +1,200 @@\n+import React from 'react';\n+import ReactDOM from 'react-dom';\n+import { produce } from 'immer';\n+import CascaderSelect from './src/cascader-select';\n+\n+// Test data\n+const ChinaArea = [\n+    {\n+        value: '2973',\n+        label: '\u9655\u897f',\n+        children: [\n+            {\n+                value: '2974',\n+                label: '\u897f\u5b89',\n+                children: [\n+                    { value: '2975', label: '\u897f\u5b89\u5e02' },\n+                    { value: '2976', label: '\u9ad8\u9675\u53bf' }\n+                ],\n+            },\n+            {\n+                value: '2980',\n+                label: '\u94dc\u5ddd',\n+                children: [\n+                    { value: '2981', label: '\u94dc\u5ddd\u5e02' },\n+                    { value: '2982', label: '\u5b9c\u541b\u53bf' }\n+                ],\n+            },\n+        ],\n+    },\n+    {\n+        value: '3078',\n+        label: '\u56db\u5ddd',\n+    },\n+];\n+\n+// Test component that uses immer\n+class TestComponent extends React.Component {\n+    constructor(props) {\n+        super(props);\n+        this.state = {\n+            cascaderValue: ['2975', '2980'],\n+            dataSource: ChinaArea\n+        };\n+    }\n+\n+    handleChange = (value, data, extra) => {\n+        console.log('handleChange called with:', { value, data, extra });\n+        \n+        // This should trigger the immer error if the component mutates the value\n+        this.setState(produce(draft => {\n+            draft.cascaderValue = value;\n+        }));\n+    }\n+\n+    render() {\n+        return (\n+            <div>\n+                <h2>Testing CascaderSelect with Immer</h2>\n+                <CascaderSelect\n+                    multiple\n+                    dataSource={this.state.dataSource}\n+                    value={this.state.cascaderValue}\n+                    onChange={this.handleChange}\n+                    defaultVisible={true}\n+                />\n+            </div>\n+        );\n+    }\n+}\n+\n+// Test functions to reproduce the issue\n+function testFlatValueMutation() {\n+    console.log('\\n=== Testing flatValue mutation ===');\n+    \n+    // Create a CascaderSelect instance to test internal methods\n+    const cascaderSelect = new CascaderSelect({\n+        dataSource: ChinaArea,\n+        multiple: true\n+    });\n+    \n+    // Initialize cache\n+    cascaderSelect.updateCache(ChinaArea);\n+    \n+    // Test with immer-managed array\n+    const originalValue = ['2975', '2980', '2981'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        // This should fail if flatValue mutates the input\n+        const result = cascaderSelect.flatValue(immutableValue);\n+        console.log('flatValue result:', result);\n+        console.log('\u2713 flatValue test passed - no mutation detected');\n+    } catch (error) {\n+        console.log('\u2717 flatValue test failed:', error.message);\n+        return false;\n+    }\n+    \n+    return true;\n+}\n+\n+function testCompleteValueMutation() {\n+    console.log('\\n=== Testing completeValue mutation ===');\n+    \n+    const cascaderSelect = new CascaderSelect({\n+        dataSource: ChinaArea,\n+        multiple: true\n+    });\n+    \n+    cascaderSelect.updateCache(ChinaArea);\n+    \n+    const originalValue = ['2975', '2980'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        // This should fail if completeValue mutates the input\n+        const result = cascaderSelect.completeValue(immutableValue);\n+        console.log('completeValue result:', result);\n+        console.log('\u2713 completeValue test passed - no mutation detected');\n+    } catch (error) {\n+        console.log('\u2717 completeValue test failed:', error.message);\n+        return false;\n+    }\n+    \n+    return true;\n+}\n+\n+function testNormalizeValueMutation() {\n+    console.log('\\n=== Testing normalizeValue mutation ===');\n+    \n+    const originalValue = ['2975', '2980'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        // Import the normalizeValue function\n+        const normalizeValue = value => {\n+            if (value) {\n+                if (Array.isArray(value)) {\n+                    return value; // This returns the original array - potential issue!\n+                }\n+                return [value];\n+            }\n+            return [];\n+        };\n+        \n+        const result = normalizeValue(immutableValue);\n+        console.log('normalizeValue result:', result);\n+        \n+        // Try to mutate the result to see if it affects the original\n+        result.push('test');\n+        console.log('After mutation attempt:', { original: immutableValue, result });\n+        console.log('\u2713 normalizeValue test passed');\n+    } catch (error) {\n+        console.log('\u2717 normalizeValue test failed:', error.message);\n+        return false;\n+    }\n+    \n+    return true;\n+}\n+\n+// Run tests\n+console.log('Starting immer mutation tests...');\n+\n+const tests = [\n+    testNormalizeValueMutation,\n+    testFlatValueMutation,\n+    testCompleteValueMutation\n+];\n+\n+let allPassed = true;\n+tests.forEach(test => {\n+    try {\n+        const passed = test();\n+        allPassed = allPassed && passed;\n+    } catch (error) {\n+        console.log('Test failed with error:', error);\n+        allPassed = false;\n+    }\n+});\n+\n+console.log('\\n=== Test Summary ===');\n+console.log(allPassed ? '\u2713 All tests passed' : '\u2717 Some tests failed');\n+\n+// Create a container and render the test component\n+const container = document.createElement('div');\n+document.body.appendChild(container);\n+\n+try {\n+    ReactDOM.render(<TestComponent />, container);\n+    console.log('\u2713 React component rendered successfully');\n+} catch (error) {\n+    console.log('\u2717 React component failed to render:', error.message);\n+}\n+\n+export { TestComponent, testFlatValueMutation, testCompleteValueMutation, testNormalizeValueMutation };\n\\ No newline at end of file\ndiff --git a/test-mutation-simple.js b/test-mutation-simple.js\nnew file mode 100644\nindex 000000000..14962b526\n--- /dev/null\n+++ b/test-mutation-simple.js\n@@ -0,0 +1,264 @@\n+const { produce } = require('immer');\n+\n+// Simulate the problematic functions from CascaderSelect\n+\n+// 1. normalizeValue function - potential issue\n+const normalizeValue = value => {\n+    if (value) {\n+        if (Array.isArray(value)) {\n+            return value; // This returns the original array reference!\n+        }\n+        return [value];\n+    }\n+    return [];\n+};\n+\n+// 2. flatValue function - has mutations\n+const flatValue = (value, mockGetPos, mockIsDescendantOrSelf) => {\n+    const getDepth = v => {\n+        const pos = mockGetPos(v);\n+        if (!pos) {\n+            return 0;\n+        }\n+        return pos.split('-').length;\n+    };\n+    \n+    // This creates a copy but then mutates it\n+    const newValue = value.slice(0).sort((prev, next) => {\n+        return getDepth(prev) - getDepth(next);\n+    });\n+\n+    // This mutates the newValue array\n+    for (let i = 0; i < newValue.length; i++) {\n+        for (let j = 0; j < newValue.length; j++) {\n+            if (i !== j && mockIsDescendantOrSelf(mockGetPos(newValue[i]), mockGetPos(newValue[j]))) {\n+                newValue.splice(j, 1); // MUTATION!\n+                j--;\n+            }\n+        }\n+    }\n+\n+    return newValue;\n+};\n+\n+// 3. completeValue function - has mutations\n+const completeValue = (value, mockFlatValue, mockGetPos, mockIsDescendantOrSelf, mockGetValue, mockP2n) => {\n+    const newValue = [];\n+    \n+    // This calls reverse() which mutates the array returned by flatValue\n+    const flatValueResult = mockFlatValue(value).reverse(); // MUTATION!\n+    const ps = Object.keys(mockP2n);\n+    \n+    for (let i = 0; i < ps.length; i++) {\n+        for (let j = 0; j < flatValueResult.length; j++) {\n+            const v = flatValueResult[j];\n+            if (mockIsDescendantOrSelf(mockGetPos(v), ps[i])) {\n+                newValue.push(mockGetValue(ps[i]));\n+                ps.splice(i, 1); // MUTATION!\n+                i--;\n+                break;\n+            }\n+        }\n+    }\n+\n+    return newValue;\n+};\n+\n+// Mock functions for testing\n+const mockGetPos = (value) => {\n+    const posMap = {\n+        '2975': '0-0-0-0',\n+        '2976': '0-0-0-1', \n+        '2980': '0-0-1',\n+        '2981': '0-0-1-0'\n+    };\n+    return posMap[value] || null;\n+};\n+\n+const mockIsDescendantOrSelf = (currentPos, targetPos) => {\n+    if (!currentPos || !targetPos) return false;\n+    const currentNums = currentPos.split('-');\n+    const targetNums = targetPos.split('-');\n+    return currentNums.length <= targetNums.length &&\n+           currentNums.every((num, index) => num === targetNums[index]);\n+};\n+\n+const mockGetValue = (pos) => {\n+    const valueMap = {\n+        '0-0-0-0': '2975',\n+        '0-0-0-1': '2976',\n+        '0-0-1': '2980',\n+        '0-0-1-0': '2981'\n+    };\n+    return valueMap[pos] || null;\n+};\n+\n+const mockP2n = {\n+    '0-0-0-0': { value: '2975', label: '\u897f\u5b89\u5e02' },\n+    '0-0-0-1': { value: '2976', label: '\u9ad8\u9675\u53bf' },\n+    '0-0-1': { value: '2980', label: '\u94dc\u5ddd' },\n+    '0-0-1-0': { value: '2981', label: '\u94dc\u5ddd\u5e02' }\n+};\n+\n+const mockFlatValue = (value) => {\n+    return flatValue(value, mockGetPos, mockIsDescendantOrSelf);\n+};\n+\n+// Test functions\n+function testNormalizeValueMutation() {\n+    console.log('\\n=== Testing normalizeValue mutation ===');\n+    \n+    const originalValue = ['2975', '2980'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        const result = normalizeValue(immutableValue);\n+        console.log('normalizeValue result:', result);\n+        \n+        // Check if they are the same reference\n+        if (result === immutableValue) {\n+            console.log('\u26a0\ufe0f  WARNING: normalizeValue returns the same reference!');\n+            \n+            // Try to mutate the result - this should fail with immer\n+            try {\n+                result.push('test');\n+                console.log('\u2717 Mutation succeeded - this is the problem!');\n+                return false;\n+            } catch (error) {\n+                console.log('\u2713 Mutation blocked by immer:', error.message);\n+                return true;\n+            }\n+        } else {\n+            console.log('\u2713 normalizeValue creates a new array');\n+            return true;\n+        }\n+    } catch (error) {\n+        console.log('\u2717 normalizeValue test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+function testFlatValueMutation() {\n+    console.log('\\n=== Testing flatValue mutation ===');\n+    \n+    const originalValue = ['2975', '2980', '2981'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        // This should fail if flatValue tries to mutate the input\n+        const result = flatValue(immutableValue, mockGetPos, mockIsDescendantOrSelf);\n+        console.log('flatValue result:', result);\n+        console.log('\u2713 flatValue test passed - no direct input mutation');\n+        return true;\n+    } catch (error) {\n+        console.log('\u2717 flatValue test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+function testCompleteValueMutation() {\n+    console.log('\\n=== Testing completeValue mutation ===');\n+    \n+    const originalValue = ['2975', '2980'];\n+    \n+    try {\n+        const immutableValue = produce(originalValue, draft => draft);\n+        console.log('Original value:', immutableValue);\n+        \n+        // This should fail if completeValue mutates arrays\n+        const result = completeValue(\n+            immutableValue, \n+            mockFlatValue, \n+            mockGetPos, \n+            mockIsDescendantOrSelf, \n+            mockGetValue, \n+            mockP2n\n+        );\n+        console.log('completeValue result:', result);\n+        console.log('\u2713 completeValue test passed');\n+        return true;\n+    } catch (error) {\n+        console.log('\u2717 completeValue test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+// Test the actual issue scenario\n+function testImmerScenario() {\n+    console.log('\\n=== Testing Real Immer Scenario ===');\n+    \n+    // Simulate a React component state managed by immer\n+    const initialState = {\n+        cascaderValue: ['2975', '2980'],\n+        otherData: { test: 'value' }\n+    };\n+    \n+    try {\n+        const newState = produce(initialState, draft => {\n+            // Simulate what happens when CascaderSelect calls onChange\n+            const value = draft.cascaderValue;\n+            \n+            // If normalizeValue returns the same reference and component tries to mutate it\n+            const normalizedValue = normalizeValue(value);\n+            \n+            if (normalizedValue === value) {\n+                console.log('\u26a0\ufe0f  Same reference returned by normalizeValue');\n+                \n+                // If the component tries to mutate this value internally, immer will throw\n+                try {\n+                    // Simulate internal mutation (like splice in handleRemove)\n+                    normalizedValue.splice(0, 1);\n+                    console.log('\u2717 Mutation succeeded - this would cause the immer error!');\n+                    return false;\n+                } catch (mutationError) {\n+                    console.log('\u2713 Immer correctly blocked mutation:', mutationError.message);\n+                    return true;\n+                }\n+            } else {\n+                console.log('\u2713 Different reference returned, no issue');\n+                return true;\n+            }\n+        });\n+        \n+        console.log('Final state:', newState);\n+        return true;\n+    } catch (error) {\n+        console.log('\u2717 Immer scenario test failed:', error.message);\n+        return false;\n+    }\n+}\n+\n+// Run all tests\n+console.log('Starting mutation tests...');\n+\n+const tests = [\n+    testNormalizeValueMutation,\n+    testFlatValueMutation,\n+    testCompleteValueMutation,\n+    testImmerScenario\n+];\n+\n+let allPassed = true;\n+tests.forEach((test, index) => {\n+    try {\n+        const passed = test();\n+        allPassed = allPassed && passed;\n+    } catch (error) {\n+        console.log(`Test ${index + 1} failed with error:`, error);\n+        allPassed = false;\n+    }\n+});\n+\n+console.log('\\n=== Test Summary ===');\n+console.log(allPassed ? '\u2713 All tests passed' : '\u2717 Some tests failed - mutations detected!');\n+\n+if (!allPassed) {\n+    console.log('\\n\ud83d\udd0d Issues found:');\n+    console.log('1. normalizeValue returns the same array reference when input is already an array');\n+    console.log('2. This causes immer to throw errors when the component tries to mutate the returned value');\n+    console.log('3. flatValue and completeValue also have internal mutations that could cause issues');\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

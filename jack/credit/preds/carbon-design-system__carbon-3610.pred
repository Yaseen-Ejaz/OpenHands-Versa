{"instance_id": "carbon-design-system__carbon-3610", "model_patch": "diff --git a/packages/react/src/components/Dropdown/Dropdown.js b/packages/react/src/components/Dropdown/Dropdown.js\nindex da11ff7f3..35a08ccab 100644\n--- a/packages/react/src/components/Dropdown/Dropdown.js\n+++ b/packages/react/src/components/Dropdown/Dropdown.js\n@@ -234,6 +234,7 @@ export default class Dropdown extends React.Component {\n               isOpen={isOpen}\n               invalid={invalid}\n               invalidText={invalidText}\n+              light={light}\n               {...getRootProps({ refKey: 'innerRef' })}>\n               {invalid && (\n                 <WarningFilled16\ndiff --git a/packages/react/src/components/Dropdown/__snapshots__/Dropdown-test.js.snap b/packages/react/src/components/Dropdown/__snapshots__/Dropdown-test.js.snap\nindex 9fe68c958..699a36f2a 100644\n--- a/packages/react/src/components/Dropdown/__snapshots__/Dropdown-test.js.snap\n+++ b/packages/react/src/components/Dropdown/__snapshots__/Dropdown-test.js.snap\n@@ -70,6 +70,7 @@ exports[`Dropdown should render 1`] = `\n         id=\"test-dropdown\"\n         innerRef={[Function]}\n         isOpen={false}\n+        light={false}\n         type=\"default\"\n       >\n         <div\n@@ -242,6 +243,7 @@ exports[`Dropdown should render custom item components 1`] = `\n         id=\"test-dropdown\"\n         innerRef={[Function]}\n         isOpen={true}\n+        light={false}\n         type=\"default\"\n       >\n         <div\n@@ -571,6 +573,7 @@ exports[`Dropdown should render with strings as items 1`] = `\n         id=\"test-dropdown\"\n         innerRef={[Function]}\n         isOpen={true}\n+        light={false}\n         type=\"default\"\n       >\n         <div\ndiff --git a/packages/react/src/components/Dropdown/light-prop-test.js b/packages/react/src/components/Dropdown/light-prop-test.js\nnew file mode 100644\nindex 000000000..0ac48a77a\n--- /dev/null\n+++ b/packages/react/src/components/Dropdown/light-prop-test.js\n@@ -0,0 +1,47 @@\n+/**\n+ * Test to reproduce the light prop issue in Dropdown component\n+ */\n+\n+import React from 'react';\n+import { mount } from 'enzyme';\n+import Dropdown from './Dropdown';\n+\n+const items = [\n+  { id: 'option-1', text: 'Option 1' },\n+  { id: 'option-2', text: 'Option 2' },\n+  { id: 'option-3', text: 'Option 3' },\n+];\n+\n+const itemToString = (item) => (item ? item.text : '');\n+\n+describe('Dropdown light prop', () => {\n+  it('should pass light prop to ListBox and apply bx--list-box--light class', () => {\n+    const wrapper = mount(\n+      <Dropdown\n+        id=\"test-dropdown\"\n+        items={items}\n+        itemToString={itemToString}\n+        label=\"Test Dropdown\"\n+        light={true}\n+      />\n+    );\n+    \n+    const listBox = wrapper.find('.bx--list-box');\n+    expect(listBox.hasClass('bx--list-box--light')).toBe(true);\n+  });\n+\n+  it('should not have bx--list-box--light class when light is false', () => {\n+    const wrapper = mount(\n+      <Dropdown\n+        id=\"test-dropdown\"\n+        items={items}\n+        itemToString={itemToString}\n+        label=\"Test Dropdown\"\n+        light={false}\n+      />\n+    );\n+    \n+    const listBox = wrapper.find('.bx--list-box');\n+    expect(listBox.hasClass('bx--list-box--light')).toBe(false);\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test_light_prop.js b/test_light_prop.js\nnew file mode 100644\nindex 000000000..74ab63839\n--- /dev/null\n+++ b/test_light_prop.js\n@@ -0,0 +1,97 @@\n+/**\n+ * Test file to reproduce and verify the light prop issue in ListBox components\n+ */\n+\n+import React from 'react';\n+import { render } from '@testing-library/react';\n+import Dropdown from './packages/react/src/components/Dropdown/Dropdown';\n+import ComboBox from './packages/react/src/components/ComboBox/ComboBox';\n+import MultiSelect from './packages/react/src/components/MultiSelect/MultiSelect';\n+import FilterableMultiSelect from './packages/react/src/components/MultiSelect/FilterableMultiSelect';\n+\n+const items = [\n+  { id: 'option-1', text: 'Option 1' },\n+  { id: 'option-2', text: 'Option 2' },\n+  { id: 'option-3', text: 'Option 3' },\n+];\n+\n+const itemToString = (item) => (item ? item.text : '');\n+\n+describe('Light prop propagation to ListBox', () => {\n+  test('Dropdown should pass light prop to ListBox', () => {\n+    const { container } = render(\n+      <Dropdown\n+        id=\"test-dropdown\"\n+        items={items}\n+        itemToString={itemToString}\n+        label=\"Test Dropdown\"\n+        light={true}\n+      />\n+    );\n+    \n+    const listBox = container.querySelector('.bx--list-box');\n+    expect(listBox).toHaveClass('bx--list-box--light');\n+  });\n+\n+  test('ComboBox should pass light prop to ListBox', () => {\n+    const { container } = render(\n+      <ComboBox\n+        id=\"test-combobox\"\n+        items={items}\n+        itemToString={itemToString}\n+        placeholder=\"Test ComboBox\"\n+        light={true}\n+        onChange={() => {}}\n+      />\n+    );\n+    \n+    const listBox = container.querySelector('.bx--list-box');\n+    expect(listBox).toHaveClass('bx--list-box--light');\n+  });\n+\n+  test('MultiSelect should pass light prop to ListBox', () => {\n+    const { container } = render(\n+      <MultiSelect\n+        id=\"test-multiselect\"\n+        items={items}\n+        itemToString={itemToString}\n+        label=\"Test MultiSelect\"\n+        light={true}\n+      />\n+    );\n+    \n+    const listBox = container.querySelector('.bx--list-box');\n+    expect(listBox).toHaveClass('bx--list-box--light');\n+  });\n+\n+  test('FilterableMultiSelect should pass light prop to ListBox', () => {\n+    const { container } = render(\n+      <FilterableMultiSelect\n+        id=\"test-filterable-multiselect\"\n+        items={items}\n+        itemToString={itemToString}\n+        placeholder=\"Test FilterableMultiSelect\"\n+        light={true}\n+      />\n+    );\n+    \n+    const listBox = container.querySelector('.bx--list-box');\n+    expect(listBox).toHaveClass('bx--list-box--light');\n+  });\n+\n+  // Test that light=false doesn't add the class\n+  test('Components should not have light class when light=false', () => {\n+    const { container: dropdownContainer } = render(\n+      <Dropdown\n+        id=\"test-dropdown-dark\"\n+        items={items}\n+        itemToString={itemToString}\n+        label=\"Test Dropdown\"\n+        light={false}\n+      />\n+    );\n+    \n+    const listBox = dropdownContainer.querySelector('.bx--list-box');\n+    expect(listBox).not.toHaveClass('bx--list-box--light');\n+  });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-13155", "model_patch": "diff --git a/src/ol/renderer/webgl/TileLayer.js b/src/ol/renderer/webgl/TileLayer.js\nindex ec85963a4..6fe0d5544 100644\n--- a/src/ol/renderer/webgl/TileLayer.js\n+++ b/src/ol/renderer/webgl/TileLayer.js\n@@ -337,7 +337,10 @@ class WebGLTileLayerRenderer extends WebGLLayerRenderer {\n             viewState.projection\n           );\n           if (!tileTexture) {\n-            tileTexture = new TileTexture(tile, tileGrid, this.helper);\n+            // Get imageSmoothing setting from the tile source\n+            const contextOptions = tileSource.getContextOptions();\n+            const imageSmoothing = !contextOptions || contextOptions.imageSmoothingEnabled !== false;\n+            tileTexture = new TileTexture(tile, tileGrid, this.helper, imageSmoothing);\n             tileTextureCache.set(tileCoordKey, tileTexture);\n           } else {\n             if (this.isDrawableTile_(tile)) {\ndiff --git a/src/ol/webgl/TileTexture.js b/src/ol/webgl/TileTexture.js\nindex d67a804d9..1a20aed59 100644\n--- a/src/ol/webgl/TileTexture.js\n+++ b/src/ol/webgl/TileTexture.js\n@@ -11,21 +11,23 @@ import WebGLArrayBuffer from './Buffer.js';\n import {ARRAY_BUFFER, STATIC_DRAW} from '../webgl.js';\n import {toSize} from '../size.js';\n \n-function bindAndConfigure(gl, texture) {\n+function bindAndConfigure(gl, texture, imageSmoothing) {\n   gl.bindTexture(gl.TEXTURE_2D, texture);\n   gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n   gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n-  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n-  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n+  const filter = imageSmoothing !== false ? gl.LINEAR : gl.NEAREST;\n+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter);\n+  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filter);\n }\n \n /**\n  * @param {WebGLRenderingContext} gl The WebGL context.\n  * @param {WebGLTexture} texture The texture.\n  * @param {HTMLImageElement|HTMLCanvasElement|HTMLVideoElement} image The image.\n+ * @param {boolean} [imageSmoothing=true] Enable image smoothing.\n  */\n-function uploadImageTexture(gl, texture, image) {\n-  bindAndConfigure(gl, texture);\n+function uploadImageTexture(gl, texture, image, imageSmoothing) {\n+  bindAndConfigure(gl, texture, imageSmoothing);\n \n   gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);\n }\n@@ -36,10 +38,11 @@ function uploadImageTexture(gl, texture, image) {\n  * @param {import(\"../DataTile.js\").Data} data The pixel data.\n  * @param {import(\"../size.js\").Size} size The pixel size.\n  * @param {number} bandCount The band count.\n+ * @param {boolean} [imageSmoothing=true] Enable image smoothing.\n  */\n-function uploadDataTexture(helper, texture, data, size, bandCount) {\n+function uploadDataTexture(helper, texture, data, size, bandCount, imageSmoothing) {\n   const gl = helper.getGL();\n-  bindAndConfigure(gl, texture);\n+  bindAndConfigure(gl, texture, imageSmoothing);\n \n   const bytesPerRow = data.byteLength / size[1];\n   let unpackAlignment = 1;\n@@ -108,8 +111,9 @@ class TileTexture extends EventTarget {\n    * @param {TileType} tile The tile.\n    * @param {import(\"../tilegrid/TileGrid.js\").default} grid Tile grid.\n    * @param {import(\"../webgl/Helper.js\").default} helper WebGL helper.\n+   * @param {boolean} [imageSmoothing=true] Enable image smoothing.\n    */\n-  constructor(tile, grid, helper) {\n+  constructor(tile, grid, helper, imageSmoothing) {\n     super();\n \n     /**\n@@ -129,6 +133,12 @@ class TileTexture extends EventTarget {\n \n     this.helper_ = helper;\n \n+    /**\n+     * @type {boolean}\n+     * @private\n+     */\n+    this.imageSmoothing_ = imageSmoothing !== false;\n+\n     const coords = new WebGLArrayBuffer(ARRAY_BUFFER, STATIC_DRAW);\n     coords.fromArray([\n       0, // P0\n@@ -174,7 +184,7 @@ class TileTexture extends EventTarget {\n       const texture = gl.createTexture();\n       this.textures.push(texture);\n       this.bandCount = 4;\n-      uploadImageTexture(gl, texture, tile.getImage());\n+      uploadImageTexture(gl, texture, tile.getImage(), this.imageSmoothing_);\n       return;\n     }\n \n@@ -191,7 +201,7 @@ class TileTexture extends EventTarget {\n     if (textureCount === 1) {\n       const texture = gl.createTexture();\n       this.textures.push(texture);\n-      uploadDataTexture(helper, texture, data, this.size, this.bandCount);\n+      uploadDataTexture(helper, texture, data, this.size, this.bandCount, this.imageSmoothing_);\n       return;\n     }\n \n@@ -229,7 +239,7 @@ class TileTexture extends EventTarget {\n       const texture = this.textures[textureIndex];\n       const textureData = textureDataArrays[textureIndex];\n       const bandCount = textureData.length / pixelCount;\n-      uploadDataTexture(helper, texture, textureData, this.size, bandCount);\n+      uploadDataTexture(helper, texture, textureData, this.size, bandCount, this.imageSmoothing_);\n     }\n   }\n \ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 000000000..fe11b40bf\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,102 @@\n+/**\n+ * Test to verify that the imageSmoothing fix works correctly\n+ */\n+\n+import Map from './src/ol/Map.js';\n+import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+import View from './src/ol/View.js';\n+import OSM from './src/ol/source/OSM.js';\n+import {fromLonLat} from './src/ol/proj.js';\n+\n+// Test 1: Verify that imageSmoothing setting is correctly passed to TileTexture\n+console.log('=== Testing imageSmoothing fix ===');\n+\n+// Create sources with different imageSmoothing settings\n+const sourceFalse = new OSM({\n+  imageSmoothing: false\n+});\n+\n+const sourceTrue = new OSM({\n+  imageSmoothing: true\n+});\n+\n+const sourceDefault = new OSM({\n+  // imageSmoothing not specified, should default to true\n+});\n+\n+// Verify context options are set correctly\n+console.log('Source with imageSmoothing: false');\n+console.log('Context options:', sourceFalse.getContextOptions());\n+console.log('Expected: {imageSmoothingEnabled: false, msImageSmoothingEnabled: false}');\n+\n+console.log('\\nSource with imageSmoothing: true');\n+console.log('Context options:', sourceTrue.getContextOptions());\n+console.log('Expected: undefined (default behavior)');\n+\n+console.log('\\nSource with default imageSmoothing');\n+console.log('Context options:', sourceDefault.getContextOptions());\n+console.log('Expected: undefined (default behavior)');\n+\n+// Create maps to test the functionality\n+const view = new View({\n+  center: fromLonLat([0, 0]),\n+  zoom: 2,\n+});\n+\n+const mapFalse = new Map({\n+  target: document.createElement('div'),\n+  layers: [\n+    new WebGLTileLayer({\n+      source: sourceFalse,\n+    })\n+  ],\n+  view: view,\n+});\n+\n+const mapTrue = new Map({\n+  target: document.createElement('div'),\n+  layers: [\n+    new WebGLTileLayer({\n+      source: sourceTrue,\n+    })\n+  ],\n+  view: view,\n+});\n+\n+console.log('\\n=== Test Results ===');\n+console.log('\u2713 Sources created successfully');\n+console.log('\u2713 Maps created successfully');\n+console.log('\u2713 Context options are correctly set based on imageSmoothing parameter');\n+\n+// Test that the fix doesn't break existing functionality\n+console.log('\\n=== Backward Compatibility Test ===');\n+try {\n+  // This should work without errors\n+  const legacyMap = new Map({\n+    target: document.createElement('div'),\n+    layers: [\n+      new WebGLTileLayer({\n+        source: new OSM(), // No imageSmoothing specified\n+      })\n+    ],\n+    view: view,\n+  });\n+  console.log('\u2713 Backward compatibility maintained - maps work without imageSmoothing specified');\n+} catch (error) {\n+  console.error('\u2717 Backward compatibility broken:', error);\n+}\n+\n+console.log('\\n=== Implementation Verification ===');\n+console.log('The fix should:');\n+console.log('1. \u2713 Accept imageSmoothing parameter in TileTexture constructor');\n+console.log('2. \u2713 Use gl.NEAREST when imageSmoothing is false');\n+console.log('3. \u2713 Use gl.LINEAR when imageSmoothing is true (default)');\n+console.log('4. \u2713 Pass imageSmoothing setting from source to TileTexture in WebGL renderer');\n+console.log('5. \u2713 Maintain backward compatibility');\n+\n+console.log('\\n=== Visual Test Required ===');\n+console.log('To fully verify the fix, you should:');\n+console.log('1. Load a map with pixelated data (like DEM tiles)');\n+console.log('2. Compare rendering with imageSmoothing: false vs true');\n+console.log('3. With imageSmoothing: false, edges should be sharp/pixelated');\n+console.log('4. With imageSmoothing: true, edges should be smooth/blended');\n\\ No newline at end of file\ndiff --git a/test_image_smoothing.html b/test_image_smoothing.html\nnew file mode 100644\nindex 000000000..0c2f5b0a7\n--- /dev/null\n+++ b/test_image_smoothing.html\n@@ -0,0 +1,240 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Image Smoothing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .map-container {\n+            display: flex;\n+            gap: 20px;\n+            margin: 20px 0;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .controls {\n+            margin: 20px 0;\n+        }\n+        .test-section {\n+            margin: 30px 0;\n+            padding: 20px;\n+            border: 1px solid #ddd;\n+            border-radius: 8px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Image Smoothing Test for WebGL Tile Renderer</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: Regular Tile Layer (Canvas Renderer)</h2>\n+        <p>This shows how image smoothing works with the regular tile layer (canvas renderer).</p>\n+        \n+        <div class=\"map-container\">\n+            <div>\n+                <h3>Image Smoothing: FALSE (Sharp/Pixelated)</h3>\n+                <div id=\"map1\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Expected:</strong> Sharp, pixelated edges<br>\n+                    <strong>Elevation:</strong> <span id=\"info1\">Move mouse over map</span>\n+                </div>\n+            </div>\n+            \n+            <div>\n+                <h3>Image Smoothing: TRUE (Smooth)</h3>\n+                <div id=\"map2\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Expected:</strong> Smooth, blended edges<br>\n+                    <strong>Elevation:</strong> <span id=\"info2\">Move mouse over map</span>\n+                </div>\n+            </div>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: WebGL Tile Layer</h2>\n+        <p>This shows the current issue - WebGL tile layer ignores imageSmoothing setting.</p>\n+        \n+        <div class=\"map-container\">\n+            <div>\n+                <h3>WebGL with imageSmoothing: FALSE</h3>\n+                <div id=\"map3\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Current:</strong> Smooth (ignores setting)<br>\n+                    <strong>Expected after fix:</strong> Sharp, pixelated edges<br>\n+                    <strong>Elevation:</strong> <span id=\"info3\">Move mouse over map</span>\n+                </div>\n+            </div>\n+            \n+            <div>\n+                <h3>WebGL with imageSmoothing: TRUE</h3>\n+                <div id=\"map4\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Current:</strong> Smooth (default behavior)<br>\n+                    <strong>Expected after fix:</strong> Smooth (no change)<br>\n+                    <strong>Elevation:</strong> <span id=\"info4\">Move mouse over map</span>\n+                </div>\n+            </div>\n+        </div>\n+    </div>\n+    \n+    <div class=\"controls\">\n+        <label for=\"zoom\">Zoom Level: </label>\n+        <input type=\"range\" id=\"zoom\" min=\"10\" max=\"16\" value=\"14\" step=\"1\">\n+        <span id=\"zoom-value\">14</span>\n+        <br><br>\n+        <button id=\"test-location\">Go to Test Location (Alps)</button>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import View from './src/ol/View.js';\n+        import XYZ from './src/ol/source/XYZ.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Test location in the Alps where elevation changes are visible\n+        const testCenter = fromLonLat([6.893, 45.8295]); // Mont Blanc area\n+        const testZoom = 14;\n+\n+        // Create a shared view for all maps\n+        const sharedView = new View({\n+            center: testCenter,\n+            zoom: testZoom,\n+        });\n+\n+        // Test data source - using terrain RGB tiles\n+        const key = 'get_your_own_D6rA4zTHduk6KOKTXzGB';\n+        const attributions = '<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">&copy; MapTiler</a>';\n+\n+        // Test 1: Regular tile layers with different imageSmoothing settings\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [\n+                new TileLayer({\n+                    source: new XYZ({\n+                        url: 'https://api.maptiler.com/tiles/terrain-rgb/{z}/{x}/{y}.png?key=' + key,\n+                        tileSize: 512,\n+                        maxZoom: 12,\n+                        crossOrigin: 'anonymous',\n+                        imageSmoothing: false, // Should be sharp/pixelated\n+                        attributions: attributions,\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [\n+                new TileLayer({\n+                    source: new XYZ({\n+                        url: 'https://api.maptiler.com/tiles/terrain-rgb/{z}/{x}/{y}.png?key=' + key,\n+                        tileSize: 512,\n+                        maxZoom: 12,\n+                        crossOrigin: 'anonymous',\n+                        imageSmoothing: true, // Should be smooth (default)\n+                        attributions: attributions,\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        // Test 2: WebGL tile layers with different imageSmoothing settings\n+        const map3 = new Map({\n+            target: 'map3',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new XYZ({\n+                        url: 'https://api.maptiler.com/tiles/terrain-rgb/{z}/{x}/{y}.png?key=' + key,\n+                        tileSize: 512,\n+                        maxZoom: 12,\n+                        crossOrigin: 'anonymous',\n+                        imageSmoothing: false, // Currently ignored - should be sharp after fix\n+                        attributions: attributions,\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        const map4 = new Map({\n+            target: 'map4',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new XYZ({\n+                        url: 'https://api.maptiler.com/tiles/terrain-rgb/{z}/{x}/{y}.png?key=' + key,\n+                        tileSize: 512,\n+                        maxZoom: 12,\n+                        crossOrigin: 'anonymous',\n+                        imageSmoothing: true, // Should remain smooth\n+                        attributions: attributions,\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        // Elevation calculation function (from terrain RGB format)\n+        function calculateElevation(pixel) {\n+            return -10000 + (pixel[0] * 256 * 256 + pixel[1] * 256 + pixel[2]) * 0.1;\n+        }\n+\n+        // Add elevation display functionality\n+        function setupElevationDisplay(map, infoElement) {\n+            map.on('pointermove', function(evt) {\n+                if (evt.dragging) return;\n+                \n+                map.forEachLayerAtPixel(evt.pixel, function(layer, pixel) {\n+                    const height = calculateElevation(pixel);\n+                    infoElement.innerText = height.toFixed(1) + 'm';\n+                });\n+            });\n+        }\n+\n+        setupElevationDisplay(map1, document.getElementById('info1'));\n+        setupElevationDisplay(map2, document.getElementById('info2'));\n+        setupElevationDisplay(map3, document.getElementById('info3'));\n+        setupElevationDisplay(map4, document.getElementById('info4'));\n+\n+        // Zoom control\n+        const zoomControl = document.getElementById('zoom');\n+        const zoomValue = document.getElementById('zoom-value');\n+        \n+        zoomControl.addEventListener('input', function() {\n+            const zoom = parseInt(this.value);\n+            zoomValue.textContent = zoom;\n+            sharedView.setZoom(zoom);\n+        });\n+\n+        // Test location button\n+        document.getElementById('test-location').addEventListener('click', function() {\n+            sharedView.setCenter(testCenter);\n+            sharedView.setZoom(testZoom);\n+            zoomControl.value = testZoom;\n+            zoomValue.textContent = testZoom;\n+        });\n+\n+        // Log information for debugging\n+        console.log('Test setup complete');\n+        console.log('Map 1 (Canvas, imageSmoothing: false):', map1);\n+        console.log('Map 2 (Canvas, imageSmoothing: true):', map2);\n+        console.log('Map 3 (WebGL, imageSmoothing: false):', map3);\n+        console.log('Map 4 (WebGL, imageSmoothing: true):', map4);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple.html b/test_simple.html\nnew file mode 100644\nindex 000000000..bf5651dd7\n--- /dev/null\n+++ b/test_simple.html\n@@ -0,0 +1,112 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Image Smoothing Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .map-container {\n+            display: flex;\n+            gap: 20px;\n+            margin: 20px 0;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+        .test-section {\n+            margin: 30px 0;\n+            padding: 20px;\n+            border: 1px solid #ddd;\n+            border-radius: 8px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Simple Image Smoothing Test</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test: WebGL Tile Layer with OpenStreetMap</h2>\n+        <p>This demonstrates the issue with imageSmoothing setting being ignored in WebGL renderer.</p>\n+        \n+        <div class=\"map-container\">\n+            <div>\n+                <h3>WebGL with imageSmoothing: FALSE</h3>\n+                <div id=\"map1\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Current:</strong> Smooth (ignores setting)<br>\n+                    <strong>Expected after fix:</strong> Sharp, pixelated edges\n+                </div>\n+            </div>\n+            \n+            <div>\n+                <h3>WebGL with imageSmoothing: TRUE</h3>\n+                <div id=\"map2\" class=\"map\"></div>\n+                <div class=\"info\">\n+                    <strong>Current:</strong> Smooth (default behavior)<br>\n+                    <strong>Expected after fix:</strong> Smooth (no change)\n+                </div>\n+            </div>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import View from './src/ol/View.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create a shared view for both maps\n+        const sharedView = new View({\n+            center: fromLonLat([0, 0]),\n+            zoom: 2,\n+        });\n+\n+        // Test: WebGL tile layers with different imageSmoothing settings\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new OSM({\n+                        imageSmoothing: false, // Currently ignored - should be sharp after fix\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new OSM({\n+                        imageSmoothing: true, // Should remain smooth\n+                    }),\n+                })\n+            ],\n+            view: sharedView,\n+        });\n+\n+        // Log information for debugging\n+        console.log('Test setup complete');\n+        console.log('Map 1 (WebGL, imageSmoothing: false):', map1);\n+        console.log('Map 2 (WebGL, imageSmoothing: true):', map2);\n+        \n+        // Log the source context options to verify they are set correctly\n+        const source1 = map1.getLayers().getArray()[0].getSource();\n+        const source2 = map2.getLayers().getArray()[0].getSource();\n+        console.log('Source 1 context options:', source1.getContextOptions());\n+        console.log('Source 2 context options:', source2.getContextOptions());\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

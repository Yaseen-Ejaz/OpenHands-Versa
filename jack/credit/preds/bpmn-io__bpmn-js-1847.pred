{"instance_id": "bpmn-io__bpmn-js-1847", "model_patch": "diff --git a/lib/features/create-append-anything/CreateAppendKeyboardBindings.js b/lib/features/create-append-anything/CreateAppendKeyboardBindings.js\nindex a09c7d37..53c493b1 100644\n--- a/lib/features/create-append-anything/CreateAppendKeyboardBindings.js\n+++ b/lib/features/create-append-anything/CreateAppendKeyboardBindings.js\n@@ -38,6 +38,7 @@ CreateAppendKeyboardBindings.prototype.registerBindings = function() {\n   var keyboard = this._keyboard;\n   var editorActions = this._editorActions;\n   var selection = this._selection;\n+  var injector = this._injector;\n \n   // inherit default bindings\n   KeyboardBindings.prototype.registerBindings.call(this, keyboard, editorActions);\n@@ -69,7 +70,32 @@ CreateAppendKeyboardBindings.prototype.registerBindings = function() {\n     if (keyboard && keyboard.isKey([ 'a', 'A' ], event)) {\n \n       if (selection && selection.get().length == 1) {\n-        editorActions && editorActions.trigger('appendElement', event);\n+        var selectedElement = selection.get()[0];\n+\n+        // Check if append is actually available for the selected element\n+        try {\n+          var contextPad = injector.get('contextPad', false);\n+          if (contextPad) {\n+            var contextPadEntries = contextPad.getEntries(selectedElement);\n+            if (contextPadEntries && contextPadEntries.append) {\n+\n+              // Append is available, use it\n+              editorActions && editorActions.trigger('appendElement', event);\n+            } else {\n+\n+              // Append is not available, fall back to create\n+              editorActions && editorActions.trigger('createElement', event);\n+            }\n+          } else {\n+\n+            // No context pad available, fall back to create\n+            editorActions && editorActions.trigger('createElement', event);\n+          }\n+        } catch (error) {\n+\n+          // If there's any error accessing contextPad, fall back to create\n+          editorActions && editorActions.trigger('createElement', event);\n+        }\n       } else {\n         editorActions && editorActions.trigger('createElement', event);\n       }\ndiff --git a/test_append_shortcut.html b/test_append_shortcut.html\nnew file mode 100644\nindex 00000000..dca36c1d\n--- /dev/null\n+++ b/test_append_shortcut.html\n@@ -0,0 +1,255 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Test Append Shortcut Issue</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 0;\n+      padding: 20px;\n+    }\n+    \n+    #canvas {\n+      width: 100%;\n+      height: 500px;\n+      border: 1px solid #ccc;\n+      margin-bottom: 20px;\n+    }\n+    \n+    #controls {\n+      margin-bottom: 20px;\n+    }\n+    \n+    button {\n+      margin-right: 10px;\n+      padding: 10px 15px;\n+      font-size: 14px;\n+    }\n+    \n+    #log {\n+      background: #f5f5f5;\n+      padding: 15px;\n+      border: 1px solid #ddd;\n+      height: 300px;\n+      overflow-y: auto;\n+      font-family: monospace;\n+      font-size: 12px;\n+      white-space: pre-wrap;\n+    }\n+    \n+    .error {\n+      color: red;\n+    }\n+    \n+    .success {\n+      color: green;\n+    }\n+    \n+    .info {\n+      color: blue;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>Test Append Shortcut Issue</h1>\n+  \n+  <div id=\"controls\">\n+    <button onclick=\"runTest()\">Run Test</button>\n+    <button onclick=\"clearLog()\">Clear Log</button>\n+    <button onclick=\"selectEventSubProcess()\">Select Event Sub-Process</button>\n+    <button onclick=\"selectStartEvent()\">Select Start Event</button>\n+    <button onclick=\"simulateAppendShortcut()\">Simulate 'a' Key</button>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <div id=\"log\"></div>\n+\n+  <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modeler;\n+    \n+    const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"5.0.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+    <bpmn:subProcess id=\"EventSubProcess_1\" triggeredByEvent=\"true\">\n+      <bpmn:startEvent id=\"StartEvent_2\" />\n+    </bpmn:subProcess>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EventSubProcess_1_di\" bpmnElement=\"EventSubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"300\" y=\"200\" width=\"350\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"340\" y=\"282\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function log(message, type = 'info') {\n+      const logElement = document.getElementById('log');\n+      const timestamp = new Date().toLocaleTimeString();\n+      const className = type === 'error' ? 'error' : type === 'success' ? 'success' : 'info';\n+      logElement.innerHTML += `<span class=\"${className}\">[${timestamp}] ${message}</span>\\n`;\n+      logElement.scrollTop = logElement.scrollHeight;\n+    }\n+    \n+    function clearLog() {\n+      document.getElementById('log').innerHTML = '';\n+    }\n+    \n+    async function initModeler() {\n+      if (modeler) return;\n+      \n+      log('Initializing BPMN modeler...');\n+      \n+      modeler = new BpmnJS({\n+        container: '#canvas',\n+        keyboard: {\n+          bindTo: window\n+        }\n+      });\n+\n+      try {\n+        await modeler.importXML(xml);\n+        log('\u2713 Diagram imported successfully', 'success');\n+      } catch (error) {\n+        log('\u2717 Failed to import diagram: ' + error.message, 'error');\n+      }\n+    }\n+    \n+    function selectEventSubProcess() {\n+      if (!modeler) {\n+        log('Modeler not initialized', 'error');\n+        return;\n+      }\n+      \n+      const elementRegistry = modeler.get('elementRegistry');\n+      const selection = modeler.get('selection');\n+      const eventSubProcess = elementRegistry.get('EventSubProcess_1');\n+      selection.select(eventSubProcess);\n+      log('\u2713 Event sub-process selected', 'success');\n+    }\n+    \n+    function selectStartEvent() {\n+      if (!modeler) {\n+        log('Modeler not initialized', 'error');\n+        return;\n+      }\n+      \n+      const elementRegistry = modeler.get('elementRegistry');\n+      const selection = modeler.get('selection');\n+      const startEvent = elementRegistry.get('StartEvent_1');\n+      selection.select(startEvent);\n+      log('\u2713 Start event selected', 'success');\n+    }\n+    \n+    function simulateAppendShortcut() {\n+      if (!modeler) {\n+        log('Modeler not initialized', 'error');\n+        return;\n+      }\n+      \n+      log('Simulating \"a\" key press...');\n+      \n+      const keyboardEvent = new KeyboardEvent('keydown', {\n+        key: 'a',\n+        code: 'KeyA',\n+        bubbles: true\n+      });\n+      \n+      const canvas = modeler.get('canvas');\n+      const container = canvas.getContainer();\n+      container.dispatchEvent(keyboardEvent);\n+      \n+      log('\u2713 Keyboard event dispatched', 'info');\n+    }\n+    \n+    async function runTest() {\n+      clearLog();\n+      log('=== Starting Append Shortcut Test ===');\n+      \n+      await initModeler();\n+      \n+      if (!modeler) {\n+        log('Failed to initialize modeler', 'error');\n+        return;\n+      }\n+      \n+      // Get required services\n+      const elementRegistry = modeler.get('elementRegistry');\n+      const selection = modeler.get('selection');\n+      const contextPad = modeler.get('contextPad');\n+      const popupMenu = modeler.get('popupMenu');\n+      const editorActions = modeler.get('editorActions');\n+      const rules = modeler.get('rules');\n+\n+      log('\\n--- Testing Event Sub-Process ---');\n+      \n+      // Test with event sub-process\n+      const eventSubProcess = elementRegistry.get('EventSubProcess_1');\n+      selection.select(eventSubProcess);\n+      log('\u2713 Event sub-process selected');\n+\n+      // Check if append is allowed by rules\n+      const appendAllowed = rules.allowed('shape.append', { element: eventSubProcess });\n+      log('Append allowed by rules: ' + appendAllowed);\n+\n+      // Check if popup menu is empty for append\n+      const isEmpty = popupMenu.isEmpty(eventSubProcess, 'bpmn-append');\n+      log('Popup menu is empty for bpmn-append: ' + isEmpty);\n+\n+      // Check if context pad has append entry\n+      const contextPadEntries = contextPad.getEntries(eventSubProcess);\n+      const hasAppendEntry = 'append' in contextPadEntries;\n+      log('Context pad has append entry: ' + hasAppendEntry);\n+\n+      // Try to trigger appendElement action\n+      log('Attempting to trigger appendElement...');\n+      try {\n+        const result = editorActions.trigger('appendElement');\n+        log('appendElement result: ' + (result || 'undefined'));\n+      } catch (error) {\n+        log('appendElement failed: ' + error.message, 'error');\n+      }\n+\n+      // Try to trigger createElement action\n+      log('Attempting to trigger createElement...');\n+      try {\n+        const result = editorActions.trigger('createElement');\n+        log('createElement result: ' + (result || 'undefined'));\n+      } catch (error) {\n+        log('createElement failed: ' + error.message, 'error');\n+      }\n+\n+      log('\\n--- Testing Start Event (should work) ---');\n+      \n+      // Test with regular start event\n+      const startEvent = elementRegistry.get('StartEvent_1');\n+      selection.select(startEvent);\n+      \n+      const startEventAppendAllowed = rules.allowed('shape.append', { element: startEvent });\n+      const startEventIsEmpty = popupMenu.isEmpty(startEvent, 'bpmn-append');\n+      const startEventContextPadEntries = contextPad.getEntries(startEvent);\n+      const startEventHasAppendEntry = 'append' in startEventContextPadEntries;\n+      \n+      log('Start event - Append allowed by rules: ' + startEventAppendAllowed);\n+      log('Start event - Popup menu is empty for bpmn-append: ' + startEventIsEmpty);\n+      log('Start event - Context pad has append entry: ' + startEventHasAppendEntry);\n+      \n+      log('\\n=== Test Complete ===');\n+      log('Instructions: Select the event sub-process and press \"a\" - nothing should happen');\n+      log('Then select the start event and press \"a\" - append menu should open');\n+    }\n+    \n+    // Initialize when page loads\n+    window.addEventListener('load', initModeler);\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_event_subprocess_fix.js b/test_event_subprocess_fix.js\nnew file mode 100644\nindex 00000000..eb384270\n--- /dev/null\n+++ b/test_event_subprocess_fix.js\n@@ -0,0 +1,111 @@\n+/**\n+ * Test to verify the event sub-process append shortcut fix\n+ */\n+\n+import {\n+  bootstrapViewer,\n+  inject\n+} from 'test/TestHelper';\n+\n+import { forEach } from 'min-dash';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import keyboardModule from 'diagram-js/lib/features/keyboard';\n+import createAppendAnything from 'lib/features/create-append-anything';\n+import editorActions from 'diagram-js/lib/features/editor-actions';\n+\n+import {\n+  createKeyEvent\n+} from 'test/util/KeyEvents';\n+\n+describe('features/create-append-anything - event subprocess fix', function() {\n+\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+    <bpmn:subProcess id=\"EventSubProcess_1\" triggeredByEvent=\"true\">\n+      <bpmn:startEvent id=\"StartEvent_2\" />\n+    </bpmn:subProcess>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EventSubProcess_1_di\" bpmnElement=\"EventSubProcess_1\" isExpanded=\"true\">\n+        <dc:Bounds x=\"300\" y=\"200\" width=\"350\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"340\" y=\"282\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    keyboardModule,\n+    editorActions,\n+    createAppendAnything\n+  ];\n+\n+  beforeEach(bootstrapViewer(diagramXML, { modules: testModules }));\n+\n+  describe('event subprocess append shortcut fallback', function() {\n+\n+    forEach([ 'a', 'A' ], function(key) {\n+\n+      it('should fall back to create menu for event subprocess',\n+        inject(function(keyboard, popupMenu, elementRegistry, selection) {\n+\n+          sinon.spy(popupMenu, 'open');\n+\n+          // given\n+          var eventSubProcess = elementRegistry.get('EventSubProcess_1');\n+\n+          selection.select(eventSubProcess);\n+\n+          var e = createKeyEvent(key);\n+\n+          // when\n+          keyboard._keyHandler(e);\n+\n+          // then\n+          expect(popupMenu.open).to.have.been.calledOnce;\n+          \n+          // Should open create menu, not append menu\n+          var call = popupMenu.open.getCall(0);\n+          expect(call.args[1]).to.equal('bpmn-create');\n+        }));\n+\n+      it('should still use append menu for regular start event',\n+        inject(function(keyboard, popupMenu, elementRegistry, selection) {\n+\n+          sinon.spy(popupMenu, 'open');\n+\n+          // given\n+          var startEvent = elementRegistry.get('StartEvent_1');\n+\n+          selection.select(startEvent);\n+\n+          var e = createKeyEvent(key);\n+\n+          // when\n+          keyboard._keyHandler(e);\n+\n+          // then\n+          expect(popupMenu.open).to.have.been.calledOnce;\n+          \n+          // Should open append menu\n+          var call = popupMenu.open.getCall(0);\n+          expect(call.args[1]).to.equal('bpmn-append');\n+        }));\n+\n+    });\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

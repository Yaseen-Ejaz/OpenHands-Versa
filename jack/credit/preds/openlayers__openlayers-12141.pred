 - - [06/Mar/2026 03:44:20] \"GET /src/ol/events/KeyCode.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/style/IconImageCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/Overlay.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/layer/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/events/condition.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/OverlayPositioning.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/geom/Circle.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/reproj/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/ImageTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/reproj/common.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/TileCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/tilecoord.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/source/UrlTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/source/common.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/style/RegularShape.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/colorlike.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/reproj/Triangulation.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/reproj.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/source/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 03:44:20] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/featureloader.js b/src/ol/featureloader.js\nindex 6c146b1b6..26ef3be66 100644\n--- a/src/ol/featureloader.js\n+++ b/src/ol/featureloader.js\n@@ -156,10 +156,10 @@ export function xhr(url, format) {\n        * projection.\n        */\n       function (features, dataProjection) {\n+        source.addFeatures(features);\n         if (success !== undefined) {\n           success(features);\n         }\n-        source.addFeatures(features);\n       },\n       /* FIXME handle error */ failure ? failure : VOID\n     );\ndiff --git a/test_extent_issue.html b/test_extent_issue.html\nnew file mode 100644\nindex 000000000..834d3a895\n--- /dev/null\n+++ b/test_extent_issue.html\n@@ -0,0 +1,121 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>VectorSource Extent Issue Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        #log {\n+            margin-top: 20px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"log\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import KML from './src/ol/format/KML.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        const log = document.getElementById('log');\n+        function logMessage(message) {\n+            log.textContent += message + '\\n';\n+            console.log(message);\n+        }\n+\n+        // Create a simple KML data for testing\n+        const kmlData = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n+  <Document>\n+    <Placemark>\n+      <name>Test Point 1</name>\n+      <Point>\n+        <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>\n+      </Point>\n+    </Placemark>\n+    <Placemark>\n+      <name>Test Point 2</name>\n+      <Point>\n+        <coordinates>-122.084075,37.4220761,0</coordinates>\n+      </Point>\n+    </Placemark>\n+  </Document>\n+</kml>`;\n+\n+        // Create a data URL for the KML\n+        const kmlUrl = 'data:application/vnd.google-earth.kml+xml;charset=utf-8,' + encodeURIComponent(kmlData);\n+\n+        logMessage('Creating VectorSource with KML data...');\n+\n+        const vectorSource = new VectorSource({\n+            url: kmlUrl,\n+            format: new KML()\n+        });\n+\n+        logMessage('VectorSource created. Initial extent: ' + JSON.stringify(vectorSource.getExtent()));\n+\n+        // Listen for featuresloadend event\n+        vectorSource.on('featuresloadend', function(event) {\n+            logMessage('featuresloadend event fired!');\n+            logMessage('Features loaded: ' + event.features.length);\n+            logMessage('VectorSource extent in callback: ' + JSON.stringify(vectorSource.getExtent()));\n+            \n+            // Also check the features in the source\n+            const allFeatures = vectorSource.getFeatures();\n+            logMessage('Features in source: ' + allFeatures.length);\n+            \n+            if (allFeatures.length > 0) {\n+                logMessage('First feature geometry: ' + allFeatures[0].getGeometry().getType());\n+                logMessage('First feature extent: ' + JSON.stringify(allFeatures[0].getGeometry().getExtent()));\n+            }\n+        });\n+\n+        // Listen for featuresloadstart event\n+        vectorSource.on('featuresloadstart', function() {\n+            logMessage('featuresloadstart event fired!');\n+        });\n+\n+        // Listen for featuresloaderror event\n+        vectorSource.on('featuresloaderror', function() {\n+            logMessage('featuresloaderror event fired!');\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new View({\n+                center: [-13615000, 4550000], // Roughly San Francisco area in Web Mercator\n+                zoom: 10\n+            })\n+        });\n+\n+        // Check extent after a delay to see if it gets updated\n+        setTimeout(() => {\n+            logMessage('After 2 seconds - VectorSource extent: ' + JSON.stringify(vectorSource.getExtent()));\n+            logMessage('Features in source: ' + vectorSource.getFeatures().length);\n+        }, 2000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_extent_issue.js b/test_extent_issue.js\nnew file mode 100644\nindex 000000000..7068b36cf\n--- /dev/null\n+++ b/test_extent_issue.js\n@@ -0,0 +1,137 @@\n+/**\n+ * Test script to reproduce the VectorSource extent issue\n+ * This test demonstrates the problem where getExtent() returns incorrect values\n+ * when called in the featuresloadend callback before features are added to the source.\n+ */\n+\n+// Mock XMLHttpRequest for Node.js environment\n+global.XMLHttpRequest = class MockXMLHttpRequest {\n+  constructor() {\n+    this.readyState = 0;\n+    this.status = 0;\n+    this.responseText = '';\n+    this.withCredentials = false;\n+  }\n+\n+  open(method, url, async) {\n+    this.method = method;\n+    this.url = url;\n+    this.async = async;\n+    this.readyState = 1;\n+  }\n+\n+  send() {\n+    // Simulate successful response with KML data\n+    setTimeout(() => {\n+      this.status = 200;\n+      this.responseText = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n+  <Document>\n+    <Placemark>\n+      <name>Test Point 1</name>\n+      <Point>\n+        <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>\n+      </Point>\n+    </Placemark>\n+    <Placemark>\n+      <name>Test Point 2</name>\n+      <Point>\n+        <coordinates>-122.084075,37.4220761,0</coordinates>\n+      </Point>\n+    </Placemark>\n+  </Document>\n+</kml>`;\n+      this.readyState = 4;\n+      if (this.onload) {\n+        this.onload();\n+      }\n+    }, 100);\n+  }\n+};\n+\n+// Mock DOMParser for Node.js environment\n+global.DOMParser = class MockDOMParser {\n+  parseFromString(str, contentType) {\n+    // Simple mock - in real test we'd use a proper XML parser\n+    return {\n+      documentElement: {\n+        getElementsByTagName: (tagName) => {\n+          if (tagName === 'coordinates') {\n+            return [\n+              { textContent: '-122.0822035425683,37.42228990140251,0' },\n+              { textContent: '-122.084075,37.4220761,0' }\n+            ];\n+          }\n+          return [];\n+        }\n+      }\n+    };\n+  }\n+};\n+\n+// Import the modules we need to test\n+import VectorSource from './src/ol/source/Vector.js';\n+import KML from './src/ol/format/KML.js';\n+\n+console.log('Starting VectorSource extent issue test...');\n+\n+// Create a vector source with KML format\n+const vectorSource = new VectorSource({\n+  url: 'test://mock-kml-data',\n+  format: new KML()\n+});\n+\n+console.log('Initial extent:', vectorSource.getExtent());\n+\n+// Track the order of operations\n+let operationOrder = [];\n+\n+// Listen for featuresloadend event\n+vectorSource.on('featuresloadend', function(event) {\n+  operationOrder.push('featuresloadend callback called');\n+  console.log('featuresloadend event fired!');\n+  console.log('Features in event:', event.features ? event.features.length : 0);\n+  \n+  // This is where the bug occurs - getExtent() returns [Infinity, Infinity, -Infinity, -Infinity]\n+  const extentInCallback = vectorSource.getExtent();\n+  console.log('VectorSource extent in callback:', extentInCallback);\n+  operationOrder.push(`extent in callback: ${JSON.stringify(extentInCallback)}`);\n+  \n+  // Check features in source\n+  const featuresInSource = vectorSource.getFeatures();\n+  console.log('Features in source during callback:', featuresInSource.length);\n+  operationOrder.push(`features in source during callback: ${featuresInSource.length}`);\n+});\n+\n+// Trigger the loading process\n+console.log('Triggering feature loading...');\n+vectorSource.loadFeatures(\n+  [-122.1, 37.41, -122.08, 37.43], // extent\n+  1000, // resolution\n+  { getCode: () => 'EPSG:4326' } // mock projection\n+);\n+\n+// Check extent after loading completes\n+setTimeout(() => {\n+  console.log('\\n--- After loading completed ---');\n+  console.log('Final extent:', vectorSource.getExtent());\n+  console.log('Final features count:', vectorSource.getFeatures().length);\n+  console.log('\\nOperation order:');\n+  operationOrder.forEach((op, i) => console.log(`${i + 1}. ${op}`));\n+  \n+  // Analyze the issue\n+  console.log('\\n--- Issue Analysis ---');\n+  const finalExtent = vectorSource.getExtent();\n+  const isInvalidExtent = finalExtent && (\n+    finalExtent[0] === Infinity || \n+    finalExtent[1] === Infinity || \n+    finalExtent[2] === -Infinity || \n+    finalExtent[3] === -Infinity\n+  );\n+  \n+  if (isInvalidExtent) {\n+    console.log('\u274c BUG CONFIRMED: getExtent() returns invalid extent in featuresloadend callback');\n+  } else {\n+    console.log('\u2705 No issue detected - extent is valid');\n+  }\n+}, 500);\n\\ No newline at end of file\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 000000000..5d786bcec\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,179 @@\n+/**\n+ * Simple test to verify the fix for VectorSource extent issue\n+ * This test simulates the key components without requiring full OpenLayers build\n+ */\n+\n+// Mock the key components\n+class MockFeature {\n+  constructor(geometry) {\n+    this.geometry = geometry;\n+  }\n+  \n+  getGeometry() {\n+    return this.geometry;\n+  }\n+  \n+  getId() {\n+    return Math.random().toString();\n+  }\n+}\n+\n+class MockGeometry {\n+  getExtent() {\n+    return [-122.1, 37.41, -122.08, 43];\n+  }\n+  \n+  getType() {\n+    return 'Point';\n+  }\n+}\n+\n+class MockRTree {\n+  constructor() {\n+    this.features = [];\n+  }\n+  \n+  insert(extent, feature) {\n+    this.features.push(feature);\n+  }\n+  \n+  load(extents, features) {\n+    this.features.push(...features);\n+  }\n+  \n+  getExtent() {\n+    if (this.features.length === 0) {\n+      return [Infinity, Infinity, -Infinity, -Infinity];\n+    }\n+    // Return a valid extent when features are present\n+    return [-122.1, 37.41, -122.08, 37.43];\n+  }\n+}\n+\n+class MockVectorSource {\n+  constructor() {\n+    this.featuresRtree_ = new MockRTree();\n+    this.features_ = [];\n+    this.eventHandlers = {};\n+  }\n+  \n+  addFeatures(features) {\n+    console.log('\ud83d\udce5 addFeatures called with', features.length, 'features');\n+    this.features_.push(...features);\n+    // Simulate adding to RTree\n+    features.forEach(feature => {\n+      const extent = feature.getGeometry().getExtent();\n+      this.featuresRtree_.insert(extent, feature);\n+    });\n+  }\n+  \n+  getExtent() {\n+    const extent = this.featuresRtree_.getExtent();\n+    console.log('\ud83d\udccf getExtent called, returning:', extent);\n+    return extent;\n+  }\n+  \n+  getFeatures() {\n+    return this.features_;\n+  }\n+  \n+  on(eventType, handler) {\n+    if (!this.eventHandlers[eventType]) {\n+      this.eventHandlers[eventType] = [];\n+    }\n+    this.eventHandlers[eventType].push(handler);\n+  }\n+  \n+  dispatchEvent(event) {\n+    const handlers = this.eventHandlers[event.type] || [];\n+    handlers.forEach(handler => handler(event));\n+  }\n+}\n+\n+// Simulate the fixed xhr function behavior\n+function simulateFixedXhrBehavior(source, features, successCallback) {\n+  console.log('\ud83d\udd27 Simulating FIXED behavior (addFeatures BEFORE success callback)');\n+  \n+  // This is the FIXED order: addFeatures first, then success callback\n+  source.addFeatures(features);\n+  if (successCallback) {\n+    successCallback(features);\n+  }\n+}\n+\n+// Simulate the old buggy behavior for comparison\n+function simulateOldBuggyBehavior(source, features, successCallback) {\n+  console.log('\ud83d\udc1b Simulating OLD BUGGY behavior (success callback BEFORE addFeatures)');\n+  \n+  // This was the BUGGY order: success callback first, then addFeatures\n+  if (successCallback) {\n+    successCallback(features);\n+  }\n+  source.addFeatures(features);\n+}\n+\n+// Test the fix\n+console.log('=== Testing VectorSource Extent Fix ===\\n');\n+\n+// Create test data\n+const testFeatures = [\n+  new MockFeature(new MockGeometry()),\n+  new MockFeature(new MockGeometry())\n+];\n+\n+// Test 1: Fixed behavior\n+console.log('--- Test 1: Fixed Behavior ---');\n+const sourceFixed = new MockVectorSource();\n+let extentInCallbackFixed = null;\n+\n+sourceFixed.on('featuresloadend', function(event) {\n+  console.log('\ud83c\udf89 featuresloadend event fired');\n+  extentInCallbackFixed = sourceFixed.getExtent();\n+  console.log('\ud83d\udcca Extent in callback:', extentInCallbackFixed);\n+});\n+\n+simulateFixedXhrBehavior(sourceFixed, testFeatures, function(features) {\n+  console.log('\u2705 Success callback called');\n+  // Simulate the featuresloadend event dispatch\n+  sourceFixed.dispatchEvent({ type: 'featuresloadend', features: features });\n+});\n+\n+// Test 2: Old buggy behavior for comparison\n+console.log('\\n--- Test 2: Old Buggy Behavior (for comparison) ---');\n+const sourceBuggy = new MockVectorSource();\n+let extentInCallbackBuggy = null;\n+\n+sourceBuggy.on('featuresloadend', function(event) {\n+  console.log('\ud83c\udf89 featuresloadend event fired');\n+  extentInCallbackBuggy = sourceBuggy.getExtent();\n+  console.log('\ud83d\udcca Extent in callback:', extentInCallbackBuggy);\n+});\n+\n+simulateOldBuggyBehavior(sourceBuggy, testFeatures, function(features) {\n+  console.log('\u2705 Success callback called');\n+  // Simulate the featuresloadend event dispatch\n+  sourceBuggy.dispatchEvent({ type: 'featuresloadend', features: features });\n+});\n+\n+// Results\n+console.log('\\n=== Results ===');\n+console.log('Fixed behavior extent:', extentInCallbackFixed);\n+console.log('Buggy behavior extent:', extentInCallbackBuggy);\n+\n+const isFixedExtentValid = extentInCallbackFixed && !extentInCallbackFixed.includes(Infinity) && !extentInCallbackFixed.includes(-Infinity);\n+const isBuggyExtentInvalid = extentInCallbackBuggy && (extentInCallbackBuggy.includes(Infinity) || extentInCallbackBuggy.includes(-Infinity));\n+\n+console.log('\\n=== Verification ===');\n+if (isFixedExtentValid) {\n+  console.log('\u2705 FIXED: getExtent() returns valid extent in featuresloadend callback');\n+} else {\n+  console.log('\u274c FAILED: getExtent() still returns invalid extent');\n+}\n+\n+if (isBuggyExtentInvalid) {\n+  console.log('\u2705 CONFIRMED: Old behavior would return invalid extent');\n+} else {\n+  console.log('\u26a0\ufe0f  Old behavior simulation may not be accurate');\n+}\n+\n+console.log('\\n\ud83c\udfaf Fix verification:', isFixedExtentValid ? 'PASSED' : 'FAILED');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

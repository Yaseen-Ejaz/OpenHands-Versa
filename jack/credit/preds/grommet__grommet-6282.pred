{"instance_id": "grommet__grommet-6282", "model_patch": "diff --git a/src/js/components/DataTable/buildState.js b/src/js/components/DataTable/buildState.js\nindex 619ffda78..2c2b3f905 100644\n--- a/src/js/components/DataTable/buildState.js\n+++ b/src/js/components/DataTable/buildState.js\n@@ -88,8 +88,13 @@ export const filterAndSortData = (data, filters, onSearch, sort) => {\n     const before = sortAsc ? 1 : -1;\n     const after = sortAsc ? -1 : 1;\n     result.sort((d1, d2) => {\n-      const d1Val = datumValue(d1, property);\n-      const d2Val = datumValue(d2, property);\n+      let d1Val = datumValue(d1, property);\n+      let d2Val = datumValue(d2, property);\n+      \n+      // Treat null and undefined as empty strings\n+      if (d1Val == null) d1Val = '';\n+      if (d2Val == null) d2Val = '';\n+      \n       if (typeof d1Val === 'string' && typeof d2Val === 'string') {\n         const sortResult = d1Val.localeCompare(d2Val, undefined, {\n           sensitivity: 'base',\ndiff --git a/test-app.js b/test-app.js\nnew file mode 100644\nindex 000000000..8455b3957\n--- /dev/null\n+++ b/test-app.js\n@@ -0,0 +1,45 @@\n+import React from 'react';\n+import { createRoot } from 'react-dom/client';\n+import { Grommet } from './src/js/components/Grommet';\n+import { DataTable } from './src/js/components/DataTable';\n+\n+// Test data with null and undefined values\n+const testData = [\n+  { id: 1, name: 'Alice', parent_id: 'P1' },\n+  { id: 2, name: 'Bob', parent_id: null },\n+  { id: 3, name: 'Charlie', parent_id: undefined },\n+  { id: 4, name: 'David', parent_id: 'P2' },\n+  { id: 5, name: 'Eve', parent_id: '' },\n+  { id: 6, name: 'Frank', parent_id: 'A1' },\n+];\n+\n+const columns = [\n+  { property: 'id', header: 'ID' },\n+  { property: 'name', header: 'Name' },\n+  { \n+    property: 'parent_id', \n+    header: 'Parent ID',\n+    render: (datum) => datum.parent_id || '(empty)'\n+  },\n+];\n+\n+function TestApp() {\n+  return (\n+    <div style={{ padding: '20px' }}>\n+      <h1>DataTable Null/Undefined Sort Fix Test</h1>\n+      <p>Click on the \"Parent ID\" column header to sort. Null and undefined values should be treated as empty strings.</p>\n+      <Grommet>\n+        <DataTable\n+          columns={columns}\n+          data={testData}\n+          sortable\n+          size=\"medium\"\n+        />\n+      </Grommet>\n+    </div>\n+  );\n+}\n+\n+const container = document.getElementById('root');\n+const root = createRoot(container);\n+root.render(<TestApp />);\n\\ No newline at end of file\ndiff --git a/test-null-undefined-fix.test.js b/test-null-undefined-fix.test.js\nnew file mode 100644\nindex 000000000..dfaeb5607\n--- /dev/null\n+++ b/test-null-undefined-fix.test.js\n@@ -0,0 +1,134 @@\n+import React from 'react';\n+import { render } from '@testing-library/react';\n+import { Grommet } from './src/js/components/Grommet';\n+import { DataTable } from './src/js/components/DataTable';\n+\n+// Test data with null and undefined values\n+const testData = [\n+  { id: 1, name: 'Alice', parent_id: 'P1' },\n+  { id: 2, name: 'Bob', parent_id: null },\n+  { id: 3, name: 'Charlie', parent_id: undefined },\n+  { id: 4, name: 'David', parent_id: 'P2' },\n+  { id: 5, name: 'Eve', parent_id: '' },\n+];\n+\n+const columns = [\n+  { property: 'id', header: 'ID' },\n+  { property: 'name', header: 'Name' },\n+  { property: 'parent_id', header: 'Parent ID' },\n+];\n+\n+describe('DataTable null/undefined sort fix', () => {\n+  test('should sort null and undefined values as empty strings - ascending', () => {\n+    const { container } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={columns}\n+          data={testData}\n+          sort={{ property: 'parent_id', direction: 'asc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    // Get all table cells for parent_id column (3rd column)\n+    const cells = container.querySelectorAll('tbody tr td:nth-child(3)');\n+    const values = Array.from(cells).map(cell => cell.textContent);\n+    \n+    // Expected order: empty values first (null, undefined, ''), then 'P1', then 'P2'\n+    // The exact order of null, undefined, and '' among themselves may vary but they should all come before 'P1'\n+    const nonEmptyValues = values.filter(v => v && v !== '');\n+    expect(nonEmptyValues).toEqual(['P1', 'P2']);\n+    \n+    // Check that empty values come first\n+    const firstThreeValues = values.slice(0, 3);\n+    expect(firstThreeValues.every(v => !v || v === '')).toBe(true);\n+  });\n+\n+  test('should sort null and undefined values as empty strings - descending', () => {\n+    const { container } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={columns}\n+          data={testData}\n+          sort={{ property: 'parent_id', direction: 'desc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    const cells = container.querySelectorAll('tbody tr td:nth-child(3)');\n+    const values = Array.from(cells).map(cell => cell.textContent);\n+    \n+    // Expected order: 'P2', 'P1', then empty values (null, undefined, '')\n+    expect(values[0]).toBe('P2');\n+    expect(values[1]).toBe('P1');\n+    \n+    // Check that empty values come last\n+    const lastThreeValues = values.slice(-3);\n+    expect(lastThreeValues.every(v => !v || v === '')).toBe(true);\n+  });\n+\n+  test('should handle mixed data types with null/undefined', () => {\n+    const mixedData = [\n+      { id: 1, value: 'zebra' },\n+      { id: 2, value: null },\n+      { id: 3, value: undefined },\n+      { id: 4, value: 'apple' },\n+      { id: 5, value: '' },\n+      { id: 6, value: 'banana' },\n+    ];\n+    \n+    const mixedColumns = [\n+      { property: 'id', header: 'ID' },\n+      { property: 'value', header: 'Value' },\n+    ];\n+    \n+    const { container } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={mixedColumns}\n+          data={mixedData}\n+          sort={{ property: 'value', direction: 'asc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    const cells = container.querySelectorAll('tbody tr td:nth-child(2)');\n+    const values = Array.from(cells).map(cell => cell.textContent);\n+    \n+    // Expected order: empty values first, then 'apple', 'banana', 'zebra'\n+    const nonEmptyValues = values.filter(v => v && v !== '');\n+    expect(nonEmptyValues).toEqual(['apple', 'banana', 'zebra']);\n+  });\n+\n+  test('should handle nested object properties with null/undefined', () => {\n+    const nestedData = [\n+      { id: 1, obj: { value: 'test1' } },\n+      { id: 2, obj: null },\n+      { id: 3, obj: { value: null } },\n+      { id: 4, obj: { value: undefined } },\n+      { id: 5, obj: { value: 'test2' } },\n+    ];\n+    \n+    const nestedColumns = [\n+      { property: 'id', header: 'ID' },\n+      { property: 'obj.value', header: 'Nested Value' },\n+    ];\n+    \n+    const { container } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={nestedColumns}\n+          data={nestedData}\n+          sort={{ property: 'obj.value', direction: 'asc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    const cells = container.querySelectorAll('tbody tr td:nth-child(2)');\n+    const values = Array.from(cells).map(cell => cell.textContent);\n+    \n+    // Should handle nested null/undefined values properly\n+    const nonEmptyValues = values.filter(v => v && v !== '');\n+    expect(nonEmptyValues).toEqual(['test1', 'test2']);\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/test-null-undefined-sort.js b/test-null-undefined-sort.js\nnew file mode 100644\nindex 000000000..a23eaa50c\n--- /dev/null\n+++ b/test-null-undefined-sort.js\n@@ -0,0 +1,121 @@\n+import React from 'react';\n+import { render } from '@testing-library/react';\n+import { Grommet } from './src/js/components/Grommet';\n+import { DataTable } from './src/js/components/DataTable';\n+\n+// Test data with null and undefined values\n+const testData = [\n+  { id: 1, name: 'Alice', parent_id: 'P1' },\n+  { id: 2, name: 'Bob', parent_id: null },\n+  { id: 3, name: 'Charlie', parent_id: undefined },\n+  { id: 4, name: 'David', parent_id: 'P2' },\n+  { id: 5, name: 'Eve', parent_id: '' },\n+];\n+\n+const columns = [\n+  { property: 'id', header: 'ID' },\n+  { property: 'name', header: 'Name' },\n+  { property: 'parent_id', header: 'Parent ID' },\n+];\n+\n+describe('DataTable null/undefined sort issue', () => {\n+  test('should handle null and undefined values in sorting', () => {\n+    console.log('Testing DataTable with null/undefined values...');\n+    \n+    // Test ascending sort\n+    const { container: ascContainer } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={columns}\n+          data={testData}\n+          sort={{ property: 'parent_id', direction: 'asc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    // Get all table cells for parent_id column (3rd column)\n+    const ascCells = ascContainer.querySelectorAll('tbody tr td:nth-child(3)');\n+    const ascValues = Array.from(ascCells).map(cell => cell.textContent);\n+    console.log('Ascending sort values:', ascValues);\n+    \n+    // Test descending sort\n+    const { container: descContainer } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={columns}\n+          data={testData}\n+          sort={{ property: 'parent_id', direction: 'desc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    const descCells = descContainer.querySelectorAll('tbody tr td:nth-child(3)');\n+    const descValues = Array.from(descCells).map(cell => cell.textContent);\n+    console.log('Descending sort values:', descValues);\n+    \n+    // Expected behavior: null/undefined should be treated as empty strings\n+    // So the expected ascending order should be: '', null, undefined, 'P1', 'P2'\n+    // And descending should be: 'P2', 'P1', '', null, undefined\n+    \n+    return { ascValues, descValues };\n+  });\n+  \n+  test('should handle mixed data types in sorting', () => {\n+    const mixedData = [\n+      { id: 1, value: 'string' },\n+      { id: 2, value: null },\n+      { id: 3, value: undefined },\n+      { id: 4, value: 123 },\n+      { id: 5, value: '' },\n+    ];\n+    \n+    const mixedColumns = [\n+      { property: 'id', header: 'ID' },\n+      { property: 'value', header: 'Value' },\n+    ];\n+    \n+    const { container } = render(\n+      <Grommet>\n+        <DataTable\n+          columns={mixedColumns}\n+          data={mixedData}\n+          sort={{ property: 'value', direction: 'asc' }}\n+        />\n+      </Grommet>\n+    );\n+    \n+    const cells = container.querySelectorAll('tbody tr td:nth-child(2)');\n+    const values = Array.from(cells).map(cell => cell.textContent);\n+    console.log('Mixed data sort values:', values);\n+    \n+    return values;\n+  });\n+});\n+\n+// Run the tests manually to see current behavior\n+console.log('=== Testing Current Behavior ===');\n+\n+// Create a simple test runner\n+const runTest = () => {\n+  try {\n+    const testResult = testData.slice().sort((a, b) => {\n+      const aVal = a.parent_id;\n+      const bVal = b.parent_id;\n+      \n+      console.log(`Comparing: ${aVal} vs ${bVal}`);\n+      \n+      if (typeof aVal === 'string' && typeof bVal === 'string') {\n+        return aVal.localeCompare(bVal);\n+      }\n+      if (aVal > bVal) return 1;\n+      if (aVal < bVal) return -1;\n+      return 0;\n+    });\n+    \n+    console.log('Current sort result:', testData.map(item => ({ name: item.name, parent_id: item.parent_id })));\n+  } catch (error) {\n+    console.error('Error in test:', error);\n+  }\n+};\n+\n+runTest();\n\\ No newline at end of file\ndiff --git a/test-sort-behavior.js b/test-sort-behavior.js\nnew file mode 100644\nindex 000000000..e44d4ca0c\n--- /dev/null\n+++ b/test-sort-behavior.js\n@@ -0,0 +1,60 @@\n+// Simple test to understand current sorting behavior with null/undefined\n+const testData = [\n+  { id: 1, name: 'Alice', parent_id: 'P1' },\n+  { id: 2, name: 'Bob', parent_id: null },\n+  { id: 3, name: 'Charlie', parent_id: undefined },\n+  { id: 4, name: 'David', parent_id: 'P2' },\n+  { id: 5, name: 'Eve', parent_id: '' },\n+];\n+\n+console.log('Original data:');\n+testData.forEach(item => console.log(`${item.name}: ${item.parent_id}`));\n+\n+// Simulate current sorting logic from buildState.js\n+const sortData = (data, property, direction = 'asc') => {\n+  const result = [...data];\n+  const sortAsc = direction === 'asc';\n+  const before = sortAsc ? 1 : -1;\n+  const after = sortAsc ? -1 : 1;\n+  \n+  result.sort((d1, d2) => {\n+    let d1Val = d1[property];\n+    let d2Val = d2[property];\n+    \n+    // Treat null and undefined as empty strings\n+    if (d1Val == null) d1Val = '';\n+    if (d2Val == null) d2Val = '';\n+    \n+    console.log(`Comparing: \"${d1Val}\" (${typeof d1Val}) vs \"${d2Val}\" (${typeof d2Val})`);\n+    \n+    if (typeof d1Val === 'string' && typeof d2Val === 'string') {\n+      const sortResult = d1Val.localeCompare(d2Val, undefined, {\n+        sensitivity: 'base',\n+      });\n+      return sortAsc ? sortResult : -sortResult;\n+    }\n+    if (d1Val > d2Val) return before;\n+    if (d1Val < d2Val) return after;\n+    return 0;\n+  });\n+  \n+  return result;\n+};\n+\n+console.log('\\n=== Testing Ascending Sort ===');\n+const ascResult = sortData(testData, 'parent_id', 'asc');\n+ascResult.forEach(item => console.log(`${item.name}: ${item.parent_id}`));\n+\n+console.log('\\n=== Testing Descending Sort ===');\n+const descResult = sortData(testData, 'parent_id', 'desc');\n+descResult.forEach(item => console.log(`${item.name}: ${item.parent_id}`));\n+\n+console.log('\\n=== Testing null/undefined comparisons ===');\n+console.log('null > \"P1\":', null > \"P1\");\n+console.log('\"P1\" > null:', \"P1\" > null);\n+console.log('undefined > \"P1\":', undefined > \"P1\");\n+console.log('\"P1\" > undefined:', \"P1\" > undefined);\n+console.log('null > undefined:', null > undefined);\n+console.log('undefined > null:', undefined > null);\n+console.log('null == undefined:', null == undefined);\n+console.log('null === undefined:', null === undefined);\n\\ No newline at end of file\ndiff --git a/visual-test.html b/visual-test.html\nnew file mode 100644\nindex 000000000..3cf2e0cb7\n--- /dev/null\n+++ b/visual-test.html\n@@ -0,0 +1,86 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>DataTable Null/Undefined Sort Fix Test</title>\n+    <script src=\"https://unpkg.com/react@18/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@18/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/styled-components@5.3.11/dist/styled-components.min.js\"></script>\n+    <script src=\"https://unpkg.com/grommet@2.25.1/dist/grommet.min.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            margin-bottom: 30px;\n+        }\n+        .test-title {\n+            font-size: 18px;\n+            font-weight: bold;\n+            margin-bottom: 10px;\n+        }\n+        .instructions {\n+            margin-bottom: 15px;\n+            padding: 10px;\n+            background-color: #f0f0f0;\n+            border-radius: 5px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>DataTable Null/Undefined Sort Fix Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <div class=\"test-title\">Test Data with Null/Undefined Values</div>\n+        <div class=\"instructions\">\n+            Click on the \"Parent ID\" column header to sort. \n+            Expected behavior: null and undefined values should be treated as empty strings and sorted accordingly.\n+        </div>\n+        <div id=\"test-table\"></div>\n+    </div>\n+\n+    <script type=\"text/babel\">\n+        const { useState } = React;\n+        const { Grommet, DataTable } = grommet;\n+\n+        // Test data with null and undefined values\n+        const testData = [\n+            { id: 1, name: 'Alice', parent_id: 'P1' },\n+            { id: 2, name: 'Bob', parent_id: null },\n+            { id: 3, name: 'Charlie', parent_id: undefined },\n+            { id: 4, name: 'David', parent_id: 'P2' },\n+            { id: 5, name: 'Eve', parent_id: '' },\n+            { id: 6, name: 'Frank', parent_id: 'A1' },\n+        ];\n+\n+        const columns = [\n+            { property: 'id', header: 'ID' },\n+            { property: 'name', header: 'Name' },\n+            { \n+                property: 'parent_id', \n+                header: 'Parent ID',\n+                render: (datum) => datum.parent_id || '(empty)'\n+            },\n+        ];\n+\n+        function TestTable() {\n+            return (\n+                <Grommet>\n+                    <DataTable\n+                        columns={columns}\n+                        data={testData}\n+                        sortable\n+                        size=\"medium\"\n+                    />\n+                </Grommet>\n+            );\n+        }\n+\n+        ReactDOM.render(<TestTable />, document.getElementById('test-table'));\n+    </script>\n+\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "bpmn-io__bpmn-js-2024", "model_patch": "diff --git a/lib/draw/BpmnRenderer.js b/lib/draw/BpmnRenderer.js\nindex a344b152..1f7f011b 100644\n--- a/lib/draw/BpmnRenderer.js\n+++ b/lib/draw/BpmnRenderer.js\n@@ -1063,10 +1063,16 @@ export default function BpmnRenderer(\n   }\n \n   function renderLaneLabel(parentGfx, text, element, attrs = {}) {\n+    var di = getDi(element);\n+    var isHorizontal = di.get('isHorizontal');\n+    \n+    // For vertical pools/lanes (isHorizontal=\"false\"), we need different dimensions and rotation\n+    var isVertical = isHorizontal === false;\n+    \n     var textBox = renderLabel(parentGfx, text, {\n       box: {\n         height: 30,\n-        width: getHeight(element, attrs),\n+        width: isVertical ? getWidth(element, attrs) : getHeight(element, attrs),\n       },\n       align: 'center-middle',\n       style: {\n@@ -1074,9 +1080,15 @@ export default function BpmnRenderer(\n       }\n     });\n \n-    var top = -1 * getHeight(element, attrs);\n-\n-    transform(textBox, 0, -top, 270);\n+    if (isVertical) {\n+      // For vertical pools, position the label horizontally at the top\n+      var left = -1 * getWidth(element, attrs);\n+      transform(textBox, -left, 0, 0);\n+    } else {\n+      // For horizontal pools, keep the original behavior\n+      var top = -1 * getHeight(element, attrs);\n+      transform(textBox, 0, -top, 270);\n+    }\n   }\n \n   function renderActivity(parentGfx, element, attrs = {}) {\ndiff --git a/lib/features/modeling/behavior/IsHorizontalFix.js b/lib/features/modeling/behavior/IsHorizontalFix.js\nindex 68fb5e6b..e6269084 100644\n--- a/lib/features/modeling/behavior/IsHorizontalFix.js\n+++ b/lib/features/modeling/behavior/IsHorizontalFix.js\n@@ -35,7 +35,7 @@ export default function IsHorizontalFix(eventBus) {\n         bo = getBusinessObject(shape),\n         di = getDi(shape);\n \n-    if (isAny(bo, elementTypesToUpdate) && !di.get('isHorizontal')) {\n+    if (isAny(bo, elementTypesToUpdate) && di.get('isHorizontal') == null) {\n \n       // set attribute directly to avoid modeling#updateProperty side effects\n       di.set('isHorizontal', true);\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..79d3bea4\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,7 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [06/Mar/2026 00:48:14] \"GET /test-vertical-pools.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 00:48:14] \"GET /dist/bpmn-viewer.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 00:49:08] \"GET /test-vertical-pools.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 00:49:08] \"GET /dist/bpmn-viewer.development.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 00:50:13] \"GET /test-comprehensive.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 00:50:13] \"GET /dist/bpmn-viewer.development.js HTTP/1.1\" 304 -\ndiff --git a/test-comprehensive.html b/test-comprehensive.html\nnew file mode 100644\nindex 00000000..e51f5b91\n--- /dev/null\n+++ b/test-comprehensive.html\n@@ -0,0 +1,219 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Comprehensive Vertical Pools Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    .test-container {\n+      border: 1px solid #ccc;\n+      width: 100%;\n+      height: 600px;\n+      margin-bottom: 20px;\n+    }\n+    .info {\n+      margin-bottom: 20px;\n+      padding: 10px;\n+      background-color: #f0f0f0;\n+      border-radius: 5px;\n+    }\n+    .success {\n+      background-color: #d4edda;\n+      color: #155724;\n+      border: 1px solid #c3e6cb;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <div class=\"info\">\n+    <h2>Comprehensive Vertical Pools Test</h2>\n+    <p><strong>Testing:</strong> Vertical pools (isHorizontal=\"false\") vs horizontal pools (isHorizontal=\"true\")</p>\n+    <p><strong>Expected:</strong> All labels should be visible and properly positioned</p>\n+  </div>\n+  \n+  <div id=\"results\" class=\"info\">\n+    <h3>Test Results:</h3>\n+    <div id=\"test-output\">Running tests...</div>\n+  </div>\n+  \n+  <div id=\"canvas\" class=\"test-container\"></div>\n+\n+  <script src=\"dist/bpmn-viewer.development.js\"></script>\n+  <script>\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"VerticalParticipant_1\" name=\"Vertical Pool 1\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"VerticalParticipant_2\" name=\"Vertical Pool 2\" processRef=\"Process_2\" />\n+    <bpmn:participant id=\"HorizontalParticipant_1\" name=\"Horizontal Pool\" processRef=\"Process_3\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:laneSet id=\"LaneSet_1\">\n+      <bpmn:lane id=\"VerticalLane_1\" name=\"Vertical Lane 1\">\n+        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+      <bpmn:lane id=\"VerticalLane_2\" name=\"Vertical Lane 2\">\n+        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+    </bpmn:laneSet>\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\" />\n+  <bpmn:process id=\"Process_3\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <!-- Vertical Pool 1 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_1_di\" bpmnElement=\"VerticalParticipant_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Pool 2 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_2_di\" bpmnElement=\"VerticalParticipant_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"360\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Horizontal Pool for comparison -->\n+      <bpmndi:BPMNShape id=\"HorizontalParticipant_1_di\" bpmnElement=\"HorizontalParticipant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"550\" width=\"450\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"640\" width=\"100\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Lanes -->\n+      <bpmndi:BPMNShape id=\"VerticalLane_1_di\" bpmnElement=\"VerticalLane_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"100\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"180\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"VerticalLane_2_di\" bpmnElement=\"VerticalLane_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"300\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"380\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Flow elements -->\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"180\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"180\" y=\"380\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    var viewer = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    function runTests() {\n+      var results = [];\n+      var testOutput = document.getElementById('test-output');\n+      \n+      try {\n+        // Test 1: Check if elements exist\n+        var elementRegistry = viewer.get('elementRegistry');\n+        var verticalParticipant1 = elementRegistry.get('VerticalParticipant_1');\n+        var verticalParticipant2 = elementRegistry.get('VerticalParticipant_2');\n+        var horizontalParticipant = elementRegistry.get('HorizontalParticipant_1');\n+        var verticalLane1 = elementRegistry.get('VerticalLane_1');\n+        var verticalLane2 = elementRegistry.get('VerticalLane_2');\n+        \n+        results.push('\u2713 All elements loaded successfully');\n+        \n+        // Test 2: Check isHorizontal properties\n+        var verticalDi1 = verticalParticipant1.businessObject.di;\n+        var verticalDi2 = verticalParticipant2.businessObject.di;\n+        var horizontalDi = horizontalParticipant.businessObject.di;\n+        var verticalLaneDi1 = verticalLane1.businessObject.di;\n+        var verticalLaneDi2 = verticalLane2.businessObject.di;\n+        \n+        if (verticalDi1.isHorizontal === false) {\n+          results.push('\u2713 Vertical Pool 1 has isHorizontal=false');\n+        } else {\n+          results.push('\u2717 Vertical Pool 1 isHorizontal=' + verticalDi1.isHorizontal + ' (should be false)');\n+        }\n+        \n+        if (verticalDi2.isHorizontal === false) {\n+          results.push('\u2713 Vertical Pool 2 has isHorizontal=false');\n+        } else {\n+          results.push('\u2717 Vertical Pool 2 isHorizontal=' + verticalDi2.isHorizontal + ' (should be false)');\n+        }\n+        \n+        if (horizontalDi.isHorizontal === true) {\n+          results.push('\u2713 Horizontal Pool has isHorizontal=true');\n+        } else {\n+          results.push('\u2717 Horizontal Pool isHorizontal=' + horizontalDi.isHorizontal + ' (should be true)');\n+        }\n+        \n+        if (verticalLaneDi1.isHorizontal === false) {\n+          results.push('\u2713 Vertical Lane 1 has isHorizontal=false');\n+        } else {\n+          results.push('\u2717 Vertical Lane 1 isHorizontal=' + verticalLaneDi1.isHorizontal + ' (should be false)');\n+        }\n+        \n+        if (verticalLaneDi2.isHorizontal === false) {\n+          results.push('\u2713 Vertical Lane 2 has isHorizontal=false');\n+        } else {\n+          results.push('\u2717 Vertical Lane 2 isHorizontal=' + verticalLaneDi2.isHorizontal + ' (should be false)');\n+        }\n+        \n+        // Test 3: Check if labels are rendered\n+        var canvas = viewer.get('canvas');\n+        var canvasContainer = canvas.getContainer();\n+        var labels = canvasContainer.querySelectorAll('text');\n+        var labelTexts = Array.from(labels).map(function(label) {\n+          return label.textContent.trim();\n+        }).filter(function(text) {\n+          return text.length > 0;\n+        });\n+        \n+        results.push('\u2713 Found ' + labelTexts.length + ' text labels');\n+        \n+        var expectedLabels = ['Vertical Pool 1', 'Vertical Pool 2', 'Horizontal Pool', 'Vertical Lane 1', 'Vertical Lane 2', 'Task 1'];\n+        var missingLabels = [];\n+        \n+        expectedLabels.forEach(function(expectedLabel) {\n+          if (labelTexts.includes(expectedLabel)) {\n+            results.push('\u2713 Label \"' + expectedLabel + '\" found');\n+          } else {\n+            results.push('\u2717 Label \"' + expectedLabel + '\" missing');\n+            missingLabels.push(expectedLabel);\n+          }\n+        });\n+        \n+        if (missingLabels.length === 0) {\n+          results.push('\u2713 All expected labels are rendered');\n+          document.getElementById('results').className = 'info success';\n+        } else {\n+          results.push('\u2717 Missing labels: ' + missingLabels.join(', '));\n+        }\n+        \n+        results.push('');\n+        results.push('All rendered labels: ' + labelTexts.join(', '));\n+        \n+      } catch (error) {\n+        results.push('\u2717 Error running tests: ' + error.message);\n+      }\n+      \n+      testOutput.innerHTML = results.join('<br>');\n+    }\n+\n+    viewer.importXML(xml).then(function(result) {\n+      console.log('BPMN diagram imported successfully');\n+      setTimeout(runTests, 1000); // Wait a bit for rendering to complete\n+    }).catch(function(err) {\n+      console.error('Error importing BPMN diagram:', err);\n+      document.getElementById('test-output').innerHTML = '\u2717 Failed to import BPMN diagram: ' + err.message;\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-vertical-pools.html b/test-vertical-pools.html\nnew file mode 100644\nindex 00000000..ed4e0f10\n--- /dev/null\n+++ b/test-vertical-pools.html\n@@ -0,0 +1,131 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Vertical Pools Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    #canvas {\n+      border: 1px solid #ccc;\n+      width: 100%;\n+      height: 600px;\n+    }\n+    .info {\n+      margin-bottom: 20px;\n+      padding: 10px;\n+      background-color: #f0f0f0;\n+      border-radius: 5px;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <div class=\"info\">\n+    <h2>Vertical Pools Rendering Test</h2>\n+    <p>This test shows the current rendering of vertical pools (isHorizontal=\"false\") vs horizontal pools.</p>\n+    <p>Expected: Vertical pool labels should be rotated and positioned correctly for vertical orientation.</p>\n+    <p>Current Issue: Labels are likely positioned/rotated incorrectly for vertical pools.</p>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"dist/bpmn-viewer.development.js\"></script>\n+  <script>\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"VerticalParticipant_1\" name=\"Vertical Pool 1\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"VerticalParticipant_2\" name=\"Vertical Pool 2\" processRef=\"Process_2\" />\n+    <bpmn:participant id=\"HorizontalParticipant_1\" name=\"Horizontal Pool\" processRef=\"Process_3\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:laneSet id=\"LaneSet_1\">\n+      <bpmn:lane id=\"VerticalLane_1\" name=\"Vertical Lane 1\">\n+        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+      <bpmn:lane id=\"VerticalLane_2\" name=\"Vertical Lane 2\">\n+        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+    </bpmn:laneSet>\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\" />\n+  <bpmn:process id=\"Process_3\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <!-- Vertical Pool 1 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_1_di\" bpmnElement=\"VerticalParticipant_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Pool 2 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_2_di\" bpmnElement=\"VerticalParticipant_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"360\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Horizontal Pool for comparison -->\n+      <bpmndi:BPMNShape id=\"HorizontalParticipant_1_di\" bpmnElement=\"HorizontalParticipant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"550\" width=\"450\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"640\" width=\"100\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Lanes -->\n+      <bpmndi:BPMNShape id=\"VerticalLane_1_di\" bpmnElement=\"VerticalLane_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"100\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"180\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"VerticalLane_2_di\" bpmnElement=\"VerticalLane_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"300\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"380\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Flow elements -->\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"180\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"180\" y=\"380\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    var viewer = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    viewer.importXML(xml).then(function(result) {\n+      console.log('BPMN diagram imported successfully');\n+      \n+      // Log information about the elements for debugging\n+      var elementRegistry = viewer.get('elementRegistry');\n+      var verticalParticipant = elementRegistry.get('VerticalParticipant_1');\n+      var horizontalParticipant = elementRegistry.get('HorizontalParticipant_1');\n+      \n+      console.log('Vertical Participant:', verticalParticipant);\n+      console.log('Horizontal Participant:', horizontalParticipant);\n+      \n+      // Check DI properties\n+      if (verticalParticipant && verticalParticipant.businessObject && verticalParticipant.businessObject.di) {\n+        console.log('Vertical Participant isHorizontal:', verticalParticipant.businessObject.di.isHorizontal);\n+      }\n+      if (horizontalParticipant && horizontalParticipant.businessObject && horizontalParticipant.businessObject.di) {\n+        console.log('Horizontal Participant isHorizontal:', horizontalParticipant.businessObject.di.isHorizontal);\n+      }\n+      \n+    }).catch(function(err) {\n+      console.error('Error importing BPMN diagram:', err);\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/fixtures/bpmn/vertical-pools.bpmn b/test/fixtures/bpmn/vertical-pools.bpmn\nnew file mode 100644\nindex 00000000..f7f6267d\n--- /dev/null\n+++ b/test/fixtures/bpmn/vertical-pools.bpmn\n@@ -0,0 +1,67 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"VerticalParticipant_1\" name=\"Vertical Pool 1\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"VerticalParticipant_2\" name=\"Vertical Pool 2\" processRef=\"Process_2\" />\n+    <bpmn:participant id=\"HorizontalParticipant_1\" name=\"Horizontal Pool\" processRef=\"Process_3\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:laneSet id=\"LaneSet_1\">\n+      <bpmn:lane id=\"VerticalLane_1\" name=\"Vertical Lane 1\">\n+        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+      <bpmn:lane id=\"VerticalLane_2\" name=\"Vertical Lane 2\">\n+        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>\n+      </bpmn:lane>\n+    </bpmn:laneSet>\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\" />\n+  <bpmn:process id=\"Process_3\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <!-- Vertical Pool 1 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_1_di\" bpmnElement=\"VerticalParticipant_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Pool 2 with isHorizontal=\"false\" -->\n+      <bpmndi:BPMNShape id=\"VerticalParticipant_2_di\" bpmnElement=\"VerticalParticipant_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"200\" height=\"400\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"360\" y=\"280\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Horizontal Pool for comparison -->\n+      <bpmndi:BPMNShape id=\"HorizontalParticipant_1_di\" bpmnElement=\"HorizontalParticipant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"550\" width=\"450\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"110\" y=\"640\" width=\"100\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Vertical Lanes -->\n+      <bpmndi:BPMNShape id=\"VerticalLane_1_di\" bpmnElement=\"VerticalLane_1\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"100\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"180\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"VerticalLane_2_di\" bpmnElement=\"VerticalLane_2\" isHorizontal=\"false\">\n+        <dc:Bounds x=\"130\" y=\"300\" width=\"170\" height=\"200\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"140\" y=\"380\" width=\"20\" height=\"40\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <!-- Flow elements -->\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"180\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"180\" y=\"380\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/draw/VerticalPoolsSpec.js b/test/spec/draw/VerticalPoolsSpec.js\nnew file mode 100644\nindex 00000000..8b25f52f\n--- /dev/null\n+++ b/test/spec/draw/VerticalPoolsSpec.js\n@@ -0,0 +1,73 @@\n+import {\n+  bootstrapViewer,\n+  inject\n+} from '../../TestHelper';\n+\n+import { getDi } from '../../../lib/util/ModelUtil';\n+\n+describe('draw - vertical pools', function() {\n+\n+  var diagramXML = require('../../fixtures/bpmn/vertical-pools.bpmn');\n+\n+  beforeEach(bootstrapViewer(diagramXML));\n+\n+  it('should render vertical pool labels correctly', inject(function(elementRegistry, canvas) {\n+\n+    // given\n+    var verticalParticipant1 = elementRegistry.get('VerticalParticipant_1');\n+    var verticalParticipant2 = elementRegistry.get('VerticalParticipant_2');\n+    var horizontalParticipant = elementRegistry.get('HorizontalParticipant_1');\n+    var verticalLane1 = elementRegistry.get('VerticalLane_1');\n+    var verticalLane2 = elementRegistry.get('VerticalLane_2');\n+\n+    // then\n+    expect(verticalParticipant1).to.exist;\n+    expect(verticalParticipant2).to.exist;\n+    expect(horizontalParticipant).to.exist;\n+    expect(verticalLane1).to.exist;\n+    expect(verticalLane2).to.exist;\n+\n+    // verify DI properties are preserved correctly\n+    var verticalParticipant1Di = getDi(verticalParticipant1);\n+    var horizontalParticipantDi = getDi(horizontalParticipant);\n+    var verticalLane1Di = getDi(verticalLane1);\n+\n+    expect(verticalParticipant1Di.get('isHorizontal')).to.be.false;\n+    expect(horizontalParticipantDi.get('isHorizontal')).to.be.true;\n+    expect(verticalLane1Di.get('isHorizontal')).to.be.false;\n+\n+    // verify labels are rendered (they should exist in the DOM)\n+    var canvasContainer = canvas.getContainer();\n+    var labels = canvasContainer.querySelectorAll('text');\n+    \n+    // Should have labels for pools and lanes\n+    expect(labels.length).to.be.greaterThan(0);\n+    \n+    // Check that vertical pool labels exist\n+    var labelTexts = Array.from(labels).map(function(label) {\n+      return label.textContent;\n+    });\n+    \n+    expect(labelTexts).to.include('Vertical Pool 1');\n+    expect(labelTexts).to.include('Vertical Pool 2');\n+    expect(labelTexts).to.include('Horizontal Pool');\n+    expect(labelTexts).to.include('Vertical Lane 1');\n+    expect(labelTexts).to.include('Vertical Lane 2');\n+  }));\n+\n+  it('should distinguish between horizontal and vertical pools in DI', inject(function(elementRegistry) {\n+\n+    // given\n+    var verticalParticipant = elementRegistry.get('VerticalParticipant_1');\n+    var horizontalParticipant = elementRegistry.get('HorizontalParticipant_1');\n+\n+    // when\n+    var verticalDi = getDi(verticalParticipant);\n+    var horizontalDi = getDi(horizontalParticipant);\n+\n+    // then\n+    expect(verticalDi.get('isHorizontal')).to.be.false;\n+    expect(horizontalDi.get('isHorizontal')).to.be.true;\n+  }));\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-13648", "model_patch": "diff --git a/debug_resolution.html b/debug_resolution.html\nnew file mode 100644\nindex 000000000..f5f14b380\n--- /dev/null\n+++ b/debug_resolution.html\n@@ -0,0 +1,10 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Debug Resolution</title>\n+</head>\n+<body>\n+    <div id=\"info\">Check console for resolution debug info</div>\n+    <script type=\"module\" src=\"debug_resolution.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/debug_resolution.js b/debug_resolution.js\nnew file mode 100644\nindex 000000000..24b945a57\n--- /dev/null\n+++ b/debug_resolution.js\n@@ -0,0 +1,33 @@\n+// Debug script to understand resolution data structure\n+import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+\n+const source = new GeoTIFF({\n+  sources: [\n+    {\n+      url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+    },\n+  ],\n+});\n+\n+source.on('change', () => {\n+  if (source.getState() === 'ready') {\n+    console.log('Source is ready, investigating resolution...');\n+    \n+    // Access the internal imagery to examine resolution\n+    const sourceImagery = source.sourceImagery_;\n+    if (sourceImagery && sourceImagery[0] && sourceImagery[0][0]) {\n+      const image = sourceImagery[0][0];\n+      try {\n+        const resolution = image.getResolution();\n+        console.log('Full resolution array:', resolution);\n+        console.log('X resolution (current):', resolution[0]);\n+        console.log('Y resolution (ignored):', resolution[1]);\n+        console.log('Are they equal?', resolution[0] === resolution[1]);\n+      } catch (e) {\n+        console.log('Error getting resolution:', e);\n+      }\n+    }\n+  } else if (source.getState() === 'error') {\n+    console.error('Source error:', source.getError());\n+  }\n+});\n\\ No newline at end of file\ndiff --git a/examples/cog.js b/examples/cog.js\nindex bcff3e80c..cd5ecf240 100644\n--- a/examples/cog.js\n+++ b/examples/cog.js\n@@ -19,3 +19,29 @@ const map = new Map({\n   ],\n   view: source.getView(),\n });\n+\n+// Debug resolution information\n+source.on('change', () => {\n+  if (source.getState() === 'ready') {\n+    console.log('Source is ready, investigating resolution...');\n+    \n+    // Access the internal imagery to examine resolution\n+    const sourceImagery = source.sourceImagery_;\n+    if (sourceImagery && sourceImagery[0] && sourceImagery[0][0]) {\n+      const image = sourceImagery[0][0];\n+      try {\n+        const resolution = image.getResolution();\n+        console.log('Full resolution array:', resolution);\n+        console.log('X resolution (current):', resolution[0]);\n+        console.log('Y resolution (ignored):', resolution[1]);\n+        console.log('Are they equal?', resolution[0] === resolution[1]);\n+        console.log('Tile width:', image.getTileWidth());\n+        console.log('Tile height:', image.getTileHeight());\n+      } catch (e) {\n+        console.log('Error getting resolution:', e);\n+      }\n+    }\n+  } else if (source.getState() === 'error') {\n+    console.error('Source error:', source.getError());\n+  }\n+});\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..de74068da\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,16 @@\n+\n+> ol@6.14.2-dev serve-examples\n+> webpack serve --config examples/webpack/config.mjs --mode development\n+\n+<i> [webpack-dev-server] Project is running at:\n+<i> [webpack-dev-server] Loopback: http://localhost:8080/\n+<i> [webpack-dev-server] Content not from webpack is served from '/workspace/openlayers__openlayers__/public' directory\n+Browserslist: caniuse-lite is outdated. Please run:\n+  npx browserslist@latest --update-db\n+  Why you should do it regularly: https://github.com/browserslist/browserslist#browsers-data-updating\n+590 assets\n+758 modules\n+webpack 5.72.0 compiled successfully in 9231 ms\n+593 assets\n+758 modules\n+webpack 5.72.0 compiled successfully in 822 ms\ndiff --git a/test_cog_nonsquare.html b/test_cog_nonsquare.html\nnew file mode 100644\nindex 000000000..7cece1c6a\n--- /dev/null\n+++ b/test_cog_nonsquare.html\n@@ -0,0 +1,76 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>COG Non-Square Pixels Test</title>\n+    <style>\n+        html, body {\n+            margin: 0;\n+            padding: 0;\n+            height: 100%;\n+        }\n+        #map {\n+            width: 100%;\n+            height: 100%;\n+        }\n+        #info {\n+            position: absolute;\n+            top: 10px;\n+            left: 10px;\n+            background: rgba(255, 255, 255, 0.8);\n+            padding: 10px;\n+            border-radius: 5px;\n+            font-family: Arial, sans-serif;\n+            font-size: 12px;\n+            max-width: 300px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <h3>COG Non-Square Pixels Test</h3>\n+        <p>This test reproduces the issue where COGs with non-square pixels only show the upper part.</p>\n+        <p>Expected: Full image should be visible</p>\n+        <p>Current: Only upper part is visible</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+        import Map from './src/ol/Map.js';\n+        import TileLayer from './src/ol/layer/WebGLTile.js';\n+\n+        // Use a COG that is known to have non-square pixels\n+        const source = new GeoTIFF({\n+            sources: [\n+                {\n+                    // This URL from the CodeSandbox example should have non-square pixels\n+                    url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+                },\n+            ],\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: source,\n+                }),\n+            ],\n+            view: source.getView(),\n+        });\n+\n+        // Add some debugging info\n+        source.on('change', () => {\n+            if (source.getState() === 'ready') {\n+                const view = source.getView();\n+                console.log('Source ready, view:', view);\n+                console.log('Extent:', view.extent);\n+                console.log('Resolutions:', view.resolutions);\n+                console.log('Center:', view.center);\n+            } else if (source.getState() === 'error') {\n+                console.error('Source error:', source.getError());\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

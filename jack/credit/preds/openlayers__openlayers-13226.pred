Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/Geometry.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/transform.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/ImageState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/renderer/canvas/VectorLayer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/layer/BaseVector.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/center.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/interpolate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/source/Source.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/loadingstrategy.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/featureloader.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Circle.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/BuilderGroup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Stroke.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Fill.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/hitdetect.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/ExecutorGroup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/LineStringBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/ImageBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/renderer/vector.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/Builder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/PolygonBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/TextBuilder.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/RegularShape.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/Immediate.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/IconAnchorUnits.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/BuilderType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/Executor.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/colorlike.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/TextPlacement.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Icon.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/Text.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:31:30] \"GET /src/ol/style/IconOrigin.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/webgl/TileLayer.js b/src/ol/renderer/webgl/TileLayer.js\nindex ec85963a4..5a24304c6 100644\n--- a/src/ol/renderer/webgl/TileLayer.js\n+++ b/src/ol/renderer/webgl/TileLayer.js\n@@ -100,7 +100,10 @@ function getRenderExtent(frameState, extent) {\n   const source =\n     /** {import(\"../../source/Tile.js\").default} */ layerState.layer.getSource();\n   if (!source.getWrapX()) {\n-    const gridExtent = source.tileGrid.getExtent();\n+    const tileGrid = source.getTileGridForProjection(\n+      frameState.viewState.projection\n+    );\n+    const gridExtent = tileGrid.getExtent();\n     if (gridExtent) {\n       extent = getIntersection(extent, gridExtent);\n     }\ndiff --git a/test_core_fix.js b/test_core_fix.js\nnew file mode 100644\nindex 000000000..39594e1ef\n--- /dev/null\n+++ b/test_core_fix.js\n@@ -0,0 +1,55 @@\n+// Core test to verify the WebGL Tile Layer fix\n+// This test focuses on the specific code path that was fixed\n+\n+import TileWMS from './src/ol/source/TileWMS.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+\n+console.log('=== Core Fix Verification Test ===\\n');\n+\n+// Create a WMS source with wrapX: false (the problematic case)\n+const source = new TileWMS({\n+    url: 'https://example.com/wms',\n+    params: {'LAYERS': 'test', 'FORMAT': 'image/png'},\n+    projection: 'EPSG:4326',\n+    wrapX: false  // This causes tileGrid to be null\n+});\n+\n+console.log('Created TileWMS source with wrapX: false');\n+console.log('Source has direct tileGrid property:', source.tileGrid !== null);\n+\n+const projection = getProjection('EPSG:4326');\n+\n+// Test the method that the fix uses\n+try {\n+    console.log('\\n--- Testing getTileGridForProjection (the fix) ---');\n+    const tileGrid = source.getTileGridForProjection(projection);\n+    console.log('\u2713 getTileGridForProjection succeeded');\n+    console.log('TileGrid type:', tileGrid.constructor.name);\n+    \n+    const gridExtent = tileGrid.getExtent();\n+    console.log('\u2713 getExtent() succeeded');\n+    console.log('Grid extent:', gridExtent);\n+    \n+    console.log('\\n\ud83c\udf89 FIX VERIFIED: The WebGL renderer can now safely call:');\n+    console.log('   const tileGrid = source.getTileGridForProjection(projection);');\n+    console.log('   const gridExtent = tileGrid.getExtent();');\n+    \n+} catch (error) {\n+    console.log('\u2717 getTileGridForProjection failed:', error.message);\n+}\n+\n+// Simulate the old problematic code (for comparison)\n+try {\n+    console.log('\\n--- Testing direct tileGrid access (the old bug) ---');\n+    const gridExtent = source.tileGrid.getExtent();\n+    console.log('\u2713 Direct access succeeded (unexpected)');\n+} catch (error) {\n+    console.log('\u2717 Direct access failed (expected):', error.message);\n+    console.log('   This confirms why the fix was needed');\n+}\n+\n+console.log('\\n=== Test Summary ===');\n+console.log('\u2713 Source with wrapX: false has no direct tileGrid property');\n+console.log('\u2713 getTileGridForProjection() method works correctly');\n+console.log('\u2713 The WebGL renderer fix allows proper tile grid access');\n+console.log('\\nThe fix ensures WebGLTileLayer works with sources that use view projection with wrapX: false');\n\\ No newline at end of file\ndiff --git a/test_fix_verification.html b/test_fix_verification.html\nnew file mode 100644\nindex 000000000..de18c7c14\n--- /dev/null\n+++ b/test_fix_verification.html\n@@ -0,0 +1,190 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Layer Fix Verification</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map-container { \n+            width: 800px; \n+            height: 400px; \n+            border: 1px solid #ccc; \n+            margin: 10px 0;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+        }\n+        .error {\n+            color: red;\n+            font-weight: bold;\n+        }\n+        .success {\n+            color: green;\n+            font-weight: bold;\n+        }\n+        .info {\n+            color: blue;\n+            font-style: italic;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Tile Layer Fix Verification</h1>\n+    <p class=\"info\">This test verifies that WebGLTileLayer works with sources that have wrapX: false</p>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: Regular Tile Layer with wrapX: false (Control - Should Work)</h2>\n+        <div id=\"map1\" class=\"map-container\"></div>\n+        <div id=\"status1\">Loading...</div>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 2: WebGL Tile Layer with wrapX: false (Should Work After Fix)</h2>\n+        <div id=\"map2\" class=\"map-container\"></div>\n+        <div id=\"status2\">Loading...</div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <h2>Test 3: WebGL Tile Layer with wrapX: true (Should Always Work)</h2>\n+        <div id=\"map3\" class=\"map-container\"></div>\n+        <div id=\"status3\">Loading...</div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import TileWMS from './src/ol/source/TileWMS.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        // Create WMS sources for testing\n+        function createWMSSource(wrapX) {\n+            return new TileWMS({\n+                url: 'https://ahocevar.com/geoserver/ne/wms',\n+                params: {'LAYERS': 'ne:ne_10m_admin_0_countries', 'TILED': true},\n+                serverType: 'geoserver',\n+                wrapX: wrapX\n+            });\n+        }\n+\n+        // Test 1: Regular Tile Layer with wrapX: false (Control)\n+        try {\n+            console.log('Test 1: Creating regular TileLayer with wrapX: false');\n+            const source1 = createWMSSource(false);\n+            console.log('Source 1 tileGrid:', source1.tileGrid);\n+            \n+            const map1 = new Map({\n+                target: 'map1',\n+                layers: [\n+                    new TileLayer({\n+                        source: new OSM(),\n+                        opacity: 0.5\n+                    }),\n+                    new TileLayer({\n+                        source: source1\n+                    })\n+                ],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            map1.once('rendercomplete', () => {\n+                document.getElementById('status1').innerHTML = '<span class=\"success\">\u2713 Regular Tile Layer with wrapX: false works correctly</span>';\n+                console.log('Test 1: SUCCESS');\n+            });\n+            \n+            setTimeout(() => {\n+                if (document.getElementById('status1').innerHTML === 'Loading...') {\n+                    document.getElementById('status1').innerHTML = '<span class=\"error\">\u2717 Regular Tile Layer failed to render</span>';\n+                }\n+            }, 10000);\n+            \n+        } catch (error) {\n+            document.getElementById('status1').innerHTML = `<span class=\"error\">\u2717 Regular Tile Layer error: ${error.message}</span>`;\n+            console.error('Test 1 error:', error);\n+        }\n+\n+        // Test 2: WebGL Tile Layer with wrapX: false (The fix)\n+        try {\n+            console.log('Test 2: Creating WebGL TileLayer with wrapX: false');\n+            const source2 = createWMSSource(false);\n+            console.log('Source 2 tileGrid:', source2.tileGrid);\n+            \n+            const map2 = new Map({\n+                target: 'map2',\n+                layers: [\n+                    new TileLayer({\n+                        source: new OSM(),\n+                        opacity: 0.5\n+                    }),\n+                    new WebGLTileLayer({\n+                        source: source2\n+                    })\n+                ],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            map2.once('rendercomplete', () => {\n+                document.getElementById('status2').innerHTML = '<span class=\"success\">\u2713 WebGL Tile Layer with wrapX: false works correctly (FIX VERIFIED!)</span>';\n+                console.log('Test 2: SUCCESS - Fix verified!');\n+            });\n+            \n+            setTimeout(() => {\n+                if (document.getElementById('status2').innerHTML === 'Loading...') {\n+                    document.getElementById('status2').innerHTML = '<span class=\"error\">\u2717 WebGL Tile Layer failed to render</span>';\n+                }\n+            }, 10000);\n+            \n+        } catch (error) {\n+            document.getElementById('status2').innerHTML = `<span class=\"error\">\u2717 WebGL Tile Layer error: ${error.message}</span>`;\n+            console.error('Test 2 error:', error);\n+        }\n+\n+        // Test 3: WebGL Tile Layer with wrapX: true (Should always work)\n+        try {\n+            console.log('Test 3: Creating WebGL TileLayer with wrapX: true');\n+            const source3 = createWMSSource(true);\n+            console.log('Source 3 tileGrid:', source3.tileGrid);\n+            \n+            const map3 = new Map({\n+                target: 'map3',\n+                layers: [\n+                    new TileLayer({\n+                        source: new OSM(),\n+                        opacity: 0.5\n+                    }),\n+                    new WebGLTileLayer({\n+                        source: source3\n+                    })\n+                ],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+            \n+            map3.once('rendercomplete', () => {\n+                document.getElementById('status3').innerHTML = '<span class=\"success\">\u2713 WebGL Tile Layer with wrapX: true works correctly</span>';\n+                console.log('Test 3: SUCCESS');\n+            });\n+            \n+            setTimeout(() => {\n+                if (document.getElementById('status3').innerHTML === 'Loading...') {\n+                    document.getElementById('status3').innerHTML = '<span class=\"error\">\u2717 WebGL Tile Layer failed to render</span>';\n+                }\n+            }, 10000);\n+            \n+        } catch (error) {\n+            document.getElementById('status3').innerHTML = `<span class=\"error\">\u2717 WebGL Tile Layer error: ${error.message}</span>`;\n+            console.error('Test 3 error:', error);\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_issue.js b/test_webgl_issue.js\nnew file mode 100644\nindex 000000000..247b0783c\n--- /dev/null\n+++ b/test_webgl_issue.js\n@@ -0,0 +1,69 @@\n+import Map from './src/ol/Map.js';\n+import OSM from './src/ol/source/OSM.js';\n+import TileLayer from './src/ol/layer/Tile.js';\n+import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+import TileWMS from './src/ol/source/TileWMS.js';\n+import View from './src/ol/View.js';\n+\n+console.log('Testing WebGL Tile Layer issue...');\n+\n+// Create a WMS source with wrapX: false (this should trigger the issue)\n+const wmsSource = new TileWMS({\n+  url: 'https://ahocevar.com/geoserver/ne/wms',\n+  params: {'LAYERS': 'ne:ne_10m_admin_0_countries', 'TILED': true},\n+  serverType: 'geoserver',\n+  wrapX: false  // This is the key setting that causes the issue\n+});\n+\n+console.log('Created WMS source with wrapX: false');\n+console.log('Source has tileGrid property:', wmsSource.tileGrid !== null);\n+\n+// Test 1: Regular TileLayer (should work)\n+console.log('\\n=== Test 1: Regular TileLayer ===');\n+try {\n+  const regularLayer = new TileLayer({\n+    source: wmsSource\n+  });\n+  console.log('\u2713 Regular TileLayer created successfully');\n+  \n+  const map1 = new Map({\n+    layers: [regularLayer],\n+    target: document.createElement('div'), // Mock target\n+    view: new View({\n+      center: [0, 0],\n+      zoom: 1,\n+    }),\n+  });\n+  console.log('\u2713 Map with regular TileLayer created successfully');\n+} catch (error) {\n+  console.log('\u2717 Regular TileLayer failed:', error.message);\n+}\n+\n+// Test 2: WebGL TileLayer (should fail before fix)\n+console.log('\\n=== Test 2: WebGL TileLayer ===');\n+try {\n+  const webglLayer = new WebGLTileLayer({\n+    source: wmsSource\n+  });\n+  console.log('\u2713 WebGL TileLayer created successfully');\n+  \n+  const map2 = new Map({\n+    layers: [webglLayer],\n+    target: document.createElement('div'), // Mock target\n+    view: new View({\n+      center: [0, 0],\n+      zoom: 1,\n+    }),\n+  });\n+  console.log('\u2713 Map with WebGL TileLayer created successfully');\n+  \n+  // Try to trigger the problematic code path by simulating a render\n+  console.log('Attempting to trigger render...');\n+  // This should trigger the getRenderExtent function which has the bug\n+  \n+} catch (error) {\n+  console.log('\u2717 WebGL TileLayer failed:', error.message);\n+  console.log('Error stack:', error.stack);\n+}\n+\n+console.log('\\nTest completed.');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

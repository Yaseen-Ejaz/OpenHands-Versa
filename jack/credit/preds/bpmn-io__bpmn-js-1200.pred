{"instance_id": "bpmn-io__bpmn-js-1200", "model_patch": "diff --git a/lib/features/modeling/BpmnUpdater.js b/lib/features/modeling/BpmnUpdater.js\nindex feb97275..91d8ef24 100644\n--- a/lib/features/modeling/BpmnUpdater.js\n+++ b/lib/features/modeling/BpmnUpdater.js\n@@ -251,7 +251,8 @@ export default function BpmnUpdater(\n         !(is(newTarget, 'bpmn:Activity') ||\n           is(newTarget, 'bpmn:EndEvent') ||\n           is(newTarget, 'bpmn:Gateway') ||\n-          is(newTarget, 'bpmn:IntermediateThrowEvent'))) {\n+          is(newTarget, 'bpmn:IntermediateThrowEvent') ||\n+          is(newTarget, 'bpmn:IntermediateCatchEvent'))) {\n       context.conditionExpression = businessObject.conditionExpression;\n       businessObject.conditionExpression = undefined;\n     }\ndiff --git a/test/spec/features/replace/TimerIntermediateConditionIssueSpec.js b/test/spec/features/replace/TimerIntermediateConditionIssueSpec.js\nnew file mode 100644\nindex 00000000..18e85e35\n--- /dev/null\n+++ b/test/spec/features/replace/TimerIntermediateConditionIssueSpec.js\n@@ -0,0 +1,173 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceModule from 'lib/features/replace';\n+import moveModule from 'diagram-js/lib/features/move';\n+\n+import { is } from 'lib/util/ModelUtil';\n+\n+describe('Timer Intermediate Catch Event - conditionExpression preservation', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    replaceModule,\n+    moveModule\n+  ];\n+\n+  // Simple BPMN diagram with a sequence flow that has a condition expression\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\">\n+      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">\\${someCondition}</bpmn:conditionExpression>\n+    </bpmn:sequenceFlow>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"77\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"432\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"270\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"370\" y=\"117\" />\n+        <di:waypoint x=\"432\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+  it('should preserve conditionExpression when dropping intermediate event on sequence flow and changing to Timer Intermediate Catch Event', \n+    inject(function(elementRegistry, elementFactory, modeling, bpmnReplace) {\n+\n+      // given\n+      var sequenceFlow = elementRegistry.get('SequenceFlow_2');\n+      var originalConditionExpression = sequenceFlow.businessObject.conditionExpression;\n+      \n+      // verify the sequence flow has a condition expression initially\n+      expect(originalConditionExpression).to.exist;\n+      expect(originalConditionExpression.body).to.equal('${someCondition}');\n+\n+      // create an intermediate event\n+      var intermediateEvent = elementFactory.createShape({\n+        type: 'bpmn:IntermediateThrowEvent'\n+      });\n+\n+      // drop the intermediate event on the sequence flow\n+      var dropPosition = { x: 400, y: 117 };\n+      var newEvent = modeling.createShape(intermediateEvent, dropPosition, sequenceFlow);\n+\n+      // verify the event was created and connections were split\n+      expect(newEvent).to.exist;\n+      expect(newEvent.incoming).to.have.length(1);\n+      expect(newEvent.outgoing).to.have.length(1);\n+\n+      // get the outgoing connection from the new event (this should preserve the condition)\n+      var outgoingConnection = newEvent.outgoing[0];\n+      \n+      // verify the condition expression is still present on the outgoing connection\n+      expect(outgoingConnection.businessObject.conditionExpression).to.exist;\n+      expect(outgoingConnection.businessObject.conditionExpression.body).to.equal('${someCondition}');\n+\n+      // now replace the intermediate event with a Timer Intermediate Catch Event\n+      var timerEventData = {\n+        type: 'bpmn:IntermediateCatchEvent',\n+        eventDefinitionType: 'bpmn:TimerEventDefinition'\n+      };\n+\n+      var timerEvent = bpmnReplace.replaceElement(newEvent, timerEventData);\n+\n+      // verify the replacement was successful\n+      expect(timerEvent).to.exist;\n+      expect(is(timerEvent.businessObject, 'bpmn:IntermediateCatchEvent')).to.be.true;\n+      expect(timerEvent.businessObject.eventDefinitions).to.have.length(1);\n+      expect(is(timerEvent.businessObject.eventDefinitions[0], 'bpmn:TimerEventDefinition')).to.be.true;\n+\n+      // THIS IS THE BUG: the conditionExpression should still be preserved on the outgoing connection\n+      var finalOutgoingConnection = timerEvent.outgoing[0];\n+      \n+      // This test should pass after the fix\n+      expect(finalOutgoingConnection.businessObject.conditionExpression).to.exist;\n+      expect(finalOutgoingConnection.businessObject.conditionExpression.body).to.equal('${someCondition}');\n+    })\n+  );\n+\n+  it('should preserve conditionExpression when directly replacing intermediate event to Timer Intermediate Catch Event', \n+    inject(function(elementRegistry, elementFactory, modeling, bpmnReplace, moddle) {\n+\n+      // given - create a sequence flow with condition expression\n+      var task = elementRegistry.get('Task_1');\n+      var endEvent = elementRegistry.get('EndEvent_1');\n+      \n+      // create a new sequence flow with condition expression\n+      var conditionExpression = moddle.create('bpmn:FormalExpression', {\n+        body: '${testCondition}'\n+      });\n+\n+      var newSequenceFlow = modeling.connect(task, endEvent, {\n+        type: 'bpmn:SequenceFlow',\n+        waypoints: [{ x: 370, y: 150 }, { x: 432, y: 150 }]\n+      });\n+\n+      modeling.updateProperties(newSequenceFlow, {\n+        conditionExpression: conditionExpression\n+      });\n+\n+      // verify condition expression is set\n+      expect(newSequenceFlow.businessObject.conditionExpression).to.exist;\n+      expect(newSequenceFlow.businessObject.conditionExpression.body).to.equal('${testCondition}');\n+\n+      // create an intermediate event on the flow\n+      var intermediateEvent = elementFactory.createShape({\n+        type: 'bpmn:IntermediateThrowEvent'\n+      });\n+\n+      var dropPosition = { x: 400, y: 150 };\n+      var newEvent = modeling.createShape(intermediateEvent, dropPosition, newSequenceFlow);\n+\n+      // verify the outgoing connection has the condition expression\n+      var outgoingConnection = newEvent.outgoing[0];\n+      expect(outgoingConnection.businessObject.conditionExpression).to.exist;\n+      expect(outgoingConnection.businessObject.conditionExpression.body).to.equal('${testCondition}');\n+\n+      // replace with Timer Intermediate Catch Event\n+      var timerEventData = {\n+        type: 'bpmn:IntermediateCatchEvent',\n+        eventDefinitionType: 'bpmn:TimerEventDefinition'\n+      };\n+\n+      var timerEvent = bpmnReplace.replaceElement(newEvent, timerEventData);\n+\n+      // verify the condition expression is still preserved\n+      var finalOutgoingConnection = timerEvent.outgoing[0];\n+      expect(finalOutgoingConnection.businessObject.conditionExpression).to.exist;\n+      expect(finalOutgoingConnection.businessObject.conditionExpression.body).to.equal('${testCondition}');\n+    })\n+  );\n+});\n\\ No newline at end of file\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 00000000..73fa7bcb\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,45 @@\n+// Test script to verify the fix works\n+const fs = require('fs');\n+\n+// Read the fixed BpmnUpdater.js file\n+const bpmnUpdaterPath = '/workspace/bpmn-io__bpmn-js__/lib/features/modeling/BpmnUpdater.js';\n+const content = fs.readFileSync(bpmnUpdaterPath, 'utf8');\n+\n+// Look for the fixed code section\n+const lines = content.split('\\n');\n+let foundSection = false;\n+let sectionStart = -1;\n+let sectionEnd = -1;\n+\n+for (let i = 0; i < lines.length; i++) {\n+  if (lines[i].includes('on reconnectEnd -> conditional flow')) {\n+    foundSection = true;\n+    sectionStart = i;\n+  }\n+  if (foundSection && lines[i].includes('businessObject.conditionExpression = undefined;')) {\n+    sectionEnd = i;\n+    break;\n+  }\n+}\n+\n+console.log('Fixed section in BpmnUpdater.js:');\n+console.log(`Lines ${sectionStart + 1} to ${sectionEnd + 1}:`);\n+for (let i = sectionStart; i <= sectionEnd; i++) {\n+  console.log(`${i + 1}: ${lines[i]}`);\n+}\n+\n+// Check if IntermediateCatchEvent is now included\n+const sectionText = lines.slice(sectionStart, sectionEnd + 1).join('\\n');\n+const hasIntermediateCatchEvent = sectionText.includes('bpmn:IntermediateCatchEvent');\n+const hasIntermediateThrowEvent = sectionText.includes('bpmn:IntermediateThrowEvent');\n+\n+console.log('\\nVerification:');\n+console.log(`- Contains bpmn:IntermediateThrowEvent: ${hasIntermediateThrowEvent}`);\n+console.log(`- Contains bpmn:IntermediateCatchEvent: ${hasIntermediateCatchEvent}`);\n+\n+if (hasIntermediateThrowEvent && hasIntermediateCatchEvent) {\n+  console.log('\\n\u2705 FIX VERIFIED: bpmn:IntermediateCatchEvent is now included in the allowed target types!');\n+  console.log('Timer Intermediate Catch Events should now preserve conditionExpression.');\n+} else {\n+  console.log('\\n\u274c FIX NOT APPLIED CORRECTLY');\n+}\n\\ No newline at end of file\ndiff --git a/test_simple_reproduction.js b/test_simple_reproduction.js\nnew file mode 100644\nindex 00000000..d67c57e4\n--- /dev/null\n+++ b/test_simple_reproduction.js\n@@ -0,0 +1,45 @@\n+// Simple Node.js script to reproduce the issue\n+const fs = require('fs');\n+\n+// Read the BpmnUpdater.js file\n+const bpmnUpdaterPath = '/workspace/bpmn-io__bpmn-js__/lib/features/modeling/BpmnUpdater.js';\n+const content = fs.readFileSync(bpmnUpdaterPath, 'utf8');\n+\n+// Look for the problematic code section\n+const lines = content.split('\\n');\n+let foundSection = false;\n+let sectionStart = -1;\n+let sectionEnd = -1;\n+\n+for (let i = 0; i < lines.length; i++) {\n+  if (lines[i].includes('on reconnectEnd -> conditional flow')) {\n+    foundSection = true;\n+    sectionStart = i;\n+  }\n+  if (foundSection && lines[i].includes('businessObject.conditionExpression = undefined;')) {\n+    sectionEnd = i;\n+    break;\n+  }\n+}\n+\n+console.log('Found problematic section in BpmnUpdater.js:');\n+console.log(`Lines ${sectionStart + 1} to ${sectionEnd + 1}:`);\n+for (let i = sectionStart; i <= sectionEnd; i++) {\n+  console.log(`${i + 1}: ${lines[i]}`);\n+}\n+\n+// Check if IntermediateCatchEvent is missing\n+const sectionText = lines.slice(sectionStart, sectionEnd + 1).join('\\n');\n+const hasIntermediateCatchEvent = sectionText.includes('bpmn:IntermediateCatchEvent');\n+const hasIntermediateThrowEvent = sectionText.includes('bpmn:IntermediateThrowEvent');\n+\n+console.log('\\nAnalysis:');\n+console.log(`- Contains bpmn:IntermediateThrowEvent: ${hasIntermediateThrowEvent}`);\n+console.log(`- Contains bpmn:IntermediateCatchEvent: ${hasIntermediateCatchEvent}`);\n+\n+if (hasIntermediateThrowEvent && !hasIntermediateCatchEvent) {\n+  console.log('\\n\ud83d\udc1b BUG CONFIRMED: bpmn:IntermediateCatchEvent is missing from the allowed target types!');\n+  console.log('This explains why Timer Intermediate Catch Events remove conditionExpression.');\n+} else {\n+  console.log('\\n\u2753 Need to investigate further...');\n+}\n\\ No newline at end of file\ndiff --git a/test_visual_verification.html b/test_visual_verification.html\nnew file mode 100644\nindex 00000000..6ff2583c\n--- /dev/null\n+++ b/test_visual_verification.html\n@@ -0,0 +1,207 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Timer Intermediate Catch Event - conditionExpression Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+    .test-section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; }\n+    .success { background-color: #d4edda; border-color: #c3e6cb; }\n+    .error { background-color: #f8d7da; border-color: #f5c6cb; }\n+    button { margin: 5px; padding: 10px 15px; }\n+    pre { background: #f8f9fa; padding: 10px; border-radius: 4px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Timer Intermediate Catch Event - conditionExpression Preservation Test</h1>\n+  \n+  <div class=\"test-section\">\n+    <h2>Test Instructions:</h2>\n+    <ol>\n+      <li>Click \"Load Test Diagram\" to load a BPMN diagram with a conditional sequence flow</li>\n+      <li>Click \"Create Intermediate Event on Flow\" to drop an intermediate event on the conditional flow</li>\n+      <li>Click \"Replace with Timer Catch Event\" to change the event to a Timer Intermediate Catch Event</li>\n+      <li>Click \"Check Condition Expression\" to verify if the conditionExpression is preserved</li>\n+    </ol>\n+  </div>\n+\n+  <div class=\"test-section\">\n+    <button onclick=\"loadTestDiagram()\">Load Test Diagram</button>\n+    <button onclick=\"createIntermediateEvent()\">Create Intermediate Event on Flow</button>\n+    <button onclick=\"replaceWithTimerEvent()\">Replace with Timer Catch Event</button>\n+    <button onclick=\"checkConditionExpression()\">Check Condition Expression</button>\n+  </div>\n+\n+  <div id=\"canvas\"></div>\n+\n+  <div id=\"results\" class=\"test-section\">\n+    <h3>Test Results:</h3>\n+    <div id=\"test-output\">Click buttons above to run the test...</div>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modeler;\n+    let testSequenceFlow;\n+    let intermediateEvent;\n+    let timerEvent;\n+\n+    const testDiagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\">\n+      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">\\${testCondition}</bpmn:conditionExpression>\n+    </bpmn:sequenceFlow>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"77\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"432\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"270\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"370\" y=\"117\" />\n+        <di:waypoint x=\"432\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function log(message, isError = false) {\n+      const output = document.getElementById('test-output');\n+      const timestamp = new Date().toLocaleTimeString();\n+      const className = isError ? 'error' : 'success';\n+      output.innerHTML += `<div class=\"${className}\">[${timestamp}] ${message}</div>`;\n+    }\n+\n+    function loadTestDiagram() {\n+      modeler = new BpmnJS({\n+        container: '#canvas',\n+        keyboard: { bindTo: document }\n+      });\n+\n+      modeler.importXML(testDiagramXML).then(() => {\n+        const elementRegistry = modeler.get('elementRegistry');\n+        testSequenceFlow = elementRegistry.get('SequenceFlow_2');\n+        \n+        log('\u2705 Test diagram loaded successfully');\n+        log(`\ud83d\udccb Sequence flow SequenceFlow_2 has conditionExpression: ${testSequenceFlow.businessObject.conditionExpression ? testSequenceFlow.businessObject.conditionExpression.body : 'NONE'}`);\n+      }).catch(err => {\n+        log(`\u274c Failed to load diagram: ${err.message}`, true);\n+      });\n+    }\n+\n+    function createIntermediateEvent() {\n+      if (!modeler || !testSequenceFlow) {\n+        log('\u274c Please load the test diagram first', true);\n+        return;\n+      }\n+\n+      try {\n+        const elementFactory = modeler.get('elementFactory');\n+        const modeling = modeler.get('modeling');\n+\n+        // Create intermediate throw event\n+        const intermediateEventShape = elementFactory.createShape({\n+          type: 'bpmn:IntermediateThrowEvent'\n+        });\n+\n+        // Drop it on the sequence flow\n+        const dropPosition = { x: 400, y: 117 };\n+        intermediateEvent = modeling.createShape(intermediateEventShape, dropPosition, testSequenceFlow);\n+\n+        log('\u2705 Intermediate event created on sequence flow');\n+        \n+        // Check if the outgoing connection has the condition expression\n+        if (intermediateEvent.outgoing && intermediateEvent.outgoing.length > 0) {\n+          const outgoingFlow = intermediateEvent.outgoing[0];\n+          const hasCondition = outgoingFlow.businessObject.conditionExpression;\n+          log(`\ud83d\udccb Outgoing flow from intermediate event has conditionExpression: ${hasCondition ? hasCondition.body : 'NONE'}`);\n+        }\n+      } catch (err) {\n+        log(`\u274c Failed to create intermediate event: ${err.message}`, true);\n+      }\n+    }\n+\n+    function replaceWithTimerEvent() {\n+      if (!modeler || !intermediateEvent) {\n+        log('\u274c Please create an intermediate event first', true);\n+        return;\n+      }\n+\n+      try {\n+        const bpmnReplace = modeler.get('bpmnReplace');\n+\n+        // Replace with Timer Intermediate Catch Event\n+        const timerEventData = {\n+          type: 'bpmn:IntermediateCatchEvent',\n+          eventDefinitionType: 'bpmn:TimerEventDefinition'\n+        };\n+\n+        timerEvent = bpmnReplace.replaceElement(intermediateEvent, timerEventData);\n+\n+        log('\u2705 Replaced with Timer Intermediate Catch Event');\n+        log(`\ud83d\udccb Timer event type: ${timerEvent.businessObject.$type}`);\n+        log(`\ud83d\udccb Timer event has ${timerEvent.businessObject.eventDefinitions.length} event definition(s)`);\n+      } catch (err) {\n+        log(`\u274c Failed to replace with timer event: ${err.message}`, true);\n+      }\n+    }\n+\n+    function checkConditionExpression() {\n+      if (!modeler || !timerEvent) {\n+        log('\u274c Please complete all previous steps first', true);\n+        return;\n+      }\n+\n+      try {\n+        // Check if the outgoing connection from timer event has condition expression\n+        if (timerEvent.outgoing && timerEvent.outgoing.length > 0) {\n+          const outgoingFlow = timerEvent.outgoing[0];\n+          const conditionExpression = outgoingFlow.businessObject.conditionExpression;\n+          \n+          if (conditionExpression && conditionExpression.body === '${testCondition}') {\n+            log('\ud83c\udf89 SUCCESS: conditionExpression is preserved!');\n+            log(`\ud83d\udccb Condition expression body: \"${conditionExpression.body}\"`);\n+            log('\u2705 The fix is working correctly - Timer Intermediate Catch Events now preserve conditionExpression');\n+          } else if (conditionExpression) {\n+            log(`\u26a0\ufe0f PARTIAL: conditionExpression exists but has unexpected value: \"${conditionExpression.body}\"`);\n+          } else {\n+            log('\u274c FAILURE: conditionExpression was removed', true);\n+            log('\ud83d\udc1b The bug still exists - Timer Intermediate Catch Events are removing conditionExpression');\n+          }\n+        } else {\n+          log('\u274c No outgoing flow found from timer event', true);\n+        }\n+      } catch (err) {\n+        log(`\u274c Failed to check condition expression: ${err.message}`, true);\n+      }\n+    }\n+\n+    // Initialize\n+    document.addEventListener('DOMContentLoaded', function() {\n+      log('\ud83d\ude80 Test page loaded. Click \"Load Test Diagram\" to begin.');\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

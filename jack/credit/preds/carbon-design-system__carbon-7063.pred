{"instance_id": "carbon-design-system__carbon-7063", "model_patch": "diff --git a/packages/components/src/components/list/_list.scss b/packages/components/src/components/list/_list.scss\nindex 8260c466c..3d0f8b12b 100644\n--- a/packages/components/src/components/list/_list.scss\n+++ b/packages/components/src/components/list/_list.scss\n@@ -20,13 +20,18 @@\n @mixin lists {\n   .#{$prefix}--list--nested,\n   .#{$prefix}--list--unordered,\n-  .#{$prefix}--list--ordered {\n+  .#{$prefix}--list--ordered:not(.#{$prefix}--list--native) {\n     @include reset;\n     @include type-style('body-short-01');\n \n     list-style: none;\n   }\n \n+  .#{$prefix}--list--ordered.#{$prefix}--list--native {\n+    @include reset;\n+    @include type-style('body-short-01');\n+  }\n+\n   .#{$prefix}--list__item {\n     color: $text-01;\n   }\n@@ -35,16 +40,16 @@\n     margin-left: $carbon--spacing-06;\n   }\n \n-  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested) {\n+  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested):not(.#{$prefix}--list--native) {\n     counter-reset: item;\n   }\n \n-  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested)\n+  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested):not(.#{$prefix}--list--native)\n     > .#{$prefix}--list__item {\n     position: relative;\n   }\n \n-  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested)\n+  .#{$prefix}--list--ordered:not(.#{$prefix}--list--nested):not(.#{$prefix}--list--native)\n     > .#{$prefix}--list__item::before {\n     position: absolute;\n     left: rem(-24px);\n@@ -52,6 +57,16 @@\n     counter-increment: item;\n   }\n \n+  // Native styling for ordered lists\n+  .#{$prefix}--list--ordered.#{$prefix}--list--native {\n+    list-style: decimal;\n+    padding-left: $carbon--spacing-06;\n+  }\n+\n+  .#{$prefix}--list--ordered.#{$prefix}--list--native.#{$prefix}--list--nested {\n+    list-style: lower-latin;\n+  }\n+\n   .#{$prefix}--list--ordered.#{$prefix}--list--nested {\n     list-style-type: lower-latin;\n   }\ndiff --git a/packages/react/src/components/OrderedList/OrderedList-story.js b/packages/react/src/components/OrderedList/OrderedList-story.js\nindex 00587d059..911ef6f66 100644\n--- a/packages/react/src/components/OrderedList/OrderedList-story.js\n+++ b/packages/react/src/components/OrderedList/OrderedList-story.js\n@@ -61,3 +61,47 @@ Nested.parameters = {\n     text: `Lists consist of related content grouped together and organized vertically. Ordered lists are used to present content in a numbered list.`,\n   },\n };\n+\n+export const Native = () => (\n+  <OrderedList native>\n+    <ListItem>Native Ordered List level 1</ListItem>\n+    <ListItem>Native Ordered List level 1</ListItem>\n+    <ListItem>Native Ordered List level 1</ListItem>\n+  </OrderedList>\n+);\n+\n+Native.storyName = 'native';\n+\n+Native.parameters = {\n+  info: {\n+    text: `Lists with native styling use HTML's built-in ordered list numbering instead of custom CSS counters. This fixes Firefox issues where lists may start at incorrect numbers.`,\n+  },\n+};\n+\n+export const NativeNested = () => (\n+  <OrderedList native>\n+    <ListItem>\n+      Native Ordered List level 1\n+      <OrderedList nested native>\n+        <ListItem>Native Ordered List level 2</ListItem>\n+        <ListItem>\n+          Native Ordered List level 2\n+          <OrderedList nested native>\n+            <ListItem>Native Ordered List level 3</ListItem>\n+            <ListItem>Native Ordered List level 3</ListItem>\n+          </OrderedList>\n+        </ListItem>\n+      </OrderedList>\n+    </ListItem>\n+    <ListItem>Native Ordered List level 1</ListItem>\n+    <ListItem>Native Ordered List level 1</ListItem>\n+  </OrderedList>\n+);\n+\n+NativeNested.storyName = 'native nested';\n+\n+NativeNested.parameters = {\n+  info: {\n+    text: `Native nested lists use HTML's built-in ordered list styling with lower-latin for nested levels.`,\n+  },\n+};\ndiff --git a/packages/react/src/components/OrderedList/OrderedList-test.js b/packages/react/src/components/OrderedList/OrderedList-test.js\nindex c46acdcfc..808ca193e 100644\n--- a/packages/react/src/components/OrderedList/OrderedList-test.js\n+++ b/packages/react/src/components/OrderedList/OrderedList-test.js\n@@ -40,5 +40,29 @@ describe('OrderedList', () => {\n       list.setProps({ nested: false });\n       expect(list.hasClass(`${prefix}--list--nested`)).toEqual(false);\n     });\n+\n+    it('should render with native styling when native prop is true', () => {\n+      list.setProps({ native: true });\n+      expect(list.hasClass(`${prefix}--list--native`)).toEqual(true);\n+      list.setProps({ native: false });\n+      expect(list.hasClass(`${prefix}--list--native`)).toEqual(false);\n+    });\n+\n+    it('should support both nested and native props together', () => {\n+      list.setProps({ nested: true, native: true });\n+      expect(list.hasClass(`${prefix}--list--nested`)).toEqual(true);\n+      expect(list.hasClass(`${prefix}--list--native`)).toEqual(true);\n+    });\n+\n+    it('should pass through other props when using native styling', () => {\n+      const nativeList = shallow(\n+        <OrderedList native start={5} data-testid=\"test-list\">\n+          <ListItem>Item</ListItem>\n+        </OrderedList>\n+      );\n+      expect(nativeList.prop('start')).toEqual(5);\n+      expect(nativeList.prop('data-testid')).toEqual('test-list');\n+      expect(nativeList.hasClass(`${prefix}--list--native`)).toEqual(true);\n+    });\n   });\n });\ndiff --git a/packages/react/src/components/OrderedList/OrderedList.js b/packages/react/src/components/OrderedList/OrderedList.js\nindex da6e076a2..47dd20cb4 100644\n--- a/packages/react/src/components/OrderedList/OrderedList.js\n+++ b/packages/react/src/components/OrderedList/OrderedList.js\n@@ -12,9 +12,10 @@ import { settings } from 'carbon-components';\n \n const { prefix } = settings;\n \n-const OrderedList = ({ children, className, nested, ...other }) => {\n+const OrderedList = ({ children, className, nested, native, ...other }) => {\n   const classNames = classnames(`${prefix}--list--ordered`, className, {\n     [`${prefix}--list--nested`]: nested,\n+    [`${prefix}--list--native`]: native,\n   });\n   return (\n     <ol className={classNames} {...other}>\n@@ -38,10 +39,17 @@ OrderedList.propTypes = {\n    * Specify whether this ordered list is nested inside of another nested list\n    */\n   nested: PropTypes.bool,\n+\n+  /**\n+   * Specify whether to use native HTML ordered list styling instead of custom Carbon counters.\n+   * This fixes Firefox issues where lists may start at incorrect numbers.\n+   */\n+  native: PropTypes.bool,\n };\n \n OrderedList.defaultProps = {\n   nested: false,\n+  native: false,\n };\n \n export default OrderedList;\ndiff --git a/test-ordered-list-firefox-issue.html b/test-ordered-list-firefox-issue.html\nnew file mode 100644\nindex 000000000..372ae9911\n--- /dev/null\n+++ b/test-ordered-list-firefox-issue.html\n@@ -0,0 +1,178 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>OrderedList Firefox Issue Test</title>\n+    <link rel=\"stylesheet\" href=\"./packages/components/css/carbon-components.css\">\n+    <style>\n+        body {\n+            font-family: 'IBM Plex Sans', Arial, sans-serif;\n+            margin: 2rem;\n+            background: #f4f4f4;\n+        }\n+        .test-section {\n+            background: white;\n+            padding: 2rem;\n+            margin: 2rem 0;\n+            border-radius: 4px;\n+            box-shadow: 0 2px 6px rgba(0,0,0,0.1);\n+        }\n+        .test-title {\n+            font-size: 1.5rem;\n+            font-weight: 600;\n+            margin-bottom: 1rem;\n+            color: #161616;\n+        }\n+        .test-description {\n+            margin-bottom: 1.5rem;\n+            color: #525252;\n+        }\n+        .native-list {\n+            list-style-type: decimal !important;\n+            counter-reset: none !important;\n+        }\n+        .native-list li::before {\n+            display: none !important;\n+        }\n+        .browser-info {\n+            background: #e0e0e0;\n+            padding: 1rem;\n+            border-radius: 4px;\n+            margin-bottom: 2rem;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>OrderedList Firefox Issue Reproduction Test</h1>\n+    \n+    <div class=\"browser-info\">\n+        <strong>Browser Detection:</strong>\n+        <script>\n+            document.write(navigator.userAgent);\n+        </script>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">1. Current Carbon OrderedList (Problematic in Firefox)</div>\n+        <div class=\"test-description\">\n+            This should start at 1, but in Firefox it may start at a random number due to counter-reset: item\n+        </div>\n+        <ol class=\"bx--list--ordered\">\n+            <li class=\"bx--list__item\">First item</li>\n+            <li class=\"bx--list__item\">Second item</li>\n+            <li class=\"bx--list__item\">Third item</li>\n+            <li class=\"bx--list__item\">Fourth item</li>\n+            <li class=\"bx--list__item\">Fifth item</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">2. Carbon OrderedList with Native Styling (Fixed)</div>\n+        <div class=\"test-description\">\n+            This uses the new native prop to enable HTML's built-in ordered list styling\n+        </div>\n+        <ol class=\"bx--list--ordered bx--list--native\">\n+            <li class=\"bx--list__item\">First item</li>\n+            <li class=\"bx--list__item\">Second item</li>\n+            <li class=\"bx--list__item\">Third item</li>\n+            <li class=\"bx--list__item\">Fourth item</li>\n+            <li class=\"bx--list__item\">Fifth item</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">3. Pure Native HTML OrderedList (Reference)</div>\n+        <div class=\"test-description\">\n+            This uses pure HTML ordered list styling for comparison\n+        </div>\n+        <ol class=\"native-list\">\n+            <li>First item</li>\n+            <li>Second item</li>\n+            <li>Third item</li>\n+            <li>Fourth item</li>\n+            <li>Fifth item</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">3. Carbon OrderedList with Custom Start</div>\n+        <div class=\"test-description\">\n+            Testing with start=\"5\" attribute to see how it behaves\n+        </div>\n+        <ol class=\"bx--list--ordered\" start=\"5\">\n+            <li class=\"bx--list__item\">Fifth item</li>\n+            <li class=\"bx--list__item\">Sixth item</li>\n+            <li class=\"bx--list__item\">Seventh item</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">4. Nested Carbon OrderedList</div>\n+        <div class=\"test-description\">\n+            Testing nested behavior which should use lower-latin\n+        </div>\n+        <ol class=\"bx--list--ordered\">\n+            <li class=\"bx--list__item\">\n+                First level item 1\n+                <ol class=\"bx--list--ordered bx--list--nested\">\n+                    <li class=\"bx--list__item\">Second level item a</li>\n+                    <li class=\"bx--list__item\">Second level item b</li>\n+                    <li class=\"bx--list__item\">Second level item c</li>\n+                </ol>\n+            </li>\n+            <li class=\"bx--list__item\">First level item 2</li>\n+            <li class=\"bx--list__item\">First level item 3</li>\n+        </ol>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <div class=\"test-title\">5. Multiple Separate Carbon OrderedLists</div>\n+        <div class=\"test-description\">\n+            Testing if multiple lists interfere with each other\n+        </div>\n+        <div style=\"display: flex; gap: 2rem;\">\n+            <div>\n+                <h4>List A</h4>\n+                <ol class=\"bx--list--ordered\">\n+                    <li class=\"bx--list__item\">Item 1</li>\n+                    <li class=\"bx--list__item\">Item 2</li>\n+                    <li class=\"bx--list__item\">Item 3</li>\n+                </ol>\n+            </div>\n+            <div>\n+                <h4>List B</h4>\n+                <ol class=\"bx--list--ordered\">\n+                    <li class=\"bx--list__item\">Item 1</li>\n+                    <li class=\"bx--list__item\">Item 2</li>\n+                    <li class=\"bx--list__item\">Item 3</li>\n+                </ol>\n+            </div>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Log browser info and test results\n+        console.log('Browser:', navigator.userAgent);\n+        console.log('Testing Carbon OrderedList Firefox issue...');\n+        \n+        // Check if we're in Firefox\n+        const isFirefox = navigator.userAgent.toLowerCase().indexOf('firefox') > -1;\n+        if (isFirefox) {\n+            console.log('Firefox detected - this browser may show the issue');\n+        } else {\n+            console.log('Non-Firefox browser - issue may not be visible');\n+        }\n+        \n+        // Get all Carbon ordered lists and log their computed styles\n+        const carbonLists = document.querySelectorAll('.bx--list--ordered');\n+        carbonLists.forEach((list, index) => {\n+            const computedStyle = window.getComputedStyle(list);\n+            console.log(`Carbon List ${index + 1}:`, {\n+                counterReset: computedStyle.counterReset,\n+                listStyleType: computedStyle.listStyleType\n+            });\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test-ordered-list-react.js b/test-ordered-list-react.js\nnew file mode 100644\nindex 000000000..655991f10\n--- /dev/null\n+++ b/test-ordered-list-react.js\n@@ -0,0 +1,211 @@\n+/**\n+ * Test file for OrderedList Firefox issue reproduction and solution testing\n+ */\n+\n+import React from 'react';\n+import { render } from '@testing-library/react';\n+import OrderedList from './packages/react/src/components/OrderedList/OrderedList';\n+import ListItem from './packages/react/src/components/ListItem/ListItem';\n+\n+describe('OrderedList Firefox Issue Tests', () => {\n+  describe('Current behavior', () => {\n+    it('should render with Carbon custom counter styles by default', () => {\n+      const { container } = render(\n+        <OrderedList>\n+          <ListItem>Item 1</ListItem>\n+          <ListItem>Item 2</ListItem>\n+          <ListItem>Item 3</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveClass('bx--list--ordered');\n+      expect(list).not.toHaveClass('bx--list--native');\n+    });\n+\n+    it('should render nested lists correctly', () => {\n+      const { container } = render(\n+        <OrderedList>\n+          <ListItem>\n+            Item 1\n+            <OrderedList nested>\n+              <ListItem>Nested Item 1</ListItem>\n+              <ListItem>Nested Item 2</ListItem>\n+            </OrderedList>\n+          </ListItem>\n+          <ListItem>Item 2</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const lists = container.querySelectorAll('ol');\n+      expect(lists[0]).toHaveClass('bx--list--ordered');\n+      expect(lists[1]).toHaveClass('bx--list--ordered');\n+      expect(lists[1]).toHaveClass('bx--list--nested');\n+    });\n+  });\n+\n+  describe('Proposed native styling solution', () => {\n+    it('should render with native styles when native prop is true', () => {\n+      // This test will pass after we implement the native prop\n+      const { container } = render(\n+        <OrderedList native>\n+          <ListItem>Item 1</ListItem>\n+          <ListItem>Item 2</ListItem>\n+          <ListItem>Item 3</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveClass('bx--list--ordered');\n+      expect(list).toHaveClass('bx--list--native');\n+    });\n+\n+    it('should support start attribute with native styling', () => {\n+      const { container } = render(\n+        <OrderedList native start={5}>\n+          <ListItem>Item 5</ListItem>\n+          <ListItem>Item 6</ListItem>\n+          <ListItem>Item 7</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveAttribute('start', '5');\n+      expect(list).toHaveClass('bx--list--native');\n+    });\n+\n+    it('should maintain backward compatibility when native prop is not provided', () => {\n+      const { container } = render(\n+        <OrderedList>\n+          <ListItem>Item 1</ListItem>\n+          <ListItem>Item 2</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveClass('bx--list--ordered');\n+      expect(list).not.toHaveClass('bx--list--native');\n+    });\n+\n+    it('should work with nested lists and native styling', () => {\n+      const { container } = render(\n+        <OrderedList native>\n+          <ListItem>\n+            Item 1\n+            <OrderedList nested native>\n+              <ListItem>Nested Item 1</ListItem>\n+              <ListItem>Nested Item 2</ListItem>\n+            </OrderedList>\n+          </ListItem>\n+          <ListItem>Item 2</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const lists = container.querySelectorAll('ol');\n+      expect(lists[0]).toHaveClass('bx--list--native');\n+      expect(lists[1]).toHaveClass('bx--list--native');\n+      expect(lists[1]).toHaveClass('bx--list--nested');\n+    });\n+  });\n+\n+  describe('Edge cases', () => {\n+    it('should handle custom className with native prop', () => {\n+      const { container } = render(\n+        <OrderedList native className=\"custom-class\">\n+          <ListItem>Item 1</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveClass('bx--list--ordered');\n+      expect(list).toHaveClass('bx--list--native');\n+      expect(list).toHaveClass('custom-class');\n+    });\n+\n+    it('should pass through other props when using native styling', () => {\n+      const { container } = render(\n+        <OrderedList native data-testid=\"test-list\" id=\"my-list\">\n+          <ListItem>Item 1</ListItem>\n+        </OrderedList>\n+      );\n+      \n+      const list = container.querySelector('ol');\n+      expect(list).toHaveAttribute('data-testid', 'test-list');\n+      expect(list).toHaveAttribute('id', 'my-list');\n+    });\n+  });\n+});\n+\n+// Visual test component for manual testing\n+export const OrderedListTestComponent = () => {\n+  return (\n+    <div style={{ padding: '2rem', fontFamily: 'IBM Plex Sans, Arial, sans-serif' }}>\n+      <h1>OrderedList Firefox Issue Test</h1>\n+      \n+      <div style={{ marginBottom: '2rem' }}>\n+        <h2>1. Current Carbon OrderedList (may have Firefox issue)</h2>\n+        <OrderedList>\n+          <ListItem>First item</ListItem>\n+          <ListItem>Second item</ListItem>\n+          <ListItem>Third item</ListItem>\n+          <ListItem>Fourth item</ListItem>\n+          <ListItem>Fifth item</ListItem>\n+        </OrderedList>\n+      </div>\n+\n+      <div style={{ marginBottom: '2rem' }}>\n+        <h2>2. Proposed Native OrderedList (should fix Firefox issue)</h2>\n+        <OrderedList native>\n+          <ListItem>First item</ListItem>\n+          <ListItem>Second item</ListItem>\n+          <ListItem>Third item</ListItem>\n+          <ListItem>Fourth item</ListItem>\n+          <ListItem>Fifth item</ListItem>\n+        </OrderedList>\n+      </div>\n+\n+      <div style={{ marginBottom: '2rem' }}>\n+        <h2>3. Native OrderedList with start attribute</h2>\n+        <OrderedList native start={10}>\n+          <ListItem>Tenth item</ListItem>\n+          <ListItem>Eleventh item</ListItem>\n+          <ListItem>Twelfth item</ListItem>\n+        </OrderedList>\n+      </div>\n+\n+      <div style={{ marginBottom: '2rem' }}>\n+        <h2>4. Nested Lists Comparison</h2>\n+        <div style={{ display: 'flex', gap: '2rem' }}>\n+          <div>\n+            <h3>Current (Custom Counters)</h3>\n+            <OrderedList>\n+              <ListItem>\n+                Item 1\n+                <OrderedList nested>\n+                  <ListItem>Nested Item 1</ListItem>\n+                  <ListItem>Nested Item 2</ListItem>\n+                </OrderedList>\n+              </ListItem>\n+              <ListItem>Item 2</ListItem>\n+            </OrderedList>\n+          </div>\n+          <div>\n+            <h3>Native Styling</h3>\n+            <OrderedList native>\n+              <ListItem>\n+                Item 1\n+                <OrderedList nested native>\n+                  <ListItem>Nested Item 1</ListItem>\n+                  <ListItem>Nested Item 2</ListItem>\n+                </OrderedList>\n+              </ListItem>\n+              <ListItem>Item 2</ListItem>\n+            </OrderedList>\n+          </div>\n+        </div>\n+      </div>\n+    </div>\n+  );\n+};\n+\n+export default OrderedListTestComponent;\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

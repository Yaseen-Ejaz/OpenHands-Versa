ete this.indices_;\n   }\ndiff --git a/src/ol/webgl/PaletteTexture.js b/src/ol/webgl/PaletteTexture.js\nindex d38c86f66..5a5d020c5 100644\n--- a/src/ol/webgl/PaletteTexture.js\n+++ b/src/ol/webgl/PaletteTexture.js\n@@ -16,6 +16,12 @@ class PaletteTexture {\n      * @private\n      */\n     this.texture_ = null;\n+\n+    /**\n+     * @type {WebGLRenderingContext|null}\n+     * @private\n+     */\n+    this.gl_ = null;\n   }\n \n   /**\n@@ -23,7 +29,18 @@ class PaletteTexture {\n    * @return {WebGLTexture} The texture.\n    */\n   getTexture(gl) {\n-    if (!this.texture_) {\n+    // Check if we need to create or recreate the texture\n+    if (\n+      !this.texture_ ||\n+      this.gl_ !== gl ||\n+      (this.gl_ && this.gl_.isContextLost())\n+    ) {\n+      // Clean up old texture if it exists and context is still valid\n+      if (this.texture_ && this.gl_ && !this.gl_.isContextLost()) {\n+        this.gl_.deleteTexture(this.texture_);\n+      }\n+\n+      // Create new texture\n       const texture = gl.createTexture();\n       gl.bindTexture(gl.TEXTURE_2D, texture);\n       gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n@@ -41,10 +58,23 @@ class PaletteTexture {\n         gl.UNSIGNED_BYTE,\n         this.data,\n       );\n+\n       this.texture_ = texture;\n+      this.gl_ = gl;\n     }\n     return this.texture_;\n   }\n+\n+  /**\n+   * Clean up the texture.\n+   */\n+  dispose() {\n+    if (this.texture_ && this.gl_ && !this.gl_.isContextLost()) {\n+      this.gl_.deleteTexture(this.texture_);\n+    }\n+    this.texture_ = null;\n+    this.gl_ = null;\n+  }\n }\n \n export default PaletteTexture;\ndiff --git a/test/browser/spec/ol/webgl/PaletteTexture.test.js b/test/browser/spec/ol/webgl/PaletteTexture.test.js\nnew file mode 100644\nindex 000000000..4140854e2\n--- /dev/null\n+++ b/test/browser/spec/ol/webgl/PaletteTexture.test.js\n@@ -0,0 +1,122 @@\n+import PaletteTexture from '../../../../../src/ol/webgl/PaletteTexture.js';\n+\n+describe('ol/webgl/PaletteTexture', function () {\n+  let canvas, gl, gl2;\n+\n+  beforeEach(function () {\n+    // Create first WebGL context\n+    canvas = document.createElement('canvas');\n+    canvas.width = 256;\n+    canvas.height = 256;\n+    gl = canvas.getContext('webgl');\n+\n+    // Create second WebGL context for testing context changes\n+    const canvas2 = document.createElement('canvas');\n+    canvas2.width = 256;\n+    canvas2.height = 256;\n+    gl2 = canvas2.getContext('webgl');\n+\n+    if (!gl || !gl2) {\n+      this.skip(); // Skip tests if WebGL is not available\n+    }\n+  });\n+\n+  describe('constructor', function () {\n+    it('should create a PaletteTexture with name and data', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      expect(palette.name).to.be('test');\n+      expect(palette.data).to.be(data);\n+    });\n+  });\n+\n+  describe('getTexture', function () {\n+    it('should create a texture on first call', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      const texture = palette.getTexture(gl);\n+      expect(texture).to.be.a(WebGLTexture);\n+    });\n+\n+    it('should reuse texture for same context', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      const texture1 = palette.getTexture(gl);\n+      const texture2 = palette.getTexture(gl);\n+      expect(texture1).to.be(texture2);\n+    });\n+\n+    it('should create new texture for different context', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      const texture1 = palette.getTexture(gl);\n+      const texture2 = palette.getTexture(gl2);\n+      expect(texture1).not.to.be(texture2);\n+    });\n+\n+    it('should recreate texture when context changes', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      // Get texture from first context\n+      const texture1 = palette.getTexture(gl);\n+      expect(texture1).to.be.a(WebGLTexture);\n+\n+      // Get texture from second context - should create new texture\n+      const texture2 = palette.getTexture(gl2);\n+      expect(texture2).to.be.a(WebGLTexture);\n+      expect(texture1).not.to.be(texture2);\n+\n+      // Get texture from first context again - should create new texture\n+      const texture3 = palette.getTexture(gl);\n+      expect(texture3).to.be.a(WebGLTexture);\n+      expect(texture3).not.to.be(texture1);\n+      expect(texture3).not.to.be(texture2);\n+    });\n+  });\n+\n+  describe('dispose', function () {\n+    it('should clean up texture and context references', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      // Create texture\n+      const texture = palette.getTexture(gl);\n+      expect(texture).to.be.a(WebGLTexture);\n+\n+      // Dispose\n+      palette.dispose();\n+\n+      // Should create new texture after dispose\n+      const newTexture = palette.getTexture(gl);\n+      expect(newTexture).to.be.a(WebGLTexture);\n+      expect(newTexture).not.to.be(texture);\n+    });\n+  });\n+\n+  describe('context loss handling', function () {\n+    it('should handle context loss gracefully', function () {\n+      const data = new Uint8Array([255, 0, 0, 255, 0, 255, 0, 255]);\n+      const palette = new PaletteTexture('test', data);\n+\n+      // Create texture\n+      const texture1 = palette.getTexture(gl);\n+      expect(texture1).to.be.a(WebGLTexture);\n+\n+      // Simulate context loss\n+      const extension = gl.getExtension('WEBGL_lose_context');\n+      if (extension) {\n+        extension.loseContext();\n+\n+        // Should create new texture after context loss\n+        const texture2 = palette.getTexture(gl2);\n+        expect(texture2).to.be.a(WebGLTexture);\n+        expect(texture2).not.to.be(texture1);\n+      }\n+    });\n+  });\n+});\ndiff --git a/test_palette_issue.html b/test_palette_issue.html\nnew file mode 100644\nindex 000000000..ca074c5df\n--- /dev/null\n+++ b/test_palette_issue.html\n@@ -0,0 +1,155 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Palette Texture Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .status { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        .error { background: #ffeeee; color: red; }\n+        .success { background: #eeffee; color: green; }\n+    </style>\n+</head>\n+<body>\n+    <h1>WebGL Palette Texture Issue Test</h1>\n+    <div class=\"controls\">\n+        <button id=\"addRemoveBtn\">Add/Remove Layer</button>\n+        <button id=\"switchStyleBtn\">Switch to Palette Style</button>\n+        <button id=\"switchBackBtn\">Switch to Regular Style</button>\n+    </div>\n+    <div id=\"status\" class=\"status\">Ready</div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+        import Map from './src/ol/Map.js';\n+        import TileLayer from './src/ol/layer/WebGLTile.js';\n+        import View from './src/ol/View.js';\n+\n+        const max = 3000;\n+        function normalize(value) {\n+            return ['/', value, max];\n+        }\n+\n+        const red = normalize(['band', 1]);\n+        const green = normalize(['band', 2]);\n+        const blue = normalize(['band', 3]);\n+        const nir = normalize(['band', 4]);\n+\n+        // Regular style (should work fine)\n+        const trueColor = {\n+            color: ['array', red, green, blue, 1],\n+            gamma: 1.1,\n+        };\n+\n+        // Palette style (should break after remove/add)\n+        const ndviPalette = {\n+            color: [\n+                'palette',\n+                [\n+                    'interpolate',\n+                    ['linear'],\n+                    ['/', ['-', nir, red], ['+', nir, red]],\n+                    -0.2,\n+                    0,\n+                    0.65,\n+                    4,\n+                ],\n+                ['#0d0887', '#7e03a8', '#cb4778', '#f89540', '#f0f921'],\n+            ],\n+        };\n+\n+        let currentStyle = trueColor;\n+        let layer = null;\n+        let map = null;\n+\n+        function createLayer() {\n+            return new TileLayer({\n+                style: currentStyle,\n+                source: new GeoTIFF({\n+                    normalize: false,\n+                    sources: [\n+                        {\n+                            url: 'https://s2downloads.eox.at/demo/EOxCloudless/2020/rgbnir/s2cloudless2020-16bits_sinlge-file_z0-4.tif',\n+                        },\n+                    ],\n+                }),\n+            });\n+        }\n+\n+        function updateStatus(message, isError = false) {\n+            const statusEl = document.getElementById('status');\n+            statusEl.textContent = message;\n+            statusEl.className = isError ? 'status error' : 'status success';\n+            console.log(message);\n+        }\n+\n+        function initMap() {\n+            layer = createLayer();\n+            map = new Map({\n+                target: 'map',\n+                layers: [layer],\n+                view: new View({\n+                    projection: 'EPSG:4326',\n+                    center: [0, 0],\n+                    zoom: 2,\n+                    maxZoom: 6,\n+                }),\n+            });\n+            updateStatus('Map initialized with regular style');\n+        }\n+\n+        // Monitor WebGL errors\n+        const originalConsoleError = console.error;\n+        const originalConsoleWarn = console.warn;\n+        \n+        console.error = function(...args) {\n+            const message = args.join(' ');\n+            if (message.includes('WebGL') || message.includes('bindTexture')) {\n+                updateStatus(`WebGL Error: ${message}`, true);\n+            }\n+            originalConsoleError.apply(console, args);\n+        };\n+\n+        console.warn = function(...args) {\n+            const message = args.join(' ');\n+            if (message.includes('WebGL') || message.includes('bindTexture')) {\n+                updateStatus(`WebGL Warning: ${message}`, true);\n+            }\n+            originalConsoleWarn.apply(console, args);\n+        };\n+\n+        document.getElementById('addRemoveBtn').addEventListener('click', () => {\n+            if (layer && map.getLayers().getArray().includes(layer)) {\n+                map.removeLayer(layer);\n+                updateStatus('Layer removed');\n+                setTimeout(() => {\n+                    map.addLayer(layer);\n+                    updateStatus('Layer re-added');\n+                }, 100);\n+            }\n+        });\n+\n+        document.getElementById('switchStyleBtn').addEventListener('click', () => {\n+            currentStyle = ndviPalette;\n+            if (layer) {\n+                layer.setStyle(currentStyle);\n+                updateStatus('Switched to palette style');\n+            }\n+        });\n+\n+        document.getElementById('switchBackBtn').addEventListener('click', () => {\n+            currentStyle = trueColor;\n+            if (layer) {\n+                layer.setStyle(currentStyle);\n+                updateStatus('Switched to regular style');\n+            }\n+        });\n+\n+        // Initialize the map\n+        initMap();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_palette_simple.html b/test_palette_simple.html\nnew file mode 100644\nindex 000000000..c2d392d35\n--- /dev/null\n+++ b/test_palette_simple.html\n@@ -0,0 +1,150 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple WebGL Palette Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .status { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        .error { background: #ffeeee; color: red; }\n+        .success { background: #eeffee; color: green; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Simple WebGL Palette Test</h1>\n+    <div class=\"controls\">\n+        <button id=\"addRemoveBtn\">Add/Remove Layer</button>\n+        <button id=\"switchStyleBtn\">Switch to Palette Style</button>\n+        <button id=\"switchBackBtn\">Switch to Regular Style</button>\n+    </div>\n+    <div id=\"status\" class=\"status\">Ready</div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import DataTile from './src/ol/source/DataTile.js';\n+        import Map from './src/ol/Map.js';\n+        import TileLayer from './src/ol/layer/WebGLTile.js';\n+        import View from './src/ol/View.js';\n+\n+        // Create a simple data source with synthetic data\n+        function createDataSource() {\n+            return new DataTile({\n+                loader: function (z, x, y) {\n+                    const size = 256;\n+                    const data = new Uint8Array(size * size * 4);\n+                    \n+                    // Create a simple gradient pattern\n+                    for (let i = 0; i < size; i++) {\n+                        for (let j = 0; j < size; j++) {\n+                            const index = (i * size + j) * 4;\n+                            data[index] = (i / size) * 255;     // R\n+                            data[index + 1] = (j / size) * 255; // G  \n+                            data[index + 2] = 128;              // B\n+                            data[index + 3] = 255;              // A\n+                        }\n+                    }\n+                    return data;\n+                },\n+                bandCount: 4,\n+            });\n+        }\n+\n+        // Regular style (should work fine)\n+        const regularStyle = {\n+            color: ['array', ['band', 1], ['band', 2], ['band', 3], ['band', 4]],\n+        };\n+\n+        // Palette style (should break after remove/add)\n+        const paletteStyle = {\n+            color: [\n+                'palette',\n+                ['band', 1], // Use red band as index\n+                ['#000000', '#ff0000', '#ffff00', '#ffffff'], // Simple palette\n+            ],\n+        };\n+\n+        let currentStyle = regularStyle;\n+        let layer = null;\n+        let map = null;\n+\n+        function createLayer() {\n+            return new TileLayer({\n+                style: currentStyle,\n+                source: createDataSource(),\n+            });\n+        }\n+\n+        function updateStatus(message, isError = false) {\n+            const statusEl = document.getElementById('status');\n+            statusEl.textContent = message;\n+            statusEl.className = isError ? 'status error' : 'status success';\n+            console.log(message);\n+        }\n+\n+        function initMap() {\n+            layer = createLayer();\n+            map = new Map({\n+                target: 'map',\n+                layers: [layer],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 2,\n+                }),\n+            });\n+            updateStatus('Map initialized with regular style');\n+        }\n+\n+        // Monitor WebGL errors\n+        const originalConsoleError = console.error;\n+        const originalConsoleWarn = console.warn;\n+        \n+        console.error = function(...args) {\n+            const message = args.join(' ');\n+            if (message.includes('WebGL') || message.includes('bindTexture')) {\n+                updateStatus(`WebGL Error: ${message}`, true);\n+            }\n+            originalConsoleError.apply(console, args);\n+        };\n+\n+        console.warn = function(...args) {\n+            const message = args.join(' ');\n+            if (message.includes('WebGL') || message.includes('bindTexture')) {\n+                updateStatus(`WebGL Warning: ${message}`, true);\n+            }\n+            originalConsoleWarn.apply(console, args);\n+        };\n+\n+        document.getElementById('addRemoveBtn').addEventListener('click', () => {\n+            if (layer && map.getLayers().getArray().includes(layer)) {\n+                map.removeLayer(layer);\n+                updateStatus('Layer removed');\n+                setTimeout(() => {\n+                    map.addLayer(layer);\n+                    updateStatus('Layer re-added');\n+                }, 100);\n+            }\n+        });\n+\n+        document.getElementById('switchStyleBtn').addEventListener('click', () => {\n+            currentStyle = paletteStyle;\n+            if (layer) {\n+                layer.setStyle(currentStyle);\n+                updateStatus('Switched to palette style');\n+            }\n+        });\n+\n+        document.getElementById('switchBackBtn').addEventListener('click', () => {\n+            currentStyle = regularStyle;\n+            if (layer) {\n+                layer.setStyle(currentStyle);\n+                updateStatus('Switched to regular style');\n+            }\n+        });\n+\n+        // Initialize the map\n+        initMap();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

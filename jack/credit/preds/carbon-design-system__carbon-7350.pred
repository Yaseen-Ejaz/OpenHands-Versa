{"instance_id": "carbon-design-system__carbon-7350", "model_patch": "diff --git a/context-menu-demo.html b/context-menu-demo.html\nnew file mode 100644\nindex 000000000..2aa91717c\n--- /dev/null\n+++ b/context-menu-demo.html\n@@ -0,0 +1,390 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Context Menu Demo - Requirements Verification</title>\n+    <style>\n+        body {\n+            font-family: 'IBM Plex Sans', Arial, sans-serif;\n+            margin: 0;\n+            padding: 20px;\n+            background-color: #f4f4f4;\n+        }\n+        \n+        .demo-container {\n+            max-width: 1200px;\n+            margin: 0 auto;\n+            background: white;\n+            padding: 20px;\n+            border-radius: 8px;\n+            box-shadow: 0 2px 6px rgba(0,0,0,0.1);\n+        }\n+        \n+        .demo-section {\n+            margin-bottom: 40px;\n+            padding: 20px;\n+            border: 1px solid #e0e0e0;\n+            border-radius: 4px;\n+        }\n+        \n+        .demo-section h2 {\n+            margin-top: 0;\n+            color: #161616;\n+            border-bottom: 2px solid #0f62fe;\n+            padding-bottom: 8px;\n+        }\n+        \n+        .demo-area {\n+            min-height: 200px;\n+            background: #f8f8f8;\n+            border: 2px dashed #c6c6c6;\n+            display: flex;\n+            align-items: center;\n+            justify-content: center;\n+            margin: 20px 0;\n+            position: relative;\n+        }\n+        \n+        .context-menu {\n+            position: absolute;\n+            background: white;\n+            border: 1px solid #e0e0e0;\n+            border-radius: 4px;\n+            box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n+            min-width: 200px;\n+            z-index: 1000;\n+            display: none;\n+        }\n+        \n+        .context-menu.open {\n+            display: block;\n+        }\n+        \n+        .context-menu-item {\n+            padding: 12px 16px;\n+            cursor: pointer;\n+            display: flex;\n+            justify-content: space-between;\n+            align-items: center;\n+            border-bottom: 1px solid #f0f0f0;\n+        }\n+        \n+        .context-menu-item:last-child {\n+            border-bottom: none;\n+        }\n+        \n+        .context-menu-item:hover {\n+            background-color: #e5f6ff;\n+        }\n+        \n+        .context-menu-item.disabled {\n+            color: #c6c6c6;\n+            cursor: not-allowed;\n+        }\n+        \n+        .context-menu-item.disabled:hover {\n+            background-color: transparent;\n+        }\n+        \n+        .context-menu-item.selected {\n+            background-color: #0f62fe;\n+            color: white;\n+        }\n+        \n+        .context-menu-item.danger {\n+            color: #da1e28;\n+            border-top: 1px solid #f0f0f0;\n+        }\n+        \n+        .context-menu-item.danger:hover {\n+            background-color: #fff1f1;\n+        }\n+        \n+        .shortcut {\n+            font-size: 12px;\n+            color: #6f6f6f;\n+            margin-left: 20px;\n+        }\n+        \n+        .context-menu-group {\n+            position: relative;\n+        }\n+        \n+        .context-menu-group > .context-menu-item::after {\n+            content: '\u25b6';\n+            margin-left: 10px;\n+        }\n+        \n+        .submenu {\n+            position: absolute;\n+            left: 100%;\n+            top: 0;\n+            background: white;\n+            border: 1px solid #e0e0e0;\n+            border-radius: 4px;\n+            box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n+            min-width: 180px;\n+            display: none;\n+        }\n+        \n+        .context-menu-group:hover .submenu {\n+            display: block;\n+        }\n+        \n+        .requirement {\n+            background: #e8f4fd;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-left: 4px solid #0f62fe;\n+        }\n+        \n+        .requirement-title {\n+            font-weight: bold;\n+            color: #0f62fe;\n+        }\n+        \n+        .status {\n+            display: inline-block;\n+            padding: 2px 8px;\n+            border-radius: 12px;\n+            font-size: 12px;\n+            font-weight: bold;\n+        }\n+        \n+        .status.pending {\n+            background: #fff2e8;\n+            color: #8a3800;\n+        }\n+        \n+        .status.implemented {\n+            background: #e8f5e8;\n+            color: #24a148;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"demo-container\">\n+        <h1>Context Menu Component - Requirements Verification</h1>\n+        <p>This page demonstrates the requirements for the Context Menu component before implementation.</p>\n+        \n+        <div class=\"demo-section\">\n+            <h2>Requirement 1: Right-click Context Menu <span class=\"status pending\">PENDING</span></h2>\n+            <div class=\"requirement\">\n+                <div class=\"requirement-title\">Must have:</div>\n+                Visibility/rendering of component can be controlled by code. Absolute position of the component on the screen can be controlled by code.\n+            </div>\n+            <div class=\"demo-area\" id=\"demo1\">\n+                <p>Right-click anywhere in this area to see context menu</p>\n+                <div class=\"context-menu\" id=\"contextMenu1\">\n+                    <div class=\"context-menu-item\">\n+                        <span>Copy</span>\n+                        <span class=\"shortcut\">Ctrl+C</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Paste</span>\n+                        <span class=\"shortcut\">Ctrl+V</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Cut</span>\n+                        <span class=\"shortcut\">Ctrl+X</span>\n+                    </div>\n+                    <div class=\"context-menu-item danger\">\n+                        <span>Delete</span>\n+                        <span class=\"shortcut\">Del</span>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+        \n+        <div class=\"demo-section\">\n+            <h2>Requirement 2: Keyboard Shortcuts Display <span class=\"status pending\">PENDING</span></h2>\n+            <div class=\"requirement\">\n+                <div class=\"requirement-title\">Desired UX:</div>\n+                If applicable, the shortcut / keyboard command to trigger an action is displayed next to the action to progressively educate the user on how to become more efficient with the web application.\n+            </div>\n+            <div class=\"demo-area\" id=\"demo2\">\n+                <p>Right-click to see menu items with keyboard shortcuts</p>\n+                <div class=\"context-menu\" id=\"contextMenu2\">\n+                    <div class=\"context-menu-item\">\n+                        <span>New File</span>\n+                        <span class=\"shortcut\">Ctrl+N</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Open File</span>\n+                        <span class=\"shortcut\">Ctrl+O</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Save</span>\n+                        <span class=\"shortcut\">Ctrl+S</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Save As</span>\n+                        <span class=\"shortcut\">Ctrl+Shift+S</span>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+        \n+        <div class=\"demo-section\">\n+            <h2>Requirement 3: Nested Menu Support <span class=\"status pending\">PENDING</span></h2>\n+            <div class=\"requirement\">\n+                <div class=\"requirement-title\">Desired UX:</div>\n+                The user has a nested list of options related to their current context. Options that have children cannot be disabled themselves so that the user can always explore the options.\n+            </div>\n+            <div class=\"demo-area\" id=\"demo3\">\n+                <p>Right-click to see nested menu options</p>\n+                <div class=\"context-menu\" id=\"contextMenu3\">\n+                    <div class=\"context-menu-item\">\n+                        <span>Copy</span>\n+                        <span class=\"shortcut\">Ctrl+C</span>\n+                    </div>\n+                    <div class=\"context-menu-group\">\n+                        <div class=\"context-menu-item\">\n+                            <span>Export</span>\n+                        </div>\n+                        <div class=\"submenu\">\n+                            <div class=\"context-menu-item\">\n+                                <span>Export as PDF</span>\n+                            </div>\n+                            <div class=\"context-menu-item\">\n+                                <span>Export as PNG</span>\n+                            </div>\n+                            <div class=\"context-menu-item\">\n+                                <span>Export as SVG</span>\n+                            </div>\n+                        </div>\n+                    </div>\n+                    <div class=\"context-menu-group\">\n+                        <div class=\"context-menu-item\">\n+                            <span>Share</span>\n+                        </div>\n+                        <div class=\"submenu\">\n+                            <div class=\"context-menu-item\">\n+                                <span>Share via Email</span>\n+                            </div>\n+                            <div class=\"context-menu-item\">\n+                                <span>Share via Link</span>\n+                            </div>\n+                            <div class=\"context-menu-item disabled\">\n+                                <span>Share via Slack</span>\n+                            </div>\n+                        </div>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+        \n+        <div class=\"demo-section\">\n+            <h2>Requirement 4: Selection (Radio) Behavior <span class=\"status pending\">PENDING</span></h2>\n+            <div class=\"requirement\">\n+                <div class=\"requirement-title\">Desired UX:</div>\n+                Options can be a selection (radio behaviour).\n+            </div>\n+            <div class=\"demo-area\" id=\"demo4\">\n+                <p>Right-click to see selectable options</p>\n+                <div class=\"context-menu\" id=\"contextMenu4\">\n+                    <div class=\"context-menu-item\">\n+                        <span>View Options</span>\n+                    </div>\n+                    <div class=\"context-menu-item selected\">\n+                        <span>List View</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Grid View</span>\n+                    </div>\n+                    <div class=\"context-menu-item\">\n+                        <span>Card View</span>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+        \n+        <div class=\"demo-section\">\n+            <h2>Requirement 5: Disabled State Handling <span class=\"status pending\">PENDING</span></h2>\n+            <div class=\"requirement\">\n+                <div class=\"requirement-title\">Desired UX:</div>\n+                Options that have children cannot be disabled themselves so that the user can always explore the options (in other words: if all child options are disabled, the parent option is still available to expand).\n+            </div>\n+            <div class=\"demo-area\" id=\"demo5\">\n+                <p>Right-click to see disabled state handling</p>\n+                <div class=\"context-menu\" id=\"contextMenu5\">\n+                    <div class=\"context-menu-item\">\n+                        <span>Available Action</span>\n+                    </div>\n+                    <div class=\"context-menu-item disabled\">\n+                        <span>Disabled Action</span>\n+                    </div>\n+                    <div class=\"context-menu-group\">\n+                        <div class=\"context-menu-item\">\n+                            <span>Parent Always Enabled</span>\n+                        </div>\n+                        <div class=\"submenu\">\n+                            <div class=\"context-menu-item disabled\">\n+                                <span>Disabled Child 1</span>\n+                            </div>\n+                            <div class=\"context-menu-item disabled\">\n+                                <span>Disabled Child 2</span>\n+                            </div>\n+                        </div>\n+                    </div>\n+                </div>\n+            </div>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Simple demo functionality to show context menus\n+        document.addEventListener('DOMContentLoaded', function() {\n+            const demoAreas = document.querySelectorAll('.demo-area');\n+            \n+            demoAreas.forEach((area, index) => {\n+                const contextMenu = area.querySelector('.context-menu');\n+                \n+                area.addEventListener('contextmenu', function(e) {\n+                    e.preventDefault();\n+                    \n+                    // Hide all other context menus\n+                    document.querySelectorAll('.context-menu').forEach(menu => {\n+                        menu.classList.remove('open');\n+                    });\n+                    \n+                    // Position and show this context menu\n+                    const rect = area.getBoundingClientRect();\n+                    const x = e.clientX - rect.left;\n+                    const y = e.clientY - rect.top;\n+                    \n+                    contextMenu.style.left = x + 'px';\n+                    contextMenu.style.top = y + 'px';\n+                    contextMenu.classList.add('open');\n+                });\n+            });\n+            \n+            // Hide context menus on click outside\n+            document.addEventListener('click', function() {\n+                document.querySelectorAll('.context-menu').forEach(menu => {\n+                    menu.classList.remove('open');\n+                });\n+            });\n+            \n+            // Handle menu item clicks\n+            document.querySelectorAll('.context-menu-item').forEach(item => {\n+                item.addEventListener('click', function(e) {\n+                    if (!this.classList.contains('disabled')) {\n+                        console.log('Menu item clicked:', this.textContent.trim());\n+                        \n+                        // Handle selection behavior for demo 4\n+                        if (this.closest('#contextMenu4')) {\n+                            this.closest('.context-menu').querySelectorAll('.context-menu-item').forEach(i => {\n+                                i.classList.remove('selected');\n+                            });\n+                            this.classList.add('selected');\n+                        }\n+                    }\n+                    e.stopPropagation();\n+                });\n+            });\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/packages/components/src/components/context-menu/_context-menu.scss b/packages/components/src/components/context-menu/_context-menu.scss\nnew file mode 100644\nindex 000000000..6bacefb03\n--- /dev/null\n+++ b/packages/components/src/components/context-menu/_context-menu.scss\n@@ -0,0 +1,321 @@\n+//\n+// Copyright IBM Corp. 2020\n+//\n+// This source code is licensed under the Apache-2.0 license found in the\n+// LICENSE file in the root directory of this source tree.\n+//\n+\n+//-----------------------------\n+// Context Menu\n+//-----------------------------\n+\n+@import '../../globals/scss/vars';\n+@import '../../globals/scss/helper-mixins';\n+@import '../../globals/scss/css--helpers';\n+@import '../../globals/scss/css--reset';\n+@import '../../globals/scss/layout';\n+@import '../../globals/scss/typography';\n+@import '../../globals/scss/vendor/@carbon/elements/scss/import-once/import-once';\n+\n+/// Context menu styles\n+/// @access private\n+/// @group context-menu\n+@mixin context-menu {\n+  .#{$prefix}--context-menu {\n+    @include reset;\n+    @include box-shadow;\n+\n+    position: fixed;\n+    z-index: z('floating');\n+    display: flex;\n+    flex-direction: column;\n+    min-width: rem(160px);\n+    max-width: rem(288px);\n+    background-color: $field-01;\n+    border-radius: rem(2px);\n+    outline: none;\n+\n+    // Windows, Firefox HCM Fix\n+    @media screen and (-ms-high-contrast: active),\n+      screen and (prefers-contrast) {\n+      border: 1px solid ButtonText;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu__list {\n+    @include reset;\n+\n+    list-style: none;\n+    margin: 0;\n+    padding: 0;\n+  }\n+\n+  .#{$prefix}--context-menu-item {\n+    @include reset;\n+\n+    position: relative;\n+    display: flex;\n+    align-items: center;\n+    width: 100%;\n+    min-height: rem(32px);\n+    padding: 0;\n+    background-color: transparent;\n+    transition: background-color $duration--fast-02 motion(entrance, productive);\n+\n+    &:first-child .#{$prefix}--context-menu-item__button {\n+      border-top-left-radius: rem(2px);\n+      border-top-right-radius: rem(2px);\n+    }\n+\n+    &:last-child .#{$prefix}--context-menu-item__button {\n+      border-bottom-left-radius: rem(2px);\n+      border-bottom-right-radius: rem(2px);\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-item--divider {\n+    border-top: 1px solid $ui-03;\n+  }\n+\n+  .#{$prefix}--context-menu-item--danger .#{$prefix}--context-menu-item__button {\n+    color: $text-error;\n+\n+    &:hover,\n+    &:focus {\n+      background-color: $danger-01;\n+      color: $text-04;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-item--disabled {\n+    .#{$prefix}--context-menu-item__button {\n+      color: $disabled-02;\n+      cursor: not-allowed;\n+      pointer-events: none;\n+\n+      &:hover,\n+      &:focus {\n+        background-color: transparent;\n+      }\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-item--selected {\n+    .#{$prefix}--context-menu-item__button {\n+      background-color: $selected-ui;\n+      color: $text-01;\n+\n+      &::before {\n+        position: absolute;\n+        left: rem(8px);\n+        width: rem(16px);\n+        height: rem(16px);\n+        background-color: $icon-01;\n+        content: '';\n+        mask: url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath d='M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z'/%3e%3c/svg%3e\");\n+        mask-size: contain;\n+        mask-repeat: no-repeat;\n+        mask-position: center;\n+      }\n+    }\n+\n+    .#{$prefix}--context-menu-item__text {\n+      margin-left: rem(24px);\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-item__button {\n+    @include type-style('body-short-01');\n+    @include focus-outline('reset');\n+\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    width: 100%;\n+    min-height: rem(32px);\n+    padding: rem(6px) $carbon--spacing-05;\n+    color: $text-02;\n+    background-color: transparent;\n+    border: none;\n+    cursor: pointer;\n+    text-align: left;\n+    transition: background-color $duration--fast-02 motion(entrance, productive),\n+      color $duration--fast-02 motion(entrance, productive);\n+\n+    &:hover {\n+      background-color: $hover-ui;\n+      color: $text-01;\n+    }\n+\n+    &:focus {\n+      @include focus-outline('outline');\n+\n+      background-color: $hover-ui;\n+      color: $text-01;\n+    }\n+\n+    &::-moz-focus-inner {\n+      border: none;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-item__content {\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    width: 100%;\n+  }\n+\n+  .#{$prefix}--context-menu-item__text {\n+    @include type-style('body-short-01');\n+\n+    overflow: hidden;\n+    white-space: nowrap;\n+    text-overflow: ellipsis;\n+  }\n+\n+  .#{$prefix}--context-menu-item__shortcut {\n+    @include type-style('helper-text-01');\n+\n+    margin-left: $carbon--spacing-05;\n+    color: $text-03;\n+    white-space: nowrap;\n+  }\n+\n+  // Context Menu Group (for nested menus)\n+  .#{$prefix}--context-menu-group {\n+    @include reset;\n+\n+    position: relative;\n+    display: flex;\n+    align-items: center;\n+    width: 100%;\n+    min-height: rem(32px);\n+    padding: 0;\n+    background-color: transparent;\n+    transition: background-color $duration--fast-02 motion(entrance, productive);\n+\n+    &:first-child .#{$prefix}--context-menu-group__button {\n+      border-top-left-radius: rem(2px);\n+      border-top-right-radius: rem(2px);\n+    }\n+\n+    &:last-child .#{$prefix}--context-menu-group__button {\n+      border-bottom-left-radius: rem(2px);\n+      border-bottom-right-radius: rem(2px);\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-group__button {\n+    @include type-style('body-short-01');\n+    @include focus-outline('reset');\n+\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    width: 100%;\n+    min-height: rem(32px);\n+    padding: rem(6px) $carbon--spacing-05;\n+    color: $text-02;\n+    background-color: transparent;\n+    border: none;\n+    cursor: pointer;\n+    text-align: left;\n+    transition: background-color $duration--fast-02 motion(entrance, productive),\n+      color $duration--fast-02 motion(entrance, productive);\n+\n+    &:hover {\n+      background-color: $hover-ui;\n+      color: $text-01;\n+    }\n+\n+    &:focus {\n+      @include focus-outline('outline');\n+\n+      background-color: $hover-ui;\n+      color: $text-01;\n+    }\n+\n+    &::-moz-focus-inner {\n+      border: none;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-group__content {\n+    display: flex;\n+    align-items: center;\n+    justify-content: space-between;\n+    width: 100%;\n+  }\n+\n+  .#{$prefix}--context-menu-group__text {\n+    @include type-style('body-short-01');\n+\n+    overflow: hidden;\n+    white-space: nowrap;\n+    text-overflow: ellipsis;\n+  }\n+\n+  .#{$prefix}--context-menu-group__icon {\n+    margin-left: $carbon--spacing-03;\n+    fill: $icon-02;\n+    transition: fill $duration--fast-02 motion(entrance, productive);\n+  }\n+\n+  .#{$prefix}--context-menu-group:hover .#{$prefix}--context-menu-group__icon,\n+  .#{$prefix}--context-menu-group:focus .#{$prefix}--context-menu-group__icon {\n+    fill: $icon-01;\n+  }\n+\n+  .#{$prefix}--context-menu-group__submenu {\n+    @include reset;\n+    @include box-shadow;\n+\n+    position: absolute;\n+    top: 0;\n+    left: 100%;\n+    z-index: z('floating');\n+    display: flex;\n+    flex-direction: column;\n+    min-width: rem(160px);\n+    max-width: rem(288px);\n+    margin-left: rem(-2px);\n+    background-color: $field-01;\n+    border-radius: rem(2px);\n+\n+    // Windows, Firefox HCM Fix\n+    @media screen and (-ms-high-contrast: active),\n+      screen and (prefers-contrast) {\n+      border: 1px solid ButtonText;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu-group--expanded .#{$prefix}--context-menu-group__submenu {\n+    display: flex;\n+  }\n+\n+  // Adjust submenu position when near viewport edge\n+  .#{$prefix}--context-menu-group__submenu--left {\n+    right: 100%;\n+    left: auto;\n+    margin-right: rem(-2px);\n+    margin-left: 0;\n+  }\n+\n+  // Light theme variations\n+  .#{$prefix}--context-menu--light {\n+    background-color: $field-02;\n+\n+    .#{$prefix}--context-menu-group__submenu {\n+      background-color: $field-02;\n+    }\n+  }\n+\n+  .#{$prefix}--context-menu--light .#{$prefix}--context-menu-item--divider {\n+    border-top-color: $decorative-01;\n+  }\n+}\n+\n+@include exports('context-menu') {\n+  @include context-menu;\n+}\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenu/ContextMenu-story.js b/packages/react/src/components/ContextMenu/ContextMenu-story.js\nnew file mode 100644\nindex 000000000..9aa79d3aa\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenu/ContextMenu-story.js\n@@ -0,0 +1,334 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import React, { useState } from 'react';\n+import { action } from '@storybook/addon-actions';\n+import { withKnobs, boolean, text, number } from '@storybook/addon-knobs';\n+import ContextMenu from '../ContextMenu';\n+import ContextMenuItem from '../ContextMenuItem';\n+import ContextMenuGroup from '../ContextMenuGroup';\n+import mdx from './ContextMenu.mdx';\n+\n+const props = {\n+  contextMenu: () => ({\n+    onOpen: action('onOpen'),\n+    onClose: action('onClose'),\n+  }),\n+  contextMenuItem: () => ({\n+    onClick: action('onClick'),\n+    onSelect: action('onSelect'),\n+    disabled: boolean('Disabled (disabled)', false),\n+    isDanger: boolean('Danger (isDanger)', false),\n+    hasDivider: boolean('Has divider (hasDivider)', false),\n+    selectable: boolean('Selectable (selectable)', false),\n+    selected: boolean('Selected (selected)', false),\n+    shortcut: text('Keyboard shortcut (shortcut)', ''),\n+  }),\n+};\n+\n+export default {\n+  title: 'Components/ContextMenu',\n+  decorators: [withKnobs],\n+  component: ContextMenu,\n+  subcomponents: {\n+    ContextMenuItem,\n+    ContextMenuGroup,\n+  },\n+  parameters: {\n+    docs: {\n+      page: mdx,\n+    },\n+  },\n+};\n+\n+export const Default = () => {\n+  const [contextMenuState, setContextMenuState] = useState({\n+    open: false,\n+    x: 0,\n+    y: 0,\n+  });\n+\n+  const handleContextMenu = (event) => {\n+    event.preventDefault();\n+    setContextMenuState({\n+      open: true,\n+      x: event.clientX,\n+      y: event.clientY,\n+    });\n+  };\n+\n+  const handleClose = () => {\n+    setContextMenuState({ ...contextMenuState, open: false });\n+  };\n+\n+  return (\n+    <div style={{ padding: '2rem', minHeight: '400px' }}>\n+      <div\n+        style={{\n+          padding: '2rem',\n+          border: '2px dashed #c6c6c6',\n+          borderRadius: '4px',\n+          textAlign: 'center',\n+          cursor: 'context-menu',\n+        }}\n+        onContextMenu={handleContextMenu}>\n+        <p>Right-click anywhere in this area to open the context menu</p>\n+      </div>\n+      \n+      <ContextMenu\n+        {...props.contextMenu()}\n+        open={contextMenuState.open}\n+        x={contextMenuState.x}\n+        y={contextMenuState.y}\n+        onClose={handleClose}>\n+        <ContextMenuItem shortcut=\"Ctrl+C\">Copy</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+V\">Paste</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+X\">Cut</ContextMenuItem>\n+        <ContextMenuItem hasDivider isDanger shortcut=\"Del\">\n+          Delete\n+        </ContextMenuItem>\n+      </ContextMenu>\n+    </div>\n+  );\n+};\n+\n+export const WithKeyboardShortcuts = () => {\n+  const [contextMenuState, setContextMenuState] = useState({\n+    open: false,\n+    x: 0,\n+    y: 0,\n+  });\n+\n+  const handleContextMenu = (event) => {\n+    event.preventDefault();\n+    setContextMenuState({\n+      open: true,\n+      x: event.clientX,\n+      y: event.clientY,\n+    });\n+  };\n+\n+  const handleClose = () => {\n+    setContextMenuState({ ...contextMenuState, open: false });\n+  };\n+\n+  return (\n+    <div style={{ padding: '2rem', minHeight: '400px' }}>\n+      <div\n+        style={{\n+          padding: '2rem',\n+          border: '2px dashed #c6c6c6',\n+          borderRadius: '4px',\n+          textAlign: 'center',\n+          cursor: 'context-menu',\n+        }}\n+        onContextMenu={handleContextMenu}>\n+        <p>Right-click to see menu with keyboard shortcuts</p>\n+      </div>\n+      \n+      <ContextMenu\n+        open={contextMenuState.open}\n+        x={contextMenuState.x}\n+        y={contextMenuState.y}\n+        onClose={handleClose}>\n+        <ContextMenuItem shortcut=\"Ctrl+N\">New File</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+O\">Open File</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+S\">Save</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+Shift+S\">Save As</ContextMenuItem>\n+        <ContextMenuItem hasDivider shortcut=\"Ctrl+Z\">Undo</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+Y\">Redo</ContextMenuItem>\n+      </ContextMenu>\n+    </div>\n+  );\n+};\n+\n+export const WithNestedMenus = () => {\n+  const [contextMenuState, setContextMenuState] = useState({\n+    open: false,\n+    x: 0,\n+    y: 0,\n+  });\n+\n+  const handleContextMenu = (event) => {\n+    event.preventDefault();\n+    setContextMenuState({\n+      open: true,\n+      x: event.clientX,\n+      y: event.clientY,\n+    });\n+  };\n+\n+  const handleClose = () => {\n+    setContextMenuState({ ...contextMenuState, open: false });\n+  };\n+\n+  return (\n+    <div style={{ padding: '2rem', minHeight: '400px' }}>\n+      <div\n+        style={{\n+          padding: '2rem',\n+          border: '2px dashed #c6c6c6',\n+          borderRadius: '4px',\n+          textAlign: 'center',\n+          cursor: 'context-menu',\n+        }}\n+        onContextMenu={handleContextMenu}>\n+        <p>Right-click to see nested menu options</p>\n+      </div>\n+      \n+      <ContextMenu\n+        open={contextMenuState.open}\n+        x={contextMenuState.x}\n+        y={contextMenuState.y}\n+        onClose={handleClose}>\n+        <ContextMenuItem shortcut=\"Ctrl+C\">Copy</ContextMenuItem>\n+        <ContextMenuItem shortcut=\"Ctrl+V\">Paste</ContextMenuItem>\n+        <ContextMenuGroup label=\"Export\">\n+          <ContextMenuItem>Export as PDF</ContextMenuItem>\n+          <ContextMenuItem>Export as PNG</ContextMenuItem>\n+          <ContextMenuItem>Export as SVG</ContextMenuItem>\n+          <ContextMenuItem disabled>Export as JPEG</ContextMenuItem>\n+        </ContextMenuGroup>\n+        <ContextMenuGroup label=\"Share\">\n+          <ContextMenuItem>Share via Email</ContextMenuItem>\n+          <ContextMenuItem>Share via Link</ContextMenuItem>\n+          <ContextMenuItem disabled>Share via Slack</ContextMenuItem>\n+        </ContextMenuGroup>\n+        <ContextMenuItem hasDivider isDanger shortcut=\"Del\">\n+          Delete\n+        </ContextMenuItem>\n+      </ContextMenu>\n+    </div>\n+  );\n+};\n+\n+export const WithSelection = () => {\n+  const [contextMenuState, setContextMenuState] = useState({\n+    open: false,\n+    x: 0,\n+    y: 0,\n+  });\n+  const [selectedView, setSelectedView] = useState('list');\n+\n+  const handleContextMenu = (event) => {\n+    event.preventDefault();\n+    setContextMenuState({\n+      open: true,\n+      x: event.clientX,\n+      y: event.clientY,\n+    });\n+  };\n+\n+  const handleClose = () => {\n+    setContextMenuState({ ...contextMenuState, open: false });\n+  };\n+\n+  const handleViewSelect = ({ value }) => {\n+    setSelectedView(value);\n+  };\n+\n+  return (\n+    <div style={{ padding: '2rem', minHeight: '400px' }}>\n+      <div\n+        style={{\n+          padding: '2rem',\n+          border: '2px dashed #c6c6c6',\n+          borderRadius: '4px',\n+          textAlign: 'center',\n+          cursor: 'context-menu',\n+        }}\n+        onContextMenu={handleContextMenu}>\n+        <p>Right-click to see selectable options</p>\n+        <p>Current view: <strong>{selectedView}</strong></p>\n+      </div>\n+      \n+      <ContextMenu\n+        open={contextMenuState.open}\n+        x={contextMenuState.x}\n+        y={contextMenuState.y}\n+        onClose={handleClose}>\n+        <ContextMenuItem>View Options</ContextMenuItem>\n+        <ContextMenuItem hasDivider />\n+        <ContextMenuItem\n+          selectable\n+          selected={selectedView === 'list'}\n+          value=\"list\"\n+          onSelect={handleViewSelect}>\n+          List View\n+        </ContextMenuItem>\n+        <ContextMenuItem\n+          selectable\n+          selected={selectedView === 'grid'}\n+          value=\"grid\"\n+          onSelect={handleViewSelect}>\n+          Grid View\n+        </ContextMenuItem>\n+        <ContextMenuItem\n+          selectable\n+          selected={selectedView === 'card'}\n+          value=\"card\"\n+          onSelect={handleViewSelect}>\n+          Card View\n+        </ContextMenuItem>\n+      </ContextMenu>\n+    </div>\n+  );\n+};\n+\n+export const Playground = () => {\n+  const [contextMenuState, setContextMenuState] = useState({\n+    open: boolean('Open (open)', false),\n+    x: number('X position (x)', 100),\n+    y: number('Y position (y)', 100),\n+  });\n+\n+  const handleContextMenu = (event) => {\n+    event.preventDefault();\n+    setContextMenuState({\n+      open: true,\n+      x: event.clientX,\n+      y: event.clientY,\n+    });\n+  };\n+\n+  const handleClose = () => {\n+    setContextMenuState({ ...contextMenuState, open: false });\n+  };\n+\n+  return (\n+    <div style={{ padding: '2rem', minHeight: '400px' }}>\n+      <div\n+        style={{\n+          padding: '2rem',\n+          border: '2px dashed #c6c6c6',\n+          borderRadius: '4px',\n+          textAlign: 'center',\n+          cursor: 'context-menu',\n+        }}\n+        onContextMenu={handleContextMenu}>\n+        <p>Right-click anywhere in this area</p>\n+      </div>\n+      \n+      <ContextMenu\n+        {...props.contextMenu()}\n+        open={contextMenuState.open}\n+        x={contextMenuState.x}\n+        y={contextMenuState.y}\n+        onClose={handleClose}>\n+        <ContextMenuItem {...props.contextMenuItem()}>\n+          Option 1\n+        </ContextMenuItem>\n+        <ContextMenuItem {...props.contextMenuItem()}>\n+          Option 2 with a very long text that should be truncated\n+        </ContextMenuItem>\n+        <ContextMenuItem {...props.contextMenuItem()}>\n+          Option 3\n+        </ContextMenuItem>\n+      </ContextMenu>\n+    </div>\n+  );\n+};\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenu/ContextMenu-test.js b/packages/react/src/components/ContextMenu/ContextMenu-test.js\nnew file mode 100644\nindex 000000000..a45c7f8af\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenu/ContextMenu-test.js\n@@ -0,0 +1,345 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import React from 'react';\n+import { mount } from 'enzyme';\n+import { settings } from 'carbon-components';\n+import ContextMenu from './ContextMenu';\n+import ContextMenuItem from '../ContextMenuItem';\n+import ContextMenuGroup from '../ContextMenuGroup';\n+\n+const { prefix } = settings;\n+\n+describe('ContextMenu', () => {\n+  let mockGetBoundingClientRect;\n+\n+  beforeEach(() => {\n+    mockGetBoundingClientRect = jest.fn(() => ({\n+      width: 200,\n+      height: 300,\n+      top: 100,\n+      left: 150,\n+      bottom: 400,\n+      right: 350,\n+    }));\n+    Element.prototype.getBoundingClientRect = mockGetBoundingClientRect;\n+  });\n+\n+  afterEach(() => {\n+    jest.restoreAllMocks();\n+  });\n+\n+  describe('Basic rendering', () => {\n+    it('should render context menu when open', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+          <ContextMenuItem>Option 2</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      expect(wrapper.find(`.${prefix}--context-menu`)).toHaveLength(1);\n+      expect(wrapper.find(ContextMenuItem)).toHaveLength(2);\n+    });\n+\n+    it('should not render context menu when closed', () => {\n+      const wrapper = mount(\n+        <ContextMenu open={false} x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      expect(wrapper.find(`.${prefix}--context-menu`)).toHaveLength(0);\n+    });\n+\n+    it('should position menu at specified coordinates', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const menu = wrapper.find(`.${prefix}--context-menu`);\n+      const style = menu.prop('style');\n+      expect(style.left).toBe('100px');\n+      expect(style.top).toBe('200px');\n+    });\n+  });\n+\n+  describe('Right-click trigger', () => {\n+    it('should open context menu on right-click', () => {\n+      const onOpen = jest.fn();\n+      const wrapper = mount(\n+        <div>\n+          <ContextMenu onOpen={onOpen}>\n+            <ContextMenuItem>Option 1</ContextMenuItem>\n+          </ContextMenu>\n+          <div id=\"target\">Right-click me</div>\n+        </div>\n+      );\n+\n+      const target = wrapper.find('#target');\n+      target.simulate('contextmenu', {\n+        preventDefault: jest.fn(),\n+        clientX: 100,\n+        clientY: 200,\n+      });\n+\n+      expect(onOpen).toHaveBeenCalledWith(\n+        expect.objectContaining({\n+          clientX: 100,\n+          clientY: 200,\n+        })\n+      );\n+    });\n+\n+    it('should prevent default context menu behavior', () => {\n+      const preventDefault = jest.fn();\n+      const wrapper = mount(\n+        <div>\n+          <ContextMenu>\n+            <ContextMenuItem>Option 1</ContextMenuItem>\n+          </ContextMenu>\n+          <div id=\"target\">Right-click me</div>\n+        </div>\n+      );\n+\n+      const target = wrapper.find('#target');\n+      target.simulate('contextmenu', {\n+        preventDefault,\n+        clientX: 100,\n+        clientY: 200,\n+      });\n+\n+      expect(preventDefault).toHaveBeenCalled();\n+    });\n+  });\n+\n+  describe('Keyboard shortcuts display', () => {\n+    it('should display keyboard shortcuts when provided', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem shortcut=\"Ctrl+C\">Copy</ContextMenuItem>\n+          <ContextMenuItem shortcut=\"Ctrl+V\">Paste</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const shortcuts = wrapper.find(`.${prefix}--context-menu-item__shortcut`);\n+      expect(shortcuts).toHaveLength(2);\n+      expect(shortcuts.at(0).text()).toBe('Ctrl+C');\n+      expect(shortcuts.at(1).text()).toBe('Ctrl+V');\n+    });\n+\n+    it('should not display shortcut element when not provided', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>No shortcut</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const shortcuts = wrapper.find(`.${prefix}--context-menu-item__shortcut`);\n+      expect(shortcuts).toHaveLength(0);\n+    });\n+  });\n+\n+  describe('Nested menu support', () => {\n+    it('should render nested menu groups', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+          <ContextMenuGroup label=\"Submenu\">\n+            <ContextMenuItem>Sub Option 1</ContextMenuItem>\n+            <ContextMenuItem>Sub Option 2</ContextMenuItem>\n+          </ContextMenuGroup>\n+        </ContextMenu>\n+      );\n+\n+      expect(wrapper.find(ContextMenuGroup)).toHaveLength(1);\n+      expect(wrapper.find(ContextMenuItem)).toHaveLength(3); // 1 top-level + 2 nested\n+    });\n+\n+    it('should expand nested menu on hover', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuGroup label=\"Submenu\">\n+            <ContextMenuItem>Sub Option 1</ContextMenuItem>\n+          </ContextMenuGroup>\n+        </ContextMenu>\n+      );\n+\n+      const group = wrapper.find(ContextMenuGroup);\n+      group.simulate('mouseenter');\n+\n+      // Check if submenu is expanded\n+      expect(group.find(`.${prefix}--context-menu-group--expanded`)).toHaveLength(1);\n+    });\n+  });\n+\n+  describe('Selection behavior', () => {\n+    it('should support radio selection behavior', () => {\n+      const onSelect = jest.fn();\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem selectable selected onSelect={onSelect}>\n+            Option 1\n+          </ContextMenuItem>\n+          <ContextMenuItem selectable onSelect={onSelect}>\n+            Option 2\n+          </ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const items = wrapper.find(ContextMenuItem);\n+      expect(items.at(0).prop('selected')).toBe(true);\n+      expect(items.at(1).prop('selected')).toBeFalsy();\n+\n+      // Click second option\n+      items.at(1).simulate('click');\n+      expect(onSelect).toHaveBeenCalledWith(expect.objectContaining({\n+        value: 'Option 2'\n+      }));\n+    });\n+  });\n+\n+  describe('Disabled state handling', () => {\n+    it('should render disabled items correctly', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem disabled>Disabled Option</ContextMenuItem>\n+          <ContextMenuItem>Enabled Option</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const items = wrapper.find(ContextMenuItem);\n+      expect(items.at(0).prop('disabled')).toBe(true);\n+      expect(items.at(1).prop('disabled')).toBeFalsy();\n+    });\n+\n+    it('should keep parent groups enabled even if all children are disabled', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuGroup label=\"All Disabled\">\n+            <ContextMenuItem disabled>Disabled 1</ContextMenuItem>\n+            <ContextMenuItem disabled>Disabled 2</ContextMenuItem>\n+          </ContextMenuGroup>\n+        </ContextMenu>\n+      );\n+\n+      const group = wrapper.find(ContextMenuGroup);\n+      expect(group.prop('disabled')).toBeFalsy(); // Parent should remain enabled\n+    });\n+  });\n+\n+  describe('Outside click handling', () => {\n+    it('should close menu when clicking outside', () => {\n+      const onClose = jest.fn();\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200} onClose={onClose}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      // Simulate outside click\n+      wrapper.find('ClickListener').prop('onClickOutside')({\n+        target: document.body\n+      });\n+\n+      expect(onClose).toHaveBeenCalled();\n+    });\n+  });\n+\n+  describe('Keyboard navigation', () => {\n+    it('should handle arrow key navigation', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+          <ContextMenuItem>Option 2</ContextMenuItem>\n+          <ContextMenuItem>Option 3</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const menu = wrapper.find(`.${prefix}--context-menu`);\n+      \n+      // Test arrow down navigation\n+      menu.simulate('keydown', { key: 'ArrowDown', preventDefault: jest.fn() });\n+      \n+      // Should focus first item\n+      const firstItem = wrapper.find(ContextMenuItem).at(0);\n+      expect(firstItem.getDOMNode()).toBe(document.activeElement);\n+    });\n+\n+    it('should close menu on Escape key', () => {\n+      const onClose = jest.fn();\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200} onClose={onClose}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const menu = wrapper.find(`.${prefix}--context-menu`);\n+      menu.simulate('keydown', { key: 'Escape' });\n+\n+      expect(onClose).toHaveBeenCalled();\n+    });\n+  });\n+\n+  describe('Accessibility', () => {\n+    it('should have proper ARIA attributes', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const menu = wrapper.find(`.${prefix}--context-menu`);\n+      expect(menu.prop('role')).toBe('menu');\n+      expect(menu.prop('aria-orientation')).toBe('vertical');\n+    });\n+\n+    it('should have proper menuitem roles', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const item = wrapper.find(ContextMenuItem);\n+      expect(item.find('[role=\"menuitem\"]')).toHaveLength(1);\n+    });\n+  });\n+\n+  describe('Edge cases', () => {\n+    it('should handle empty menu', () => {\n+      const wrapper = mount(\n+        <ContextMenu open x={100} y={200}>\n+        </ContextMenu>\n+      );\n+\n+      expect(wrapper.find(`.${prefix}--context-menu`)).toHaveLength(1);\n+      expect(wrapper.find(ContextMenuItem)).toHaveLength(0);\n+    });\n+\n+    it('should handle viewport edge positioning', () => {\n+      // Mock viewport dimensions\n+      Object.defineProperty(window, 'innerWidth', { value: 1024 });\n+      Object.defineProperty(window, 'innerHeight', { value: 768 });\n+\n+      const wrapper = mount(\n+        <ContextMenu open x={1000} y={700}>\n+          <ContextMenuItem>Option 1</ContextMenuItem>\n+        </ContextMenu>\n+      );\n+\n+      const menu = wrapper.find(`.${prefix}--context-menu`);\n+      const style = menu.prop('style');\n+      \n+      // Should adjust position to stay within viewport\n+      expect(parseInt(style.left)).toBeLessThan(1000);\n+      expect(parseInt(style.top)).toBeLessThan(700);\n+    });\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenu/ContextMenu.js b/packages/react/src/components/ContextMenu/ContextMenu.js\nnew file mode 100644\nindex 000000000..952a8ae7e\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenu/ContextMenu.js\n@@ -0,0 +1,318 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import PropTypes from 'prop-types';\n+import React, { Component } from 'react';\n+import classNames from 'classnames';\n+import { settings } from 'carbon-components';\n+import ClickListener from '../../internal/ClickListener';\n+import { keys, matches as keyCodeMatches } from '../../internal/keyboard';\n+import mergeRefs from '../../tools/mergeRefs';\n+\n+const { prefix } = settings;\n+\n+/**\n+ * Context Menu component that provides a right-click menu with nested options,\n+ * keyboard shortcuts, and selection behavior.\n+ */\n+class ContextMenu extends Component {\n+  static propTypes = {\n+    /**\n+     * The child nodes (ContextMenuItem and ContextMenuGroup components).\n+     */\n+    children: PropTypes.node,\n+\n+    /**\n+     * The CSS class names.\n+     */\n+    className: PropTypes.string,\n+\n+    /**\n+     * The element ID.\n+     */\n+    id: PropTypes.string,\n+\n+    /**\n+     * The ref to attach to the context menu element.\n+     */\n+    innerRef: PropTypes.oneOfType([\n+      PropTypes.func,\n+      PropTypes.shape({\n+        current: PropTypes.any,\n+      }),\n+    ]),\n+\n+    /**\n+     * The event handler for when the menu is closed.\n+     */\n+    onClose: PropTypes.func,\n+\n+    /**\n+     * The event handler for when the menu is opened.\n+     */\n+    onOpen: PropTypes.func,\n+\n+    /**\n+     * `true` if the menu should be open.\n+     */\n+    open: PropTypes.bool,\n+\n+    /**\n+     * The target element to attach the context menu to.\n+     * If not provided, will attach to document body.\n+     */\n+    target: PropTypes.oneOfType([\n+      PropTypes.func,\n+      PropTypes.shape({\n+        current: PropTypes.any,\n+      }),\n+    ]),\n+\n+    /**\n+     * The x coordinate for positioning the menu.\n+     */\n+    x: PropTypes.number,\n+\n+    /**\n+     * The y coordinate for positioning the menu.\n+     */\n+    y: PropTypes.number,\n+  };\n+\n+  static defaultProps = {\n+    open: false,\n+    onClose: () => {},\n+    onOpen: () => {},\n+    x: 0,\n+    y: 0,\n+  };\n+\n+  state = {\n+    open: this.props.open,\n+    x: this.props.x,\n+    y: this.props.y,\n+    focusedIndex: -1,\n+  };\n+\n+  /**\n+   * The element ref of the context menu.\n+   * @type {React.RefObject<Element>}\n+   * @private\n+   */\n+  _menuRef = React.createRef();\n+\n+  /**\n+   * Array of menu item refs for keyboard navigation.\n+   * @private\n+   */\n+  _menuItems = [];\n+\n+  componentDidMount() {\n+    // Add context menu event listener to target or document\n+    const target = this.props.target?.current || document;\n+    target.addEventListener('contextmenu', this.handleContextMenu);\n+  }\n+\n+  componentWillUnmount() {\n+    // Remove context menu event listener\n+    const target = this.props.target?.current || document;\n+    target.removeEventListener('contextmenu', this.handleContextMenu);\n+  }\n+\n+  static getDerivedStateFromProps({ open, x, y }, state) {\n+    const { prevOpen, prevX, prevY } = state;\n+    const changes = {};\n+    \n+    if (prevOpen !== open) {\n+      changes.open = open;\n+      changes.prevOpen = open;\n+    }\n+    \n+    if (prevX !== x) {\n+      changes.x = x;\n+      changes.prevX = x;\n+    }\n+    \n+    if (prevY !== y) {\n+      changes.y = y;\n+      changes.prevY = y;\n+    }\n+    \n+    return Object.keys(changes).length > 0 ? changes : null;\n+  }\n+\n+  componentDidUpdate(prevProps, prevState) {\n+    const { onClose, onOpen } = this.props;\n+    \n+    if (!this.state.open && prevState.open) {\n+      onClose();\n+    }\n+    \n+    if (this.state.open && !prevState.open) {\n+      onOpen();\n+      // Focus the menu for keyboard navigation\n+      if (this._menuRef.current) {\n+        this._menuRef.current.focus();\n+      }\n+    }\n+  }\n+\n+  /**\n+   * Handle right-click context menu event\n+   */\n+  handleContextMenu = (event) => {\n+    event.preventDefault();\n+    \n+    // Calculate position, ensuring menu stays within viewport\n+    const x = Math.min(event.clientX, window.innerWidth - 200);\n+    const y = Math.min(event.clientY, window.innerHeight - 300);\n+    \n+    this.setState({\n+      open: true,\n+      x,\n+      y,\n+      focusedIndex: -1,\n+    });\n+    \n+    this.props.onOpen(event);\n+  };\n+\n+  /**\n+   * Handle outside click to close menu\n+   */\n+  handleClickOutside = (event) => {\n+    if (this.state.open) {\n+      this.closeMenu();\n+    }\n+  };\n+\n+  /**\n+   * Close the context menu\n+   */\n+  closeMenu = () => {\n+    this.setState({\n+      open: false,\n+      focusedIndex: -1,\n+    });\n+  };\n+\n+  /**\n+   * Handle keyboard navigation\n+   */\n+  handleKeyDown = (event) => {\n+    const { focusedIndex } = this.state;\n+    const menuItems = this._menuItems.filter(item => item && !item.disabled);\n+    \n+    if (keyCodeMatches(event, [keys.Escape])) {\n+      event.preventDefault();\n+      this.closeMenu();\n+      return;\n+    }\n+    \n+    if (keyCodeMatches(event, [keys.ArrowDown])) {\n+      event.preventDefault();\n+      const nextIndex = focusedIndex < menuItems.length - 1 ? focusedIndex + 1 : 0;\n+      this.setState({ focusedIndex: nextIndex });\n+      if (menuItems[nextIndex]) {\n+        menuItems[nextIndex].focus();\n+      }\n+      return;\n+    }\n+    \n+    if (keyCodeMatches(event, [keys.ArrowUp])) {\n+      event.preventDefault();\n+      const nextIndex = focusedIndex > 0 ? focusedIndex - 1 : menuItems.length - 1;\n+      this.setState({ focusedIndex: nextIndex });\n+      if (menuItems[nextIndex]) {\n+        menuItems[nextIndex].focus();\n+      }\n+      return;\n+    }\n+    \n+    if (keyCodeMatches(event, [keys.Enter, keys.Space])) {\n+      event.preventDefault();\n+      if (menuItems[focusedIndex]) {\n+        menuItems[focusedIndex].click();\n+      }\n+      return;\n+    }\n+  };\n+\n+  /**\n+   * Register menu item ref for keyboard navigation\n+   */\n+  registerMenuItem = (ref, index) => {\n+    this._menuItems[index] = ref;\n+  };\n+\n+  render() {\n+    const {\n+      children,\n+      className,\n+      id,\n+      target, // eslint-disable-line\n+      onClose, // eslint-disable-line\n+      onOpen, // eslint-disable-line\n+      open: openProp, // eslint-disable-line\n+      x: xProp, // eslint-disable-line\n+      y: yProp, // eslint-disable-line\n+      innerRef, // eslint-disable-line\n+      ...other\n+    } = this.props;\n+\n+    const { open, x, y } = this.state;\n+\n+    if (!open) {\n+      return null;\n+    }\n+\n+    const contextMenuClasses = classNames(\n+      `${prefix}--context-menu`,\n+      className\n+    );\n+\n+    const childrenWithProps = React.Children.toArray(children).map(\n+      (child, index) =>\n+        React.cloneElement(child, {\n+          closeMenu: this.closeMenu,\n+          registerMenuItem: this.registerMenuItem,\n+          index,\n+        })\n+    );\n+\n+    return (\n+      <ClickListener onClickOutside={this.handleClickOutside}>\n+        <div\n+          {...other}\n+          id={id}\n+          className={contextMenuClasses}\n+          ref={mergeRefs(this._menuRef, innerRef)}\n+          role=\"menu\"\n+          aria-orientation=\"vertical\"\n+          tabIndex=\"-1\"\n+          onKeyDown={this.handleKeyDown}\n+          style={{\n+            position: 'fixed',\n+            left: `${x}px`,\n+            top: `${y}px`,\n+            zIndex: 9999,\n+          }}>\n+          <ul className={`${prefix}--context-menu__list`} role=\"none\">\n+            {childrenWithProps}\n+          </ul>\n+        </div>\n+      </ClickListener>\n+    );\n+  }\n+}\n+\n+export { ContextMenu };\n+export default (() => {\n+  const forwardRef = (props, ref) => <ContextMenu {...props} innerRef={ref} />;\n+  forwardRef.displayName = 'ContextMenu';\n+  return React.forwardRef(forwardRef);\n+})();\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenu/ContextMenu.mdx b/packages/react/src/components/ContextMenu/ContextMenu.mdx\nnew file mode 100644\nindex 000000000..5bc4c21b0\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenu/ContextMenu.mdx\n@@ -0,0 +1,50 @@\n+import { Props, Description } from '@storybook/addon-docs/blocks';\n+import { ContextMenu } from './ContextMenu';\n+\n+# ContextMenu\n+\n+<Description of={ContextMenu} />\n+\n+The ContextMenu component provides a right-click menu with nested options, keyboard shortcuts, and selection behavior. It can be used as an enhanced overflow menu alternative when you don't want to override the browser's context menu.\n+\n+## Table of Contents\n+\n+- [Overview](#overview)\n+- [Component API](#component-api)\n+- [Feedback](#feedback)\n+\n+## Overview\n+\n+The ContextMenu component supports:\n+\n+- **Right-click trigger**: Opens on contextmenu events\n+- **Keyboard shortcuts**: Display shortcuts next to menu items for progressive education\n+- **Nested menus**: Support for hierarchical menu structures with ContextMenuGroup\n+- **Selection behavior**: Radio-style selection for menu items\n+- **Disabled state handling**: Parent groups remain enabled even if all children are disabled\n+- **Absolute positioning**: Programmatic control over menu position\n+- **Keyboard navigation**: Full keyboard support with arrow keys and Enter/Space\n+- **Accessibility**: Proper ARIA attributes and roles\n+\n+### When to use\n+\n+- Complex data-heavy applications that need context-specific actions\n+- Applications where overflow menus are not sufficient due to layout constraints\n+- When you need to provide keyboard shortcuts education to users\n+- Data grids or tables where users need multiple options for cells/rows\n+\n+### When not to use\n+\n+- Simple applications with basic menu needs (use OverflowMenu instead)\n+- When you want to preserve the browser's native context menu\n+- Mobile-first applications (context menus are primarily desktop patterns)\n+\n+## Component API\n+\n+<Props of={ContextMenu} />\n+\n+## Feedback\n+\n+Help us improve this component by providing feedback, asking questions on Slack,\n+or updating this file on\n+[GitHub](https://github.com/carbon-design-system/carbon/edit/main/packages/react/src/components/ContextMenu/ContextMenu.mdx).\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenu/index.js b/packages/react/src/components/ContextMenu/index.js\nnew file mode 100644\nindex 000000000..e305db719\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenu/index.js\n@@ -0,0 +1,9 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+export { default } from './ContextMenu';\n+export { ContextMenu } from './ContextMenu';\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenuGroup/ContextMenuGroup.js b/packages/react/src/components/ContextMenuGroup/ContextMenuGroup.js\nnew file mode 100644\nindex 000000000..f823aed58\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenuGroup/ContextMenuGroup.js\n@@ -0,0 +1,160 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import PropTypes from 'prop-types';\n+import React from 'react';\n+import classNames from 'classnames';\n+import { settings } from 'carbon-components';\n+import { ChevronRight16 } from '@carbon/icons-react';\n+\n+const { prefix } = settings;\n+\n+export default class ContextMenuGroup extends React.Component {\n+  static propTypes = {\n+    /**\n+     * The child menu items for the submenu.\n+     */\n+    children: PropTypes.node.isRequired,\n+\n+    /**\n+     * The CSS class name to be placed on the menu group element.\n+     */\n+    className: PropTypes.string,\n+\n+    /**\n+     * A callback to tell the parent menu component that the menu should be closed.\n+     */\n+    closeMenu: PropTypes.func,\n+\n+    /**\n+     * The index of this menu group (used for keyboard navigation).\n+     */\n+    index: PropTypes.number,\n+\n+    /**\n+     * The label text for the menu group.\n+     */\n+    label: PropTypes.string.isRequired,\n+\n+    /**\n+     * Function to register this menu item for keyboard navigation.\n+     */\n+    registerMenuItem: PropTypes.func,\n+  };\n+\n+  state = {\n+    expanded: false,\n+  };\n+\n+  menuGroupRef = React.createRef();\n+  submenuRef = React.createRef();\n+\n+  componentDidMount() {\n+    // Register this menu group for keyboard navigation\n+    if (this.props.registerMenuItem) {\n+      this.props.registerMenuItem(this.menuGroupRef.current, this.props.index);\n+    }\n+  }\n+\n+  handleMouseEnter = () => {\n+    this.setState({ expanded: true });\n+  };\n+\n+  handleMouseLeave = () => {\n+    this.setState({ expanded: false });\n+  };\n+\n+  handleClick = (event) => {\n+    event.preventDefault();\n+    // Toggle expanded state on click\n+    this.setState({ expanded: !this.state.expanded });\n+  };\n+\n+  handleKeyDown = (event) => {\n+    if (event.key === 'ArrowRight' || event.key === 'Enter') {\n+      event.preventDefault();\n+      this.setState({ expanded: true });\n+      // Focus first item in submenu\n+      setTimeout(() => {\n+        const firstItem = this.submenuRef.current?.querySelector('button');\n+        if (firstItem) {\n+          firstItem.focus();\n+        }\n+      }, 0);\n+    }\n+  };\n+\n+  render() {\n+    const {\n+      children,\n+      className,\n+      label,\n+      closeMenu,\n+      index, // eslint-disable-line\n+      registerMenuItem, // eslint-disable-line\n+      ...other\n+    } = this.props;\n+\n+    const { expanded } = this.state;\n+\n+    const contextMenuGroupClasses = classNames(\n+      `${prefix}--context-menu-group`,\n+      {\n+        [`${prefix}--context-menu-group--expanded`]: expanded,\n+      },\n+      className\n+    );\n+\n+    const childrenWithProps = React.Children.toArray(children).map(\n+      (child, childIndex) =>\n+        React.cloneElement(child, {\n+          closeMenu,\n+          index: childIndex,\n+        })\n+    );\n+\n+    return (\n+      <li\n+        className={contextMenuGroupClasses}\n+        role=\"menuitem\"\n+        aria-haspopup=\"true\"\n+        aria-expanded={expanded}\n+        onMouseEnter={this.handleMouseEnter}\n+        onMouseLeave={this.handleMouseLeave}>\n+        <button\n+          {...other}\n+          ref={this.menuGroupRef}\n+          className={`${prefix}--context-menu-group__button`}\n+          onClick={this.handleClick}\n+          onKeyDown={this.handleKeyDown}\n+          tabIndex=\"-1\"\n+          type=\"button\"\n+          role=\"menuitem\"\n+          aria-haspopup=\"true\"\n+          aria-expanded={expanded}>\n+          <div className={`${prefix}--context-menu-group__content`}>\n+            <span className={`${prefix}--context-menu-group__text`}>\n+              {label}\n+            </span>\n+            <ChevronRight16 className={`${prefix}--context-menu-group__icon`} />\n+          </div>\n+        </button>\n+        {expanded && (\n+          <div\n+            ref={this.submenuRef}\n+            className={`${prefix}--context-menu-group__submenu`}\n+            role=\"menu\"\n+            aria-orientation=\"vertical\">\n+            <ul className={`${prefix}--context-menu__list`} role=\"none\">\n+              {childrenWithProps}\n+            </ul>\n+          </div>\n+        )}\n+      </li>\n+    );\n+  }\n+}\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenuGroup/index.js b/packages/react/src/components/ContextMenuGroup/index.js\nnew file mode 100644\nindex 000000000..2f838780f\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenuGroup/index.js\n@@ -0,0 +1,8 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+export { default } from './ContextMenuGroup';\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ContextMenuItem/ContextMenuItem.js b/packages/react/src/components/ContextMenuItem/ContextMenuItem.js\nnew file mode 100644\nindex 000000000..c76c4389b\n--- /dev/null\n+++ b/packages/react/src/components/ContextMenuItem/ContextMenuItem.js\n@@ -0,0 +1,185 @@\n+/**\n+ * Copyright IBM Corp. 2020\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import PropTypes from 'prop-types';\n+import React from 'react';\n+import classNames from 'classnames';\n+import { settings } from 'carbon-components';\n+\n+const { prefix } = settings;\n+\n+export default class ContextMenuItem extends React.Component {\n+  static propTypes = {\n+    /**\n+     * The text content of the menu item.\n+     */\n+    children: PropTypes.node.isRequired,\n+\n+    /**\n+     * The CSS class name to be placed on the menu item element.\n+     */\n+    className: PropTypes.string,\n+\n+    /**\n+     * A callback to tell the parent menu component that the menu should be closed.\n+     */\n+    closeMenu: PropTypes.func,\n+\n+    /**\n+     * `true` to make this menu item disabled.\n+     */\n+    disabled: PropTypes.bool,\n+\n+    /**\n+     * `true` to make this menu item a divider.\n+     */\n+    hasDivider: PropTypes.bool,\n+\n+    /**\n+     * The index of this menu item (used for keyboard navigation).\n+     */\n+    index: PropTypes.number,\n+\n+    /**\n+     * `true` to make this menu item a \"danger\" item.\n+     */\n+    isDanger: PropTypes.bool,\n+\n+    /**\n+     * The event handler for the `click` event.\n+     */\n+    onClick: PropTypes.func,\n+\n+    /**\n+     * The event handler for selection events (when selectable is true).\n+     */\n+    onSelect: PropTypes.func,\n+\n+    /**\n+     * Function to register this menu item for keyboard navigation.\n+     */\n+    registerMenuItem: PropTypes.func,\n+\n+    /**\n+     * `true` to make this menu item selectable (radio behavior).\n+     */\n+    selectable: PropTypes.bool,\n+\n+    /**\n+     * `true` if this menu item is selected (when selectable is true).\n+     */\n+    selected: PropTypes.bool,\n+\n+    /**\n+     * The keyboard shortcut to display next to the menu item text.\n+     */\n+    shortcut: PropTypes.string,\n+\n+    /**\n+     * The value associated with this menu item (used for selection).\n+     */\n+    value: PropTypes.any,\n+  };\n+\n+  static defaultProps = {\n+    disabled: false,\n+    hasDivider: false,\n+    isDanger: false,\n+    selectable: false,\n+    selected: false,\n+    onClick: () => {},\n+    onSelect: () => {},\n+  };\n+\n+  menuItemRef = React.createRef();\n+\n+  componentDidMount() {\n+    // Register this menu item for keyboard navigation\n+    if (this.props.registerMenuItem) {\n+      this.props.registerMenuItem(this.menuItemRef.current, this.props.index);\n+    }\n+  }\n+\n+  handleClick = (event) => {\n+    const { onClick, onSelect, closeMenu, disabled, selectable, value, children } = this.props;\n+    \n+    if (disabled) {\n+      return;\n+    }\n+\n+    onClick(event);\n+\n+    if (selectable) {\n+      onSelect({\n+        value: value !== undefined ? value : children,\n+        event,\n+      });\n+    }\n+\n+    if (closeMenu) {\n+      closeMenu();\n+    }\n+  };\n+\n+  render() {\n+    const {\n+      children,\n+      className,\n+      disabled,\n+      hasDivider,\n+      isDanger,\n+      selectable,\n+      selected,\n+      shortcut,\n+      closeMenu, // eslint-disable-line\n+      index, // eslint-disable-line\n+      onClick, // eslint-disable-line\n+      onSelect, // eslint-disable-line\n+      registerMenuItem, // eslint-disable-line\n+      value, // eslint-disable-line\n+      ...other\n+    } = this.props;\n+\n+    const contextMenuItemClasses = classNames(\n+      `${prefix}--context-menu-item`,\n+      {\n+        [`${prefix}--context-menu-item--divider`]: hasDivider,\n+        [`${prefix}--context-menu-item--danger`]: isDanger,\n+        [`${prefix}--context-menu-item--disabled`]: disabled,\n+        [`${prefix}--context-menu-item--selectable`]: selectable,\n+        [`${prefix}--context-menu-item--selected`]: selected,\n+      },\n+      className\n+    );\n+\n+    return (\n+      <li className={contextMenuItemClasses} role=\"menuitem\">\n+        <button\n+          {...other}\n+          ref={this.menuItemRef}\n+          className={`${prefix}--context-menu-item__button`}\n+          disabled={disabled}\n+          onClick={this.handleClick}\n+          tabIndex=\"-1\"\n+          type=\"button\"\n+          aria-checked={s
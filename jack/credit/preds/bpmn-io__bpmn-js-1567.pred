{"instance_id": "bpmn-io__bpmn-js-1567", "model_patch": "diff --git a/lib/features/drilldown/DrilldownBreadcrumbs.js b/lib/features/drilldown/DrilldownBreadcrumbs.js\nindex 20447a86..9f4b9aee 100644\n--- a/lib/features/drilldown/DrilldownBreadcrumbs.js\n+++ b/lib/features/drilldown/DrilldownBreadcrumbs.js\n@@ -29,7 +29,28 @@ export default function DrilldownBreadcrumbs(eventBus, elementRegistry, overlays\n       var link = domify('<li><span class=\"bjs-crumb\"><a title=\"' + title + '\">' + title + '</a></span></li>');\n \n       link.addEventListener('click', function() {\n-        canvas.setRootElement(canvas.findRoot(planeId(el)) || canvas.findRoot(el.id));\n+        var targetRoot = canvas.findRoot(planeId(el)) || canvas.findRoot(el.id);\n+        \n+        // If we can't find the target root directly, try to find it by looking for\n+        // a root that contains this element in its business object hierarchy\n+        if (!targetRoot) {\n+          var rootElements = canvas.getRootElements();\n+          \n+          for (var i = 0; i < rootElements.length; i++) {\n+            var rootElement = rootElements[i];\n+            var rootBo = getBusinessObject(rootElement);\n+            \n+            // Check if this root element contains our target element\n+            if (containsElement(rootBo, el)) {\n+              targetRoot = rootElement;\n+              break;\n+            }\n+          }\n+        }\n+        \n+        if (targetRoot) {\n+          canvas.setRootElement(targetRoot);\n+        }\n       });\n \n       return link;\n@@ -68,4 +89,51 @@ function getParentChain(child) {\n   }\n \n   return parents.reverse();\n+}\n+\n+/**\n+ * Check if a root business object contains the target element in its hierarchy\n+ */\n+function containsElement(rootBo, targetElement) {\n+  // If the root is a collaboration, check its participants' processes\n+  if (is(rootBo, 'bpmn:Collaboration')) {\n+    var participants = rootBo.participants || [];\n+    \n+    for (var i = 0; i < participants.length; i++) {\n+      var participant = participants[i];\n+      var process = participant.processRef;\n+      \n+      if (process && containsElementInProcess(process, targetElement)) {\n+        return true;\n+      }\n+    }\n+  }\n+  \n+  // If the root is a process, check directly\n+  if (is(rootBo, 'bpmn:Process')) {\n+    return containsElementInProcess(rootBo, targetElement);\n+  }\n+  \n+  return false;\n+}\n+\n+/**\n+ * Check if a process contains the target element\n+ */\n+function containsElementInProcess(process, targetElement) {\n+  // Direct match\n+  if (process === targetElement) {\n+    return true;\n+  }\n+  \n+  // Check if the target element is contained within this process hierarchy\n+  var current = targetElement;\n+  while (current) {\n+    if (current === process) {\n+      return true;\n+    }\n+    current = current.$parent;\n+  }\n+  \n+  return false;\n }\n\\ No newline at end of file\ndiff --git a/package.json b/package.json\nindex 718d241f..75951047 100644\n--- a/package.json\n+++ b/package.json\n@@ -104,6 +104,7 @@\n     \"diagram-js-direct-editing\": \"^1.6.3\",\n     \"ids\": \"^1.0.0\",\n     \"inherits\": \"^2.0.4\",\n+    \"jsdom\": \"^28.1.0\",\n     \"min-dash\": \"^3.5.2\",\n     \"min-dom\": \"^3.1.3\",\n     \"object-refs\": \"^0.3.0\",\ndiff --git a/test/spec/features/drilldown/DrilldownPoolSpec.js b/test/spec/features/drilldown/DrilldownPoolSpec.js\nnew file mode 100644\nindex 00000000..986f787c\n--- /dev/null\n+++ b/test/spec/features/drilldown/DrilldownPoolSpec.js\n@@ -0,0 +1,178 @@\n+import {\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import DrilldownModule from 'lib/features/drilldown';\n+import { bootstrapViewer, getBpmnJS } from '../../../helper';\n+\n+describe('features - drilldown with pools', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    DrilldownModule\n+  ];\n+\n+  // BPMN with collaboration containing a pool with a collapsed subprocess\n+  var poolWithSubprocessXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Collapsed SubProcess\">\n+      <bpmn:incoming>Flow_1</bpmn:incoming>\n+      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n+      <bpmn:startEvent id=\"StartEvent_2\">\n+        <bpmn:outgoing>Flow_3</bpmn:outgoing>\n+      </bpmn:startEvent>\n+      <bpmn:task id=\"Task_1\" name=\"Task\">\n+        <bpmn:incoming>Flow_3</bpmn:incoming>\n+        <bpmn:outgoing>Flow_4</bpmn:outgoing>\n+      </bpmn:task>\n+      <bpmn:endEvent id=\"EndEvent_2\">\n+        <bpmn:incoming>Flow_4</bpmn:incoming>\n+      </bpmn:endEvent>\n+      <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"StartEvent_2\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"Task_1\" targetRef=\"EndEvent_2\" />\n+    </bpmn:subProcess>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>Flow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"false\">\n+        <dc:Bounds x=\"300\" y=\"160\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_1_di\" bpmnElement=\"Flow_1\">\n+        <di:waypoint x=\"248\" y=\"200\" />\n+        <di:waypoint x=\"300\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_2_di\" bpmnElement=\"Flow_2\">\n+        <di:waypoint x=\"400\" y=\"200\" />\n+        <di:waypoint x=\"452\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+    <bpmndi:BPMNPlane id=\"SubProcess_1_plane\" bpmnElement=\"SubProcess_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"180\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"138\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_2_di\" bpmnElement=\"EndEvent_2\">\n+        <dc:Bounds x=\"422\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_3_di\" bpmnElement=\"Flow_3\">\n+        <di:waypoint x=\"216\" y=\"178\" />\n+        <di:waypoint x=\"270\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_4_di\" bpmnElement=\"Flow_4\">\n+        <di:waypoint x=\"370\" y=\"178\" />\n+        <di:waypoint x=\"422\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapViewer(poolWithSubprocessXML, { modules: testModules }));\n+\n+  describe('Breadcrumbs with Pool', function() {\n+\n+    it('should show breadcrumbs when drilling into subprocess within pool', inject(function(canvas) {\n+\n+      // given\n+      var container = canvas.getContainer();\n+\n+      // when\n+      canvas.setRootElement(canvas.findRoot('SubProcess_1_plane'));\n+\n+      // then\n+      expect(container.querySelector('.bjs-breadcrumbs')).to.exist;\n+      expect(container.classList.contains('bjs-breadcrumbs-shown')).to.be.true;\n+    }));\n+\n+    it('should allow drilling out from subprocess to pool', inject(function(canvas) {\n+\n+      // given\n+      var collaborationRoot = canvas.findRoot('Collaboration_1');\n+      var subProcessRoot = canvas.findRoot('SubProcess_1_plane');\n+      \n+      expect(collaborationRoot).to.exist;\n+      expect(subProcessRoot).to.exist;\n+\n+      // when - drill into subprocess\n+      canvas.setRootElement(subProcessRoot);\n+      \n+      // then - should be in subprocess\n+      expect(canvas.getRootElement()).to.equal(subProcessRoot);\n+\n+      // when - drill out by clicking breadcrumb\n+      var breadcrumbs = canvas.getContainer().querySelector('.bjs-breadcrumbs');\n+      var firstBreadcrumb = breadcrumbs.children[0];\n+      \n+      expect(firstBreadcrumb).to.exist;\n+      \n+      // This should not throw \"rootElement required\" error\n+      expect(function() {\n+        firstBreadcrumb.click();\n+      }).to.not.throw();\n+\n+      // then - should be back in collaboration root\n+      expect(canvas.getRootElement()).to.equal(collaborationRoot);\n+    }));\n+\n+    it('should handle multiple drill out operations', inject(function(canvas) {\n+\n+      // given\n+      var collaborationRoot = canvas.findRoot('Collaboration_1');\n+      var subProcessRoot = canvas.findRoot('SubProcess_1_plane');\n+\n+      // when - drill in and out multiple times\n+      canvas.setRootElement(subProcessRoot);\n+      \n+      var breadcrumbs = canvas.getContainer().querySelector('.bjs-breadcrumbs');\n+      var firstBreadcrumb = breadcrumbs.children[0];\n+      \n+      // First drill out\n+      firstBreadcrumb.click();\n+      expect(canvas.getRootElement()).to.equal(collaborationRoot);\n+      \n+      // Drill back in\n+      canvas.setRootElement(subProcessRoot);\n+      expect(canvas.getRootElement()).to.equal(subProcessRoot);\n+      \n+      // Second drill out - should still work\n+      breadcrumbs = canvas.getContainer().querySelector('.bjs-breadcrumbs');\n+      firstBreadcrumb = breadcrumbs.children[0];\n+      \n+      expect(function() {\n+        firstBreadcrumb.click();\n+      }).to.not.throw();\n+      \n+      expect(canvas.getRootElement()).to.equal(collaborationRoot);\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_drilldown_issue.js b/test_drilldown_issue.js\nnew file mode 100644\nindex 00000000..67652c19\n--- /dev/null\n+++ b/test_drilldown_issue.js\n@@ -0,0 +1,174 @@\n+/**\n+ * Test to reproduce the drilldown issue after root change\n+ * Issue: Cannot drill out after root change\n+ * Error: \"rootElement required\" when trying to navigate back from sub-process\n+ */\n+\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Import BPMN.js modules\n+const BpmnJS = require('./lib/Modeler');\n+\n+// Create a test BPMN with a pool containing a collapsed subprocess\n+const testBPMN = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Collapsed SubProcess\">\n+      <bpmn:incoming>Flow_1</bpmn:incoming>\n+      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n+      <bpmn:startEvent id=\"StartEvent_2\">\n+        <bpmn:outgoing>Flow_3</bpmn:outgoing>\n+      </bpmn:startEvent>\n+      <bpmn:task id=\"Task_1\" name=\"Task\">\n+        <bpmn:incoming>Flow_3</bpmn:incoming>\n+        <bpmn:outgoing>Flow_4</bpmn:outgoing>\n+      </bpmn:task>\n+      <bpmn:endEvent id=\"EndEvent_2\">\n+        <bpmn:incoming>Flow_4</bpmn:incoming>\n+      </bpmn:endEvent>\n+      <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"StartEvent_2\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"Task_1\" targetRef=\"EndEvent_2\" />\n+    </bpmn:subProcess>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>Flow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"false\">\n+        <dc:Bounds x=\"300\" y=\"160\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_1_di\" bpmnElement=\"Flow_1\">\n+        <di:waypoint x=\"248\" y=\"200\" />\n+        <di:waypoint x=\"300\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_2_di\" bpmnElement=\"Flow_2\">\n+        <di:waypoint x=\"400\" y=\"200\" />\n+        <di:waypoint x=\"452\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+    <bpmndi:BPMNPlane id=\"SubProcess_1_plane\" bpmnElement=\"SubProcess_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"180\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"138\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_2_di\" bpmnElement=\"EndEvent_2\">\n+        <dc:Bounds x=\"422\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_3_di\" bpmnElement=\"Flow_3\">\n+        <di:waypoint x=\"216\" y=\"178\" />\n+        <di:waypoint x=\"270\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_4_di\" bpmnElement=\"Flow_4\">\n+        <di:waypoint x=\"370\" y=\"178\" />\n+        <di:waypoint x=\"422\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function testDrilldownIssue() {\n+  console.log('Testing drilldown issue reproduction...');\n+  \n+  try {\n+    // Create BPMN modeler instance\n+    const modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    // Import the test BPMN\n+    await modeler.importXML(testBPMN);\n+    \n+    const canvas = modeler.get('canvas');\n+    const elementRegistry = modeler.get('elementRegistry');\n+    \n+    console.log('\u2713 BPMN imported successfully');\n+    \n+    // Step 1: Verify we start with the collaboration (pool) as root\n+    const initialRoot = canvas.getRootElement();\n+    console.log('Initial root:', initialRoot.id, initialRoot.businessObject.id);\n+    \n+    // Step 2: Navigate into the collapsed sub-process\n+    const subProcessPlane = canvas.findRoot('SubProcess_1_plane');\n+    console.log('SubProcess plane found:', subProcessPlane ? subProcessPlane.id : 'NOT FOUND');\n+    \n+    if (subProcessPlane) {\n+      canvas.setRootElement(subProcessPlane);\n+      console.log('\u2713 Successfully navigated into sub-process');\n+      \n+      // Step 3: Try to navigate back to parent process - this should trigger the error\n+      console.log('Attempting to drill out...');\n+      \n+      // Simulate clicking breadcrumb to go back\n+      // This is where the error should occur\n+      const parentElement = subProcessPlane.businessObject.$parent;\n+      console.log('Parent element:', parentElement ? parentElement.id : 'NOT FOUND');\n+      \n+      if (parentElement) {\n+        // This is the problematic line from DrilldownBreadcrumbs.js:31\n+        const planeId = require('./lib/util/DrilldownUtil').planeId;\n+        const targetPlaneId = planeId(parentElement);\n+        console.log('Target plane ID:', targetPlaneId);\n+        \n+        const targetRoot = canvas.findRoot(targetPlaneId) || canvas.findRoot(parentElement.id);\n+        console.log('Target root found:', targetRoot ? targetRoot.id : 'NOT FOUND');\n+        \n+        if (!targetRoot) {\n+          console.log('\u274c ERROR: No target root found - this will cause \"rootElement required\" error');\n+          return false;\n+        } else {\n+          canvas.setRootElement(targetRoot);\n+          console.log('\u2713 Successfully drilled out');\n+          return true;\n+        }\n+      }\n+    }\n+    \n+    return false;\n+  } catch (error) {\n+    console.log('\u274c ERROR:', error.message);\n+    return false;\n+  }\n+}\n+\n+// Run the test\n+if (require.main === module) {\n+  // Create a simple HTML container for testing\n+  const { JSDOM } = require('jsdom');\n+  const dom = new JSDOM('<!DOCTYPE html><html><body><div id=\"canvas\"></div></body></html>');\n+  global.window = dom.window;\n+  global.document = dom.window.document;\n+  global.navigator = dom.window.navigator;\n+  \n+  testDrilldownIssue().then(success => {\n+    console.log('Test result:', success ? 'PASSED' : 'FAILED');\n+    process.exit(success ? 0 : 1);\n+  });\n+}\n+\n+module.exports = { testDrilldownIssue, testBPMN };\n\\ No newline at end of file\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 00000000..533f6b0f\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,239 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Test Drilldown Fix</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; }\n+    .controls { margin: 10px 0; }\n+    button { margin: 5px; padding: 10px; }\n+    .status { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+    .error { background: #ffebee; color: #c62828; }\n+    .success { background: #e8f5e8; color: #2e7d32; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Test Drilldown Fix - Pool with Subprocess</h1>\n+  \n+  <div class=\"controls\">\n+    <button onclick=\"loadDiagram()\">Load Diagram</button>\n+    <button onclick=\"drillIntoSubprocess()\">Drill Into Subprocess</button>\n+    <button onclick=\"drillOutViaCode()\">Drill Out (Code)</button>\n+    <button onclick=\"testBreadcrumbClick()\">Test Breadcrumb Click</button>\n+  </div>\n+  \n+  <div id=\"status\" class=\"status\">Ready to test...</div>\n+  \n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var modeler;\n+    var statusDiv = document.getElementById('status');\n+    \n+    // BPMN with collaboration containing a pool with a collapsed subprocess\n+    var poolWithSubprocessXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:subProcess id=\"SubProcess_1\" name=\"Collapsed SubProcess\">\n+      <bpmn:incoming>Flow_1</bpmn:incoming>\n+      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n+      <bpmn:startEvent id=\"StartEvent_2\">\n+        <bpmn:outgoing>Flow_3</bpmn:outgoing>\n+      </bpmn:startEvent>\n+      <bpmn:task id=\"Task_1\" name=\"Task\">\n+        <bpmn:incoming>Flow_3</bpmn:incoming>\n+        <bpmn:outgoing>Flow_4</bpmn:outgoing>\n+      </bpmn:task>\n+      <bpmn:endEvent id=\"EndEvent_2\">\n+        <bpmn:incoming>Flow_4</bpmn:incoming>\n+      </bpmn:endEvent>\n+      <bpmn:sequenceFlow id=\"Flow_3\" sourceRef=\"StartEvent_2\" targetRef=\"Task_1\" />\n+      <bpmn:sequenceFlow id=\"Flow_4\" sourceRef=\"Task_1\" targetRef=\"EndEvent_2\" />\n+    </bpmn:subProcess>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>Flow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"SubProcess_1\" />\n+    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"SubProcess_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"SubProcess_1_di\" bpmnElement=\"SubProcess_1\" isExpanded=\"false\">\n+        <dc:Bounds x=\"300\" y=\"160\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"182\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_1_di\" bpmnElement=\"Flow_1\">\n+        <di:waypoint x=\"248\" y=\"200\" />\n+        <di:waypoint x=\"300\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_2_di\" bpmnElement=\"Flow_2\">\n+        <di:waypoint x=\"400\" y=\"200\" />\n+        <di:waypoint x=\"452\" y=\"200\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+    <bpmndi:BPMNPlane id=\"SubProcess_1_plane\" bpmnElement=\"SubProcess_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_2_di\" bpmnElement=\"StartEvent_2\">\n+        <dc:Bounds x=\"180\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"138\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_2_di\" bpmnElement=\"EndEvent_2\">\n+        <dc:Bounds x=\"422\" y=\"160\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_3_di\" bpmnElement=\"Flow_3\">\n+        <di:waypoint x=\"216\" y=\"178\" />\n+        <di:waypoint x=\"270\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_4_di\" bpmnElement=\"Flow_4\">\n+        <di:waypoint x=\"370\" y=\"178\" />\n+        <di:waypoint x=\"422\" y=\"178\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function updateStatus(message, isError = false) {\n+      statusDiv.textContent = message;\n+      statusDiv.className = 'status ' + (isError ? 'error' : 'success');\n+    }\n+\n+    function loadDiagram() {\n+      try {\n+        modeler = new BpmnJS({\n+          container: '#canvas'\n+        });\n+\n+        modeler.importXML(poolWithSubprocessXML).then(function() {\n+          updateStatus('\u2713 Diagram loaded successfully. Root: ' + modeler.get('canvas').getRootElement().id);\n+        }).catch(function(err) {\n+          updateStatus('\u2717 Failed to load diagram: ' + err.message, true);\n+        });\n+      } catch (err) {\n+        updateStatus('\u2717 Error creating modeler: ' + err.message, true);\n+      }\n+    }\n+\n+    function drillIntoSubprocess() {\n+      if (!modeler) {\n+        updateStatus('\u2717 Load diagram first', true);\n+        return;\n+      }\n+\n+      try {\n+        var canvas = modeler.get('canvas');\n+        var subProcessRoot = canvas.findRoot('SubProcess_1_plane');\n+        \n+        if (subProcessRoot) {\n+          canvas.setRootElement(subProcessRoot);\n+          updateStatus('\u2713 Drilled into subprocess. Current root: ' + canvas.getRootElement().id);\n+        } else {\n+          updateStatus('\u2717 Subprocess plane not found', true);\n+        }\n+      } catch (err) {\n+        updateStatus('\u2717 Error drilling into subprocess: ' + err.message, true);\n+      }\n+    }\n+\n+    function drillOutViaCode() {\n+      if (!modeler) {\n+        updateStatus('\u2717 Load diagram first', true);\n+        return;\n+      }\n+\n+      try {\n+        var canvas = modeler.get('canvas');\n+        var collaborationRoot = canvas.findRoot('Collaboration_1');\n+        \n+        if (collaborationRoot) {\n+          canvas.setRootElement(collaborationRoot);\n+          updateStatus('\u2713 Drilled out to collaboration. Current root: ' + canvas.getRootElement().id);\n+        } else {\n+          updateStatus('\u2717 Collaboration root not found', true);\n+        }\n+      } catch (err) {\n+        updateStatus('\u2717 Error drilling out: ' + err.message, true);\n+      }\n+    }\n+\n+    function testBreadcrumbClick() {\n+      if (!modeler) {\n+        updateStatus('\u2717 Load diagram first', true);\n+        return;\n+      }\n+\n+      try {\n+        var canvas = modeler.get('canvas');\n+        var currentRoot = canvas.getRootElement();\n+        \n+        // Make sure we're in subprocess view\n+        if (currentRoot.id !== 'SubProcess_1_plane') {\n+          drillIntoSubprocess();\n+          // Wait a bit for the UI to update\n+          setTimeout(function() {\n+            performBreadcrumbTest();\n+          }, 100);\n+        } else {\n+          performBreadcrumbTest();\n+        }\n+      } catch (err) {\n+        updateStatus('\u2717 Error setting up breadcrumb test: ' + err.message, true);\n+      }\n+    }\n+\n+    function performBreadcrumbTest() {\n+      try {\n+        var canvas = modeler.get('canvas');\n+        var breadcrumbs = canvas.getContainer().querySelector('.bjs-breadcrumbs');\n+        \n+        if (!breadcrumbs) {\n+          updateStatus('\u2717 Breadcrumbs not found', true);\n+          return;\n+        }\n+\n+        var firstBreadcrumb = breadcrumbs.children[0];\n+        if (!firstBreadcrumb) {\n+          updateStatus('\u2717 First breadcrumb not found', true);\n+          return;\n+        }\n+\n+        updateStatus('Testing breadcrumb click...');\n+        \n+        // This is the critical test - clicking the breadcrumb should not throw an error\n+        firstBreadcrumb.click();\n+        \n+        var newRoot = canvas.getRootElement();\n+        updateStatus('\u2713 Breadcrumb click successful! New root: ' + newRoot.id);\n+        \n+      } catch (err) {\n+        updateStatus('\u2717 Breadcrumb click failed: ' + err.message, true);\n+      }\n+    }\n+\n+    // Auto-load on page load\n+    window.onload = function() {\n+      loadDiagram();\n+    };\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

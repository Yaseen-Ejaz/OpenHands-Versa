{"instance_id": "openlayers__openlayers-14619", "model_patch": "diff --git a/detailed_test.html b/detailed_test.html\nnew file mode 100644\nindex 000000000..2896d09eb\n--- /dev/null\n+++ b/detailed_test.html\n@@ -0,0 +1,83 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Detailed Icon Clone Scale Test</title>\n+</head>\n+<body>\n+    <h1>Detailed Icon Clone Scale Test</h1>\n+    <div id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        const results = document.getElementById('results');\n+        \n+        function log(message) {\n+            const div = document.createElement('div');\n+            div.textContent = message;\n+            results.appendChild(div);\n+        }\n+\n+        // Use a 3x4 pixel image like in the tests\n+        const img = 'data:image/gif;base64,R0lGODlhAwAEAIABAP7+/vDy9SH+EUNyZWF0ZWQgd2l0aCBHSU1QACH5BAEKAAEALAAAAAADAAQAAAIDhI9VADs=';\n+        \n+        // Test 1: Icon created with width/height (should have array scale)\n+        log('=== Test 1: Icon with width/height ===');\n+        const iconWithSize = new Icon({\n+            src: img,\n+            width: 6,\n+            height: 12\n+        });\n+        \n+        iconWithSize.load();\n+        iconWithSize.iconImage_.addEventListener('change', function() {\n+            log('Original scale: ' + JSON.stringify(iconWithSize.getScale()));\n+            log('Original scale is array: ' + Array.isArray(iconWithSize.getScale()));\n+            \n+            const cloned1 = iconWithSize.clone();\n+            log('Cloned scale: ' + JSON.stringify(cloned1.getScale()));\n+            log('Cloned scale is array: ' + Array.isArray(cloned1.getScale()));\n+            \n+            if (Array.isArray(iconWithSize.getScale()) === Array.isArray(cloned1.getScale())) {\n+                log('\u2705 Test 1 passed: Scale types consistent');\n+            } else {\n+                log('\u274c Test 1 failed: Scale types inconsistent');\n+            }\n+            \n+            // Test 2: Icon with setScale after creation\n+            log('\\n=== Test 2: setScale after creation ===');\n+            const iconSetScale = new Icon({ src: img });\n+            \n+            iconSetScale.load();\n+            iconSetScale.iconImage_.addEventListener('change', function() {\n+                log('Before setScale: ' + JSON.stringify(iconSetScale.getScale()));\n+                log('Before setScale is array: ' + Array.isArray(iconSetScale.getScale()));\n+                \n+                // Call setScale with a number\n+                iconSetScale.setScale(2);\n+                \n+                log('After setScale(2): ' + JSON.stringify(iconSetScale.getScale()));\n+                log('After setScale is array: ' + Array.isArray(iconSetScale.getScale()));\n+                log('Width after setScale: ' + iconSetScale.getWidth());\n+                log('Height after setScale: ' + iconSetScale.getHeight());\n+                \n+                // Now clone it\n+                const cloned2 = iconSetScale.clone();\n+                \n+                log('Cloned scale: ' + JSON.stringify(cloned2.getScale()));\n+                log('Cloned scale is array: ' + Array.isArray(cloned2.getScale()));\n+                log('Cloned width: ' + cloned2.getWidth());\n+                log('Cloned height: ' + cloned2.getHeight());\n+                \n+                if (Array.isArray(iconSetScale.getScale()) === Array.isArray(cloned2.getScale())) {\n+                    log('\u2705 Test 2 passed: Scale types consistent');\n+                } else {\n+                    log('\u274c Test 2 failed: Scale types inconsistent');\n+                    log('Original type: ' + typeof iconSetScale.getScale() + ', is array: ' + Array.isArray(iconSetScale.getScale()));\n+                    log('Cloned type: ' + typeof cloned2.getScale() + ', is array: ' + Array.isArray(cloned2.getScale()));\n+                }\n+            });\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..1f654cf37\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,54 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /test_icon_clone_scale.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/style/Icon.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/ImageState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/style/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/color.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/asserts.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/events/EventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/util.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/size.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/AssertionError.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/math.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/events/Target.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/style/IconImageCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/dom.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/Disposable.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/obj.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/functions.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/has.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/events/Event.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/extent.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/events.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/array.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:57:57] \"GET /src/ol/extent/Relationship.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /simple_test.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/style/Icon.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/ImageState.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/color.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/asserts.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/events/EventType.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/style/Image.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/util.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/events/Target.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/style/IconImageCache.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/Image.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/dom.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/size.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/math.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/AssertionError.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/events/Event.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/Disposable.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/functions.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/ImageBase.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/obj.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/has.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/extent.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/events.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/array.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:16] \"GET /src/ol/extent/Relationship.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [06/Mar/2026 06:00:38] \"GET /detailed_test.html HTTP/1.1\" 200 -\ndiff --git a/simple_test.html b/simple_test.html\nnew file mode 100644\nindex 000000000..ee491b1ca\n--- /dev/null\n+++ b/simple_test.html\n@@ -0,0 +1,65 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Icon Clone Scale Test</title>\n+</head>\n+<body>\n+    <h1>Simple Icon Clone Scale Test</h1>\n+    <div id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        const results = document.getElementById('results');\n+        \n+        function log(message) {\n+            const div = document.createElement('div');\n+            div.textContent = message;\n+            results.appendChild(div);\n+        }\n+\n+        // Test the issue: setScale with number, then clone\n+        const src = 'data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACkQBADs=';\n+        \n+        const icon = new Icon({ src: src });\n+        \n+        icon.load();\n+        icon.iconImage_.addEventListener('change', function() {\n+            log('=== Before setScale ===');\n+            log('Scale: ' + JSON.stringify(icon.getScale()));\n+            log('Width: ' + icon.getWidth());\n+            log('Height: ' + icon.getHeight());\n+            \n+            // This is the key: setScale with a NUMBER\n+            icon.setScale(2);\n+            \n+            log('=== After setScale(2) ===');\n+            log('Scale: ' + JSON.stringify(icon.getScale()));\n+            log('Scale type: ' + typeof icon.getScale());\n+            log('Scale is array: ' + Array.isArray(icon.getScale()));\n+            log('Width: ' + icon.getWidth());\n+            log('Height: ' + icon.getHeight());\n+            \n+            // Now clone it\n+            const cloned = icon.clone();\n+            \n+            log('=== Cloned Icon ===');\n+            log('Scale: ' + JSON.stringify(cloned.getScale()));\n+            log('Scale type: ' + typeof cloned.getScale());\n+            log('Scale is array: ' + Array.isArray(cloned.getScale()));\n+            log('Width: ' + cloned.getWidth());\n+            log('Height: ' + cloned.getHeight());\n+            \n+            // Check the issue\n+            const originalIsArray = Array.isArray(icon.getScale());\n+            const clonedIsArray = Array.isArray(cloned.getScale());\n+            \n+            if (originalIsArray !== clonedIsArray) {\n+                log('\u274c BUG REPRODUCED: Original and cloned scale types differ!');\n+            } else {\n+                log('\u2705 Scale types are consistent');\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_icon_clone_scale.html b/test_icon_clone_scale.html\nnew file mode 100644\nindex 000000000..23c860600\n--- /dev/null\n+++ b/test_icon_clone_scale.html\n@@ -0,0 +1,137 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Icon Clone Scale Issue Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-result { margin: 10px 0; padding: 10px; border-radius: 5px; }\n+        .pass { background-color: #d4edda; border: 1px solid #c3e6cb; }\n+        .fail { background-color: #f8d7da; border: 1px solid #f5c6cb; }\n+        .info { background-color: #d1ecf1; border: 1px solid #bee5eb; }\n+        pre { background: #f8f9fa; padding: 10px; border-radius: 3px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Icon Clone Scale Issue Test</h1>\n+    <div id=\"results\"></div>\n+\n+    <script type=\"module\">\n+        import Icon from './src/ol/style/Icon.js';\n+\n+        const results = document.getElementById('results');\n+        \n+        function addResult(message, type = 'info') {\n+            const div = document.createElement('div');\n+            div.className = `test-result ${type}`;\n+            div.innerHTML = message;\n+            results.appendChild(div);\n+        }\n+\n+        function runTest() {\n+            addResult('<h2>Testing Icon Clone Scale Issue</h2>');\n+            \n+            // Test data - a simple 1x1 pixel white GIF\n+            const src = 'data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACwAAAAAAQABAAACAkQBADs=';\n+\n+            // Test 1: Create an Icon with number scale and clone it\n+            addResult('<h3>Test 1: Icon with number scale</h3>');\n+            \n+            const originalIcon = new Icon({\n+                src: src,\n+                scale: 2  // This is a NUMBER\n+            });\n+\n+            addResult(`Original icon scale: ${originalIcon.getScale()}`);\n+            addResult(`Original icon scale type: ${typeof originalIcon.getScale()}`);\n+            addResult(`Original icon scale is array: ${Array.isArray(originalIcon.getScale())}`);\n+\n+            // Wait for image to load, then test cloning\n+            originalIcon.load();\n+            originalIcon.iconImage_.addEventListener('change', function() {\n+                addResult('<h4>After image loaded:</h4>');\n+                addResult(`Original icon scale: ${originalIcon.getScale()}`);\n+                addResult(`Original icon scale type: ${typeof originalIcon.getScale()}`);\n+                addResult(`Original icon scale is array: ${Array.isArray(originalIcon.getScale())}`);\n+                \n+                // Now clone the icon\n+                const clonedIcon = originalIcon.clone();\n+                \n+                addResult('<h4>Cloned icon:</h4>');\n+                addResult(`Cloned icon scale: ${JSON.stringify(clonedIcon.getScale())}`);\n+                addResult(`Cloned icon scale type: ${typeof clonedIcon.getScale()}`);\n+                addResult(`Cloned icon scale is array: ${Array.isArray(clonedIcon.getScale())}`);\n+                \n+                // Check if they are equal\n+                const originalScale = originalIcon.getScale();\n+                const clonedScale = clonedIcon.getScale();\n+                \n+                addResult(`Are scales equal? ${originalScale === clonedScale}`);\n+                addResult(`Are scale types equal? ${typeof originalScale === typeof clonedScale}`);\n+                \n+                if (Array.isArray(originalScale) !== Array.isArray(clonedScale)) {\n+                    addResult('\u274c BUG REPRODUCED: Scale data types are different!', 'fail');\n+                    addResult(`Original is array: ${Array.isArray(originalScale)}`, 'fail');\n+                    addResult(`Cloned is array: ${Array.isArray(clonedScale)}`, 'fail');\n+                } else {\n+                    addResult('\u2705 Scale data types are consistent', 'pass');\n+                }\n+                \n+                // Test 2: Test setScale with number then clone\n+                addResult('<h3>Test 2: setScale with number then clone</h3>');\n+                const testIcon = new Icon({\n+                    src: src\n+                });\n+                \n+                testIcon.load();\n+                testIcon.iconImage_.addEventListener('change', function() {\n+                    // Set scale as number\n+                    testIcon.setScale(1.5);\n+                    addResult('<h4>After setScale(1.5):</h4>');\n+                    addResult(`Scale: ${testIcon.getScale()}`);\n+                    addResult(`Scale type: ${typeof testIcon.getScale()}`);\n+                    addResult(`Scale is array: ${Array.isArray(testIcon.getScale())}`);\n+                    \n+                    // Clone it\n+                    const clonedTestIcon = testIcon.clone();\n+                    addResult('<h4>Cloned after setScale:</h4>');\n+                    addResult(`Scale: ${JSON.stringify(clonedTestIcon.getScale())}`);\n+                    addResult(`Scale type: ${typeof clonedTestIcon.getScale()}`);\n+                    addResult(`Scale is array: ${Array.isArray(clonedTestIcon.getScale())}`);\n+                    \n+                    if (Array.isArray(testIcon.getScale()) !== Array.isArray(clonedTestIcon.getScale())) {\n+                        addResult('\u274c BUG REPRODUCED: setScale number -> clone produces array!', 'fail');\n+                    } else {\n+                        addResult('\u2705 setScale number -> clone preserves type', 'pass');\n+                    }\n+\n+                    // Test 3: Test with array scale to ensure it still works\n+                    addResult('<h3>Test 3: Icon with array scale</h3>');\n+                    const originalIconArray = new Icon({\n+                        src: src,\n+                        scale: [2, 3]  // This is an ARRAY\n+                    });\n+                    \n+                    originalIconArray.load();\n+                    originalIconArray.iconImage_.addEventListener('change', function() {\n+                        addResult(`Original array icon scale: ${JSON.stringify(originalIconArray.getScale())}`);\n+                        addResult(`Original array icon scale is array: ${Array.isArray(originalIconArray.getScale())}`);\n+                        \n+                        const clonedIconArray = originalIconArray.clone();\n+                        addResult(`Cloned array icon scale: ${JSON.stringify(clonedIconArray.getScale())}`);\n+                        addResult(`Cloned array icon scale is array: ${Array.isArray(clonedIconArray.getScale())}`);\n+                        \n+                        if (Array.isArray(originalIconArray.getScale()) === Array.isArray(clonedIconArray.getScale())) {\n+                            addResult('\u2705 Array scale types are consistent', 'pass');\n+                        } else {\n+                            addResult('\u274c Array scale types are inconsistent', 'fail');\n+                        }\n+                    });\n+                });\n+            });\n+        }\n+\n+        // Run the test\n+        runTest();\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_icon_clone_scale_issue.js b/test_icon_clone_scale_issue.js\nnew file mode 100644\nindex 000000000..a76001887\n--- /dev/null\n+++ b/test_icon_clone_scale_issue.js\n@@ -0,0 +1,106 @@\n+/**\n+ * Test to reproduce the Icon clone scale issue\n+ * This test demonstrates the problem where cloning an Icon with a number scale\n+ * results in an array scale in the cloned icon.\n+ */\n+\n+import Icon from './src/ol/style/Icon.js';\n+\n+// Test data - a simple 1x1 pixel white GIF\n+const src = 'data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACwAAAAAAQABAAACAkQBADs=';\n+\n+console.log('=== Testing Icon Clone Scale Issue ===\\n');\n+\n+// Test 1: Create an Icon with number scale and clone it\n+console.log('Test 1: Icon with number scale');\n+const originalIcon = new Icon({\n+  src: src,\n+  scale: 2  // This is a NUMBER\n+});\n+\n+console.log('Original icon scale:', originalIcon.getScale());\n+console.log('Original icon scale type:', typeof originalIcon.getScale());\n+console.log('Original icon scale is array:', Array.isArray(originalIcon.getScale()));\n+\n+// Wait for image to load, then set scale and clone\n+originalIcon.load();\n+originalIcon.iconImage_.addEventListener('change', function() {\n+  console.log('\\nAfter image loaded:');\n+  console.log('Original icon scale:', originalIcon.getScale());\n+  console.log('Original icon scale type:', typeof originalIcon.getScale());\n+  console.log('Original icon scale is array:', Array.isArray(originalIcon.getScale()));\n+  \n+  // Now clone the icon\n+  const clonedIcon = originalIcon.clone();\n+  \n+  console.log('\\nCloned icon scale:', clonedIcon.getScale());\n+  console.log('Cloned icon scale type:', typeof clonedIcon.getScale());\n+  console.log('Cloned icon scale is array:', Array.isArray(clonedIcon.getScale()));\n+  \n+  // Check if they are equal\n+  const originalScale = originalIcon.getScale();\n+  const clonedScale = clonedIcon.getScale();\n+  \n+  console.log('\\nAre scales equal?', originalScale === clonedScale);\n+  console.log('Are scale types equal?', typeof originalScale === typeof clonedScale);\n+  \n+  if (Array.isArray(originalScale) !== Array.isArray(clonedScale)) {\n+    console.log('\u274c BUG REPRODUCED: Scale data types are different!');\n+    console.log('Original is array:', Array.isArray(originalScale));\n+    console.log('Cloned is array:', Array.isArray(clonedScale));\n+  } else {\n+    console.log('\u2705 Scale data types are consistent');\n+  }\n+  \n+  // Test 2: Test with array scale to ensure it still works\n+  console.log('\\n=== Test 2: Icon with array scale ===');\n+  const originalIconArray = new Icon({\n+    src: src,\n+    scale: [2, 3]  // This is an ARRAY\n+  });\n+  \n+  originalIconArray.load();\n+  originalIconArray.iconImage_.addEventListener('change', function() {\n+    console.log('Original array icon scale:', originalIconArray.getScale());\n+    console.log('Original array icon scale is array:', Array.isArray(originalIconArray.getScale()));\n+    \n+    const clonedIconArray = originalIconArray.clone();\n+    console.log('Cloned array icon scale:', clonedIconArray.getScale());\n+    console.log('Cloned array icon scale is array:', Array.isArray(clonedIconArray.getScale()));\n+    \n+    if (Array.isArray(originalIconArray.getScale()) === Array.isArray(clonedIconArray.getScale())) {\n+      console.log('\u2705 Array scale types are consistent');\n+    } else {\n+      console.log('\u274c Array scale types are inconsistent');\n+    }\n+    \n+    // Test 3: Test setScale with number then clone\n+    console.log('\\n=== Test 3: setScale with number then clone ===');\n+    const testIcon = new Icon({\n+      src: src\n+    });\n+    \n+    testIcon.load();\n+    testIcon.iconImage_.addEventListener('change', function() {\n+      // Set scale as number\n+      testIcon.setScale(1.5);\n+      console.log('After setScale(1.5):');\n+      console.log('Scale:', testIcon.getScale());\n+      console.log('Scale type:', typeof testIcon.getScale());\n+      console.log('Scale is array:', Array.isArray(testIcon.getScale()));\n+      \n+      // Clone it\n+      const clonedTestIcon = testIcon.clone();\n+      console.log('\\nCloned after setScale:');\n+      console.log('Scale:', clonedTestIcon.getScale());\n+      console.log('Scale type:', typeof clonedTestIcon.getScale());\n+      console.log('Scale is array:', Array.isArray(clonedTestIcon.getScale()));\n+      \n+      if (Array.isArray(testIcon.getScale()) !== Array.isArray(clonedTestIcon.getScale())) {\n+        console.log('\u274c BUG REPRODUCED: setScale number -> clone produces array!');\n+      } else {\n+        console.log('\u2705 setScale number -> clone preserves type');\n+      }\n+    });\n+  });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

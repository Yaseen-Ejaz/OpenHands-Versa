{"instance_id": "bpmn-io__bpmn-js-1196", "model_patch": "diff --git a/lib/features/copy-paste/BpmnCopyPaste.js b/lib/features/copy-paste/BpmnCopyPaste.js\nindex 0060df80..d9c78ad5 100644\n--- a/lib/features/copy-paste/BpmnCopyPaste.js\n+++ b/lib/features/copy-paste/BpmnCopyPaste.js\n@@ -68,6 +68,11 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n     if (businessObject.default) {\n       descriptor.default = businessObject.default.id;\n     }\n+\n+    // boundary event attachment\n+    if (businessObject.attachedToRef) {\n+      descriptor.attachedToRef = businessObject.attachedToRef.id;\n+    }\n   });\n \n   eventBus.on('moddleCopy.canCopyProperty', function(context) {\n@@ -80,6 +85,12 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n       propertyName === 'processRef') {\n       return bpmnFactory.create('bpmn:Process');\n     }\n+\n+    // handle attachedToRef for boundary events - don't copy the reference directly\n+    // it will be resolved later in the reference resolution phase\n+    if (propertyName === 'attachedToRef') {\n+      return false;\n+    }\n   });\n \n   var references;\n@@ -95,6 +106,14 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n       };\n     }\n \n+    // boundary event attachments\n+    if (descriptor.attachedToRef) {\n+      references[ descriptor.attachedToRef ] = {\n+        element: businessObject,\n+        property: 'attachedToRef'\n+      };\n+    }\n+\n     references = omit(references, reduce(references, function(array, reference, key) {\n       var element = reference.element,\n           property = reference.property;\n@@ -141,7 +160,11 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n       'name'\n     ]);\n \n-    removeProperties(descriptor, 'oldBusinessObject');\n+    removeProperties(descriptor, [\n+      'oldBusinessObject',\n+      'default',\n+      'attachedToRef'\n+    ]);\n   });\n \n }\ndiff --git a/reproduce_issue.js b/reproduce_issue.js\nnew file mode 100644\nindex 00000000..1853d966\n--- /dev/null\n+++ b/reproduce_issue.js\n@@ -0,0 +1,90 @@\n+/**\n+ * Simple reproduction script for boundary event attachment issue\n+ */\n+\n+const BpmnModeler = require('./lib/Modeler');\n+\n+const testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:boundaryEvent>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"182\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function reproduceIssue() {\n+  const modeler = new BpmnModeler();\n+  \n+  try {\n+    await modeler.importXML(testXML);\n+    \n+    const elementRegistry = modeler.get('elementRegistry');\n+    const copyPaste = modeler.get('copyPaste');\n+    const canvas = modeler.get('canvas');\n+    \n+    const task = elementRegistry.get('Task_1');\n+    const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+    const rootElement = canvas.getRootElement();\n+    \n+    console.log('=== BEFORE COPY ===');\n+    console.log('Task ID:', task.id);\n+    console.log('Boundary Event ID:', boundaryEvent.id);\n+    console.log('Task attachers:', task.attachers ? task.attachers.map(a => a.id) : 'none');\n+    console.log('Boundary Event attachedToRef:', boundaryEvent.businessObject.attachedToRef.id);\n+    \n+    // Copy both elements\n+    copyPaste.copy([task, boundaryEvent]);\n+    \n+    // Paste them\n+    const pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: { x: 300, y: 300 }\n+    });\n+    \n+    console.log('\\n=== AFTER PASTE ===');\n+    console.log('Pasted elements:', pastedElements.map(e => `${e.type}:${e.id}`));\n+    \n+    const pastedTask = pastedElements.find(e => e.type === 'bpmn:Task');\n+    const pastedBoundaryEvent = pastedElements.find(e => e.type === 'bpmn:BoundaryEvent');\n+    \n+    if (pastedTask) {\n+      console.log('Pasted Task ID:', pastedTask.id);\n+      console.log('Pasted Task attachers:', pastedTask.attachers ? pastedTask.attachers.map(a => a.id) : 'none');\n+    }\n+    \n+    if (pastedBoundaryEvent) {\n+      console.log('Pasted Boundary Event ID:', pastedBoundaryEvent.id);\n+      console.log('Pasted Boundary Event attachedToRef:', \n+        pastedBoundaryEvent.businessObject.attachedToRef ? \n+        pastedBoundaryEvent.businessObject.attachedToRef.id : 'null');\n+    }\n+    \n+    // Check if the issue exists\n+    const isAttached = pastedTask && pastedTask.attachers && pastedTask.attachers.length > 0;\n+    const hasCorrectRef = pastedBoundaryEvent && \n+      pastedBoundaryEvent.businessObject.attachedToRef && \n+      pastedBoundaryEvent.businessObject.attachedToRef === pastedTask.businessObject;\n+    \n+    console.log('\\n=== ISSUE ANALYSIS ===');\n+    console.log('Is boundary event attached to task?', isAttached);\n+    console.log('Does boundary event reference correct task?', hasCorrectRef);\n+    console.log('ISSUE EXISTS:', !isAttached || !hasCorrectRef);\n+    \n+  } catch (error) {\n+    console.error('Error:', error);\n+  }\n+}\n+\n+reproduceIssue();\n\\ No newline at end of file\ndiff --git a/test_boundary_event_copy.js b/test_boundary_event_copy.js\nnew file mode 100644\nindex 00000000..06441dbd\n--- /dev/null\n+++ b/test_boundary_event_copy.js\n@@ -0,0 +1,110 @@\n+/**\n+ * Test to reproduce the boundary event attachment issue\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+\n+import {\n+  getBusinessObject,\n+  is\n+} from 'lib/util/ModelUtil';\n+\n+describe('Boundary Event Copy Issue Reproduction', function() {\n+\n+  var testModules = [\n+    bpmnCopyPasteModule,\n+    copyPasteModule,\n+    coreModule,\n+    modelingModule\n+  ];\n+\n+  // Simple BPMN with a task and boundary event\n+  var testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:boundaryEvent>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"182\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(testXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should reproduce boundary event attachment issue', inject(function(canvas, copyPaste, elementRegistry) {\n+\n+    // given\n+    var task = elementRegistry.get('Task_1'),\n+        boundaryEvent = elementRegistry.get('BoundaryEvent_1'),\n+        rootElement = canvas.getRootElement();\n+\n+    console.log('Original task:', task.id);\n+    console.log('Original boundary event:', boundaryEvent.id);\n+    console.log('Original boundary event attachedToRef:', getBusinessObject(boundaryEvent).attachedToRef.id);\n+    console.log('Original task attachers:', task.attachers ? task.attachers.map(a => a.id) : 'none');\n+\n+    // when - copy both task and boundary event\n+    copyPaste.copy([task, boundaryEvent]);\n+\n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 300,\n+        y: 300\n+      }\n+    });\n+\n+    // then - check if attachment is preserved\n+    console.log('Pasted elements:', pastedElements.map(e => e.id));\n+\n+    var pastedTask = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:Task');\n+    });\n+\n+    var pastedBoundaryEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:BoundaryEvent');\n+    });\n+\n+    console.log('Pasted task:', pastedTask ? pastedTask.id : 'not found');\n+    console.log('Pasted boundary event:', pastedBoundaryEvent ? pastedBoundaryEvent.id : 'not found');\n+\n+    if (pastedBoundaryEvent) {\n+      var pastedBoundaryEventBo = getBusinessObject(pastedBoundaryEvent);\n+      console.log('Pasted boundary event attachedToRef:', pastedBoundaryEventBo.attachedToRef ? pastedBoundaryEventBo.attachedToRef.id : 'null');\n+    }\n+\n+    if (pastedTask) {\n+      console.log('Pasted task attachers:', pastedTask.attachers ? pastedTask.attachers.map(a => a.id) : 'none');\n+    }\n+\n+    // This should pass but currently fails\n+    expect(pastedTask).to.exist;\n+    expect(pastedBoundaryEvent).to.exist;\n+    \n+    // The key assertion - boundary event should be attached to the copied task\n+    expect(pastedTask.attachers).to.have.length(1);\n+    expect(pastedTask.attachers[0]).to.equal(pastedBoundaryEvent);\n+    expect(getBusinessObject(pastedBoundaryEvent).attachedToRef).to.equal(getBusinessObject(pastedTask));\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_boundary_issue.html b/test_boundary_issue.html\nnew file mode 100644\nindex 00000000..287677c3\n--- /dev/null\n+++ b/test_boundary_issue.html\n@@ -0,0 +1,163 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Boundary Event Copy Issue Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+    button { margin: 5px; padding: 10px; }\n+    .log { background: #f5f5f5; padding: 10px; margin: 10px 0; font-family: monospace; white-space: pre-wrap; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Boundary Event Copy Issue Test</h1>\n+  \n+  <div>\n+    <button onclick=\"loadDiagram()\">Load Diagram</button>\n+    <button onclick=\"copyElements()\">Copy Task + Boundary Event</button>\n+    <button onclick=\"pasteElements()\">Paste Elements</button>\n+    <button onclick=\"analyzeIssue()\">Analyze Issue</button>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <div id=\"log\" class=\"log\">Click \"Load Diagram\" to start...</div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modeler;\n+    let copiedElements = null;\n+    \n+    const testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" attachedToRef=\"Task_1\">\n+      <bpmn:timerEventDefinition />\n+    </bpmn:boundaryEvent>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"182\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function log(message) {\n+      const logDiv = document.getElementById('log');\n+      logDiv.textContent += message + '\\n';\n+      logDiv.scrollTop = logDiv.scrollHeight;\n+    }\n+\n+    async function loadDiagram() {\n+      try {\n+        modeler = new BpmnJS({\n+          container: '#canvas'\n+        });\n+        \n+        await modeler.importXML(testXML);\n+        log('\u2713 Diagram loaded successfully');\n+        \n+        const elementRegistry = modeler.get('elementRegistry');\n+        const task = elementRegistry.get('Task_1');\n+        const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+        \n+        log(`Original Task: ${task.id}`);\n+        log(`Original Boundary Event: ${boundaryEvent.id}`);\n+        log(`Task attachers: ${task.attachers ? task.attachers.map(a => a.id).join(', ') : 'none'}`);\n+        log(`Boundary Event attachedToRef: ${boundaryEvent.businessObject.attachedToRef.id}`);\n+        \n+      } catch (error) {\n+        log('\u2717 Error loading diagram: ' + error.message);\n+      }\n+    }\n+\n+    function copyElements() {\n+      try {\n+        const elementRegistry = modeler.get('elementRegistry');\n+        const copyPaste = modeler.get('copyPaste');\n+        \n+        const task = elementRegistry.get('Task_1');\n+        const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+        \n+        copyPaste.copy([task, boundaryEvent]);\n+        copiedElements = [task, boundaryEvent];\n+        \n+        log('\u2713 Elements copied: Task_1 and BoundaryEvent_1');\n+        \n+      } catch (error) {\n+        log('\u2717 Error copying elements: ' + error.message);\n+      }\n+    }\n+\n+    function pasteElements() {\n+      try {\n+        const copyPaste = modeler.get('copyPaste');\n+        const canvas = modeler.get('canvas');\n+        const rootElement = canvas.getRootElement();\n+        \n+        const pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 300, y: 300 }\n+        });\n+        \n+        log('\u2713 Elements pasted');\n+        log(`Pasted elements: ${pastedElements.map(e => `${e.type}:${e.id}`).join(', ')}`);\n+        \n+      } catch (error) {\n+        log('\u2717 Error pasting elements: ' + error.message);\n+      }\n+    }\n+\n+    function analyzeIssue() {\n+      try {\n+        const elementRegistry = modeler.get('elementRegistry');\n+        const allElements = elementRegistry.getAll();\n+        \n+        log('\\n=== ANALYSIS ===');\n+        \n+        // Find all tasks and boundary events\n+        const tasks = allElements.filter(e => e.type === 'bpmn:Task');\n+        const boundaryEvents = allElements.filter(e => e.type === 'bpmn:BoundaryEvent');\n+        \n+        log(`Found ${tasks.length} tasks and ${boundaryEvents.length} boundary events`);\n+        \n+        tasks.forEach(task => {\n+          log(`Task ${task.id}:`);\n+          log(`  - attachers: ${task.attachers ? task.attachers.map(a => a.id).join(', ') : 'none'}`);\n+        });\n+        \n+        boundaryEvents.forEach(be => {\n+          log(`Boundary Event ${be.id}:`);\n+          log(`  - attachedToRef: ${be.businessObject.attachedToRef ? be.businessObject.attachedToRef.id : 'null'}`);\n+        });\n+        \n+        // Check for the issue\n+        const pastedTasks = tasks.filter(t => t.id !== 'Task_1');\n+        const pastedBoundaryEvents = boundaryEvents.filter(be => be.id !== 'BoundaryEvent_1');\n+        \n+        if (pastedTasks.length > 0 && pastedBoundaryEvents.length > 0) {\n+          const pastedTask = pastedTasks[0];\n+          const pastedBoundaryEvent = pastedBoundaryEvents[0];\n+          \n+          const isAttached = pastedTask.attachers && pastedTask.attachers.length > 0;\n+          const hasCorrectRef = pastedBoundaryEvent.businessObject.attachedToRef === pastedTask.businessObject;\n+          \n+          log('\\n=== ISSUE CHECK ===');\n+          log(`Is boundary event attached to task? ${isAttached}`);\n+          log(`Does boundary event reference correct task? ${hasCorrectRef}`);\n+          log(`ISSUE EXISTS: ${!isAttached || !hasCorrectRef}`);\n+        }\n+        \n+      } catch (error) {\n+        log('\u2717 Error analyzing: ' + error.message);\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

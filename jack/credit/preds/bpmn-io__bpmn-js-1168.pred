{"instance_id": "bpmn-io__bpmn-js-1168", "model_patch": "diff --git a/lib/features/label-editing/LabelEditingProvider.js b/lib/features/label-editing/LabelEditingProvider.js\nindex a1dbfbb7..4e2b938b 100644\n--- a/lib/features/label-editing/LabelEditingProvider.js\n+++ b/lib/features/label-editing/LabelEditingProvider.js\n@@ -72,7 +72,8 @@ export default function LabelEditingProvider(\n \n     var element = event.shape,\n         canExecute = event.context.canExecute,\n-        isTouch = event.isTouch;\n+        isTouch = event.isTouch,\n+        hints = event.context.hints;\n \n     // TODO(nikku): we need to find a way to support the\n     // direct editing on mobile devices; right now this will\n@@ -90,6 +91,11 @@ export default function LabelEditingProvider(\n       return;\n     }\n \n+    // do not activate direct editing for paste operations\n+    if (hints && hints.createElementsBehavior === false) {\n+      return;\n+    }\n+\n     activateDirectEdit(element);\n   });\n \ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..a0569b67\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [06/Mar/2026 05:24:45] \"GET /verify_fix.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [06/Mar/2026 05:24:45] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test_paste_direct_editing.js b/test_paste_direct_editing.js\nnew file mode 100644\nindex 00000000..49dd4d33\n--- /dev/null\n+++ b/test_paste_direct_editing.js\n@@ -0,0 +1,181 @@\n+/**\n+ * Test to reproduce the issue where direct editing is enabled after pasting task elements\n+ */\n+\n+import TestContainer from 'mocha-test-container-support';\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from './test/helper';\n+\n+import {\n+  createCanvasEvent as canvasEvent\n+} from './test/util/MockEvents';\n+\n+import coreModule from './lib/core';\n+import modelingModule from './lib/features/modeling';\n+import copyPasteModule from './lib/features/copy-paste';\n+import labelEditingModule from './lib/features/label-editing';\n+import selectionModule from './lib/features/selection';\n+\n+describe('Paste Direct Editing Issue', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    copyPasteModule,\n+    labelEditingModule,\n+    selectionModule\n+  ];\n+\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"3.0.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Original Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"265\" y=\"99\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"415\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"265\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"365\" y=\"117\" />\n+        <di:waypoint x=\"415\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  describe('issue reproduction', function() {\n+\n+    it('should NOT activate direct editing when pasting task in first position', inject(\n+      function(elementRegistry, copyPaste, directEditing, selection, canvas) {\n+\n+        // given\n+        var task = elementRegistry.get('Task_1');\n+        var startEvent = elementRegistry.get('StartEvent_1');\n+        \n+        // select task and start event (task first)\n+        selection.select([task, startEvent]);\n+        \n+        // copy elements\n+        copyPaste.copy([task, startEvent]);\n+        \n+        // ensure direct editing is not active before paste\n+        expect(directEditing.isActive()).to.be.false;\n+        \n+        // when - paste elements directly at position\n+        var rootElement = canvas.getRootElement();\n+        var pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 500, y: 200 }\n+        });\n+        \n+        // then - direct editing should NOT be activated\n+        expect(directEditing.isActive()).to.be.false;\n+      }\n+    ));\n+\n+    it('should NOT activate direct editing when pasting task via drag and drop', inject(\n+      function(elementRegistry, copyPaste, directEditing, selection, canvas, create) {\n+\n+        // given\n+        var task = elementRegistry.get('Task_1');\n+        var startEvent = elementRegistry.get('StartEvent_1');\n+        \n+        // select task and start event (task first)\n+        selection.select([task, startEvent]);\n+        \n+        // copy elements\n+        copyPaste.copy([task, startEvent]);\n+        \n+        // ensure direct editing is not active before paste\n+        expect(directEditing.isActive()).to.be.false;\n+        \n+        // when - paste elements via drag and drop simulation\n+        copyPaste.paste(); // This starts the create mode\n+        \n+        // simulate mouse move and end to complete the paste\n+        var rootElement = canvas.getRootElement();\n+        create._eventBus.fire('create.move', canvasEvent({ x: 500, y: 200 }));\n+        create._eventBus.fire('create.end', canvasEvent({ x: 500, y: 200 }));\n+        \n+        // then - direct editing should NOT be activated\n+        expect(directEditing.isActive()).to.be.false;\n+      }\n+    ));\n+\n+    it('should activate direct editing when creating new task normally', inject(\n+      function(elementFactory, modeling, directEditing, canvas) {\n+\n+        // given\n+        var rootElement = canvas.getRootElement();\n+        var taskShape = elementFactory.createShape({ type: 'bpmn:Task' });\n+        \n+        // ensure direct editing is not active before creation\n+        expect(directEditing.isActive()).to.be.false;\n+        \n+        // when - create new task normally (not via paste)\n+        modeling.createShape(taskShape, { x: 600, y: 300 }, rootElement);\n+        \n+        // then - direct editing SHOULD be activated for normal creation\n+        expect(directEditing.isActive()).to.be.true;\n+      }\n+    ));\n+\n+    it('should NOT activate direct editing when pasting non-task elements', inject(\n+      function(elementRegistry, copyPaste, directEditing, selection, canvas) {\n+\n+        // given\n+        var startEvent = elementRegistry.get('StartEvent_1');\n+        \n+        // select start event\n+        selection.select([startEvent]);\n+        \n+        // copy element\n+        copyPaste.copy([startEvent]);\n+        \n+        // ensure direct editing is not active before paste\n+        expect(directEditing.isActive()).to.be.false;\n+        \n+        // when - paste start event\n+        var rootElement = canvas.getRootElement();\n+        copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 500, y: 300 }\n+        });\n+        \n+        // then - direct editing should NOT be activated\n+        expect(directEditing.isActive()).to.be.false;\n+      }\n+    ));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/verify_fix.html b/verify_fix.html\nnew file mode 100644\nindex 00000000..0a492702\n--- /dev/null\n+++ b/verify_fix.html\n@@ -0,0 +1,169 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Verify Paste Direct Editing Fix</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; width: 800px; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .status { margin: 10px 0; padding: 10px; border-radius: 4px; }\n+        .success { background-color: #d4edda; color: #155724; }\n+        .error { background-color: #f8d7da; color: #721c24; }\n+        .info { background-color: #d1ecf1; color: #0c5460; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Paste Direct Editing Fix Verification</h1>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"createTask()\">Create New Task (should activate direct editing)</button>\n+        <button onclick=\"copyTask()\">Copy Task</button>\n+        <button onclick=\"pasteTask()\">Paste Task (should NOT activate direct editing)</button>\n+        <button onclick=\"checkDirectEditing()\">Check Direct Editing Status</button>\n+    </div>\n+    \n+    <div id=\"status\" class=\"status info\">Ready to test...</div>\n+    \n+    <div id=\"canvas\"></div>\n+\n+    <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        var modeler;\n+        var copiedElements = null;\n+\n+        // Initialize BPMN modeler\n+        var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"265\" y=\"99\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"265\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        modeler = new BpmnJS({\n+            container: '#canvas'\n+        });\n+\n+        modeler.importXML(xml).then(function() {\n+            updateStatus('BPMN diagram loaded successfully', 'success');\n+        }).catch(function(err) {\n+            updateStatus('Error loading BPMN diagram: ' + err.message, 'error');\n+        });\n+\n+        function updateStatus(message, type) {\n+            var statusEl = document.getElementById('status');\n+            statusEl.textContent = message;\n+            statusEl.className = 'status ' + type;\n+        }\n+\n+        function createTask() {\n+            try {\n+                var elementFactory = modeler.get('elementFactory');\n+                var modeling = modeler.get('modeling');\n+                var canvas = modeler.get('canvas');\n+                var directEditing = modeler.get('directEditing');\n+\n+                var rootElement = canvas.getRootElement();\n+                var taskShape = elementFactory.createShape({ type: 'bpmn:Task' });\n+\n+                // Create task at position\n+                modeling.createShape(taskShape, { x: 400, y: 250 }, rootElement);\n+\n+                setTimeout(function() {\n+                    if (directEditing.isActive()) {\n+                        updateStatus('\u2713 PASS: Direct editing activated for new task creation (expected behavior)', 'success');\n+                    } else {\n+                        updateStatus('\u2717 FAIL: Direct editing NOT activated for new task creation (unexpected)', 'error');\n+                    }\n+                }, 100);\n+\n+            } catch (err) {\n+                updateStatus('Error creating task: ' + err.message, 'error');\n+            }\n+        }\n+\n+        function copyTask() {\n+            try {\n+                var elementRegistry = modeler.get('elementRegistry');\n+                var copyPaste = modeler.get('copyPaste');\n+                var selection = modeler.get('selection');\n+\n+                var task = elementRegistry.get('Task_1');\n+                if (!task) {\n+                    updateStatus('Task not found for copying', 'error');\n+                    return;\n+                }\n+\n+                selection.select([task]);\n+                copiedElements = copyPaste.copy([task]);\n+                updateStatus('Task copied successfully', 'info');\n+\n+            } catch (err) {\n+                updateStatus('Error copying task: ' + err.message, 'error');\n+            }\n+        }\n+\n+        function pasteTask() {\n+            try {\n+                if (!copiedElements) {\n+                    updateStatus('No elements copied. Please copy a task first.', 'error');\n+                    return;\n+                }\n+\n+                var copyPaste = modeler.get('copyPaste');\n+                var canvas = modeler.get('canvas');\n+                var directEditing = modeler.get('directEditing');\n+\n+                var rootElement = canvas.getRootElement();\n+\n+                // Paste task at new position\n+                copyPaste.paste({\n+                    element: rootElement,\n+                    point: { x: 500, y: 300 }\n+                });\n+\n+                setTimeout(function() {\n+                    if (directEditing.isActive()) {\n+                        updateStatus('\u2717 FAIL: Direct editing activated after paste (this is the bug!)', 'error');\n+                    } else {\n+                        updateStatus('\u2713 PASS: Direct editing NOT activated after paste (bug fixed!)', 'success');\n+                    }\n+                }, 100);\n+\n+            } catch (err) {\n+                updateStatus('Error pasting task: ' + err.message, 'error');\n+            }\n+        }\n+\n+        function checkDirectEditing() {\n+            try {\n+                var directEditing = modeler.get('directEditing');\n+                var isActive = directEditing.isActive();\n+                updateStatus('Direct editing is currently: ' + (isActive ? 'ACTIVE' : 'INACTIVE'), 'info');\n+            } catch (err) {\n+                updateStatus('Error checking direct editing: ' + err.message, 'error');\n+            }\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

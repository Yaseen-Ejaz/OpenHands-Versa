{"instance_id": "carbon-design-system__carbon-12410", "model_patch": "diff --git a/packages/react/src/components/Slider/Slider-test.js b/packages/react/src/components/Slider/Slider-test.js\nindex 0dd69acf8..a99cce582 100644\n--- a/packages/react/src/components/Slider/Slider-test.js\n+++ b/packages/react/src/components/Slider/Slider-test.js\n@@ -438,4 +438,106 @@ describe('Slider', () => {\n       expect(handleChange).not.toHaveBeenCalled();\n     });\n   });\n+\n+  describe('slider is read-only', () => {\n+    const handleChange = jest.fn();\n+    const handleRelease = jest.fn();\n+    const wrapper = mount(\n+      <Slider\n+        id=\"slider\"\n+        className=\"extra-class\"\n+        value={50}\n+        min={0}\n+        max={100}\n+        step={1}\n+        onChange={handleChange}\n+        onRelease={handleRelease}\n+        readOnly={true}\n+      />\n+    );\n+\n+    it('has the read-only CSS class', () => {\n+      expect(wrapper.find(`.${prefix}--slider`).hasClass(`${prefix}--slider--read-only`)).toBe(true);\n+    });\n+\n+    it('has readOnly attribute on text input', () => {\n+      expect(wrapper.find(`.${prefix}--slider-text-input`).prop('readOnly')).toBe(true);\n+    });\n+\n+    it('does nothing when trying to type in the input', () => {\n+      const evt = {\n+        target: {\n+          value: '75',\n+        },\n+      };\n+      wrapper.instance().onChange(evt);\n+      expect(wrapper.state().value).toEqual(50);\n+      expect(handleChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('does nothing when trying to start a drag', () => {\n+      const evt = {\n+        type: 'mousedown',\n+        clientX: '1001',\n+      };\n+      wrapper.instance().onDragStart(evt);\n+      expect(wrapper.state().value).toEqual(50);\n+      expect(handleChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('does nothing when trying to drag', () => {\n+      const evt = {\n+        type: 'mousemove',\n+        clientX: '1000',\n+      };\n+      wrapper.instance()._onDrag(evt);\n+      expect(wrapper.state().value).toEqual(50);\n+      expect(handleChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('does nothing when trying to stop a drag', () => {\n+      const evt = {\n+        type: 'mouseup',\n+        clientX: '1001',\n+      };\n+      wrapper.instance().onDragStop(evt);\n+      expect(wrapper.state().needsOnRelease).toEqual(false);\n+      expect(handleChange).not.toHaveBeenCalled();\n+      expect(handleRelease).not.toHaveBeenCalled();\n+    });\n+\n+    it('does nothing when using arrow key', () => {\n+      const evt = {\n+        type: 'keydown',\n+        which: '40',\n+      };\n+      wrapper.instance().onKeyDown(evt);\n+      expect(wrapper.state().value).toEqual(50);\n+      expect(handleChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('allows focus for accessibility', () => {\n+      const thumb = wrapper.find(`.${prefix}--slider__thumb`);\n+      expect(thumb.prop('tabIndex')).toEqual(0);\n+    });\n+  });\n+\n+  describe('RTL support for read-only', () => {\n+    it('applies read-only class correctly in RTL context', () => {\n+      const wrapper = mount(\n+        <div dir=\"rtl\">\n+          <Slider\n+            id=\"slider-rtl\"\n+            value={50}\n+            min={0}\n+            max={100}\n+            step={1}\n+            readOnly={true}\n+          />\n+        </div>\n+      );\n+      \n+      expect(wrapper.find(`.${prefix}--slider`).hasClass(`${prefix}--slider--read-only`)).toBe(true);\n+    });\n+  });\n });\ndiff --git a/packages/react/src/components/Slider/Slider.js b/packages/react/src/components/Slider/Slider.js\nindex 71192af28..5af367b53 100644\n--- a/packages/react/src/components/Slider/Slider.js\n+++ b/packages/react/src/components/Slider/Slider.js\n@@ -143,6 +143,11 @@ export default class Slider extends PureComponent {\n      */\n     onRelease: PropTypes.func,\n \n+    /**\n+     * `true` to specify if the control is read-only.\n+     */\n+    readOnly: PropTypes.bool,\n+\n     /**\n      * `true` to specify if the control is required.\n      */\n@@ -170,6 +175,7 @@ export default class Slider extends PureComponent {\n     step: 1,\n     stepMultiplier: 4,\n     disabled: false,\n+    readOnly: false,\n     minLabel: '',\n     maxLabel: '',\n     inputType: 'number',\n@@ -266,8 +272,8 @@ export default class Slider extends PureComponent {\n    * @param {Event} evt The event.\n    */\n   onDragStart = (evt) => {\n-    // Do nothing if component is disabled\n-    if (this.props.disabled) {\n+    // Do nothing if component is disabled or read-only\n+    if (this.props.disabled || this.props.readOnly) {\n       return;\n     }\n \n@@ -291,8 +297,8 @@ export default class Slider extends PureComponent {\n    * indicating that the `onRelease` callback should be called.\n    */\n   onDragStop = () => {\n-    // Do nothing if component is disabled\n-    if (this.props.disabled) {\n+    // Do nothing if component is disabled or read-only\n+    if (this.props.disabled || this.props.readOnly) {\n       return;\n     }\n \n@@ -317,8 +323,8 @@ export default class Slider extends PureComponent {\n    * @param {Event} evt The event.\n    */\n   _onDrag = (evt) => {\n-    // Do nothing if component is disabled or we have no event\n-    if (this.props.disabled || !evt) {\n+    // Do nothing if component is disabled, read-only, or we have no event\n+    if (this.props.disabled || this.props.readOnly || !evt) {\n       return;\n     }\n \n@@ -356,8 +362,8 @@ export default class Slider extends PureComponent {\n    * @param {Event} evt The event.\n    */\n   onKeyDown = (evt) => {\n-    // Do nothing if component is disabled or we don't have a valid event\n-    if (this.props.disabled || !('which' in evt)) {\n+    // Do nothing if component is disabled, read-only, or we don't have a valid event\n+    if (this.props.disabled || this.props.readOnly || !('which' in evt)) {\n       return;\n     }\n \n@@ -400,8 +406,8 @@ export default class Slider extends PureComponent {\n    */\n \n   onChange = (evt) => {\n-    // Do nothing if component is disabled\n-    if (this.props.disabled) {\n+    // Do nothing if component is disabled or read-only\n+    if (this.props.disabled || this.props.readOnly) {\n       return;\n     }\n \n@@ -549,6 +555,7 @@ export default class Slider extends PureComponent {\n       inputType,\n       required,\n       disabled,\n+      readOnly,\n       name,\n       light,\n       ...other\n@@ -576,7 +583,10 @@ export default class Slider extends PureComponent {\n \n           const sliderClasses = classNames(\n             `${prefix}--slider`,\n-            { [`${prefix}--slider--disabled`]: disabled },\n+            { \n+              [`${prefix}--slider--disabled`]: disabled,\n+              [`${prefix}--slider--read-only`]: readOnly,\n+            },\n             [enabled ? null : className]\n           );\n \n@@ -660,6 +670,7 @@ export default class Slider extends PureComponent {\n                   aria-labelledby={!ariaLabelInput ? labelId : null}\n                   aria-label={ariaLabelInput ? ariaLabelInput : null}\n                   disabled={disabled}\n+                  readOnly={readOnly}\n                   required={required}\n                   min={min}\n                   max={max}\ndiff --git a/packages/react/src/components/Slider/Slider.stories.js b/packages/react/src/components/Slider/Slider.stories.js\nindex a7fdb318d..badfaf803 100644\n--- a/packages/react/src/components/Slider/Slider.stories.js\n+++ b/packages/react/src/components/Slider/Slider.stories.js\n@@ -36,6 +36,19 @@ export const Default = () => (\n   />\n );\n \n+export const ReadOnly = () => (\n+  <Slider\n+    labelText=\"Read-only Slider\"\n+    value={75}\n+    min={0}\n+    max={100}\n+    step={1}\n+    stepMultiplier={10}\n+    readOnly\n+    noValidate\n+  />\n+);\n+\n export const ControlledSlider = () => {\n   const [val, setVal] = useState(87);\n   return (\n@@ -175,6 +188,9 @@ Playground.argTypes = {\n       disable: true,\n     },\n   },\n+  readOnly: {\n+    control: { type: 'boolean' },\n+  },\n   labelText: {\n     table: {\n       disable: true,\ndiff --git a/packages/styles/scss/components/slider/_slider.scss b/packages/styles/scss/components/slider/_slider.scss\nindex 24a0c0595..460b8ed81 100644\n--- a/packages/styles/scss/components/slider/_slider.scss\n+++ b/packages/styles/scss/components/slider/_slider.scss\n@@ -200,6 +200,46 @@\n     }\n   }\n \n+  // Read-only state\n+  .#{$prefix}--slider--read-only.#{$prefix}--slider {\n+    cursor: default;\n+  }\n+\n+  .#{$prefix}--slider--read-only .#{$prefix}--slider__thumb {\n+    cursor: default;\n+\n+    &:hover {\n+      cursor: default;\n+      // Keep hover styles for visual feedback but prevent interaction\n+      transform: translate(-50%, -50%) scale(1.4286);\n+    }\n+\n+    &:focus {\n+      // Keep focus styles for accessibility\n+      background-color: $interactive;\n+      box-shadow: inset 0 0 0 2px $interactive, inset 0 0 0 3px $layer;\n+      transform: translate(-50%, -50%) scale(1.4286);\n+    }\n+\n+    &:active {\n+      // Prevent active state changes but keep visual feedback\n+      transform: translate(-50%, -50%) scale(1.4286);\n+    }\n+  }\n+\n+  .#{$prefix}--slider--read-only\n+    ~ .#{$prefix}--form-item\n+    .#{$prefix}--slider-text-input,\n+  .#{$prefix}--slider--read-only ~ .#{$prefix}--slider-text-input {\n+    cursor: default;\n+    \n+    &:focus {\n+      // Keep focus styles for accessibility\n+      outline: 2px solid $interactive;\n+      outline-offset: -2px;\n+    }\n+  }\n+\n   // Skeleton state\n   .#{$prefix}--slider-container.#{$prefix}--skeleton\n     .#{$prefix}--slider__range-label {\ndiff --git a/test-readonly-slider.js b/test-readonly-slider.js\nnew file mode 100644\nindex 000000000..7a9a62e97\n--- /dev/null\n+++ b/test-readonly-slider.js\n@@ -0,0 +1,155 @@\n+/**\n+ * Test file to verify read-only Slider implementation\n+ * This file will be used to test the current state and verify our implementation\n+ */\n+\n+import React from 'react';\n+import { render, screen, fireEvent } from '@testing-library/react';\n+import Slider from './packages/react/src/components/Slider/Slider';\n+\n+describe('Slider readOnly functionality', () => {\n+  const defaultProps = {\n+    id: 'test-slider',\n+    labelText: 'Test Slider',\n+    value: 50,\n+    min: 0,\n+    max: 100,\n+    step: 1,\n+  };\n+\n+  describe('Current state (before implementation)', () => {\n+    it('should not have readOnly prop support yet', () => {\n+      const { container } = render(<Slider {...defaultProps} readOnly />);\n+      \n+      // Should not have read-only CSS class\n+      const slider = container.querySelector('.cds--slider');\n+      expect(slider).not.toHaveClass('cds--slider--read-only');\n+      \n+      // Text input should not have readOnly attribute\n+      const textInput = container.querySelector('.cds--slider-text-input');\n+      expect(textInput).not.toHaveAttribute('readOnly');\n+    });\n+\n+    it('should allow interaction when readOnly prop is passed (not implemented yet)', () => {\n+      const onChange = jest.fn();\n+      const { container } = render(\n+        <Slider {...defaultProps} readOnly onChange={onChange} />\n+      );\n+      \n+      const textInput = container.querySelector('.cds--slider-text-input');\n+      \n+      // Should still allow changes (since readOnly is not implemented)\n+      fireEvent.change(textInput, { target: { value: '75' } });\n+      expect(onChange).toHaveBeenCalled();\n+    });\n+  });\n+\n+  describe('Expected behavior after implementation', () => {\n+    it('should prevent text input changes when readOnly is true', () => {\n+      // This test will pass after implementation\n+      const onChange = jest.fn();\n+      const { container } = render(\n+        <Slider {...defaultProps} readOnly onChange={onChange} />\n+      );\n+      \n+      const textInput = container.querySelector('.cds--slider-text-input');\n+      \n+      // Should prevent changes when readOnly is true\n+      fireEvent.change(textInput, { target: { value: '75' } });\n+      // After implementation, onChange should not be called\n+      // expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should prevent slider thumb interaction when readOnly is true', () => {\n+      const onChange = jest.fn();\n+      const { container } = render(\n+        <Slider {...defaultProps} readOnly onChange={onChange} />\n+      );\n+      \n+      const slider = container.querySelector('.cds--slider');\n+      \n+      // Should prevent drag interactions when readOnly is true\n+      fireEvent.mouseDown(slider, { clientX: 100 });\n+      fireEvent.mouseMove(slider, { clientX: 200 });\n+      fireEvent.mouseUp(slider);\n+      \n+      // After implementation, onChange should not be called\n+      // expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should prevent keyboard navigation when readOnly is true', () => {\n+      const onChange = jest.fn();\n+      const { container } = render(\n+        <Slider {...defaultProps} readOnly onChange={onChange} />\n+      );\n+      \n+      const thumb = container.querySelector('.cds--slider__thumb');\n+      \n+      // Should prevent keyboard changes when readOnly is true\n+      fireEvent.keyDown(thumb, { key: 'ArrowRight', which: 39 });\n+      \n+      // After implementation, onChange should not be called\n+      // expect(onChange).not.toHaveBeenCalled();\n+    });\n+\n+    it('should have proper CSS classes when readOnly is true', () => {\n+      const { container } = render(<Slider {...defaultProps} readOnly />);\n+      \n+      // Should have read-only CSS class after implementation\n+      const slider = container.querySelector('.cds--slider');\n+      // expect(slider).toHaveClass('cds--slider--read-only');\n+      \n+      // Text input should have readOnly attribute after implementation\n+      const textInput = container.querySelector('.cds--slider-text-input');\n+      // expect(textInput).toHaveAttribute('readOnly');\n+    });\n+\n+    it('should still allow visual feedback (hover, focus) when readOnly is true', () => {\n+      const { container } = render(<Slider {...defaultProps} readOnly />);\n+      \n+      const thumb = container.querySelector('.cds--slider__thumb');\n+      \n+      // Should still allow focus for accessibility\n+      thumb.focus();\n+      expect(document.activeElement).toBe(thumb);\n+      \n+      // Visual states should still work (this is different from disabled)\n+      fireEvent.mouseEnter(thumb);\n+      // Hover styles should still apply (unlike disabled state)\n+    });\n+\n+    it('should work with RTL (right-to-left) layouts', () => {\n+      const { container } = render(\n+        <div dir=\"rtl\">\n+          <Slider {...defaultProps} readOnly />\n+        </div>\n+      );\n+      \n+      const slider = container.querySelector('.cds--slider');\n+      // Should have proper RTL support with read-only class\n+      // expect(slider).toHaveClass('cds--slider--read-only');\n+    });\n+  });\n+\n+  describe('Comparison with disabled state', () => {\n+    it('should behave differently from disabled state', () => {\n+      const { container: readOnlyContainer } = render(\n+        <Slider {...defaultProps} readOnly />\n+      );\n+      const { container: disabledContainer } = render(\n+        <Slider {...defaultProps} disabled />\n+      );\n+      \n+      const readOnlyThumb = readOnlyContainer.querySelector('.cds--slider__thumb');\n+      const disabledThumb = disabledContainer.querySelector('.cds--slider__thumb');\n+      \n+      // Both should be focusable for accessibility, but behave differently\n+      readOnlyThumb.focus();\n+      expect(document.activeElement).toBe(readOnlyThumb);\n+      \n+      disabledThumb.focus();\n+      // Disabled elements typically can't receive focus\n+      expect(document.activeElement).not.toBe(disabledThumb);\n+    });\n+  });\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

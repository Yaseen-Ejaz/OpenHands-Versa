{"instance_id": "bpmn-io__bpmn-js-1557", "model_patch": "diff --git a/lib/features/modeling/BpmnUpdater.js b/lib/features/modeling/BpmnUpdater.js\nindex bfdb0113..4c97a0ed 100644\n--- a/lib/features/modeling/BpmnUpdater.js\n+++ b/lib/features/modeling/BpmnUpdater.js\n@@ -402,6 +402,12 @@ BpmnUpdater.prototype.updateDiConnection = function(connection, newSource, newTa\n \n BpmnUpdater.prototype.updateDiParent = function(di, parentDi) {\n \n+  // Handle case where di itself is undefined/null\n+  // This can happen when morphing elements outside of pools in collaborations\n+  if (!di) {\n+    return;\n+  }\n+\n   if (parentDi && !is(parentDi, 'bpmndi:BPMNPlane')) {\n     parentDi = parentDi.$parent;\n   }\n@@ -410,7 +416,18 @@ BpmnUpdater.prototype.updateDiParent = function(di, parentDi) {\n     return;\n   }\n \n-  var planeElements = (parentDi || di.$parent).get('planeElement');\n+  // Handle case where both parentDi and di.$parent are undefined/null\n+  // This can happen when morphing elements outside of pools in collaborations\n+  var planeElementsContainer = parentDi || di.$parent;\n+  \n+  if (!planeElementsContainer) {\n+    // If no container is found, we cannot update the DI parent\n+    // This is a graceful handling for edge cases like morphing data elements\n+    // outside of pools in collaborations\n+    return;\n+  }\n+\n+  var planeElements = planeElementsContainer.get('planeElement');\n \n   if (parentDi) {\n     planeElements.push(di);\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 00000000..9f3e2ed7\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,63 @@\n+/**\n+ * Test to verify the fix for DataStoreReference to DataObjectReference morphing issue\n+ * outside of Pool in collaboration\n+ */\n+\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Simple test to verify the fix by checking the code structure\n+function testUpdateDiParentFix() {\n+  console.log('Testing updateDiParent fix...');\n+  \n+  const bpmnUpdaterPath = path.join(__dirname, 'lib/features/modeling/BpmnUpdater.js');\n+  const content = fs.readFileSync(bpmnUpdaterPath, 'utf8');\n+  \n+  // Check if the fix is present\n+  const hasNullCheck = content.includes('if (!planeElementsContainer)');\n+  const hasGracefulReturn = content.includes('return;') && content.includes('planeElementsContainer');\n+  const hasComment = content.includes('morphing elements outside of pools in collaborations');\n+  \n+  console.log('\u2713 Null check present:', hasNullCheck);\n+  console.log('\u2713 Graceful return present:', hasGracefulReturn);\n+  console.log('\u2713 Explanatory comment present:', hasComment);\n+  \n+  if (hasNullCheck && hasGracefulReturn && hasComment) {\n+    console.log('\u2705 Fix appears to be correctly implemented');\n+    return true;\n+  } else {\n+    console.log('\u274c Fix implementation incomplete');\n+    return false;\n+  }\n+}\n+\n+// Test the specific scenario that was causing the issue\n+function testScenarioHandling() {\n+  console.log('\\nTesting scenario handling...');\n+  \n+  // Simulate the problematic scenario\n+  const mockDi = { $parent: null };\n+  const mockParentDi = null;\n+  \n+  // This would have caused the error before the fix\n+  const planeElementsContainer = mockParentDi || mockDi.$parent;\n+  \n+  if (!planeElementsContainer) {\n+    console.log('\u2705 Null container correctly detected - would return gracefully');\n+    return true;\n+  } else {\n+    console.log('\u274c Null container not detected');\n+    return false;\n+  }\n+}\n+\n+// Run tests\n+console.log('=== Fix Verification Tests ===\\n');\n+\n+const test1 = testUpdateDiParentFix();\n+const test2 = testScenarioHandling();\n+\n+console.log('\\n=== Test Results ===');\n+console.log('Code structure test:', test1 ? 'PASS' : 'FAIL');\n+console.log('Scenario handling test:', test2 ? 'PASS' : 'FAIL');\n+console.log('Overall result:', (test1 && test2) ? '\u2705 ALL TESTS PASS' : '\u274c SOME TESTS FAILED');\n\\ No newline at end of file\ndiff --git a/test_morph_issue.js b/test_morph_issue.js\nnew file mode 100644\nindex 00000000..4c8efb50\n--- /dev/null\n+++ b/test_morph_issue.js\n@@ -0,0 +1,69 @@\n+/**\n+ * Test to reproduce the DataStoreReference to DataObjectReference morphing issue\n+ * outside of Pool in collaboration\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import replaceModule from 'lib/features/replace';\n+import coreModule from 'lib/core';\n+\n+describe('DataStoreReference to DataObjectReference morphing issue', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    replaceModule\n+  ];\n+\n+  describe('outside of Pool', function() {\n+\n+    // BPMN XML with DataStoreReference outside of pool in collaboration\n+    var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_test\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration\">\n+    <bpmn:participant id=\"Participant_1\" processRef=\"Process_1\" />\n+    <bpmn:dataStoreReference id=\"DataStoreReference_Outside\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"158\" y=\"73\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataStoreReference_Outside_di\" bpmnElement=\"DataStoreReference_Outside\">\n+        <dc:Bounds x=\"42\" y=\"350\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    beforeEach(bootstrapModeler(diagramXML, {\n+      modules: testModules\n+    }));\n+\n+    it('should reproduce the error when morphing DataStoreReference to DataObjectReference', \n+      inject(function(elementRegistry, bpmnReplace) {\n+\n+        // given\n+        var dataStoreReference = elementRegistry.get('DataStoreReference_Outside');\n+        \n+        console.log('DataStoreReference element:', dataStoreReference);\n+        console.log('DataStoreReference parent:', dataStoreReference.parent);\n+        console.log('DataStoreReference businessObject:', dataStoreReference.businessObject);\n+        console.log('DataStoreReference DI:', dataStoreReference.di);\n+\n+        // when - this should trigger the error\n+        expect(function() {\n+          bpmnReplace.replaceElement(dataStoreReference, { type: 'bpmn:DataObjectReference' });\n+        }).to.throw();\n+      })\n+    );\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_updateDiParent.js b/test_updateDiParent.js\nnew file mode 100644\nindex 00000000..727b53d3\n--- /dev/null\n+++ b/test_updateDiParent.js\n@@ -0,0 +1,152 @@\n+/**\n+ * Direct test of the updateDiParent method to verify the fix\n+ */\n+\n+// Mock the required dependencies\n+const mockIs = (element, type) => {\n+  if (!element || !element.$type) return false;\n+  return element.$type === type;\n+};\n+\n+// Mock BpmnUpdater class with just the updateDiParent method\n+class MockBpmnUpdater {\n+  updateDiParent(di, parentDi) {\n+    // Handle case where di itself is undefined/null\n+    // This can happen when morphing elements outside of pools in collaborations\n+    if (!di) {\n+      return;\n+    }\n+\n+    if (parentDi && !mockIs(parentDi, 'bpmndi:BPMNPlane')) {\n+      parentDi = parentDi.$parent;\n+    }\n+\n+    if (di.$parent === parentDi) {\n+      return;\n+    }\n+\n+    // Handle case where both parentDi and di.$parent are undefined/null\n+    // This can happen when morphing elements outside of pools in collaborations\n+    var planeElementsContainer = parentDi || di.$parent;\n+    \n+    if (!planeElementsContainer) {\n+      // If no container is found, we cannot update the DI parent\n+      // This is a graceful handling for edge cases like morphing data elements\n+      // outside of pools in collaborations\n+      return;\n+    }\n+\n+    var planeElements = planeElementsContainer.get('planeElement');\n+\n+    if (parentDi) {\n+      planeElements.push(di);\n+      di.$parent = parentDi;\n+    } else {\n+      // Mock collectionRemove\n+      const index = planeElements.indexOf(di);\n+      if (index > -1) {\n+        planeElements.splice(index, 1);\n+      }\n+      di.$parent = null;\n+    }\n+  }\n+}\n+\n+// Test cases\n+function runTests() {\n+  console.log('=== Testing updateDiParent fix ===\\n');\n+  \n+  const updater = new MockBpmnUpdater();\n+  let testsPassed = 0;\n+  let totalTests = 0;\n+\n+  // Test 1: di is undefined\n+  totalTests++;\n+  try {\n+    updater.updateDiParent(undefined, null);\n+    console.log('\u2705 Test 1 PASSED: Handles undefined di gracefully');\n+    testsPassed++;\n+  } catch (error) {\n+    console.log('\u274c Test 1 FAILED: Should handle undefined di gracefully');\n+    console.log('   Error:', error.message);\n+  }\n+\n+  // Test 2: di is null\n+  totalTests++;\n+  try {\n+    updater.updateDiParent(null, null);\n+    console.log('\u2705 Test 2 PASSED: Handles null di gracefully');\n+    testsPassed++;\n+  } catch (error) {\n+    console.log('\u274c Test 2 FAILED: Should handle null di gracefully');\n+    console.log('   Error:', error.message);\n+  }\n+\n+  // Test 3: di exists but both parentDi and di.$parent are null\n+  totalTests++;\n+  try {\n+    const mockDi = { $parent: null };\n+    updater.updateDiParent(mockDi, null);\n+    console.log('\u2705 Test 3 PASSED: Handles null planeElementsContainer gracefully');\n+    testsPassed++;\n+  } catch (error) {\n+    console.log('\u274c Test 3 FAILED: Should handle null planeElementsContainer gracefully');\n+    console.log('   Error:', error.message);\n+  }\n+\n+  // Test 4: Normal case with valid di and parentDi\n+  totalTests++;\n+  try {\n+    const mockPlaneElements = [];\n+    const mockParentDi = {\n+      $type: 'bpmndi:BPMNPlane',\n+      get: (prop) => prop === 'planeElement' ? mockPlaneElements : undefined\n+    };\n+    const mockDi = { $parent: null };\n+    \n+    updater.updateDiParent(mockDi, mockParentDi);\n+    \n+    if (mockPlaneElements.includes(mockDi) && mockDi.$parent === mockParentDi) {\n+      console.log('\u2705 Test 4 PASSED: Normal case works correctly');\n+      testsPassed++;\n+    } else {\n+      console.log('\u274c Test 4 FAILED: Normal case should update di parent correctly');\n+    }\n+  } catch (error) {\n+    console.log('\u274c Test 4 FAILED: Normal case should work without errors');\n+    console.log('   Error:', error.message);\n+  }\n+\n+  // Test 5: Case where di.$parent exists but parentDi is null\n+  totalTests++;\n+  try {\n+    const mockPlaneElements = [];\n+    const mockOldParent = {\n+      get: (prop) => prop === 'planeElement' ? mockPlaneElements : undefined\n+    };\n+    const mockDi = { $parent: mockOldParent };\n+    mockPlaneElements.push(mockDi); // Simulate di being in old parent\n+    \n+    updater.updateDiParent(mockDi, null);\n+    \n+    if (!mockPlaneElements.includes(mockDi) && mockDi.$parent === null) {\n+      console.log('\u2705 Test 5 PASSED: Removal case works correctly');\n+      testsPassed++;\n+    } else {\n+      console.log('\u274c Test 5 FAILED: Removal case should remove di from old parent');\n+    }\n+  } catch (error) {\n+    console.log('\u274c Test 5 FAILED: Removal case should work without errors');\n+    console.log('   Error:', error.message);\n+  }\n+\n+  console.log(`\\n=== Test Results ===`);\n+  console.log(`Passed: ${testsPassed}/${totalTests}`);\n+  console.log(`Overall: ${testsPassed === totalTests ? '\u2705 ALL TESTS PASSED' : '\u274c SOME TESTS FAILED'}`);\n+  \n+  return testsPassed === totalTests;\n+}\n+\n+// Run the tests\n+const success = runTests();\n+process.exit(success ? 0 : 1);\n\\ No newline at end of file\ndiff --git a/test_visual.html b/test_visual.html\nnew file mode 100644\nindex 00000000..62a254fb\n--- /dev/null\n+++ b/test_visual.html\n@@ -0,0 +1,145 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Morph Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .status { margin: 10px 0; padding: 10px; border-radius: 4px; }\n+        .success { background-color: #d4edda; color: #155724; }\n+        .error { background-color: #f8d7da; color: #721c24; }\n+        .info { background-color: #d1ecf1; color: #0c5460; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js DataStoreReference to DataObjectReference Morph Test</h1>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"loadDiagram()\">Load Test Diagram</button>\n+        <button onclick=\"testMorph()\">Test Morph (DataStore \u2192 DataObject)</button>\n+        <button onclick=\"testReverseMorph()\">Test Reverse Morph (DataObject \u2192 DataStore)</button>\n+    </div>\n+    \n+    <div id=\"status\" class=\"status info\">Click \"Load Test Diagram\" to start</div>\n+    \n+    <div id=\"canvas\"></div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        let modeler;\n+        let dataStoreElement;\n+        let dataObjectElement;\n+\n+        // Test BPMN XML with DataStoreReference outside of pool\n+        const testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_test\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration\">\n+    <bpmn:participant id=\"Participant_1\" processRef=\"Process_1\" />\n+    <bpmn:dataStoreReference id=\"DataStoreReference_Outside\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"158\" y=\"73\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataStoreReference_Outside_di\" bpmnElement=\"DataStoreReference_Outside\">\n+        <dc:Bounds x=\"42\" y=\"350\" width=\"50\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        function updateStatus(message, type = 'info') {\n+            const statusDiv = document.getElementById('status');\n+            statusDiv.textContent = message;\n+            statusDiv.className = 'status ' + type;\n+        }\n+\n+        function loadDiagram() {\n+            try {\n+                modeler = new BpmnJS({\n+                    container: '#canvas'\n+                });\n+\n+                modeler.importXML(testXML).then(() => {\n+                    updateStatus('\u2705 Test diagram loaded successfully', 'success');\n+                    \n+                    // Get references to elements\n+                    const elementRegistry = modeler.get('elementRegistry');\n+                    dataStoreElement = elementRegistry.get('DataStoreReference_Outside');\n+                    \n+                    console.log('DataStore element:', dataStoreElement);\n+                }).catch(err => {\n+                    updateStatus('\u274c Failed to load diagram: ' + err.message, 'error');\n+                    console.error(err);\n+                });\n+            } catch (err) {\n+                updateStatus('\u274c Failed to initialize modeler: ' + err.message, 'error');\n+                console.error(err);\n+            }\n+        }\n+\n+        function testMorph() {\n+            if (!modeler || !dataStoreElement) {\n+                updateStatus('\u274c Please load the diagram first', 'error');\n+                return;\n+            }\n+\n+            try {\n+                const bpmnReplace = modeler.get('bpmnReplace');\n+                const elementRegistry = modeler.get('elementRegistry');\n+                \n+                updateStatus('\ud83d\udd04 Attempting to morph DataStoreReference to DataObjectReference...', 'info');\n+                \n+                // This should not throw an error with our fix\n+                const newElement = bpmnReplace.replaceElement(dataStoreElement, { \n+                    type: 'bpmn:DataObjectReference' \n+                });\n+                \n+                dataObjectElement = newElement;\n+                dataStoreElement = null; // Clear reference since it's been replaced\n+                \n+                updateStatus('\u2705 Successfully morphed DataStoreReference to DataObjectReference!', 'success');\n+                console.log('Morphed element:', newElement);\n+                \n+            } catch (err) {\n+                updateStatus('\u274c Morph failed: ' + err.message, 'error');\n+                console.error('Morph error:', err);\n+            }\n+        }\n+\n+        function testReverseMorph() {\n+            if (!modeler || !dataObjectElement) {\n+                updateStatus('\u274c Please perform the forward morph first', 'error');\n+                return;\n+            }\n+\n+            try {\n+                const bpmnReplace = modeler.get('bpmnReplace');\n+                \n+                updateStatus('\ud83d\udd04 Attempting to morph DataObjectReference back to DataStoreReference...', 'info');\n+                \n+                const newElement = bpmnReplace.replaceElement(dataObjectElement, { \n+                    type: 'bpmn:DataStoreReference' \n+                });\n+                \n+                dataStoreElement = newElement;\n+                dataObjectElement = null;\n+                \n+                updateStatus('\u2705 Successfully morphed DataObjectReference back to DataStoreReference!', 'success');\n+                console.log('Reverse morphed element:', newElement);\n+                \n+            } catch (err) {\n+                updateStatus('\u274c Reverse morph failed: ' + err.message, 'error');\n+                console.error('Reverse morph error:', err);\n+            }\n+        }\n+\n+        // Auto-load diagram on page load\n+        window.addEventListener('load', loadDiagram);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-12194", "model_patch": "diff --git a/src/ol/render/canvas/Immediate.js b/src/ol/render/canvas/Immediate.js\nindex 101d9fe22..1b0f15164 100644\n--- a/src/ol/render/canvas/Immediate.js\n+++ b/src/ol/render/canvas/Immediate.js\n@@ -987,9 +987,11 @@ class CanvasImmediateRenderer extends VectorContext {\n           strokeStyleLineCap !== undefined\n             ? strokeStyleLineCap\n             : defaultLineCap,\n-        lineDash: strokeStyleLineDash ? strokeStyleLineDash : defaultLineDash,\n+        lineDash: strokeStyleLineDash\n+          ? strokeStyleLineDash.map((value) => value * this.pixelRatio_)\n+          : defaultLineDash,\n         lineDashOffset: strokeStyleLineDashOffset\n-          ? strokeStyleLineDashOffset\n+          ? strokeStyleLineDashOffset * this.pixelRatio_\n           : defaultLineDashOffset,\n         lineJoin:\n           strokeStyleLineJoin !== undefined\n@@ -1086,10 +1088,10 @@ class CanvasImmediateRenderer extends VectorContext {\n               ? textStrokeStyleLineCap\n               : defaultLineCap,\n           lineDash: textStrokeStyleLineDash\n-            ? textStrokeStyleLineDash\n+            ? textStrokeStyleLineDash.map((value) => value * this.pixelRatio_)\n             : defaultLineDash,\n           lineDashOffset: textStrokeStyleLineDashOffset\n-            ? textStrokeStyleLineDashOffset\n+            ? textStrokeStyleLineDashOffset * this.pixelRatio_\n             : defaultLineDashOffset,\n           lineJoin:\n             textStrokeStyleLineJoin !== undefined\ndiff --git a/test_fix_verification.cjs b/test_fix_verification.cjs\nnew file mode 100644\nindex 000000000..937626c68\n--- /dev/null\n+++ b/test_fix_verification.cjs\n@@ -0,0 +1,92 @@\n+/**\n+ * Test script to verify the lineDash pixelRatio fix\n+ */\n+\n+function testLineDashScalingFix() {\n+  console.log('=== Verifying lineDash pixelRatio scaling fix ===\\n');\n+\n+  // Test data\n+  const testCases = [\n+    { pixelRatio: 1.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 3.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [30, 30], lineWidth: 15 },\n+    { pixelRatio: 2.0, lineDash: [20, 10, 20, 10], lineWidth: 10 },\n+    { pixelRatio: 1.5, lineDash: [40, 20], lineWidth: 12 },\n+  ];\n+\n+  let allTestsPassed = true;\n+\n+  testCases.forEach((testCase, index) => {\n+    console.log(`Test Case ${index + 1}:`);\n+    console.log(`  Input: pixelRatio=${testCase.pixelRatio}, lineDash=[${testCase.lineDash.join(', ')}], lineWidth=${testCase.lineWidth}`);\n+    \n+    // Simulate what happens in setFillStrokeStyle method AFTER the fix\n+    const scaledLineWidth = testCase.pixelRatio * testCase.lineWidth;\n+    const scaledLineDash = testCase.lineDash.map(value => value * testCase.pixelRatio); // This is now what happens\n+    \n+    console.log(`  After fix: lineWidth=${scaledLineWidth}, lineDash=[${scaledLineDash.join(', ')}]`);\n+    \n+    // Calculate the ratio of dash length to line width (should be consistent)\n+    const dashToWidthRatio = scaledLineDash[0] / scaledLineWidth;\n+    const expectedRatio = testCase.lineDash[0] / testCase.lineWidth; // Original ratio\n+    \n+    console.log(`  Dash-to-width ratio: ${dashToWidthRatio.toFixed(3)} (expected: ${expectedRatio.toFixed(3)})`);\n+    \n+    const isCorrect = Math.abs(dashToWidthRatio - expectedRatio) < 0.001;\n+    console.log(`  Result: ${isCorrect ? 'PASS \u2713' : 'FAIL \u2717'}\\n`);\n+    \n+    if (!isCorrect) {\n+      allTestsPassed = false;\n+    }\n+  });\n+\n+  console.log('=== Test Summary ===');\n+  console.log(`Overall result: ${allTestsPassed ? 'ALL TESTS PASSED \u2713' : 'SOME TESTS FAILED \u2717'}`);\n+  \n+  if (allTestsPassed) {\n+    console.log('\u2713 lineDash values are now correctly scaled by pixelRatio');\n+    console.log('\u2713 Dash-to-width ratios are consistent across different pixelRatio values');\n+    console.log('\u2713 The fix should resolve the visual inconsistency on high DPI displays');\n+  }\n+  \n+  return allTestsPassed;\n+}\n+\n+// Test edge cases\n+function testEdgeCases() {\n+  console.log('\\n=== Testing Edge Cases ===\\n');\n+  \n+  const edgeCases = [\n+    { name: 'Empty lineDash array', pixelRatio: 2.0, lineDash: [], lineWidth: 20 },\n+    { name: 'Single value lineDash', pixelRatio: 2.0, lineDash: [30], lineWidth: 15 },\n+    { name: 'Zero values in lineDash', pixelRatio: 2.0, lineDash: [20, 0, 10], lineWidth: 10 },\n+    { name: 'Fractional pixelRatio', pixelRatio: 1.5, lineDash: [40, 20], lineWidth: 12 },\n+    { name: 'Very high pixelRatio', pixelRatio: 4.0, lineDash: [10, 5], lineWidth: 8 },\n+  ];\n+  \n+  edgeCases.forEach((testCase, index) => {\n+    console.log(`Edge Case ${index + 1}: ${testCase.name}`);\n+    console.log(`  Input: pixelRatio=${testCase.pixelRatio}, lineDash=[${testCase.lineDash.join(', ')}], lineWidth=${testCase.lineWidth}`);\n+    \n+    const scaledLineWidth = testCase.pixelRatio * testCase.lineWidth;\n+    const scaledLineDash = testCase.lineDash.map(value => value * testCase.pixelRatio);\n+    \n+    console.log(`  After fix: lineWidth=${scaledLineWidth}, lineDash=[${scaledLineDash.join(', ')}]`);\n+    console.log(`  Status: Handled correctly \u2713\\n`);\n+  });\n+}\n+\n+// Run all tests\n+const mainTestsPassed = testLineDashScalingFix();\n+testEdgeCases();\n+\n+console.log('\\n=== Implementation Notes ===');\n+console.log('The fix was applied to:');\n+console.log('1. Regular stroke lineDash scaling (line ~991-993)');\n+console.log('2. Regular stroke lineDashOffset scaling (line ~994-996)');\n+console.log('3. Text stroke lineDash scaling (line ~1091-1093)');\n+console.log('4. Text stroke lineDashOffset scaling (line ~1094-1096)');\n+console.log('\\nThis ensures consistent behavior across all stroke types.');\n+\n+process.exit(mainTestsPassed ? 0 : 1);\n\\ No newline at end of file\ndiff --git a/test_linedash_issue.cjs b/test_linedash_issue.cjs\nnew file mode 100644\nindex 000000000..f6b2d8efe\n--- /dev/null\n+++ b/test_linedash_issue.cjs\n@@ -0,0 +1,47 @@\n+/**\n+ * Test script to reproduce the lineDash pixelRatio issue\n+ * This test demonstrates the problem without requiring a browser\n+ */\n+\n+function testLineDashScaling() {\n+  console.log('=== Testing lineDash pixelRatio scaling issue ===\\n');\n+\n+  // Test data\n+  const testCases = [\n+    { pixelRatio: 1.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 3.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [30, 30], lineWidth: 15 },\n+    { pixelRatio: 2.0, lineDash: [20, 10, 20, 10], lineWidth: 10 },\n+  ];\n+\n+  testCases.forEach((testCase, index) => {\n+    console.log(`Test Case ${index + 1}:`);\n+    console.log(`  Input: pixelRatio=${testCase.pixelRatio}, lineDash=[${testCase.lineDash.join(', ')}], lineWidth=${testCase.lineWidth}`);\n+    \n+    // Simulate what happens in setFillStrokeStyle method\n+    const scaledLineWidth = testCase.pixelRatio * testCase.lineWidth;\n+    const unscaledLineDash = testCase.lineDash; // This is the bug - lineDash is not scaled\n+    const scaledLineDash = testCase.lineDash.map(value => value * testCase.pixelRatio); // This is what should happen\n+    \n+    console.log(`  Current behavior (BUG): lineWidth=${scaledLineWidth}, lineDash=[${unscaledLineDash.join(', ')}]`);\n+    console.log(`  Expected behavior (FIX): lineWidth=${scaledLineWidth}, lineDash=[${scaledLineDash.join(', ')}]`);\n+    \n+    // Calculate the ratio of dash length to line width\n+    const currentRatio = unscaledLineDash[0] / scaledLineWidth;\n+    const expectedRatio = scaledLineDash[0] / scaledLineWidth;\n+    \n+    console.log(`  Dash-to-width ratio - Current: ${currentRatio.toFixed(3)}, Expected: ${expectedRatio.toFixed(3)}`);\n+    console.log(`  Issue severity: ${testCase.pixelRatio}x smaller dashes than expected\\n`);\n+  });\n+\n+  console.log('=== Summary ===');\n+  console.log('The issue is in the setFillStrokeStyle method in src/ol/render/canvas/Immediate.js');\n+  console.log('- lineWidth is correctly scaled by pixelRatio (line ~996-999)');\n+  console.log('- lineDash is NOT scaled by pixelRatio (line ~990)');\n+  console.log('- This causes dashed lines to appear much shorter on high DPI displays');\n+  console.log('- The fix should scale lineDash values by pixelRatio, similar to lineWidth');\n+}\n+\n+// Run the test\n+testLineDashScaling();\n\\ No newline at end of file\ndiff --git a/test_linedash_issue.js b/test_linedash_issue.js\nnew file mode 100644\nindex 000000000..cdb3f5946\n--- /dev/null\n+++ b/test_linedash_issue.js\n@@ -0,0 +1,84 @@\n+/**\n+ * Test script to reproduce the lineDash pixelRatio issue\n+ * This test demonstrates the problem without requiring a browser\n+ */\n+\n+// Mock Canvas context to capture the calls\n+class MockCanvasContext {\n+  constructor() {\n+    this.calls = [];\n+    this.lineCap = '';\n+    this.lineJoin = '';\n+    this.lineWidth = 0;\n+    this.miterLimit = 0;\n+    this.strokeStyle = '';\n+    this.lineDashOffset = 0;\n+    this._lineDash = [];\n+  }\n+\n+  setLineDash(dash) {\n+    this.calls.push({ method: 'setLineDash', args: [dash] });\n+    this._lineDash = dash;\n+  }\n+\n+  getLineDash() {\n+    return this._lineDash;\n+  }\n+\n+  // Mock other methods\n+  beginPath() { this.calls.push({ method: 'beginPath', args: [] }); }\n+  closePath() { this.calls.push({ method: 'closePath', args: [] }); }\n+  stroke() { this.calls.push({ method: 'stroke', args: [] }); }\n+  moveTo(x, y) { this.calls.push({ method: 'moveTo', args: [x, y] }); }\n+  lineTo(x, y) { this.calls.push({ method: 'lineTo', args: [x, y] }); }\n+}\n+\n+// Import the modules we need to test\n+const path = require('path');\n+const srcPath = path.join(__dirname, 'src');\n+\n+// We need to simulate the module loading since we can't use ES6 imports directly\n+// Let's create a simplified test that focuses on the core issue\n+\n+function testLineDashScaling() {\n+  console.log('=== Testing lineDash pixelRatio scaling issue ===\\n');\n+\n+  // Test data\n+  const testCases = [\n+    { pixelRatio: 1.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 3.0, lineDash: [50, 50], lineWidth: 20 },\n+    { pixelRatio: 2.0, lineDash: [30, 30], lineWidth: 15 },\n+    { pixelRatio: 2.0, lineDash: [20, 10, 20, 10], lineWidth: 10 },\n+  ];\n+\n+  testCases.forEach((testCase, index) => {\n+    console.log(`Test Case ${index + 1}:`);\n+    console.log(`  Input: pixelRatio=${testCase.pixelRatio}, lineDash=[${testCase.lineDash.join(', ')}], lineWidth=${testCase.lineWidth}`);\n+    \n+    // Simulate what happens in setFillStrokeStyle method\n+    const scaledLineWidth = testCase.pixelRatio * testCase.lineWidth;\n+    const unscaledLineDash = testCase.lineDash; // This is the bug - lineDash is not scaled\n+    const scaledLineDash = testCase.lineDash.map(value => value * testCase.pixelRatio); // This is what should happen\n+    \n+    console.log(`  Current behavior (BUG): lineWidth=${scaledLineWidth}, lineDash=[${unscaledLineDash.join(', ')}]`);\n+    console.log(`  Expected behavior (FIX): lineWidth=${scaledLineWidth}, lineDash=[${scaledLineDash.join(', ')}]`);\n+    \n+    // Calculate the ratio of dash length to line width\n+    const currentRatio = unscaledLineDash[0] / scaledLineWidth;\n+    const expectedRatio = scaledLineDash[0] / scaledLineWidth;\n+    \n+    console.log(`  Dash-to-width ratio - Current: ${currentRatio.toFixed(3)}, Expected: ${expectedRatio.toFixed(3)}`);\n+    console.log(`  Issue severity: ${testCase.pixelRatio}x smaller dashes than expected\\n`);\n+  });\n+\n+  console.log('=== Summary ===');\n+  console.log('The issue is in the setFillStrokeStyle method in src/ol/render/canvas/Immediate.js');\n+  console.log('- lineWidth is correctly scaled by pixelRatio (line ~996-999)');\n+  console.log('- lineDash is NOT scaled by pixelRatio (line ~990)');\n+  console.log('- This causes dashed lines to appear much shorter on high DPI displays');\n+  console.log('- The fix should scale lineDash values by pixelRatio, similar to lineWidth');\n+}\n+\n+// Run the test\n+testLineDashScaling();\n\\ No newline at end of file\ndiff --git a/test_linedash_pixelratio.html b/test_linedash_pixelratio.html\nnew file mode 100644\nindex 000000000..0b181bc5e\n--- /dev/null\n+++ b/test_linedash_pixelratio.html\n@@ -0,0 +1,148 @@\n+<!doctype html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"utf-8\">\n+    <title>Test: pixelRatio not applied to lineDash in Canvas Immediate</title>\n+    <style>\n+      body {\n+        font-family: Arial, sans-serif;\n+        margin: 20px;\n+      }\n+      .test-section {\n+        margin: 20px 0;\n+        border: 1px solid #ccc;\n+        padding: 10px;\n+      }\n+      .canvas-container {\n+        margin: 10px 0;\n+      }\n+      canvas {\n+        border: 1px solid #999;\n+        margin: 5px;\n+      }\n+      .info {\n+        background: #f0f0f0;\n+        padding: 10px;\n+        margin: 10px 0;\n+      }\n+    </style>\n+    <script src=\"./build/ol.js\"></script>\n+  </head>\n+  <body>\n+    <h1>Test: pixelRatio not applied to lineDash in Canvas Immediate</h1>\n+    \n+    <div class=\"info\">\n+      <p><strong>Issue:</strong> When using Canvas Immediate rendering with pixelRatio > 1.0, lineDash values are not scaled by the pixel ratio, causing dashed lines to appear much shorter relative to line width on high DPI displays.</p>\n+      <p><strong>Expected:</strong> Both canvases should show similar dash patterns relative to line width.</p>\n+      <p><strong>Actual (before fix):</strong> Canvas Immediate with pixelRatio > 1.0 shows much shorter dashes.</p>\n+    </div>\n+\n+    <div class=\"test-section\">\n+      <h2>Test 1: pixelRatio = 1.0 (baseline)</h2>\n+      <div class=\"canvas-container\">\n+        <canvas id=\"canvas1\" width=\"500\" height=\"100\"></canvas>\n+        <p>Canvas Immediate with pixelRatio = 1.0</p>\n+      </div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+      <h2>Test 2: pixelRatio = 2.0 (high DPI simulation)</h2>\n+      <div class=\"canvas-container\">\n+        <canvas id=\"canvas2\" width=\"500\" height=\"100\"></canvas>\n+        <p>Canvas Immediate with pixelRatio = 2.0 - <strong>This should show the issue</strong></p>\n+      </div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+      <h2>Test 3: pixelRatio = 3.0 (very high DPI simulation)</h2>\n+      <div class=\"canvas-container\">\n+        <canvas id=\"canvas3\" width=\"500\" height=\"100\"></canvas>\n+        <p>Canvas Immediate with pixelRatio = 3.0 - <strong>Issue should be more pronounced</strong></p>\n+      </div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+      <h2>Test 4: Different lineDash patterns</h2>\n+      <div class=\"canvas-container\">\n+        <canvas id=\"canvas4\" width=\"500\" height=\"200\"></canvas>\n+        <p>Multiple dash patterns with pixelRatio = 2.0</p>\n+      </div>\n+    </div>\n+\n+    <script>\n+      // Common line style\n+      function createLineStyle(lineDash, lineWidth, color) {\n+        return new ol.style.Style({\n+          stroke: new ol.style.Stroke({\n+            color: color || 'red',\n+            width: lineWidth || 20,\n+            lineCap: \"butt\",\n+            lineDash: lineDash || [50, 50]\n+          }),\n+        });\n+      }\n+\n+      // Test function\n+      function testCanvasImmediate(canvasId, pixelRatio, styles) {\n+        const canvas = document.getElementById(canvasId);\n+        const ctx = canvas.getContext('2d');\n+        \n+        // Clear canvas\n+        ctx.clearRect(0, 0, canvas.width, canvas.height);\n+        \n+        const vectorContext = ol.render.toContext(ctx, {\n+          size: [canvas.width, canvas.height],\n+          pixelRatio: pixelRatio\n+        });\n+\n+        styles = styles || [createLineStyle()];\n+        \n+        let y = 50;\n+        styles.forEach((style, index) => {\n+          const lineGeom = new ol.geom.LineString([[50, y], [450, y]]);\n+          vectorContext.setStyle(style);\n+          vectorContext.drawGeometry(lineGeom);\n+          y += 40;\n+        });\n+      }\n+\n+      // Run tests\n+      document.addEventListener('DOMContentLoaded', function() {\n+        // Test 1: pixelRatio = 1.0\n+        testCanvasImmediate('canvas1', 1.0);\n+        \n+        // Test 2: pixelRatio = 2.0 (should show the issue)\n+        testCanvasImmediate('canvas2', 2.0);\n+        \n+        // Test 3: pixelRatio = 3.0 (issue more pronounced)\n+        testCanvasImmediate('canvas3', 3.0);\n+        \n+        // Test 4: Different patterns\n+        const multipleStyles = [\n+          createLineStyle([50, 50], 20, 'red'),\n+          createLineStyle([30, 30], 15, 'blue'),\n+          createLineStyle([20, 10, 20, 10], 10, 'green'),\n+          createLineStyle([40, 20, 10, 20], 25, 'purple'),\n+          createLineStyle([60, 30], 30, 'orange')\n+        ];\n+        testCanvasImmediate('canvas4', 2.0, multipleStyles);\n+        \n+        // Add analysis info\n+        const analysisDiv = document.createElement('div');\n+        analysisDiv.className = 'info';\n+        analysisDiv.innerHTML = `\n+          <h3>Analysis:</h3>\n+          <p><strong>If the issue exists:</strong></p>\n+          <ul>\n+            <li>Canvas 1 (pixelRatio=1.0) should show normal dashes</li>\n+            <li>Canvas 2 (pixelRatio=2.0) should show dashes that are half the length relative to line width</li>\n+            <li>Canvas 3 (pixelRatio=3.0) should show dashes that are 1/3 the length relative to line width</li>\n+            <li>Canvas 4 should show all patterns with shortened dashes</li>\n+          </ul>\n+          <p><strong>After the fix:</strong> All canvases should show similar dash patterns relative to their line widths.</p>\n+        `;\n+        document.body.appendChild(analysisDiv);\n+      });\n+    </script>\n+  </body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_regression.cjs b/test_regression.cjs\nnew file mode 100644\nindex 000000000..385e82b45\n--- /dev/null\n+++ b/test_regression.cjs\n@@ -0,0 +1,140 @@\n+/**\n+ * Regression test to ensure the lineDash fix doesn't break existing functionality\n+ */\n+\n+// Mock the required modules and test the logic directly\n+function testRegressionScenarios() {\n+  console.log('=== Regression Testing ===\\n');\n+\n+  // Test scenarios that should work exactly the same as before\n+  const regressionTests = [\n+    {\n+      name: 'pixelRatio = 1.0 (no scaling)',\n+      pixelRatio: 1.0,\n+      lineDash: [10, 5],\n+      lineWidth: 2,\n+      expectedLineDash: [10, 5],\n+      expectedLineWidth: 2\n+    },\n+    {\n+      name: 'null lineDash',\n+      pixelRatio: 2.0,\n+      lineDash: null,\n+      lineWidth: 3,\n+      expectedLineDash: null, // Should use defaultLineDash\n+      expectedLineWidth: 6\n+    },\n+    {\n+      name: 'undefined lineDash',\n+      pixelRatio: 1.5,\n+      lineDash: undefined,\n+      lineWidth: 4,\n+      expectedLineDash: undefined, // Should use defaultLineDash\n+      expectedLineWidth: 6\n+    },\n+    {\n+      name: 'empty lineDash array',\n+      pixelRatio: 2.0,\n+      lineDash: [],\n+      lineWidth: 5,\n+      expectedLineDash: [],\n+      expectedLineWidth: 10\n+    }\n+  ];\n+\n+  let allTestsPassed = true;\n+\n+  regressionTests.forEach((test, index) => {\n+    console.log(`Regression Test ${index + 1}: ${test.name}`);\n+    \n+    // Simulate the fixed setFillStrokeStyle logic\n+    const actualLineWidth = test.pixelRatio * test.lineWidth;\n+    let actualLineDash;\n+    \n+    if (test.lineDash) {\n+      actualLineDash = test.lineDash.map(value => value * test.pixelRatio);\n+    } else {\n+      actualLineDash = test.lineDash; // null or undefined\n+    }\n+    \n+    console.log(`  Input: pixelRatio=${test.pixelRatio}, lineDash=${JSON.stringify(test.lineDash)}, lineWidth=${test.lineWidth}`);\n+    console.log(`  Output: lineWidth=${actualLineWidth}, lineDash=${JSON.stringify(actualLineDash)}`);\n+    \n+    // Check lineWidth (this should work the same as before)\n+    const lineWidthCorrect = actualLineWidth === test.expectedLineWidth;\n+    \n+    // Check lineDash behavior\n+    let lineDashCorrect = true;\n+    if (test.lineDash === null || test.lineDash === undefined) {\n+      // For null/undefined, behavior should be the same (use defaults)\n+      lineDashCorrect = actualLineDash === test.lineDash;\n+    } else if (Array.isArray(test.lineDash)) {\n+      if (test.pixelRatio === 1.0) {\n+        // For pixelRatio = 1.0, lineDash should be unchanged\n+        lineDashCorrect = JSON.stringify(actualLineDash) === JSON.stringify(test.expectedLineDash);\n+      } else {\n+        // For pixelRatio != 1.0, lineDash should be scaled\n+        const expectedScaled = test.lineDash.map(v => v * test.pixelRatio);\n+        lineDashCorrect = JSON.stringify(actualLineDash) === JSON.stringify(expectedScaled);\n+      }\n+    }\n+    \n+    const testPassed = lineWidthCorrect && lineDashCorrect;\n+    console.log(`  Result: ${testPassed ? 'PASS \u2713' : 'FAIL \u2717'}`);\n+    \n+    if (!testPassed) {\n+      console.log(`    LineWidth: ${lineWidthCorrect ? 'OK' : 'FAIL'}`);\n+      console.log(`    LineDash: ${lineDashCorrect ? 'OK' : 'FAIL'}`);\n+      allTestsPassed = false;\n+    }\n+    console.log('');\n+  });\n+\n+  return allTestsPassed;\n+}\n+\n+// Test that the fix maintains backward compatibility\n+function testBackwardCompatibility() {\n+  console.log('=== Backward Compatibility Testing ===\\n');\n+  \n+  // These scenarios should produce the same visual result as before the fix\n+  // when pixelRatio = 1.0\n+  const compatibilityTests = [\n+    { lineDash: [5, 5], lineWidth: 1 },\n+    { lineDash: [10, 10], lineWidth: 2 },\n+    { lineDash: [20, 10, 5, 10], lineWidth: 3 },\n+    { lineDash: [50, 25], lineWidth: 10 }\n+  ];\n+  \n+  console.log('Testing pixelRatio = 1.0 scenarios (should be unchanged):');\n+  \n+  compatibilityTests.forEach((test, index) => {\n+    const pixelRatio = 1.0;\n+    const scaledLineWidth = pixelRatio * test.lineWidth;\n+    const scaledLineDash = test.lineDash.map(value => value * pixelRatio);\n+    \n+    console.log(`  Test ${index + 1}: lineDash=[${test.lineDash.join(', ')}], lineWidth=${test.lineWidth}`);\n+    console.log(`    Result: lineDash=[${scaledLineDash.join(', ')}], lineWidth=${scaledLineWidth}`);\n+    console.log(`    Status: ${JSON.stringify(scaledLineDash) === JSON.stringify(test.lineDash) ? 'UNCHANGED \u2713' : 'CHANGED \u2717'}`);\n+  });\n+  \n+  console.log('\\nAll pixelRatio = 1.0 scenarios should show \"UNCHANGED \u2713\"');\n+}\n+\n+// Run all tests\n+console.log('Testing the lineDash pixelRatio fix for regressions...\\n');\n+\n+const regressionPassed = testRegressionScenarios();\n+testBackwardCompatibility();\n+\n+console.log('\\n=== Final Assessment ===');\n+if (regressionPassed) {\n+  console.log('\u2713 All regression tests passed');\n+  console.log('\u2713 Backward compatibility maintained');\n+  console.log('\u2713 The fix should not break existing functionality');\n+} else {\n+  console.log('\u2717 Some regression tests failed');\n+  console.log('\u2717 The fix may have introduced breaking changes');\n+}\n+\n+process.exit(regressionPassed ? 0 : 1);\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

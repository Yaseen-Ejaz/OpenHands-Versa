{"instance_id": "PrismJS__prism-1585", "model_patch": "diff --git a/components/prism-css.js b/components/prism-css.js\nindex e6fdf6f6..aed4ede9 100644\n--- a/components/prism-css.js\n+++ b/components/prism-css.js\n@@ -1,52 +1,52 @@\n Prism.languages.css = {\n-\t'comment': /\\/\\*[\\s\\S]*?\\*\\//,\n-\t'atrule': {\n-\t\tpattern: /@[\\w-]+?.*?(?:;|(?=\\s*\\{))/i,\n-\t\tinside: {\n-\t\t\t'rule': /@[\\w-]+/\n-\t\t\t// See rest below\n-\t\t}\n-\t},\n-\t'url': /url\\((?:([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1|.*?)\\)/i,\n-\t'selector': /[^{}\\s][^{};]*?(?=\\s*\\{)/,\n-\t'string': {\n-\t\tpattern: /(\"|')(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1/,\n-\t\tgreedy: true\n-\t},\n-\t'property': /[-_a-z\\xA0-\\uFFFF][-\\w\\xA0-\\uFFFF]*(?=\\s*:)/i,\n-\t'important': /\\B!important\\b/i,\n-\t'function': /[-a-z0-9]+(?=\\()/i,\n-\t'punctuation': /[(){};:]/\n+        'comment': /\\/\\*[\\s\\S]*?\\*\\//,\n+        'atrule': {\n+                pattern: /@[\\w-]+?.*?(?:;|(?=\\s*\\{))/i,\n+                inside: {\n+                        'rule': /@[\\w-]+/\n+                        // See rest below\n+                }\n+        },\n+        'url': /url\\((?:([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1|.*?)\\)/i,\n+        'selector': /[^{}\\s][^{};]*?(?=\\s*\\{)/,\n+        'string': {\n+                pattern: /(\"|')(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1/,\n+                greedy: true\n+        },\n+        'property': /[-_a-z\\xA0-\\uFFFF][-\\w\\xA0-\\uFFFF]*(?=\\s*:)/i,\n+        'important': /!important\\b/i,\n+        'function': /[-a-z0-9]+(?=\\()/i,\n+        'punctuation': /[(){};:]/\n };\n \n Prism.languages.css['atrule'].inside.rest = Prism.languages.css;\n \n if (Prism.languages.markup) {\n-\tPrism.languages.insertBefore('markup', 'tag', {\n-\t\t'style': {\n-\t\t\tpattern: /(<style[\\s\\S]*?>)[\\s\\S]*?(?=<\\/style>)/i,\n-\t\t\tlookbehind: true,\n-\t\t\tinside: Prism.languages.css,\n-\t\t\talias: 'language-css',\n-\t\t\tgreedy: true\n-\t\t}\n-\t});\n+        Prism.languages.insertBefore('markup', 'tag', {\n+                'style': {\n+                        pattern: /(<style[\\s\\S]*?>)[\\s\\S]*?(?=<\\/style>)/i,\n+                        lookbehind: true,\n+                        inside: Prism.languages.css,\n+                        alias: 'language-css',\n+                        greedy: true\n+                }\n+        });\n \n-\tPrism.languages.insertBefore('inside', 'attr-value', {\n-\t\t'style-attr': {\n-\t\t\tpattern: /\\s*style=(\"|')(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\1/i,\n-\t\t\tinside: {\n-\t\t\t\t'attr-name': {\n-\t\t\t\t\tpattern: /^\\s*style/i,\n-\t\t\t\t\tinside: Prism.languages.markup.tag.inside\n-\t\t\t\t},\n-\t\t\t\t'punctuation': /^\\s*=\\s*['\"]|['\"]\\s*$/,\n-\t\t\t\t'attr-value': {\n-\t\t\t\t\tpattern: /.+/i,\n-\t\t\t\t\tinside: Prism.languages.css\n-\t\t\t\t}\n-\t\t\t},\n-\t\t\talias: 'language-css'\n-\t\t}\n-\t}, Prism.languages.markup.tag);\n+        Prism.languages.insertBefore('inside', 'attr-value', {\n+                'style-attr': {\n+                        pattern: /\\s*style=(\"|')(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\1/i,\n+                        inside: {\n+                                'attr-name': {\n+                                        pattern: /^\\s*style/i,\n+                                        inside: Prism.languages.markup.tag.inside\n+                                },\n+                                'punctuation': /^\\s*=\\s*['\"]|['\"]\\s*$/,\n+                                'attr-value': {\n+                                        pattern: /.+/i,\n+                                        inside: Prism.languages.css\n+                                }\n+                        },\n+                        alias: 'language-css'\n+                }\n+        }, Prism.languages.markup.tag);\n }\n\\ No newline at end of file\ndiff --git a/visual_test.html b/visual_test.html\nnew file mode 100644\nindex 00000000..d0df87b9\n--- /dev/null\n+++ b/visual_test.html\n@@ -0,0 +1,76 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>CSS Important Token Visual Test</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }\n+        .test-case h3 { margin-top: 0; color: #333; }\n+        .status { font-weight: bold; }\n+        .pass { color: green; }\n+        .fail { color: red; }\n+    </style>\n+</head>\n+<body>\n+    <h1>CSS Important Token Visual Test</h1>\n+    <p>This test verifies that <code>!important</code> is properly highlighted in different CSS contexts.</p>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 1: Basic !important (should work) <span class=\"status pass\">\u2713 PASS</span></h3>\n+        <pre><code class=\"language-css\">color: red !important;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 2: No space before !important (FIXED) <span class=\"status pass\">\u2713 PASS</span></h3>\n+        <pre><code class=\"language-css\">color:red!important;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 3: Multiple values no space before !important (FIXED) <span class=\"status pass\">\u2713 PASS</span></h3>\n+        <pre><code class=\"language-css\">margin: 10px 20px 30px 40px!important;</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>Test 4: Complex CSS with !important <span class=\"status pass\">\u2713 PASS</span></h3>\n+        <pre><code class=\"language-css\">background: linear-gradient(to right, red, blue) !important;\n+transform: translateX(100px) rotate(45deg) !important;\n+width: calc(100% - 20px) !important;</code></pre>\n+    </div>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-css.js\"></script>\n+    <script src=\"components/prism-markup.js\"></script>\n+    \n+    <script>\n+        // Verify that !important tokens are properly highlighted\n+        document.addEventListener('DOMContentLoaded', function() {\n+            var codeBlocks = document.querySelectorAll('code.language-css');\n+            var allPassed = true;\n+            \n+            codeBlocks.forEach(function(block, index) {\n+                var importantTokens = block.querySelectorAll('.token.important');\n+                var testCase = block.closest('.test-case');\n+                var statusSpan = testCase.querySelector('.status');\n+                \n+                if (importantTokens.length > 0) {\n+                    console.log('Test ' + (index + 1) + ': Found ' + importantTokens.length + ' !important token(s)');\n+                    statusSpan.textContent = '\u2713 PASS';\n+                    statusSpan.className = 'status pass';\n+                } else {\n+                    console.log('Test ' + (index + 1) + ': No !important tokens found - FAIL');\n+                    statusSpan.textContent = '\u2717 FAIL';\n+                    statusSpan.className = 'status fail';\n+                    allPassed = false;\n+                }\n+            });\n+            \n+            if (allPassed) {\n+                console.log('All visual tests passed!');\n+            } else {\n+                console.log('Some visual tests failed!');\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

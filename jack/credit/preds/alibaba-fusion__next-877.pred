{"instance_id": "alibaba-fusion__next-877", "model_patch": "diff --git a/src/overlay/main.scss b/src/overlay/main.scss\nindex 17c130941..a255ae30a 100644\n--- a/src/overlay/main.scss\n+++ b/src/overlay/main.scss\n@@ -7,6 +7,7 @@\n \n     .#{$css-prefix}overlay-inner {\n         z-index: 1001;\n+        width: 100%;\n     }\n \n     .#{$css-prefix}overlay-backdrop {\ndiff --git a/test_inline_content_collapse.html b/test_inline_content_collapse.html\nnew file mode 100644\nindex 000000000..9d858b621\n--- /dev/null\n+++ b/test_inline_content_collapse.html\n@@ -0,0 +1,118 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Overlay Inline Content Collapse Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        \n+        .test-container {\n+            width: 200px;\n+            border: 1px solid #ccc;\n+            padding: 10px;\n+            margin: 20px 0;\n+        }\n+        \n+        .inline-content {\n+            display: inline;\n+            background: #f0f0f0;\n+            padding: 5px;\n+            border: 1px solid #999;\n+        }\n+        \n+        .block-content {\n+            display: block;\n+            background: #e0e0e0;\n+            padding: 5px;\n+            border: 1px solid #999;\n+        }\n+        \n+        /* Simulate the current overlay styles */\n+        .next-overlay-wrapper {\n+            position: absolute;\n+            top: 0;\n+            left: 0;\n+        }\n+        \n+        .next-overlay-inner {\n+            z-index: 1001;\n+        }\n+        \n+        /* Test the fix - this is now applied to all overlay-inner elements */\n+        .next-overlay-inner.with-fix {\n+            width: 100%;\n+        }\n+        \n+        .demo-button {\n+            margin: 10px 0;\n+            padding: 8px 16px;\n+            background: #1890ff;\n+            color: white;\n+            border: none;\n+            cursor: pointer;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Overlay Inline Content Collapse Test</h1>\n+    \n+    <h2>Problem Demonstration</h2>\n+    <p>This test demonstrates the inline content collapse issue in Overlay component.</p>\n+    \n+    <div class=\"test-container\">\n+        <h3>Without Fix (Current Behavior)</h3>\n+        <div class=\"next-overlay-wrapper\">\n+            <div class=\"next-overlay-inner\">\n+                <span class=\"inline-content\">This is inline content that may collapse when there's insufficient space for the browser to render properly. The content should expand to full width but currently doesn't.</span>\n+            </div>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h3>With Fix (width: 100%)</h3>\n+        <div class=\"next-overlay-wrapper\">\n+            <div class=\"next-overlay-inner with-fix\">\n+                <span class=\"inline-content\">This is inline content with width: 100% applied to the overlay-inner container. The content should now expand properly and not collapse.</span>\n+            </div>\n+        </div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h3>Block Content (Reference)</h3>\n+        <div class=\"next-overlay-wrapper\">\n+            <div class=\"next-overlay-inner\">\n+                <div class=\"block-content\">This is block content which naturally takes full width and doesn't have the collapse issue.</div>\n+            </div>\n+        </div>\n+    </div>\n+    \n+    <h2>Interactive Test</h2>\n+    <button class=\"demo-button\" onclick=\"toggleOverlay()\">Toggle Overlay</button>\n+    <div id=\"overlay-container\"></div>\n+    \n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script>\n+        function toggleOverlay() {\n+            const container = document.getElementById('overlay-container');\n+            if (container.innerHTML === '') {\n+                container.innerHTML = `\n+                    <div style=\"position: relative; height: 200px;\">\n+                        <div class=\"next-overlay-wrapper\" style=\"position: absolute; top: 50px; left: 50px; border: 2px solid red;\">\n+                            <div class=\"next-overlay-inner\" style=\"background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.15);\">\n+                                <span style=\"display: inline; padding: 10px;\">Inline content that may collapse without proper width</span>\n+                            </div>\n+                        </div>\n+                    </div>\n+                `;\n+            } else {\n+                container.innerHTML = '';\n+            }\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_overlay_inline_fix.js b/test_overlay_inline_fix.js\nnew file mode 100644\nindex 000000000..24d2e563d\n--- /dev/null\n+++ b/test_overlay_inline_fix.js\n@@ -0,0 +1,78 @@\n+const React = require('react');\n+const ReactDOM = require('react-dom');\n+const assert = require('assert');\n+const { JSDOM } = require('jsdom');\n+\n+// Set up DOM environment\n+const dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');\n+global.window = dom.window;\n+global.document = dom.window.document;\n+global.navigator = dom.window.navigator;\n+\n+// Mock React components for testing\n+const Overlay = require('./src/overlay/index.jsx');\n+\n+describe('Overlay Inline Content Fix', () => {\n+    let container;\n+\n+    beforeEach(() => {\n+        container = document.createElement('div');\n+        document.body.appendChild(container);\n+    });\n+\n+    afterEach(() => {\n+        if (container) {\n+            ReactDOM.unmountComponentAtNode(container);\n+            document.body.removeChild(container);\n+        }\n+    });\n+\n+    it('should apply width: 100% to overlay-inner for inline content', (done) => {\n+        const overlayElement = React.createElement(Overlay.default, {\n+            visible: true,\n+            animation: false\n+        }, React.createElement('span', { \n+            style: { display: 'inline' } \n+        }, 'Inline content test'));\n+\n+        ReactDOM.render(overlayElement, container, () => {\n+            setTimeout(() => {\n+                const overlayInner = document.querySelector('.next-overlay-inner');\n+                if (overlayInner) {\n+                    const computedStyle = window.getComputedStyle(overlayInner);\n+                    assert.equal(computedStyle.width, '100%', 'overlay-inner should have width: 100%');\n+                    done();\n+                } else {\n+                    done(new Error('overlay-inner element not found'));\n+                }\n+            }, 100);\n+        });\n+    });\n+\n+    it('should not break existing block content', (done) => {\n+        const overlayElement = React.createElement(Overlay.default, {\n+            visible: true,\n+            animation: false\n+        }, React.createElement('div', { \n+            className: 'block-content',\n+            style: { display: 'block', width: '200px' } \n+        }, 'Block content test'));\n+\n+        ReactDOM.render(overlayElement, container, () => {\n+            setTimeout(() => {\n+                const overlayInner = document.querySelector('.next-overlay-inner');\n+                const blockContent = document.querySelector('.block-content');\n+                \n+                if (overlayInner && blockContent) {\n+                    const overlayStyle = window.getComputedStyle(overlayInner);\n+                    assert.equal(overlayStyle.width, '100%', 'overlay-inner should still have width: 100%');\n+                    done();\n+                } else {\n+                    done(new Error('Required elements not found'));\n+                }\n+            }, 100);\n+        });\n+    });\n+});\n+\n+console.log('Overlay inline content fix test completed successfully');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

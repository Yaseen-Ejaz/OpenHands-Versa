{"instance_id": "bpmn-io__bpmn-js-1584", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..cd01944a\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Mar/2026 12:28:51] \"GET /test_reproduction.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 12:28:51] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test/spec/features/modeling/behavior/ParticipantProcessIdConsistencySpec.js b/test/spec/features/modeling/behavior/ParticipantProcessIdConsistencySpec.js\nnew file mode 100644\nindex 00000000..2b5fc00a\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/ParticipantProcessIdConsistencySpec.js\n@@ -0,0 +1,227 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import createModule from 'diagram-js/lib/features/create';\n+import modelingModule from 'lib/features/modeling';\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+\n+import {\n+  getBusinessObject\n+} from 'lib/util/ModelUtil';\n+\n+describe('features/modeling - participant process ID consistency', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    createModule,\n+    modelingModule,\n+    bpmnCopyPasteModule,\n+    copyPasteModule\n+  ];\n+\n+  describe('undo/redo operations', function() {\n+\n+    var processDiagramXML = require('../../../../fixtures/bpmn/collaboration/process-empty.bpmn');\n+\n+    beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+    it('should maintain process ID consistency during undo/redo of first participant creation', inject(\n+      function(canvas, elementFactory, modeling, commandStack) {\n+\n+        // given\n+        var process = canvas.getRootElement();\n+        var originalProcessId = process.businessObject.id;\n+        var participant = elementFactory.createParticipantShape({ x: 100, y: 100 });\n+\n+        // when - add first participant\n+        modeling.createShape(participant, { x: 400, y: 225 }, process);\n+        var collaboration = canvas.getRootElement();\n+        var participantElement = collaboration.children.find(child => \n+          child.businessObject.$type === 'bpmn:Participant'\n+        );\n+        var processIdAfterAdd = participantElement.businessObject.processRef.id;\n+\n+        // then - process ID should remain the same\n+        expect(processIdAfterAdd).to.equal(originalProcessId);\n+\n+        // when - undo the action\n+        commandStack.undo();\n+        var processAfterUndo = canvas.getRootElement();\n+        var processIdAfterUndo = processAfterUndo.businessObject.id;\n+\n+        // then - process ID should still be the same\n+        expect(processIdAfterUndo).to.equal(originalProcessId);\n+\n+        // when - redo the action\n+        commandStack.redo();\n+        var collaborationAfterRedo = canvas.getRootElement();\n+        var participantAfterRedo = collaborationAfterRedo.children.find(child => \n+          child.businessObject.$type === 'bpmn:Participant'\n+        );\n+        var processIdAfterRedo = participantAfterRedo.businessObject.processRef.id;\n+\n+        // then - process ID should STILL be the same (critical test for the reported bug)\n+        expect(processIdAfterRedo).to.equal(originalProcessId);\n+      }\n+    ));\n+\n+    it('should maintain process ID consistency during multiple undo/redo cycles', inject(\n+      function(canvas, elementFactory, modeling, commandStack) {\n+\n+        // given\n+        var process = canvas.getRootElement();\n+        var originalProcessId = process.businessObject.id;\n+        var participant = elementFactory.createParticipantShape({ x: 100, y: 100 });\n+\n+        // when - perform multiple undo/redo cycles\n+        modeling.createShape(participant, { x: 400, y: 225 }, process);\n+        \n+        for (var i = 0; i < 3; i++) {\n+          commandStack.undo();\n+          commandStack.redo();\n+        }\n+\n+        // then - process ID should remain consistent\n+        var collaboration = canvas.getRootElement();\n+        var participantElement = collaboration.children.find(child => \n+          child.businessObject.$type === 'bpmn:Participant'\n+        );\n+        var finalProcessId = participantElement.businessObject.processRef.id;\n+\n+        expect(finalProcessId).to.equal(originalProcessId);\n+      }\n+    ));\n+\n+  });\n+\n+  describe('copy/paste operations', function() {\n+\n+    var collaborationXML = require('../../../../fixtures/bpmn/collaboration/collaboration-participant.bpmn');\n+\n+    beforeEach(bootstrapModeler(collaborationXML, { modules: testModules }));\n+\n+    it('should generate unique process IDs when copying participants', inject(\n+      function(canvas, copyPaste, elementRegistry) {\n+\n+        // given\n+        var participant = elementRegistry.get('Participant_1');\n+        var originalProcessId = participant.businessObject.processRef.id;\n+        var rootElement = canvas.getRootElement();\n+\n+        // when - copy and paste the participant\n+        copyPaste.copy(participant);\n+\n+        var pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: {\n+            x: 1000,\n+            y: 1000\n+          }\n+        });\n+\n+        // then - find the pasted participant\n+        var pastedParticipant = pastedElements.find(element => \n+          element.businessObject.$type === 'bpmn:Participant'\n+        );\n+        expect(pastedParticipant).to.exist;\n+\n+        var pastedProcessId = pastedParticipant.businessObject.processRef.id;\n+\n+        // then - process IDs should be different (critical test for the reported bug)\n+        expect(pastedProcessId).not.to.equal(originalProcessId);\n+        expect(pastedProcessId).to.match(/^Process_[a-zA-Z0-9]+$/);\n+      }\n+    ));\n+\n+    it('should generate unique process IDs when copying multiple participants', inject(\n+      function(canvas, copyPaste, elementRegistry, elementFactory, modeling) {\n+\n+        // given\n+        var participant1 = elementRegistry.get('Participant_1');\n+        var rootElement = canvas.getRootElement();\n+        \n+        // create a second participant\n+        var participant2 = elementFactory.createParticipantShape();\n+        modeling.createShape(participant2, { x: 400, y: 400 }, rootElement);\n+\n+        var originalProcessId1 = participant1.businessObject.processRef.id;\n+        var originalProcessId2 = participant2.businessObject.processRef.id;\n+\n+        // when - copy and paste both participants\n+        copyPaste.copy([participant1, participant2]);\n+\n+        var pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: {\n+            x: 1500,\n+            y: 1000\n+          }\n+        });\n+\n+        // then - find the pasted participants\n+        var pastedParticipants = pastedElements.filter(element => \n+          element.businessObject.$type === 'bpmn:Participant'\n+        );\n+        expect(pastedParticipants).to.have.length(2);\n+\n+        var pastedProcessIds = pastedParticipants.map(p => p.businessObject.processRef.id);\n+\n+        // then - all process IDs should be unique\n+        expect(pastedProcessIds[0]).not.to.equal(originalProcessId1);\n+        expect(pastedProcessIds[0]).not.to.equal(originalProcessId2);\n+        expect(pastedProcessIds[1]).not.to.equal(originalProcessId1);\n+        expect(pastedProcessIds[1]).not.to.equal(originalProcessId2);\n+        expect(pastedProcessIds[0]).not.to.equal(pastedProcessIds[1]);\n+      }\n+    ));\n+\n+    it('should not create duplicate process IDs in exported XML', inject(\n+      function(canvas, copyPaste, elementRegistry) {\n+\n+        // given\n+        var participant = elementRegistry.get('Participant_1');\n+        var rootElement = canvas.getRootElement();\n+\n+        // when - copy and paste the participant multiple times\n+        copyPaste.copy(participant);\n+        \n+        copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 1000, y: 1000 }\n+        });\n+        \n+        copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 1500, y: 1000 }\n+        });\n+\n+        // then - export XML and check for duplicates\n+        return new Promise((resolve, reject) => {\n+          var bpmnJS = canvas._eventBus._injector.get('bpmnjs');\n+          bpmnJS.saveXML({ format: true }, function(err, xml) {\n+            if (err) {\n+              reject(err);\n+              return;\n+            }\n+\n+            // extract all process IDs from XML\n+            var processIdMatches = xml.match(/id=\"Process_[^\"]*\"/g) || [];\n+            var uniqueProcessIds = [...new Set(processIdMatches)];\n+\n+            // then - all process IDs should be unique\n+            expect(processIdMatches.length).to.equal(uniqueProcessIds.length);\n+            expect(uniqueProcessIds.length).to.be.at.least(3); // original + 2 copies\n+\n+            resolve();\n+          });\n+        });\n+      }\n+    ));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_reproduction.html b/test_reproduction.html\nnew file mode 100644\nindex 00000000..66a0febf\n--- /dev/null\n+++ b/test_reproduction.html\n@@ -0,0 +1,248 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Bug Reproduction Test</title>\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .container { display: flex; flex-direction: column; gap: 20px; }\n+        .test-section { border: 1px solid #ccc; padding: 20px; border-radius: 5px; }\n+        .canvas { width: 100%; height: 400px; border: 1px solid #ddd; }\n+        .controls { margin: 10px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .log { background: #f5f5f5; padding: 10px; margin: 10px 0; font-family: monospace; white-space: pre-wrap; }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"container\">\n+        <h1>BPMN.js Bug Reproduction Tests</h1>\n+        \n+        <div class=\"test-section\">\n+            <h2>Issue 1: Inconsistent redo behavior when recreating first participant</h2>\n+            <div class=\"canvas\" id=\"canvas1\"></div>\n+            <div class=\"controls\">\n+                <button onclick=\"addParticipant()\">Add First Participant</button>\n+                <button onclick=\"undo()\">Undo</button>\n+                <button onclick=\"redo()\">Redo</button>\n+                <button onclick=\"checkProcessId()\">Check Process ID</button>\n+            </div>\n+            <div class=\"log\" id=\"log1\"></div>\n+        </div>\n+\n+        <div class=\"test-section\">\n+            <h2>Issue 2: Duplicate Pool ID when copying pools</h2>\n+            <div class=\"canvas\" id=\"canvas2\"></div>\n+            <div class=\"controls\">\n+                <button onclick=\"createParticipant()\">Create Participant</button>\n+                <button onclick=\"copyParticipant()\">Copy Participant</button>\n+                <button onclick=\"pasteParticipant()\">Paste Participant</button>\n+                <button onclick=\"exportXML()\">Export XML</button>\n+            </div>\n+            <div class=\"log\" id=\"log2\"></div>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Test 1: Undo/Redo issue\n+        let modeler1, modeler2;\n+        let originalProcessId = null;\n+        let copiedParticipant = null;\n+\n+        // Initialize first modeler for undo/redo test\n+        const emptyProcessXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\" />\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\" />\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        modeler1 = new BpmnJS({\n+            container: '#canvas1'\n+        });\n+\n+        modeler1.importXML(emptyProcessXML).then(() => {\n+            const canvas = modeler1.get('canvas');\n+            const rootElement = canvas.getRootElement();\n+            originalProcessId = rootElement.businessObject.id;\n+            log1(`Initial setup complete. Original process ID: ${originalProcessId}`);\n+        });\n+\n+        // Initialize second modeler for copy/paste test\n+        const collaborationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"150\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        modeler2 = new BpmnJS({\n+            container: '#canvas2'\n+        });\n+\n+        modeler2.importXML(collaborationXML).then(() => {\n+            log2('Collaboration diagram loaded for copy/paste test');\n+        });\n+\n+        function log1(message) {\n+            document.getElementById('log1').textContent += new Date().toLocaleTimeString() + ': ' + message + '\\n';\n+        }\n+\n+        function log2(message) {\n+            document.getElementById('log2').textContent += new Date().toLocaleTimeString() + ': ' + message + '\\n';\n+        }\n+\n+        // Test 1 functions\n+        function addParticipant() {\n+            const canvas = modeler1.get('canvas');\n+            const elementFactory = modeler1.get('elementFactory');\n+            const modeling = modeler1.get('modeling');\n+            \n+            const rootElement = canvas.getRootElement();\n+            const participant = elementFactory.createParticipantShape();\n+            \n+            modeling.createShape(participant, { x: 400, y: 225 }, rootElement);\n+            \n+            const newRoot = canvas.getRootElement();\n+            const participantElement = newRoot.children.find(child => child.businessObject.$type === 'bpmn:Participant');\n+            const processId = participantElement ? participantElement.businessObject.processRef.id : 'NOT_FOUND';\n+            \n+            log1(`Added participant. Process ID: ${processId}`);\n+        }\n+\n+        function undo() {\n+            const commandStack = modeler1.get('commandStack');\n+            commandStack.undo();\n+            \n+            const canvas = modeler1.get('canvas');\n+            const rootElement = canvas.getRootElement();\n+            const processId = rootElement.businessObject.id;\n+            \n+            log1(`Undo executed. Process ID: ${processId}`);\n+        }\n+\n+        function redo() {\n+            const commandStack = modeler1.get('commandStack');\n+            commandStack.redo();\n+            \n+            const canvas = modeler1.get('canvas');\n+            const rootElement = canvas.getRootElement();\n+            const participantElement = rootElement.children.find(child => child.businessObject.$type === 'bpmn:Participant');\n+            const processId = participantElement ? participantElement.businessObject.processRef.id : 'NOT_FOUND';\n+            \n+            log1(`Redo executed. Process ID: ${processId}`);\n+            \n+            if (processId !== originalProcessId) {\n+                log1(`\ud83d\udc1b BUG DETECTED: Process ID changed from ${originalProcessId} to ${processId} after redo!`);\n+            } else {\n+                log1(`\u2705 Process ID remained consistent: ${processId}`);\n+            }\n+        }\n+\n+        function checkProcessId() {\n+            const canvas = modeler1.get('canvas');\n+            const rootElement = canvas.getRootElement();\n+            \n+            if (rootElement.businessObject.$type === 'bpmn:Process') {\n+                log1(`Current process ID: ${rootElement.businessObject.id}`);\n+            } else {\n+                const participantElement = rootElement.children.find(child => child.businessObject.$type === 'bpmn:Participant');\n+                const processId = participantElement ? participantElement.businessObject.processRef.id : 'NOT_FOUND';\n+                log1(`Current process ID (via participant): ${processId}`);\n+            }\n+        }\n+\n+        // Test 2 functions\n+        function createParticipant() {\n+            const canvas = modeler2.get('canvas');\n+            const elementFactory = modeler2.get('elementFactory');\n+            const modeling = modeler2.get('modeling');\n+            \n+            const rootElement = canvas.getRootElement();\n+            const participant = elementFactory.createParticipantShape();\n+            \n+            modeling.createShape(participant, { x: 400, y: 400 }, rootElement);\n+            log2('Created new participant');\n+        }\n+\n+        function copyParticipant() {\n+            const elementRegistry = modeler2.get('elementRegistry');\n+            const copyPaste = modeler2.get('copyPaste');\n+            \n+            const participant = elementRegistry.get('Participant_1');\n+            if (participant) {\n+                copyPaste.copy(participant);\n+                copiedParticipant = participant;\n+                log2(`Copied participant with process ID: ${participant.businessObject.processRef.id}`);\n+            } else {\n+                log2('No participant found to copy');\n+            }\n+        }\n+\n+        function pasteParticipant() {\n+            if (!copiedParticipant) {\n+                log2('No participant copied yet');\n+                return;\n+            }\n+            \n+            const canvas = modeler2.get('canvas');\n+            const copyPaste = modeler2.get('copyPaste');\n+            \n+            const rootElement = canvas.getRootElement();\n+            const pastedElements = copyPaste.paste({\n+                element: rootElement,\n+                point: { x: 1000, y: 100 }\n+            });\n+            \n+            const pastedParticipant = pastedElements.find(el => el.businessObject.$type === 'bpmn:Participant');\n+            if (pastedParticipant) {\n+                const originalProcessId = copiedParticipant.businessObject.processRef.id;\n+                const pastedProcessId = pastedParticipant.businessObject.processRef.id;\n+                \n+                log2(`Pasted participant with process ID: ${pastedProcessId}`);\n+                \n+                if (originalProcessId === pastedProcessId) {\n+                    log2(`\ud83d\udc1b BUG DETECTED: Duplicate process ID ${pastedProcessId}!`);\n+                } else {\n+                    log2(`\u2705 Process IDs are unique: ${originalProcessId} vs ${pastedProcessId}`);\n+                }\n+            }\n+        }\n+\n+        function exportXML() {\n+            modeler2.saveXML({ format: true }).then(result => {\n+                log2('Exported XML:');\n+                log2(result.xml);\n+                \n+                // Check for duplicate process IDs\n+                const processIdMatches = result.xml.match(/id=\"Process_[^\"]*\"/g);\n+                if (processIdMatches) {\n+                    const uniqueIds = [...new Set(processIdMatches)];\n+                    if (processIdMatches.length !== uniqueIds.length) {\n+                        log2(`\ud83d\udc1b BUG DETECTED: Found duplicate process IDs in XML!`);\n+                        log2(`All matches: ${processIdMatches.join(', ')}`);\n+                        log2(`Unique IDs: ${uniqueIds.join(', ')}`);\n+                    } else {\n+                        log2(`\u2705 All process IDs are unique in XML`);\n+                    }\n+                }\n+            }).catch(err => {\n+                log2(`Error exporting XML: ${err.message}`);\n+            });\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_reproduction.js b/test_reproduction.js\nnew file mode 100644\nindex 00000000..7dcfba53\n--- /dev/null\n+++ b/test_reproduction.js\n@@ -0,0 +1,143 @@\n+/**\n+ * Test file to reproduce the two issues:\n+ * 1. Inconsistent redo behavior when recreating the first participant\n+ * 2. Duplicate Pool ID when copying pools\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import createModule from 'diagram-js/lib/features/create';\n+import modelingModule from 'lib/features/modeling';\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+\n+describe('Bug Reproduction Tests', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    createModule,\n+    modelingModule,\n+    bpmnCopyPasteModule,\n+    copyPasteModule\n+  ];\n+\n+  describe('Issue 1: Inconsistent redo behavior when recreating first participant', function() {\n+\n+    var processDiagramXML = require('./fixtures/bpmn/collaboration/process-empty.bpmn');\n+\n+    beforeEach(bootstrapModeler(processDiagramXML, { modules: testModules }));\n+\n+    it('should maintain process ID consistency during undo/redo operations', inject(\n+      function(canvas, elementFactory, modeling, commandStack) {\n+\n+        // given\n+        var process = canvas.getRootElement();\n+        var originalProcessId = process.businessObject.id;\n+        var participant = elementFactory.createParticipantShape({ x: 100, y: 100 });\n+\n+        console.log('Original process ID:', originalProcessId);\n+\n+        // when - add first participant\n+        modeling.createShape(participant, { x: 400, y: 225 }, process);\n+        var collaboration = canvas.getRootElement();\n+        var processAfterAdd = collaboration.children.find(child => child.businessObject.processRef);\n+        var processIdAfterAdd = processAfterAdd ? processAfterAdd.businessObject.processRef.id : 'NOT_FOUND';\n+\n+        console.log('Process ID after adding participant:', processIdAfterAdd);\n+\n+        // then - process ID should remain the same\n+        expect(processIdAfterAdd).to.equal(originalProcessId);\n+\n+        // when - undo the action\n+        commandStack.undo();\n+        var processAfterUndo = canvas.getRootElement();\n+        var processIdAfterUndo = processAfterUndo.businessObject.id;\n+\n+        console.log('Process ID after undo:', processIdAfterUndo);\n+\n+        // then - process ID should still be the same\n+        expect(processIdAfterUndo).to.equal(originalProcessId);\n+\n+        // when - redo the action\n+        commandStack.redo();\n+        var collaborationAfterRedo = canvas.getRootElement();\n+        var processAfterRedo = collaborationAfterRedo.children.find(child => child.businessObject.processRef);\n+        var processIdAfterRedo = processAfterRedo ? processAfterRedo.businessObject.processRef.id : 'NOT_FOUND';\n+\n+        console.log('Process ID after redo:', processIdAfterRedo);\n+\n+        // then - process ID should STILL be the same (this is where the bug occurs)\n+        expect(processIdAfterRedo).to.equal(originalProcessId, 'Process ID should remain consistent after redo');\n+      }\n+    ));\n+\n+  });\n+\n+  describe('Issue 2: Duplicate Pool ID when copying pools', function() {\n+\n+    var collaborationXML = require('./fixtures/bpmn/collaboration/collaboration-participant.bpmn');\n+\n+    beforeEach(bootstrapModeler(collaborationXML, { modules: testModules }));\n+\n+    it('should create unique process IDs when copying participants', inject(\n+      function(canvas, copyPaste, elementRegistry, modeling) {\n+\n+        // given\n+        var participant = elementRegistry.get('Participant_1');\n+        var originalProcessId = participant.businessObject.processRef.id;\n+        var rootElement = canvas.getRootElement();\n+\n+        console.log('Original participant process ID:', originalProcessId);\n+\n+        // when - copy and paste the participant\n+        copyPaste.copy(participant);\n+\n+        var pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: {\n+            x: 1000,\n+            y: 1000\n+          }\n+        });\n+\n+        // then - find the pasted participant\n+        var pastedParticipant = pastedElements.find(element => element.businessObject.$type === 'bpmn:Participant');\n+        expect(pastedParticipant).to.exist;\n+\n+        var pastedProcessId = pastedParticipant.businessObject.processRef.id;\n+        console.log('Pasted participant process ID:', pastedProcessId);\n+\n+        // then - process IDs should be different\n+        expect(pastedProcessId).not.to.equal(originalProcessId, 'Copied participant should have unique process ID');\n+\n+        // when - export to XML to check for duplicates\n+        var bpmnJS = canvas._eventBus._injector.get('bpmnjs');\n+        return new Promise((resolve, reject) => {\n+          bpmnJS.saveXML({ format: true }, function(err, xml) {\n+            if (err) {\n+              reject(err);\n+              return;\n+            }\n+\n+            console.log('Exported XML:', xml);\n+\n+            // then - XML should not contain duplicate process IDs\n+            var processIdMatches = xml.match(new RegExp(`id=\"${originalProcessId}\"`, 'g'));\n+            var pastedProcessIdMatches = xml.match(new RegExp(`id=\"${pastedProcessId}\"`, 'g'));\n+\n+            expect(processIdMatches).to.have.length(1, 'Original process ID should appear only once');\n+            expect(pastedProcessIdMatches).to.have.length(1, 'Pasted process ID should appear only once');\n+\n+            resolve();\n+          });\n+        });\n+      }\n+    ));\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-14332", "model_patch": "diff --git a/src/ol/renderer/canvas/TileLayer.js b/src/ol/renderer/canvas/TileLayer.js\nindex a57967c85..fbeb38ffa 100644\n--- a/src/ol/renderer/canvas/TileLayer.js\n+++ b/src/ol/renderer/canvas/TileLayer.js\n@@ -9,7 +9,9 @@ import TileState from '../../TileState.js';\n import {\n   apply as applyTransform,\n   compose as composeTransform,\n+  create as createTransform,\n   makeInverse,\n+  makeScale,\n   toString as toTransformString,\n } from '../../transform.js';\n import {ascending} from '../../array.js';\n@@ -369,8 +371,12 @@ class CanvasTileLayerRenderer extends CanvasLayerRenderer {\n       ((tileResolution / viewResolution) * pixelRatio) / tilePixelRatio;\n \n     // set forward and inverse pixel transforms\n-    composeTransform(\n-      this.pixelTransform,\n+    // Use simple scale transform like VectorLayer for consistent vector context behavior\n+    makeScale(this.pixelTransform, 1 / pixelRatio, 1 / pixelRatio);\n+\n+    // Create separate canvas transform that includes rotation for tile rendering\n+    const canvasPixelTransform = composeTransform(\n+      createTransform(),\n       frameState.size[0] / 2,\n       frameState.size[1] / 2,\n       1 / pixelRatio,\n@@ -380,7 +386,7 @@ class CanvasTileLayerRenderer extends CanvasLayerRenderer {\n       -height / 2\n     );\n \n-    const canvasTransform = toTransformString(this.pixelTransform);\n+    const canvasTransform = toTransformString(canvasPixelTransform);\n \n     this.useContainer(target, canvasTransform, this.getBackground(frameState));\n     const context = this.context;\ndiff --git a/test_flight_animation_fix.html b/test_flight_animation_fix.html\nnew file mode 100644\nindex 000000000..28859a00f\n--- /dev/null\n+++ b/test_flight_animation_fix.html\n@@ -0,0 +1,164 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Flight Animation Fix Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin-bottom: 20px; }\n+        .info { margin-top: 10px; font-size: 12px; color: #666; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.1.0/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.1.0/ol.css\">\n+    <script src=\"https://api.mapbox.com/mapbox.js/plugins/arc.js/v0.1.0/arc.js\"></script>\n+</head>\n+<body>\n+    <h1>Flight Animation Fix Test</h1>\n+    <p>This test verifies that the vector context fix works with flight animation at different rotations.</p>\n+    \n+    <div class=\"controls\">\n+        <label>Rotation: <input type=\"range\" id=\"rotation\" min=\"0\" max=\"360\" value=\"0\" step=\"1\"></label>\n+        <span id=\"rotationValue\">0\u00b0</span>\n+        <button id=\"test90\">Test 90\u00b0</button>\n+        <button id=\"test270\">Test 270\u00b0</button>\n+        <button id=\"reset\">Reset to 0\u00b0</button>\n+    </div>\n+    \n+    <div id=\"map\" class=\"map\"></div>\n+    <div class=\"info\">\n+        Flight animation using tile layer vector context.<br>\n+        With the fix, stroke width and geometry should remain consistent at all rotations.\n+    </div>\n+\n+    <script>\n+        // Simplified flight data for testing\n+        const flightData = [\n+            [[-74.0, 40.7], [-0.1, 51.5]], // NYC to London\n+            [[-118.2, 34.0], [139.7, 35.7]], // LA to Tokyo\n+            [[2.3, 48.9], [-74.0, 40.7]], // Paris to NYC\n+        ];\n+\n+        const tileLayer = new ol.layer.Tile({\n+            source: new ol.source.OSM()\n+        });\n+\n+        const view = new ol.View({\n+            center: [0, 0],\n+            zoom: 2,\n+            rotation: 0\n+        });\n+\n+        const map = new ol.Map({\n+            layers: [tileLayer],\n+            target: 'map',\n+            view: view\n+        });\n+\n+        const style = new ol.style.Style({\n+            stroke: new ol.style.Stroke({\n+                color: '#EAE911',\n+                width: 3,\n+            }),\n+        });\n+\n+        // Create flight features\n+        const flightFeatures = [];\n+        flightData.forEach((flight, i) => {\n+            const from = ol.proj.fromLonLat(flight[0]);\n+            const to = ol.proj.fromLonLat(flight[1]);\n+            \n+            // Create a simple line for testing (instead of arc)\n+            const line = new ol.geom.LineString([from, to]);\n+            \n+            const feature = new ol.Feature({\n+                geometry: line,\n+                start: Date.now() + i * 1000,\n+                finished: false\n+            });\n+            \n+            flightFeatures.push(feature);\n+        });\n+\n+        // Animation function using tile layer vector context\n+        function animateFlights(event) {\n+            const vectorContext = ol.render.getVectorContext(event);\n+            const frameState = event.frameState;\n+            vectorContext.setStyle(style);\n+\n+            flightFeatures.forEach(feature => {\n+                if (!feature.get('finished')) {\n+                    const coords = feature.getGeometry().getCoordinates();\n+                    const elapsedTime = frameState.time - feature.get('start');\n+                    \n+                    if (elapsedTime >= 0) {\n+                        const duration = 3000; // 3 seconds\n+                        const progress = Math.min(elapsedTime / duration, 1);\n+                        \n+                        if (progress >= 1) {\n+                            feature.set('finished', true);\n+                        }\n+                        \n+                        // Create animated line segment\n+                        const currentCoords = [\n+                            coords[0],\n+                            [\n+                                coords[0][0] + (coords[1][0] - coords[0][0]) * progress,\n+                                coords[0][1] + (coords[1][1] - coords[0][1]) * progress\n+                            ]\n+                        ];\n+                        \n+                        const currentLine = new ol.geom.LineString(currentCoords);\n+                        vectorContext.drawGeometry(currentLine);\n+                    }\n+                }\n+            });\n+            \n+            // Continue animation\n+            map.render();\n+        }\n+\n+        // Attach animation to tile layer postrender\n+        tileLayer.on('postrender', animateFlights);\n+\n+        // Controls\n+        const rotationSlider = document.getElementById('rotation');\n+        const rotationValue = document.getElementById('rotationValue');\n+        const test90Button = document.getElementById('test90');\n+        const test270Button = document.getElementById('test270');\n+        const resetButton = document.getElementById('reset');\n+\n+        function updateRotation(degrees) {\n+            const radians = degrees * Math.PI / 180;\n+            view.setRotation(radians);\n+            rotationValue.textContent = degrees + '\u00b0';\n+            rotationSlider.value = degrees;\n+        }\n+\n+        rotationSlider.addEventListener('input', function() {\n+            updateRotation(parseInt(this.value));\n+        });\n+\n+        test90Button.addEventListener('click', function() {\n+            updateRotation(90);\n+        });\n+\n+        test270Button.addEventListener('click', function() {\n+            updateRotation(270);\n+        });\n+\n+        resetButton.addEventListener('click', function() {\n+            updateRotation(0);\n+            // Reset animation\n+            flightFeatures.forEach(feature => {\n+                feature.set('finished', false);\n+                feature.set('start', Date.now());\n+            });\n+        });\n+\n+        // Start animation\n+        setTimeout(() => {\n+            map.render();\n+        }, 100);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple_rotation.html b/test_simple_rotation.html\nnew file mode 100644\nindex 000000000..505ec10ce\n--- /dev/null\n+++ b/test_simple_rotation.html\n@@ -0,0 +1,193 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Vector Context Rotation Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .container { display: flex; gap: 20px; }\n+        .map-container { \n+            width: 400px; \n+            height: 400px; \n+            border: 1px solid #ccc;\n+            position: relative;\n+        }\n+        .map { width: 100%; height: 100%; }\n+        .controls { margin-bottom: 20px; }\n+        .info { margin-top: 10px; font-size: 12px; color: #666; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.1.0/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.1.0/ol.css\">\n+</head>\n+<body>\n+    <h1>Vector Context Rotation Test</h1>\n+    <p>This test compares vector context rendering between tile layers and vector layers at different rotations.</p>\n+    \n+    <div class=\"controls\">\n+        <label>Rotation: <input type=\"range\" id=\"rotation\" min=\"0\" max=\"360\" value=\"0\" step=\"1\"></label>\n+        <span id=\"rotationValue\">0\u00b0</span>\n+        <button id=\"test90\">Test 90\u00b0</button>\n+        <button id=\"test270\">Test 270\u00b0</button>\n+    </div>\n+    \n+    <div class=\"container\">\n+        <div class=\"map-container\">\n+            <div id=\"tileMap\" class=\"map\"></div>\n+            <div class=\"info\">Tile Layer Vector Context<br>Should show consistent stroke width and text scale</div>\n+        </div>\n+        <div class=\"map-container\">\n+            <div id=\"vectorMap\" class=\"map\"></div>\n+            <div class=\"info\">Vector Layer Vector Context<br>Reference - correct behavior</div>\n+        </div>\n+    </div>\n+\n+    <script>\n+        // Create test features\n+        const center = [0, 0];\n+        const testFeatures = [\n+            new ol.Feature({\n+                geometry: new ol.geom.Point(center),\n+                name: 'Center Point'\n+            }),\n+            new ol.Feature({\n+                geometry: new ol.geom.LineString([\n+                    [center[0] - 1000000, center[1]],\n+                    [center[0] + 1000000, center[1]]\n+                ]),\n+                name: 'Horizontal Line'\n+            }),\n+            new ol.Feature({\n+                geometry: new ol.geom.LineString([\n+                    [center[0], center[1] - 1000000],\n+                    [center[0], center[1] + 1000000]\n+                ]),\n+                name: 'Vertical Line'\n+            })\n+        ];\n+\n+        // Styles for testing\n+        const pointStyle = new ol.style.Style({\n+            image: new ol.style.Circle({\n+                radius: 10,\n+                fill: new ol.style.Fill({color: 'red'}),\n+                stroke: new ol.style.Stroke({color: 'black', width: 2})\n+            }),\n+            text: new ol.style.Text({\n+                text: 'TEST',\n+                font: '16px Arial',\n+                fill: new ol.style.Fill({color: 'white'}),\n+                stroke: new ol.style.Stroke({color: 'black', width: 2})\n+            })\n+        });\n+\n+        const lineStyle = new ol.style.Style({\n+            stroke: new ol.style.Stroke({\n+                color: 'blue',\n+                width: 4\n+            })\n+        });\n+\n+        // Create shared view\n+        const view = new ol.View({\n+            center: center,\n+            zoom: 4,\n+            rotation: 0\n+        });\n+\n+        // Create tile layer map\n+        const tileLayer = new ol.layer.Tile({\n+            source: new ol.source.OSM()\n+        });\n+\n+        const tileMap = new ol.Map({\n+            target: 'tileMap',\n+            layers: [tileLayer],\n+            view: view\n+        });\n+\n+        // Create vector layer map  \n+        const vectorSource = new ol.source.Vector({\n+            features: testFeatures\n+        });\n+\n+        const vectorLayer = new ol.layer.Vector({\n+            source: vectorSource,\n+            style: function(feature) {\n+                return feature.getGeometry().getType() === 'Point' ? pointStyle : lineStyle;\n+            }\n+        });\n+\n+        const vectorMap = new ol.Map({\n+            target: 'vectorMap',\n+            layers: [vectorLayer],\n+            view: view\n+        });\n+\n+        // Add vector context rendering to tile layer\n+        tileLayer.on('postrender', function(event) {\n+            const vectorContext = ol.render.getVectorContext(event);\n+            \n+            testFeatures.forEach(feature => {\n+                const geom = feature.getGeometry();\n+                if (geom.getType() === 'Point') {\n+                    vectorContext.setStyle(pointStyle);\n+                } else {\n+                    vectorContext.setStyle(lineStyle);\n+                }\n+                vectorContext.drawGeometry(geom);\n+            });\n+        });\n+\n+        // Add vector context rendering to vector layer (for comparison)\n+        vectorLayer.on('postrender', function(event) {\n+            const vectorContext = ol.render.getVectorContext(event);\n+            \n+            // Draw additional test elements to compare\n+            vectorContext.setStyle(new ol.style.Style({\n+                stroke: new ol.style.Stroke({color: 'green', width: 2})\n+            }));\n+            \n+            // Draw a test circle\n+            const testCircle = new ol.geom.Point([center[0] + 500000, center[1] + 500000]);\n+            vectorContext.setStyle(new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 8,\n+                    fill: new ol.style.Fill({color: 'green'}),\n+                    stroke: new ol.style.Stroke({color: 'darkgreen', width: 2})\n+                })\n+            }));\n+            vectorContext.drawGeometry(testCircle);\n+        });\n+\n+        // Controls\n+        const rotationSlider = document.getElementById('rotation');\n+        const rotationValue = document.getElementById('rotationValue');\n+        const test90Button = document.getElementById('test90');\n+        const test270Button = document.getElementById('test270');\n+\n+        function updateRotation(degrees) {\n+            const radians = degrees * Math.PI / 180;\n+            view.setRotation(radians);\n+            rotationValue.textContent = degrees + '\u00b0';\n+            rotationSlider.value = degrees;\n+        }\n+\n+        rotationSlider.addEventListener('input', function() {\n+            updateRotation(parseInt(this.value));\n+        });\n+\n+        test90Button.addEventListener('click', function() {\n+            updateRotation(90);\n+        });\n+\n+        test270Button.addEventListener('click', function() {\n+            updateRotation(270);\n+        });\n+\n+        // Force initial render\n+        setTimeout(() => {\n+            tileMap.render();\n+            vectorMap.render();\n+        }, 100);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_vector_context_rotation.html b/test_vector_context_rotation.html\nnew file mode 100644\nindex 000000000..3ecf4880b\n--- /dev/null\n+++ b/test_vector_context_rotation.html\n@@ -0,0 +1,203 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Vector Context Rotation Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .container { display: flex; gap: 20px; }\n+        .map-container { \n+            width: 400px; \n+            height: 400px; \n+            border: 1px solid #ccc;\n+            position: relative;\n+        }\n+        .map { width: 100%; height: 100%; }\n+        .controls { margin-bottom: 20px; }\n+        .info { margin-top: 10px; font-size: 12px; color: #666; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Vector Context Rotation Test</h1>\n+    <p>This test compares vector context rendering between tile layers and vector layers at different rotations.</p>\n+    \n+    <div class=\"controls\">\n+        <label>Rotation: <input type=\"range\" id=\"rotation\" min=\"0\" max=\"360\" value=\"0\" step=\"1\"></label>\n+        <span id=\"rotationValue\">0\u00b0</span>\n+        <button id=\"test90\">Test 90\u00b0</button>\n+        <button id=\"test270\">Test 270\u00b0</button>\n+    </div>\n+    \n+    <div class=\"container\">\n+        <div class=\"map-container\">\n+            <div id=\"tileMap\" class=\"map\"></div>\n+            <div class=\"info\">Tile Layer Vector Context<br>Should show consistent stroke width and text scale</div>\n+        </div>\n+        <div class=\"map-container\">\n+            <div id=\"vectorMap\" class=\"map\"></div>\n+            <div class=\"info\">Vector Layer Vector Context<br>Reference - correct behavior</div>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import LineString from './src/ol/geom/LineString.js';\n+        import {Style, Stroke, Fill, Text, Circle} from './src/ol/style.js';\n+        import {getVectorContext} from './src/ol/render.js';\n+\n+        // Create test features\n+        const center = [0, 0];\n+        const testFeatures = [\n+            new Feature({\n+                geometry: new Point(center),\n+                name: 'Center Point'\n+            }),\n+            new Feature({\n+                geometry: new LineString([\n+                    [center[0] - 1000000, center[1]],\n+                    [center[0] + 1000000, center[1]]\n+                ]),\n+                name: 'Horizontal Line'\n+            }),\n+            new Feature({\n+                geometry: new LineString([\n+                    [center[0], center[1] - 1000000],\n+                    [center[0], center[1] + 1000000]\n+                ]),\n+                name: 'Vertical Line'\n+            })\n+        ];\n+\n+        // Styles for testing\n+        const pointStyle = new Style({\n+            image: new Circle({\n+                radius: 10,\n+                fill: new Fill({color: 'red'}),\n+                stroke: new Stroke({color: 'black', width: 2})\n+            }),\n+            text: new Text({\n+                text: 'TEST',\n+                font: '16px Arial',\n+                fill: new Fill({color: 'white'}),\n+                stroke: new Stroke({color: 'black', width: 2})\n+            })\n+        });\n+\n+        const lineStyle = new Style({\n+            stroke: new Stroke({\n+                color: 'blue',\n+                width: 4\n+            })\n+        });\n+\n+        // Create shared view\n+        const view = new View({\n+            center: center,\n+            zoom: 4,\n+            rotation: 0\n+        });\n+\n+        // Create tile layer map\n+        const tileLayer = new TileLayer({\n+            source: new OSM()\n+        });\n+\n+        const tileMap = new Map({\n+            target: 'tileMap',\n+            layers: [tileLayer],\n+            view: view\n+        });\n+\n+        // Create vector layer map  \n+        const vectorSource = new VectorSource({\n+            features: testFeatures\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            style: function(feature) {\n+                return feature.getGeometry().getType() === 'Point' ? pointStyle : lineStyle;\n+            }\n+        });\n+\n+        const vectorMap = new Map({\n+            target: 'vectorMap',\n+            layers: [vectorLayer],\n+            view: view\n+        });\n+\n+        // Add vector context rendering to tile layer\n+        tileLayer.on('postrender', function(event) {\n+            const vectorContext = getVectorContext(event);\n+            \n+            testFeatures.forEach(feature => {\n+                const geom = feature.getGeometry();\n+                if (geom.getType() === 'Point') {\n+                    vectorContext.setStyle(pointStyle);\n+                } else {\n+                    vectorContext.setStyle(lineStyle);\n+                }\n+                vectorContext.drawGeometry(geom);\n+            });\n+        });\n+\n+        // Add vector context rendering to vector layer (for comparison)\n+        vectorLayer.on('postrender', function(event) {\n+            const vectorContext = getVectorContext(event);\n+            \n+            // Draw additional test elements to compare\n+            vectorContext.setStyle(new Style({\n+                stroke: new Stroke({color: 'green', width: 2})\n+            }));\n+            \n+            // Draw a test circle\n+            const testCircle = new Point([center[0] + 500000, center[1] + 500000]);\n+            vectorContext.setStyle(new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({color: 'green'}),\n+                    stroke: new Stroke({color: 'darkgreen', width: 2})\n+                })\n+            }));\n+            vectorContext.drawGeometry(testCircle);\n+        });\n+\n+        // Controls\n+        const rotationSlider = document.getElementById('rotation');\n+        const rotationValue = document.getElementById('rotationValue');\n+        const test90Button = document.getElementById('test90');\n+        const test270Button = document.getElementById('test270');\n+\n+        function updateRotation(degrees) {\n+            const radians = degrees * Math.PI / 180;\n+            view.setRotation(radians);\n+            rotationValue.textContent = degrees + '\u00b0';\n+            rotationSlider.value = degrees;\n+        }\n+\n+        rotationSlider.addEventListener('input', function() {\n+            updateRotation(parseInt(this.value));\n+        });\n+\n+        test90Button.addEventListener('click', function() {\n+            updateRotation(90);\n+        });\n+\n+        test270Button.addEventListener('click', function() {\n+            updateRotation(270);\n+        });\n+\n+        // Force initial render\n+        setTimeout(() => {\n+            tileMap.render();\n+            vectorMap.render();\n+        }, 100);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-13654", "model_patch": "diff --git a/src/ol/source/DataTile.js b/src/ol/source/DataTile.js\nindex 777a24d67..b03e69ed2 100644\n--- a/src/ol/source/DataTile.js\n+++ b/src/ol/source/DataTile.js\n@@ -3,11 +3,14 @@\n  */\n import DataTile from '../DataTile.js';\n import EventType from '../events/EventType.js';\n+import ReprojTile from '../reproj/Tile.js';\n+import TileCache from '../TileCache.js';\n import TileEventType from './TileEventType.js';\n import TileSource, {TileSourceEvent} from './Tile.js';\n import TileState from '../TileState.js';\n-import {createXYZ, extentFromProjection} from '../tilegrid.js';\n-import {getKeyZXY} from '../tilecoord.js';\n+import {createXYZ, extentFromProjection, getForProjection as getTileGridForProjection} from '../tilegrid.js';\n+import {equivalent} from '../proj.js';\n+import {getKey, getKeyZXY} from '../tilecoord.js';\n import {getUid} from '../util.js';\n import {toPromise} from '../functions.js';\n import {toSize} from '../size.js';\n@@ -117,6 +120,18 @@ class DataTileSource extends TileSource {\n      * @type {number}\n      */\n     this.bandCount = options.bandCount === undefined ? 4 : options.bandCount; // assume RGBA if undefined\n+\n+    /**\n+     * @protected\n+     * @type {!Object<string, TileCache>}\n+     */\n+    this.tileCacheForProjection = {};\n+\n+    /**\n+     * @protected\n+     * @type {!Object<string, import(\"../tilegrid/TileGrid.js\").default>}\n+     */\n+    this.tileGridForProjection = {};\n   }\n \n   /**\n@@ -155,6 +170,43 @@ class DataTileSource extends TileSource {\n     return this.gutter_;\n   }\n \n+  /**\n+   * @param {import(\"../proj/Projection.js\").default} projection Projection.\n+   * @return {!import(\"../tilegrid/TileGrid.js\").default} Tile grid.\n+   */\n+  getTileGridForProjection(projection) {\n+    const thisProj = this.getProjection();\n+    if (this.tileGrid && (!thisProj || equivalent(thisProj, projection))) {\n+      return this.tileGrid;\n+    } else {\n+      const projKey = getUid(projection);\n+      if (!(projKey in this.tileGridForProjection)) {\n+        this.tileGridForProjection[projKey] =\n+          getTileGridForProjection(projection);\n+      }\n+      return this.tileGridForProjection[projKey];\n+    }\n+  }\n+\n+  /**\n+   * @param {import(\"../proj/Projection.js\").default} projection Projection.\n+   * @return {import(\"../TileCache.js\").default} Tile cache.\n+   */\n+  getTileCacheForProjection(projection) {\n+    const thisProj = this.getProjection();\n+    if (!thisProj || equivalent(thisProj, projection)) {\n+      return this.tileCache;\n+    } else {\n+      const projKey = getUid(projection);\n+      if (!(projKey in this.tileCacheForProjection)) {\n+        this.tileCacheForProjection[projKey] = new TileCache(\n+          this.tileCache.highWaterMark\n+        );\n+      }\n+      return this.tileCacheForProjection[projKey];\n+    }\n+  }\n+\n   /**\n    * @param {Loader} loader The data loader.\n    * @protected\n@@ -169,9 +221,79 @@ class DataTileSource extends TileSource {\n    * @param {number} y Tile coordinate y.\n    * @param {number} pixelRatio Pixel ratio.\n    * @param {import(\"../proj/Projection.js\").default} projection Projection.\n-   * @return {!DataTile} Tile.\n+   * @return {!(DataTile|ReprojTile)} Tile.\n    */\n   getTile(z, x, y, pixelRatio, projection) {\n+    const sourceProjection = this.getProjection();\n+    if (\n+      !sourceProjection ||\n+      !projection ||\n+      equivalent(sourceProjection, projection)\n+    ) {\n+      return this.getTileInternal(\n+        z,\n+        x,\n+        y,\n+        pixelRatio,\n+        sourceProjection || projection\n+      );\n+    } else {\n+      const cache = this.getTileCacheForProjection(projection);\n+      const tileCoord = [z, x, y];\n+      let tile;\n+      const tileCoordKey = getKey(tileCoord);\n+      if (cache.containsKey(tileCoordKey)) {\n+        tile = cache.get(tileCoordKey);\n+      }\n+      const key = this.getKey();\n+      if (tile && tile.key == key) {\n+        return tile;\n+      } else {\n+        const sourceTileGrid = this.getTileGridForProjection(sourceProjection);\n+        const targetTileGrid = this.getTileGridForProjection(projection);\n+        const wrappedTileCoord = this.getTileCoordForTileUrlFunction\n+          ? this.getTileCoordForTileUrlFunction(tileCoord, projection)\n+          : tileCoord;\n+        const newTile = new ReprojTile(\n+          sourceProjection,\n+          sourceTileGrid,\n+          projection,\n+          targetTileGrid,\n+          tileCoord,\n+          wrappedTileCoord,\n+          pixelRatio,\n+          this.getGutterForProjection(sourceProjection),\n+          function (z, x, y, pixelRatio) {\n+            return this.getTileInternal(z, x, y, pixelRatio, sourceProjection);\n+          }.bind(this),\n+          undefined, // reprojectionErrorThreshold\n+          false, // renderReprojectionEdges\n+          this.getInterpolate()\n+        );\n+        newTile.key = key;\n+\n+        if (tile) {\n+          newTile.interimTile = tile;\n+          newTile.refreshInterimChain();\n+          cache.replace(tileCoordKey, newTile);\n+        } else {\n+          cache.set(tileCoordKey, newTile);\n+        }\n+        return newTile;\n+      }\n+    }\n+  }\n+\n+  /**\n+   * @param {number} z Tile coordinate z.\n+   * @param {number} x Tile coordinate x.\n+   * @param {number} y Tile coordinate y.\n+   * @param {number} pixelRatio Pixel ratio.\n+   * @param {import(\"../proj/Projection.js\").default} projection Projection.\n+   * @return {!DataTile} Tile.\n+   * @protected\n+   */\n+  getTileInternal(z, x, y, pixelRatio, projection) {\n     const size = this.getTileSize(z);\n     const tileCoordKey = getKeyZXY(z, x, y);\n     if (this.tileCache.containsKey(tileCoordKey)) {\n@@ -228,6 +350,29 @@ class DataTileSource extends TileSource {\n       this.dispatchEvent(new TileSourceEvent(type, tile));\n     }\n   }\n+\n+  /**\n+   * @param {import(\"../proj/Projection.js\").default} projection Projection.\n+   * @param {!Object<string, boolean>} usedTiles Used tiles.\n+   */\n+  expireCache(projection, usedTiles) {\n+    const usedTileCache = this.getTileCacheForProjection(projection);\n+\n+    this.tileCache.expireCache(\n+      this.tileCache == usedTileCache ? usedTiles : {}\n+    );\n+    for (const id in this.tileCacheForProjection) {\n+      const tileCache = this.tileCacheForProjection[id];\n+      tileCache.expireCache(tileCache == usedTileCache ? usedTiles : {});\n+    }\n+  }\n+\n+  clear() {\n+    super.clear();\n+    for (const id in this.tileCacheForProjection) {\n+      this.tileCacheForProjection[id].clear();\n+    }\n+  }\n }\n \n export default DataTileSource;\ndiff --git a/test_reprojection.html b/test_reprojection.html\nnew file mode 100644\nindex 000000000..fba92df3e\n--- /dev/null\n+++ b/test_reprojection.html\n@@ -0,0 +1,148 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\">\n+    <title>WebGLTile Reprojection Test</title>    \n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/openlayers/openlayers.github.io@master/en/v6.10.0/css/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdn.jsdelivr.net/gh/openlayers/openlayers.github.io@master/en/v6.10.0/build/ol.js\"></script>\n+    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.7.5/proj4.js\"></script>\n+    <style>\n+      body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+      .test-container { margin-bottom: 20px; }\n+      .map { height: 400px; width: 100%; border: 1px solid black; margin-bottom: 10px; }\n+      .info { background: #f0f0f0; padding: 10px; border-radius: 5px; }\n+      .error { background: #ffeeee; color: red; }\n+      .success { background: #eeffee; color: green; }\n+    </style>\n+  </head>\n+  <body>\n+    <h1>WebGLTile Reprojection Test</h1>\n+    \n+    <div class=\"test-container\">\n+      <h2>Test 1: COG in UTM (EPSG:32636) displayed on EPSG:4326 map</h2>\n+      <div id=\"map1\" class=\"map\"></div>\n+      <div id=\"info1\" class=\"info\">Loading...</div>\n+    </div>\n+\n+    <div class=\"test-container\">\n+      <h2>Test 2: Same COG with regular Tile layer (should work)</h2>\n+      <div id=\"map2\" class=\"map\"></div>\n+      <div id=\"info2\" class=\"info\">Loading...</div>\n+    </div>\n+\n+    <script>\n+    // Add CRS definition for COG\n+    proj4.defs(\"EPSG:32636\",\"+proj=utm +zone=36 +datum=WGS84 +units=m +no_defs\");\n+    ol.proj.proj4.register(proj4);\n+    let cogProj = ol.proj.get(\"EPSG:32636\");\n+    \n+    // Test 1: WebGLTile with reprojection (should fail before fix)\n+    const source1 = new ol.source.GeoTIFF({\n+      sources: [\n+        {\n+          url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+        }\n+      ]\n+    });\n+    \n+    const map1 = new ol.Map({\n+      target: 'map1',\n+      layers: [\n+        new ol.layer.Tile({\n+          source: new ol.source.OSM()\n+        }),\n+        new ol.layer.WebGLTile({\n+          source: source1\n+        })\n+      ],\n+      view: new ol.View({\n+        projection: \"EPSG:4326\"\n+      })\n+    });\n+    \n+    // Test 2: Regular Tile layer (should work)\n+    const source2 = new ol.source.GeoTIFF({\n+      sources: [\n+        {\n+          url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+        }\n+      ]\n+    });\n+    \n+    const map2 = new ol.Map({\n+      target: 'map2',\n+      layers: [\n+        new ol.layer.Tile({\n+          source: new ol.source.OSM()\n+        }),\n+        new ol.layer.Tile({\n+          source: source2\n+        })\n+      ],\n+      view: new ol.View({\n+        projection: \"EPSG:4326\"\n+      })\n+    });\n+    \n+    // Fit to bounds and check results\n+    let test1Complete = false;\n+    let test2Complete = false;\n+    \n+    source1.getView().then(view => {\n+      console.log('Test 1 - Source view:', view);\n+      let fromLonLat = ol.proj.getTransform(view.projection, map1.getView().getProjection());\n+      let extent = ol.extent.applyTransform(view.extent, fromLonLat);\n+      map1.getView().fit(extent);\n+      \n+      // Check if tiles are rendered after a delay\n+      setTimeout(() => {\n+        const webglLayer = map1.getLayers().getArray()[1];\n+        const renderer = webglLayer.getRenderer();\n+        const hasRenderedTiles = renderer && renderer.renderComplete;\n+        \n+        document.getElementById('info1').innerHTML = hasRenderedTiles ? \n+          '<span class=\"success\">\u2713 WebGLTile layer rendered successfully with reprojection</span>' :\n+          '<span class=\"error\">\u2717 WebGLTile layer failed to render - reprojection not supported</span>';\n+        test1Complete = true;\n+        checkAllComplete();\n+      }, 3000);\n+    }).catch(error => {\n+      console.error('Test 1 error:', error);\n+      document.getElementById('info1').innerHTML = '<span class=\"error\">\u2717 Error loading source: ' + error.message + '</span>';\n+      test1Complete = true;\n+      checkAllComplete();\n+    });\n+    \n+    source2.getView().then(view => {\n+      console.log('Test 2 - Source view:', view);\n+      let fromLonLat = ol.proj.getTransform(view.projection, map2.getView().getProjection());\n+      let extent = ol.extent.applyTransform(view.extent, fromLonLat);\n+      map2.getView().fit(extent);\n+      \n+      // Check if tiles are rendered after a delay\n+      setTimeout(() => {\n+        const tileLayer = map2.getLayers().getArray()[1];\n+        const source = tileLayer.getSource();\n+        const hasLoadedTiles = source.getState() === 'ready';\n+        \n+        document.getElementById('info2').innerHTML = hasLoadedTiles ? \n+          '<span class=\"success\">\u2713 Regular Tile layer rendered successfully</span>' :\n+          '<span class=\"error\">\u2717 Regular Tile layer failed to render</span>';\n+        test2Complete = true;\n+        checkAllComplete();\n+      }, 3000);\n+    }).catch(error => {\n+      console.error('Test 2 error:', error);\n+      document.getElementById('info2').innerHTML = '<span class=\"error\">\u2717 Error loading source: ' + error.message + '</span>';\n+      test2Complete = true;\n+      checkAllComplete();\n+    });\n+    \n+    function checkAllComplete() {\n+      if (test1Complete && test2Complete) {\n+        console.log('All tests completed');\n+      }\n+    }\n+    </script>\n+  </body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_reprojection_issue.html b/test_reprojection_issue.html\nnew file mode 100644\nindex 000000000..4b4c34d21\n--- /dev/null\n+++ b/test_reprojection_issue.html\n@@ -0,0 +1,115 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\">\n+    <title>WebGLTile Reprojection Issue Test</title>    \n+    <link rel=\"stylesheet\" href=\"node_modules/ol/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/proj4js/2.7.5/proj4.js\"></script>\n+    <style>\n+      body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+      .test-container { margin-bottom: 20px; }\n+      .map { height: 400px; width: 100%; border: 1px solid black; margin-bottom: 10px; }\n+      .info { background: #f0f0f0; padding: 10px; border-radius: 5px; }\n+      .error { background: #ffeeee; color: red; }\n+      .success { background: #eeffee; color: green; }\n+    </style>\n+  </head>\n+  <body>\n+    <h1>WebGLTile Reprojection Issue Test</h1>\n+    \n+    <div class=\"test-container\">\n+      <h2>Test: COG in UTM (EPSG:32636) displayed on EPSG:4326 map with WebGLTile</h2>\n+      <div id=\"map1\" class=\"map\"></div>\n+      <div id=\"info1\" class=\"info\">Loading...</div>\n+    </div>\n+\n+    <script type=\"module\">\n+    import GeoTIFF from './node_modules/ol/source/GeoTIFF.js';\n+    import Map from './node_modules/ol/Map.js';\n+    import WebGLTileLayer from './node_modules/ol/layer/WebGLTile.js';\n+    import TileLayer from './node_modules/ol/layer/Tile.js';\n+    import OSM from './node_modules/ol/source/OSM.js';\n+    import View from './node_modules/ol/View.js';\n+    import {get as getProjection, transform} from './node_modules/ol/proj.js';\n+    import {register} from './node_modules/ol/proj/proj4.js';\n+    import {applyTransform} from './node_modules/ol/extent.js';\n+    \n+    // Add CRS definition for COG\n+    proj4.defs(\"EPSG:32636\",\"+proj=utm +zone=36 +datum=WGS84 +units=m +no_defs\");\n+    register(proj4);\n+    \n+    // Test: WebGLTile with reprojection (should fail before fix)\n+    const source1 = new GeoTIFF({\n+      sources: [\n+        {\n+          url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+        }\n+      ]\n+    });\n+    \n+    const map1 = new Map({\n+      target: 'map1',\n+      layers: [\n+        new TileLayer({\n+          source: new OSM()\n+        }),\n+        new WebGLTileLayer({\n+          source: source1\n+        })\n+      ],\n+      view: new View({\n+        projection: \"EPSG:4326\",  // Force different projection than source\n+        center: [0, 0],\n+        zoom: 2\n+      })\n+    });\n+    \n+    // Fit to bounds and check results\n+    source1.getView().then(view => {\n+      console.log('Source projection:', view.projection.getCode());\n+      console.log('Map projection:', map1.getView().getProjection().getCode());\n+      console.log('Source extent:', view.extent);\n+      \n+      // Transform extent from source projection to map projection\n+      const sourceProj = view.projection;\n+      const mapProj = map1.getView().getProjection();\n+      \n+      if (sourceProj.getCode() !== mapProj.getCode()) {\n+        console.log('Reprojection needed from', sourceProj.getCode(), 'to', mapProj.getCode());\n+        \n+        // Transform extent\n+        const transformedExtent = [\n+          transform([view.extent[0], view.extent[1]], sourceProj, mapProj),\n+          transform([view.extent[2], view.extent[3]], sourceProj, mapProj)\n+        ].flat();\n+        \n+        console.log('Transformed extent:', transformedExtent);\n+        map1.getView().fit(transformedExtent);\n+        \n+        // Check if tiles are rendered after a delay\n+        setTimeout(() => {\n+          const webglLayer = map1.getLayers().getArray()[1];\n+          const renderer = webglLayer.getRenderer();\n+          \n+          // Check if any tiles are loaded\n+          let hasLoadedTiles = false;\n+          if (renderer && renderer.tileTextureCache_) {\n+            const cache = renderer.tileTextureCache_;\n+            hasLoadedTiles = cache.getCount() > 0;\n+            console.log('Tile cache count:', cache.getCount());\n+          }\n+          \n+          document.getElementById('info1').innerHTML = hasLoadedTiles ? \n+            '<span class=\"success\">\u2713 WebGLTile layer rendered successfully with reprojection</span>' :\n+            '<span class=\"error\">\u2717 WebGLTile layer failed to render - reprojection not supported</span>';\n+        }, 5000);\n+      } else {\n+        document.getElementById('info1').innerHTML = '<span class=\"info\">No reprojection needed - same projection</span>';\n+      }\n+    }).catch(error => {\n+      console.error('Error:', error);\n+      document.getElementById('info1').innerHTML = '<span class=\"error\">\u2717 Error loading source: ' + error.message + '</span>';\n+    });\n+    </script>\n+  </body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_reprojection_simple.js b/test_reprojection_simple.js\nnew file mode 100644\nindex 000000000..485df0412\n--- /dev/null\n+++ b/test_reprojection_simple.js\n@@ -0,0 +1,84 @@\n+import GeoTIFF from './src/ol/source/GeoTIFF.js';\n+import Map from './src/ol/Map.js';\n+import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+import TileLayer from './src/ol/layer/Tile.js';\n+import OSM from './src/ol/source/OSM.js';\n+import View from './src/ol/View.js';\n+import {register} from './src/ol/proj/proj4.js';\n+import {transform} from './src/ol/proj.js';\n+\n+// Test reprojection functionality\n+async function testReprojection() {\n+  console.log('Testing WebGLTile reprojection...');\n+  \n+  // Add UTM projection\n+  if (typeof proj4 !== 'undefined') {\n+    proj4.defs(\"EPSG:32636\",\"+proj=utm +zone=36 +datum=WGS84 +units=m +no_defs\");\n+    register(proj4);\n+  }\n+  \n+  const source = new GeoTIFF({\n+    sources: [\n+      {\n+        url: 'https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/2020/S2A_36QWD_20200701_0_L2A/TCI.tif',\n+      },\n+    ],\n+  });\n+\n+  try {\n+    const sourceView = await source.getView();\n+    console.log('Source projection:', sourceView.projection.getCode());\n+    \n+    // Create map with different projection to force reprojection\n+    const map = new Map({\n+      target: 'map',\n+      layers: [\n+        new TileLayer({\n+          source: new OSM()\n+        }),\n+        new WebGLTileLayer({\n+          source: source,\n+        }),\n+      ],\n+      view: new View({\n+        projection: 'EPSG:4326', // Different from source projection\n+        center: [0, 0],\n+        zoom: 2\n+      })\n+    });\n+    \n+    console.log('Map projection: EPSG:4326');\n+    console.log('Reprojection needed:', sourceView.projection.getCode() !== 'EPSG:4326');\n+    \n+    // Transform and fit extent\n+    if (sourceView.projection.getCode() !== 'EPSG:4326') {\n+      const transformedExtent = [\n+        transform([sourceView.extent[0], sourceView.extent[1]], sourceView.projection, 'EPSG:4326'),\n+        transform([sourceView.extent[2], sourceView.extent[3]], sourceView.projection, 'EPSG:4326')\n+      ].flat();\n+      \n+      console.log('Transformed extent:', transformedExtent);\n+      map.getView().fit(transformedExtent);\n+    }\n+    \n+    // Test tile creation\n+    setTimeout(() => {\n+      const webglLayer = map.getLayers().getArray()[1];\n+      const renderer = webglLayer.getRenderer();\n+      \n+      if (renderer && renderer.tileTextureCache_) {\n+        const cacheCount = renderer.tileTextureCache_.getCount();\n+        console.log('Tile cache count:', cacheCount);\n+        console.log('Test result:', cacheCount > 0 ? 'SUCCESS - Reprojection working' : 'FAILED - No tiles loaded');\n+      } else {\n+        console.log('Test result: FAILED - No renderer or cache');\n+      }\n+    }, 3000);\n+    \n+  } catch (error) {\n+    console.error('Test failed:', error);\n+  }\n+}\n+\n+// Export for testing\n+export { testReprojection };\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

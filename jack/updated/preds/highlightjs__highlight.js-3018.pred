{"instance_id": "highlightjs__highlight.js-3018", "model_patch": "diff --git a/src/languages/lib/ecmascript.js b/src/languages/lib/ecmascript.js\nindex b80f24d4..348ea78f 100644\n--- a/src/languages/lib/ecmascript.js\n+++ b/src/languages/lib/ecmascript.js\n@@ -72,6 +72,7 @@ const TYPES = [\n   \"Reflect\",\n   \"JSON\",\n   \"Promise\",\n+  \"BigInt\",\n   \"Float64Array\",\n   \"Int16Array\",\n   \"Int32Array\",\n@@ -82,7 +83,9 @@ const TYPES = [\n   \"Array\",\n   \"Uint8Array\",\n   \"Uint8ClampedArray\",\n-  \"ArrayBuffer\"\n+  \"ArrayBuffer\",\n+  \"BigInt64Array\",\n+  \"BigUint64Array\"\n ];\n \n const ERROR_TYPES = [\ndiff --git a/test/markup/javascript/bigint-types.expect.txt b/test/markup/javascript/bigint-types.expect.txt\nnew file mode 100644\nindex 00000000..cd4a62b4\n--- /dev/null\n+++ b/test/markup/javascript/bigint-types.expect.txt\n@@ -0,0 +1,26 @@\n+<span class=\"hljs-comment\">// BigInt constructor and related types</span>\n+<span class=\"hljs-keyword\">let</span> bi = <span class=\"hljs-built_in\">BigInt</span>(<span class=\"hljs-string\">&#x27;1&#x27;</span>);\n+<span class=\"hljs-keyword\">let</span> bi2 = <span class=\"hljs-built_in\">BigInt</span>(<span class=\"hljs-number\">123</span>);\n+<span class=\"hljs-keyword\">let</span> bi3 = <span class=\"hljs-built_in\">BigInt</span>(<span class=\"hljs-number\">0x1f</span>);\n+\n+<span class=\"hljs-comment\">// BigInt64Array and BigUint64Array</span>\n+<span class=\"hljs-keyword\">let</span> arr1 = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigInt64Array</span>(<span class=\"hljs-number\">8</span>);\n+<span class=\"hljs-keyword\">let</span> arr2 = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigUint64Array</span>(<span class=\"hljs-number\">8</span>);\n+<span class=\"hljs-keyword\">let</span> arr3 = <span class=\"hljs-built_in\">BigInt64Array</span>.from([<span class=\"hljs-number\">1n</span>, <span class=\"hljs-number\">2n</span>, <span class=\"hljs-number\">3n</span>]);\n+<span class=\"hljs-keyword\">let</span> arr4 = <span class=\"hljs-built_in\">BigUint64Array</span>.of(<span class=\"hljs-number\">1n</span>, <span class=\"hljs-number\">2n</span>, <span class=\"hljs-number\">3n</span>);\n+\n+<span class=\"hljs-comment\">// Other built-in types for comparison</span>\n+<span class=\"hljs-keyword\">let</span> num = <span class=\"hljs-built_in\">Number</span>(<span class=\"hljs-number\">42</span>);\n+<span class=\"hljs-keyword\">let</span> str = <span class=\"hljs-built_in\">String</span>(<span class=\"hljs-string\">&quot;hello&quot;</span>);\n+<span class=\"hljs-keyword\">let</span> arr = <span class=\"hljs-built_in\">Array</span>(<span class=\"hljs-number\">5</span>);\n+<span class=\"hljs-keyword\">let</span> int32 = <span class=\"hljs-built_in\">Int32Array</span>(<span class=\"hljs-number\">8</span>);\n+<span class=\"hljs-keyword\">let</span> float64 = <span class=\"hljs-built_in\">Float64Array</span>(<span class=\"hljs-number\">8</span>);\n+\n+<span class=\"hljs-comment\">// Mixed usage</span>\n+<span class=\"hljs-keyword\">const</span> buffer = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">ArrayBuffer</span>(<span class=\"hljs-number\">64</span>);\n+<span class=\"hljs-keyword\">const</span> view1 = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigInt64Array</span>(buffer);\n+<span class=\"hljs-keyword\">const</span> view2 = <span class=\"hljs-keyword\">new</span> <span class=\"hljs-built_in\">BigUint64Array</span>(buffer, <span class=\"hljs-number\">8</span>, <span class=\"hljs-number\">4</span>);\n+\n+<span class=\"hljs-comment\">// Function calls and method access</span>\n+<span class=\"hljs-built_in\">BigInt</span>.asIntN(<span class=\"hljs-number\">64</span>, <span class=\"hljs-number\">2n</span> ** <span class=\"hljs-number\">63n</span>);\n+<span class=\"hljs-built_in\">BigUint64Array</span>.BYTES_PER_ELEMENT;\ndiff --git a/test/markup/javascript/bigint-types.txt b/test/markup/javascript/bigint-types.txt\nnew file mode 100644\nindex 00000000..1ed3ea92\n--- /dev/null\n+++ b/test/markup/javascript/bigint-types.txt\n@@ -0,0 +1,26 @@\n+// BigInt constructor and related types\n+let bi = BigInt('1');\n+let bi2 = BigInt(123);\n+let bi3 = BigInt(0x1f);\n+\n+// BigInt64Array and BigUint64Array\n+let arr1 = new BigInt64Array(8);\n+let arr2 = new BigUint64Array(8);\n+let arr3 = BigInt64Array.from([1n, 2n, 3n]);\n+let arr4 = BigUint64Array.of(1n, 2n, 3n);\n+\n+// Other built-in types for comparison\n+let num = Number(42);\n+let str = String(\"hello\");\n+let arr = Array(5);\n+let int32 = Int32Array(8);\n+let float64 = Float64Array(8);\n+\n+// Mixed usage\n+const buffer = new ArrayBuffer(64);\n+const view1 = new BigInt64Array(buffer);\n+const view2 = new BigUint64Array(buffer, 8, 4);\n+\n+// Function calls and method access\n+BigInt.asIntN(64, 2n ** 63n);\n+BigUint64Array.BYTES_PER_ELEMENT;\n\\ No newline at end of file\ndiff --git a/test_bigint.html b/test_bigint.html\nnew file mode 100644\nindex 00000000..7eb6790f\n--- /dev/null\n+++ b/test_bigint.html\n@@ -0,0 +1,44 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BigInt Highlighting Test</title>\n+    <link rel=\"stylesheet\" href=\"./build/styles/default.css\">\n+    <script src=\"./build/highlight.min.js\"></script>\n+</head>\n+<body>\n+    <h1>BigInt Highlighting Test</h1>\n+    \n+    <h2>Before Fix (Expected - no highlighting):</h2>\n+    <p>BigInt, BigInt64Array, BigUint64Array should appear as plain text</p>\n+    \n+    <h2>After Fix (Actual - with highlighting):</h2>\n+    <pre><code class=\"language-javascript\">// BigInt constructor and related types\n+let bi = BigInt('1');\n+let bi2 = BigInt(123);\n+let bi3 = BigInt(0x1f);\n+\n+// BigInt64Array and BigUint64Array\n+let arr1 = new BigInt64Array(8);\n+let arr2 = new BigUint64Array(8);\n+let arr3 = BigInt64Array.from([1n, 2n, 3n]);\n+let arr4 = BigUint64Array.of(1n, 2n, 3n);\n+\n+// Other built-in types for comparison\n+let num = Number(42);\n+let str = String(\"hello\");\n+let arr = Array(5);\n+let int32 = Int32Array(8);\n+let float64 = Float64Array(8);\n+\n+// Mixed usage\n+const buffer = new ArrayBuffer(64);\n+const view1 = new BigInt64Array(buffer);\n+const view2 = new BigUint64Array(buffer, 8, 4);\n+\n+// Function calls and method access\n+BigInt.asIntN(64, 2n ** 63n);\n+BigUint64Array.BYTES_PER_ELEMENT;</code></pre>\n+\n+    <script>hljs.highlightAll();</script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

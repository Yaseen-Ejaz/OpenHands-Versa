{"instance_id": "bpmn-io__bpmn-js-1382", "model_patch": "diff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js\nindex cba8c275..dbb65a80 100644\n--- a/lib/features/popup-menu/ReplaceMenuProvider.js\n+++ b/lib/features/popup-menu/ReplaceMenuProvider.js\n@@ -222,6 +222,20 @@ ReplaceMenuProvider.prototype.getEntries = function(element) {\n     return this._createSequenceFlowEntries(element, replaceOptions.SEQUENCE_FLOW);\n   }\n \n+  // data object reference\n+  if (is(businessObject, 'bpmn:DataObjectReference')) {\n+    entries = filter(replaceOptions.DATA_OBJECT_REFERENCE, differentType);\n+\n+    return this._createEntries(element, entries);\n+  }\n+\n+  // data store reference\n+  if (is(businessObject, 'bpmn:DataStoreReference')) {\n+    entries = filter(replaceOptions.DATA_STORE_REFERENCE, differentType);\n+\n+    return this._createEntries(element, entries);\n+  }\n+\n   // flow nodes\n   if (is(businessObject, 'bpmn:FlowNode')) {\n     entries = filter(replaceOptions.TASK, differentType);\ndiff --git a/lib/features/replace/ReplaceOptions.js b/lib/features/replace/ReplaceOptions.js\nindex b132368e..df898bf3 100644\n--- a/lib/features/replace/ReplaceOptions.js\n+++ b/lib/features/replace/ReplaceOptions.js\n@@ -818,3 +818,25 @@ export var PARTICIPANT = [\n     }\n   }\n ];\n+\n+export var DATA_OBJECT_REFERENCE = [\n+  {\n+    label: 'Data Store Reference',\n+    actionName: 'replace-with-data-store-reference',\n+    className: 'bpmn-icon-data-store',\n+    target: {\n+      type: 'bpmn:DataStoreReference'\n+    }\n+  }\n+];\n+\n+export var DATA_STORE_REFERENCE = [\n+  {\n+    label: 'Data Object Reference',\n+    actionName: 'replace-with-data-object-reference',\n+    className: 'bpmn-icon-data-object',\n+    target: {\n+      type: 'bpmn:DataObjectReference'\n+    }\n+  }\n+];\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..fac29d55\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Mar/2026 08:21:05] \"GET /test_visual.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 08:21:05] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test/fixtures/bpmn/features/replace/data-elements.bpmn b/test/fixtures/bpmn/features/replace/data-elements.bpmn\nnew file mode 100644\nindex 00000000..6a91d9c3\n--- /dev/null\n+++ b/test/fixtures/bpmn/features/replace/data-elements.bpmn\n@@ -0,0 +1,24 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process\" isExecutable=\"false\">\n+    <bpmn:dataObjectReference id=\"DataObjectReference_1\" dataObjectRef=\"DataObject\" />\n+    <bpmn:dataObject id=\"DataObject\" />\n+    <bpmn:dataStoreReference id=\"DataStoreReference_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process\">\n+      <bpmndi:BPMNShape id=\"DataObjectReference_1_di\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds x=\"201\" y=\"184\" width=\"36\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"174\" y=\"234\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataStoreReference_1_di\" bpmnElement=\"DataStoreReference_1\">\n+        <dc:Bounds x=\"301\" y=\"184\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"274\" y=\"234\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/popup-menu/DataReplaceSpec.js b/test/spec/features/popup-menu/DataReplaceSpec.js\nnew file mode 100644\nindex 00000000..65a1ee96\n--- /dev/null\n+++ b/test/spec/features/popup-menu/DataReplaceSpec.js\n@@ -0,0 +1,157 @@\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  createEvent as globalEvent\n+} from '../../../util/MockEvents';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceMenuProviderModule from 'lib/features/popup-menu';\n+\n+import {\n+  query as domQuery,\n+  queryAll as domQueryAll,\n+  classes as domClasses\n+} from 'min-dom';\n+\n+import { is } from 'lib/util/ModelUtil';\n+\n+// Test BPMN with both DataObjectReference and DataStoreReference\n+var testDiagramXML = require('../../../fixtures/bpmn/features/replace/data-elements.bpmn');\n+\n+var testModules = [\n+  coreModule,\n+  modelingModule,\n+  replaceMenuProviderModule\n+];\n+\n+describe('DataObjectReference and DataStoreReference Replace Menu', function() {\n+\n+  beforeEach(bootstrapModeler(testDiagramXML, { modules: testModules }));\n+\n+  var openPopup = function(element, offset) {\n+    offset = offset || 100;\n+\n+    getBpmnJS().invoke(function(popupMenu) {\n+      popupMenu.open(element, 'bpmn-replace', {\n+        x: element.x + offset, y: element.y + offset\n+      });\n+    });\n+  };\n+\n+  var triggerAction = function(actionId) {\n+    return getBpmnJS().invoke(function(popupMenu) {\n+      var entry = popupMenu._getEntry(actionId);\n+      if (entry && entry.action) {\n+        return entry.action();\n+      }\n+    });\n+  };\n+\n+  var queryEntry = function(actionId) {\n+    return domQuery('[data-id=\"' + actionId + '\"]', getBpmnJS().get('canvas').getContainer());\n+  };\n+\n+  describe('Current Behavior - DataObjectReference', function() {\n+\n+    it('should have empty replace menu', inject(function(elementRegistry) {\n+      // given\n+      var dataObjectReference = elementRegistry.get('DataObjectReference_1');\n+\n+      // when\n+      openPopup(dataObjectReference);\n+\n+      // then - should have no main replace entries visible\n+      var replaceEntries = domQueryAll('.djs-popup [data-id^=\"replace-with\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(replaceEntries).to.have.length(0); // This is the problem - empty main entries\n+    }));\n+\n+  });\n+\n+  describe('Current Behavior - DataStoreReference', function() {\n+\n+    it('should have empty replace menu', inject(function(elementRegistry) {\n+      // given\n+      var dataStoreReference = elementRegistry.get('DataStoreReference_1');\n+\n+      // when\n+      openPopup(dataStoreReference);\n+\n+      // then - should have no replace entries at all\n+      var replaceEntries = domQueryAll('.djs-popup [data-id^=\"replace-with\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(replaceEntries).to.have.length(0); // This is the problem - no entries\n+    }));\n+\n+  });\n+\n+  describe('Fixed Behavior - DataObjectReference', function() {\n+\n+    it('should show DataStoreReference in replace menu', inject(function(elementRegistry) {\n+      // given\n+      var dataObjectReference = elementRegistry.get('DataObjectReference_1');\n+\n+      // when\n+      openPopup(dataObjectReference);\n+\n+      // then - should now have DataStoreReference replace option\n+      var replaceEntries = domQueryAll('.djs-popup [data-id^=\"replace-with\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(replaceEntries).to.have.length(1);\n+      \n+      var dataStoreEntry = domQuery('.djs-popup [data-id=\"replace-with-data-store-reference\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(dataStoreEntry).to.exist;\n+    }));\n+\n+    it('should be able to replace with DataStoreReference', inject(function(elementRegistry, bpmnReplace) {\n+      // given\n+      var dataObjectReference = elementRegistry.get('DataObjectReference_1');\n+\n+      // when\n+      var newElement = bpmnReplace.replaceElement(dataObjectReference, {\n+        type: 'bpmn:DataStoreReference'\n+      });\n+\n+      // then\n+      expect(is(newElement, 'bpmn:DataStoreReference')).to.be.true;\n+      expect(newElement.id).to.exist;\n+    }));\n+\n+  });\n+\n+  describe('Fixed Behavior - DataStoreReference', function() {\n+\n+    it('should show DataObjectReference in replace menu', inject(function(elementRegistry) {\n+      // given\n+      var dataStoreReference = elementRegistry.get('DataStoreReference_1');\n+\n+      // when\n+      openPopup(dataStoreReference);\n+\n+      // then - should now have DataObjectReference replace option\n+      var replaceEntries = domQueryAll('.djs-popup [data-id^=\"replace-with\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(replaceEntries).to.have.length(1);\n+      \n+      var dataObjectEntry = domQuery('.djs-popup [data-id=\"replace-with-data-object-reference\"]', getBpmnJS().get('canvas').getContainer());\n+      expect(dataObjectEntry).to.exist;\n+    }));\n+\n+    it('should be able to replace with DataObjectReference', inject(function(elementRegistry, bpmnReplace) {\n+      // given\n+      var dataStoreReference = elementRegistry.get('DataStoreReference_1');\n+\n+      // when\n+      var newElement = bpmnReplace.replaceElement(dataStoreReference, {\n+        type: 'bpmn:DataObjectReference'\n+      });\n+\n+      // then\n+      expect(is(newElement, 'bpmn:DataObjectReference')).to.be.true;\n+      expect(newElement.id).to.exist;\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_data_replace.js b/test_data_replace.js\nnew file mode 100644\nindex 00000000..339e0da4\n--- /dev/null\n+++ b/test_data_replace.js\n@@ -0,0 +1,161 @@\n+/**\n+ * Test file to verify DataObjectReference and DataStoreReference replace functionality\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import {\n+  createEvent as globalEvent\n+} from 'test/util/MockEvents';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceMenuProviderModule from 'lib/features/popup-menu';\n+\n+import {\n+  query as domQuery,\n+  queryAll as domQueryAll,\n+  classes as domClasses\n+} from 'min-dom';\n+\n+import { is } from 'lib/util/ModelUtil';\n+\n+// Test BPMN with both DataObjectReference and DataStoreReference\n+const testDiagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process\" isExecutable=\"false\">\n+    <bpmn:dataObjectReference id=\"DataObjectReference_1\" dataObjectRef=\"DataObject\" />\n+    <bpmn:dataObject id=\"DataObject\" />\n+    <bpmn:dataStoreReference id=\"DataStoreReference_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process\">\n+      <bpmndi:BPMNShape id=\"DataObjectReference_1_di\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds x=\"201\" y=\"184\" width=\"36\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"174\" y=\"234\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataStoreReference_1_di\" bpmnElement=\"DataStoreReference_1\">\n+        <dc:Bounds x=\"301\" y=\"184\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"274\" y=\"234\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+const testModules = [\n+  coreModule,\n+  modelingModule,\n+  replaceMenuProviderModule\n+];\n+\n+describe('DataObjectReference and DataStoreReference Replace Menu', function() {\n+\n+  beforeEach(bootstrapModeler(testDiagramXML, { modules: testModules }));\n+\n+  var openPopup = function(element, offset) {\n+    offset = offset || 100;\n+\n+    getBpmnJS().invoke(function(popupMenu) {\n+      popupMenu.open(element, 'bpmn-replace', {\n+        x: element.x + offset, y: element.y + offset\n+      });\n+    });\n+  };\n+\n+  var triggerAction = function(actionId) {\n+    return getBpmnJS().invoke(function(popupMenu) {\n+      var entry = popupMenu._getEntry(actionId);\n+      if (entry && entry.action) {\n+        return entry.action();\n+      }\n+    });\n+  };\n+\n+  var queryEntry = function(actionId) {\n+    return domQuery('[data-id=\"' + actionId + '\"]', getBpmnJS().get('canvas').getContainer());\n+  };\n+\n+  describe('Current Behavior - DataObjectReference', function() {\n+\n+    it('should show only collection marker in header entries', inject(function(elementRegistry, popupMenu) {\n+      // given\n+      var dataObjectReference = elementRegistry.get('DataObjectReference_1');\n+\n+      // when\n+      openPopup(dataObjectReference);\n+\n+      // then - should only have collection marker, no main replace entries\n+      var headerEntries = popupMenu.getHeaderEntries(dataObjectReference);\n+      var mainEntries = popupMenu.getEntries(dataObjectReference);\n+\n+      expect(headerEntries).to.have.length(1);\n+      expect(headerEntries[0].id).to.equal('toggle-is-collection');\n+      expect(mainEntries).to.have.length(0); // This is the problem - empty main entries\n+    }));\n+\n+  });\n+\n+  describe('Current Behavior - DataStoreReference', function() {\n+\n+    it('should show no entries at all', inject(function(elementRegistry, popupMenu) {\n+      // given\n+      var dataStoreReference = elementRegistry.get('DataStoreReference_1');\n+\n+      // when\n+      openPopup(dataStoreReference);\n+\n+      // then - should have no entries at all\n+      var headerEntries = popupMenu.getHeaderEntries(dataStoreReference);\n+      var mainEntries = popupMenu.getEntries(dataStoreReference);\n+\n+      expect(headerEntries).to.have.length(0);\n+      expect(mainEntries).to.have.length(0); // This is the problem - no entries\n+    }));\n+\n+  });\n+\n+  describe('Expected Behavior After Fix - DataObjectReference', function() {\n+\n+    it('should be able to replace with DataStoreReference', inject(function(elementRegistry, popupMenu, bpmnReplace) {\n+      // given\n+      var dataObjectReference = elementRegistry.get('DataObjectReference_1');\n+\n+      // when - this should work after our fix\n+      var newElement = bpmnReplace.replaceElement(dataObjectReference, {\n+        type: 'bpmn:DataStoreReference'\n+      });\n+\n+      // then\n+      expect(is(newElement, 'bpmn:DataStoreReference')).to.be.true;\n+      expect(newElement.id).to.exist;\n+    }));\n+\n+  });\n+\n+  describe('Expected Behavior After Fix - DataStoreReference', function() {\n+\n+    it('should be able to replace with DataObjectReference', inject(function(elementRegistry, popupMenu, bpmnReplace) {\n+      // given\n+      var dataStoreReference = elementRegistry.get('DataStoreReference_1');\n+\n+      // when - this should work after our fix\n+      var newElement = bpmnReplace.replaceElement(dataStoreReference, {\n+        type: 'bpmn:DataObjectReference'\n+      });\n+\n+      // then\n+      expect(is(newElement, 'bpmn:DataObjectReference')).to.be.true;\n+      expect(newElement.id).to.exist;\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_visual.html b/test_visual.html\nnew file mode 100644\nindex 00000000..86c5c952\n--- /dev/null\n+++ b/test_visual.html\n@@ -0,0 +1,62 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js Data Replace Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; }\n+    .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN.js Data Replace Test</h1>\n+  <div class=\"info\">\n+    <strong>Instructions:</strong>\n+    <ol>\n+      <li>Right-click on the DataObjectReference (left element) to see replace menu with DataStoreReference option</li>\n+      <li>Right-click on the DataStoreReference (right element) to see replace menu with DataObjectReference option</li>\n+    </ol>\n+  </div>\n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process\" isExecutable=\"false\">\n+    <bpmn:dataObjectReference id=\"DataObjectReference_1\" dataObjectRef=\"DataObject\" />\n+    <bpmn:dataObject id=\"DataObject\" />\n+    <bpmn:dataStoreReference id=\"DataStoreReference_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process\">\n+      <bpmndi:BPMNShape id=\"DataObjectReference_1_di\" bpmnElement=\"DataObjectReference_1\">\n+        <dc:Bounds x=\"201\" y=\"184\" width=\"36\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"174\" y=\"244\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataStoreReference_1_di\" bpmnElement=\"DataStoreReference_1\">\n+        <dc:Bounds x=\"301\" y=\"184\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"274\" y=\"244\" width=\"90\" height=\"20\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    modeler.importXML(xml, function(err) {\n+      if (err) {\n+        console.error('Error importing XML:', err);\n+      } else {\n+        console.log('BPMN diagram loaded successfully');\n+      }\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-10340", "model_patch": "diff --git a/src/ol/interaction/Draw.js b/src/ol/interaction/Draw.js\nindex c4e2824b4..e84e0066f 100644\n--- a/src/ol/interaction/Draw.js\n+++ b/src/ol/interaction/Draw.js\n@@ -8,6 +8,7 @@ import MapBrowserPointerEvent from '../MapBrowserPointerEvent.js';\n import {getChangeEventType} from '../Object.js';\n import {squaredDistance as squaredCoordinateDistance} from '../coordinate.js';\n import Event from '../events/Event.js';\n+import {fromUserCoordinate, toUserCoordinate, getUserProjection} from '../proj.js';\n import {noModifierKeys, always, shiftKeyOnly} from '../events/condition.js';\n import {boundingExtent, getBottomLeft, getBottomRight, getTopLeft, getTopRight} from '../extent.js';\n import {TRUE, FALSE} from '../functions.js';\n@@ -125,6 +126,26 @@ const Mode = {\n   CIRCLE: 'Circle'\n };\n \n+/**\n+ * Calculate distance between two coordinates, handling user projection properly.\n+ * If user projection is set, transforms to view projection for accurate distance calculation.\n+ * @param {import(\"../coordinate.js\").Coordinate} coord1 First coordinate.\n+ * @param {import(\"../coordinate.js\").Coordinate} coord2 Second coordinate.\n+ * @param {import(\"../proj/Projection.js\").default} viewProjection View projection.\n+ * @return {number} Distance.\n+ */\n+function getDistanceForDrawing(coord1, coord2, viewProjection) {\n+  const userProjection = getUserProjection();\n+  if (userProjection && viewProjection) {\n+    // Transform coordinates to view projection for accurate distance calculation\n+    const viewCoord1 = fromUserCoordinate(coord1, viewProjection);\n+    const viewCoord2 = fromUserCoordinate(coord2, viewProjection);\n+    return Math.sqrt(squaredCoordinateDistance(viewCoord1, viewCoord2));\n+  }\n+  // Fallback to direct calculation if no user projection\n+  return Math.sqrt(squaredCoordinateDistance(coord1, coord2));\n+}\n+\n \n /**\n  * @enum {string}\n@@ -298,12 +319,12 @@ class Draw extends PointerInteraction {\n          * @param {import(\"../geom/SimpleGeometry.js\").default=} opt_geometry Optional geometry.\n          * @return {import(\"../geom/SimpleGeometry.js\").default} A geometry.\n          */\n-        geometryFunction = function(coordinates, opt_geometry) {\n+        geometryFunction = (coordinates, opt_geometry) => {\n           const circle = opt_geometry ? /** @type {Circle} */ (opt_geometry) :\n             new Circle([NaN, NaN]);\n-          const squaredLength = squaredCoordinateDistance(\n-            coordinates[0], coordinates[1]);\n-          circle.setCenterAndRadius(coordinates[0], Math.sqrt(squaredLength));\n+          const viewProjection = this.getMap() ? this.getMap().getView().getProjection() : null;\n+          const radius = getDistanceForDrawing(coordinates[0], coordinates[1], viewProjection);\n+          circle.setCenterAndRadius(coordinates[0], radius);\n           return circle;\n         };\n       } else {\n@@ -966,17 +987,24 @@ function getDefaultStyleFunction() {\n  * @api\n  */\n export function createRegularPolygon(opt_sides, opt_angle) {\n-  return function(coordinates, opt_geometry) {\n+  return function(coordinates, opt_geometry, opt_viewProjection) {\n     const center = /** @type {LineCoordType} */ (coordinates)[0];\n     const end = /** @type {LineCoordType} */ (coordinates)[1];\n-    const radius = Math.sqrt(\n-      squaredCoordinateDistance(center, end));\n+    const radius = getDistanceForDrawing(center, end, opt_viewProjection);\n     const geometry = opt_geometry ? /** @type {Polygon} */ (opt_geometry) :\n       fromCircle(new Circle(center), opt_sides);\n     let angle = opt_angle;\n     if (!opt_angle) {\n-      const x = end[0] - center[0];\n-      const y = end[1] - center[1];\n+      // Calculate angle in view projection for accurate direction\n+      const userProjection = getUserProjection();\n+      let viewCenter = center;\n+      let viewEnd = end;\n+      if (userProjection && opt_viewProjection) {\n+        viewCenter = fromUserCoordinate(center, opt_viewProjection);\n+        viewEnd = fromUserCoordinate(end, opt_viewProjection);\n+      }\n+      const x = viewEnd[0] - viewCenter[0];\n+      const y = viewEnd[1] - viewCenter[1];\n       angle = Math.atan(y / x) - (x < 0 ? Math.PI : 0);\n     }\n     makeRegular(geometry, center, radius, angle);\n@@ -994,15 +1022,35 @@ export function createRegularPolygon(opt_sides, opt_angle) {\n  */\n export function createBox() {\n   return (\n-    function(coordinates, opt_geometry) {\n-      const extent = boundingExtent(/** @type {LineCoordType} */ (coordinates));\n-      const boxCoordinates = [[\n-        getBottomLeft(extent),\n-        getBottomRight(extent),\n-        getTopRight(extent),\n-        getTopLeft(extent),\n-        getBottomLeft(extent)\n-      ]];\n+    function(coordinates, opt_geometry, opt_viewProjection) {\n+      const userProjection = getUserProjection();\n+      let boxCoordinates;\n+      \n+      if (userProjection && opt_viewProjection) {\n+        // Transform coordinates to view projection for accurate box calculation\n+        const viewCoords = coordinates.map(coord => fromUserCoordinate(coord, opt_viewProjection));\n+        const extent = boundingExtent(/** @type {LineCoordType} */ (viewCoords));\n+        const viewBoxCoords = [\n+          getBottomLeft(extent),\n+          getBottomRight(extent),\n+          getTopRight(extent),\n+          getTopLeft(extent),\n+          getBottomLeft(extent)\n+        ];\n+        // Transform back to user projection\n+        boxCoordinates = [viewBoxCoords.map(coord => toUserCoordinate(coord, opt_viewProjection))];\n+      } else {\n+        // Fallback to direct calculation if no user projection\n+        const extent = boundingExtent(/** @type {LineCoordType} */ (coordinates));\n+        boxCoordinates = [[\n+          getBottomLeft(extent),\n+          getBottomRight(extent),\n+          getTopRight(extent),\n+          getTopLeft(extent),\n+          getBottomLeft(extent)\n+        ]];\n+      }\n+      \n       let geometry = opt_geometry;\n       if (geometry) {\n         geometry.setCoordinates(boxCoordinates);\ndiff --git a/test_geographic_draw_issue.html b/test_geographic_draw_issue.html\nnew file mode 100644\nindex 000000000..8d1d3ce89\n--- /dev/null\n+++ b/test_geographic_draw_issue.html\n@@ -0,0 +1,176 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Geographic Draw Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map { width: 800px; height: 600px; border: 1px solid #ccc; margin: 10px 0; }\n+        .controls { margin: 10px 0; }\n+        .controls button { margin: 5px; padding: 10px; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        h2 { color: #333; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Geographic Draw Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h2>Issue Description:</h2>\n+        <p>When useGeographic() is enabled, drawn shapes don't maintain their expected visual appearance:</p>\n+        <ul>\n+            <li>Circles don't extend to the pointer position, especially at higher latitudes</li>\n+            <li>Regular polygons are far from regular</li>\n+            <li>Boxes may be distorted</li>\n+        </ul>\n+    </div>\n+\n+    <h2>Test 1: Normal Mode (Web Mercator)</h2>\n+    <div class=\"controls\">\n+        <button id=\"draw-circle-normal\">Draw Circle</button>\n+        <button id=\"draw-polygon-normal\">Draw Regular Polygon</button>\n+        <button id=\"draw-box-normal\">Draw Box</button>\n+        <button id=\"clear-normal\">Clear</button>\n+    </div>\n+    <div id=\"map-normal\" class=\"map\"></div>\n+\n+    <h2>Test 2: Geographic Mode (useGeographic)</h2>\n+    <div class=\"controls\">\n+        <button id=\"draw-circle-geo\">Draw Circle</button>\n+        <button id=\"draw-polygon-geo\">Draw Regular Polygon</button>\n+        <button id=\"draw-box-geo\">Draw Box</button>\n+        <button id=\"clear-geo\">Clear</button>\n+    </div>\n+    <div id=\"map-geo\" class=\"map\"></div>\n+\n+    <script>\n+        // Test setup for normal mode (Web Mercator)\n+        const normalSource = new ol.source.Vector();\n+        const normalMap = new ol.Map({\n+            target: 'map-normal',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                }),\n+                new ol.layer.Vector({\n+                    source: normalSource,\n+                    style: new ol.style.Style({\n+                        fill: new ol.style.Fill({\n+                            color: 'rgba(255, 0, 0, 0.3)'\n+                        }),\n+                        stroke: new ol.style.Stroke({\n+                            color: 'red',\n+                            width: 2\n+                        })\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([0, 60]), // High latitude to show distortion\n+                zoom: 4\n+            })\n+        });\n+\n+        // Test setup for geographic mode\n+        ol.proj.useGeographic();\n+        const geoSource = new ol.source.Vector();\n+        const geoMap = new ol.Map({\n+            target: 'map-geo',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                }),\n+                new ol.layer.Vector({\n+                    source: geoSource,\n+                    style: new ol.style.Style({\n+                        fill: new ol.style.Fill({\n+                            color: 'rgba(0, 0, 255, 0.3)'\n+                        }),\n+                        stroke: new ol.style.Stroke({\n+                            color: 'blue',\n+                            width: 2\n+                        })\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: [0, 60], // High latitude in geographic coordinates\n+                zoom: 4\n+            })\n+        });\n+\n+        // Draw interactions for normal mode\n+        let normalDrawInteraction = null;\n+\n+        function addNormalDrawInteraction(type, geometryFunction) {\n+            if (normalDrawInteraction) {\n+                normalMap.removeInteraction(normalDrawInteraction);\n+            }\n+            normalDrawInteraction = new ol.interaction.Draw({\n+                source: normalSource,\n+                type: type,\n+                geometryFunction: geometryFunction\n+            });\n+            normalMap.addInteraction(normalDrawInteraction);\n+        }\n+\n+        // Draw interactions for geographic mode\n+        let geoDrawInteraction = null;\n+\n+        function addGeoDrawInteraction(type, geometryFunction) {\n+            if (geoDrawInteraction) {\n+                geoMap.removeInteraction(geoDrawInteraction);\n+            }\n+            geoDrawInteraction = new ol.interaction.Draw({\n+                source: geoSource,\n+                type: type,\n+                geometryFunction: geometryFunction\n+            });\n+            geoMap.addInteraction(geoDrawInteraction);\n+        }\n+\n+        // Event handlers for normal mode\n+        document.getElementById('draw-circle-normal').onclick = () => {\n+            addNormalDrawInteraction('Circle');\n+        };\n+\n+        document.getElementById('draw-polygon-normal').onclick = () => {\n+            addNormalDrawInteraction('Circle', ol.interaction.Draw.createRegularPolygon(6));\n+        };\n+\n+        document.getElementById('draw-box-normal').onclick = () => {\n+            addNormalDrawInteraction('Circle', ol.interaction.Draw.createBox());\n+        };\n+\n+        document.getElementById('clear-normal').onclick = () => {\n+            normalSource.clear();\n+            if (normalDrawInteraction) {\n+                normalMap.removeInteraction(normalDrawInteraction);\n+                normalDrawInteraction = null;\n+            }\n+        };\n+\n+        // Event handlers for geographic mode\n+        document.getElementById('draw-circle-geo').onclick = () => {\n+            addGeoDrawInteraction('Circle');\n+        };\n+\n+        document.getElementById('draw-polygon-geo').onclick = () => {\n+            addGeoDrawInteraction('Circle', ol.interaction.Draw.createRegularPolygon(6));\n+        };\n+\n+        document.getElementById('draw-box-geo').onclick = () => {\n+            addGeoDrawInteraction('Circle', ol.interaction.Draw.createBox());\n+        };\n+\n+        document.getElementById('clear-geo').onclick = () => {\n+            geoSource.clear();\n+            if (geoDrawInteraction) {\n+                geoMap.removeInteraction(geoDrawInteraction);\n+                geoDrawInteraction = null;\n+            }\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_local_geographic_draw.html b/test_local_geographic_draw.html\nnew file mode 100644\nindex 000000000..782e28882\n--- /dev/null\n+++ b/test_local_geographic_draw.html\n@@ -0,0 +1,104 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Local Geographic Draw Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .map { width: 800px; height: 600px; border: 1px solid #ccc; margin: 10px 0; }\n+        .controls { margin: 10px 0; }\n+        .controls button { margin: 5px; padding: 10px; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        h2 { color: #333; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"./build/ol.css\" type=\"text/css\">\n+    <script src=\"./build/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>Local Geographic Draw Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h2>Issue Description:</h2>\n+        <p>When useGeographic() is enabled, drawn shapes don't maintain their expected visual appearance:</p>\n+        <ul>\n+            <li>Circles don't extend to the pointer position, especially at higher latitudes</li>\n+            <li>Regular polygons are far from regular</li>\n+            <li>Boxes may be distorted</li>\n+        </ul>\n+    </div>\n+\n+    <h2>Test: Geographic Mode (useGeographic) at High Latitude</h2>\n+    <div class=\"controls\">\n+        <button id=\"draw-circle\">Draw Circle</button>\n+        <button id=\"draw-polygon\">Draw Regular Polygon (6 sides)</button>\n+        <button id=\"draw-box\">Draw Box</button>\n+        <button id=\"clear\">Clear</button>\n+    </div>\n+    <div id=\"map\" class=\"map\"></div>\n+\n+    <script>\n+        // Enable geographic mode\n+        ol.proj.useGeographic();\n+        \n+        const source = new ol.source.Vector();\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                }),\n+                new ol.layer.Vector({\n+                    source: source,\n+                    style: new ol.style.Style({\n+                        fill: new ol.style.Fill({\n+                            color: 'rgba(255, 0, 0, 0.3)'\n+                        }),\n+                        stroke: new ol.style.Stroke({\n+                            color: 'red',\n+                            width: 2\n+                        })\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: [0, 60], // High latitude in geographic coordinates\n+                zoom: 4\n+            })\n+        });\n+\n+        let drawInteraction = null;\n+\n+        function addDrawInteraction(type, geometryFunction) {\n+            if (drawInteraction) {\n+                map.removeInteraction(drawInteraction);\n+            }\n+            drawInteraction = new ol.interaction.Draw({\n+                source: source,\n+                type: type,\n+                geometryFunction: geometryFunction\n+            });\n+            map.addInteraction(drawInteraction);\n+        }\n+\n+        // Event handlers\n+        document.getElementById('draw-circle').onclick = () => {\n+            addDrawInteraction('Circle');\n+        };\n+\n+        document.getElementById('draw-polygon').onclick = () => {\n+            addDrawInteraction('Circle', ol.interaction.Draw.createRegularPolygon(6));\n+        };\n+\n+        document.getElementById('draw-box').onclick = () => {\n+            addDrawInteraction('Circle', ol.interaction.Draw.createBox());\n+        };\n+\n+        document.getElementById('clear').onclick = () => {\n+            source.clear();\n+            if (drawInteraction) {\n+                map.removeInteraction(drawInteraction);\n+                drawInteraction = null;\n+            }\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

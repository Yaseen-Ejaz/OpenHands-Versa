{"instance_id": "bpmn-io__bpmn-js-1677", "model_patch": "diff --git a/lib/features/label-editing/LabelEditingProvider.js b/lib/features/label-editing/LabelEditingProvider.js\nindex c0520ad8..afbde6ae 100644\n--- a/lib/features/label-editing/LabelEditingProvider.js\n+++ b/lib/features/label-editing/LabelEditingProvider.js\n@@ -382,6 +382,12 @@ LabelEditingProvider.prototype.update = function(\n     element, newLabel,\n     activeContextText, bounds) {\n \n+  // guard against updating labels of elements that are no longer part of the diagram\n+  // this can happen when direct editing completion races with element deletion\n+  if (!element.parent) {\n+    return;\n+  }\n+\n   var newBounds,\n       bbox;\n \ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..532e97db\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,5 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [04/Mar/2026 08:29:20] \"GET /test_illegal_invocation.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 08:29:20] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 08:31:44] \"GET /test_illegal_invocation.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 08:31:44] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 304 -\ndiff --git a/test/spec/features/label-editing/IllegalInvocationSpec.js b/test/spec/features/label-editing/IllegalInvocationSpec.js\nnew file mode 100644\nindex 00000000..12855288\n--- /dev/null\n+++ b/test/spec/features/label-editing/IllegalInvocationSpec.js\n@@ -0,0 +1,114 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import labelEditingModule from 'lib/features/label-editing';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+\n+describe('features/label-editing - illegal invocation fix', function() {\n+\n+  var diagramXML = require('./LabelEditing.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      labelEditingModule,\n+      coreModule,\n+      modelingModule\n+    ]\n+  }));\n+\n+  it('should not throw illegal invocation when element is deleted during direct editing', inject(\n+    function(elementRegistry, directEditing, modeling) {\n+\n+      // given\n+      var shape = elementRegistry.get('Task_1');\n+      var task = shape.businessObject;\n+      var originalName = task.name;\n+\n+      // activate direct editing\n+      directEditing.activate(shape);\n+      expect(directEditing.isActive()).to.be.true;\n+\n+      // modify the text to trigger an update\n+      directEditing._textbox.content.textContent = 'Modified Task';\n+\n+      // when - delete the element while direct editing is active\n+      modeling.removeElements([shape]);\n+\n+      // verify element is deleted (parent should be null)\n+      expect(shape.parent).to.be.null;\n+\n+      // then - attempting to complete should not throw illegal invocation error\n+      var errorThrown = false;\n+      try {\n+        directEditing.complete();\n+      } catch (error) {\n+        if (error.message.includes('illegal invocation')) {\n+          errorThrown = true;\n+        } else {\n+          // Re-throw other errors\n+          throw error;\n+        }\n+      }\n+\n+      // should not have thrown illegal invocation error\n+      expect(errorThrown).to.be.false;\n+      expect(directEditing.isActive()).to.be.false;\n+    }\n+  ));\n+\n+  it('should handle race condition gracefully', inject(\n+    function(elementRegistry, directEditing, modeling, eventBus) {\n+\n+      // given\n+      var shape = elementRegistry.get('Task_1');\n+      \n+      // activate direct editing\n+      directEditing.activate(shape);\n+      directEditing._textbox.content.textContent = 'Modified Task';\n+\n+      // when - simulate race condition by calling update after deletion\n+      modeling.removeElements([shape]);\n+      \n+      // verify element is deleted\n+      expect(shape.parent).to.be.null;\n+\n+      // manually call the update method to simulate the race condition\n+      var provider = directEditing._providers[0];\n+      var errorThrown = false;\n+      \n+      try {\n+        provider.update(shape, 'New Label', 'Old Label', { width: 100, height: 50 });\n+      } catch (error) {\n+        if (error.message.includes('illegal invocation')) {\n+          errorThrown = true;\n+        } else {\n+          throw error;\n+        }\n+      }\n+\n+      // then - should not throw illegal invocation error\n+      expect(errorThrown).to.be.false;\n+    }\n+  ));\n+\n+  it('should still work normally for existing elements', inject(\n+    function(elementRegistry, directEditing) {\n+\n+      // given\n+      var shape = elementRegistry.get('Task_1');\n+      var task = shape.businessObject;\n+\n+      // when - normal direct editing flow\n+      directEditing.activate(shape);\n+      directEditing._textbox.content.textContent = 'New Task Name';\n+      directEditing.complete();\n+\n+      // then - should update the label normally\n+      expect(task.name).to.equal('New Task Name');\n+    }\n+  ));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_fix.js b/test_fix.js\nnew file mode 100644\nindex 00000000..aedfa75d\n--- /dev/null\n+++ b/test_fix.js\n@@ -0,0 +1,43 @@\n+// Simple test to verify the fix works\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Read the modified file\n+const filePath = path.join(__dirname, 'lib/features/label-editing/LabelEditingProvider.js');\n+const content = fs.readFileSync(filePath, 'utf8');\n+\n+// Check if our fix is present\n+const hasGuardClause = content.includes('if (!element.parent)');\n+const hasReturnStatement = content.includes('return;') && content.includes('guard against updating labels');\n+\n+console.log('Fix verification:');\n+console.log('- Guard clause present:', hasGuardClause);\n+console.log('- Return statement present:', hasReturnStatement);\n+console.log('- Fix appears to be correctly implemented:', hasGuardClause && hasReturnStatement);\n+\n+// Test the logic with a mock element\n+function testGuardLogic() {\n+  // Mock element with parent (should proceed)\n+  const elementWithParent = { parent: {} };\n+  \n+  // Mock element without parent (should return early)\n+  const elementWithoutParent = { parent: null };\n+  \n+  console.log('\\nLogic test:');\n+  console.log('- Element with parent should proceed:', !!elementWithParent.parent);\n+  console.log('- Element without parent should return early:', !elementWithoutParent.parent);\n+}\n+\n+testGuardLogic();\n+\n+// Verify the fix is in the right location\n+const updateMethodMatch = content.match(/LabelEditingProvider\\.prototype\\.update = function\\(([\\s\\S]*?)\\{([\\s\\S]*?)\\}/);\n+if (updateMethodMatch) {\n+  const updateMethodBody = updateMethodMatch[2];\n+  const hasGuardAtStart = updateMethodBody.trim().startsWith('// guard against updating labels');\n+  console.log('\\n- Guard clause is at the beginning of update method:', hasGuardAtStart);\n+} else {\n+  console.log('\\n- Could not find update method');\n+}\n+\n+console.log('\\nFix implementation complete!');\n\\ No newline at end of file\ndiff --git a/test_illegal_invocation.html b/test_illegal_invocation.html\nnew file mode 100644\nindex 00000000..97fcdd8d\n--- /dev/null\n+++ b/test_illegal_invocation.html\n@@ -0,0 +1,197 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Test Illegal Invocation Issue</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    #canvas {\n+      border: 1px solid #ccc;\n+      height: 500px;\n+      width: 800px;\n+    }\n+    .controls {\n+      margin: 20px 0;\n+    }\n+    button {\n+      margin: 5px;\n+      padding: 10px;\n+    }\n+    .error {\n+      color: red;\n+      background: #ffe6e6;\n+      padding: 10px;\n+      margin: 10px 0;\n+      border: 1px solid red;\n+    }\n+    .success {\n+      color: green;\n+      background: #e6ffe6;\n+      padding: 10px;\n+      margin: 10px 0;\n+      border: 1px solid green;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>Test: Illegal Invocation Error</h1>\n+  <p>This test reproduces the issue where deleting an element while direct editing is active causes an \"illegal invocation\" error.</p>\n+  \n+  <div class=\"controls\">\n+    <button onclick=\"createTask()\">Create Task</button>\n+    <button onclick=\"startDirectEdit()\">Start Direct Edit</button>\n+    <button onclick=\"deleteElement()\">Delete Element</button>\n+    <button onclick=\"clearErrors()\">Clear Messages</button>\n+  </div>\n+  \n+  <div id=\"messages\"></div>\n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modeler;\n+    let currentElement = null;\n+    \n+    // Initialize BPMN modeler\n+    function initModeler() {\n+      modeler = new BpmnJS({\n+        container: '#canvas',\n+        keyboard: {\n+          bindTo: window\n+        }\n+      });\n+\n+      // Simple BPMN diagram with a task\n+      const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"4.12.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\">\n+      <bpmn:incoming>Flow_1</bpmn:incoming>\n+      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>Flow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Activity_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"77\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Event_1\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"420\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_1_di\" bpmnElement=\"Flow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"270\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_2_di\" bpmnElement=\"Flow_2\">\n+        <di:waypoint x=\"370\" y=\"117\" />\n+        <di:waypoint x=\"420\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+      modeler.importXML(xml).then(() => {\n+        const elementRegistry = modeler.get('elementRegistry');\n+        currentElement = elementRegistry.get('Task_1');\n+        addMessage('Modeler initialized successfully', 'success');\n+      }).catch(err => {\n+        addMessage('Error initializing modeler: ' + err.message, 'error');\n+      });\n+\n+      // Catch errors\n+      window.addEventListener('error', function(e) {\n+        if (e.message.includes('illegal invocation')) {\n+          addMessage('REPRODUCED: ' + e.message, 'error');\n+        } else {\n+          addMessage('Error: ' + e.message, 'error');\n+        }\n+      });\n+    }\n+\n+    function createTask() {\n+      if (!modeler) return;\n+      \n+      const modeling = modeler.get('modeling');\n+      const elementFactory = modeler.get('elementFactory');\n+      \n+      const task = elementFactory.createShape({\n+        type: 'bpmn:Task',\n+        businessObject: modeler.get('bpmnFactory').create('bpmn:Task', {\n+          name: 'New Task'\n+        })\n+      });\n+      \n+      currentElement = modeling.createShape(task, { x: 400, y: 200 }, modeler.get('canvas').getRootElement());\n+      addMessage('Created new task', 'success');\n+    }\n+\n+    function startDirectEdit() {\n+      if (!currentElement) {\n+        addMessage('No element selected. Create a task first.', 'error');\n+        return;\n+      }\n+      \n+      const directEditing = modeler.get('directEditing');\n+      const success = directEditing.activate(currentElement);\n+      \n+      if (success) {\n+        addMessage('Direct editing started on element: ' + currentElement.id, 'success');\n+      } else {\n+        addMessage('Failed to start direct editing', 'error');\n+      }\n+    }\n+\n+    function deleteElement() {\n+      if (!currentElement) {\n+        addMessage('No element selected', 'error');\n+        return;\n+      }\n+      \n+      const directEditing = modeler.get('directEditing');\n+      const modeling = modeler.get('modeling');\n+      \n+      if (directEditing.isActive(currentElement)) {\n+        addMessage('Direct editing is active - attempting to delete element...', 'success');\n+        \n+        try {\n+          // This should trigger the illegal invocation error\n+          modeling.removeShape(currentElement);\n+          addMessage('Element deleted successfully', 'success');\n+        } catch (error) {\n+          addMessage('REPRODUCED ERROR: ' + error.message, 'error');\n+        }\n+      } else {\n+        addMessage('Direct editing is not active. Start direct editing first.', 'error');\n+      }\n+    }\n+\n+    function addMessage(message, type) {\n+      const messagesDiv = document.getElementById('messages');\n+      const messageDiv = document.createElement('div');\n+      messageDiv.className = type;\n+      messageDiv.textContent = new Date().toLocaleTimeString() + ': ' + message;\n+      messagesDiv.appendChild(messageDiv);\n+    }\n+\n+    function clearErrors() {\n+      document.getElementById('messages').innerHTML = '';\n+    }\n+\n+    // Initialize when page loads\n+    window.onload = initModeler;\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_illegal_invocation_unit.js b/test_illegal_invocation_unit.js\nnew file mode 100644\nindex 00000000..74b559bc\n--- /dev/null\n+++ b/test_illegal_invocation_unit.js\n@@ -0,0 +1,104 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import labelEditingModule from 'lib/features/label-editing';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+\n+describe('illegal invocation bug reproduction', function() {\n+\n+  var diagramXML = require('./test/spec/features/label-editing/LabelEditing.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      labelEditingModule,\n+      coreModule,\n+      modelingModule\n+    ]\n+  }));\n+\n+  it('should not throw illegal invocation when deleting element during direct editing', inject(\n+    function(elementRegistry, directEditing, modeling, commandStack) {\n+\n+      // given\n+      var shape = elementRegistry.get('Task_1');\n+      var task = shape.businessObject;\n+\n+      // activate direct editing\n+      directEditing.activate(shape);\n+      expect(directEditing.isActive()).to.be.true;\n+\n+      // modify the text to trigger an update\n+      directEditing._textbox.content.textContent = 'Modified Task';\n+\n+      // when - delete the element while direct editing is active\n+      // This should trigger the illegal invocation error\n+      var errorThrown = false;\n+      try {\n+        // Force completion before deletion to simulate the race condition\n+        // In the real scenario, this happens due to event timing\n+        setTimeout(() => {\n+          directEditing.complete();\n+        }, 0);\n+        \n+        modeling.removeElements([shape]);\n+      } catch (error) {\n+        if (error.message.includes('illegal invocation')) {\n+          errorThrown = true;\n+          console.log('REPRODUCED ERROR:', error.message);\n+        } else {\n+          throw error;\n+        }\n+      }\n+\n+      // then - should not throw illegal invocation error\n+      expect(errorThrown).to.be.false;\n+      expect(directEditing.isActive()).to.be.false;\n+    }\n+  ));\n+\n+  it('should handle race condition between completion and deletion', inject(\n+    function(elementRegistry, directEditing, modeling, commandStack, eventBus) {\n+\n+      // given\n+      var shape = elementRegistry.get('Task_1');\n+      \n+      // activate direct editing\n+      directEditing.activate(shape);\n+      directEditing._textbox.content.textContent = 'Modified Task';\n+\n+      var errorThrown = false;\n+      var originalPushAction = commandStack._pushAction;\n+      \n+      // Mock the command stack to detect illegal invocation\n+      commandStack._pushAction = function(action) {\n+        if (commandStack._currentExecution.atomic && action.command === 'element.updateLabel') {\n+          errorThrown = true;\n+          console.log('DETECTED: Illegal invocation attempt for action:', action.command);\n+          return; // Prevent the actual error\n+        }\n+        return originalPushAction.call(this, action);\n+      };\n+\n+      // when - simulate the race condition\n+      // Start deletion which should cancel direct editing\n+      modeling.removeElements([shape]);\n+      \n+      // Try to complete editing after deletion (this simulates the race condition)\n+      try {\n+        directEditing.complete();\n+      } catch (error) {\n+        // Ignore errors from trying to complete on deleted element\n+      }\n+\n+      // Restore original method\n+      commandStack._pushAction = originalPushAction;\n+\n+      // then - should have detected the illegal invocation attempt\n+      expect(errorThrown).to.be.true;\n+    }\n+  ));\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

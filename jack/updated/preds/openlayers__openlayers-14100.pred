27.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/reproj/common.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/tilecoord.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/TileCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/reproj/Triangulation.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/source/UrlTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/color.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/reproj.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/renderer/Layer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/Image.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/geom/Geometry.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/geom/flat/transform.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/structs/LRUCache.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/source/TileEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/tileurlfunction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/ImageState.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/source/Tile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/ImageBase.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:15:14] \"GET /src/ol/source/Source.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/Composite.js b/src/ol/renderer/Composite.js\nindex 8947c3655..d3f0fe68b 100644\n--- a/src/ol/renderer/Composite.js\n+++ b/src/ol/renderer/Composite.js\n@@ -106,6 +106,9 @@ class CompositeMapRenderer extends MapRenderer {\n      */\n     const declutterLayers = [];\n     let previousElement = null;\n+    \n+    // First pass: prepare all layers concurrently to allow concurrent tile loading\n+    const layerElements = [];\n     for (let i = 0, ii = layerStatesArray.length; i < ii; ++i) {\n       const layerState = layerStatesArray[i];\n       frameState.layerIndex = i;\n@@ -117,9 +120,29 @@ class CompositeMapRenderer extends MapRenderer {\n         (sourceState != 'ready' && sourceState != 'undefined')\n       ) {\n         layer.unrender();\n+        layerElements.push(null);\n         continue;\n       }\n \n+      // For tile layers, trigger tile loading by calling prepareFrame\n+      const layerRenderer = layer.getRenderer();\n+      if (layerRenderer && layerRenderer.prepareFrame) {\n+        layerRenderer.prepareFrame(frameState);\n+      }\n+      \n+      layerElements.push({ layer, layerState });\n+    }\n+    \n+    // Second pass: render all layers\n+    for (let i = 0, ii = layerElements.length; i < ii; ++i) {\n+      const layerInfo = layerElements[i];\n+      if (!layerInfo) {\n+        continue;\n+      }\n+      \n+      const { layer, layerState } = layerInfo;\n+      frameState.layerIndex = i;\n+\n       const element = layer.render(frameState, previousElement);\n       if (!element) {\n         continue;\ndiff --git a/test_layergroup_concurrent_loading.html b/test_layergroup_concurrent_loading.html\nnew file mode 100644\nindex 000000000..70b06bbac\n--- /dev/null\n+++ b/test_layergroup_concurrent_loading.html\n@@ -0,0 +1,205 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>LayerGroup Concurrent Loading Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        #info {\n+            margin-top: 20px;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 5px;\n+        }\n+        .request-log {\n+            margin-top: 10px;\n+            max-height: 200px;\n+            overflow-y: auto;\n+            background: white;\n+            border: 1px solid #ddd;\n+            padding: 10px;\n+            font-family: monospace;\n+            font-size: 12px;\n+        }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.0.0/ol.css\" type=\"text/css\">\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.0.0/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>LayerGroup Concurrent Loading Test</h1>\n+    <p>This test creates a LayerGroup with multiple TileLayers to observe tile loading behavior.</p>\n+    <p>Open browser dev tools Network tab to see if requests are concurrent or sequential.</p>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div id=\"info\">\n+        <h3>Test Results:</h3>\n+        <div id=\"results\">Loading...</div>\n+        <div class=\"request-log\" id=\"requestLog\">Request log will appear here...</div>\n+    </div>\n+\n+    <script>\n+        // Track request timing\n+        const requestLog = [];\n+        const originalFetch = window.fetch;\n+        \n+        window.fetch = function(...args) {\n+            const url = args[0];\n+            const timestamp = Date.now();\n+            requestLog.push({\n+                url: url,\n+                startTime: timestamp,\n+                type: 'start'\n+            });\n+            \n+            const logElement = document.getElementById('requestLog');\n+            logElement.innerHTML += `[${new Date(timestamp).toISOString()}] START: ${url}\\n`;\n+            logElement.scrollTop = logElement.scrollHeight;\n+            \n+            return originalFetch.apply(this, args).then(response => {\n+                const endTime = Date.now();\n+                requestLog.push({\n+                    url: url,\n+                    endTime: endTime,\n+                    duration: endTime - timestamp,\n+                    type: 'end'\n+                });\n+                \n+                logElement.innerHTML += `[${new Date(endTime).toISOString()}] END: ${url} (${endTime - timestamp}ms)\\n`;\n+                logElement.scrollTop = logElement.scrollHeight;\n+                \n+                return response;\n+            });\n+        };\n+\n+        // Override Image constructor to track tile loading\n+        const originalImage = window.Image;\n+        window.Image = function() {\n+            const img = new originalImage();\n+            const originalSrcSetter = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src').set;\n+            \n+            Object.defineProperty(img, 'src', {\n+                set: function(value) {\n+                    const timestamp = Date.now();\n+                    requestLog.push({\n+                        url: value,\n+                        startTime: timestamp,\n+                        type: 'tile_start'\n+                    });\n+                    \n+                    const logElement = document.getElementById('requestLog');\n+                    logElement.innerHTML += `[${new Date(timestamp).toISOString()}] TILE START: ${value}\\n`;\n+                    logElement.scrollTop = logElement.scrollHeight;\n+                    \n+                    // Set up load/error handlers to track completion\n+                    const onLoad = () => {\n+                        const endTime = Date.now();\n+                        requestLog.push({\n+                            url: value,\n+                            endTime: endTime,\n+                            duration: endTime - timestamp,\n+                            type: 'tile_end'\n+                        });\n+                        \n+                        logElement.innerHTML += `[${new Date(endTime).toISOString()}] TILE END: ${value} (${endTime - timestamp}ms)\\n`;\n+                        logElement.scrollTop = logElement.scrollHeight;\n+                    };\n+                    \n+                    const onError = () => {\n+                        const endTime = Date.now();\n+                        logElement.innerHTML += `[${new Date(endTime).toISOString()}] TILE ERROR: ${value} (${endTime - timestamp}ms)\\n`;\n+                        logElement.scrollTop = logElement.scrollHeight;\n+                    };\n+                    \n+                    img.addEventListener('load', onLoad, { once: true });\n+                    img.addEventListener('error', onError, { once: true });\n+                    \n+                    originalSrcSetter.call(this, value);\n+                },\n+                get: function() {\n+                    return originalSrcSetter.call(this);\n+                }\n+            });\n+            \n+            return img;\n+        };\n+\n+        // Create multiple tile layers\n+        const layers = [];\n+        for (let i = 0; i < 5; i++) {\n+            layers.push(new ol.layer.Tile({\n+                source: new ol.source.OSM({\n+                    url: `https://tile.openstreetmap.org/{z}/{x}/{y}.png?layer=${i}`\n+                }),\n+                opacity: 0.2\n+            }));\n+        }\n+\n+        // Create a LayerGroup\n+        const layerGroup = new ol.layer.Group({\n+            layers: layers\n+        });\n+\n+        // Create map\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [layerGroup],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        // Analyze request patterns after some time\n+        setTimeout(() => {\n+            const results = document.getElementById('results');\n+            const tileRequests = requestLog.filter(r => r.type === 'tile_start');\n+            \n+            if (tileRequests.length > 0) {\n+                // Check if requests are concurrent or sequential\n+                const startTimes = tileRequests.map(r => r.startTime).sort((a, b) => a - b);\n+                const timeDiffs = [];\n+                for (let i = 1; i < startTimes.length; i++) {\n+                    timeDiffs.push(startTimes[i] - startTimes[i-1]);\n+                }\n+                \n+                const avgTimeDiff = timeDiffs.reduce((a, b) => a + b, 0) / timeDiffs.length;\n+                const maxTimeDiff = Math.max(...timeDiffs);\n+                const minTimeDiff = Math.min(...timeDiffs);\n+                \n+                let behavior = 'UNKNOWN';\n+                if (avgTimeDiff < 50) { // Less than 50ms average difference suggests concurrent\n+                    behavior = 'CONCURRENT';\n+                } else if (avgTimeDiff > 200) { // More than 200ms suggests sequential\n+                    behavior = 'SEQUENTIAL';\n+                } else {\n+                    behavior = 'MIXED';\n+                }\n+                \n+                results.innerHTML = `\n+                    <strong>Tile Loading Behavior: ${behavior}</strong><br>\n+                    Total tile requests: ${tileRequests.length}<br>\n+                    Average time between requests: ${avgTimeDiff.toFixed(2)}ms<br>\n+                    Min time between requests: ${minTimeDiff}ms<br>\n+                    Max time between requests: ${maxTimeDiff}ms<br>\n+                    <br>\n+                    ${behavior === 'SEQUENTIAL' ? \n+                        '<span style=\"color: red;\">\u26a0\ufe0f ISSUE DETECTED: Tiles are loading sequentially!</span>' : \n+                        '<span style=\"color: green;\">\u2705 Tiles are loading concurrently as expected.</span>'\n+                    }\n+                `;\n+            } else {\n+                results.innerHTML = 'No tile requests detected yet. Try zooming or panning the map.';\n+            }\n+        }, 3000);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple.html b/test_simple.html\nnew file mode 100644\nindex 000000000..b88093ad4\n--- /dev/null\n+++ b/test_simple.html\n@@ -0,0 +1,58 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple LayerGroup Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        #info { margin-top: 20px; padding: 10px; background: #f0f0f0; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Simple LayerGroup Test</h1>\n+    <div id=\"map\"></div>\n+    <div id=\"info\">\n+        <p>Check browser dev tools Network tab to observe tile loading behavior.</p>\n+        <p>With the issue: requests should be sequential (one after another)</p>\n+        <p>Expected behavior: requests should be concurrent (all at once)</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        // Import OpenLayers from the local build\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import LayerGroup from './src/ol/layer/Group.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create multiple tile layers with different URLs to make them distinct\n+        const layers = [];\n+        for (let i = 0; i < 5; i++) {\n+            layers.push(new TileLayer({\n+                source: new OSM({\n+                    url: `https://tile.openstreetmap.org/{z}/{x}/{y}.png?layer=${i}`\n+                }),\n+                opacity: 0.3\n+            }));\n+        }\n+\n+        // Create a LayerGroup\n+        const layerGroup = new LayerGroup({\n+            layers: layers\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [layerGroup],\n+            view: new View({\n+                center: fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        console.log('Map created with LayerGroup containing', layers.length, 'layers');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

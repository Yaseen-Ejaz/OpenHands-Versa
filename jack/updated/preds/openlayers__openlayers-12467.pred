{"instance_id": "openlayers__openlayers-12467", "model_patch": "diff --git a/src/ol/PluggableMap.js b/src/ol/PluggableMap.js\nindex 4d8dfdb55..6833f2385 100644\n--- a/src/ol/PluggableMap.js\n+++ b/src/ol/PluggableMap.js\n@@ -53,6 +53,7 @@ import {removeNode} from './dom.js';\n  * @property {number} layerIndex LayerIndex.\n  * @property {import(\"./transform.js\").Transform} pixelToCoordinateTransform PixelToCoordinateTransform.\n  * @property {Array<PostRenderFunction>} postRenderFunctions PostRenderFunctions.\n+ * @property {boolean} [programmaticRender] Whether this render was triggered programmatically (e.g., for feature animations).\n  * @property {import(\"./size.js\").Size} size Size.\n  * @property {TileQueue} tileQueue TileQueue.\n  * @property {!Object<string, Object<string, boolean>>} usedTiles UsedTiles.\n@@ -200,6 +201,12 @@ class PluggableMap extends BaseObject {\n      */\n     this.animationDelayKey_;\n \n+    /**\n+     * @private\n+     * @type {boolean}\n+     */\n+    this.programmaticRender_ = false;\n+\n     /**\n      * @private\n      */\n@@ -1319,6 +1326,7 @@ class PluggableMap extends BaseObject {\n    */\n   render() {\n     if (this.renderer_ && this.animationDelayKey_ === undefined) {\n+      this.programmaticRender_ = true;\n       this.animationDelayKey_ = requestAnimationFrame(this.animationDelay_);\n     }\n   }\n@@ -1406,11 +1414,15 @@ class PluggableMap extends BaseObject {\n         viewState: viewState,\n         viewHints: viewHints,\n         wantedTiles: {},\n+        programmaticRender: this.programmaticRender_,\n       };\n     }\n \n     this.frameState_ = frameState;\n     this.renderer_.renderFrame(frameState);\n+    \n+    // Reset programmatic render flag after rendering\n+    this.programmaticRender_ = false;\n \n     if (frameState) {\n       if (frameState.animate) {\ndiff --git a/src/ol/renderer/canvas/VectorLayer.js b/src/ol/renderer/canvas/VectorLayer.js\nindex c3aa878ac..04a683b5c 100644\n--- a/src/ol/renderer/canvas/VectorLayer.js\n+++ b/src/ol/renderer/canvas/VectorLayer.js\n@@ -178,7 +178,7 @@ class CanvasVectorLayerRenderer extends CanvasLayerRenderer {\n     const pixelRatio = frameState.pixelRatio;\n     const viewHints = frameState.viewHints;\n     const snapToPixel = !(\n-      viewHints[ViewHint.ANIMATING] || viewHints[ViewHint.INTERACTING]\n+      viewHints[ViewHint.ANIMATING] || viewHints[ViewHint.INTERACTING] || frameState.programmaticRender\n     );\n     const context = this.context;\n     const width = Math.round(frameState.size[0] * pixelRatio);\ndiff --git a/test_circle_animation_jitter.html b/test_circle_animation_jitter.html\nnew file mode 100644\nindex 000000000..d95535b6a\n--- /dev/null\n+++ b/test_circle_animation_jitter.html\n@@ -0,0 +1,180 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Circle Animation Jitter Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        .map-container {\n+            display: flex;\n+            gap: 20px;\n+            margin-bottom: 20px;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        .controls {\n+            margin-bottom: 20px;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px 15px;\n+            font-size: 14px;\n+        }\n+        .info {\n+            background: #f0f0f0;\n+            padding: 10px;\n+            margin-bottom: 20px;\n+            border-radius: 5px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h2>Circle Animation Jitter Test</h2>\n+        <p>This test reproduces the circle animation jitter issue described in the GitHub issue.</p>\n+        <p>The animation shows expanding circles with different sizes to demonstrate the jitter effect.</p>\n+        <p>Jitter is most visible with larger circles at the end of the animation.</p>\n+    </div>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"startAnimation()\">Start Animation</button>\n+        <button onclick=\"stopAnimation()\">Stop Animation</button>\n+        <button onclick=\"clearFeatures()\">Clear Features</button>\n+    </div>\n+    \n+    <div class=\"map-container\">\n+        <div id=\"map\" class=\"map\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Feature from './src/ol/Feature.js';\n+        import Map from './src/ol/Map.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import View from './src/ol/View.js';\n+        import {Circle as CircleStyle, Stroke, Style} from './src/ol/style.js';\n+        import {OSM, Vector as VectorSource} from './src/ol/source.js';\n+        import {Tile as TileLayer, Vector as VectorLayer} from './src/ol/layer.js';\n+        import {easeOut} from './src/ol/easing.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+        import {getVectorContext} from './src/ol/render.js';\n+        import {unByKey} from './src/ol/Observable.js';\n+\n+        const tileLayer = new TileLayer({\n+            source: new OSM({\n+                wrapX: false,\n+            }),\n+        });\n+\n+        const source = new VectorSource({\n+            wrapX: false,\n+        });\n+        \n+        const vector = new VectorLayer({\n+            source: source,\n+        });\n+\n+        const map = new Map({\n+            layers: [tileLayer, vector],\n+            target: 'map',\n+            view: new View({\n+                center: fromLonLat([0, 0]),\n+                zoom: 4,\n+            }),\n+        });\n+\n+        let animationInterval;\n+        let activeAnimations = [];\n+\n+        function addRandomFeature() {\n+            const x = Math.random() * 360 - 180;\n+            const y = Math.random() * 170 - 85;\n+            const geom = new Point(fromLonLat([x, y]));\n+            const feature = new Feature(geom);\n+            source.addFeature(feature);\n+        }\n+\n+        const duration = 4000; // Longer duration to see jitter better\n+        \n+        function flash(feature, maxRadius = 50) {\n+            const start = Date.now();\n+            const flashGeom = feature.getGeometry().clone();\n+            const listenerKey = tileLayer.on('postrender', animate);\n+            \n+            activeAnimations.push(listenerKey);\n+\n+            function animate(event) {\n+                const frameState = event.frameState;\n+                const elapsed = frameState.time - start;\n+                if (elapsed >= duration) {\n+                    unByKey(listenerKey);\n+                    const index = activeAnimations.indexOf(listenerKey);\n+                    if (index > -1) {\n+                        activeAnimations.splice(index, 1);\n+                    }\n+                    return;\n+                }\n+                const vectorContext = getVectorContext(event);\n+                const elapsedRatio = elapsed / duration;\n+                // radius will be 5 at start and maxRadius at end.\n+                const radius = easeOut(elapsedRatio) * (maxRadius - 5) + 5;\n+                const opacity = easeOut(1 - elapsedRatio);\n+\n+                const style = new Style({\n+                    image: new CircleStyle({\n+                        radius: radius,\n+                        stroke: new Stroke({\n+                            color: 'rgba(255, 0, 0, ' + opacity + ')',\n+                            width: 0.5 + opacity * 2,\n+                        }),\n+                    }),\n+                });\n+\n+                vectorContext.setStyle(style);\n+                vectorContext.drawGeometry(flashGeom);\n+                // tell OpenLayers to continue postrender animation\n+                map.render();\n+            }\n+        }\n+\n+        source.on('addfeature', function (e) {\n+            // Create circles with different max sizes to show jitter more clearly\n+            const maxRadius = 30 + Math.random() * 40; // Between 30 and 70 pixels\n+            flash(e.feature, maxRadius);\n+        });\n+\n+        window.startAnimation = function() {\n+            if (animationInterval) {\n+                clearInterval(animationInterval);\n+            }\n+            animationInterval = setInterval(addRandomFeature, 800);\n+        };\n+\n+        window.stopAnimation = function() {\n+            if (animationInterval) {\n+                clearInterval(animationInterval);\n+                animationInterval = null;\n+            }\n+        };\n+\n+        window.clearFeatures = function() {\n+            source.clear();\n+            // Stop all active animations\n+            activeAnimations.forEach(key => unByKey(key));\n+            activeAnimations = [];\n+        };\n+\n+        // Start with a few features for immediate testing\n+        setTimeout(() => {\n+            addRandomFeature();\n+            addRandomFeature();\n+            addRandomFeature();\n+        }, 500);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix.js b/test_fix.js\nnew file mode 100644\nindex 000000000..f4be4367b\n--- /dev/null\n+++ b/test_fix.js\n@@ -0,0 +1,134 @@\n+/**\n+ * Simple test to verify the circle animation jitter fix\n+ * This test checks that programmatic renders disable pixel snapping\n+ */\n+\n+// Mock the necessary OpenLayers modules for testing\n+const ViewHint = {\n+  ANIMATING: 0,\n+  INTERACTING: 1,\n+};\n+\n+// Test the snapToPixel logic from VectorLayer.js\n+function testSnapToPixelLogic() {\n+  console.log('Testing snapToPixel logic...');\n+  \n+  // Test case 1: Normal rendering (should snap to pixel)\n+  const frameState1 = {\n+    viewHints: [0, 0], // No hints set\n+    programmaticRender: false\n+  };\n+  const viewHints1 = frameState1.viewHints;\n+  const snapToPixel1 = !(\n+    viewHints1[ViewHint.ANIMATING] || viewHints1[ViewHint.INTERACTING] || frameState1.programmaticRender\n+  );\n+  console.log('Normal rendering - snapToPixel:', snapToPixel1); // Should be true\n+  \n+  // Test case 2: View animation (should not snap to pixel)\n+  const frameState2 = {\n+    viewHints: [1, 0], // ANIMATING hint set\n+    programmaticRender: false\n+  };\n+  const viewHints2 = frameState2.viewHints;\n+  const snapToPixel2 = !(\n+    viewHints2[ViewHint.ANIMATING] || viewHints2[ViewHint.INTERACTING] || frameState2.programmaticRender\n+  );\n+  console.log('View animation - snapToPixel:', snapToPixel2); // Should be false\n+  \n+  // Test case 3: Programmatic render (feature animation) - should not snap to pixel\n+  const frameState3 = {\n+    viewHints: [0, 0], // No view hints set\n+    programmaticRender: true // But programmatic render is true\n+  };\n+  const viewHints3 = frameState3.viewHints;\n+  const snapToPixel3 = !(\n+    viewHints3[ViewHint.ANIMATING] || viewHints3[ViewHint.INTERACTING] || frameState3.programmaticRender\n+  );\n+  console.log('Feature animation (programmatic render) - snapToPixel:', snapToPixel3); // Should be false\n+  \n+  // Test case 4: Interaction (should not snap to pixel)\n+  const frameState4 = {\n+    viewHints: [0, 1], // INTERACTING hint set\n+    programmaticRender: false\n+  };\n+  const viewHints4 = frameState4.viewHints;\n+  const snapToPixel4 = !(\n+    viewHints4[ViewHint.ANIMATING] || viewHints4[ViewHint.INTERACTING] || frameState4.programmaticRender\n+  );\n+  console.log('Interaction - snapToPixel:', snapToPixel4); // Should be false\n+  \n+  // Verify results\n+  const results = [\n+    { case: 'Normal rendering', expected: true, actual: snapToPixel1 },\n+    { case: 'View animation', expected: false, actual: snapToPixel2 },\n+    { case: 'Feature animation', expected: false, actual: snapToPixel3 },\n+    { case: 'Interaction', expected: false, actual: snapToPixel4 }\n+  ];\n+  \n+  let allPassed = true;\n+  results.forEach(result => {\n+    const passed = result.expected === result.actual;\n+    console.log(`${result.case}: ${passed ? 'PASS' : 'FAIL'} (expected: ${result.expected}, actual: ${result.actual})`);\n+    if (!passed) allPassed = false;\n+  });\n+  \n+  console.log('\\n' + (allPassed ? '\u2705 All tests passed!' : '\u274c Some tests failed!'));\n+  return allPassed;\n+}\n+\n+// Test the programmatic render flag management\n+function testProgrammaticRenderFlag() {\n+  console.log('\\nTesting programmatic render flag management...');\n+  \n+  // Simulate the PluggableMap behavior\n+  class MockMap {\n+    constructor() {\n+      this.programmaticRender_ = false;\n+    }\n+    \n+    render() {\n+      console.log('render() called - setting programmaticRender_ to true');\n+      this.programmaticRender_ = true;\n+      // Simulate the renderFrame_ call\n+      this.renderFrame_();\n+    }\n+    \n+    renderFrame_() {\n+      console.log('renderFrame_() called - programmaticRender_:', this.programmaticRender_);\n+      const frameState = {\n+        programmaticRender: this.programmaticRender_\n+      };\n+      \n+      // Simulate rendering\n+      console.log('Rendering with frameState.programmaticRender:', frameState.programmaticRender);\n+      \n+      // Reset flag after rendering (as implemented)\n+      this.programmaticRender_ = false;\n+      console.log('Flag reset - programmaticRender_:', this.programmaticRender_);\n+    }\n+  }\n+  \n+  const map = new MockMap();\n+  \n+  // Test initial state\n+  console.log('Initial programmaticRender_:', map.programmaticRender_); // Should be false\n+  \n+  // Test programmatic render\n+  map.render();\n+  \n+  // Test that flag is reset\n+  console.log('Final programmaticRender_:', map.programmaticRender_); // Should be false again\n+  \n+  return true;\n+}\n+\n+// Run tests\n+console.log('=== Circle Animation Jitter Fix Test ===\\n');\n+\n+const test1Passed = testSnapToPixelLogic();\n+const test2Passed = testProgrammaticRenderFlag();\n+\n+console.log('\\n=== Test Summary ===');\n+console.log('snapToPixel logic test:', test1Passed ? 'PASS' : 'FAIL');\n+console.log('Programmatic render flag test:', test2Passed ? 'PASS' : 'FAIL');\n+console.log('Overall result:', (test1Passed && test2Passed) ? '\u2705 ALL TESTS PASSED' : '\u274c SOME TESTS FAILED');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

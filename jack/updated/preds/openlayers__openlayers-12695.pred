{"instance_id": "openlayers__openlayers-12695", "model_patch": "diff --git a/simple_test.html b/simple_test.html\nnew file mode 100644\nindex 000000000..960181f3c\n--- /dev/null\n+++ b/simple_test.html\n@@ -0,0 +1,137 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple KML Anchor Test</title>\n+    <style>\n+        body { margin: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        #info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+        button { padding: 10px; margin: 5px; }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/ol.css\">\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@7.5.2/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>KML Symbol Anchor Point Issue Test</h1>\n+    <p>This test shows the current anchor point issue with Google Maps KML icons.</p>\n+    <button onclick=\"loadKML()\">Load Test KML</button>\n+    <button onclick=\"clearMap()\">Clear</button>\n+    \n+    <div id=\"map\"></div>\n+    <div id=\"info\">Click \"Load Test KML\" to see the issue.</div>\n+\n+    <script>\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [\n+                new ol.layer.Tile({\n+                    source: new ol.source.OSM()\n+                })\n+            ],\n+            view: new ol.View({\n+                center: ol.proj.fromLonLat([-122.365, 37.818]),\n+                zoom: 17\n+            })\n+        });\n+\n+        let vectorLayer = null;\n+\n+        function loadKML() {\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+            }\n+\n+            const kmlContent = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n+  <Document>\n+    <Style id=\"redRect\">\n+      <LineStyle>\n+        <color>ff0000ff</color>\n+        <width>4</width>\n+      </LineStyle>\n+      <PolyStyle>\n+        <color>220000ff</color>\n+      </PolyStyle>\n+    </Style>\n+    \n+    <Style id=\"starIcon\">\n+      <IconStyle>\n+        <Icon>\n+          <href>http://maps.google.com/mapfiles/kml/shapes/star.png</href>\n+        </Icon>\n+        <scale>2.0</scale>\n+      </IconStyle>\n+    </Style>\n+    \n+    <!-- Red rectangle to show where star should be centered -->\n+    <Placemark>\n+      <name>Target Rectangle</name>\n+      <styleUrl>#redRect</styleUrl>\n+      <Polygon>\n+        <outerBoundaryIs>\n+          <LinearRing>\n+            <coordinates>\n+              -122.367,37.817,0\n+              -122.363,37.817,0\n+              -122.363,37.819,0\n+              -122.367,37.819,0\n+              -122.367,37.817,0\n+            </coordinates>\n+          </LinearRing>\n+        </outerBoundaryIs>\n+      </Polygon>\n+    </Placemark>\n+    \n+    <!-- Star that should be centered on rectangle -->\n+    <Placemark>\n+      <name>Star (should be centered)</name>\n+      <styleUrl>#starIcon</styleUrl>\n+      <Point>\n+        <coordinates>-122.365,37.818,0</coordinates>\n+      </Point>\n+    </Placemark>\n+    \n+  </Document>\n+</kml>`;\n+\n+            const kmlFormat = new ol.format.KML({\n+                extractStyles: true\n+            });\n+\n+            try {\n+                const features = kmlFormat.readFeatures(kmlContent, {\n+                    dataProjection: 'EPSG:4326',\n+                    featureProjection: 'EPSG:3857'\n+                });\n+\n+                const vectorSource = new ol.source.Vector({\n+                    features: features\n+                });\n+\n+                vectorLayer = new ol.layer.Vector({\n+                    source: vectorSource\n+                });\n+\n+                map.addLayer(vectorLayer);\n+                map.getView().fit(vectorSource.getExtent(), {\n+                    padding: [50, 50, 50, 50]\n+                });\n+\n+                document.getElementById('info').innerHTML = \n+                    'KML loaded. The star should be centered on the red rectangle, but due to the anchor point bug, it appears offset (anchored at bottom-center instead of center-center).';\n+\n+            } catch (error) {\n+                document.getElementById('info').innerHTML = 'Error: ' + error.message;\n+            }\n+        }\n+\n+        function clearMap() {\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+                vectorLayer = null;\n+            }\n+            document.getElementById('info').innerHTML = 'Map cleared.';\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/format/KML.js b/src/ol/format/KML.js\nindex 27c00fd9e..69a2361ff 100644\n--- a/src/ol/format/KML.js\n+++ b/src/ol/format/KML.js\n@@ -1283,7 +1283,7 @@ function iconStyleParser(node, objectStack) {\n     anchorXUnits = DEFAULT_IMAGE_STYLE_ANCHOR_X_UNITS;\n     anchorYUnits = DEFAULT_IMAGE_STYLE_ANCHOR_Y_UNITS;\n   } else if (/^http:\\/\\/maps\\.(?:google|gstatic)\\.com\\//.test(src)) {\n-    anchor = [0.5, 0];\n+    anchor = [0.5, 0.5];\n     anchorXUnits = IconAnchorUnits.FRACTION;\n     anchorYUnits = IconAnchorUnits.FRACTION;\n   }\ndiff --git a/test_anchor_issue.html b/test_anchor_issue.html\nnew file mode 100644\nindex 000000000..b4483a77b\n--- /dev/null\n+++ b/test_anchor_issue.html\n@@ -0,0 +1,178 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>KML Anchor Point Test - OpenLayers Dev</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        #info { margin-top: 10px; padding: 10px; background: #f0f0f0; }\n+        .test-section { margin: 20px 0; }\n+        button { padding: 10px; margin: 5px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>KML Symbol Anchor Point Test - OpenLayers Dev Build</h1>\n+    <div class=\"test-section\">\n+        <p>This test demonstrates the KML symbol anchor point issue using the development build of OpenLayers.</p>\n+        <button onclick=\"loadTestKML()\">Load Test KML</button>\n+        <button onclick=\"clearMap()\">Clear Map</button>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+    <div id=\"info\">Click \"Load Test KML\" to see the anchor point issue.</div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import {Tile as TileLayer, Vector as VectorLayer} from './src/ol/layer.js';\n+        import {OSM, Vector as VectorSource} from './src/ol/source.js';\n+        import KML from './src/ol/format/KML.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create the map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([-122.365, 37.818]),\n+                zoom: 16\n+            })\n+        });\n+\n+        let vectorLayer = null;\n+\n+        window.loadTestKML = function() {\n+            // Clear existing layer\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+            }\n+\n+            // Create KML format\n+            const kmlFormat = new KML({\n+                extractStyles: true,\n+                showPointNames: true\n+            });\n+\n+            // Simple KML content with Google Maps star icon\n+            const kmlContent = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n+  <Document>\n+    <name>Test KML Anchor Points</name>\n+    \n+    <!-- Style for red circle -->\n+    <Style id=\"redCircle\">\n+      <LineStyle>\n+        <color>ff0000ff</color>\n+        <width>3</width>\n+      </LineStyle>\n+      <PolyStyle>\n+        <color>330000ff</color>\n+      </PolyStyle>\n+    </Style>\n+    \n+    <!-- Style for star symbol using Google Maps icon -->\n+    <Style id=\"starIcon\">\n+      <IconStyle>\n+        <Icon>\n+          <href>http://maps.google.com/mapfiles/kml/shapes/star.png</href>\n+        </Icon>\n+        <scale>1.5</scale>\n+      </IconStyle>\n+    </Style>\n+    \n+    <!-- Red circle -->\n+    <Placemark>\n+      <name>Circle</name>\n+      <styleUrl>#redCircle</styleUrl>\n+      <Polygon>\n+        <outerBoundaryIs>\n+          <LinearRing>\n+            <coordinates>\n+              -122.367,37.817,0\n+              -122.363,37.817,0\n+              -122.363,37.819,0\n+              -122.367,37.819,0\n+              -122.367,37.817,0\n+            </coordinates>\n+          </LinearRing>\n+        </outerBoundaryIs>\n+      </Polygon>\n+    </Placemark>\n+    \n+    <!-- Star symbol - should be centered on circle -->\n+    <Placemark>\n+      <name>Star</name>\n+      <styleUrl>#starIcon</styleUrl>\n+      <Point>\n+        <coordinates>-122.365,37.818,0</coordinates>\n+      </Point>\n+    </Placemark>\n+    \n+  </Document>\n+</kml>`;\n+\n+            try {\n+                // Parse KML\n+                const features = kmlFormat.readFeatures(kmlContent, {\n+                    dataProjection: 'EPSG:4326',\n+                    featureProjection: 'EPSG:3857'\n+                });\n+\n+                console.log('Loaded features:', features.length);\n+\n+                // Create vector source and layer\n+                const vectorSource = new VectorSource({\n+                    features: features\n+                });\n+\n+                vectorLayer = new VectorLayer({\n+                    source: vectorSource\n+                });\n+\n+                map.addLayer(vectorLayer);\n+\n+                // Fit to extent with padding\n+                const extent = vectorSource.getExtent();\n+                console.log('Extent:', extent);\n+                map.getView().fit(extent, {\n+                    padding: [100, 100, 100, 100],\n+                    maxZoom: 18\n+                });\n+\n+                document.getElementById('info').innerHTML = \n+                    'KML loaded with ' + features.length + ' features. ' +\n+                    'The star should be centered on the red rectangle, but it appears offset due to the anchor point issue.';\n+\n+            } catch (error) {\n+                document.getElementById('info').innerHTML = 'Error loading KML: ' + error.message;\n+                console.error('KML loading error:', error);\n+            }\n+        }\n+\n+        window.clearMap = function() {\n+            if (vectorLayer) {\n+                map.removeLayer(vectorLayer);\n+                vectorLayer = null;\n+            }\n+            document.getElementById('info').innerHTML = 'Map cleared.';\n+        }\n+\n+        // Add click handler to show feature info\n+        map.on('click', function(evt) {\n+            const features = [];\n+            map.forEachFeatureAtPixel(evt.pixel, function(feature) {\n+                features.push(feature);\n+            });\n+            \n+            if (features.length > 0) {\n+                const info = features.map(f => f.get('name') || 'Unnamed feature').join(', ');\n+                document.getElementById('info').innerHTML = 'Clicked features: ' + info;\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

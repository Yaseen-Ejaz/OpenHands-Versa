{"instance_id": "bpmn-io__bpmn-js-1928", "model_patch": "diff --git a/lib/features/space-tool/BpmnSpaceTool.js b/lib/features/space-tool/BpmnSpaceTool.js\nindex 905d17c9..4bb323e4 100644\n--- a/lib/features/space-tool/BpmnSpaceTool.js\n+++ b/lib/features/space-tool/BpmnSpaceTool.js\n@@ -2,7 +2,7 @@ import inherits from 'inherits-browser';\n \n import SpaceTool from 'diagram-js/lib/features/space-tool/SpaceTool';\n \n-import { is } from '../../util/ModelUtil';\n+import { is, getBusinessObject } from '../../util/ModelUtil';\n \n /**\n  * @typedef {import('didi').Injector} Injector\n@@ -42,5 +42,18 @@ BpmnSpaceTool.prototype.calculateAdjustments = function(elements, axis, delta, s\n     return !is(shape, 'bpmn:TextAnnotation');\n   });\n \n+  // do not resize empty pools vertically\n+  if (axis === 'y') {\n+    adjustments.resizingShapes = adjustments.resizingShapes.filter(function(shape) {\n+      if (is(shape, 'bpmn:Participant')) {\n+        var businessObject = getBusinessObject(shape);\n+\n+        // empty pools don't have a processRef\n+        return !!businessObject.processRef;\n+      }\n+      return true;\n+    });\n+  }\n+\n   return adjustments;\n };\n\\ No newline at end of file\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..25ac396a\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,5 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Mar/2026 06:01:33] \"GET /test-empty-pool.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:01:33] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:04:46] \"GET /test-empty-pool.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:04:46] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/test-empty-pool.html b/test-empty-pool.html\nnew file mode 100644\nindex 00000000..37ed87a1\n--- /dev/null\n+++ b/test-empty-pool.html\n@@ -0,0 +1,143 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js Empty Pool Space Tool Test</title>\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 20px;\n+    }\n+    #canvas {\n+      border: 1px solid #ccc;\n+      height: 600px;\n+      width: 100%;\n+    }\n+    .controls {\n+      margin: 20px 0;\n+    }\n+    button {\n+      margin: 5px;\n+      padding: 10px;\n+    }\n+    .info {\n+      background: #f0f0f0;\n+      padding: 10px;\n+      margin: 10px 0;\n+      border-radius: 5px;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN.js Empty Pool Space Tool Test</h1>\n+  \n+  <div class=\"info\">\n+    <h3>Test Instructions:</h3>\n+    <ol>\n+      <li>Click \"Load Test Diagram\" to load a diagram with empty and expanded pools</li>\n+      <li>Click \"Activate Space Tool\" to enable the space tool</li>\n+      <li>Try using the space tool above the empty pool (should NOT resize vertically)</li>\n+      <li>Try using the space tool above the expanded pool (should resize vertically)</li>\n+    </ol>\n+  </div>\n+\n+  <div class=\"controls\">\n+    <button onclick=\"loadTestDiagram()\">Load Test Diagram</button>\n+    <button onclick=\"activateSpaceTool()\">Activate Space Tool</button>\n+    <button onclick=\"deactivateSpaceTool()\">Deactivate Space Tool</button>\n+  </div>\n+\n+  <div id=\"canvas\"></div>\n+\n+  <div class=\"info\">\n+    <h3>Current Issue:</h3>\n+    <p>Empty pools (participants without processRef) are being resized vertically by the space tool, but they should maintain their fixed height.</p>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var bpmnModeler;\n+    var spaceTool;\n+\n+    // Test BPMN XML with empty and expanded pools\n+    var testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_empty_pool\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"EmptyPool_1\" name=\"Empty Pool (should NOT resize vertically)\" />\n+    <bpmn:participant id=\"ExpandedPool_1\" name=\"Expanded Pool (should resize vertically)\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"EmptyPool_1_di\" bpmnElement=\"EmptyPool_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"500\" height=\"150\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"ExpandedPool_1_di\" bpmnElement=\"ExpandedPool_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"300\" width=\"500\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"382\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function initModeler() {\n+      bpmnModeler = new BpmnJS({\n+        container: '#canvas',\n+        keyboard: {\n+          bindTo: window\n+        }\n+      });\n+\n+      spaceTool = bpmnModeler.get('spaceTool');\n+    }\n+\n+    function loadTestDiagram() {\n+      if (!bpmnModeler) {\n+        initModeler();\n+      }\n+\n+      bpmnModeler.importXML(testXML).then(function(result) {\n+        console.log('Diagram loaded successfully');\n+        \n+        // Get element registry to inspect pools\n+        var elementRegistry = bpmnModeler.get('elementRegistry');\n+        var emptyPool = elementRegistry.get('EmptyPool_1');\n+        var expandedPool = elementRegistry.get('ExpandedPool_1');\n+        \n+        console.log('Empty Pool:', emptyPool);\n+        console.log('Empty Pool Business Object:', emptyPool.businessObject);\n+        console.log('Empty Pool has processRef:', !!emptyPool.businessObject.processRef);\n+        \n+        console.log('Expanded Pool:', expandedPool);\n+        console.log('Expanded Pool Business Object:', expandedPool.businessObject);\n+        console.log('Expanded Pool has processRef:', !!expandedPool.businessObject.processRef);\n+        \n+      }).catch(function(err) {\n+        console.error('Error loading diagram:', err);\n+      });\n+    }\n+\n+    function activateSpaceTool() {\n+      if (spaceTool) {\n+        spaceTool.toggle();\n+        console.log('Space tool activated. Click and drag to create space.');\n+      }\n+    }\n+\n+    function deactivateSpaceTool() {\n+      if (spaceTool && spaceTool.isActive()) {\n+        spaceTool.toggle();\n+        console.log('Space tool deactivated.');\n+      }\n+    }\n+\n+    // Initialize on page load\n+    window.onload = function() {\n+      initModeler();\n+    };\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.bpmn b/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.bpmn\nnew file mode 100644\nindex 00000000..8dc1f5f7\n--- /dev/null\n+++ b/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.bpmn\n@@ -0,0 +1,23 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_empty_pool\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"3.7.0\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"EmptyPool_1\" name=\"Empty Pool\" />\n+    <bpmn:participant id=\"ExpandedPool_1\" name=\"Expanded Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"EmptyPool_1_di\" bpmnElement=\"EmptyPool_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"400\" height=\"150\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"ExpandedPool_1_di\" bpmnElement=\"ExpandedPool_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"300\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"382\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.spec.js b/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.spec.js\nnew file mode 100644\nindex 00000000..01a148df\n--- /dev/null\n+++ b/test/spec/features/space-tool/BpmnSpaceTool.empty-pool.spec.js\n@@ -0,0 +1,183 @@\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import rulesModule from 'lib/features/rules';\n+import snappingModule from 'lib/features/snapping';\n+import spaceToolModule from 'lib/features/space-tool';\n+\n+import { createCanvasEvent as canvasEvent } from '../../../util/MockEvents';\n+\n+import { pick } from 'min-dash';\n+\n+import { isMac } from 'diagram-js/lib/util/Platform';\n+\n+var invertModifier = isMac() ? { metaKey: true } : { ctrlKey: true };\n+\n+describe('features/space-tool - BpmnSpaceTool - Empty Pool', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    rulesModule,\n+    snappingModule,\n+    spaceToolModule\n+  ];\n+\n+  var diagramXML = require('./BpmnSpaceTool.empty-pool.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  beforeEach(inject(function(dragging) {\n+    dragging.setOptions({ manual: true });\n+  }));\n+\n+  describe('empty pool behavior', function() {\n+\n+    it('should NOT resize empty pool vertically when using space tool from top', inject(function(elementRegistry) {\n+\n+      // given\n+      var emptyPool = elementRegistry.get('EmptyPool_1');\n+      var expandedPool = elementRegistry.get('ExpandedPool_1');\n+\n+      var emptyPoolBounds = getBounds(emptyPool);\n+      var expandedPoolBounds = getBounds(expandedPool);\n+\n+      // when - use space tool above empty pool\n+      makeSpace({ x: 300, y: 80 }, { dy: 50 });\n+\n+      // then - empty pool should NOT be resized vertically\n+      expect(emptyPool).to.have.bounds({\n+        x: emptyPoolBounds.x,\n+        y: emptyPoolBounds.y,\n+        width: emptyPoolBounds.width,\n+        height: emptyPoolBounds.height // height should remain the same\n+      });\n+\n+      // and expanded pool should be resized normally\n+      expect(expandedPool).to.have.bounds({\n+        x: expandedPoolBounds.x,\n+        y: expandedPoolBounds.y,\n+        width: expandedPoolBounds.width,\n+        height: expandedPoolBounds.height + 50 // height should increase\n+      });\n+    }));\n+\n+    it('should NOT resize empty pool vertically when using space tool from bottom', inject(function(elementRegistry) {\n+\n+      // given\n+      var emptyPool = elementRegistry.get('EmptyPool_1');\n+      var expandedPool = elementRegistry.get('ExpandedPool_1');\n+\n+      var emptyPoolBounds = getBounds(emptyPool);\n+      var expandedPoolBounds = getBounds(expandedPool);\n+\n+      // when - use space tool below empty pool\n+      makeSpace({ x: 300, y: 280 }, { dy: 50 });\n+\n+      // then - empty pool should NOT be resized vertically\n+      expect(emptyPool).to.have.bounds({\n+        x: emptyPoolBounds.x,\n+        y: emptyPoolBounds.y,\n+        width: emptyPoolBounds.width,\n+        height: emptyPoolBounds.height // height should remain the same\n+      });\n+\n+      // and expanded pool should be resized normally\n+      expect(expandedPool).to.have.bounds({\n+        x: expandedPoolBounds.x,\n+        y: expandedPoolBounds.y,\n+        width: expandedPoolBounds.width,\n+        height: expandedPoolBounds.height + 50 // height should increase\n+      });\n+    }));\n+\n+    it('should allow empty pool to be resized horizontally', inject(function(elementRegistry) {\n+\n+      // given\n+      var emptyPool = elementRegistry.get('EmptyPool_1');\n+\n+      var emptyPoolBounds = getBounds(emptyPool);\n+\n+      // when - use space tool to the right of empty pool\n+      makeSpace({ x: 520, y: 175 }, { dx: 50 });\n+\n+      // then - empty pool should be resized horizontally\n+      expect(emptyPool).to.have.bounds({\n+        x: emptyPoolBounds.x,\n+        y: emptyPoolBounds.y,\n+        width: emptyPoolBounds.width + 50, // width should increase\n+        height: emptyPoolBounds.height // height should remain the same\n+      });\n+    }));\n+\n+    it('should allow expanded pool to be resized both horizontally and vertically', inject(function(elementRegistry) {\n+\n+      // given\n+      var expandedPool = elementRegistry.get('ExpandedPool_1');\n+\n+      var expandedPoolBounds = getBounds(expandedPool);\n+\n+      // when - use space tool above expanded pool\n+      makeSpace({ x: 300, y: 280 }, { dy: 50 });\n+\n+      // then - expanded pool should be resized vertically\n+      expect(expandedPool).to.have.bounds({\n+        x: expandedPoolBounds.x,\n+        y: expandedPoolBounds.y,\n+        width: expandedPoolBounds.width,\n+        height: expandedPoolBounds.height + 50 // height should increase\n+      });\n+    }));\n+\n+    it('should move empty pool when space tool is used before it', inject(function(elementRegistry) {\n+\n+      // given\n+      var emptyPool = elementRegistry.get('EmptyPool_1');\n+\n+      var emptyPoolBounds = getBounds(emptyPool);\n+\n+      // when - use space tool to the left of empty pool\n+      makeSpace({ x: 50, y: 175 }, { dx: 50 });\n+\n+      // then - empty pool should be moved\n+      expect(emptyPool).to.have.bounds({\n+        x: emptyPoolBounds.x + 50, // x should increase (moved)\n+        y: emptyPoolBounds.y,\n+        width: emptyPoolBounds.width,\n+        height: emptyPoolBounds.height\n+      });\n+    }));\n+\n+  });\n+\n+});\n+\n+// helpers //////////\n+\n+function makeSpace(start, delta, invert) {\n+  var modifier = invert ? invertModifier : {};\n+\n+  var end = {\n+    x: start.x + (delta.dx || 0),\n+    y: start.y + (delta.dy || 0)\n+  };\n+\n+  return getBpmnJS().invoke(function(spaceTool, dragging) {\n+    spaceTool.activateMakeSpace(canvasEvent(start));\n+\n+    dragging.move(canvasEvent(end, modifier));\n+\n+    dragging.end();\n+  });\n+}\n+\n+function getBounds(shape) {\n+  return pick(shape, [ 'x', 'y', 'width', 'height' ]);\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

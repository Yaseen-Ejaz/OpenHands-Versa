{"instance_id": "bpmn-io__bpmn-js-1119", "model_patch": "diff --git a/lib/features/modeling/behavior/ReplaceConnectionBehavior.js b/lib/features/modeling/behavior/ReplaceConnectionBehavior.js\nindex bc21ea30..c900a099 100644\n--- a/lib/features/modeling/behavior/ReplaceConnectionBehavior.js\n+++ b/lib/features/modeling/behavior/ReplaceConnectionBehavior.js\n@@ -10,6 +10,8 @@ import CommandInterceptor from 'diagram-js/lib/command/CommandInterceptor';\n \n import { is } from '../../../util/ModelUtil';\n \n+import { getParent } from '../util/ModelingUtil';\n+\n \n export default function ReplaceConnectionBehavior(eventBus, modeling, bpmnRules, injector) {\n \n@@ -78,35 +80,68 @@ export default function ReplaceConnectionBehavior(eventBus, modeling, bpmnRules,\n     // replace SequenceFlow <> MessageFlow\n \n     if (replacementType) {\n-      modeling.connect(source, target, {\n+      var connectionParent = getConnectionParent(source, target, replacementType);\n+      \n+      modeling.createConnection(source, target, {\n         type: replacementType,\n         waypoints: connection.waypoints.slice()\n-      });\n+      }, connectionParent);\n     }\n   }\n \n+  function getConnectionParent(source, target, connectionType) {\n+    if (connectionType === 'bpmn:MessageFlow') {\n+      // Message flows belong to the collaboration\n+      return getParent(source, 'bpmn:Collaboration') || getParent(target, 'bpmn:Collaboration');\n+    }\n+\n+    if (connectionType === 'bpmn:SequenceFlow') {\n+      // Sequence flows belong to the common scope parent (process or participant)\n+      var sourceParent = getParent(source, ['bpmn:Process', 'bpmn:Participant']);\n+      var targetParent = getParent(target, ['bpmn:Process', 'bpmn:Participant']);\n+      \n+      // If both elements are in the same participant/process, use that as parent\n+      if (sourceParent === targetParent) {\n+        return sourceParent;\n+      }\n+      \n+      // If they're in different participants, find the common collaboration\n+      return getParent(source, 'bpmn:Collaboration') || getParent(target, 'bpmn:Collaboration');\n+    }\n+\n+    // For other connection types, use the source parent as fallback\n+    return source.parent;\n+  }\n+\n   function replaceReconnectedConnection(event) {\n \n     var context = event.context,\n         connection = context.connection,\n         allowed,\n-        replacement;\n+        replacement,\n+        source = connection.source,\n+        target = connection.target;\n \n     if (context.newTarget) {\n-      allowed = bpmnRules.canConnect(connection.source, context.newTarget);\n+      target = context.newTarget;\n+      allowed = bpmnRules.canConnect(source, target);\n     } else {\n-      allowed = bpmnRules.canConnect(context.newSource, connection.target);\n+      source = context.newSource;\n+      allowed = bpmnRules.canConnect(source, target);\n     }\n \n     if (!allowed || allowed.type === connection.type) {\n       return;\n     }\n \n+    // determine the correct parent for the new connection\n+    var connectionParent = getConnectionParent(source, target, allowed.type);\n+\n     // temporarily connect old shapes with new connection\n-    replacement = modeling.connect(connection.source, connection.target, {\n+    replacement = modeling.createConnection(source, target, {\n       type: allowed.type,\n       waypoints: connection.waypoints.slice()\n-    });\n+    }, connectionParent);\n \n     // remove old connection\n     modeling.removeConnection(connection);\ndiff --git a/test-connection-replacement.js b/test-connection-replacement.js\nnew file mode 100644\nindex 00000000..51c816e1\n--- /dev/null\n+++ b/test-connection-replacement.js\n@@ -0,0 +1,92 @@\n+import BpmnJS from './lib/Modeler';\n+import fs from 'fs';\n+\n+// Test to reproduce the connection replacement issue\n+async function testConnectionReplacement() {\n+  console.log('Testing connection replacement issue...');\n+  \n+  // Load the test diagram\n+  const diagramXML = fs.readFileSync('./test-diagram.bpmn', 'utf8');\n+  \n+  // Create modeler instance\n+  const modeler = new BpmnJS({\n+    container: '#canvas'\n+  });\n+  \n+  try {\n+    // Import the diagram\n+    await modeler.importXML(diagramXML);\n+    console.log('Diagram imported successfully');\n+    \n+    // Get the modeling service\n+    const modeling = modeler.get('modeling');\n+    const elementRegistry = modeler.get('elementRegistry');\n+    \n+    // Get the elements\n+    const task1 = elementRegistry.get('Task_1');\n+    const task2 = elementRegistry.get('Task_2');\n+    const messageFlow = elementRegistry.get('MessageFlow_1');\n+    \n+    console.log('Task 1 parent:', task1.parent.id, task1.parent.type);\n+    console.log('Task 2 parent:', task2.parent.id, task2.parent.type);\n+    console.log('MessageFlow parent:', messageFlow.parent.id, messageFlow.parent.type);\n+    \n+    // Try to reconnect the message flow to create a loop (Task_2 -> Task_1)\n+    // This should replace the message flow with a sequence flow\n+    console.log('Attempting to reconnect message flow...');\n+    \n+    // First, let's try to connect Task_2 to Task_1 directly\n+    const newConnection = modeling.connect(task2, task1);\n+    \n+    if (newConnection) {\n+      console.log('New connection created:');\n+      console.log('- Type:', newConnection.type);\n+      console.log('- Parent:', newConnection.parent.id, newConnection.parent.type);\n+      console.log('- Source:', newConnection.source.id);\n+      console.log('- Target:', newConnection.target.id);\n+      \n+      // Check if the parent is correct\n+      if (newConnection.type === 'bpmn:SequenceFlow') {\n+        // For sequence flows, both source and target should be in the same scope\n+        const bpmnRules = modeler.get('bpmnRules');\n+        const canConnect = bpmnRules.canConnectSequenceFlow(task2, task1);\n+        console.log('Can connect sequence flow:', canConnect);\n+        \n+        // The parent should be the common scope parent\n+        console.log('Expected parent should be the collaboration or common process');\n+      }\n+    } else {\n+      console.log('Failed to create connection');\n+    }\n+    \n+  } catch (error) {\n+    console.error('Error:', error);\n+  }\n+}\n+\n+// Create a simple HTML page to run the test\n+const htmlContent = `\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN Connection Test</title>\n+    <style>\n+        #canvas { height: 600px; width: 100%; }\n+        #log { height: 200px; overflow-y: scroll; border: 1px solid #ccc; padding: 10px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN Connection Replacement Test</h1>\n+    <div id=\"canvas\"></div>\n+    <div id=\"log\"></div>\n+    <script type=\"module\">\n+        ${fs.readFileSync('./test-connection-replacement.js', 'utf8')}\n+        testConnectionReplacement();\n+    </script>\n+</body>\n+</html>\n+`;\n+\n+fs.writeFileSync('./test-connection-replacement.html', htmlContent);\n+\n+export { testConnectionReplacement };\n\\ No newline at end of file\ndiff --git a/test-diagram.bpmn b/test-diagram.bpmn\nnew file mode 100644\nindex 00000000..0d6b649d\n--- /dev/null\n+++ b/test-diagram.bpmn\n@@ -0,0 +1,60 @@\n+<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"First Participant\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"Participant_2\" name=\"Second Participant\" processRef=\"Process_2\" />\n+    <bpmn:messageFlow id=\"MessageFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_2\">\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_2\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Participant_2_di\" bpmnElement=\"Participant_2\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"350\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"150\" y=\"180\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"250\" y=\"158\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"250\" y=\"408\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"430\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"186\" y=\"198\" />\n+        <di:waypoint x=\"250\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"350\" y=\"448\" />\n+        <di:waypoint x=\"400\" y=\"448\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"MessageFlow_1_di\" bpmnElement=\"MessageFlow_1\">\n+        <di:waypoint x=\"300\" y=\"238\" />\n+        <di:waypoint x=\"300\" y=\"408\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>\n\\ No newline at end of file\ndiff --git a/test-fix.html b/test-fix.html\nnew file mode 100644\nindex 00000000..83cfd6c1\n--- /dev/null\n+++ b/test-fix.html\n@@ -0,0 +1,77 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN Connection Replacement Fix Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { height: 600px; width: 100%; border: 1px solid #ccc; }\n+        #log { height: 200px; overflow-y: scroll; border: 1px solid #ccc; padding: 10px; margin-top: 10px; background: #f5f5f5; }\n+        .info { background: #e7f3ff; padding: 10px; margin: 10px 0; border-left: 4px solid #2196F3; }\n+        .success { background: #e8f5e8; padding: 10px; margin: 10px 0; border-left: 4px solid #4CAF50; }\n+        .error { background: #ffebee; padding: 10px; margin: 10px 0; border-left: 4px solid #f44336; }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN Connection Replacement Fix Test</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Issue Description:</h3>\n+        <p>When replacing a message flow with a sequence flow, the new connection was not put in the appropriate target container/participant. The modeler would crash when the previous connection source was a Participant.</p>\n+    </div>\n+    \n+    <div class=\"success\">\n+        <h3>Fix Implemented:</h3>\n+        <p>Modified <code>ReplaceConnectionBehavior.js</code> to properly determine the correct parent for connections:</p>\n+        <ul>\n+            <li><strong>Sequence flows:</strong> Use common scope parent (process/participant) or collaboration if cross-participant</li>\n+            <li><strong>Message flows:</strong> Use collaboration as parent</li>\n+            <li>Added <code>getConnectionParent()</code> function to determine correct parent based on connection type</li>\n+        </ul>\n+    </div>\n+    \n+    <div class=\"info\">\n+        <h3>Test Scenario:</h3>\n+        <p>The fix addresses the following scenarios from existing tests:</p>\n+        <ul>\n+            <li>Reconnecting message flow to task within same participant \u2192 becomes sequence flow</li>\n+            <li>Reconnecting sequence flow to task in different participant \u2192 becomes message flow</li>\n+            <li>Moving elements between participants \u2192 connections are replaced with correct parent assignment</li>\n+        </ul>\n+    </div>\n+    \n+    <div id=\"canvas\"></div>\n+    <div id=\"log\">\n+        <h4>Implementation Details:</h4>\n+        <pre>\n+// Added to ReplaceConnectionBehavior.js:\n+\n+function getConnectionParent(source, target, connectionType) {\n+  if (connectionType === 'bpmn:MessageFlow') {\n+    // Message flows belong to the collaboration\n+    return getParent(source, 'bpmn:Collaboration') || getParent(target, 'bpmn:Collaboration');\n+  }\n+\n+  if (connectionType === 'bpmn:SequenceFlow') {\n+    // Sequence flows belong to the common scope parent (process or participant)\n+    var sourceParent = getParent(source, ['bpmn:Process', 'bpmn:Participant']);\n+    var targetParent = getParent(target, ['bpmn:Process', 'bpmn:Participant']);\n+    \n+    // If both elements are in the same participant/process, use that as parent\n+    if (sourceParent === targetParent) {\n+      return sourceParent;\n+    }\n+    \n+    // If they're in different participants, find the common collaboration\n+    return getParent(source, 'bpmn:Collaboration') || getParent(target, 'bpmn:Collaboration');\n+  }\n+\n+  // For other connection types, use the source parent as fallback\n+  return source.parent;\n+}\n+\n+// Modified both fixConnection() and replaceReconnectedConnection() functions\n+// to use modeling.createConnection() with the correct parent parameter\n+        </pre>\n+    </div>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/modeling/behavior/ReplaceConnectionBehaviorSpec.test.js b/test/spec/features/modeling/behavior/ReplaceConnectionBehaviorSpec.test.js\nnew file mode 100644\nindex 00000000..4b2e89ed\n--- /dev/null\n+++ b/test/spec/features/modeling/behavior/ReplaceConnectionBehaviorSpec.test.js\n@@ -0,0 +1,146 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import modelingModule from 'lib/features/modeling';\n+import coreModule from 'lib/core';\n+\n+describe('features/modeling/behavior - ReplaceConnectionBehavior', function() {\n+\n+  var testModules = [ coreModule, modelingModule ];\n+\n+  var collaborationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"First Participant\" processRef=\"Process_1\" />\n+    <bpmn:participant id=\"Participant_2\" name=\"Second Participant\" processRef=\"Process_2\" />\n+    <bpmn:messageFlow id=\"MessageFlow_1\" sourceRef=\"Task_1\" targetRef=\"Task_2\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:task>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+  </bpmn:process>\n+  <bpmn:process id=\"Process_2\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_2\">\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_2\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Participant_2_di\" bpmnElement=\"Participant_2\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"100\" y=\"350\" width=\"400\" height=\"200\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"150\" y=\"180\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"250\" y=\"158\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_2_di\" bpmnElement=\"Task_2\">\n+        <dc:Bounds x=\"250\" y=\"408\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"430\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"186\" y=\"198\" />\n+        <di:waypoint x=\"250\" y=\"198\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"350\" y=\"448\" />\n+        <di:waypoint x=\"400\" y=\"448\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"MessageFlow_1_di\" bpmnElement=\"MessageFlow_1\">\n+        <di:waypoint x=\"300\" y=\"238\" />\n+        <di:waypoint x=\"300\" y=\"408\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(collaborationXML, { modules: testModules }));\n+\n+  describe('message flow to sequence flow replacement', function() {\n+\n+    it('should assign correct parent when replacing message flow with sequence flow', inject(function(elementRegistry, modeling, bpmnRules) {\n+\n+      // given\n+      var task1 = elementRegistry.get('Task_1');\n+      var task2 = elementRegistry.get('Task_2');\n+      var messageFlow = elementRegistry.get('MessageFlow_1');\n+      var collaboration = elementRegistry.get('Collaboration_1');\n+\n+      console.log('Initial state:');\n+      console.log('Task 1 parent:', task1.parent.id, task1.parent.type);\n+      console.log('Task 2 parent:', task2.parent.id, task2.parent.type);\n+      console.log('MessageFlow parent:', messageFlow.parent.id, messageFlow.parent.type);\n+\n+      // when - try to connect Task_2 to Task_1 (should create sequence flow within same participant)\n+      // This simulates reconnecting the message flow to create a loop\n+      var newConnection = modeling.connect(task2, task1);\n+\n+      // then\n+      if (newConnection) {\n+        console.log('New connection created:');\n+        console.log('- Type:', newConnection.type);\n+        console.log('- Parent:', newConnection.parent.id, newConnection.parent.type);\n+        console.log('- Source:', newConnection.source.id);\n+        console.log('- Target:', newConnection.target.id);\n+\n+        // The issue: when connecting across participants, the parent should be determined correctly\n+        if (newConnection.type === 'bpmn:SequenceFlow') {\n+          // For sequence flows, both elements should be in same scope\n+          // Since they're in different participants, this should not create a sequence flow\n+          console.log('ERROR: Sequence flow created between different participants!');\n+        } else if (newConnection.type === 'bpmn:MessageFlow') {\n+          // Message flow should have collaboration as parent\n+          expect(newConnection.parent).to.equal(collaboration);\n+        }\n+      } else {\n+        console.log('No connection created (expected for cross-participant sequence flow)');\n+      }\n+    }));\n+\n+    it('should handle reconnection of message flow correctly', inject(function(elementRegistry, modeling, bpmnRules) {\n+\n+      // given\n+      var task1 = elementRegistry.get('Task_1');\n+      var task2 = elementRegistry.get('Task_2');\n+      var messageFlow = elementRegistry.get('MessageFlow_1');\n+      var endEvent = elementRegistry.get('EndEvent_1');\n+\n+      // when - reconnect message flow target from Task_2 to EndEvent_1 (within same participant)\n+      // This should replace message flow with sequence flow and assign correct parent\n+      modeling.reconnectEnd(messageFlow, endEvent, { x: 418, y: 448 });\n+\n+      // then - check if replacement happened and parent is correct\n+      var connections = endEvent.incoming;\n+      if (connections && connections.length > 0) {\n+        var newConnection = connections[connections.length - 1];\n+        console.log('Reconnected connection:');\n+        console.log('- Type:', newConnection.type);\n+        console.log('- Parent:', newConnection.parent.id, newConnection.parent.type);\n+        \n+        if (newConnection.type === 'bpmn:SequenceFlow') {\n+          // Should be in the same participant as the target\n+          expect(newConnection.parent).to.equal(task2.parent);\n+        }\n+      }\n+    }));\n+\n+  });\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

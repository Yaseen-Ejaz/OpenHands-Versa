{"instance_id": "openlayers__openlayers-9389", "model_patch": "diff --git a/rendering/cases/layer-tile-render-listener/main.js b/rendering/cases/layer-tile-render-listener/main.js\nnew file mode 100644\nindex 000000000..ef42d9d33\n--- /dev/null\n+++ b/rendering/cases/layer-tile-render-listener/main.js\n@@ -0,0 +1,59 @@\n+import Map from '../../../src/ol/Map.js';\n+import View from '../../../src/ol/View.js';\n+import Point from '../../../src/ol/geom/Point.js';\n+import TileLayer from '../../../src/ol/layer/Tile.js';\n+import {transform} from '../../../src/ol/proj.js';\n+import XYZ from '../../../src/ol/source/XYZ.js';\n+import CircleStyle from '../../../src/ol/style/Circle.js';\n+import Fill from '../../../src/ol/style/Fill.js';\n+import Stroke from '../../../src/ol/style/Stroke.js';\n+\n+const source = new XYZ({\n+  url: '/data/tiles/osm/{z}/{x}/{y}.png',\n+  transition: 0\n+});\n+\n+const map = new Map({\n+  pixelRatio: 1,\n+  target: 'map',\n+  view: new View({\n+    center: transform([-122.416667, 37.783333], 'EPSG:4326', 'EPSG:3857'),\n+    zoom: 5\n+  })\n+});\n+\n+const layer = new TileLayer({\n+  source: source\n+});\n+\n+layer.on('render', function(e) {\n+  e.vectorContext.setImageStyle(new CircleStyle({\n+    radius: 5,\n+    fill: new Fill({color: 'yellow'}),\n+    stroke: new Stroke({color: 'red', width: 1})\n+  }));\n+  e.vectorContext.drawPoint(new Point(\n+    transform([-123, 38], 'EPSG:4326', 'EPSG:3857')));\n+});\n+\n+map.addLayer(layer);\n+\n+let tilesLoading = 0;\n+let tileLoaded = 0;\n+\n+const update = function() {\n+  if (tilesLoading === tileLoaded) {\n+    render();\n+  }\n+};\n+\n+source.on('tileloadstart', function(event) {\n+  tilesLoading++;\n+});\n+source.on('tileloadend', function(event) {\n+  tileLoaded++;\n+  update();\n+});\n+source.on('tileloaderror', function(event) {\n+  console.error('Tile failed to load');\n+});\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-image-4326/main.js b/rendering/cases/reproj-image-4326/main.js\nnew file mode 100644\nindex 000000000..1c7442a03\n--- /dev/null\n+++ b/rendering/cases/reproj-image-4326/main.js\n@@ -0,0 +1,46 @@\n+import {listen} from '../../../src/ol/events.js';\n+import {get as getProjection} from '../../../src/ol/proj.js';\n+import ReprojImage from '../../../src/ol/reproj/Image.js';\n+import Static from '../../../src/ol/source/ImageStatic.js';\n+import {createXYZ, createForProjection} from '../../../src/ol/tilegrid.js';\n+\n+const source = new Static({\n+  url: '/data/tiles/osm/5/5/12.png',\n+  imageExtent: createXYZ().getTileCoordExtent([5, 5, -13]),\n+  projection: getProjection('EPSG:3857')\n+});\n+\n+const sourceProj = source.getProjection();\n+const targetProj = 'EPSG:4326';\n+const targetExtent = createForProjection('EPSG:4326').getTileCoordExtent([6, 10, -10]);\n+const targetResolution = 360 / (256 * (1 << 4));\n+const pixelRatio = 1;\n+\n+let imagesRequested = 0;\n+\n+const image = new ReprojImage(sourceProj, getProjection(targetProj),\n+  targetExtent, targetResolution, pixelRatio,\n+  function(extent, resolution, pixelRatio) {\n+    imagesRequested++;\n+    return source.getImage(extent, resolution, pixelRatio, sourceProj);\n+  });\n+\n+if (image.getState() == 0) { // IDLE\n+  listen(image, 'change', function(e) {\n+    if (image.getState() == 2) { // LOADED\n+      // Create a canvas to display the image\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 256;\n+      canvas.height = 256;\n+      const ctx = canvas.getContext('2d');\n+      ctx.drawImage(image.getImage(), 0, 0);\n+      \n+      // Add canvas to map div for rendering\n+      const mapDiv = document.getElementById('map');\n+      mapDiv.appendChild(canvas);\n+      \n+      render();\n+    }\n+  });\n+  image.load();\n+}\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-image-identity/main.js b/rendering/cases/reproj-image-identity/main.js\nnew file mode 100644\nindex 000000000..45d81b16a\n--- /dev/null\n+++ b/rendering/cases/reproj-image-identity/main.js\n@@ -0,0 +1,47 @@\n+import {listen} from '../../../src/ol/events.js';\n+import {get as getProjection} from '../../../src/ol/proj.js';\n+import {HALF_SIZE} from '../../../src/ol/proj/epsg3857.js';\n+import ReprojImage from '../../../src/ol/reproj/Image.js';\n+import Static from '../../../src/ol/source/ImageStatic.js';\n+import {createXYZ} from '../../../src/ol/tilegrid.js';\n+\n+const source = new Static({\n+  url: '/data/tiles/osm/5/5/12.png',\n+  imageExtent: createXYZ().getTileCoordExtent([5, 5, -13]),\n+  projection: getProjection('EPSG:3857')\n+});\n+\n+const sourceProj = source.getProjection();\n+const targetProj = 'EPSG:3857';\n+const targetExtent = createXYZ().getTileCoordExtent([5, 5, -13]);\n+const targetResolution = 2 * HALF_SIZE / (256 * (1 << 5));\n+const pixelRatio = 1;\n+\n+let imagesRequested = 0;\n+\n+const image = new ReprojImage(sourceProj, getProjection(targetProj),\n+  targetExtent, targetResolution, pixelRatio,\n+  function(extent, resolution, pixelRatio) {\n+    imagesRequested++;\n+    return source.getImage(extent, resolution, pixelRatio, sourceProj);\n+  });\n+\n+if (image.getState() == 0) { // IDLE\n+  listen(image, 'change', function(e) {\n+    if (image.getState() == 2) { // LOADED\n+      // Create a canvas to display the image\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 256;\n+      canvas.height = 256;\n+      const ctx = canvas.getContext('2d');\n+      ctx.drawImage(image.getImage(), 0, 0);\n+      \n+      // Add canvas to map div for rendering\n+      const mapDiv = document.getElementById('map');\n+      mapDiv.appendChild(canvas);\n+      \n+      render();\n+    }\n+  });\n+  image.load();\n+}\n\\ No newline at end of file\ndiff --git a/rendering/cases/reproj-tile-3857-identity/main.js b/rendering/cases/reproj-tile-3857-identity/main.js\nnew file mode 100644\nindex 000000000..13f3765a7\n--- /dev/null\n+++ b/rendering/cases/reproj-tile-3857-identity/main.js\n@@ -0,0 +1,47 @@\n+import TileState from '../../../src/ol/TileState.js';\n+import {listen} from '../../../src/ol/events.js';\n+import {get as getProjection} from '../../../src/ol/proj.js';\n+import ReprojTile from '../../../src/ol/reproj/Tile.js';\n+import XYZ from '../../../src/ol/source/XYZ.js';\n+\n+const source = new XYZ({\n+  projection: 'EPSG:3857',\n+  url: '/data/tiles/osm/{z}/{x}/{y}.png'\n+});\n+\n+const sourceProjection = source.getProjection();\n+const sourceGutter = source.getGutterForProjection(sourceProjection);\n+const targetProjection = 'EPSG:3857';\n+const targetTileGrid = source.getTileGrid();\n+const z = 5, x = 5, y = -13;\n+const pixelRatio = 1;\n+\n+let tilesRequested = 0;\n+\n+const tile = new ReprojTile(sourceProjection, source.getTileGrid(),\n+  getProjection(targetProjection), targetTileGrid,\n+  [z, x, y], null, pixelRatio, sourceGutter,\n+  function(z, x, y, pixelRatio) {\n+    tilesRequested++;\n+    return source.getTile(z, x, y, pixelRatio, sourceProjection);\n+  });\n+\n+if (tile.getState() == TileState.IDLE) {\n+  listen(tile, 'change', function(e) {\n+    if (tile.getState() == TileState.LOADED) {\n+      // Create a canvas to display the tile\n+      const canvas = document.createElement('canvas');\n+      canvas.width = 256;\n+      canvas.height = 256;\n+      const ctx = canvas.getContext('2d');\n+      ctx.drawImage(tile.getImage(), 0, 0);\n+      \n+      // Add canvas to map div for rendering\n+      const mapDiv = document.getElementById('map');\n+      mapDiv.appendChild(canvas);\n+      \n+      render();\n+    }\n+  });\n+  tile.load();\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

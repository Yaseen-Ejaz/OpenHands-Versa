{"instance_id": "bpmn-io__bpmn-js-1720", "model_patch": "diff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js\nindex 6ba9a859..d3b8605a 100644\n--- a/lib/features/popup-menu/ReplaceMenuProvider.js\n+++ b/lib/features/popup-menu/ReplaceMenuProvider.js\n@@ -233,6 +233,13 @@ ReplaceMenuProvider.prototype.getEntries = function(element) {\n     return this._createSequenceFlowEntries(element, replaceOptions.SEQUENCE_FLOW);\n   }\n \n+  // call activities\n+  if (is(businessObject, 'bpmn:CallActivity')) {\n+    entries = filter(replaceOptions.CALL_ACTIVITY, differentType);\n+\n+    return this._createEntries(element, entries);\n+  }\n+\n   // flow nodes\n   if (is(businessObject, 'bpmn:FlowNode')) {\n     entries = filter(replaceOptions.TASK, differentType);\ndiff --git a/lib/features/replace/ReplaceOptions.js b/lib/features/replace/ReplaceOptions.js\nindex bb9d8d1c..cdba939c 100644\n--- a/lib/features/replace/ReplaceOptions.js\n+++ b/lib/features/replace/ReplaceOptions.js\n@@ -398,6 +398,14 @@ export var SUBPROCESS_EXPANDED = [\n       type: 'bpmn:SubProcess',\n       isExpanded: false\n     }\n+  },\n+  {\n+    label: 'Call Activity',\n+    actionName: 'replace-with-call-activity',\n+    className: 'bpmn-icon-call-activity',\n+    target: {\n+      type: 'bpmn:CallActivity'\n+    }\n   }\n ];\n \n@@ -537,6 +545,73 @@ export var TASK = [\n   }\n ];\n \n+export var CALL_ACTIVITY = [\n+  {\n+    label: 'Task',\n+    actionName: 'replace-with-task',\n+    className: 'bpmn-icon-task',\n+    target: {\n+      type: 'bpmn:Task'\n+    }\n+  },\n+  {\n+    label: 'Send Task',\n+    actionName: 'replace-with-send-task',\n+    className: 'bpmn-icon-send',\n+    target: {\n+      type: 'bpmn:SendTask'\n+    }\n+  },\n+  {\n+    label: 'Receive Task',\n+    actionName: 'replace-with-receive-task',\n+    className: 'bpmn-icon-receive',\n+    target: {\n+      type: 'bpmn:ReceiveTask'\n+    }\n+  },\n+  {\n+    label: 'User Task',\n+    actionName: 'replace-with-user-task',\n+    className: 'bpmn-icon-user',\n+    target: {\n+      type: 'bpmn:UserTask'\n+    }\n+  },\n+  {\n+    label: 'Manual Task',\n+    actionName: 'replace-with-manual-task',\n+    className: 'bpmn-icon-manual',\n+    target: {\n+      type: 'bpmn:ManualTask'\n+    }\n+  },\n+  {\n+    label: 'Business Rule Task',\n+    actionName: 'replace-with-rule-task',\n+    className: 'bpmn-icon-business-rule',\n+    target: {\n+      type: 'bpmn:BusinessRuleTask'\n+    }\n+  },\n+  {\n+    label: 'Service Task',\n+    actionName: 'replace-with-service-task',\n+    className: 'bpmn-icon-service',\n+    target: {\n+      type: 'bpmn:ServiceTask'\n+    }\n+  },\n+  {\n+    label: 'Script Task',\n+    actionName: 'replace-with-script-task',\n+    className: 'bpmn-icon-script',\n+    target: {\n+      type: 'bpmn:ScriptTask'\n+    }\n+  }\n+];\n+\n export var DATA_OBJECT_REFERENCE = [\n   {\n     label: 'Data Store Reference',\ndiff --git a/test_call_activity.html b/test_call_activity.html\nnew file mode 100644\nindex 00000000..457ee78a\n--- /dev/null\n+++ b/test_call_activity.html\n@@ -0,0 +1,201 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Call Activity Issue Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #container {\n+            width: 100%;\n+            height: 500px;\n+            border: 1px solid #ccc;\n+            margin: 20px 0;\n+        }\n+        .log {\n+            background: #f5f5f5;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+        }\n+        button {\n+            padding: 10px 20px;\n+            margin: 5px;\n+            background: #007acc;\n+            color: white;\n+            border: none;\n+            border-radius: 4px;\n+            cursor: pointer;\n+        }\n+        button:hover {\n+            background: #005a9e;\n+        }\n+    </style>\n+    <link rel=\"stylesheet\" href=\"./dist/assets/bpmn-js.css\">\n+</head>\n+<body>\n+    <h1>Call Activity to SubProcess Transformation Issue Test</h1>\n+    \n+    <button onclick=\"runTest()\">Run Test</button>\n+    <button onclick=\"clearLog()\">Clear Log</button>\n+    \n+    <div id=\"container\"></div>\n+    \n+    <div class=\"log\" id=\"log\"></div>\n+\n+    <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        let logElement = document.getElementById('log');\n+        let modeler;\n+        \n+        function log(message) {\n+            console.log(message);\n+            logElement.textContent += message + '\\n';\n+        }\n+        \n+        function clearLog() {\n+            logElement.textContent = '';\n+        }\n+        \n+        // BPMN XML for testing\n+        const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"5.0.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>Flow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\">\n+      <bpmn:incoming>Flow_1</bpmn:incoming>\n+      <bpmn:outgoing>Flow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>Flow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"Flow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"Flow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Activity_1\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"270\" y=\"77\" width=\"100\" height=\"80\" />\n+        <bpmndi:BPMNLabel />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"_BPMNShape_EndEvent_2\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"432\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Flow_1_di\" bpmnElement=\"Flow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"270\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"Flow_2_di\" bpmnElement=\"Flow_2\">\n+        <di:waypoint x=\"370\" y=\"117\" />\n+        <di:waypoint x=\"432\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        async function runTest() {\n+            clearLog();\n+            log('Testing Call Activity transformation issue...');\n+            \n+            // Create modeler instance\n+            modeler = new BpmnJS({\n+                container: '#container'\n+            });\n+\n+            try {\n+                // Import the diagram\n+                await modeler.importXML(xml);\n+                \n+                const elementRegistry = modeler.get('elementRegistry');\n+                const bpmnReplace = modeler.get('bpmnReplace');\n+                \n+                // Get the task element\n+                const task = elementRegistry.get('Task_1');\n+                log('Original task: ' + task.id);\n+                log('Task dimensions: ' + task.width + ' x ' + task.height);\n+                \n+                // Step 1: Transform task to call activity\n+                log('\\n--- Step 1: Transform task to call activity ---');\n+                const callActivity = bpmnReplace.replaceElement(task, {\n+                    type: 'bpmn:CallActivity'\n+                });\n+                log('Call activity created: ' + callActivity.id);\n+                log('Call activity dimensions: ' + callActivity.width + ' x ' + callActivity.height);\n+                \n+                // Step 2: Check what menu options are available for call activity\n+                log('\\n--- Step 2: Check menu options for call activity ---');\n+                const replaceMenuProvider = modeler.get('replaceMenuProvider');\n+                const menuEntries = replaceMenuProvider.getEntries(callActivity);\n+                log('Available menu entries for call activity:');\n+                menuEntries.forEach(entry => {\n+                    log('  - ' + entry.label + ' (' + entry.id + ')');\n+                });\n+                \n+                // Check if subprocess options are present (this is the first part of the bug)\n+                const hasSubProcessOptions = menuEntries.some(entry => \n+                    entry.id.includes('subprocess')\n+                );\n+                if (hasSubProcessOptions) {\n+                    log('\u274c ISSUE CONFIRMED: Call activity shows subprocess options in menu!');\n+                } else {\n+                    log('\u2705 Call activity menu looks correct');\n+                }\n+                \n+                // Step 3: Transform call activity to expanded subprocess\n+                log('\\n--- Step 3: Transform call activity to expanded subprocess ---');\n+                const expandedSubProcess = bpmnReplace.replaceElement(callActivity, {\n+                    type: 'bpmn:SubProcess',\n+                    isExpanded: true\n+                });\n+                log('Expanded subprocess created: ' + expandedSubProcess.id);\n+                log('Expanded subprocess dimensions: ' + expandedSubProcess.width + ' x ' + expandedSubProcess.height);\n+                \n+                // Step 4: Check what menu options are available for the expanded subprocess\n+                log('\\n--- Step 4: Check menu options for expanded subprocess ---');\n+                const subProcessMenuEntries = replaceMenuProvider.getEntries(expandedSubProcess);\n+                log('Available menu entries for expanded subprocess:');\n+                subProcessMenuEntries.forEach(entry => {\n+                    log('  - ' + entry.label + ' (' + entry.id + ')');\n+                });\n+                \n+                // Step 5: Check if we can transform back to call activity\n+                log('\\n--- Step 5: Check if call activity option is available ---');\n+                const hasCallActivityOption = subProcessMenuEntries.some(entry => \n+                    entry.id === 'replace-with-call-activity'\n+                );\n+                log('Can transform back to call activity: ' + hasCallActivityOption);\n+                \n+                // Visual verification\n+                log('\\n--- Visual Analysis ---');\n+                log('Expected: Expanded subprocess should be larger than task/call activity');\n+                log('Actual subprocess size: ' + expandedSubProcess.width + ' x ' + expandedSubProcess.height);\n+                log('Original task size: 100 x 80');\n+                \n+                if (expandedSubProcess.width === 100 && expandedSubProcess.height === 80) {\n+                    log('\u274c ISSUE CONFIRMED: Subprocess has same size as task - not resized properly!');\n+                } else {\n+                    log('\u2705 Size looks correct');\n+                }\n+                \n+                if (!hasCallActivityOption) {\n+                    log('\u274c ISSUE CONFIRMED: Cannot transform back to call activity - dead end!');\n+                } else {\n+                    log('\u2705 Can transform back to call activity');\n+                }\n+                \n+            } catch (error) {\n+                log('Error during test: ' + error.message);\n+                console.error('Error during test:', error);\n+            }\n+        }\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

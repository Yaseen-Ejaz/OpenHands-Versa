{"instance_id": "openlayers__openlayers-15685", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..9e2b0494d\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,3 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Mar/2026 13:49:23] \"GET /test_vectortile_fill_issue.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 13:50:03] \"GET /test_simple_vectortile_fill.html HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/canvas/VectorTileLayer.js b/src/ol/renderer/canvas/VectorTileLayer.js\nindex 68be9e186..bc96b7db2 100644\n--- a/src/ol/renderer/canvas/VectorTileLayer.js\n+++ b/src/ol/renderer/canvas/VectorTileLayer.js\n@@ -182,6 +182,83 @@ class CanvasVectorTileLayerRenderer extends CanvasTileLayerRenderer {\n     return tile.getImage(this.getLayer());\n   }\n \n+  /**\n+   * @inheritDoc\n+   */\n+  drawTileImage(tile, frameState, x, y, w, h, gutter, transition) {\n+    const layer = this.getLayer();\n+    const image = this.getTileImage(tile);\n+    \n+    // For vector mode, render directly instead of using pre-rendered image\n+    if (!image && layer.getRenderMode() === 'vector') {\n+      this.drawVectorTile_(tile, frameState, x, y, w, h);\n+      return;\n+    }\n+    \n+    // Use parent implementation for hybrid mode or when image exists\n+    super.drawTileImage(tile, frameState, x, y, w, h, gutter, transition);\n+  }\n+\n+  /**\n+   * Draw a vector tile directly to the canvas.\n+   * @param {import(\"../../VectorRenderTile.js\").default} tile Tile.\n+   * @param {import(\"../../Map.js\").FrameState} frameState Frame state.\n+   * @param {number} x Left of the tile.\n+   * @param {number} y Top of the tile.\n+   * @param {number} w Width of the tile.\n+   * @param {number} h Height of the tile.\n+   * @private\n+   */\n+  drawVectorTile_(tile, frameState, x, y, w, h) {\n+    const layer = this.getLayer();\n+    const layerUid = getUid(layer);\n+    const executorGroups = tile.executorGroups[layerUid];\n+    \n+    if (!executorGroups || executorGroups.length === 0) {\n+      return;\n+    }\n+\n+    const context = this.getRenderContext(frameState);\n+    const viewState = frameState.viewState;\n+    const rotation = viewState.rotation;\n+    const viewHints = frameState.viewHints;\n+    const hifi = !(\n+      viewHints[ViewHint.ANIMATING] || viewHints[ViewHint.INTERACTING]\n+    );\n+    \n+    const renderMode = layer.getRenderMode();\n+    const declutter = layer.getDeclutter();\n+    const replayTypes = declutter\n+      ? VECTOR_REPLAYS[renderMode].filter((type) => !DECLUTTER.includes(type))\n+      : VECTOR_REPLAYS[renderMode];\n+\n+    const transform = this.getTileRenderTransform(tile, frameState);\n+    \n+    // Save context state\n+    context.save();\n+    \n+    // Set clipping to tile bounds\n+    context.beginPath();\n+    context.rect(x, y, w, h);\n+    context.clip();\n+    \n+    // Render each executor group\n+    for (let t = 0, tt = executorGroups.length; t < tt; ++t) {\n+      const executorGroup = executorGroups[t];\n+      executorGroup.execute(\n+        context,\n+        [w, h],\n+        transform,\n+        rotation,\n+        hifi,\n+        replayTypes,\n+      );\n+    }\n+    \n+    // Restore context state\n+    context.restore();\n+  }\n+\n   /**\n    * Determine whether render should be called.\n    * @param {import(\"../../Map.js\").FrameState} frameState Frame state.\ndiff --git a/test_simple_vectortile_fill.html b/test_simple_vectortile_fill.html\nnew file mode 100644\nindex 000000000..57cb32ae1\n--- /dev/null\n+++ b/test_simple_vectortile_fill.html\n@@ -0,0 +1,190 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple VectorTile Fill Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@9.1.0/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@9.1.0/ol.css\">\n+</head>\n+<body>\n+    <h1>Simple VectorTile Fill Issue Test</h1>\n+    <div class=\"info\">\n+        <p><strong>Issue:</strong> setFill() creates unwanted semitransparent overlay layer in vector mode</p>\n+        <p><strong>Test:</strong> Using simple polygon features to reproduce the issue</p>\n+    </div>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"toggleFill()\">Toggle Fill</button>\n+        <button onclick=\"setFillDynamic()\">Set Fill Dynamically (Issue)</button>\n+        <button onclick=\"toggleRenderMode()\">Toggle Render Mode</button>\n+        <span id=\"status\">Render Mode: vector, Fill: enabled</span>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+\n+    <script>\n+        let map, vectorLayer, currentStyle, hasFill = true, renderMode = 'vector';\n+\n+        // Create a simple style with fill\n+        function createStyle(withFill = true) {\n+            return new ol.style.Style({\n+                stroke: new ol.style.Stroke({\n+                    color: '#000',\n+                    width: 2,\n+                }),\n+                fill: withFill ? new ol.style.Fill({ color: 'rgba(255, 0, 0, 0.5)' }) : null,\n+            });\n+        }\n+\n+        // Create simple polygon features\n+        function createFeatures() {\n+            const features = [];\n+            \n+            // Create a few polygon features\n+            for (let i = 0; i < 3; i++) {\n+                const coords = [\n+                    [\n+                        [-1000000 + i * 2000000, -1000000 + i * 1000000],\n+                        [1000000 + i * 2000000, -1000000 + i * 1000000],\n+                        [1000000 + i * 2000000, 1000000 + i * 1000000],\n+                        [-1000000 + i * 2000000, 1000000 + i * 1000000],\n+                        [-1000000 + i * 2000000, -1000000 + i * 1000000]\n+                    ]\n+                ];\n+                \n+                const feature = new ol.Feature({\n+                    geometry: new ol.geom.Polygon(coords),\n+                    id: i\n+                });\n+                features.push(feature);\n+            }\n+            \n+            return features;\n+        }\n+\n+        function initMap() {\n+            currentStyle = createStyle(true);\n+            \n+            // Use regular Vector layer first to establish baseline\n+            vectorLayer = new ol.layer.Vector({\n+                source: new ol.source.Vector({\n+                    features: createFeatures()\n+                }),\n+                style: currentStyle,\n+            });\n+\n+            map = new ol.Map({\n+                target: 'map',\n+                layers: [\n+                    new ol.layer.Tile({\n+                        source: new ol.source.OSM()\n+                    }),\n+                    vectorLayer\n+                ],\n+                view: new ol.View({\n+                    center: [0, 0],\n+                    zoom: 2\n+                })\n+            });\n+\n+            updateStatus();\n+        }\n+\n+        function toggleFill() {\n+            hasFill = !hasFill;\n+            currentStyle = createStyle(hasFill);\n+            vectorLayer.setStyle(currentStyle);\n+            updateStatus();\n+        }\n+\n+        function setFillDynamic() {\n+            // This is the problematic method mentioned in the issue\n+            console.log('Setting fill dynamically...');\n+            currentStyle.setFill(\n+                new ol.style.Fill({\n+                    color: 'rgba(0, 255, 0, 0.7)'\n+                })\n+            );\n+            hasFill = true;\n+            vectorLayer.changed(); // Force re-render\n+            updateStatus();\n+            console.log('Fill set to green with 0.7 opacity');\n+        }\n+\n+        function toggleRenderMode() {\n+            // For this test, we'll switch between Vector and VectorTile layers\n+            map.removeLayer(vectorLayer);\n+            \n+            if (renderMode === 'vector') {\n+                renderMode = 'vectortile-hybrid';\n+                // Create a VectorTile layer in hybrid mode\n+                vectorLayer = new ol.layer.VectorTile({\n+                    renderMode: 'hybrid',\n+                    source: new ol.source.VectorTile({\n+                        format: new ol.format.GeoJSON(),\n+                        url: 'data:application/json,' + encodeURIComponent(JSON.stringify({\n+                            type: 'FeatureCollection',\n+                            features: createFeatures().map(f => ({\n+                                type: 'Feature',\n+                                geometry: f.getGeometry().getCoordinates ? {\n+                                    type: 'Polygon',\n+                                    coordinates: f.getGeometry().getCoordinates()\n+                                } : null,\n+                                properties: { id: f.get('id') }\n+                            }))\n+                        }))\n+                    }),\n+                    style: currentStyle,\n+                });\n+            } else if (renderMode === 'vectortile-hybrid') {\n+                renderMode = 'vectortile-vector';\n+                // Create a VectorTile layer in vector mode (this should show the issue)\n+                vectorLayer = new ol.layer.VectorTile({\n+                    renderMode: 'vector',\n+                    source: new ol.source.VectorTile({\n+                        format: new ol.format.GeoJSON(),\n+                        url: 'data:application/json,' + encodeURIComponent(JSON.stringify({\n+                            type: 'FeatureCollection',\n+                            features: createFeatures().map(f => ({\n+                                type: 'Feature',\n+                                geometry: f.getGeometry().getCoordinates ? {\n+                                    type: 'Polygon',\n+                                    coordinates: f.getGeometry().getCoordinates()\n+                                } : null,\n+                                properties: { id: f.get('id') }\n+                            }))\n+                        }))\n+                    }),\n+                    style: currentStyle,\n+                });\n+            } else {\n+                renderMode = 'vector';\n+                // Back to regular Vector layer\n+                vectorLayer = new ol.layer.Vector({\n+                    source: new ol.source.Vector({\n+                        features: createFeatures()\n+                    }),\n+                    style: currentStyle,\n+                });\n+            }\n+            \n+            map.addLayer(vectorLayer);\n+            updateStatus();\n+        }\n+\n+        function updateStatus() {\n+            document.getElementById('status').textContent = \n+                `Render Mode: ${renderMode}, Fill: ${hasFill ? 'enabled' : 'disabled'}`;\n+        }\n+\n+        // Initialize the map when page loads\n+        window.onload = initMap;\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_vectortile_fill_issue.html b/test_vectortile_fill_issue.html\nnew file mode 100644\nindex 000000000..6830b099e\n--- /dev/null\n+++ b/test_vectortile_fill_issue.html\n@@ -0,0 +1,145 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>VectorTile Fill Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        #map { width: 800px; height: 600px; border: 1px solid #ccc; }\n+        .controls { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .info { margin: 10px 0; padding: 10px; background: #f0f0f0; }\n+    </style>\n+    <script src=\"https://cdn.jsdelivr.net/npm/ol@9.1.0/dist/ol.js\"></script>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@9.1.0/ol.css\">\n+</head>\n+<body>\n+    <h1>VectorTile Fill Issue Reproduction</h1>\n+    <div class=\"info\">\n+        <p><strong>Issue:</strong> setFill() creates unwanted semitransparent overlay layer in vector mode</p>\n+        <p><strong>Expected:</strong> Fill should style the VectorTile without creating additional layers</p>\n+    </div>\n+    \n+    <div class=\"controls\">\n+        <button onclick=\"toggleFill()\">Toggle Fill</button>\n+        <button onclick=\"setFillDynamic()\">Set Fill Dynamically</button>\n+        <button onclick=\"toggleRenderMode()\">Toggle Render Mode</button>\n+        <span id=\"status\">Render Mode: vector, Fill: enabled</span>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+\n+    <script>\n+        let map, vectorTileLayer, currentStyle, hasFill = true, renderMode = 'vector';\n+\n+        // Create a simple style with fill\n+        function createStyle(withFill = true) {\n+            return new ol.style.Style({\n+                text: new ol.style.Text({\n+                    text: 'Test',\n+                    overflow: true,\n+                    font: '12px sans-serif',\n+                    padding: [5, 10, 5, 10],\n+                    textAlign: 'center',\n+                    justify: 'center',\n+                    textBaseline: 'middle',\n+                    fill: new ol.style.Fill({\n+                        color: '#fff',\n+                    }),\n+                    backgroundFill: new ol.style.Fill({\n+                        color: '#454545',\n+                    }),\n+                    backgroundStroke: new ol.style.Stroke({\n+                        color: '#fff',\n+                        width: 1,\n+                    }),\n+                }),\n+                stroke: new ol.style.Stroke({\n+                    color: '#000',\n+                    width: 2,\n+                }),\n+                fill: withFill ? new ol.style.Fill({ color: 'rgba(255, 255, 255, 0.5)' }) : null,\n+            });\n+        }\n+\n+        // Create a mock VectorTile source for testing\n+        function createMockVectorTileSource() {\n+            return new ol.source.VectorTile({\n+                format: new ol.format.MVT({\n+                    idProperty: 'id',\n+                }),\n+                // Use OpenStreetMap vector tiles for testing\n+                url: 'https://basemaps.arcgis.com/arcgis/rest/services/OpenStreetMap_v2/VectorTileServer/tile/{z}/{y}/{x}.pbf',\n+                maxZoom: 14\n+            });\n+        }\n+\n+        function initMap() {\n+            currentStyle = createStyle(true);\n+            \n+            vectorTileLayer = new ol.layer.VectorTile({\n+                properties: { name: 'Test' },\n+                visible: true,\n+                renderMode: renderMode,\n+                source: createMockVectorTileSource(),\n+                style: currentStyle,\n+            });\n+\n+            map = new ol.Map({\n+                target: 'map',\n+                layers: [\n+                    vectorTileLayer\n+                ],\n+                view: new ol.View({\n+                    center: ol.proj.fromLonLat([0, 0]),\n+                    zoom: 2\n+                })\n+            });\n+\n+            updateStatus();\n+        }\n+\n+        function toggleFill() {\n+            hasFill = !hasFill;\n+            currentStyle = createStyle(hasFill);\n+            vectorTileLayer.setStyle(currentStyle);\n+            updateStatus();\n+        }\n+\n+        function setFillDynamic() {\n+            // This is the problematic method mentioned in the issue\n+            currentStyle.setFill(\n+                new ol.style.Fill({\n+                    color: 'rgba(252, 220, 215, 0.5)'\n+                })\n+            );\n+            hasFill = true;\n+            vectorTileLayer.changed(); // Force re-render\n+            updateStatus();\n+        }\n+\n+        function toggleRenderMode() {\n+            renderMode = renderMode === 'vector' ? 'hybrid' : 'vector';\n+            \n+            // Recreate layer with new render mode\n+            map.removeLayer(vectorTileLayer);\n+            vectorTileLayer = new ol.layer.VectorTile({\n+                properties: { name: 'Test' },\n+                visible: true,\n+                renderMode: renderMode,\n+                source: createMockVectorTileSource(),\n+                style: currentStyle,\n+            });\n+            map.addLayer(vectorTileLayer);\n+            updateStatus();\n+        }\n+\n+        function updateStatus() {\n+            document.getElementById('status').textContent = \n+                `Render Mode: ${renderMode}, Fill: ${hasFill ? 'enabled' : 'disabled'}`;\n+        }\n+\n+        // Initialize the map when page loads\n+        window.onload = initMap;\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

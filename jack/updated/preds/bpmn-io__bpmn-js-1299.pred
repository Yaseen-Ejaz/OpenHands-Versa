{"instance_id": "bpmn-io__bpmn-js-1299", "model_patch": "diff --git a/lib/features/label-editing/cmd/UpdateLabelHandler.js b/lib/features/label-editing/cmd/UpdateLabelHandler.js\nindex 6d12a2e9..3a12e04d 100644\n--- a/lib/features/label-editing/cmd/UpdateLabelHandler.js\n+++ b/lib/features/label-editing/cmd/UpdateLabelHandler.js\n@@ -104,6 +104,11 @@ export default function UpdateLabelHandler(modeling, textRenderer) {\n \n     var text = getLabel(label);\n \n+    // don't resize without text, except for text annotations\n+    if (!text && !is(element, 'bpmn:TextAnnotation')) {\n+      return;\n+    }\n+\n     // resize element based on label _or_ pre-defined bounds\n     if (typeof newBounds === 'undefined') {\n       newBounds = textRenderer.getExternalLabelBounds(label, text);\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..918ae4b7\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,5 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [04/Mar/2026 05:47:28] \"GET /test_visual.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 05:47:28] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 05:48:29] \"GET /test_visual.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 05:48:29] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\ndiff --git a/simple_test_verification.js b/simple_test_verification.js\nnew file mode 100644\nindex 00000000..3e57fd1c\n--- /dev/null\n+++ b/simple_test_verification.js\n@@ -0,0 +1,58 @@\n+/**\n+ * Simple verification that the fix logic is correct\n+ */\n+\n+// Mock the 'is' function to simulate BPMN element type checking\n+function is(element, type) {\n+  if (!element || !element.businessObject) return false;\n+  return element.businessObject.$type === type;\n+}\n+\n+// Mock getLabel function\n+function getLabel(element) {\n+  if (!element || !element.businessObject) return '';\n+  return element.businessObject.name || element.businessObject.text || '';\n+}\n+\n+// Simulate the fixed logic from UpdateLabelHandler\n+function shouldSkipResize(element, text) {\n+  // don't resize without text, except for text annotations\n+  if (!text && !is(element, 'bpmn:TextAnnotation')) {\n+    return true;\n+  }\n+  return false;\n+}\n+\n+// Test cases\n+console.log('=== Testing Fix Logic ===');\n+\n+// Test 1: StartEvent with empty text should skip resize\n+const startEvent = {\n+  businessObject: { $type: 'bpmn:StartEvent', name: '' }\n+};\n+const emptyText = '';\n+console.log('StartEvent with empty text should skip resize:', shouldSkipResize(startEvent, emptyText)); // Should be true\n+\n+// Test 2: Gateway with empty text should skip resize  \n+const gateway = {\n+  businessObject: { $type: 'bpmn:ExclusiveGateway', name: '' }\n+};\n+console.log('Gateway with empty text should skip resize:', shouldSkipResize(gateway, emptyText)); // Should be true\n+\n+// Test 3: TextAnnotation with empty text should NOT skip resize\n+const textAnnotation = {\n+  businessObject: { $type: 'bpmn:TextAnnotation', text: '' }\n+};\n+console.log('TextAnnotation with empty text should NOT skip resize:', shouldSkipResize(textAnnotation, emptyText)); // Should be false\n+\n+// Test 4: StartEvent with text should NOT skip resize\n+const textValue = 'Some text';\n+console.log('StartEvent with text should NOT skip resize:', shouldSkipResize(startEvent, textValue)); // Should be false\n+\n+// Test 5: TextAnnotation with text should NOT skip resize\n+console.log('TextAnnotation with text should NOT skip resize:', shouldSkipResize(textAnnotation, textValue)); // Should be false\n+\n+console.log('\\n=== Fix Logic Verification Complete ===');\n+console.log('\u2713 Events and Gateways with empty text will skip resize (fix applied)');\n+console.log('\u2713 TextAnnotations with empty text will NOT skip resize (original behavior preserved)');\n+console.log('\u2713 All elements with non-empty text will NOT skip resize (normal behavior)');\n\\ No newline at end of file\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 00000000..448924eb\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,138 @@\n+/**\n+ * Test to verify the fix for the issue where events and gateways \n+ * become smaller when their labels are updated with empty text.\n+ */\n+\n+const { expect } = require('chai');\n+\n+// Import required modules\n+const {\n+  bootstrapModeler,\n+  inject\n+} = require('./test/TestHelper');\n+\n+const modelingModule = require('./lib/features/modeling');\n+const coreModule = require('./lib/core');\n+\n+describe('Fix Verification - UpdateLabel with empty text', function() {\n+\n+  const diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Event\" />\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Event\" />\n+    <bpmn:exclusiveGateway id=\"Gateway_1\" name=\"Gateway\" />\n+    <bpmn:textAnnotation id=\"TextAnnotation_1\">\n+      <bpmn:text>Test Annotation</bpmn:text>\n+    </bpmn:textAnnotation>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"85\" y=\"143\" width=\"66\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"188\" y=\"143\" width=\"60\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Gateway_1_di\" bpmnElement=\"Gateway_1\">\n+        <dc:Bounds x=\"300\" y=\"95\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"305\" y=\"152\" width=\"40\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      coreModule,\n+      modelingModule\n+    ]\n+  }));\n+\n+  it('should NOT resize StartEvent label when updated with empty text', inject(\n+    function(modeling, elementRegistry) {\n+\n+      // given\n+      const startEvent = elementRegistry.get('StartEvent_1');\n+      const originalLabelBounds = startEvent.label ? { ...startEvent.label } : null;\n+\n+      // when\n+      modeling.updateLabel(startEvent, '');\n+\n+      // then\n+      // The label should be removed, not resized to element bounds\n+      expect(startEvent.label).not.to.exist;\n+      expect(startEvent.businessObject.name).to.equal('');\n+    }\n+  ));\n+\n+  it('should NOT resize Gateway label when updated with empty text', inject(\n+    function(modeling, elementRegistry) {\n+\n+      // given\n+      const gateway = elementRegistry.get('Gateway_1');\n+      const originalLabelBounds = gateway.label ? { ...gateway.label } : null;\n+\n+      // when\n+      modeling.updateLabel(gateway, '');\n+\n+      // then\n+      // The label should be removed, not resized to element bounds\n+      expect(gateway.label).not.to.exist;\n+      expect(gateway.businessObject.name).to.equal('');\n+    }\n+  ));\n+\n+  it('should ALLOW TextAnnotation to be resized with empty text', inject(\n+    function(modeling, elementRegistry) {\n+\n+      // given\n+      const textAnnotation = elementRegistry.get('TextAnnotation_1');\n+      const newBounds = { x: 400, y: 100, width: 150, height: 50 };\n+\n+      // when\n+      modeling.updateLabel(textAnnotation, '', newBounds);\n+\n+      // then\n+      // TextAnnotation should be resized to the new bounds\n+      expect(textAnnotation).to.have.bounds(newBounds);\n+      expect(textAnnotation.businessObject.text).to.equal('');\n+    }\n+  ));\n+\n+  it('should work normally when updating with non-empty text', inject(\n+    function(modeling, elementRegistry) {\n+\n+      // given\n+      const startEvent = elementRegistry.get('StartEvent_1');\n+\n+      // when\n+      modeling.updateLabel(startEvent, 'New Label');\n+\n+      // then\n+      expect(startEvent.businessObject.name).to.equal('New Label');\n+      expect(startEvent.label).to.exist;\n+    }\n+  ));\n+\n+});\n+\n+module.exports = {\n+  diagramXML\n+};\n\\ No newline at end of file\ndiff --git a/test_issue_reproduction.js b/test_issue_reproduction.js\nnew file mode 100644\nindex 00000000..68ec6edf\n--- /dev/null\n+++ b/test_issue_reproduction.js\n@@ -0,0 +1,138 @@\n+/**\n+ * Test to reproduce the issue with events and gateways becoming smaller when selected\n+ * after completing direct editing with empty text.\n+ */\n+\n+const fs = require('fs');\n+const path = require('path');\n+\n+// Import BPMN.js modules\n+const BpmnModeler = require('./lib/Modeler').default;\n+\n+// Create a simple BPMN diagram with events and gateways for testing\n+const testDiagram = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Event\" />\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Event\" />\n+    <bpmn:exclusiveGateway id=\"Gateway_1\" name=\"Gateway\" />\n+    <bpmn:textAnnotation id=\"TextAnnotation_1\">\n+      <bpmn:text>Test Annotation</bpmn:text>\n+    </bpmn:textAnnotation>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"85\" y=\"143\" width=\"66\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"188\" y=\"143\" width=\"60\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Gateway_1_di\" bpmnElement=\"Gateway_1\">\n+        <dc:Bounds x=\"300\" y=\"95\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"305\" y=\"152\" width=\"40\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+async function testIssueReproduction() {\n+  console.log('Testing issue reproduction...');\n+  \n+  // Create modeler instance\n+  const modeler = new BpmnModeler({\n+    container: '#canvas'\n+  });\n+\n+  try {\n+    // Import the test diagram\n+    await modeler.importXML(testDiagram);\n+    console.log('\u2713 Diagram imported successfully');\n+\n+    // Get the modeling service\n+    const modeling = modeler.get('modeling');\n+    const elementRegistry = modeler.get('elementRegistry');\n+    const textRenderer = modeler.get('textRenderer');\n+\n+    // Test elements\n+    const startEvent = elementRegistry.get('StartEvent_1');\n+    const endEvent = elementRegistry.get('EndEvent_1');\n+    const gateway = elementRegistry.get('Gateway_1');\n+    const textAnnotation = elementRegistry.get('TextAnnotation_1');\n+\n+    console.log('\\n=== Testing Current Behavior ===');\n+    \n+    // Test 1: Update start event label with empty text\n+    console.log('\\n1. Testing StartEvent with empty text:');\n+    console.log('Before - StartEvent bounds:', startEvent.label ? startEvent.label : 'No label');\n+    \n+    try {\n+      modeling.updateLabel(startEvent, '');\n+      console.log('After - StartEvent bounds:', startEvent.label ? startEvent.label : 'No label');\n+    } catch (error) {\n+      console.log('Error updating StartEvent:', error.message);\n+    }\n+\n+    // Test 2: Update gateway label with empty text\n+    console.log('\\n2. Testing Gateway with empty text:');\n+    console.log('Before - Gateway bounds:', gateway.label ? gateway.label : 'No label');\n+    \n+    try {\n+      modeling.updateLabel(gateway, '');\n+      console.log('After - Gateway bounds:', gateway.label ? gateway.label : 'No label');\n+    } catch (error) {\n+      console.log('Error updating Gateway:', error.message);\n+    }\n+\n+    // Test 3: Update text annotation with empty text (should work)\n+    console.log('\\n3. Testing TextAnnotation with empty text:');\n+    console.log('Before - TextAnnotation bounds:', textAnnotation);\n+    \n+    try {\n+      modeling.updateLabel(textAnnotation, '', { x: 400, y: 100, width: 100, height: 30 });\n+      console.log('After - TextAnnotation bounds:', textAnnotation);\n+    } catch (error) {\n+      console.log('Error updating TextAnnotation:', error.message);\n+    }\n+\n+    // Test 4: Test getExternalLabelBounds with empty text\n+    console.log('\\n4. Testing getExternalLabelBounds with empty text:');\n+    const emptyBounds = textRenderer.getExternalLabelBounds({ x: 100, y: 100, width: 36, height: 36 }, '');\n+    console.log('Empty text bounds:', emptyBounds);\n+    \n+    const normalBounds = textRenderer.getExternalLabelBounds({ x: 100, y: 100, width: 36, height: 36 }, 'Normal Text');\n+    console.log('Normal text bounds:', normalBounds);\n+\n+    console.log('\\n=== Test Results ===');\n+    console.log('Issue reproduced: Elements with empty labels get incorrect bounds');\n+    \n+  } catch (error) {\n+    console.error('Error during test:', error);\n+  }\n+}\n+\n+// Export for use in browser environment\n+if (typeof module !== 'undefined' && module.exports) {\n+  module.exports = { testIssueReproduction, testDiagram };\n+}\n+\n+// Run test if called directly\n+if (require.main === module) {\n+  testIssueReproduction();\n+}\n\\ No newline at end of file\ndiff --git a/test_visual.html b/test_visual.html\nnew file mode 100644\nindex 00000000..59dfdad2\n--- /dev/null\n+++ b/test_visual.html\n@@ -0,0 +1,198 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>BPMN.js Issue Reproduction Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        #canvas {\n+            border: 1px solid #ccc;\n+            height: 400px;\n+            width: 800px;\n+            margin: 20px 0;\n+        }\n+        .test-section {\n+            margin: 20px 0;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+            background: #f9f9f9;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px 15px;\n+            background: #007bff;\n+            color: white;\n+            border: none;\n+            cursor: pointer;\n+        }\n+        button:hover {\n+            background: #0056b3;\n+        }\n+        .log {\n+            background: #f8f9fa;\n+            border: 1px solid #dee2e6;\n+            padding: 10px;\n+            margin: 10px 0;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+            max-height: 200px;\n+            overflow-y: auto;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>BPMN.js Issue Reproduction Test</h1>\n+    <p>This test reproduces the issue where events and gateways become smaller when their labels are updated with empty text.</p>\n+    \n+    <div id=\"canvas\"></div>\n+    \n+    <div class=\"test-section\">\n+        <h3>Test Actions</h3>\n+        <button onclick=\"testStartEventEmpty()\">Update Start Event with Empty Text</button>\n+        <button onclick=\"testGatewayEmpty()\">Update Gateway with Empty Text</button>\n+        <button onclick=\"testTextAnnotationEmpty()\">Update Text Annotation with Empty Text</button>\n+        <button onclick=\"resetDiagram()\">Reset Diagram</button>\n+    </div>\n+    \n+    <div class=\"test-section\">\n+        <h3>Test Log</h3>\n+        <div id=\"log\" class=\"log\"></div>\n+    </div>\n+\n+    <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        const testDiagram = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Event\" />\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Event\" />\n+    <bpmn:exclusiveGateway id=\"Gateway_1\" name=\"Gateway\" />\n+    <bpmn:textAnnotation id=\"TextAnnotation_1\">\n+      <bpmn:text>Test Annotation</bpmn:text>\n+    </bpmn:textAnnotation>\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"85\" y=\"143\" width=\"66\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"188\" y=\"143\" width=\"60\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Gateway_1_di\" bpmnElement=\"Gateway_1\">\n+        <dc:Bounds x=\"300\" y=\"95\" width=\"50\" height=\"50\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"305\" y=\"152\" width=\"40\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"TextAnnotation_1_di\" bpmnElement=\"TextAnnotation_1\">\n+        <dc:Bounds x=\"400\" y=\"100\" width=\"100\" height=\"30\" />\n+      </bpmndi:BPMNShape>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+        let modeler;\n+        let modeling;\n+        let elementRegistry;\n+        let textRenderer;\n+\n+        function log(message) {\n+            const logElement = document.getElementById('log');\n+            logElement.textContent += new Date().toLocaleTimeString() + ': ' + message + '\\n';\n+            logElement.scrollTop = logElement.scrollHeight;\n+        }\n+\n+        async function initializeModeler() {\n+            try {\n+                modeler = new BpmnJS({\n+                    container: '#canvas'\n+                });\n+\n+                await modeler.importXML(testDiagram);\n+                \n+                modeling = modeler.get('modeling');\n+                elementRegistry = modeler.get('elementRegistry');\n+                textRenderer = modeler.get('textRenderer');\n+                \n+                log('Modeler initialized successfully');\n+            } catch (error) {\n+                log('Error initializing modeler: ' + error.message);\n+            }\n+        }\n+\n+        function getBoundsInfo(element) {\n+            if (!element) return 'null';\n+            const bounds = element.label ? element.label : element;\n+            return `{x: ${bounds.x}, y: ${bounds.y}, width: ${bounds.width}, height: ${bounds.height}}`;\n+        }\n+\n+        function testStartEventEmpty() {\n+            try {\n+                const startEvent = elementRegistry.get('StartEvent_1');\n+                log('Before - StartEvent label bounds: ' + getBoundsInfo(startEvent));\n+                \n+                modeling.updateLabel(startEvent, '');\n+                \n+                log('After - StartEvent label bounds: ' + getBoundsInfo(startEvent));\n+                log('StartEvent test completed');\n+            } catch (error) {\n+                log('Error in StartEvent test: ' + error.message);\n+            }\n+        }\n+\n+        function testGatewayEmpty() {\n+            try {\n+                const gateway = elementRegistry.get('Gateway_1');\n+                log('Before - Gateway label bounds: ' + getBoundsInfo(gateway));\n+                \n+                modeling.updateLabel(gateway, '');\n+                \n+                log('After - Gateway label bounds: ' + getBoundsInfo(gateway));\n+                log('Gateway test completed');\n+            } catch (error) {\n+                log('Error in Gateway test: ' + error.message);\n+            }\n+        }\n+\n+        function testTextAnnotationEmpty() {\n+            try {\n+                const textAnnotation = elementRegistry.get('TextAnnotation_1');\n+                log('Before - TextAnnotation bounds: ' + getBoundsInfo(textAnnotation));\n+                \n+                modeling.updateLabel(textAnnotation, '', { x: 400, y: 100, width: 100, height: 30 });\n+                \n+                log('After - TextAnnotation bounds: ' + getBoundsInfo(textAnnotation));\n+                log('TextAnnotation test completed');\n+            } catch (error) {\n+                log('Error in TextAnnotation test: ' + error.message);\n+            }\n+        }\n+\n+        async function resetDiagram() {\n+            try {\n+                await modeler.importXML(testDiagram);\n+                log('Diagram reset successfully');\n+            } catch (error) {\n+                log('Error resetting diagram: ' + error.message);\n+            }\n+        }\n+\n+        // Initialize when page loads\n+        window.addEventListener('load', initializeModeler);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

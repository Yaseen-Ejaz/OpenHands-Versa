{"instance_id": "bpmn-io__bpmn-js-1151", "model_patch": "diff --git a/lib/features/copy-paste/BpmnCopyPaste.js b/lib/features/copy-paste/BpmnCopyPaste.js\nindex f66694f6..1ca51c13 100644\n--- a/lib/features/copy-paste/BpmnCopyPaste.js\n+++ b/lib/features/copy-paste/BpmnCopyPaste.js\n@@ -117,9 +117,15 @@ export default function BpmnCopyPaste(bpmnFactory, eventBus, moddleCopy) {\n         oldBusinessObject = descriptor.oldBusinessObject,\n         newBusinessObject;\n \n-    // do NOT copy business object if external label\n+    // handle labels differently - they should copy their own business object\n     if (isLabel(descriptor)) {\n-      descriptor.businessObject = getBusinessObject(cache[ descriptor.labelTarget ]);\n+      // create a new business object for the label and copy its properties\n+      newBusinessObject = bpmnFactory.create(oldBusinessObject.$type);\n+      \n+      descriptor.businessObject = moddleCopy.copyElement(\n+        oldBusinessObject,\n+        newBusinessObject\n+      );\n \n       return;\n     }\ndiff --git a/test/spec/features/copy-paste/LabelCopyPasteSpec.js b/test/spec/features/copy-paste/LabelCopyPasteSpec.js\nnew file mode 100644\nindex 00000000..b18de98a\n--- /dev/null\n+++ b/test/spec/features/copy-paste/LabelCopyPasteSpec.js\n@@ -0,0 +1,197 @@\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+\n+import {\n+  getBusinessObject,\n+  is\n+} from 'lib/util/ModelUtil';\n+\n+describe('Label Copy Paste Issue Reproduction', function() {\n+\n+  var testModules = [\n+    bpmnCopyPasteModule,\n+    copyPasteModule,\n+    coreModule,\n+    modelingModule\n+  ];\n+\n+  // Test BPMN with labeled elements in a collaboration\n+  var collaborationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Test Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Label\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task Label\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Label\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow Label 1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow Label 2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"202\" y=\"205\" width=\"56\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"300\" y=\"140\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"446\" y=\"205\" width=\"48\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"248\" y=\"180\" />\n+        <di:waypoint x=\"300\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"254\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"400\" y=\"180\" />\n+        <di:waypoint x=\"452\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"406\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(collaborationXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should reproduce label loss during pool extraction', inject(function(canvas, copyPaste, elementRegistry, modeling) {\n+\n+    // given\n+    var participant = elementRegistry.get('Participant_1');\n+    var startEvent = elementRegistry.get('StartEvent_1');\n+    var task = elementRegistry.get('Task_1');\n+    var endEvent = elementRegistry.get('EndEvent_1');\n+    var flow1 = elementRegistry.get('SequenceFlow_1');\n+    var flow2 = elementRegistry.get('SequenceFlow_2');\n+    var rootElement = canvas.getRootElement();\n+\n+    // Verify initial labels exist\n+    expect(getBusinessObject(startEvent).name).to.equal('Start Label');\n+    expect(getBusinessObject(task).name).to.equal('Task Label');\n+    expect(getBusinessObject(endEvent).name).to.equal('End Label');\n+    expect(getBusinessObject(flow1).name).to.equal('Flow Label 1');\n+    expect(getBusinessObject(flow2).name).to.equal('Flow Label 2');\n+\n+    // Get all elements inside the participant (simulate pool extraction)\n+    var participantChildren = participant.children;\n+    \n+    // when\n+    // Step 1: Copy participant contents\n+    copyPaste.copy(participantChildren);\n+\n+    // Step 2: Remove all diagram contents (simulate clearing diagram)\n+    modeling.removeShape(participant);\n+\n+    // Step 3: Paste the copied contents\n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 300,\n+        y: 300\n+      }\n+    });\n+\n+    // then\n+    // Find pasted elements\n+    var pastedStartEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:StartEvent');\n+    });\n+    var pastedTask = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:Task');\n+    });\n+    var pastedEndEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:EndEvent');\n+    });\n+    var pastedFlow1 = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:SequenceFlow') && element.source === pastedStartEvent;\n+    });\n+    var pastedFlow2 = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:SequenceFlow') && element.source === pastedTask;\n+    });\n+\n+    // Verify elements were pasted\n+    expect(pastedStartEvent).to.exist;\n+    expect(pastedTask).to.exist;\n+    expect(pastedEndEvent).to.exist;\n+    expect(pastedFlow1).to.exist;\n+    expect(pastedFlow2).to.exist;\n+\n+    // Check if labels are preserved (this should fail with current implementation)\n+    console.log('Pasted StartEvent name:', getBusinessObject(pastedStartEvent).name);\n+    console.log('Pasted Task name:', getBusinessObject(pastedTask).name);\n+    console.log('Pasted EndEvent name:', getBusinessObject(pastedEndEvent).name);\n+    console.log('Pasted Flow1 name:', getBusinessObject(pastedFlow1).name);\n+    console.log('Pasted Flow2 name:', getBusinessObject(pastedFlow2).name);\n+\n+    // These assertions should pass after the fix\n+    expect(getBusinessObject(pastedStartEvent).name).to.equal('Start Label');\n+    expect(getBusinessObject(pastedTask).name).to.equal('Task Label');\n+    expect(getBusinessObject(pastedEndEvent).name).to.equal('End Label');\n+    expect(getBusinessObject(pastedFlow1).name).to.equal('Flow Label 1');\n+    expect(getBusinessObject(pastedFlow2).name).to.equal('Flow Label 2');\n+  }));\n+\n+  it('should preserve labels when copying individual labeled elements', inject(function(canvas, copyPaste, elementRegistry, modeling) {\n+\n+    // given\n+    var startEvent = elementRegistry.get('StartEvent_1');\n+    var rootElement = canvas.getRootElement();\n+\n+    // Verify initial label exists\n+    expect(getBusinessObject(startEvent).name).to.equal('Start Label');\n+\n+    // when\n+    copyPaste.copy(startEvent);\n+\n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 500,\n+        y: 500\n+      }\n+    });\n+\n+    // then\n+    var pastedStartEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:StartEvent');\n+    });\n+\n+    expect(pastedStartEvent).to.exist;\n+    console.log('Individual copy - Pasted StartEvent name:', getBusinessObject(pastedStartEvent).name);\n+    \n+    // This should work even with current implementation\n+    expect(getBusinessObject(pastedStartEvent).name).to.equal('Start Label');\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_label_copy_paste.js b/test_label_copy_paste.js\nnew file mode 100644\nindex 00000000..7b22dd3e\n--- /dev/null\n+++ b/test_label_copy_paste.js\n@@ -0,0 +1,201 @@\n+/**\n+ * Test to reproduce the label loss issue during pool extraction\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import bpmnCopyPasteModule from 'lib/features/copy-paste';\n+import copyPasteModule from 'diagram-js/lib/features/copy-paste';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+\n+import {\n+  getBusinessObject,\n+  is\n+} from 'lib/util/ModelUtil';\n+\n+describe('Label Copy Paste Issue Reproduction', function() {\n+\n+  var testModules = [\n+    bpmnCopyPasteModule,\n+    copyPasteModule,\n+    coreModule,\n+    modelingModule\n+  ];\n+\n+  // Test BPMN with labeled elements in a collaboration\n+  var collaborationXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Test Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Label\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task Label\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Label\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow Label 1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow Label 2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"202\" y=\"205\" width=\"56\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"300\" y=\"140\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"446\" y=\"205\" width=\"48\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"248\" y=\"180\" />\n+        <di:waypoint x=\"300\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"254\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"400\" y=\"180\" />\n+        <di:waypoint x=\"452\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"406\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(collaborationXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should reproduce label loss during pool extraction', inject(function(canvas, copyPaste, elementRegistry, modeling) {\n+\n+    // given\n+    var participant = elementRegistry.get('Participant_1');\n+    var startEvent = elementRegistry.get('StartEvent_1');\n+    var task = elementRegistry.get('Task_1');\n+    var endEvent = elementRegistry.get('EndEvent_1');\n+    var flow1 = elementRegistry.get('SequenceFlow_1');\n+    var flow2 = elementRegistry.get('SequenceFlow_2');\n+    var rootElement = canvas.getRootElement();\n+\n+    // Verify initial labels exist\n+    expect(getBusinessObject(startEvent).name).to.equal('Start Label');\n+    expect(getBusinessObject(task).name).to.equal('Task Label');\n+    expect(getBusinessObject(endEvent).name).to.equal('End Label');\n+    expect(getBusinessObject(flow1).name).to.equal('Flow Label 1');\n+    expect(getBusinessObject(flow2).name).to.equal('Flow Label 2');\n+\n+    // Get all elements inside the participant (simulate pool extraction)\n+    var participantChildren = participant.children;\n+    \n+    // when\n+    // Step 1: Copy participant contents\n+    copyPaste.copy(participantChildren);\n+\n+    // Step 2: Remove all diagram contents (simulate clearing diagram)\n+    modeling.removeShape(participant);\n+\n+    // Step 3: Paste the copied contents\n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 300,\n+        y: 300\n+      }\n+    });\n+\n+    // then\n+    // Find pasted elements\n+    var pastedStartEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:StartEvent');\n+    });\n+    var pastedTask = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:Task');\n+    });\n+    var pastedEndEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:EndEvent');\n+    });\n+    var pastedFlow1 = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:SequenceFlow') && element.source === pastedStartEvent;\n+    });\n+    var pastedFlow2 = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:SequenceFlow') && element.source === pastedTask;\n+    });\n+\n+    // Verify elements were pasted\n+    expect(pastedStartEvent).to.exist;\n+    expect(pastedTask).to.exist;\n+    expect(pastedEndEvent).to.exist;\n+    expect(pastedFlow1).to.exist;\n+    expect(pastedFlow2).to.exist;\n+\n+    // Check if labels are preserved (this should fail with current implementation)\n+    console.log('Pasted StartEvent name:', getBusinessObject(pastedStartEvent).name);\n+    console.log('Pasted Task name:', getBusinessObject(pastedTask).name);\n+    console.log('Pasted EndEvent name:', getBusinessObject(pastedEndEvent).name);\n+    console.log('Pasted Flow1 name:', getBusinessObject(pastedFlow1).name);\n+    console.log('Pasted Flow2 name:', getBusinessObject(pastedFlow2).name);\n+\n+    // These assertions should pass after the fix\n+    expect(getBusinessObject(pastedStartEvent).name).to.equal('Start Label');\n+    expect(getBusinessObject(pastedTask).name).to.equal('Task Label');\n+    expect(getBusinessObject(pastedEndEvent).name).to.equal('End Label');\n+    expect(getBusinessObject(pastedFlow1).name).to.equal('Flow Label 1');\n+    expect(getBusinessObject(pastedFlow2).name).to.equal('Flow Label 2');\n+  }));\n+\n+  it('should preserve labels when copying individual labeled elements', inject(function(canvas, copyPaste, elementRegistry, modeling) {\n+\n+    // given\n+    var startEvent = elementRegistry.get('StartEvent_1');\n+    var rootElement = canvas.getRootElement();\n+\n+    // Verify initial label exists\n+    expect(getBusinessObject(startEvent).name).to.equal('Start Label');\n+\n+    // when\n+    copyPaste.copy(startEvent);\n+\n+    var pastedElements = copyPaste.paste({\n+      element: rootElement,\n+      point: {\n+        x: 500,\n+        y: 500\n+      }\n+    });\n+\n+    // then\n+    var pastedStartEvent = pastedElements.find(function(element) {\n+      return is(element, 'bpmn:StartEvent');\n+    });\n+\n+    expect(pastedStartEvent).to.exist;\n+    console.log('Individual copy - Pasted StartEvent name:', getBusinessObject(pastedStartEvent).name);\n+    \n+    // This should work even with current implementation\n+    expect(getBusinessObject(pastedStartEvent).name).to.equal('Start Label');\n+  }));\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_label_issue.html b/test_label_issue.html\nnew file mode 100644\nindex 00000000..e084a024\n--- /dev/null\n+++ b/test_label_issue.html\n@@ -0,0 +1,209 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN Label Copy Paste Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    #canvas { border: 1px solid #ccc; height: 400px; margin: 20px 0; }\n+    button { margin: 5px; padding: 10px; }\n+    .log { background: #f5f5f5; padding: 10px; margin: 10px 0; border-radius: 4px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>BPMN Label Copy Paste Issue Test</h1>\n+  \n+  <div>\n+    <button onclick=\"copyParticipantContents()\">1. Copy Participant Contents</button>\n+    <button onclick=\"clearDiagram()\">2. Clear Diagram</button>\n+    <button onclick=\"pasteContents()\">3. Paste Contents</button>\n+    <button onclick=\"checkLabels()\">4. Check Labels</button>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+  \n+  <div id=\"log\" class=\"log\">\n+    <h3>Log:</h3>\n+    <div id=\"logContent\"></div>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    var modeler;\n+    var copiedElements = null;\n+    \n+    // BPMN XML with labeled elements in a collaboration\n+    var bpmnXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:collaboration id=\"Collaboration_1\">\n+    <bpmn:participant id=\"Participant_1\" name=\"Test Pool\" processRef=\"Process_1\" />\n+  </bpmn:collaboration>\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\" name=\"Start Label\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task Label\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\" name=\"End Label\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" name=\"Flow Label 1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" name=\"Flow Label 2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_1\">\n+      <bpmndi:BPMNShape id=\"Participant_1_di\" bpmnElement=\"Participant_1\" isHorizontal=\"true\">\n+        <dc:Bounds x=\"160\" y=\"80\" width=\"600\" height=\"250\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"212\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"202\" y=\"205\" width=\"56\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"300\" y=\"140\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"452\" y=\"162\" width=\"36\" height=\"36\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"446\" y=\"205\" width=\"48\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"248\" y=\"180\" />\n+        <di:waypoint x=\"300\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"254\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"400\" y=\"180\" />\n+        <di:waypoint x=\"452\" y=\"180\" />\n+        <bpmndi:BPMNLabel>\n+          <dc:Bounds x=\"406\" y=\"162\" width=\"64\" height=\"14\" />\n+        </bpmndi:BPMNLabel>\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    function log(message) {\n+      var logContent = document.getElementById('logContent');\n+      logContent.innerHTML += '<div>' + new Date().toLocaleTimeString() + ': ' + message + '</div>';\n+    }\n+\n+    function copyParticipantContents() {\n+      try {\n+        var elementRegistry = modeler.get('elementRegistry');\n+        var copyPaste = modeler.get('copyPaste');\n+        \n+        var participant = elementRegistry.get('Participant_1');\n+        if (!participant) {\n+          log('ERROR: Participant not found');\n+          return;\n+        }\n+        \n+        // Get all elements inside the participant\n+        var participantChildren = participant.children;\n+        log('Found ' + participantChildren.length + ' elements in participant');\n+        \n+        // Copy the contents\n+        copiedElements = copyPaste.copy(participantChildren);\n+        log('Copied participant contents: ' + JSON.stringify(Object.keys(copiedElements)));\n+        \n+        // Log the names of the elements being copied\n+        participantChildren.forEach(function(element) {\n+          var bo = element.businessObject;\n+          if (bo && bo.name) {\n+            log('Copying element ' + element.id + ' with name: \"' + bo.name + '\"');\n+          }\n+        });\n+        \n+      } catch (error) {\n+        log('ERROR in copyParticipantContents: ' + error.message);\n+      }\n+    }\n+\n+    function clearDiagram() {\n+      try {\n+        var elementRegistry = modeler.get('elementRegistry');\n+        var modeling = modeler.get('modeling');\n+        \n+        var participant = elementRegistry.get('Participant_1');\n+        if (participant) {\n+          modeling.removeShape(participant);\n+          log('Cleared diagram (removed participant)');\n+        } else {\n+          log('Participant already removed');\n+        }\n+      } catch (error) {\n+        log('ERROR in clearDiagram: ' + error.message);\n+      }\n+    }\n+\n+    function pasteContents() {\n+      try {\n+        var canvas = modeler.get('canvas');\n+        var copyPaste = modeler.get('copyPaste');\n+        \n+        var rootElement = canvas.getRootElement();\n+        \n+        var pastedElements = copyPaste.paste({\n+          element: rootElement,\n+          point: { x: 300, y: 300 }\n+        });\n+        \n+        log('Pasted ' + pastedElements.length + ' elements');\n+        \n+        // Log the names of pasted elements\n+        pastedElements.forEach(function(element) {\n+          var bo = element.businessObject;\n+          if (bo && bo.name) {\n+            log('Pasted element ' + element.id + ' with name: \"' + bo.name + '\"');\n+          } else if (bo) {\n+            log('Pasted element ' + element.id + ' with NO NAME (type: ' + bo.$type + ')');\n+          }\n+        });\n+        \n+      } catch (error) {\n+        log('ERROR in pasteContents: ' + error.message);\n+      }\n+    }\n+\n+    function checkLabels() {\n+      try {\n+        var elementRegistry = modeler.get('elementRegistry');\n+        \n+        var allElements = elementRegistry.getAll();\n+        log('Checking labels on ' + allElements.length + ' elements:');\n+        \n+        allElements.forEach(function(element) {\n+          var bo = element.businessObject;\n+          if (bo && bo.name) {\n+            log('\u2713 Element ' + element.id + ' (' + bo.$type + ') has name: \"' + bo.name + '\"');\n+          } else if (bo && (bo.$type.includes('Event') || bo.$type.includes('Task') || bo.$type.includes('Flow'))) {\n+            log('\u2717 Element ' + element.id + ' (' + bo.$type + ') is missing name');\n+          }\n+        });\n+        \n+      } catch (error) {\n+        log('ERROR in checkLabels: ' + error.message);\n+      }\n+    }\n+\n+    // Initialize the modeler\n+    modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    modeler.importXML(bpmnXML).then(function() {\n+      log('BPMN diagram loaded successfully');\n+      checkLabels(); // Check initial labels\n+    }).catch(function(err) {\n+      log('ERROR loading BPMN: ' + err.message);\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

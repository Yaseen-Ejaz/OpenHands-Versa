{"instance_id": "openlayers__openlayers-13212", "model_patch": "diff --git a/examples/cog-pyramid-improved.html b/examples/cog-pyramid-improved.html\nnew file mode 100644\nindex 000000000..3ebd3be82\n--- /dev/null\n+++ b/examples/cog-pyramid-improved.html\n@@ -0,0 +1,138 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\">\n+    <title>Improved GeoTIFF Pyramid</title>\n+    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/ol@v7.2.2/ol.css\" type=\"text/css\">\n+    <style>\n+      .map {\n+        height: 400px;\n+        width: 100%;\n+      }\n+      .info {\n+        padding: 10px;\n+        background: #f0f0f0;\n+        margin: 10px 0;\n+        border-radius: 5px;\n+      }\n+      .performance {\n+        display: flex;\n+        gap: 20px;\n+        margin: 10px 0;\n+      }\n+      .metric {\n+        padding: 10px;\n+        background: white;\n+        border: 1px solid #ccc;\n+        border-radius: 3px;\n+        min-width: 120px;\n+      }\n+      .metric.good { border-color: green; }\n+      .metric.warning { border-color: orange; }\n+      .metric.error { border-color: red; }\n+    </style>\n+  </head>\n+  <body>\n+    <h2>Improved GeoTIFF Pyramid Example</h2>\n+    <div class=\"info\">\n+      <strong>Improvement:</strong> This example uses a single WebGLTileLayer with a GeoTIFFPyramid source \n+      instead of multiple WebGLTileLayer instances. This should prevent WebGL context exhaustion and \n+      improve performance for large pyramids.\n+    </div>\n+    \n+    <div class=\"performance\" id=\"performance\">\n+      <div class=\"metric\" id=\"webgl-contexts\">\n+        <div>WebGL Contexts</div>\n+        <div id=\"context-count\">0</div>\n+      </div>\n+      <div class=\"metric\" id=\"fps-metric\">\n+        <div>FPS</div>\n+        <div id=\"fps-count\">--</div>\n+      </div>\n+      <div class=\"metric\" id=\"tiles-metric\">\n+        <div>Tiles Loaded</div>\n+        <div id=\"tiles-count\">0</div>\n+      </div>\n+    </div>\n+    \n+    <div id=\"map\" class=\"map\"></div>\n+    \n+    <div class=\"info\">\n+      <strong>Instructions:</strong> Pan and zoom around the map. The performance metrics above \n+      should show only 1 WebGL context being used regardless of how many tiles are loaded.\n+    </div>\n+\n+    <script type=\"module\" src=\"./cog-pyramid-improved.js\"></script>\n+    \n+    <script type=\"module\">\n+      // Performance monitoring\n+      let webglContextCount = 0;\n+      let tilesLoaded = 0;\n+      let frameCount = 0;\n+      let lastTime = performance.now();\n+\n+      // Monitor WebGL context creation\n+      const originalGetContext = HTMLCanvasElement.prototype.getContext;\n+      HTMLCanvasElement.prototype.getContext = function(contextType, ...args) {\n+        const context = originalGetContext.call(this, contextType, ...args);\n+        if (contextType === 'webgl' || contextType === 'webgl2') {\n+          webglContextCount++;\n+          updateMetrics();\n+        }\n+        return context;\n+      };\n+\n+      // Monitor tile loading (simplified)\n+      let originalFetch = window.fetch;\n+      window.fetch = function(...args) {\n+        const url = args[0];\n+        if (typeof url === 'string' && url.includes('.tif')) {\n+          tilesLoaded++;\n+          updateMetrics();\n+        }\n+        return originalFetch.apply(this, args);\n+      };\n+\n+      function updateMetrics() {\n+        document.getElementById('context-count').textContent = webglContextCount;\n+        document.getElementById('tiles-count').textContent = tilesLoaded;\n+        \n+        const contextMetric = document.getElementById('webgl-contexts');\n+        if (webglContextCount <= 1) {\n+          contextMetric.className = 'metric good';\n+        } else if (webglContextCount <= 3) {\n+          contextMetric.className = 'metric warning';\n+        } else {\n+          contextMetric.className = 'metric error';\n+        }\n+      }\n+\n+      function measureFPS() {\n+        const currentTime = performance.now();\n+        frameCount++;\n+        \n+        if (currentTime - lastTime >= 1000) {\n+          const fps = Math.round((frameCount * 1000) / (currentTime - lastTime));\n+          document.getElementById('fps-count').textContent = fps;\n+          \n+          const fpsMetric = document.getElementById('fps-metric');\n+          if (fps >= 25) {\n+            fpsMetric.className = 'metric good';\n+          } else if (fps >= 15) {\n+            fpsMetric.className = 'metric warning';\n+          } else {\n+            fpsMetric.className = 'metric error';\n+          }\n+          \n+          frameCount = 0;\n+          lastTime = currentTime;\n+        }\n+        \n+        requestAnimationFrame(measureFPS);\n+      }\n+      \n+      measureFPS();\n+      updateMetrics();\n+    </script>\n+  </body>\n+</html>\n\\ No newline at end of file\ndiff --git a/examples/cog-pyramid-improved.js b/examples/cog-pyramid-improved.js\nnew file mode 100644\nindex 000000000..6bb9ac35f\n--- /dev/null\n+++ b/examples/cog-pyramid-improved.js\n@@ -0,0 +1,48 @@\n+import GeoTIFFPyramid from '../src/ol/source/GeoTIFFPyramid.js';\n+import Map from '../src/ol/Map.js';\n+import TileGrid from '../src/ol/tilegrid/TileGrid.js';\n+import View from '../src/ol/View.js';\n+import WebGLTileLayer from '../src/ol/layer/WebGLTile.js';\n+\n+// Metadata from https://s2downloads.eox.at/demo/EOxCloudless/2019/rgb/2019_EOxCloudless_rgb.json\n+\n+// Tile grid of the GeoTIFF pyramid layout\n+const tileGrid = new TileGrid({\n+  origin: [-180, 90],\n+  resolutions: [0.703125, 0.3515625, 0.17578125, 8.7890625e-2, 4.39453125e-2],\n+  tileSizes: [\n+    [512, 256],\n+    [1024, 512],\n+    [2048, 1024],\n+    [4096, 2048],\n+    [4096, 4096],\n+  ],\n+});\n+\n+// Create a single WebGLTileLayer with the new GeoTIFFPyramid source\n+const pyramidLayer = new WebGLTileLayer({\n+  source: new GeoTIFFPyramid({\n+    url: 'https://s2downloads.eox.at/demo/EOxCloudless/2019/rgb/{z}/{y}/{x}.tif',\n+    tileGrid: tileGrid,\n+    projection: 'EPSG:4326',\n+    bandCount: 3, // RGB\n+    normalize: true,\n+    interpolate: true,\n+  }),\n+});\n+\n+const map = new Map({\n+  target: 'map',\n+  layers: [pyramidLayer],\n+  view: new View({\n+    projection: 'EPSG:4326',\n+    center: [0, 0],\n+    zoom: 0,\n+    showFullExtent: true,\n+  }),\n+});\n+\n+// Add some debugging information\n+console.log('GeoTIFF Pyramid layer created with single WebGL context');\n+console.log('Tile grid resolutions:', tileGrid.getResolutions());\n+console.log('Tile grid tile sizes:', tileGrid.getTileSizes ? tileGrid.getTileSizes() : 'Not available');\n\\ No newline at end of file\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..21a4a2cf7\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,422 @@\n+Server running at http://localhost:8080/\n+Test page: http://localhost:8080/test_geotiff_pyramid.html\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /test_geotiff_pyramid.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/source/GeoTIFF.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/layer/Group.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/Map.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/tilegrid/TileGrid.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/View.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/layer/WebGLTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/extent.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/renderer/Composite.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/PluggableMap.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/obj.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/control.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/interaction.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/layer/Base.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/Collection.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/CollectionEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/events/Event.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/events/EventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/ObjectEventType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/source/State.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/asserts.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/util.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/events.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/TileRange.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/tilegrid/common.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/math.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/tilecoord.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/array.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/size.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/layer/BaseTile.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/layer/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/renderer/webgl/TileLayer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/style/expressions.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/Object.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/geom/GeometryType.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 09:31:02] \"GET /src/ol/pro
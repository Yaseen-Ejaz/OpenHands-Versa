{"instance_id": "openlayers__openlayers-14719", "model_patch": "diff --git a/src/ol/renderer/canvas/ImageLayer.js b/src/ol/renderer/canvas/ImageLayer.js\nindex f92414f4b..4b1d630d8 100644\n--- a/src/ol/renderer/canvas/ImageLayer.js\n+++ b/src/ol/renderer/canvas/ImageLayer.js\n@@ -237,13 +237,26 @@ class CanvasImageLayerRenderer extends CanvasLayerRenderer {\n     if (render && dw >= 0.5 && dh >= 0.5) {\n       const dx = transform[4];\n       const dy = transform[5];\n+      // Round drawing dimensions to prevent blurriness caused by fractional pixel rendering\n+      const roundedDw = Math.round(dw);\n+      const roundedDh = Math.round(dh);\n       const opacity = layerState.opacity;\n       let previousAlpha;\n       if (opacity !== 1) {\n         previousAlpha = context.globalAlpha;\n         context.globalAlpha = opacity;\n       }\n-      context.drawImage(img, 0, 0, +img.width, +img.height, dx, dy, dw, dh);\n+      context.drawImage(\n+        img,\n+        0,\n+        0,\n+        +img.width,\n+        +img.height,\n+        dx,\n+        dy,\n+        roundedDw,\n+        roundedDh\n+      );\n       if (opacity !== 1) {\n         context.globalAlpha = previousAlpha;\n       }\ndiff --git a/test_fix.html b/test_fix.html\nnew file mode 100644\nindex 000000000..a3ff60ec1\n--- /dev/null\n+++ b/test_fix.html\n@@ -0,0 +1,72 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WMS Blur Fix Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .test-container { margin-bottom: 30px; }\n+        .map { width: 401px; height: 301px; border: 1px solid #ccc; margin: 10px 0; }\n+        .info { font-size: 12px; color: #666; }\n+        h3 { margin: 10px 0 5px 0; }\n+    </style>\n+    <script src=\"./dist/ol.js\"></script>\n+</head>\n+<body>\n+    <h1>WMS Image Blur Fix Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h3>Test: Odd dimensions with non-integer pixel ratio</h3>\n+        <div class=\"info\">Map: 401x301px, Pixel Ratio: 1.25 (should be sharp with fix)</div>\n+        <div id=\"map1\" class=\"map\"></div>\n+    </div>\n+\n+    <script>\n+        // Create a simple test with a static image to avoid CORS issues\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [\n+                new ol.layer.Image({\n+                    source: new ol.source.ImageStatic({\n+                        url: 'data:image/svg+xml;base64,' + btoa(`\n+                            <svg width=\"400\" height=\"300\" xmlns=\"http://www.w3.org/2000/svg\">\n+                                <defs>\n+                                    <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n+                                        <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke=\"#ccc\" stroke-width=\"1\"/>\n+                                    </pattern>\n+                                </defs>\n+                                <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n+                                <text x=\"200\" y=\"150\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"24\" fill=\"red\">\n+                                    Test Pattern\n+                                </text>\n+                                <circle cx=\"100\" cy=\"100\" r=\"30\" fill=\"blue\" opacity=\"0.7\"/>\n+                                <rect x=\"250\" y=\"50\" width=\"100\" height=\"80\" fill=\"green\" opacity=\"0.7\"/>\n+                            </svg>\n+                        `),\n+                        imageExtent: [-180, -90, 180, 90],\n+                        projection: 'EPSG:4326'\n+                    })\n+                })\n+            ],\n+            view: new ol.View({\n+                center: [0, 0],\n+                zoom: 1,\n+                projection: 'EPSG:4326'\n+            }),\n+            pixelRatio: 1.25\n+        });\n+\n+        // Log rendering information\n+        map1.once('rendercomplete', function() {\n+            console.log('Map rendered successfully with pixel ratio:', map1.getPixelRatio());\n+            console.log('Map size:', map1.getSize());\n+            \n+            // Check canvas dimensions\n+            const canvas = document.querySelector('canvas');\n+            if (canvas) {\n+                console.log('Canvas dimensions:', canvas.width, 'x', canvas.height);\n+                console.log('Canvas style:', canvas.style.transform);\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_wms_blur.html b/test_wms_blur.html\nnew file mode 100644\nindex 000000000..d6ee4541e\n--- /dev/null\n+++ b/test_wms_blur.html\n@@ -0,0 +1,145 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WMS Blur Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .test-container { margin-bottom: 30px; }\n+        .map { width: 400px; height: 300px; border: 1px solid #ccc; margin: 10px 0; }\n+        .info { font-size: 12px; color: #666; }\n+        h3 { margin: 10px 0 5px 0; }\n+    </style>\n+    <script src=\"./dist/ol.js\"></script>\n+    <script>\n+        // Override console.log to capture debug info\n+        const originalLog = console.log;\n+        const logs = [];\n+        console.log = function(...args) {\n+            logs.push(args.join(' '));\n+            originalLog.apply(console, args);\n+        };\n+    </script>\n+</head>\n+<body>\n+    <h1>WMS Image Blur Test Cases</h1>\n+    \n+    <div class=\"test-container\">\n+        <h3>Test 1: Even dimensions, pixel ratio = 1</h3>\n+        <div class=\"info\">Map: 400x300px, Pixel Ratio: 1.0 (should be sharp)</div>\n+        <div id=\"map1\" class=\"map\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h3>Test 2: Odd dimensions, pixel ratio = 1</h3>\n+        <div class=\"info\">Map: 401x301px, Pixel Ratio: 1.0 (may be blurry)</div>\n+        <div id=\"map2\" class=\"map\" style=\"width: 401px; height: 301px;\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h3>Test 3: Even dimensions, non-integer pixel ratio</h3>\n+        <div class=\"info\">Map: 400x300px, Pixel Ratio: 1.5 (may be blurry)</div>\n+        <div id=\"map3\" class=\"map\"></div>\n+    </div>\n+    \n+    <div class=\"test-container\">\n+        <h3>Test 4: Odd dimensions, non-integer pixel ratio</h3>\n+        <div class=\"info\">Map: 401x301px, Pixel Ratio: 1.25 (likely blurry)</div>\n+        <div id=\"map4\" class=\"map\" style=\"width: 401px; height: 301px;\"></div>\n+    </div>\n+\n+    <script>\n+        // Common WMS source configuration\n+        function createWMSSource() {\n+            return new ol.source.ImageWMS({\n+                url: 'https://ahocevar.com/geoserver/wms',\n+                params: {\n+                    'LAYERS': 'ne:ne',\n+                    'TILED': false\n+                },\n+                serverType: 'geoserver',\n+                crossOrigin: 'anonymous'\n+            });\n+        }\n+\n+        // Common view configuration\n+        function createView() {\n+            return new ol.View({\n+                center: ol.proj.fromLonLat([0, 0]),\n+                zoom: 2\n+            });\n+        }\n+\n+        // Test 1: Even dimensions, pixel ratio = 1\n+        const map1 = new ol.Map({\n+            target: 'map1',\n+            layers: [\n+                new ol.layer.Image({\n+                    source: createWMSSource()\n+                })\n+            ],\n+            view: createView(),\n+            pixelRatio: 1.0\n+        });\n+\n+        // Test 2: Odd dimensions, pixel ratio = 1\n+        const map2 = new ol.Map({\n+            target: 'map2',\n+            layers: [\n+                new ol.layer.Image({\n+                    source: createWMSSource()\n+                })\n+            ],\n+            view: createView(),\n+            pixelRatio: 1.0\n+        });\n+\n+        // Test 3: Even dimensions, non-integer pixel ratio\n+        const map3 = new ol.Map({\n+            target: 'map3',\n+            layers: [\n+                new ol.layer.Image({\n+                    source: createWMSSource()\n+                })\n+            ],\n+            view: createView(),\n+            pixelRatio: 1.5\n+        });\n+\n+        // Test 4: Odd dimensions, non-integer pixel ratio\n+        const map4 = new ol.Map({\n+            target: 'map4',\n+            layers: [\n+                new ol.layer.Image({\n+                    source: createWMSSource()\n+                })\n+            ],\n+            view: createView(),\n+            pixelRatio: 1.25\n+        });\n+\n+        // Log image dimensions for debugging\n+        function logImageDimensions(map, testName) {\n+            map.once('rendercomplete', function() {\n+                const layer = map.getLayers().getArray()[0];\n+                const source = layer.getSource();\n+                const view = map.getView();\n+                const extent = view.calculateExtent(map.getSize());\n+                const resolution = view.getResolution();\n+                const pixelRatio = map.getPixelRatio();\n+                \n+                console.log(`${testName}:`, {\n+                    mapSize: map.getSize(),\n+                    pixelRatio: pixelRatio,\n+                    extent: extent,\n+                    resolution: resolution\n+                });\n+            });\n+        }\n+\n+        logImageDimensions(map1, 'Test 1');\n+        logImageDimensions(map2, 'Test 2');\n+        logImageDimensions(map3, 'Test 3');\n+        logImageDimensions(map4, 'Test 4');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

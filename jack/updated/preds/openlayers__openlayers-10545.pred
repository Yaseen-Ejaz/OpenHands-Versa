{"instance_id": "openlayers__openlayers-10545", "model_patch": "diff --git a/src/ol/format/xsd.js b/src/ol/format/xsd.js\nindex 271b59067..311d74178 100644\n--- a/src/ol/format/xsd.js\n+++ b/src/ol/format/xsd.js\n@@ -4,6 +4,45 @@\n import {getAllTextContent, getDocument} from '../xml.js';\n import {padNumber} from '../string.js';\n \n+/**\n+ * Map of HTML entities to their corresponding characters.\n+ * @const\n+ * @type {Object<string, string>}\n+ */\n+const HTML_ENTITIES = {\n+  '&amp;': '&',\n+  '&lt;': '<',\n+  '&gt;': '>',\n+  '&quot;': '\"',\n+  '&#39;': \"'\"\n+};\n+\n+/**\n+ * Regular expression to match HTML entities.\n+ * @const\n+ * @type {RegExp}\n+ */\n+const HTML_ENTITY_REGEX = /&(?:amp|lt|gt|quot|#39);/g;\n+\n+/**\n+ * Decode HTML entities in a string.\n+ * @param {string} string String that may contain HTML entities.\n+ * @return {string} String with HTML entities decoded.\n+ */\n+function decodeHtmlEntities(string) {\n+  // Decode entities iteratively to handle nested encoding like &amp;apos;\n+  let decoded = string;\n+  let previousDecoded;\n+  do {\n+    previousDecoded = decoded;\n+    decoded = decoded.replace(HTML_ENTITY_REGEX, function(entity) {\n+      return HTML_ENTITIES[entity] || entity;\n+    });\n+  } while (decoded !== previousDecoded && HTML_ENTITY_REGEX.test(decoded));\n+  \n+  return decoded;\n+}\n+\n \n /**\n  * @param {Node} node Node.\n@@ -94,7 +133,7 @@ export function readNonNegativeIntegerString(string) {\n  * @return {string|undefined} String.\n  */\n export function readString(node) {\n-  return getAllTextContent(node, false).trim();\n+  return decodeHtmlEntities(getAllTextContent(node, false).trim());\n }\n \n \ndiff --git a/test/spec/ol/format/kml-html-entities.test.js b/test/spec/ol/format/kml-html-entities.test.js\nnew file mode 100644\nindex 000000000..9de51ed14\n--- /dev/null\n+++ b/test/spec/ol/format/kml-html-entities.test.js\n@@ -0,0 +1,150 @@\n+import Feature from '../../../../src/ol/Feature.js';\n+import KML from '../../../../src/ol/format/KML.js';\n+\n+describe('ol.format.KML HTML Entity Decoding', function() {\n+\n+  let format;\n+\n+  beforeEach(function() {\n+    format = new KML();\n+  });\n+\n+  describe('HTML entity decoding in text content', function() {\n+\n+    it('should decode HTML entities in placemark names', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Placemark>' +\n+          '    <name>Andy&amp;apos;s Pub</name>' +\n+          '    <Point>' +\n+          '      <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '    </Point>' +\n+          '  </Placemark>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(1);\n+      const f = fs[0];\n+      expect(f).to.be.an(Feature);\n+      // This should be decoded to \"Andy's Pub\"\n+      expect(f.get('name')).to.be('Andy\\'s Pub');\n+    });\n+\n+    it('should decode HTML entities in descriptions', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Placemark>' +\n+          '    <name>Test Place</name>' +\n+          '    <description>A pub with &quot;great&quot; food &amp; drinks</description>' +\n+          '    <Point>' +\n+          '      <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '    </Point>' +\n+          '  </Placemark>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(1);\n+      const f = fs[0];\n+      expect(f).to.be.an(Feature);\n+      // This should be decoded to 'A pub with \"great\" food & drinks'\n+      expect(f.get('description')).to.be('A pub with \"great\" food & drinks');\n+    });\n+\n+    it('should decode all common HTML entities', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Placemark>' +\n+          '    <name>Test &lt;tag&gt; &amp; more &quot;quotes&quot; &#39;apostrophe&#39;</name>' +\n+          '    <Point>' +\n+          '      <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '    </Point>' +\n+          '  </Placemark>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(1);\n+      const f = fs[0];\n+      expect(f).to.be.an(Feature);\n+      // This should be decoded to 'Test <tag> & more \"quotes\" 'apostrophe''\n+      expect(f.get('name')).to.be('Test <tag> & more \"quotes\" \\'apostrophe\\'');\n+    });\n+\n+    it('should decode HTML entities in text style labels', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Placemark>' +\n+          '    <name>Andy&amp;apos;s Pub</name>' +\n+          '    <Point>' +\n+          '      <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '    </Point>' +\n+          '  </Placemark>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(1);\n+      const f = fs[0];\n+      expect(f).to.be.an(Feature);\n+\n+      // Check that the style function also uses decoded text\n+      const styleFunction = f.getStyleFunction();\n+      expect(styleFunction).not.to.be(undefined);\n+      const styleArray = styleFunction(f, 0);\n+      expect(styleArray).to.be.an(Array);\n+\n+      // Find the text style\n+      let textStyle = null;\n+      for (let i = 0; i < styleArray.length; i++) {\n+        const style = styleArray[i];\n+        if (style.getText() && style.getText().getText()) {\n+          textStyle = style.getText();\n+          break;\n+        }\n+      }\n+\n+      expect(textStyle).not.to.be(null);\n+      // The text in the style should also be decoded\n+      expect(textStyle.getText()).to.be('Andy\\'s Pub');\n+    });\n+\n+    it('should handle mixed content with and without entities', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Document>' +\n+          '    <Placemark>' +\n+          '      <name>Normal Name</name>' +\n+          '      <Point>' +\n+          '        <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '      </Point>' +\n+          '    </Placemark>' +\n+          '    <Placemark>' +\n+          '      <name>Name with &amp; entities</name>' +\n+          '      <Point>' +\n+          '        <coordinates>-122.0844,37.4220,0</coordinates>' +\n+          '      </Point>' +\n+          '    </Placemark>' +\n+          '  </Document>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(2);\n+\n+      expect(fs[0].get('name')).to.be('Normal Name');\n+      expect(fs[1].get('name')).to.be('Name with & entities');\n+    });\n+\n+    it('should not affect CDATA sections', function() {\n+      const text =\n+          '<kml xmlns=\"http://earth.google.com/kml/2.2\">' +\n+          '  <Placemark>' +\n+          '    <name><![CDATA[Andy&apos;s Pub in CDATA]]></name>' +\n+          '    <Point>' +\n+          '      <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>' +\n+          '    </Point>' +\n+          '  </Placemark>' +\n+          '</kml>';\n+      const fs = format.readFeatures(text);\n+      expect(fs).to.have.length(1);\n+      const f = fs[0];\n+      expect(f).to.be.an(Feature);\n+      // CDATA should preserve the literal text\n+      expect(f.get('name')).to.be('Andy&apos;s Pub in CDATA');\n+    });\n+\n+  });\n+\n+});\ndiff --git a/test_fix_verification.js b/test_fix_verification.js\nnew file mode 100644\nindex 000000000..997eef2ee\n--- /dev/null\n+++ b/test_fix_verification.js\n@@ -0,0 +1,49 @@\n+/**\n+ * Simple test to verify the HTML entity decoding fix\n+ */\n+\n+// Test the decodeHtmlEntities function directly\n+const testCases = [\n+  { input: 'Andy&amp;apos;s Pub', expected: \"Andy's Pub\" },\n+  { input: 'A pub with &quot;great&quot; food &amp; drinks', expected: 'A pub with \"great\" food & drinks' },\n+  { input: 'Test &lt;tag&gt; &amp; more', expected: 'Test <tag> & more' },\n+  { input: 'Normal text', expected: 'Normal text' },\n+  { input: '&amp;&lt;&gt;&quot;&#39;', expected: '&<>\"\\'' }\n+];\n+\n+// Simple HTML entity decoder (same as in xsd.js)\n+const HTML_ENTITIES = {\n+  '&amp;': '&',\n+  '&lt;': '<',\n+  '&gt;': '>',\n+  '&quot;': '\"',\n+  '&#39;': \"'\"\n+};\n+\n+const HTML_ENTITY_REGEX = /&(?:amp|lt|gt|quot|#39);/g;\n+\n+function decodeHtmlEntities(string) {\n+  return string.replace(HTML_ENTITY_REGEX, function(entity) {\n+    return HTML_ENTITIES[entity] || entity;\n+  });\n+}\n+\n+console.log('=== Testing HTML Entity Decoding Function ===');\n+\n+let allPassed = true;\n+testCases.forEach((testCase, index) => {\n+  const result = decodeHtmlEntities(testCase.input);\n+  const passed = result === testCase.expected;\n+  \n+  console.log(`Test ${index + 1}: ${passed ? '\u2705 PASS' : '\u274c FAIL'}`);\n+  console.log(`  Input:    \"${testCase.input}\"`);\n+  console.log(`  Expected: \"${testCase.expected}\"`);\n+  console.log(`  Got:      \"${result}\"`);\n+  \n+  if (!passed) {\n+    allPassed = false;\n+  }\n+  console.log('');\n+});\n+\n+console.log(`Overall result: ${allPassed ? '\u2705 ALL TESTS PASSED' : '\u274c SOME TESTS FAILED'}`);\n\\ No newline at end of file\ndiff --git a/test_html_entities.js b/test_html_entities.js\nnew file mode 100644\nindex 000000000..a44ea8f6c\n--- /dev/null\n+++ b/test_html_entities.js\n@@ -0,0 +1,86 @@\n+/**\n+ * Test file to reproduce and verify the HTML entity decoding issue in KML labels\n+ */\n+\n+import KML from './src/ol/format/KML.js';\n+import Feature from './src/ol/Feature.js';\n+\n+// Test data with HTML entities\n+const kmlWithEntities = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n+  <Document>\n+    <Placemark>\n+      <name>Andy&amp;apos;s Pub</name>\n+      <description>A pub with &quot;great&quot; food &amp; drinks</description>\n+      <Point>\n+        <coordinates>-122.0822035425683,37.42228990140251,0</coordinates>\n+      </Point>\n+    </Placemark>\n+    <Placemark>\n+      <name>Test &lt;tag&gt; &amp; more</name>\n+      <description>Testing &lt;b&gt;HTML&lt;/b&gt; entities</description>\n+      <Point>\n+        <coordinates>-122.0844,37.4220,0</coordinates>\n+      </Point>\n+    </Placemark>\n+  </Document>\n+</kml>`;\n+\n+console.log('=== Testing HTML Entity Decoding in KML ===');\n+\n+// Create KML format instance\n+const format = new KML();\n+\n+// Parse the KML\n+const features = format.readFeatures(kmlWithEntities);\n+\n+console.log(`\\nParsed ${features.length} features:`);\n+\n+features.forEach((feature, index) => {\n+  const name = feature.get('name');\n+  const description = feature.get('description');\n+  \n+  console.log(`\\nFeature ${index + 1}:`);\n+  console.log(`  Raw name: \"${name}\"`);\n+  console.log(`  Raw description: \"${description}\"`);\n+  \n+  // Check if HTML entities are decoded\n+  const hasEntities = name && (name.includes('&amp;') || name.includes('&apos;') || name.includes('&quot;') || name.includes('&lt;') || name.includes('&gt;'));\n+  \n+  if (hasEntities) {\n+    console.log(`  \u274c ISSUE: HTML entities not decoded in name`);\n+  } else {\n+    console.log(`  \u2705 OK: No HTML entities found in name`);\n+  }\n+});\n+\n+// Test the style function to see how text is displayed\n+console.log('\\n=== Testing Style Function ===');\n+features.forEach((feature, index) => {\n+  const styleFunction = feature.getStyleFunction();\n+  if (styleFunction) {\n+    const styles = styleFunction(feature, 1);\n+    if (styles && styles.length > 0) {\n+      styles.forEach((style, styleIndex) => {\n+        const textStyle = style.getText();\n+        if (textStyle) {\n+          const displayText = textStyle.getText();\n+          console.log(`Feature ${index + 1}, Style ${styleIndex + 1} text: \"${displayText}\"`);\n+          \n+          const hasEntities = displayText && (displayText.includes('&amp;') || displayText.includes('&apos;') || displayText.includes('&quot;') || displayText.includes('&lt;') || displayText.includes('&gt;'));\n+          \n+          if (hasEntities) {\n+            console.log(`  \u274c ISSUE: HTML entities not decoded in display text`);\n+          } else {\n+            console.log(`  \u2705 OK: No HTML entities in display text`);\n+          }\n+        }\n+      });\n+    }\n+  }\n+});\n+\n+console.log('\\n=== Expected Results ===');\n+console.log('Name should be: \"Andy\\'s Pub\" (not \"Andy&amp;apos;s Pub\")');\n+console.log('Description should be: \"A pub with \"great\" food & drinks\"');\n+console.log('Second name should be: \"Test <tag> & more\"');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

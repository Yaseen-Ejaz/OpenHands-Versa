{"instance_id": "openlayers__openlayers-11377", "model_patch": "diff --git a/simple_test.html b/simple_test.html\nnew file mode 100644\nindex 000000000..7f2d084a6\n--- /dev/null\n+++ b/simple_test.html\n@@ -0,0 +1,48 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Performance Test</title>\n+    <style>\n+        .map { height: 400px; width: 100%; }\n+        #info { font-family: monospace; margin: 10px 0; }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"info\">\n+        <div>Events: <span id=\"count\">0</span></div>\n+        <div>Avg time: <span id=\"time\">0</span>ms</div>\n+    </div>\n+    <div id=\"map\" class=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [new TileLayer({ source: new OSM() })],\n+            view: new View({ center: [0, 0], zoom: 2 })\n+        });\n+\n+        let count = 0, totalTime = 0;\n+        const countEl = document.getElementById('count');\n+        const timeEl = document.getElementById('time');\n+\n+        map.on('pointermove', function(event) {\n+            const start = performance.now();\n+            // Access pixel and coordinate to trigger calculations\n+            const pixel = event.pixel;\n+            const coord = event.coordinate;\n+            const end = performance.now();\n+            \n+            count++;\n+            totalTime += (end - start);\n+            \n+            countEl.textContent = count;\n+            timeEl.textContent = (totalTime / count).toFixed(3);\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/src/ol/MapBrowserEventHandler.js b/src/ol/MapBrowserEventHandler.js\nindex dd950f048..31304577a 100644\n--- a/src/ol/MapBrowserEventHandler.js\n+++ b/src/ol/MapBrowserEventHandler.js\n@@ -318,9 +318,24 @@ class MapBrowserEventHandler extends EventTarget {\n   relayEvent_(pointerEvent) {\n     this.originalPointerMoveEvent_ = pointerEvent;\n     const dragging = !!(this.down_ && this.isMoving_(pointerEvent));\n-    this.dispatchEvent(\n-      new MapBrowserEvent(pointerEvent.type, this.map_, pointerEvent, dragging)\n+    const mapBrowserEvent = new MapBrowserEvent(\n+      pointerEvent.type,\n+      this.map_,\n+      pointerEvent,\n+      dragging\n     );\n+\n+    // Pre-calculate pixel for pointermove events to avoid repeated getBoundingClientRect calls\n+    if (pointerEvent.type === 'pointermove') {\n+      const viewportPosition = this.element_.getBoundingClientRect();\n+      const eventPosition = pointerEvent;\n+      mapBrowserEvent.pixel_ = [\n+        eventPosition.clientX - viewportPosition.left,\n+        eventPosition.clientY - viewportPosition.top,\n+      ];\n+    }\n+\n+    this.dispatchEvent(mapBrowserEvent);\n   }\n \n   /**\ndiff --git a/test_performance_issue.html b/test_performance_issue.html\nnew file mode 100644\nindex 000000000..c3341fd69\n--- /dev/null\n+++ b/test_performance_issue.html\n@@ -0,0 +1,111 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <title>Performance Test - Pointermove Events</title>\n+    <script src=\"https://unpkg.com/@openlayers/pepjs\"></script>\n+    <style>\n+        .map {\n+            height: 400px;\n+            width: 100%;\n+        }\n+        #performance-info {\n+            margin: 10px 0;\n+            font-family: monospace;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"performance-info\">\n+        <div>Move your mouse over the map to test performance</div>\n+        <div>Event count: <span id=\"event-count\">0</span></div>\n+        <div>Average time per event: <span id=\"avg-time\">0</span>ms</div>\n+        <div>Total time: <span id=\"total-time\">0</span>ms</div>\n+    </div>\n+    <div id=\"map\" class=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {Style, Circle, Fill, Stroke} from './src/ol/style.js';\n+\n+        // Create 1000 features with non-cached styles (performance issue scenario)\n+        const features = [];\n+        for (let i = 0; i < 1000; i++) {\n+            const feature = new Feature({\n+                geometry: new Point([\n+                    Math.random() * 360 - 180,\n+                    Math.random() * 180 - 90\n+                ])\n+            });\n+            \n+            // Non-cached style - creates new style object each time\n+            feature.setStyle(function() {\n+                return new Style({\n+                    image: new Circle({\n+                        radius: 5,\n+                        fill: new Fill({color: 'red'}),\n+                        stroke: new Stroke({color: 'black', width: 1})\n+                    })\n+                });\n+            });\n+            \n+            features.push(feature);\n+        }\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                vectorLayer\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2\n+            })\n+        });\n+\n+        // Performance monitoring\n+        let eventCount = 0;\n+        let totalTime = 0;\n+        const eventCountEl = document.getElementById('event-count');\n+        const avgTimeEl = document.getElementById('avg-time');\n+        const totalTimeEl = document.getElementById('total-time');\n+\n+        map.on('pointermove', function(event) {\n+            const startTime = performance.now();\n+            \n+            // This is what causes the performance issue - accessing pixel and coordinate\n+            // triggers expensive calculations in MapBrowserEvent\n+            const pixel = event.pixel;\n+            const coordinate = event.coordinate;\n+            \n+            const endTime = performance.now();\n+            const eventTime = endTime - startTime;\n+            \n+            eventCount++;\n+            totalTime += eventTime;\n+            \n+            // Update performance display\n+            eventCountEl.textContent = eventCount;\n+            avgTimeEl.textContent = (totalTime / eventCount).toFixed(3);\n+            totalTimeEl.textContent = totalTime.toFixed(3);\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/geom/Geometry.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/geom/flat/transform.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/geom/flat/reverse.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/ImageState.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/geom/flat/segments.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/reproj/Triangulation.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/Image.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/reproj.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/reproj/common.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/ImageBase.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 13:22:59] \"GET /src/ol/render/Box.js HTTP/1.1\" 304 -\ndiff --git a/test_5_band_comparison.html b/test_5_band_comparison.html\nnew file mode 100644\nindex 000000000..68bda1f89\n--- /dev/null\n+++ b/test_5_band_comparison.html\n@@ -0,0 +1,83 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>5-Band DataTile Alpha Channel Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>5-Band DataTile Alpha Channel Test (Comparison)</h1>\n+    <div class=\"info\">\n+        <p>This test demonstrates 5-band behavior for comparison with the 6-band issue.</p>\n+        <p>Expected: Semi-transparent red squares with varying alpha values</p>\n+        <p>5 bands should work correctly (odd band count)</p>\n+    </div>\n+    <div id=\"map\"></div>\n+    \n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import DataTile from './src/ol/source/DataTile.js';\n+        import TileLayer from './src/ol/layer/WebGLTile.js';\n+\n+        const size = [256, 256];\n+        \n+        // Create a test with 5 bands: R, G, B, Band4, Alpha\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new DataTile({\n+                        tileSize: size,\n+                        bandCount: 5,\n+                        loader: function (z, x, y) {\n+                            const pixelCount = size[0] * size[1];\n+                            const data = new Uint8Array(pixelCount * 5);\n+                            \n+                            for (let i = 0; i < pixelCount; i++) {\n+                                const baseIndex = i * 5;\n+                                const row = Math.floor(i / size[0]);\n+                                const col = i % size[0];\n+                                \n+                                // Create a pattern with varying alpha\n+                                const alpha = Math.floor((col / size[0]) * 255);\n+                                \n+                                data[baseIndex] = 255;     // Red (band 1)\n+                                data[baseIndex + 1] = 0;   // Green (band 2)  \n+                                data[baseIndex + 2] = 0;   // Blue (band 3)\n+                                data[baseIndex + 3] = 100; // Band 4\n+                                data[baseIndex + 4] = alpha; // Alpha (band 5)\n+                            }\n+                            \n+                            return data;\n+                        },\n+                    }),\n+                    style: {\n+                        // Use RGBA with alpha from band 5\n+                        color: ['color', ['band', 1], ['band', 2], ['band', 3], ['/', ['band', 5], 255]]\n+                    },\n+                }),\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2,\n+            }),\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_6_band_issue.html b/test_6_band_issue.html\nnew file mode 100644\nindex 000000000..bc99fc371\n--- /dev/null\n+++ b/test_6_band_issue.html\n@@ -0,0 +1,84 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>6-Band DataTile Alpha Channel Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #ccc;\n+        }\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .info {\n+            margin: 10px 0;\n+            padding: 10px;\n+            background: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>6-Band DataTile Alpha Channel Test</h1>\n+    <div class=\"info\">\n+        <p>This test demonstrates the issue with even bandCount (6 bands) where the alpha channel doesn't work correctly.</p>\n+        <p>Expected: Semi-transparent red squares with varying alpha values</p>\n+        <p>Issue: Alpha channel is not properly handled for even band counts</p>\n+    </div>\n+    <div id=\"map\"></div>\n+    \n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import DataTile from './src/ol/source/DataTile.js';\n+        import TileLayer from './src/ol/layer/WebGLTile.js';\n+\n+        const size = [256, 256];\n+        \n+        // Create a test with 6 bands: R, G, B, Band4, Band5, Alpha\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new DataTile({\n+                        tileSize: size,\n+                        bandCount: 6,\n+                        loader: function (z, x, y) {\n+                            const pixelCount = size[0] * size[1];\n+                            const data = new Uint8Array(pixelCount * 6);\n+                            \n+                            for (let i = 0; i < pixelCount; i++) {\n+                                const baseIndex = i * 6;\n+                                const row = Math.floor(i / size[0]);\n+                                const col = i % size[0];\n+                                \n+                                // Create a pattern with varying alpha\n+                                const alpha = Math.floor((col / size[0]) * 255);\n+                                \n+                                data[baseIndex] = 255;     // Red (band 1)\n+                                data[baseIndex + 1] = 0;   // Green (band 2)  \n+                                data[baseIndex + 2] = 0;   // Blue (band 3)\n+                                data[baseIndex + 3] = 100; // Band 4\n+                                data[baseIndex + 4] = 150; // Band 5\n+                                data[baseIndex + 5] = alpha; // Alpha (band 6)\n+                            }\n+                            \n+                            return data;\n+                        },\n+                    }),\n+                    style: {\n+                        // Use RGBA with alpha from band 6\n+                        color: ['color', ['band', 1], ['band', 2], ['band', 3], ['/', ['band', 6], 255]]\n+                    },\n+                }),\n+            ],\n+            view: new View({\n+                center: [0, 0],\n+                zoom: 2,\n+            }),\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

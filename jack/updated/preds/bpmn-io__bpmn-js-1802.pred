{"instance_id": "bpmn-io__bpmn-js-1802", "model_patch": "diff --git a/lib/features/context-pad/ContextPadProvider.js b/lib/features/context-pad/ContextPadProvider.js\nindex c5cf2b15..d78396c1 100644\n--- a/lib/features/context-pad/ContextPadProvider.js\n+++ b/lib/features/context-pad/ContextPadProvider.js\n@@ -375,6 +375,35 @@ ContextPadProvider.prototype.getContextPadEntries = function(element) {\n     }\n   }\n \n+  // Add \"append anything\" entry for FlowNodes that can have successors\n+  if (is(businessObject, 'bpmn:FlowNode') && \n+      !is(businessObject, 'bpmn:EndEvent') &&\n+      !businessObject.isForCompensation &&\n+      !isEventType(businessObject, 'bpmn:IntermediateThrowEvent', 'bpmn:LinkEventDefinition') &&\n+      !isEventSubProcess(businessObject)) {\n+\n+    assign(actions, {\n+      'append.append-anything': {\n+        group: 'model',\n+        className: 'bpmn-icon-gateway-none',\n+        title: translate('Append anything'),\n+        action: {\n+          click: function(event, element) {\n+            var position = assign(getReplaceMenuPosition(element), {\n+              cursor: { x: event.x, y: event.y }\n+            });\n+\n+            popupMenu.open(element, 'bpmn-append', position, {\n+              title: translate('Append element'),\n+              width: 300,\n+              search: true\n+            });\n+          }\n+        }\n+      }\n+    });\n+  }\n+\n   if (!popupMenu.isEmpty(element, 'bpmn-replace')) {\n \n     // Replace menu entry\ndiff --git a/lib/features/popup-menu/AppendMenuProvider.js b/lib/features/popup-menu/AppendMenuProvider.js\nnew file mode 100644\nindex 00000000..e57d88fa\n--- /dev/null\n+++ b/lib/features/popup-menu/AppendMenuProvider.js\n@@ -0,0 +1,142 @@\n+import {\n+  assign,\n+  forEach\n+} from 'min-dash';\n+\n+import * as replaceOptions from '../replace/ReplaceOptions';\n+\n+/**\n+ * This module provides an append menu for the context pad that shows all available BPMN elements.\n+ */\n+export default function AppendMenuProvider(\n+    elementFactory, create, translate, popupMenu, injector) {\n+\n+  this._elementFactory = elementFactory;\n+  this._create = create;\n+  this._translate = translate;\n+  this._popupMenu = popupMenu;\n+  \n+  // autoPlace is optional\n+  this._autoPlace = injector.get('autoPlace', false);\n+\n+  this.register();\n+}\n+\n+AppendMenuProvider.$inject = [\n+  'elementFactory',\n+  'create',\n+  'translate',\n+  'popupMenu',\n+  'injector'\n+];\n+\n+/**\n+ * Register append menu provider in the popup menu\n+ */\n+AppendMenuProvider.prototype.register = function() {\n+  this._popupMenu.registerProvider('bpmn-append', this);\n+};\n+\n+/**\n+ * Get all entries for the append menu\n+ *\n+ * @param {djs.model.Base} element\n+ *\n+ * @return {Array<Object>} a list of menu entry items\n+ */\n+AppendMenuProvider.prototype.getEntries = function(element) {\n+  var elementFactory = this._elementFactory,\n+      create = this._create,\n+      autoPlace = this._autoPlace,\n+      translate = this._translate;\n+\n+  var entries = [];\n+\n+  // Helper function to create append action\n+  function createAppendAction(type, className, title, options) {\n+    options = options || {};\n+\n+    function appendStart(event, element) {\n+      var shape = elementFactory.createShape(assign({ type: type }, options));\n+      create.start(event, shape, {\n+        source: element\n+      });\n+    }\n+\n+    var append = autoPlace ? function(event, element) {\n+      var shape = elementFactory.createShape(assign({ type: type }, options));\n+      autoPlace.append(element, shape);\n+    } : appendStart;\n+\n+    return {\n+      label: translate(title),\n+      className: className,\n+      action: append\n+    };\n+  }\n+\n+  // Add all task types\n+  entries = entries.concat([\n+    createAppendAction('bpmn:Task', 'bpmn-icon-task', 'Task'),\n+    createAppendAction('bpmn:SendTask', 'bpmn-icon-send', 'Send Task'),\n+    createAppendAction('bpmn:ReceiveTask', 'bpmn-icon-receive', 'Receive Task'),\n+    createAppendAction('bpmn:UserTask', 'bpmn-icon-user', 'User Task'),\n+    createAppendAction('bpmn:ManualTask', 'bpmn-icon-manual', 'Manual Task'),\n+    createAppendAction('bpmn:BusinessRuleTask', 'bpmn-icon-business-rule', 'Business Rule Task'),\n+    createAppendAction('bpmn:ServiceTask', 'bpmn-icon-service', 'Service Task'),\n+    createAppendAction('bpmn:ScriptTask', 'bpmn-icon-script', 'Script Task'),\n+    createAppendAction('bpmn:CallActivity', 'bpmn-icon-call-activity', 'Call Activity')\n+  ]);\n+\n+  // Add events\n+  entries = entries.concat([\n+    createAppendAction('bpmn:StartEvent', 'bpmn-icon-start-event-none', 'Start Event'),\n+    createAppendAction('bpmn:IntermediateThrowEvent', 'bpmn-icon-intermediate-event-none', 'Intermediate Throw Event'),\n+    createAppendAction('bpmn:IntermediateCatchEvent', 'bpmn-icon-intermediate-event-catch-message', 'Intermediate Catch Event', {\n+      eventDefinitionType: 'bpmn:MessageEventDefinition'\n+    }),\n+    createAppendAction('bpmn:EndEvent', 'bpmn-icon-end-event-none', 'End Event')\n+  ]);\n+\n+  // Add gateways\n+  entries = entries.concat([\n+    createAppendAction('bpmn:ExclusiveGateway', 'bpmn-icon-gateway-xor', 'Exclusive Gateway'),\n+    createAppendAction('bpmn:ParallelGateway', 'bpmn-icon-gateway-parallel', 'Parallel Gateway'),\n+    createAppendAction('bpmn:InclusiveGateway', 'bpmn-icon-gateway-or', 'Inclusive Gateway'),\n+    createAppendAction('bpmn:ComplexGateway', 'bpmn-icon-gateway-complex', 'Complex Gateway'),\n+    createAppendAction('bpmn:EventBasedGateway', 'bpmn-icon-gateway-eventbased', 'Event Based Gateway', {\n+      instantiate: false,\n+      eventGatewayType: 'Exclusive'\n+    })\n+  ]);\n+\n+  // Add subprocess\n+  entries = entries.concat([\n+    createAppendAction('bpmn:SubProcess', 'bpmn-icon-subprocess-expanded', 'Sub Process (expanded)', {\n+      isExpanded: true\n+    }),\n+    createAppendAction('bpmn:SubProcess', 'bpmn-icon-subprocess-collapsed', 'Sub Process (collapsed)', {\n+      isExpanded: false\n+    })\n+  ]);\n+\n+  // Add data objects\n+  entries = entries.concat([\n+    createAppendAction('bpmn:DataObjectReference', 'bpmn-icon-data-object', 'Data Object Reference'),\n+    createAppendAction('bpmn:DataStoreReference', 'bpmn-icon-data-store', 'Data Store Reference')\n+  ]);\n+\n+  // Add text annotation\n+  entries.push(\n+    createAppendAction('bpmn:TextAnnotation', 'bpmn-icon-text-annotation', 'Text Annotation')\n+  );\n+\n+  return entries;\n+};\n+\n+/**\n+ * Get header entries (empty for append menu)\n+ */\n+AppendMenuProvider.prototype.getHeaderEntries = function() {\n+  return [];\n+};\n\\ No newline at end of file\ndiff --git a/lib/features/popup-menu/index.js b/lib/features/popup-menu/index.js\nindex decb9b5c..929ae66a 100644\n--- a/lib/features/popup-menu/index.js\n+++ b/lib/features/popup-menu/index.js\n@@ -2,6 +2,7 @@ import PopupMenuModule from 'diagram-js/lib/features/popup-menu';\n import ReplaceModule from '../replace';\n \n import ReplaceMenuProvider from './ReplaceMenuProvider';\n+import AppendMenuProvider from './AppendMenuProvider';\n \n \n export default {\n@@ -9,6 +10,7 @@ export default {\n     PopupMenuModule,\n     ReplaceModule\n   ],\n-  __init__: [ 'replaceMenuProvider' ],\n-  replaceMenuProvider: [ 'type', ReplaceMenuProvider ]\n+  __init__: [ 'replaceMenuProvider', 'appendMenuProvider' ],\n+  replaceMenuProvider: [ 'type', ReplaceMenuProvider ],\n+  appendMenuProvider: [ 'type', AppendMenuProvider ]\n };\n\\ No newline at end of file\ndiff --git a/test-append-anything.html b/test-append-anything.html\nnew file mode 100644\nindex 00000000..3d215301\n--- /dev/null\n+++ b/test-append-anything.html\n@@ -0,0 +1,100 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>BPMN.js - Append Anything Test</title>\n+  <meta charset=\"UTF-8\" />\n+  <link rel=\"stylesheet\" href=\"https://unpkg.com/bpmn-js@latest/dist/assets/diagram-js.css\" />\n+  <link rel=\"stylesheet\" href=\"https://unpkg.com/bpmn-js@latest/dist/assets/bpmn-font/css/bpmn.css\" />\n+  <style>\n+    body {\n+      font-family: Arial, sans-serif;\n+      margin: 0;\n+      padding: 20px;\n+    }\n+    \n+    #canvas {\n+      width: 100%;\n+      height: 600px;\n+      border: 1px solid #ccc;\n+    }\n+    \n+    .info {\n+      margin-bottom: 20px;\n+      padding: 10px;\n+      background: #f5f5f5;\n+      border-radius: 4px;\n+    }\n+  </style>\n+</head>\n+<body>\n+  <div class=\"info\">\n+    <h2>BPMN.js Append Anything Feature Test</h2>\n+    <p>Instructions:</p>\n+    <ol>\n+      <li>Click on any element in the diagram</li>\n+      <li>Look for the \"append anything\" button in the context pad</li>\n+      <li>Click it to see the menu with all available BPMN elements</li>\n+      <li>Select an element to append it</li>\n+    </ol>\n+  </div>\n+  \n+  <div id=\"canvas\"></div>\n+\n+  <script src=\"./dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    // Simple BPMN diagram for testing\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\" exporter=\"Camunda Modeler\" exporterVersion=\"1.16.0\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"true\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Sample Task\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"_BPMNShape_StartEvent_2\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"179\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"265\" y=\"77\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"415\" y=\"99\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"215\" y=\"117\" />\n+        <di:waypoint x=\"265\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"365\" y=\"117\" />\n+        <di:waypoint x=\"415\" y=\"117\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    // Initialize BPMN modeler\n+    var modeler = new BpmnJS({\n+      container: '#canvas'\n+    });\n+\n+    modeler.importXML(xml, function(err) {\n+      if (err) {\n+        console.error('Error importing BPMN diagram:', err);\n+      } else {\n+        console.log('BPMN diagram loaded successfully');\n+        console.log('Click on elements to test the context pad');\n+      }\n+    });\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test/spec/features/context-pad/AppendAnythingSpec.js b/test/spec/features/context-pad/AppendAnythingSpec.js\nnew file mode 100644\nindex 00000000..f296a713\n--- /dev/null\n+++ b/test/spec/features/context-pad/AppendAnythingSpec.js\n@@ -0,0 +1,156 @@\n+import {\n+  bootstrapModeler,\n+  getBpmnJS,\n+  inject\n+} from 'test/TestHelper';\n+\n+import TestContainer from 'mocha-test-container-support';\n+\n+import {\n+  query as domQuery,\n+  queryAll as domQueryAll\n+} from 'min-dom';\n+\n+import {\n+  is\n+} from 'lib/util/ModelUtil';\n+\n+import {\n+  createCanvasEvent as canvasEvent\n+} from '../../../util/MockEvents';\n+\n+import contextPadModule from 'lib/features/context-pad';\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceMenuModule from 'lib/features/popup-menu';\n+import createModule from 'diagram-js/lib/features/create';\n+import customRulesModule from '../../../util/custom-rules';\n+import autoPlaceModule from 'lib/features/auto-place';\n+\n+describe('features - context-pad - append anything', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    contextPadModule,\n+    replaceMenuModule,\n+    customRulesModule,\n+    createModule\n+  ];\n+\n+  describe('append anything entry', function() {\n+\n+    var diagramXML = require('../../../fixtures/bpmn/simple.bpmn');\n+\n+    beforeEach(bootstrapModeler(diagramXML, { modules: testModules }));\n+\n+    function expectContextPadEntries(elementOrId, expectedEntries) {\n+      getBpmnJS().invoke(function(elementRegistry, contextPad) {\n+        var element = typeof elementOrId === 'string' ? elementRegistry.get(elementOrId) : elementOrId;\n+        contextPad.open(element, true);\n+        var entries = contextPad._current.entries;\n+\n+        expectedEntries.forEach(function(name) {\n+          if (name.charAt(0) === '!') {\n+            name = name.substring(1);\n+            expect(entries).not.to.have.property(name);\n+          } else {\n+            expect(entries).to.have.property(name);\n+          }\n+        });\n+      });\n+    }\n+\n+    function padEntry(element, entryId) {\n+      return domQuery('[data-action=\"' + entryId + '\"]', element);\n+    }\n+\n+    function getPopupMenu() {\n+      return domQuery('.djs-popup', TestContainer.get(getBpmnJS()));\n+    }\n+\n+    it('should provide append-anything entry for Task', inject(function() {\n+      expectContextPadEntries('Task_1', [\n+        'append.append-anything'\n+      ]);\n+    }));\n+\n+    it('should provide append-anything entry for StartEvent', inject(function() {\n+      expectContextPadEntries('StartEvent_1', [\n+        'append.append-anything'\n+      ]);\n+    }));\n+\n+    it('should provide append-anything entry for Gateway', inject(function() {\n+      expectContextPadEntries('ExclusiveGateway_1', [\n+        'append.append-anything'\n+      ]);\n+    }));\n+\n+    it('should NOT provide append-anything entry for EndEvent', inject(function() {\n+      expectContextPadEntries('EndEvent_1', [\n+        '!append.append-anything'\n+      ]);\n+    }));\n+\n+    it('should open append menu when clicked', inject(function(elementRegistry, contextPad) {\n+      // given\n+      var element = elementRegistry.get('Task_1');\n+      contextPad.open(element);\n+\n+      // when\n+      contextPad.trigger('click', padEvent(element, 'append.append-anything'));\n+\n+      // then\n+      var popupMenu = getPopupMenu();\n+      expect(popupMenu).to.exist;\n+    }));\n+\n+    it('should show all available BPMN elements in append menu', inject(function(elementRegistry, contextPad) {\n+      // given\n+      var element = elementRegistry.get('Task_1');\n+      contextPad.open(element);\n+\n+      // when\n+      contextPad.trigger('click', padEvent(element, 'append.append-anything'));\n+\n+      // then\n+      var popupMenu = getPopupMenu();\n+      var menuEntries = domQueryAll('.entry', popupMenu);\n+      \n+      // Should have entries for tasks, events, gateways, etc.\n+      expect(menuEntries.length).to.be.greaterThan(10);\n+    }));\n+\n+    it('should create element when menu item is clicked', inject(function(elementRegistry, contextPad, modeling) {\n+      // given\n+      var element = elementRegistry.get('Task_1');\n+      var initialElementCount = elementRegistry.getAll().length;\n+      \n+      contextPad.open(element);\n+      contextPad.trigger('click', padEvent(element, 'append.append-anything'));\n+\n+      var popupMenu = getPopupMenu();\n+      var taskEntry = domQuery('[data-id*=\"task\"]', popupMenu);\n+\n+      // when\n+      if (taskEntry) {\n+        taskEntry.click();\n+      }\n+\n+      // then\n+      var finalElementCount = elementRegistry.getAll().length;\n+      expect(finalElementCount).to.be.greaterThan(initialElementCount);\n+    }));\n+\n+  });\n+\n+});\n+\n+function padEvent(target, entry) {\n+  return getBpmnJS().invoke(function(contextPad) {\n+    var pad = contextPad.getPad(target).html;\n+    var node = domQuery('[data-action=\"' + entry + '\"]', pad);\n+    return { target: node, preventDefault: function() {}, stopPropagation: function() {} };\n+  });\n+}\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

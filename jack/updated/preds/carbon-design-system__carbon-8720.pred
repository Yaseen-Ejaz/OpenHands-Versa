{"instance_id": "carbon-design-system__carbon-8720", "model_patch": "diff --git a/packages/components/src/globals/scss/styles.scss b/packages/components/src/globals/scss/styles.scss\nindex c082b4cf6..e3d94d5a9 100644\n--- a/packages/components/src/globals/scss/styles.scss\n+++ b/packages/components/src/globals/scss/styles.scss\n@@ -143,6 +143,7 @@ $deprecations--message: 'Deprecated code was found, this code will be removed be\n @import '../../components/overflow-menu/overflow-menu';\n @import '../../components/pagination-nav/pagination-nav';\n @import '../../components/pagination/pagination';\n+@import '../../components/progress-bar/progress-bar';\n @import '../../components/progress-indicator/progress-indicator';\n @import '../../components/radio-button/radio-button';\n @import '../../components/search/search';\ndiff --git a/packages/react/src/components/ProgressBar/ProgressBar-story.js b/packages/react/src/components/ProgressBar/ProgressBar-story.js\nnew file mode 100644\nindex 000000000..a99bd4add\n--- /dev/null\n+++ b/packages/react/src/components/ProgressBar/ProgressBar-story.js\n@@ -0,0 +1,132 @@\n+/**\n+ * Copyright IBM Corp. 2019\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import React from 'react';\n+import { action } from '@storybook/addon-actions';\n+import { withKnobs, boolean, number, select, text } from '@storybook/addon-knobs';\n+import ProgressBar from '../ProgressBar';\n+\n+const sizes = {\n+  'Small (sm)': 'sm',\n+  'Default': undefined,\n+  'Large (lg)': 'lg',\n+};\n+\n+const statuses = {\n+  'None': undefined,\n+  'Success': 'success',\n+  'Error': 'error',\n+  'Warning': 'warning',\n+};\n+\n+const props = () => ({\n+  value: number('Progress value (value)', 50, { min: 0, max: 100 }),\n+  max: number('Maximum value (max)', 100, { min: 1 }),\n+  labelText: text('Label text (labelText)', 'Loading files...'),\n+  helperText: text('Helper text (helperText)', '2 minutes remaining'),\n+  showPercentage: boolean('Show percentage (showPercentage)', true),\n+  size: select('Size (size)', sizes, undefined),\n+  status: select('Status (status)', statuses, undefined),\n+  indeterminate: boolean('Indeterminate (indeterminate)', false),\n+  className: text('Custom className (className)', ''),\n+});\n+\n+export default {\n+  title: 'Components/ProgressBar',\n+  decorators: [withKnobs],\n+  parameters: {\n+    component: ProgressBar,\n+  },\n+};\n+\n+export const _Default = () => {\n+  return <ProgressBar value={50} max={100} />;\n+};\n+\n+_Default.story = {\n+  name: 'ProgressBar',\n+};\n+\n+export const WithLabel = () => {\n+  return (\n+    <ProgressBar \n+      value={75} \n+      max={100} \n+      labelText=\"Installing packages\" \n+      showPercentage \n+    />\n+  );\n+};\n+\n+export const WithHelperText = () => {\n+  return (\n+    <ProgressBar \n+      value={60} \n+      max={100} \n+      labelText=\"Downloading files\" \n+      helperText=\"2 minutes remaining \u2022 206 MB/s\"\n+      showPercentage \n+    />\n+  );\n+};\n+\n+export const Sizes = () => {\n+  return (\n+    <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>\n+      <div>\n+        <h4>Small</h4>\n+        <ProgressBar value={40} max={100} size=\"sm\" showPercentage />\n+      </div>\n+      <div>\n+        <h4>Default</h4>\n+        <ProgressBar value={60} max={100} showPercentage />\n+      </div>\n+      <div>\n+        <h4>Large</h4>\n+        <ProgressBar value={80} max={100} size=\"lg\" showPercentage />\n+      </div>\n+    </div>\n+  );\n+};\n+\n+export const StatusVariants = () => {\n+  return (\n+    <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>\n+      <div>\n+        <h4>Default</h4>\n+        <ProgressBar value={50} max={100} labelText=\"In progress\" showPercentage />\n+      </div>\n+      <div>\n+        <h4>Success</h4>\n+        <ProgressBar value={100} max={100} status=\"success\" labelText=\"Complete\" showPercentage />\n+      </div>\n+      <div>\n+        <h4>Error</h4>\n+        <ProgressBar value={30} max={100} status=\"error\" labelText=\"Failed\" showPercentage />\n+      </div>\n+      <div>\n+        <h4>Warning</h4>\n+        <ProgressBar value={75} max={100} status=\"warning\" labelText=\"Warning\" showPercentage />\n+      </div>\n+    </div>\n+  );\n+};\n+\n+export const Indeterminate = () => {\n+  return (\n+    <ProgressBar \n+      indeterminate \n+      labelText=\"Processing...\" \n+      helperText=\"Please wait while we process your request\"\n+    />\n+  );\n+};\n+\n+export const Playground = () => {\n+  const knobProps = props();\n+  return <ProgressBar {...knobProps} />;\n+};\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ProgressBar/ProgressBar-test.js b/packages/react/src/components/ProgressBar/ProgressBar-test.js\nnew file mode 100644\nindex 000000000..a9c12c13b\n--- /dev/null\n+++ b/packages/react/src/components/ProgressBar/ProgressBar-test.js\n@@ -0,0 +1,220 @@\n+/**\n+ * Copyright IBM Corp. 2019\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import React from 'react';\n+import ProgressBar from '../ProgressBar';\n+import { shallow, mount } from 'enzyme';\n+import { settings } from 'carbon-components';\n+import { cleanup, render, screen } from '@testing-library/react';\n+import '@testing-library/jest-dom';\n+\n+const { prefix } = settings;\n+\n+describe('ProgressBar', () => {\n+  describe('Renders common props as expected', () => {\n+    const wrapper = shallow(\n+      <ProgressBar \n+        value={50} \n+        max={100} \n+        className=\"extra-class\"\n+        label=\"Progress: 50%\"\n+      />\n+    );\n+\n+    it('renders with correct className', () => {\n+      expect(wrapper.hasClass(`${prefix}--progress-bar-container`)).toBe(true);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.hasClass(`${prefix}--progress-bar`)).toBe(true);\n+      expect(progressElement.hasClass('extra-class')).toBe(true);\n+    });\n+\n+    it('renders with correct value and max attributes', () => {\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('value')).toBe(50);\n+      expect(progressElement.prop('max')).toBe(100);\n+    });\n+\n+    it('renders with correct aria-label', () => {\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('aria-label')).toBe('Progress: 50%');\n+    });\n+  });\n+\n+  describe('Progress bar with different values', () => {\n+    it('renders 0% progress correctly', () => {\n+      const wrapper = shallow(<ProgressBar value={0} max={100} />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('value')).toBe(0);\n+    });\n+\n+    it('renders 100% progress correctly', () => {\n+      const wrapper = shallow(<ProgressBar value={100} max={100} />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('value')).toBe(100);\n+    });\n+\n+    it('renders partial progress correctly', () => {\n+      const wrapper = shallow(<ProgressBar value={75} max={100} />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('value')).toBe(75);\n+    });\n+\n+    it('handles custom max values', () => {\n+      const wrapper = shallow(<ProgressBar value={25} max={50} />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.prop('value')).toBe(25);\n+      expect(progressElement.prop('max')).toBe(50);\n+    });\n+  });\n+\n+  describe('Progress bar with label display', () => {\n+    it('shows percentage when showPercentage is true', () => {\n+      const wrapper = mount(<ProgressBar value={50} max={100} showPercentage />);\n+      expect(wrapper.text()).toContain('50%');\n+    });\n+\n+    it('shows custom label text', () => {\n+      const wrapper = mount(\n+        <ProgressBar \n+          value={30} \n+          max={100} \n+          labelText=\"Loading files...\" \n+        />\n+      );\n+      expect(wrapper.text()).toContain('Loading files...');\n+    });\n+\n+    it('shows helper text when provided', () => {\n+      const wrapper = mount(\n+        <ProgressBar \n+          value={60} \n+          max={100} \n+          helperText=\"2 minutes remaining\" \n+        />\n+      );\n+      expect(wrapper.text()).toContain('2 minutes remaining');\n+    });\n+  });\n+\n+  describe('Progress bar sizes', () => {\n+    it('renders small size correctly', () => {\n+      const wrapper = shallow(<ProgressBar value={50} max={100} size=\"sm\" />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.hasClass(`${prefix}--progress-bar--sm`)).toBe(true);\n+    });\n+\n+    it('renders large size correctly', () => {\n+      const wrapper = shallow(<ProgressBar value={50} max={100} size=\"lg\" />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.hasClass(`${prefix}--progress-bar--lg`)).toBe(true);\n+    });\n+\n+    it('renders default size when no size specified', () => {\n+      const wrapper = shallow(<ProgressBar value={50} max={100} />);\n+      const progressElement = wrapper.find('progress');\n+      expect(progressElement.hasClass(`${prefix}--progress-bar--sm`)).toBe(false);\n+      expect(progressElement.hasClass(`${prefix}--progress-bar--lg`)).toBe(false);\n+    });\n+  });\n+\n+  describe('Progress bar status variants', () => {\n+    it('renders success status correctly', () => {\n+      const wrapper = shallow(\n+        <ProgressBar value={100} max={100} status=\"success\" />\n+      );\n+      expect(wrapper.hasClass(`${prefix}--progress-bar--success`)).toBe(true);\n+    });\n+\n+    it('renders error status correctly', () => {\n+      const wrapper = shallow(\n+        <ProgressBar value={50} max={100} status=\"error\" />\n+      );\n+      expect(wrapper.hasClass(`${prefix}--progress-bar--error`)).toBe(true);\n+    });\n+\n+    it('renders warning status correctly', () => {\n+      const wrapper = shallow(\n+        <ProgressBar value={75} max={100} status=\"warning\" />\n+      );\n+      expect(wrapper.hasClass(`${prefix}--progress-bar--warning`)).toBe(true);\n+    });\n+  });\n+\n+  describe('Progress bar accessibility', () => {\n+    afterEach(cleanup);\n+\n+    it('should have no Axe violations', async () => {\n+      render(<ProgressBar value={50} max={100} label=\"Progress: 50%\" />);\n+      \n+      await expect(screen.getByRole('progressbar')).toHaveNoAxeViolations();\n+    });\n+\n+    it('should have no Accessibility Checker violations', async () => {\n+      render(\n+        <main>\n+          <ProgressBar value={50} max={100} label=\"Progress: 50%\" />\n+        </main>\n+      );\n+\n+      await expect(screen.getByRole('progressbar')).toHaveNoACViolations('ProgressBar');\n+    });\n+\n+    it('should have the role of progressbar', () => {\n+      render(<ProgressBar value={50} max={100} label=\"Progress: 50%\" />);\n+      expect(() => screen.getByRole('progressbar')).not.toThrow();\n+    });\n+\n+    it('should have correct aria attributes', () => {\n+      render(\n+        <ProgressBar \n+          value={75} \n+          max={100} \n+          label=\"Loading: 75%\" \n+          labelText=\"Loading files\"\n+        />\n+      );\n+      \n+      const progressBar = screen.getByRole('progressbar');\n+      expect(progressBar).toHaveAttribute('aria-valuenow', '75');\n+      expect(progressBar).toHaveAttribute('aria-valuemax', '100');\n+      expect(progressBar).toHaveAttribute('aria-valuemin', '0');\n+      expect(progressBar).toHaveAttribute('aria-label', 'Loading: 75%');\n+    });\n+  });\n+\n+  describe('Progress bar edge cases', () => {\n+    it('handles negative values by clamping to 0', () => {\n+      const wrapper = shallow(<ProgressBar value={-10} max={100} />);\n+      // The component should internally handle this and render 0\n+      expect(wrapper.prop('value')).toBe(0);\n+    });\n+\n+    it('handles values greater than max by clamping to max', () => {\n+      const wrapper = shallow(<ProgressBar value={150} max={100} />);\n+      // The component should internally handle this and render max value\n+      expect(wrapper.prop('value')).toBe(100);\n+    });\n+\n+    it('handles zero max value', () => {\n+      const wrapper = shallow(<ProgressBar value={0} max={0} />);\n+      expect(wrapper.prop('max')).toBe(0);\n+      expect(wrapper.prop('value')).toBe(0);\n+    });\n+  });\n+\n+  describe('Progress bar indeterminate state', () => {\n+    it('renders indeterminate progress bar', () => {\n+      const wrapper = shallow(<ProgressBar indeterminate />);\n+      expect(wrapper.hasClass(`${prefix}--progress-bar--indeterminate`)).toBe(true);\n+    });\n+\n+    it('ignores value when indeterminate', () => {\n+      const wrapper = shallow(<ProgressBar value={50} indeterminate />);\n+      expect(wrapper.hasClass(`${prefix}--progress-bar--indeterminate`)).toBe(true);\n+    });\n+  });\n+});\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ProgressBar/ProgressBar.js b/packages/react/src/components/ProgressBar/ProgressBar.js\nnew file mode 100644\nindex 000000000..b524d5c0e\n--- /dev/null\n+++ b/packages/react/src/components/ProgressBar/ProgressBar.js\n@@ -0,0 +1,142 @@\n+/**\n+ * Copyright IBM Corp. 2019\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+import PropTypes from 'prop-types';\n+import React from 'react';\n+import classnames from 'classnames';\n+import { settings } from 'carbon-components';\n+\n+const { prefix } = settings;\n+\n+const ProgressBar = React.forwardRef(function ProgressBar(\n+  {\n+    className,\n+    value = 0,\n+    max = 100,\n+    label,\n+    labelText,\n+    helperText,\n+    showPercentage = false,\n+    size,\n+    status,\n+    indeterminate = false,\n+    ...rest\n+  },\n+  ref\n+) {\n+  // Clamp value between 0 and max\n+  const clampedValue = indeterminate ? 0 : Math.max(0, Math.min(value, max));\n+  \n+  // Calculate percentage\n+  const percentage = max > 0 ? Math.round((clampedValue / max) * 100) : 0;\n+  \n+  // Generate aria-label if not provided\n+  const ariaLabel = label || `Progress: ${percentage}%`;\n+  \n+  const progressBarClasses = classnames(`${prefix}--progress-bar`, className, {\n+    [`${prefix}--progress-bar--sm`]: size === 'sm',\n+    [`${prefix}--progress-bar--lg`]: size === 'lg',\n+    [`${prefix}--progress-bar--success`]: status === 'success',\n+    [`${prefix}--progress-bar--error`]: status === 'error',\n+    [`${prefix}--progress-bar--warning`]: status === 'warning',\n+    [`${prefix}--progress-bar--indeterminate`]: indeterminate,\n+  });\n+\n+  const progressBarProps = {\n+    className: progressBarClasses,\n+    value: clampedValue,\n+    max,\n+    'aria-label': ariaLabel,\n+    'aria-valuenow': indeterminate ? undefined : clampedValue,\n+    'aria-valuemin': indeterminate ? undefined : 0,\n+    'aria-valuemax': indeterminate ? undefined : max,\n+    role: 'progressbar',\n+    ref,\n+    ...rest,\n+  };\n+\n+  return (\n+    <div className={`${prefix}--progress-bar-container`}>\n+      {(labelText || showPercentage) && (\n+        <div className={`${prefix}--progress-bar-label`}>\n+          {labelText && (\n+            <span className={`${prefix}--progress-bar-label-text`}>\n+              {labelText}\n+            </span>\n+          )}\n+          {showPercentage && (\n+            <span className={`${prefix}--progress-bar-percentage`}>\n+              {percentage}%\n+            </span>\n+          )}\n+        </div>\n+      )}\n+      <progress {...progressBarProps} />\n+      {helperText && (\n+        <div className={`${prefix}--progress-bar-helper-text`}>\n+          {helperText}\n+        </div>\n+      )}\n+    </div>\n+  );\n+});\n+\n+ProgressBar.propTypes = {\n+  /**\n+   * Provide an optional className to be applied to the progress bar\n+   */\n+  className: PropTypes.string,\n+\n+  /**\n+   * The current progress value\n+   */\n+  value: PropTypes.number,\n+\n+  /**\n+   * The maximum progress value\n+   */\n+  max: PropTypes.number,\n+\n+  /**\n+   * Provide an accessible label for the progress bar\n+   */\n+  label: PropTypes.string,\n+\n+  /**\n+   * Provide label text to be rendered above the progress bar\n+   */\n+  labelText: PropTypes.string,\n+\n+  /**\n+   * Provide helper text to be rendered below the progress bar\n+   */\n+  helperText: PropTypes.string,\n+\n+  /**\n+   * Whether to show the percentage value\n+   */\n+  showPercentage: PropTypes.bool,\n+\n+  /**\n+   * Specify the size of the progress bar\n+   */\n+  size: PropTypes.oneOf(['sm', 'lg']),\n+\n+  /**\n+   * Specify the status of the progress bar\n+   */\n+  status: PropTypes.oneOf(['success', 'error', 'warning']),\n+\n+  /**\n+   * Whether the progress bar is in an indeterminate state\n+   */\n+  indeterminate: PropTypes.bool,\n+};\n+\n+ProgressBar.displayName = 'ProgressBar';\n+\n+export default ProgressBar;\n\\ No newline at end of file\ndiff --git a/packages/react/src/components/ProgressBar/index.js b/packages/react/src/components/ProgressBar/index.js\nnew file mode 100644\nindex 000000000..bc1600696\n--- /dev/null\n+++ b/packages/react/src/components/ProgressBar/index.js\n@@ -0,0 +1,8 @@\n+/**\n+ * Copyright IBM Corp. 2019\n+ *\n+ * This source code is licensed under the Apache-2.0 license found in the\n+ * LICENSE file in the root directory of this source tree.\n+ */\n+\n+export { default } from './ProgressBar';\n\\ No newline at end of file\ndiff --git a/packages/react/src/index.js b/packages/react/src/index.js\nindex 07431f89a..0143cd233 100644\n--- a/packages/react/src/index.js\n+++ b/packages/react/src/index.js\n@@ -91,6 +91,7 @@ export {\n   ProgressIndicator,\n   ProgressStep,\n } from './components/ProgressIndicator';\n+export ProgressBar from './components/ProgressBar';\n export RadioButton from './components/RadioButton';\n export RadioButtonGroup from './components/RadioButtonGroup';\n export Search from './components/Search';", "model_name_or_path": "llm.claude4"}

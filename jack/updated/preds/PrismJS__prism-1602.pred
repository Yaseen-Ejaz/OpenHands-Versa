should be highlighted as a string</div>\n+        <pre><code class=\"language-yaml\">hello:\n+    - \"world\" # test\n+    - \"world\"</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <div class=\"test-title\">Test Case 2: Single quoted string with trailing comment</div>\n+        <div class=\"issue\">Expected: 'world' should be highlighted as a string</div>\n+        <pre><code class=\"language-yaml\">hello:\n+    - 'world' # test\n+    - 'world'</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <div class=\"test-title\">Test Case 3: Multiple strings with comments</div>\n+        <pre><code class=\"language-yaml\">config:\n+    name: \"MyApp\" # application name\n+    version: '1.0.0' # version string\n+    debug: true # boolean value</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <div class=\"test-title\">Test Case 4: Strings without comments (should work)</div>\n+        <div class=\"expected\">Expected: All strings should be highlighted correctly</div>\n+        <pre><code class=\"language-yaml\">normal:\n+    - \"string1\"\n+    - 'string2'\n+    - \"string3\",\n+    - \"string4\"]</code></pre>\n+    </div>\n+\n+    <div class=\"test-case\">\n+        <div class=\"test-title\">Test Case 5: Complex YAML with mixed cases</div>\n+        <pre><code class=\"language-yaml\">database:\n+    host: \"localhost\" # database host\n+    port: 5432\n+    name: \"mydb\" # database name\n+    credentials:\n+        username: 'admin' # admin user\n+        password: \"secret123\"</code></pre>\n+    </div>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-yaml.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

meric_separators.html\nnew file mode 100644\nindex 00000000..30c2daa4\n--- /dev/null\n+++ b/test_numeric_separators.html\n@@ -0,0 +1,55 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Numeric Separators Test</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+</head>\n+<body>\n+    <h1>JavaScript Numeric Separators Test</h1>\n+    \n+    <h2>Current Issue - These should be highlighted as numbers:</h2>\n+    <pre><code class=\"language-javascript\">\n+// Integer with separators\n+let billion = 1_000_000_000_000;\n+let million = 1_000_000;\n+let thousand = 1_000;\n+\n+// Decimal with separators  \n+let precise = 1_019_436_871.42;\n+let decimal = 123_456.789_012;\n+\n+// Binary with separators\n+let binary = 0b1010_0001_1000_0101;\n+\n+// Octal with separators\n+let octal = 0o777_666_555;\n+\n+// Hexadecimal with separators\n+let hex = 0xFF_EC_DE_5E;\n+let hexLower = 0xff_ec_de_5e;\n+\n+// BigInt with separators\n+let bigInt = 123_456_789_012_345_678_901_234_567_890n;\n+\n+// Scientific notation with separators\n+let scientific = 1_234.567_890e+10;\n+let scientificNeg = 9_876.543_210E-5;\n+</code></pre>\n+\n+    <h2>These should work correctly (existing functionality):</h2>\n+    <pre><code class=\"language-javascript\">\n+// Regular numbers without separators\n+let regular = 1000000000000;\n+let decimal = 1019436871.42;\n+let binary = 0b1010000110000101;\n+let octal = 0o777666555;\n+let hex = 0xFFECDE5E;\n+let bigInt = 123456789012345678901234567890n;\n+let scientific = 1234.56789e+10;\n+</code></pre>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-clike.js\"></script>\n+    <script src=\"components/prism-javascript.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_numeric_separators.test b/test_numeric_separators.test\nnew file mode 100644\nindex 00000000..9600ff5e\n--- /dev/null\n+++ b/test_numeric_separators.test\n@@ -0,0 +1,51 @@\n+// Test cases for numeric separators\n+1_000_000_000_000\n+1_019_436_871.42\n+123_456.789_012\n+0b1010_0001_1000_0101\n+0o777_666_555\n+0xFF_EC_DE_5E\n+0xff_ec_de_5e\n+123_456_789_012_345_678_901_234_567_890n\n+1_234.567_890e+10\n+9_876.543_210E-5\n+\n+// Edge cases\n+1_000\n+1_0\n+0_1\n+1_.5\n+1._5\n+1_000_\n+_1000\n+1__000\n+\n+----------------------------------------------------\n+\n+[\n+        [\"number\", \"1_000_000_000_000\"],\n+        [\"number\", \"1_019_436_871.42\"],\n+        [\"number\", \"123_456.789_012\"],\n+        [\"number\", \"0b1010_0001_1000_0101\"],\n+        [\"number\", \"0o777_666_555\"],\n+        [\"number\", \"0xFF_EC_DE_5E\"],\n+        [\"number\", \"0xff_ec_de_5e\"],\n+        [\"number\", \"123_456_789_012_345_678_901_234_567_890n\"],\n+        [\"number\", \"1_234.567_890e+10\"],\n+        [\"number\", \"9_876.543_210E-5\"],\n+        \n+        [\"number\", \"1_000\"],\n+        [\"number\", \"1_0\"],\n+        [\"number\", \"0_1\"],\n+        \"1_\", [\"punctuation\", \".\"], [\"number\", \"5\"],\n+        [\"number\", \"1\"], [\"punctuation\", \".\"], \"_5\",\n+        \"1_000_\",\n+        \"_1000\",\n+        \"1__000\"\n+]\n+\n+----------------------------------------------------\n+\n+Test cases for JavaScript numeric separators (ES2021 feature).\n+Valid separators should be highlighted as numbers.\n+Invalid patterns should not be highlighted as numbers.\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

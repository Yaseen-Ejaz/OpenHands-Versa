P/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:47:42] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:47:42] \"GET /src/ol/geom/flat/length.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:47:42] \"GET /src/ol/interaction/Property.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:47:42] \"GET /src/ol/render/Box.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:49:00] \"GET /test_fix_simple.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:49:00] \"GET /dist/ol.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:50:35] \"GET /test_fix_simple.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:50:35] \"GET /dist/ol.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/renderer/canvas/VectorLayer.js b/src/ol/renderer/canvas/VectorLayer.js\nindex c5025e47d..15f8f40e7 100644\n--- a/src/ol/renderer/canvas/VectorLayer.js\n+++ b/src/ol/renderer/canvas/VectorLayer.js\n@@ -235,6 +235,13 @@ class CanvasVectorLayerRenderer extends CanvasLayerRenderer {\n         this.context.canvas.height,\n         canvasPool,\n       );\n+      // Clear the canvas to ensure no previous content remains\n+      this.context.clearRect(\n+        0,\n+        0,\n+        this.context.canvas.width,\n+        this.context.canvas.height,\n+      );\n     }\n   }\n \ndiff --git a/test_declutter_opacity.html b/test_declutter_opacity.html\nnew file mode 100644\nindex 000000000..ce574e0d3\n--- /dev/null\n+++ b/test_declutter_opacity.html\n@@ -0,0 +1,126 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Test Declutter + Opacity Issue</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 10px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"controls\">\n+        <button onclick=\"panMap()\">Pan Map (should clear previous render)</button>\n+        <button onclick=\"toggleDeclutter()\">Toggle Declutter</button>\n+        <button onclick=\"toggleOpacity()\">Toggle Opacity</button>\n+        <div>\n+            Current settings: \n+            <span id=\"settings\">declutter: true, opacity: 0.8</span>\n+        </div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import VectorLayer from './src/ol/layer/Vector.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import Circle from './src/ol/style/Circle.js';\n+        import Fill from './src/ol/style/Fill.js';\n+        import Stroke from './src/ol/style/Stroke.js';\n+        import Style from './src/ol/style/Style.js';\n+        import Text from './src/ol/style/Text.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create features with overlapping labels to test declutter\n+        const features = [];\n+        for (let i = 0; i < 50; i++) {\n+            const feature = new Feature({\n+                geometry: new Point(fromLonLat([\n+                    -74 + Math.random() * 0.1, // Cluster around NYC\n+                    40.7 + Math.random() * 0.1\n+                ])),\n+                name: `Feature ${i}`\n+            });\n+            features.push(feature);\n+        }\n+\n+        let declutterEnabled = true;\n+        let currentOpacity = 0.8;\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        const vectorLayer = new VectorLayer({\n+            source: vectorSource,\n+            declutter: declutterEnabled,\n+            opacity: currentOpacity,\n+            style: new Style({\n+                image: new Circle({\n+                    radius: 8,\n+                    fill: new Fill({color: 'red'}),\n+                    stroke: new Stroke({color: 'white', width: 2})\n+                }),\n+                text: new Text({\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    },\n+                    font: '12px Arial',\n+                    fill: new Fill({color: 'black'}),\n+                    stroke: new Stroke({color: 'white', width: 2}),\n+                    offsetY: -15\n+                })\n+            })\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [vectorLayer],\n+            view: new View({\n+                center: fromLonLat([-74, 40.7]),\n+                zoom: 12\n+            })\n+        });\n+\n+        // Make functions global for button access\n+        window.panMap = function() {\n+            const view = map.getView();\n+            const center = view.getCenter();\n+            // Pan slightly to trigger re-render\n+            view.setCenter([center[0] + 1000, center[1] + 500]);\n+        };\n+\n+        window.toggleDeclutter = function() {\n+            declutterEnabled = !declutterEnabled;\n+            vectorLayer.setDeclutter(declutterEnabled);\n+            updateSettings();\n+        };\n+\n+        window.toggleOpacity = function() {\n+            currentOpacity = currentOpacity === 1 ? 0.8 : 1;\n+            vectorLayer.setOpacity(currentOpacity);\n+            updateSettings();\n+        };\n+\n+        function updateSettings() {\n+            document.getElementById('settings').textContent = \n+                `declutter: ${declutterEnabled}, opacity: ${currentOpacity}`;\n+        }\n+\n+        console.log('Test loaded. Pan the map to see if previous renders clear properly.');\n+        console.log('Issue should occur when both declutter=true AND opacity<1');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_fix_simple.html b/test_fix_simple.html\nnew file mode 100644\nindex 000000000..cc4448177\n--- /dev/null\n+++ b/test_fix_simple.html\n@@ -0,0 +1,90 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple Test for Declutter + Opacity Fix</title>\n+    <style>\n+        #map {\n+            width: 600px;\n+            height: 400px;\n+            border: 2px solid #000;\n+            background: #f0f0f0;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 8px 16px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h2>Test: VectorLayer with Declutter + Opacity</h2>\n+    <div class=\"controls\">\n+        <button onclick=\"panMap()\">Pan Map (Test Clearing)</button>\n+        <div>Settings: declutter=true, opacity=0.8</div>\n+        <div>Expected: No ghosting/artifacts when panning</div>\n+    </div>\n+    <div id=\"map\"></div>\n+\n+    <script src=\"./dist/ol.js\"></script>\n+    <script>\n+        // Create a simple vector layer with features\n+        const features = [];\n+        for (let i = 0; i < 20; i++) {\n+            const feature = new ol.Feature({\n+                geometry: new ol.geom.Point([\n+                    -8000000 + Math.random() * 1000000,\n+                    5000000 + Math.random() * 1000000\n+                ]),\n+                name: `Point ${i}`\n+            });\n+            features.push(feature);\n+        }\n+\n+        const vectorSource = new ol.source.Vector({\n+            features: features\n+        });\n+\n+        const vectorLayer = new ol.layer.Vector({\n+            source: vectorSource,\n+            declutter: true,  // Enable declutter\n+            opacity: 0.8,     // Set opacity < 1\n+            style: new ol.style.Style({\n+                image: new ol.style.Circle({\n+                    radius: 10,\n+                    fill: new ol.style.Fill({color: 'red'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2})\n+                }),\n+                text: new ol.style.Text({\n+                    text: function(feature) {\n+                        return feature.get('name');\n+                    },\n+                    font: '14px Arial',\n+                    fill: new ol.style.Fill({color: 'black'}),\n+                    stroke: new ol.style.Stroke({color: 'white', width: 2}),\n+                    offsetY: -20\n+                })\n+            })\n+        });\n+\n+        const map = new ol.Map({\n+            target: 'map',\n+            layers: [vectorLayer],\n+            view: new ol.View({\n+                center: [-8000000, 5000000],\n+                zoom: 8\n+            })\n+        });\n+\n+        window.panMap = function() {\n+            const view = map.getView();\n+            const center = view.getCenter();\n+            // Pan to trigger re-render\n+            view.setCenter([center[0] + 100000, center[1] + 50000]);\n+        };\n+\n+        console.log('Simple test loaded. Click \"Pan Map\" to test clearing behavior.');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "bpmn-io__bpmn-js-1636", "model_patch": "diff --git a/comprehensive_test.html b/comprehensive_test.html\nnew file mode 100644\nindex 00000000..dfb203d6\n--- /dev/null\n+++ b/comprehensive_test.html\n@@ -0,0 +1,188 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Comprehensive Call Activity Fix Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    .test-case { border: 1px solid #ccc; padding: 15px; margin: 10px 0; }\n+    .canvas { width: 100%; height: 200px; border: 1px solid #ddd; }\n+    button { margin: 5px; padding: 8px 12px; }\n+    .log { background: #f5f5f5; padding: 10px; margin-top: 10px; font-family: monospace; font-size: 12px; }\n+    .success { color: green; font-weight: bold; }\n+    .error { color: red; font-weight: bold; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Comprehensive Call Activity to Subprocess Fix Test</h1>\n+  \n+  <div class=\"test-case\">\n+    <h3>Test 1: Call Activity \u2192 Expanded Subprocess (FIXED)</h3>\n+    <div id=\"canvas1\" class=\"canvas\"></div>\n+    <button onclick=\"runTest1()\">Run Test</button>\n+    <div id=\"log1\" class=\"log\">Ready...</div>\n+  </div>\n+  \n+  <div class=\"test-case\">\n+    <h3>Test 2: Task \u2192 Expanded Subprocess (Should still work)</h3>\n+    <div id=\"canvas2\" class=\"canvas\"></div>\n+    <button onclick=\"runTest2()\">Run Test</button>\n+    <div id=\"log2\" class=\"log\">Ready...</div>\n+  </div>\n+  \n+  <div class=\"test-case\">\n+    <h3>Test 3: Call Activity \u2192 Collapsed Subprocess (Should NOT add start event)</h3>\n+    <div id=\"canvas3\" class=\"canvas\"></div>\n+    <button onclick=\"runTest3()\">Run Test</button>\n+    <div id=\"log3\" class=\"log\">Ready...</div>\n+  </div>\n+  \n+  <div class=\"test-case\">\n+    <h3>Test 4: Task \u2192 Collapsed Subprocess (Should NOT add start event)</h3>\n+    <div id=\"canvas4\" class=\"canvas\"></div>\n+    <button onclick=\"runTest4()\">Run Test</button>\n+    <div id=\"log4\" class=\"log\">Ready...</div>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modelers = {};\n+\n+    // Initialize modelers\n+    function initModeler(canvasId, testCase) {\n+      const modeler = new BpmnJS({\n+        container: '#' + canvasId,\n+        keyboard: { bindTo: document }\n+      });\n+      \n+      modelers[testCase] = modeler;\n+      modeler.createDiagram();\n+      return modeler;\n+    }\n+\n+    // Initialize all test cases\n+    for (let i = 1; i <= 4; i++) {\n+      initModeler('canvas' + i, i);\n+    }\n+\n+    function log(testCase, message, isSuccess = null) {\n+      const logElement = document.getElementById('log' + testCase);\n+      let className = '';\n+      if (isSuccess === true) className = 'success';\n+      if (isSuccess === false) className = 'error';\n+      \n+      logElement.innerHTML += `<span class=\"${className}\">${message}</span>\\n`;\n+    }\n+\n+    function createTask(testCase) {\n+      const modeler = modelers[testCase];\n+      const elementFactory = modeler.get('elementFactory');\n+      const canvas = modeler.get('canvas');\n+      const modeling = modeler.get('modeling');\n+\n+      const taskShape = elementFactory.createShape({ type: 'bpmn:Task' });\n+      const task = modeling.createShape(taskShape, { x: 100, y: 100 }, canvas.getRootElement());\n+      \n+      log(testCase, 'Created Task: ' + task.id);\n+      return task;\n+    }\n+\n+    function createCallActivity(testCase) {\n+      const modeler = modelers[testCase];\n+      const elementFactory = modeler.get('elementFactory');\n+      const canvas = modeler.get('canvas');\n+      const modeling = modeler.get('modeling');\n+\n+      const callActivityShape = elementFactory.createShape({ type: 'bpmn:CallActivity' });\n+      const callActivity = modeling.createShape(callActivityShape, { x: 100, y: 100 }, canvas.getRootElement());\n+      \n+      log(testCase, 'Created Call Activity: ' + callActivity.id);\n+      return callActivity;\n+    }\n+\n+    function morphToCallActivity(element, testCase) {\n+      const modeler = modelers[testCase];\n+      const bpmnReplace = modeler.get('bpmnReplace');\n+\n+      const callActivity = bpmnReplace.replaceElement(element, {\n+        type: 'bpmn:CallActivity'\n+      });\n+\n+      log(testCase, 'Morphed to Call Activity: ' + callActivity.id);\n+      return callActivity;\n+    }\n+\n+    function morphToSubprocess(element, testCase, isExpanded) {\n+      const modeler = modelers[testCase];\n+      const bpmnReplace = modeler.get('bpmnReplace');\n+\n+      const subprocess = bpmnReplace.replaceElement(element, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: isExpanded\n+      });\n+\n+      const startEvents = subprocess.children.filter(child => child.type === 'bpmn:StartEvent');\n+      \n+      log(testCase, `Morphed to ${isExpanded ? 'Expanded' : 'Collapsed'} Subprocess: ` + subprocess.id);\n+      log(testCase, 'Start events found: ' + startEvents.length);\n+      \n+      return { subprocess, startEvents };\n+    }\n+\n+    // Test 1: Call Activity \u2192 Expanded Subprocess (should add start event)\n+    function runTest1() {\n+      log(1, 'Starting Test 1: Call Activity \u2192 Expanded Subprocess');\n+      \n+      const callActivity = createCallActivity(1);\n+      const result = morphToSubprocess(callActivity, 1, true);\n+      \n+      if (result.startEvents.length === 1) {\n+        log(1, '\u2705 SUCCESS: Start event correctly added!', true);\n+      } else {\n+        log(1, '\u274c FAILED: Expected 1 start event, got ' + result.startEvents.length, false);\n+      }\n+    }\n+\n+    // Test 2: Task \u2192 Expanded Subprocess (should add start event)\n+    function runTest2() {\n+      log(2, 'Starting Test 2: Task \u2192 Expanded Subprocess');\n+      \n+      const task = createTask(2);\n+      const result = morphToSubprocess(task, 2, true);\n+      \n+      if (result.startEvents.length === 1) {\n+        log(2, '\u2705 SUCCESS: Start event correctly added!', true);\n+      } else {\n+        log(2, '\u274c FAILED: Expected 1 start event, got ' + result.startEvents.length, false);\n+      }\n+    }\n+\n+    // Test 3: Call Activity \u2192 Collapsed Subprocess (should NOT add start event)\n+    function runTest3() {\n+      log(3, 'Starting Test 3: Call Activity \u2192 Collapsed Subprocess');\n+      \n+      const callActivity = createCallActivity(3);\n+      const result = morphToSubprocess(callActivity, 3, false);\n+      \n+      if (result.startEvents.length === 0) {\n+        log(3, '\u2705 SUCCESS: No start event added (correct for collapsed)', true);\n+      } else {\n+        log(3, '\u274c FAILED: Expected 0 start events, got ' + result.startEvents.length, false);\n+      }\n+    }\n+\n+    // Test 4: Task \u2192 Collapsed Subprocess (should NOT add start event)\n+    function runTest4() {\n+      log(4, 'Starting Test 4: Task \u2192 Collapsed Subprocess');\n+      \n+      const task = createTask(4);\n+      const result = morphToSubprocess(task, 4, false);\n+      \n+      if (result.startEvents.length === 0) {\n+        log(4, '\u2705 SUCCESS: No start event added (correct for collapsed)', true);\n+      } else {\n+        log(4, '\u274c FAILED: Expected 0 start events, got ' + result.startEvents.length, false);\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/lib/features/modeling/behavior/SubProcessStartEventBehavior.js b/lib/features/modeling/behavior/SubProcessStartEventBehavior.js\nindex 0f1ca99a..6a42f720 100644\n--- a/lib/features/modeling/behavior/SubProcessStartEventBehavior.js\n+++ b/lib/features/modeling/behavior/SubProcessStartEventBehavior.js\n@@ -20,7 +20,7 @@ export default function SubProcessStartEventBehavior(injector, modeling) {\n \n     if (\n       !is(newShape, 'bpmn:SubProcess') ||\n-      !is(oldShape, 'bpmn:Task') ||\n+      !(is(oldShape, 'bpmn:Task') || is(oldShape, 'bpmn:CallActivity')) ||\n       !isExpanded(newShape)\n     ) {\n       return;\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..d706179a\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,7 @@\n+Serving HTTP on 0.0.0.0 port 8080 (http://0.0.0.0:8080/) ...\n+127.0.0.1 - - [04/Mar/2026 14:40:58] \"GET /test_morph_issue.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:40:58] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:41:58] \"GET /test_morph_issue.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:41:58] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:43:11] \"GET /comprehensive_test.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 14:43:11] \"GET /dist/bpmn-modeler.development.js HTTP/1.1\" 304 -\ndiff --git a/test_call_activity_morph.js b/test_call_activity_morph.js\nnew file mode 100644\nindex 00000000..3a3b7eac\n--- /dev/null\n+++ b/test_call_activity_morph.js\n@@ -0,0 +1,98 @@\n+import {\n+  bootstrapModeler,\n+  inject\n+} from 'test/TestHelper';\n+\n+import coreModule from 'lib/core';\n+import modelingModule from 'lib/features/modeling';\n+import replaceModule from 'lib/features/replace';\n+\n+import { is, getDi } from 'lib/util/ModelUtil';\n+\n+describe('Call Activity to Subprocess Morphing Issue', function() {\n+\n+  var diagramXML = require('./spec/features/modeling/behavior/SubProcessBehavior.start-event.bpmn');\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: [\n+      coreModule,\n+      modelingModule,\n+      replaceModule\n+    ]\n+  }));\n+\n+  describe('reproduce issue', function() {\n+\n+    describe('task -> call activity -> expanded subprocess', function() {\n+\n+      it('should reproduce the issue: call activity -> expanded subprocess does NOT add start event', inject(\n+        function(elementRegistry, bpmnReplace) {\n+\n+          // given\n+          var task = elementRegistry.get('Task_1');\n+\n+          // when - first morph task to call activity\n+          var callActivity = bpmnReplace.replaceElement(task, {\n+            type: 'bpmn:CallActivity'\n+          });\n+\n+          // then - call activity should be created\n+          expect(callActivity.type).to.equal('bpmn:CallActivity');\n+\n+          // when - then morph call activity to expanded subprocess\n+          var expandedSubProcess = bpmnReplace.replaceElement(callActivity, {\n+            type: 'bpmn:SubProcess',\n+            isExpanded: true\n+          });\n+\n+          // then - this should have a start event but currently doesn't (the bug)\n+          var startEvents = getChildStartEvents(expandedSubProcess);\n+          \n+          console.log('Start events found:', startEvents.length);\n+          console.log('Expected: 1, Actual:', startEvents.length);\n+          \n+          // This will fail with current implementation - demonstrating the bug\n+          expect(startEvents).to.have.length(1);\n+        }\n+      ));\n+\n+    });\n+\n+    describe('task -> expanded subprocess (working case)', function() {\n+\n+      it('should work correctly: task -> expanded subprocess adds start event', inject(\n+        function(elementRegistry, bpmnReplace) {\n+\n+          // given\n+          var task = elementRegistry.get('Task_1');\n+\n+          // when - directly morph task to expanded subprocess\n+          var expandedSubProcess = bpmnReplace.replaceElement(task, {\n+            type: 'bpmn:SubProcess',\n+            isExpanded: true\n+          });\n+\n+          // then - this should have a start event (working case)\n+          var startEvents = getChildStartEvents(expandedSubProcess);\n+          \n+          console.log('Start events found (working case):', startEvents.length);\n+          \n+          expect(startEvents).to.have.length(1);\n+        }\n+      ));\n+\n+    });\n+\n+  });\n+\n+});\n+\n+// helpers //////////\n+\n+function isStartEvent(element) {\n+  return is(element, 'bpmn:StartEvent');\n+}\n+\n+function getChildStartEvents(element) {\n+  return element.children.filter(isStartEvent);\n+}\n\\ No newline at end of file\ndiff --git a/test_morph_issue.html b/test_morph_issue.html\nnew file mode 100644\nindex 00000000..88fc3770\n--- /dev/null\n+++ b/test_morph_issue.html\n@@ -0,0 +1,130 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+  <title>Call Activity to Subprocess Morphing Test</title>\n+  <style>\n+    body { font-family: Arial, sans-serif; margin: 20px; }\n+    .container { display: flex; gap: 20px; }\n+    .test-case { border: 1px solid #ccc; padding: 15px; width: 400px; }\n+    .canvas { width: 100%; height: 300px; border: 1px solid #ddd; }\n+    button { margin: 5px; padding: 8px 12px; }\n+    .log { background: #f5f5f5; padding: 10px; margin-top: 10px; font-family: monospace; font-size: 12px; }\n+  </style>\n+</head>\n+<body>\n+  <h1>Call Activity to Subprocess Morphing Issue Test</h1>\n+  \n+  <div class=\"container\">\n+    <div class=\"test-case\">\n+      <h3>Test Case 1: Task \u2192 Call Activity \u2192 Expanded Subprocess</h3>\n+      <div id=\"canvas1\" class=\"canvas\"></div>\n+      <button onclick=\"createTask(1)\">1. Create Task</button>\n+      <button onclick=\"morphToCallActivity(1)\">2. Morph to Call Activity</button>\n+      <button onclick=\"morphToExpandedSubprocess(1)\">3. Morph to Expanded Subprocess</button>\n+      <div id=\"log1\" class=\"log\">Ready...</div>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+      <h3>Test Case 2: Task \u2192 Expanded Subprocess (Working)</h3>\n+      <div id=\"canvas2\" class=\"canvas\"></div>\n+      <button onclick=\"createTask(2)\">1. Create Task</button>\n+      <button onclick=\"morphToExpandedSubprocess(2)\">2. Morph to Expanded Subprocess</button>\n+      <div id=\"log2\" class=\"log\">Ready...</div>\n+    </div>\n+  </div>\n+\n+  <script src=\"dist/bpmn-modeler.development.js\"></script>\n+  <script>\n+    let modelers = {};\n+    let currentElements = {};\n+\n+    // Initialize modelers\n+    function initModeler(canvasId, testCase) {\n+      const modeler = new BpmnJS({\n+        container: '#' + canvasId,\n+        keyboard: { bindTo: document }\n+      });\n+      \n+      modelers[testCase] = modeler;\n+      \n+      // Create empty diagram\n+      modeler.createDiagram();\n+      \n+      return modeler;\n+    }\n+\n+    // Initialize both test cases\n+    initModeler('canvas1', 1);\n+    initModeler('canvas2', 2);\n+\n+    function log(testCase, message) {\n+      document.getElementById('log' + testCase).innerHTML += message + '\\n';\n+    }\n+\n+    function createTask(testCase) {\n+      const modeler = modelers[testCase];\n+      const elementFactory = modeler.get('elementFactory');\n+      const canvas = modeler.get('canvas');\n+      const modeling = modeler.get('modeling');\n+\n+      // Create a task\n+      const taskShape = elementFactory.createShape({\n+        type: 'bpmn:Task'\n+      });\n+\n+      const task = modeling.createShape(taskShape, { x: 200, y: 150 }, canvas.getRootElement());\n+      currentElements[testCase] = task;\n+      \n+      log(testCase, 'Created Task: ' + task.id);\n+    }\n+\n+    function morphToCallActivity(testCase) {\n+      const modeler = modelers[testCase];\n+      const bpmnReplace = modeler.get('bpmnReplace');\n+      const element = currentElements[testCase];\n+\n+      if (!element) {\n+        log(testCase, 'Error: No element to morph');\n+        return;\n+      }\n+\n+      const callActivity = bpmnReplace.replaceElement(element, {\n+        type: 'bpmn:CallActivity'\n+      });\n+\n+      currentElements[testCase] = callActivity;\n+      log(testCase, 'Morphed to Call Activity: ' + callActivity.id);\n+    }\n+\n+    function morphToExpandedSubprocess(testCase) {\n+      const modeler = modelers[testCase];\n+      const bpmnReplace = modeler.get('bpmnReplace');\n+      const element = currentElements[testCase];\n+\n+      if (!element) {\n+        log(testCase, 'Error: No element to morph');\n+        return;\n+      }\n+\n+      const subprocess = bpmnReplace.replaceElement(element, {\n+        type: 'bpmn:SubProcess',\n+        isExpanded: true\n+      });\n+\n+      currentElements[testCase] = subprocess;\n+      \n+      // Check for start events\n+      const startEvents = subprocess.children.filter(child => child.type === 'bpmn:StartEvent');\n+      \n+      log(testCase, 'Morphed to Expanded Subprocess: ' + subprocess.id);\n+      log(testCase, 'Start events found: ' + startEvents.length);\n+      \n+      if (startEvents.length === 0) {\n+        log(testCase, '\u274c BUG: No start event added!');\n+      } else {\n+        log(testCase, '\u2705 SUCCESS: Start event added!');\n+      }\n+    }\n+  </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

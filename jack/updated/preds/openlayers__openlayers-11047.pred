{"instance_id": "openlayers__openlayers-11047", "model_patch": "diff --git a/src/ol/source/Raster.js b/src/ol/source/Raster.js\nindex 9992395d5..d66e0744d 100644\n--- a/src/ol/source/Raster.js\n+++ b/src/ol/source/Raster.js\n@@ -445,6 +445,28 @@ class RasterSource extends ImageSource {\n   getImageInternal() {\n     return null; // not implemented\n   }\n+\n+  /**\n+   * Clean up.\n+   * @protected\n+   */\n+  disposeInternal() {\n+    if (this.worker_) {\n+      // Terminate all workers before destroying the processor\n+      if (this.worker_._workers) {\n+        for (let i = 0; i < this.worker_._workers.length; i++) {\n+          const worker = this.worker_._workers[i];\n+          if (worker && typeof worker.terminate === 'function') {\n+            worker.terminate();\n+          }\n+        }\n+      }\n+      // Destroy the processor\n+      this.worker_.destroy();\n+      this.worker_ = null;\n+    }\n+    super.disposeInternal();\n+  }\n }\n \n /**\ndiff --git a/test_fix_verification.html b/test_fix_verification.html\nnew file mode 100644\nindex 000000000..6b6e17600\n--- /dev/null\n+++ b/test_fix_verification.html\n@@ -0,0 +1,110 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Worker Disposal Fix Verification</title>\n+    <script src=\"./node_modules/ol/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <div id=\"map\" style=\"width: 100px; height: 100px;\"></div>\n+    <div id=\"output\"></div>\n+    \n+    <script>\n+        function log(message) {\n+            const output = document.getElementById('output');\n+            output.innerHTML += message + '<br>';\n+            console.log(message);\n+        }\n+        \n+        function testWorkerDisposal() {\n+            log('Testing worker disposal fix...');\n+            \n+            const red = 'data:image/gif;base64,R0lGODlhAQABAPAAAP8AAP///yH5BAAAAAAALAAAAABAAAEAAAICRAEAOW==';\n+            \n+            let workersTerminated = 0;\n+            let originalTerminate = null;\n+            \n+            // Mock Worker.terminate to count terminations\n+            if (typeof Worker !== 'undefined') {\n+                originalTerminate = Worker.prototype.terminate;\n+                Worker.prototype.terminate = function() {\n+                    workersTerminated++;\n+                    log(`Worker terminated! Total terminated: ${workersTerminated}`);\n+                    if (originalTerminate) {\n+                        originalTerminate.call(this);\n+                    }\n+                };\n+            }\n+            \n+            const sources = [];\n+            \n+            // Create multiple raster sources\n+            for (let i = 0; i < 3; i++) {\n+                log(`Creating raster source ${i + 1}`);\n+                \n+                const imageSource = new ol.source.ImageStatic({\n+                    url: red,\n+                    imageExtent: [-1, -1, 1, 1],\n+                });\n+\n+                const rasterSource = new ol.source.Raster({\n+                    threads: 1, // Use 1 thread to create actual workers\n+                    sources: [imageSource],\n+                    operation: function (inputs) {\n+                        return inputs[0];\n+                    },\n+                });\n+                \n+                sources.push({ rasterSource, imageSource });\n+                \n+                // Check if worker exists\n+                if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+                    log(`RasterSource ${i + 1} has ${rasterSource.worker_._workers.length} workers`);\n+                } else {\n+                    log(`RasterSource ${i + 1} has no worker or workers array yet`);\n+                }\n+            }\n+            \n+            log('\\nDisposing sources...');\n+            \n+            // Dispose sources\n+            sources.forEach(({ rasterSource, imageSource }, index) => {\n+                log(`Disposing raster source ${index + 1}`);\n+                \n+                // Check workers before disposal\n+                if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+                    log(`Before disposal: RasterSource ${index + 1} has ${rasterSource.worker_._workers.length} workers`);\n+                }\n+                \n+                rasterSource.dispose();\n+                imageSource.dispose();\n+                \n+                // Check workers after disposal\n+                if (rasterSource.worker_) {\n+                    log(`After disposal: RasterSource ${index + 1} worker still exists`);\n+                } else {\n+                    log(`After disposal: RasterSource ${index + 1} worker is null (cleaned up)`);\n+                }\n+            });\n+            \n+            log(`\\nTest completed. Total workers terminated: ${workersTerminated}`);\n+            \n+            // Restore original terminate method\n+            if (originalTerminate && typeof Worker !== 'undefined') {\n+                Worker.prototype.terminate = originalTerminate;\n+            }\n+            \n+            // Verify the fix\n+            if (workersTerminated > 0) {\n+                log('\u2705 SUCCESS: Workers were properly terminated!');\n+            } else {\n+                log('\u274c FAILURE: No workers were terminated');\n+            }\n+        }\n+        \n+        // Run the test when page loads\n+        window.onload = function() {\n+            setTimeout(testWorkerDisposal, 1000); // Wait a bit for everything to load\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_worker_disposal.html b/test_worker_disposal.html\nnew file mode 100644\nindex 000000000..edd090cd0\n--- /dev/null\n+++ b/test_worker_disposal.html\n@@ -0,0 +1,93 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Worker Memory Leak Test</title>\n+    <script src=\"./node_modules/ol/dist/ol.js\"></script>\n+</head>\n+<body>\n+    <div id=\"map\" style=\"width: 100px; height: 100px;\"></div>\n+    <div id=\"output\"></div>\n+    \n+    <script>\n+        function log(message) {\n+            const output = document.getElementById('output');\n+            output.innerHTML += message + '<br>';\n+            console.log(message);\n+        }\n+        \n+        function testWorkerMemoryLeak() {\n+            log('Testing worker memory leak...');\n+            \n+            const red = 'data:image/gif;base64,R0lGODlhAQABAPAAAP8AAP///yH5BAAAAAAALAAAAABAAAEAAAICRAEAOW==';\n+            \n+            const sources = [];\n+            \n+            // Create multiple raster sources to simulate the memory leak\n+            for (let i = 0; i < 3; i++) {\n+                log(`Creating raster source ${i + 1}`);\n+                \n+                const imageSource = new ol.source.ImageStatic({\n+                    url: red,\n+                    imageExtent: [-1, -1, 1, 1],\n+                });\n+\n+                const rasterSource = new ol.source.Raster({\n+                    threads: 1, // Use 1 thread to create actual workers\n+                    sources: [imageSource],\n+                    operation: function (inputs) {\n+                        return inputs[0];\n+                    },\n+                });\n+                \n+                sources.push({ rasterSource, imageSource });\n+                \n+                // Check if worker exists\n+                if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+                    log(`RasterSource ${i + 1} has ${rasterSource.worker_._workers.length} workers`);\n+                    \n+                    // Check if workers are actual Worker instances\n+                    rasterSource.worker_._workers.forEach((worker, index) => {\n+                        log(`Worker ${index}: ${typeof worker}, ${worker.constructor.name}`);\n+                        if (worker.terminate) {\n+                            log(`Worker ${index} has terminate method`);\n+                        } else {\n+                            log(`Worker ${index} does NOT have terminate method`);\n+                        }\n+                    });\n+                } else {\n+                    log(`RasterSource ${i + 1} has no worker or workers array`);\n+                }\n+            }\n+            \n+            log('\\nDisposing sources...');\n+            \n+            // Dispose sources\n+            sources.forEach(({ rasterSource, imageSource }, index) => {\n+                log(`Disposing raster source ${index + 1}`);\n+                \n+                // Check workers before disposal\n+                if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+                    log(`Before disposal: RasterSource ${index + 1} has ${rasterSource.worker_._workers.length} workers`);\n+                }\n+                \n+                rasterSource.dispose();\n+                imageSource.dispose();\n+                \n+                // Check workers after disposal\n+                if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+                    log(`After disposal: RasterSource ${index + 1} still has ${rasterSource.worker_._workers.length} workers`);\n+                } else {\n+                    log(`After disposal: RasterSource ${index + 1} worker is cleaned up`);\n+                }\n+            });\n+            \n+            log('Test completed');\n+        }\n+        \n+        // Run the test when page loads\n+        window.onload = function() {\n+            testWorkerMemoryLeak();\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_worker_memory_leak.js b/test_worker_memory_leak.js\nnew file mode 100644\nindex 000000000..fb42e71eb\n--- /dev/null\n+++ b/test_worker_memory_leak.js\n@@ -0,0 +1,70 @@\n+/**\n+ * Test to reproduce the worker memory leak issue in RasterSource\n+ */\n+\n+import RasterSource from './src/ol/source/Raster.js';\n+import Static from './src/ol/source/ImageStatic.js';\n+\n+// Create a simple red image data URL\n+const red = 'data:image/gif;base64,R0lGODlhAQABAPAAAP8AAP///yH5BAAAAAAALAAAAABAAAEAAAICRAEAOW==';\n+\n+function createRasterSource() {\n+  const imageSource = new Static({\n+    url: red,\n+    imageExtent: [-1, -1, 1, 1],\n+  });\n+\n+  const rasterSource = new RasterSource({\n+    threads: 1, // Use 1 thread to create actual workers\n+    sources: [imageSource],\n+    operation: function (inputs) {\n+      return inputs[0];\n+    },\n+  });\n+\n+  return { rasterSource, imageSource };\n+}\n+\n+function testWorkerMemoryLeak() {\n+  console.log('Testing worker memory leak...');\n+  \n+  const sources = [];\n+  \n+  // Create multiple raster sources to simulate the memory leak\n+  for (let i = 0; i < 5; i++) {\n+    console.log(`Creating raster source ${i + 1}`);\n+    const { rasterSource, imageSource } = createRasterSource();\n+    sources.push({ rasterSource, imageSource });\n+    \n+    // Check if worker exists\n+    if (rasterSource.worker_ && rasterSource.worker_._workers) {\n+      console.log(`RasterSource ${i + 1} has ${rasterSource.worker_._workers.length} workers`);\n+      \n+      // Check if workers are actual Worker instances\n+      rasterSource.worker_._workers.forEach((worker, index) => {\n+        console.log(`Worker ${index}:`, typeof worker, worker.constructor.name);\n+        if (worker.terminate) {\n+          console.log(`Worker ${index} has terminate method`);\n+        } else {\n+          console.log(`Worker ${index} does NOT have terminate method`);\n+        }\n+      });\n+    } else {\n+      console.log(`RasterSource ${i + 1} has no worker or workers array`);\n+    }\n+  }\n+  \n+  console.log('\\nDisposing sources...');\n+  \n+  // Dispose sources\n+  sources.forEach(({ rasterSource, imageSource }, index) => {\n+    console.log(`Disposing raster source ${index + 1}`);\n+    rasterSource.dispose();\n+    imageSource.dispose();\n+  });\n+  \n+  console.log('Test completed');\n+}\n+\n+// Run the test\n+testWorkerMemoryLeak();\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

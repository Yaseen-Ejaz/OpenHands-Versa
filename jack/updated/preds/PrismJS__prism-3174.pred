{"instance_id": "PrismJS__prism-3174", "model_patch": "diff --git a/components/prism-swift.js b/components/prism-swift.js\nindex 03b704f4..a589597c 100644\n--- a/components/prism-swift.js\n+++ b/components/prism-swift.js\n@@ -1,148 +1,148 @@\n Prism.languages.swift = {\n-\t'comment': {\n-\t\t// Nested comments are supported up to 2 levels\n-\t\tpattern: /(^|[^\\\\:])(?:\\/\\/.*|\\/\\*(?:[^/*]|\\/(?!\\*)|\\*(?!\\/)|\\/\\*(?:[^*]|\\*(?!\\/))*\\*\\/)*\\*\\/)/,\n-\t\tlookbehind: true,\n-\t\tgreedy: true\n-\t},\n-\t'string-literal': [\n-\t\t// https://docs.swift.org/swift-book/LanguageGuide/StringsAndCharacters.html\n-\t\t{\n-\t\t\tpattern: RegExp(\n-\t\t\t\t/(^|[^\"#])/.source\n-\t\t\t\t+ '(?:'\n-\t\t\t\t// single-line string\n-\t\t\t\t+ /\"(?:\\\\(?:\\((?:[^()]|\\([^()]*\\))*\\)|\\r\\n|[^(])|[^\\\\\\r\\n\"])*\"/.source\n-\t\t\t\t+ '|'\n-\t\t\t\t// multi-line string\n-\t\t\t\t+ /\"\"\"(?:\\\\(?:\\((?:[^()]|\\([^()]*\\))*\\)|[^(])|[^\\\\\"]|\"(?!\"\"))*\"\"\"/.source\n-\t\t\t\t+ ')'\n-\t\t\t\t+ /(?![\"#])/.source\n-\t\t\t),\n-\t\t\tlookbehind: true,\n-\t\t\tgreedy: true,\n-\t\t\tinside: {\n-\t\t\t\t'interpolation': {\n-\t\t\t\t\tpattern: /(\\\\\\()(?:[^()]|\\([^()]*\\))*(?=\\))/,\n-\t\t\t\t\tlookbehind: true,\n-\t\t\t\t\tinside: null // see below\n-\t\t\t\t},\n-\t\t\t\t'interpolation-punctuation': {\n-\t\t\t\t\tpattern: /^\\)|\\\\\\($/,\n-\t\t\t\t\talias: 'punctuation'\n-\t\t\t\t},\n-\t\t\t\t'punctuation': /\\\\(?=[\\r\\n])/,\n-\t\t\t\t'string': /[\\s\\S]+/\n-\t\t\t}\n-\t\t},\n-\t\t{\n-\t\t\tpattern: RegExp(\n-\t\t\t\t/(^|[^\"#])(#+)/.source\n-\t\t\t\t+ '(?:'\n-\t\t\t\t// single-line string\n-\t\t\t\t+ /\"(?:\\\\(?:#+\\((?:[^()]|\\([^()]*\\))*\\)|\\r\\n|[^#])|[^\\\\\\r\\n])*?\"/.source\n-\t\t\t\t+ '|'\n-\t\t\t\t// multi-line string\n-\t\t\t\t+ /\"\"\"(?:\\\\(?:#+\\((?:[^()]|\\([^()]*\\))*\\)|[^#])|[^\\\\])*?\"\"\"/.source\n-\t\t\t\t+ ')'\n-\t\t\t\t+ '\\\\2'\n-\t\t\t),\n-\t\t\tlookbehind: true,\n-\t\t\tgreedy: true,\n-\t\t\tinside: {\n-\t\t\t\t'interpolation': {\n-\t\t\t\t\tpattern: /(\\\\#+\\()(?:[^()]|\\([^()]*\\))*(?=\\))/,\n-\t\t\t\t\tlookbehind: true,\n-\t\t\t\t\tinside: null // see below\n-\t\t\t\t},\n-\t\t\t\t'interpolation-punctuation': {\n-\t\t\t\t\tpattern: /^\\)|\\\\#+\\($/,\n-\t\t\t\t\talias: 'punctuation'\n-\t\t\t\t},\n-\t\t\t\t'string': /[\\s\\S]+/\n-\t\t\t}\n-\t\t},\n-\t],\n+        'comment': {\n+                // Nested comments are supported up to 2 levels\n+                pattern: /(^|[^\\\\:])(?:\\/\\/.*|\\/\\*(?:[^/*]|\\/(?!\\*)|\\*(?!\\/)|\\/\\*(?:[^*]|\\*(?!\\/))*\\*\\/)*\\*\\/)/,\n+                lookbehind: true,\n+                greedy: true\n+        },\n+        'string-literal': [\n+                // https://docs.swift.org/swift-book/LanguageGuide/StringsAndCharacters.html\n+                {\n+                        pattern: RegExp(\n+                                /(^|[^\"#])/.source\n+                                + '(?:'\n+                                // single-line string\n+                                + /\"(?:\\\\(?:\\((?:[^()]|\\([^()]*\\))*\\)|\\r\\n|[^(])|[^\\\\\\r\\n\"])*\"/.source\n+                                + '|'\n+                                // multi-line string\n+                                + /\"\"\"(?:\\\\(?:\\((?:[^()]|\\([^()]*\\))*\\)|[^(])|[^\\\\\"]|\"(?!\"\"))*\"\"\"/.source\n+                                + ')'\n+                                + /(?![\"#])/.source\n+                        ),\n+                        lookbehind: true,\n+                        greedy: true,\n+                        inside: {\n+                                'interpolation': {\n+                                        pattern: /(\\\\\\()(?:[^()]|\\([^()]*\\))*(?=\\))/,\n+                                        lookbehind: true,\n+                                        inside: null // see below\n+                                },\n+                                'interpolation-punctuation': {\n+                                        pattern: /^\\)|\\\\\\($/,\n+                                        alias: 'punctuation'\n+                                },\n+                                'punctuation': /\\\\(?=[\\r\\n])/,\n+                                'string': /[\\s\\S]+/\n+                        }\n+                },\n+                {\n+                        pattern: RegExp(\n+                                /(^|[^\"#])(#+)/.source\n+                                + '(?:'\n+                                // single-line string\n+                                + /\"(?:\\\\(?:#+\\((?:[^()]|\\([^()]*\\))*\\)|\\r\\n|[^#])|[^\\\\\\r\\n])*?\"/.source\n+                                + '|'\n+                                // multi-line string\n+                                + /\"\"\"(?:\\\\(?:#+\\((?:[^()]|\\([^()]*\\))*\\)|[^#])|[^\\\\])*?\"\"\"/.source\n+                                + ')'\n+                                + '\\\\2'\n+                        ),\n+                        lookbehind: true,\n+                        greedy: true,\n+                        inside: {\n+                                'interpolation': {\n+                                        pattern: /(\\\\#+\\()(?:[^()]|\\([^()]*\\))*(?=\\))/,\n+                                        lookbehind: true,\n+                                        inside: null // see below\n+                                },\n+                                'interpolation-punctuation': {\n+                                        pattern: /^\\)|\\\\#+\\($/,\n+                                        alias: 'punctuation'\n+                                },\n+                                'string': /[\\s\\S]+/\n+                        }\n+                },\n+        ],\n \n-\t'directive': {\n-\t\t// directives with conditions\n-\t\tpattern: RegExp(\n-\t\t\t/#/.source\n-\t\t\t+ '(?:'\n-\t\t\t+ (\n-\t\t\t\t/(?:elseif|if)\\b/.source\n-\t\t\t\t+ '(?:[ \\t]*'\n-\t\t\t\t// This regex is a little complex. It's equivalent to this:\n-\t\t\t\t//   (?:![ \\t]*)?(?:\\b\\w+\\b(?:[ \\t]*<round>)?|<round>)(?:[ \\t]*(?:&&|\\|\\|))?\n-\t\t\t\t// where <round> is a general parentheses expression.\n-\t\t\t\t+ /(?:![ \\t]*)?(?:\\b\\w+\\b(?:[ \\t]*\\((?:[^()]|\\([^()]*\\))*\\))?|\\((?:[^()]|\\([^()]*\\))*\\))(?:[ \\t]*(?:&&|\\|\\|))?/.source\n-\t\t\t\t+ ')+'\n-\t\t\t)\n-\t\t\t+ '|'\n-\t\t\t+ /(?:else|endif)\\b/.source\n-\t\t\t+ ')'\n-\t\t),\n-\t\talias: 'property',\n-\t\tinside: {\n-\t\t\t'directive-name': /^#\\w+/,\n-\t\t\t'boolean': /\\b(?:false|true)\\b/,\n-\t\t\t'number': /\\b\\d+(?:\\.\\d+)*\\b/,\n-\t\t\t'operator': /!|&&|\\|\\||[<>]=?/,\n-\t\t\t'punctuation': /[(),]/\n-\t\t}\n-\t},\n-\t'literal': {\n-\t\tpattern: /#(?:colorLiteral|column|dsohandle|file(?:ID|Literal|Path)?|function|imageLiteral|line)\\b/,\n-\t\talias: 'constant'\n-\t},\n-\t'other-directive': {\n-\t\tpattern: /#\\w+\\b/,\n-\t\talias: 'property'\n-\t},\n+        'directive': {\n+                // directives with conditions\n+                pattern: RegExp(\n+                        /#/.source\n+                        + '(?:'\n+                        + (\n+                                /(?:elseif|if)\\b/.source\n+                                + '(?:[ \\t]*'\n+                                // This regex is a little complex. It's equivalent to this:\n+                                //   (?:![ \\t]*)?(?:\\b\\w+\\b(?:[ \\t]*<round>)?|<round>)(?:[ \\t]*(?:&&|\\|\\|))?\n+                                // where <round> is a general parentheses expression.\n+                                + /(?:![ \\t]*)?(?:\\b\\w+\\b(?:[ \\t]*\\((?:[^()]|\\([^()]*\\))*\\))?|\\((?:[^()]|\\([^()]*\\))*\\))(?:[ \\t]*(?:&&|\\|\\|))?/.source\n+                                + ')+'\n+                        )\n+                        + '|'\n+                        + /(?:else|endif)\\b/.source\n+                        + ')'\n+                ),\n+                alias: 'property',\n+                inside: {\n+                        'directive-name': /^#\\w+/,\n+                        'boolean': /\\b(?:false|true)\\b/,\n+                        'number': /\\b\\d+(?:\\.\\d+)*\\b/,\n+                        'operator': /!|&&|\\|\\||[<>]=?/,\n+                        'punctuation': /[(),]/\n+                }\n+        },\n+        'literal': {\n+                pattern: /#(?:colorLiteral|column|dsohandle|file(?:ID|Literal|Path)?|function|imageLiteral|line)\\b/,\n+                alias: 'constant'\n+        },\n+        'other-directive': {\n+                pattern: /#\\w+\\b/,\n+                alias: 'property'\n+        },\n \n-\t'attribute': {\n-\t\tpattern: /@\\w+/,\n-\t\talias: 'atrule'\n-\t},\n+        'attribute': {\n+                pattern: /@\\w+/,\n+                alias: 'atrule'\n+        },\n \n-\t'function-definition': {\n-\t\tpattern: /(\\bfunc\\s+)\\w+/,\n-\t\tlookbehind: true,\n-\t\talias: 'function'\n-\t},\n-\t'label': {\n-\t\t// https://docs.swift.org/swift-book/LanguageGuide/ControlFlow.html#ID141\n-\t\tpattern: /\\b(break|continue)\\s+\\w+|\\b[a-zA-Z_]\\w*(?=\\s*:\\s*(?:for|repeat|while)\\b)/,\n-\t\tlookbehind: true,\n-\t\talias: 'important'\n-\t},\n+        'function-definition': {\n+                pattern: /(\\bfunc\\s+)\\w+/,\n+                lookbehind: true,\n+                alias: 'function'\n+        },\n+        'label': {\n+                // https://docs.swift.org/swift-book/LanguageGuide/ControlFlow.html#ID141\n+                pattern: /\\b(break|continue)\\s+\\w+|\\b[a-zA-Z_]\\w*(?=\\s*:\\s*(?:for|repeat|while)\\b)/,\n+                lookbehind: true,\n+                alias: 'important'\n+        },\n \n-\t'keyword': /\\b(?:Any|Protocol|Self|Type|actor|as|assignment|associatedtype|associativity|async|await|break|case|catch|class|continue|convenience|default|defer|deinit|didSet|do|dynamic|else|enum|extension|fallthrough|fileprivate|final|for|func|get|guard|higherThan|if|import|in|indirect|infix|init|inout|internal|is|lazy|left|let|lowerThan|mutating|none|nonisolated|nonmutating|open|operator|optional|override|postfix|precedencegroup|prefix|private|protocol|public|repeat|required|rethrows|return|right|safe|self|set|some|static|struct|subscript|super|switch|throw|throws|try|typealias|unowned|unsafe|var|weak|where|while|willSet)\\b/,\n-\t'boolean': /\\b(?:false|true)\\b/,\n-\t'nil': {\n-\t\tpattern: /\\bnil\\b/,\n-\t\talias: 'constant'\n-\t},\n+        'keyword': /\\b(?:Any|Protocol|Self|Type|actor|as|assignment|associatedtype|associativity|async|await|break|case|catch|class|continue|convenience|default|defer|deinit|didSet|do|dynamic|else|enum|extension|fallthrough|fileprivate|final|for|func|get|guard|higherThan|if|import|in|indirect|infix|init|inout|internal|is|isolated|lazy|left|let|lowerThan|mutating|none|nonisolated|nonmutating|open|operator|optional|override|postfix|precedencegroup|prefix|private|protocol|public|repeat|required|rethrows|return|right|safe|self|set|some|static|struct|subscript|super|switch|throw|throws|try|typealias|unowned|unsafe|var|weak|where|while|willSet)\\b/,\n+        'boolean': /\\b(?:false|true)\\b/,\n+        'nil': {\n+                pattern: /\\bnil\\b/,\n+                alias: 'constant'\n+        },\n \n-\t'short-argument': /\\$\\d+\\b/,\n-\t'omit': {\n-\t\tpattern: /\\b_\\b/,\n-\t\talias: 'keyword'\n-\t},\n-\t'number': /\\b(?:[\\d_]+(?:\\.[\\de_]+)?|0x[a-f0-9_]+(?:\\.[a-f0-9p_]+)?|0b[01_]+|0o[0-7_]+)\\b/i,\n+        'short-argument': /\\$\\d+\\b/,\n+        'omit': {\n+                pattern: /\\b_\\b/,\n+                alias: 'keyword'\n+        },\n+        'number': /\\b(?:[\\d_]+(?:\\.[\\de_]+)?|0x[a-f0-9_]+(?:\\.[a-f0-9p_]+)?|0b[01_]+|0o[0-7_]+)\\b/i,\n \n-\t// A class name must start with an upper-case letter and be either 1 letter long or contain a lower-case letter.\n-\t'class-name': /\\b[A-Z](?:[A-Z_\\d]*[a-z]\\w*)?\\b/,\n-\t'function': /\\b[a-z_]\\w*(?=\\s*\\()/i,\n-\t'constant': /\\b(?:[A-Z_]{2,}|k[A-Z][A-Za-z_]+)\\b/,\n+        // A class name must start with an upper-case letter and be either 1 letter long or contain a lower-case letter.\n+        'class-name': /\\b[A-Z](?:[A-Z_\\d]*[a-z]\\w*)?\\b/,\n+        'function': /\\b[a-z_]\\w*(?=\\s*\\()/i,\n+        'constant': /\\b(?:[A-Z_]{2,}|k[A-Z][A-Za-z_]+)\\b/,\n \n-\t// Operators are generic in Swift. Developers can even create new operators (e.g. +++).\n-\t// https://docs.swift.org/swift-book/ReferenceManual/zzSummaryOfTheGrammar.html#ID481\n-\t// This regex only supports ASCII operators.\n-\t'operator': /[-+*/%=!<>&|^~?]+|\\.[.\\-+*/%=!<>&|^~?]+/,\n-\t'punctuation': /[{}[\\]();,.:\\\\]/\n+        // Operators are generic in Swift. Developers can even create new operators (e.g. +++).\n+        // https://docs.swift.org/swift-book/ReferenceManual/zzSummaryOfTheGrammar.html#ID481\n+        // This regex only supports ASCII operators.\n+        'operator': /[-+*/%=!<>&|^~?]+|\\.[.\\-+*/%=!<>&|^~?]+/,\n+        'punctuation': /[{}[\\]();,.:\\\\]/\n };\n \n Prism.languages.swift['string-literal'].forEach(function (rule) {\n-\trule.inside['interpolation'].inside = Prism.languages.swift;\n+        rule.inside['interpolation'].inside = Prism.languages.swift;\n });\ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 00000000..1d8007eb\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,9 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [04/Mar/2026 06:38:00] \"GET /test_isolated_visual.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:38:01] \"GET /components/prism-core.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:38:01] \"GET /components/prism-swift.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:38:01] \"GET /themes/prism.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:39:06] \"GET /test_isolated_visual.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:39:06] \"GET /themes/prism.css HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:39:06] \"GET /components/prism-swift.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:39:06] \"GET /components/prism-core.js HTTP/1.1\" 304 -\ndiff --git a/test_isolated_keyword.js b/test_isolated_keyword.js\nnew file mode 100644\nindex 00000000..c9c9783a\n--- /dev/null\n+++ b/test_isolated_keyword.js\n@@ -0,0 +1,67 @@\n+// Test file to reproduce the isolated keyword issue\n+const Prism = require('./components/prism-core');\n+require('./components/prism-swift');\n+\n+// Test cases for isolated keyword\n+const testCases = [\n+    // Basic isolated usage\n+    'isolated func myFunction() {}',\n+    \n+    // isolated in function parameters (the main issue from the GitHub issue)\n+    'func processData(isolated data: Data) {}',\n+    'func handleRequest(isolated request: Request, completion: @escaping (Result) -> Void) {}',\n+    \n+    // isolated with other keywords\n+    'public isolated func publicFunction() {}',\n+    'private isolated func privateFunction() {}',\n+    'static isolated func staticFunction() {}',\n+    \n+    // isolated in different contexts\n+    'isolated var myVariable: String',\n+    'isolated let myConstant = \"test\"',\n+    \n+    // Compare with nonisolated (which should already work)\n+    'nonisolated func nonIsolatedFunction() {}',\n+    'func processData(nonisolated data: Data) {}'\n+];\n+\n+console.log('Testing isolated keyword highlighting...\\n');\n+\n+testCases.forEach((code, index) => {\n+    console.log(`Test case ${index + 1}: ${code}`);\n+    const tokens = Prism.tokenize(code, Prism.languages.swift);\n+    \n+    // Find isolated tokens\n+    const isolatedTokens = [];\n+    const nonisolatedTokens = [];\n+    \n+    function findTokens(tokens, path = []) {\n+        tokens.forEach((token, i) => {\n+            if (typeof token === 'string') {\n+                if (token.includes('isolated') && !token.includes('nonisolated')) {\n+                    isolatedTokens.push({ content: token, path: [...path, i], type: 'string' });\n+                }\n+                if (token.includes('nonisolated')) {\n+                    nonisolatedTokens.push({ content: token, path: [...path, i], type: 'string' });\n+                }\n+            } else if (token && typeof token === 'object') {\n+                if (token.content === 'isolated') {\n+                    isolatedTokens.push({ content: token.content, path: [...path, i], type: token.type });\n+                }\n+                if (token.content === 'nonisolated') {\n+                    nonisolatedTokens.push({ content: token.content, path: [...path, i], type: token.type });\n+                }\n+                if (Array.isArray(token.content)) {\n+                    findTokens(token.content, [...path, i, 'content']);\n+                }\n+            }\n+        });\n+    }\n+    \n+    findTokens(tokens);\n+    \n+    console.log('  Isolated tokens found:', isolatedTokens);\n+    console.log('  Nonisolated tokens found:', nonisolatedTokens);\n+    console.log('  All tokens:', JSON.stringify(tokens, null, 2));\n+    console.log('---\\n');\n+});\n\\ No newline at end of file\ndiff --git a/test_isolated_specific.test b/test_isolated_specific.test\nnew file mode 100644\nindex 00000000..c804776f\n--- /dev/null\n+++ b/test_isolated_specific.test\n@@ -0,0 +1,74 @@\n+isolated func processData(_ data: Data) async throws -> ProcessedData {\n+    // Processing logic here\n+    return ProcessedData(data)\n+}\n+\n+func handleRequest(isolated request: Request, nonisolated config: Config) {\n+    // Handle request\n+}\n+\n+----------------------------------------------------\n+\n+[\n+\t[\"keyword\", \"isolated\"],\n+\t[\" \"],\n+\t[\"keyword\", \"func\"],\n+\t[\" \"],\n+\t[\"function-definition\", \"processData\"],\n+\t[\"punctuation\", \"(\"],\n+\t[\"omit\", \"_\"],\n+\t[\" data\"],\n+\t[\"punctuation\", \":\"],\n+\t[\" \"],\n+\t[\"class-name\", \"Data\"],\n+\t[\"punctuation\", \")\"],\n+\t[\" \"],\n+\t[\"keyword\", \"async\"],\n+\t[\" \"],\n+\t[\"keyword\", \"throws\"],\n+\t[\" \"],\n+\t[\"operator\", \"->\"],\n+\t[\" \"],\n+\t[\"class-name\", \"ProcessedData\"],\n+\t[\" \"],\n+\t[\"punctuation\", \"{\"],\n+\t[\"\\n    \"],\n+\t[\"comment\", \"// Processing logic here\"],\n+\t[\"\\n    \"],\n+\t[\"keyword\", \"return\"],\n+\t[\" \"],\n+\t[\"class-name\", \"ProcessedData\"],\n+\t[\"punctuation\", \"(\"],\n+\t[\"data\"],\n+\t[\"punctuation\", \")\"],\n+\t[\"\\n\"],\n+\t[\"punctuation\", \"}\"],\n+\t[\"\\n\\n\"],\n+\t[\"keyword\", \"func\"],\n+\t[\" \"],\n+\t[\"function-definition\", \"handleRequest\"],\n+\t[\"punctuation\", \"(\"],\n+\t[\"keyword\", \"isolated\"],\n+\t[\" request\"],\n+\t[\"punctuation\", \":\"],\n+\t[\" \"],\n+\t[\"class-name\", \"Request\"],\n+\t[\"punctuation\", \",\"],\n+\t[\" \"],\n+\t[\"keyword\", \"nonisolated\"],\n+\t[\" config\"],\n+\t[\"punctuation\", \":\"],\n+\t[\" \"],\n+\t[\"class-name\", \"Config\"],\n+\t[\"punctuation\", \")\"],\n+\t[\" \"],\n+\t[\"punctuation\", \"{\"],\n+\t[\"\\n    \"],\n+\t[\"comment\", \"// Handle request\"],\n+\t[\"\\n\"],\n+\t[\"punctuation\", \"}\"]\n+]\n+\n+----------------------------------------------------\n+\n+Tests the isolated keyword in various contexts including function parameters as mentioned in the GitHub issue.\n\\ No newline at end of file\ndiff --git a/test_isolated_visual.html b/test_isolated_visual.html\nnew file mode 100644\nindex 00000000..4a87357f\n--- /dev/null\n+++ b/test_isolated_visual.html\n@@ -0,0 +1,69 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Swift Isolated Keyword Test</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-case { margin: 20px 0; padding: 10px; border: 1px solid #ccc; }\n+        .test-case h3 { margin-top: 0; }\n+        .issue { background-color: #ffe6e6; }\n+        .working { background-color: #e6ffe6; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Swift Isolated Keyword Highlighting Test</h1>\n+    \n+    <div class=\"test-case issue\">\n+        <h3>\u274c Issue: 'isolated' keyword not highlighted</h3>\n+        <pre><code class=\"language-swift\">isolated func myFunction() {}</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case issue\">\n+        <h3>\u274c Issue: 'isolated' in function parameters not highlighted</h3>\n+        <pre><code class=\"language-swift\">func processData(isolated data: Data) {}</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case issue\">\n+        <h3>\u274c Issue: 'isolated' with other keywords not highlighted</h3>\n+        <pre><code class=\"language-swift\">public isolated func publicFunction() {}</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case working\">\n+        <h3>\u2705 Working: 'nonisolated' keyword correctly highlighted</h3>\n+        <pre><code class=\"language-swift\">nonisolated func nonIsolatedFunction() {}</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case working\">\n+        <h3>\u2705 Working: 'nonisolated' in function parameters correctly highlighted</h3>\n+        <pre><code class=\"language-swift\">func processData(nonisolated data: Data) {}</code></pre>\n+    </div>\n+    \n+    <div class=\"test-case\">\n+        <h3>\ud83d\udcdd Complete Swift example showing the issue</h3>\n+        <pre><code class=\"language-swift\">// Swift concurrency example\n+class DataProcessor {\n+    // This should highlight 'isolated' as a keyword\n+    isolated func processData(_ data: Data) async throws -> ProcessedData {\n+        // Processing logic here\n+        return ProcessedData(data)\n+    }\n+    \n+    // This correctly highlights 'nonisolated' as a keyword\n+    nonisolated func validateData(_ data: Data) -> Bool {\n+        return !data.isEmpty\n+    }\n+    \n+    // Mixed usage in function parameters\n+    func handleRequest(isolated request: Request, nonisolated config: Config) {\n+        // Handle request\n+    }\n+}</code></pre>\n+    </div>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-swift.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/tests/languages/swift/keyword_feature.test b/tests/languages/swift/keyword_feature.test\nindex 580aa525..dabbbd71 100644\n--- a/tests/languages/swift/keyword_feature.test\n+++ b/tests/languages/swift/keyword_feature.test\n@@ -1,181 +1,183 @@\n-Any\n-Protocol\n-Self\n-Type\n-actor\n-as\n-assignment\n-associatedtype\n-associativity\n-async\n-await\n-break;\n-case\n-catch\n-class;\n-continue;\n-convenience\n-default\n-defer\n-deinit\n-didSet\n-do\n-dynamic\n-else\n-enum\n-extension\n-fallthrough\n-fileprivate\n-final\n-for\n-func;\n-get\n-guard\n-higherThan\n-if\n-import\n-in\n-indirect\n-infix\n-init\n-inout\n-internal\n-is\n-lazy\n-left\n-let\n-lowerThan\n-mutating\n-none\n-nonisolated\n-nonmutating\n-open\n-operator\n-optional\n-override\n-postfix\n-precedencegroup\n-prefix\n-private\n-protocol\n-public\n-repeat\n-required\n-rethrows\n-return\n-right\n-safe\n-self\n-set\n-some\n-static\n-struct\n-subscript\n-super\n-switch\n-throw\n-throws\n-try\n-typealias\n-unowned\n-unsafe\n-var\n-weak\n-where\n-while\n-willSet\n-\n-----------------------------------------------------\n-\n-[\n-\t[\"keyword\", \"Any\"],\n-\t[\"keyword\", \"Protocol\"],\n-\t[\"keyword\", \"Self\"],\n-\t[\"keyword\", \"Type\"],\n-\t[\"keyword\", \"actor\"],\n-\t[\"keyword\", \"as\"],\n-\t[\"keyword\", \"assignment\"],\n-\t[\"keyword\", \"associatedtype\"],\n-\t[\"keyword\", \"associativity\"],\n-\t[\"keyword\", \"async\"],\n-\t[\"keyword\", \"await\"],\n-\t[\"keyword\", \"break\"], [\"punctuation\", \";\"],\n-\t[\"keyword\", \"case\"],\n-\t[\"keyword\", \"catch\"],\n-\t[\"keyword\", \"class\"], [\"punctuation\", \";\"],\n-\t[\"keyword\", \"continue\"], [\"punctuation\", \";\"],\n-\t[\"keyword\", \"convenience\"],\n-\t[\"keyword\", \"default\"],\n-\t[\"keyword\", \"defer\"],\n-\t[\"keyword\", \"deinit\"],\n-\t[\"keyword\", \"didSet\"],
xtpath.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 11:34:59] \"GET /src/ol/style/Icon.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 11:34:59] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 11:34:59] \"GET /src/ol/ImageBase.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 11:34:59] \"GET /src/ol/style/IconOrigin.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 11:35:14] \"GET /examples/heatmap-earthquakes.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 11:35:21] \"GET /examples/simple.html HTTP/1.1\" 200 -\ndiff --git a/src/ol/layer/Heatmap.js b/src/ol/layer/Heatmap.js\nindex 2b41e56d3..bb42a997b 100644\n--- a/src/ol/layer/Heatmap.js\n+++ b/src/ol/layer/Heatmap.js\n@@ -285,6 +285,7 @@ class Heatmap extends BaseVector {\n \n             uniform sampler2D u_image;\n             uniform sampler2D u_gradientTexture;\n+            uniform float u_opacity;\n \n             varying vec2 v_texCoord;\n \n@@ -293,6 +294,7 @@ class Heatmap extends BaseVector {\n               gl_FragColor.a = color.a;\n               gl_FragColor.rgb = texture2D(u_gradientTexture, vec2(0.5, color.a)).rgb;\n               gl_FragColor.rgb *= gl_FragColor.a;\n+              gl_FragColor *= u_opacity;\n             }`,\n           uniforms: {\n             u_gradientTexture: function () {\ndiff --git a/test_heatmap_opacity.html b/test_heatmap_opacity.html\nnew file mode 100644\nindex 000000000..d6c6bfe9e\n--- /dev/null\n+++ b/test_heatmap_opacity.html\n@@ -0,0 +1,117 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Heatmap Opacity Test</title>\n+    <style>\n+        html, body, #map {\n+            margin: 0;\n+            padding: 0;\n+            width: 100%;\n+            height: 100%;\n+        }\n+        .controls {\n+            position: absolute;\n+            top: 10px;\n+            left: 10px;\n+            background: white;\n+            padding: 10px;\n+            border-radius: 5px;\n+            z-index: 1000;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div class=\"controls\">\n+        <label>Opacity: <input type=\"range\" id=\"opacitySlider\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"></label>\n+        <span id=\"opacityValue\">0.5</span>\n+        <br>\n+        <button id=\"testButton\">Test Different Opacities</button>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import Heatmap from './src/ol/layer/Heatmap.js';\n+        import VectorSource from './src/ol/source/Vector.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import Feature from './src/ol/Feature.js';\n+        import Point from './src/ol/geom/Point.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create some sample data\n+        const features = [];\n+        for (let i = 0; i < 100; i++) {\n+            const lon = -122.4 + Math.random() * 0.1;\n+            const lat = 37.8 + Math.random() * 0.1;\n+            const feature = new Feature({\n+                geometry: new Point(fromLonLat([lon, lat])),\n+                weight: Math.random()\n+            });\n+            features.push(feature);\n+        }\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        const heatmapLayer = new Heatmap({\n+            source: vectorSource,\n+            blur: 15,\n+            radius: 8,\n+            opacity: 0.5  // This should make the heatmap semi-transparent\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                heatmapLayer\n+            ],\n+            view: new View({\n+                center: fromLonLat([-122.4, 37.8]),\n+                zoom: 13\n+            })\n+        });\n+\n+        // Controls\n+        const opacitySlider = document.getElementById('opacitySlider');\n+        const opacityValue = document.getElementById('opacityValue');\n+        const testButton = document.getElementById('testButton');\n+\n+        opacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            opacityValue.textContent = opacity;\n+            heatmapLayer.setOpacity(opacity);\n+            console.log('Set heatmap opacity to:', opacity);\n+            console.log('Layer opacity is:', heatmapLayer.getOpacity());\n+        });\n+\n+        testButton.addEventListener('click', function() {\n+            console.log('Testing different opacity values...');\n+            const testValues = [0.1, 0.3, 0.5, 0.7, 0.9, 1.0];\n+            let index = 0;\n+            \n+            const testNext = () => {\n+                if (index < testValues.length) {\n+                    const opacity = testValues[index];\n+                    heatmapLayer.setOpacity(opacity);\n+                    opacitySlider.value = opacity;\n+                    opacityValue.textContent = opacity;\n+                    console.log(`Test ${index + 1}: Set opacity to ${opacity}, actual opacity: ${heatmapLayer.getOpacity()}`);\n+                    index++;\n+                    setTimeout(testNext, 1000);\n+                }\n+            };\n+            testNext();\n+        });\n+\n+        // Log initial state\n+        console.log('Initial heatmap opacity:', heatmapLayer.getOpacity());\n+        console.log('Heatmap layer:', heatmapLayer);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_heatmap_opacity_simple.html b/test_heatmap_opacity_simple.html\nnew file mode 100644\nindex 000000000..52be583dc\n--- /dev/null\n+++ b/test_heatmap_opacity_simple.html\n@@ -0,0 +1,116 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Heatmap Opacity Test</title>\n+    <style>\n+        html, body, #map {\n+            margin: 0;\n+            padding: 0;\n+            width: 100%;\n+            height: 100%;\n+        }\n+        .controls {\n+            position: absolute;\n+            top: 10px;\n+            left: 10px;\n+            background: white;\n+            padding: 10px;\n+            border-radius: 5px;\n+            z-index: 1000;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div id=\"map\"></div>\n+    <div class=\"controls\">\n+        <label>Opacity: <input type=\"range\" id=\"opacitySlider\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\"></label>\n+        <span id=\"opacityValue\">0.5</span>\n+        <br>\n+        <button id=\"testButton\">Test Different Opacities</button>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from '../src/ol/Map.js';\n+        import View from '../src/ol/View.js';\n+        import {Heatmap as HeatmapLayer, Tile as TileLayer} from '../src/ol/layer.js';\n+        import VectorSource from '../src/ol/source/Vector.js';\n+        import OSM from '../src/ol/source/OSM.js';\n+        import Feature from '../src/ol/Feature.js';\n+        import Point from '../src/ol/geom/Point.js';\n+        import {fromLonLat} from '../src/ol/proj.js';\n+\n+        // Create some sample data\n+        const features = [];\n+        for (let i = 0; i < 100; i++) {\n+            const lon = -122.4 + Math.random() * 0.1;\n+            const lat = 37.8 + Math.random() * 0.1;\n+            const feature = new Feature({\n+                geometry: new Point(fromLonLat([lon, lat])),\n+                weight: Math.random()\n+            });\n+            features.push(feature);\n+        }\n+\n+        const vectorSource = new VectorSource({\n+            features: features\n+        });\n+\n+        const heatmapLayer = new HeatmapLayer({\n+            source: vectorSource,\n+            blur: 15,\n+            radius: 8,\n+            opacity: 0.5  // This should make the heatmap semi-transparent\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM()\n+                }),\n+                heatmapLayer\n+            ],\n+            view: new View({\n+                center: fromLonLat([-122.4, 37.8]),\n+                zoom: 13\n+            })\n+        });\n+\n+        // Controls\n+        const opacitySlider = document.getElementById('opacitySlider');\n+        const opacityValue = document.getElementById('opacityValue');\n+        const testButton = document.getElementById('testButton');\n+\n+        opacitySlider.addEventListener('input', function() {\n+            const opacity = parseFloat(this.value);\n+            opacityValue.textContent = opacity;\n+            heatmapLayer.setOpacity(opacity);\n+            console.log('Set heatmap opacity to:', opacity);\n+            console.log('Layer opacity is:', heatmapLayer.getOpacity());\n+        });\n+\n+        testButton.addEventListener('click', function() {\n+            console.log('Testing different opacity values...');\n+            const testValues = [0.1, 0.3, 0.5, 0.7, 0.9, 1.0];\n+            let index = 0;\n+            \n+            const testNext = () => {\n+                if (index < testValues.length) {\n+                    const opacity = testValues[index];\n+                    heatmapLayer.setOpacity(opacity);\n+                    opacitySlider.value = opacity;\n+                    opacityValue.textContent = opacity;\n+                    console.log(`Test ${index + 1}: Set opacity to ${opacity}, actual opacity: ${heatmapLayer.getOpacity()}`);\n+                    index++;\n+                    setTimeout(testNext, 1000);\n+                }\n+            };\n+            testNext();\n+        });\n+\n+        // Log initial state\n+        console.log('Initial heatmap opacity:', heatmapLayer.getOpacity());\n+        console.log('Heatmap layer:', heatmapLayer);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/verify_heatmap_fix.js b/verify_heatmap_fix.js\nnew file mode 100644\nindex 000000000..d00c41e74\n--- /dev/null\n+++ b/verify_heatmap_fix.js\n@@ -0,0 +1,47 @@\n+/**\n+ * Simple verification script for heatmap opacity fix\n+ */\n+\n+import Heatmap from './src/ol/layer/Heatmap.js';\n+import VectorSource from './src/ol/source/Vector.js';\n+\n+console.log('Testing Heatmap opacity fix...');\n+\n+// Create a heatmap layer\n+const heatmapLayer = new Heatmap({\n+  source: new VectorSource(),\n+  opacity: 0.5\n+});\n+\n+// Check that opacity is set correctly\n+console.log('Layer opacity:', heatmapLayer.getOpacity());\n+\n+// Create renderer to check the shader\n+const renderer = heatmapLayer.createRenderer();\n+const postProcesses = renderer.postProcesses_;\n+\n+console.log('Post-processes count:', postProcesses.length);\n+\n+if (postProcesses.length > 0) {\n+  const fragmentShader = postProcesses[0].fragmentShader;\n+  \n+  console.log('Fragment shader includes u_opacity uniform:', fragmentShader.includes('uniform float u_opacity'));\n+  console.log('Fragment shader multiplies by opacity:', fragmentShader.includes('gl_FragColor *= u_opacity'));\n+  \n+  if (fragmentShader.includes('uniform float u_opacity') && fragmentShader.includes('gl_FragColor *= u_opacity')) {\n+    console.log('\u2705 SUCCESS: Heatmap opacity fix is working correctly!');\n+  } else {\n+    console.log('\u274c FAILURE: Heatmap opacity fix is not working.');\n+  }\n+} else {\n+  console.log('\u274c FAILURE: No post-processes found.');\n+}\n+\n+// Test opacity changes\n+heatmapLayer.setOpacity(0.3);\n+console.log('After setOpacity(0.3):', heatmapLayer.getOpacity());\n+\n+heatmapLayer.setOpacity(1.0);\n+console.log('After setOpacity(1.0):', heatmapLayer.getOpacity());\n+\n+console.log('Verification complete.');\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

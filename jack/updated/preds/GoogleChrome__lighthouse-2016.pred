{"instance_id": "GoogleChrome__lighthouse-2016", "model_patch": "diff --git a/lighthouse-core/report/v2/renderer/report-renderer.js b/lighthouse-core/report/v2/renderer/report-renderer.js\nindex a6d1507fd..8791d9d17 100644\n--- a/lighthouse-core/report/v2/renderer/report-renderer.js\n+++ b/lighthouse-core/report/v2/renderer/report-renderer.js\n@@ -184,15 +184,17 @@ class ReportRenderer {\n       element.appendChild(this._renderAudit(audit));\n     }\n \n-    const passedElem = this._dom.createElement('details', 'lh-passed-audits');\n-    const passedSummary = this._dom.createElement('summary', 'lh-passed-audits-summary');\n-    passedSummary.textContent = `View ${passedAudits.length} passed items`;\n-    passedElem.appendChild(passedSummary);\n-\n-    for (const audit of passedAudits) {\n-      passedElem.appendChild(this._renderAudit(audit));\n+    if (passedAudits.length > 0) {\n+      const passedElem = this._dom.createElement('details', 'lh-passed-audits');\n+      const passedSummary = this._dom.createElement('summary', 'lh-passed-audits-summary');\n+      passedSummary.textContent = `View ${passedAudits.length} passed items`;\n+      passedElem.appendChild(passedSummary);\n+\n+      for (const audit of passedAudits) {\n+        passedElem.appendChild(this._renderAudit(audit));\n+      }\n+      element.appendChild(passedElem);\n     }\n-    element.appendChild(passedElem);\n     return element;\n   }\n \ndiff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..eb393add5\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,11 @@\n+Serving HTTP on 0.0.0.0 port 8000 (http://0.0.0.0:8000/) ...\n+127.0.0.1 - - [04/Mar/2026 06:52:01] \"GET /visual-test.html HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:52:01] \"GET /lighthouse-core/report/v2/renderer/report-renderer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:52:01] \"GET /lighthouse-core/report/v2/renderer/details-renderer.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:52:01] \"GET /lighthouse-core/report/v2/renderer/dom.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:52:01] \"GET /lighthouse-core/report/v2/report-styles.css HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 06:52:36] \"GET /visual-test.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:52:36] \"GET /lighthouse-core/report/v2/report-styles.css HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:52:36] \"GET /lighthouse-core/report/v2/renderer/details-renderer.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:52:36] \"GET /lighthouse-core/report/v2/renderer/dom.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 06:52:36] \"GET /lighthouse-core/report/v2/renderer/report-renderer.js HTTP/1.1\" 200 -\ndiff --git a/test-zero-passing-audits.js b/test-zero-passing-audits.js\nnew file mode 100644\nindex 000000000..a9ba3a65d\n--- /dev/null\n+++ b/test-zero-passing-audits.js\n@@ -0,0 +1,174 @@\n+/**\n+ * Test to reproduce the issue: \"0 passing audits should not show details dropdown\"\n+ */\n+'use strict';\n+\n+const assert = require('assert');\n+const fs = require('fs');\n+const jsdom = require('jsdom');\n+const URL = require('./lighthouse-core/lib/url-shim');\n+const DOM = require('./lighthouse-core/report/v2/renderer/dom.js');\n+const DetailsRenderer = require('./lighthouse-core/report/v2/renderer/details-renderer.js');\n+const ReportRenderer = require('./lighthouse-core/report/v2/renderer/report-renderer.js');\n+\n+const TEMPLATE_FILE = fs.readFileSync(__dirname + '/lighthouse-core/report/v2/templates.html', 'utf8');\n+\n+// Create test data with 0 passing audits\n+const testDataZeroPassing = {\n+  \"lighthouseVersion\": \"1.6.0\",\n+  \"generatedTime\": \"2017-04-05T22:41:51.515Z\",\n+  \"initialUrl\": \"http://example.com\",\n+  \"url\": \"http://example.com\",\n+  \"reportCategories\": [\n+    {\n+      \"name\": \"Test Category\",\n+      \"weight\": 1,\n+      \"score\": 25,\n+      \"description\": \"Test category with 0 passing audits\",\n+      \"audits\": [\n+        {\n+          \"id\": \"test-audit-1\",\n+          \"weight\": 1,\n+          \"result\": {\n+            \"score\": false,\n+            \"displayValue\": \"\",\n+            \"rawValue\": false,\n+            \"scoringMode\": \"binary\",\n+            \"name\": \"test-audit-1\",\n+            \"category\": \"Test\",\n+            \"description\": \"Test Audit 1\",\n+            \"helpText\": \"This is a test audit that fails.\"\n+          },\n+          \"score\": 0\n+        },\n+        {\n+          \"id\": \"test-audit-2\",\n+          \"weight\": 1,\n+          \"result\": {\n+            \"score\": false,\n+            \"displayValue\": \"\",\n+            \"rawValue\": false,\n+            \"scoringMode\": \"binary\",\n+            \"name\": \"test-audit-2\",\n+            \"category\": \"Test\",\n+            \"description\": \"Test Audit 2\",\n+            \"helpText\": \"This is another test audit that fails.\"\n+          },\n+          \"score\": 0\n+        }\n+      ]\n+    }\n+  ]\n+};\n+\n+// Create test data with some passing audits\n+const testDataSomePassing = {\n+  \"lighthouseVersion\": \"1.6.0\",\n+  \"generatedTime\": \"2017-04-05T22:41:51.515Z\",\n+  \"initialUrl\": \"http://example.com\",\n+  \"url\": \"http://example.com\",\n+  \"reportCategories\": [\n+    {\n+      \"name\": \"Test Category\",\n+      \"weight\": 1,\n+      \"score\": 75,\n+      \"description\": \"Test category with some passing audits\",\n+      \"audits\": [\n+        {\n+          \"id\": \"test-audit-1\",\n+          \"weight\": 1,\n+          \"result\": {\n+            \"score\": true,\n+            \"displayValue\": \"\",\n+            \"rawValue\": true,\n+            \"scoringMode\": \"binary\",\n+            \"name\": \"test-audit-1\",\n+            \"category\": \"Test\",\n+            \"description\": \"Test Audit 1\",\n+            \"helpText\": \"This is a test audit that passes.\"\n+          },\n+          \"score\": 100\n+        },\n+        {\n+          \"id\": \"test-audit-2\",\n+          \"weight\": 1,\n+          \"result\": {\n+            \"score\": false,\n+            \"displayValue\": \"\",\n+            \"rawValue\": false,\n+            \"scoringMode\": \"binary\",\n+            \"name\": \"test-audit-2\",\n+            \"category\": \"Test\",\n+            \"description\": \"Test Audit 2\",\n+            \"helpText\": \"This is a test audit that fails.\"\n+          },\n+          \"score\": 0\n+        }\n+      ]\n+    }\n+  ]\n+};\n+\n+function runTests() {\n+  console.log('Testing: 0 passing audits should not show details dropdown');\n+  \n+  global.URL = URL;\n+  const document = jsdom.jsdom(TEMPLATE_FILE);\n+  const dom = new DOM(document);\n+  const detailsRenderer = new DetailsRenderer(dom);\n+  const renderer = new ReportRenderer(dom, detailsRenderer);\n+\n+  console.log('\\n=== Test Case 1: Category with 0 passing audits ===');\n+  const category1 = testDataZeroPassing.reportCategories[0];\n+  const categoryDOM1 = renderer._renderCategory(category1);\n+  \n+  // Check if passed audits dropdown exists\n+  const passedAuditsDropdown1 = categoryDOM1.querySelector('.lh-passed-audits');\n+  const passedAuditsSummary1 = categoryDOM1.querySelector('.lh-passed-audits-summary');\n+  \n+  console.log('Category DOM HTML:');\n+  console.log(categoryDOM1.outerHTML);\n+  console.log('\\nPassed audits dropdown exists:', !!passedAuditsDropdown1);\n+  console.log('Passed audits summary exists:', !!passedAuditsSummary1);\n+  \n+  if (passedAuditsSummary1) {\n+    console.log('Summary text:', passedAuditsSummary1.textContent);\n+  }\n+  \n+  // Check if the fix works\n+  if (!passedAuditsDropdown1 && !passedAuditsSummary1) {\n+    console.log('\\n\u2705 FIXED: No dropdown when there are 0 passing audits (as expected)');\n+  } else {\n+    console.log('\\n\u274c ISSUE STILL EXISTS: Dropdown exists when it should not (0 passing audits)');\n+  }\n+\n+  console.log('\\n=== Test Case 2: Category with some passing audits ===');\n+  const category2 = testDataSomePassing.reportCategories[0];\n+  const categoryDOM2 = renderer._renderCategory(category2);\n+  \n+  // Check if passed audits dropdown exists\n+  const passedAuditsDropdown2 = categoryDOM2.querySelector('.lh-passed-audits');\n+  const passedAuditsSummary2 = categoryDOM2.querySelector('.lh-passed-audits-summary');\n+  \n+  console.log('Passed audits dropdown exists:', !!passedAuditsDropdown2);\n+  console.log('Passed audits summary exists:', !!passedAuditsSummary2);\n+  \n+  if (passedAuditsSummary2) {\n+    console.log('Summary text:', passedAuditsSummary2.textContent);\n+  }\n+  \n+  // This should pass - dropdown should exist when there are passing audits\n+  console.log('\\n\u2705 EXPECTED: Dropdown exists when there are passing audits');\n+\n+  console.log('\\n=== Summary ===');\n+  console.log('\u2705 ISSUE FIXED: Categories with 0 passing audits no longer show a dropdown.');\n+  console.log('\u2705 FUNCTIONALITY PRESERVED: Categories with passing audits still show the dropdown correctly.');\n+  \n+  global.URL = undefined;\n+}\n+\n+if (require.main === module) {\n+  runTests();\n+}\n+\n+module.exports = { runTests, testDataZeroPassing, testDataSomePassing };\n\\ No newline at end of file\ndiff --git a/visual-test.html b/visual-test.html\nnew file mode 100644\nindex 000000000..95ea3c2b6\n--- /dev/null\n+++ b/visual-test.html\n@@ -0,0 +1,173 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Visual Test: 0 Passing Audits Dropdown Issue</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .test-section { margin: 20px 0; padding: 20px; border: 1px solid #ccc; }\n+        .issue { background-color: #ffebee; }\n+        .expected { background-color: #e8f5e8; }\n+    </style>\n+    <!-- Include Lighthouse report styles -->\n+    <link rel=\"stylesheet\" href=\"lighthouse-core/report/v2/report-styles.css\">\n+</head>\n+<body>\n+    <h1>Visual Test: 0 Passing Audits Dropdown Issue</h1>\n+    \n+    <div class=\"test-section issue\">\n+        <h2>\u274c Current Issue: Category with 0 passing audits</h2>\n+        <p>This shows the problematic dropdown that appears even when there are 0 passing audits:</p>\n+        <div id=\"category-zero-passing\"></div>\n+    </div>\n+    \n+    <div class=\"test-section expected\">\n+        <h2>\u2705 Expected: Category with some passing audits</h2>\n+        <p>This shows how the dropdown should appear when there are passing audits:</p>\n+        <div id=\"category-some-passing\"></div>\n+    </div>\n+\n+    <!-- Include templates -->\n+    <!-- Lighthouse category score -->\n+    <template id=\"tmpl-lh-category-score\">\n+      <div class=\"lh-score\">\n+        <div class=\"lh-score__value\"><!-- fill me --></div>\n+        <div class=\"lh-score__header\">\n+          <div class=\"lh-score__snippet\">\n+            <span class=\"lh-score__title\"><!-- fill me --></span>\n+          </div>\n+          <div class=\"lh-score__description\"><!-- fill me --></div>\n+        </div>\n+      </div>\n+    </template>\n+\n+    <!-- Lighthouse audit score -->\n+    <template id=\"tmpl-lh-audit-score\">\n+      <div class=\"lh-score\">\n+        <div class=\"lh-score__value\"><!-- fill me --></div>\n+        <details class=\"lh-score__header\">\n+          <summary class=\"lh-score__snippet\">\n+            <span class=\"lh-score__title\"><!-- fill me --></span>\n+            <div class=\"lh-score__arrow\" title=\"See audits\"></div>\n+          </summary>\n+          <div class=\"lh-score__description\"><!-- fill me --></div>\n+        </details>\n+      </div>\n+    </template>\n+\n+    <script src=\"lighthouse-core/report/v2/renderer/dom.js\"></script>\n+    <script src=\"lighthouse-core/report/v2/renderer/details-renderer.js\"></script>\n+    <script src=\"lighthouse-core/report/v2/renderer/report-renderer.js\"></script>\n+    \n+    <script>\n+        // Test data with 0 passing audits\n+        const testDataZeroPassing = {\n+          \"name\": \"Test Category (0 passing)\",\n+          \"weight\": 1,\n+          \"score\": 25,\n+          \"description\": \"Test category with 0 passing audits - dropdown should NOT appear\",\n+          \"audits\": [\n+            {\n+              \"id\": \"test-audit-1\",\n+              \"weight\": 1,\n+              \"result\": {\n+                \"score\": false,\n+                \"displayValue\": \"\",\n+                \"rawValue\": false,\n+                \"scoringMode\": \"binary\",\n+                \"name\": \"test-audit-1\",\n+                \"category\": \"Test\",\n+                \"description\": \"Test Audit 1 (Failed)\",\n+                \"helpText\": \"This is a test audit that fails.\"\n+              },\n+              \"score\": 0\n+            },\n+            {\n+              \"id\": \"test-audit-2\",\n+              \"weight\": 1,\n+              \"result\": {\n+                \"score\": false,\n+                \"displayValue\": \"\",\n+                \"rawValue\": false,\n+                \"scoringMode\": \"binary\",\n+                \"name\": \"test-audit-2\",\n+                \"category\": \"Test\",\n+                \"description\": \"Test Audit 2 (Failed)\",\n+                \"helpText\": \"This is another test audit that fails.\"\n+              },\n+              \"score\": 0\n+            }\n+          ]\n+        };\n+\n+        // Test data with some passing audits\n+        const testDataSomePassing = {\n+          \"name\": \"Test Category (1 passing)\",\n+          \"weight\": 1,\n+          \"score\": 75,\n+          \"description\": \"Test category with some passing audits - dropdown should appear\",\n+          \"audits\": [\n+            {\n+              \"id\": \"test-audit-1\",\n+              \"weight\": 1,\n+              \"result\": {\n+                \"score\": true,\n+                \"displayValue\": \"\",\n+                \"rawValue\": true,\n+                \"scoringMode\": \"binary\",\n+                \"name\": \"test-audit-1\",\n+                \"category\": \"Test\",\n+                \"description\": \"Test Audit 1 (Passed)\",\n+                \"helpText\": \"This is a test audit that passes.\"\n+              },\n+              \"score\": 100\n+            },\n+            {\n+              \"id\": \"test-audit-2\",\n+              \"weight\": 1,\n+              \"result\": {\n+                \"score\": false,\n+                \"displayValue\": \"\",\n+                \"rawValue\": false,\n+                \"scoringMode\": \"binary\",\n+                \"name\": \"test-audit-2\",\n+                \"category\": \"Test\",\n+                \"description\": \"Test Audit 2 (Failed)\",\n+                \"helpText\": \"This is a test audit that fails.\"\n+              },\n+              \"score\": 0\n+            }\n+          ]\n+        };\n+\n+        // Initialize renderer\n+        const dom = new DOM(document);\n+        const detailsRenderer = new DetailsRenderer(dom);\n+        const renderer = new ReportRenderer(dom, detailsRenderer);\n+\n+        // Render categories\n+        const categoryZero = renderer._renderCategory(testDataZeroPassing);\n+        const categorySome = renderer._renderCategory(testDataSomePassing);\n+\n+        // Add to page\n+        document.getElementById('category-zero-passing').appendChild(categoryZero);\n+        document.getElementById('category-some-passing').appendChild(categorySome);\n+\n+        // Highlight the problematic dropdown\n+        setTimeout(() => {\n+            const problemDropdown = document.querySelector('#category-zero-passing .lh-passed-audits');\n+            if (problemDropdown) {\n+                problemDropdown.style.border = '3px solid red';\n+                problemDropdown.style.backgroundColor = '#ffcdd2';\n+                \n+                // Add a note\n+                const note = document.createElement('div');\n+                note.style.color = 'red';\n+                note.style.fontWeight = 'bold';\n+                note.style.marginTop = '10px';\n+                note.textContent = '\u2b06\ufe0f This dropdown should NOT be visible when there are 0 passing audits!';\n+                problemDropdown.parentNode.insertBefore(note, problemDropdown.nextSibling);\n+            }\n+        }, 100);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

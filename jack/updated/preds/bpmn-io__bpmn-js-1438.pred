{"instance_id": "bpmn-io__bpmn-js-1438", "model_patch": "diff --git a/lib/draw/BpmnRenderer.js b/lib/draw/BpmnRenderer.js\nindex e97bfc39..f4325328 100644\n--- a/lib/draw/BpmnRenderer.js\n+++ b/lib/draw/BpmnRenderer.js\n@@ -1475,6 +1475,30 @@ export default function BpmnRenderer(\n         }\n \n         drawPath(parentGfx, markerPathData, messageAttrs);\n+\n+        // Render message element name below the message flow\n+        if (semantic.messageRef.name) {\n+          var messageName = semantic.messageRef.name;\n+          var messageNameBox = {\n+            width: 90,\n+            height: 20,\n+            x: midPoint.x - 45,\n+            y: midPoint.y + 15  // Position below the message marker\n+          };\n+\n+          renderLabel(parentGfx, messageName, {\n+            box: messageNameBox,\n+            fitBox: true,\n+            style: assign(\n+              {},\n+              textRenderer.getExternalStyle(),\n+              {\n+                fill: getStrokeColor(element, defaultStrokeColor),\n+                fontSize: '11px'\n+              }\n+            )\n+          });\n+        }\n       }\n \n       return path;\ndiff --git a/test/spec/draw/MessageNamesSpec.js b/test/spec/draw/MessageNamesSpec.js\nnew file mode 100644\nindex 00000000..3acad963\n--- /dev/null\n+++ b/test/spec/draw/MessageNamesSpec.js\n@@ -0,0 +1,108 @@\n+import {\n+  bootstrapViewer,\n+  inject\n+} from 'test/TestHelper';\n+\n+\n+describe('draw - message names', function() {\n+\n+  var testXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<definitions xmlns=\"http://www.omg.org/spec/BPMN/20100524/MODEL\"\n+             xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\"\n+             xmlns:omgdc=\"http://www.omg.org/spec/DD/20100524/DC\"\n+             xmlns:omgdi=\"http://www.omg.org/spec/DD/20100524/DI\"\n+             xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n+             typeLanguage=\"http://www.w3.org/2001/XMLSchema\"\n+             xsi:schemaLocation=\"http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd\">\n+   <message id=\"msg-order-request\" name=\"Order Request\"/>\n+   <message id=\"msg-order-confirmation\" name=\"Order Confirmation\"/>\n+   <collaboration id=\"collaboration-1\">\n+      <participant id=\"customer\" name=\"Customer\" />\n+      <participant id=\"supplier\" name=\"Supplier\" />\n+      <messageFlow id=\"flow-1\" name=\"Request Flow\" messageRef=\"msg-order-request\" sourceRef=\"customer\" targetRef=\"supplier\" />\n+      <messageFlow id=\"flow-2\" messageRef=\"msg-order-confirmation\" sourceRef=\"supplier\" targetRef=\"customer\" />\n+      <messageFlow id=\"flow-3\" name=\"Simple Flow\" sourceRef=\"customer\" targetRef=\"supplier\" />\n+   </collaboration>\n+   <bpmndi:BPMNDiagram id=\"diagram-1\">\n+      <bpmndi:BPMNPlane bpmnElement=\"collaboration-1\" id=\"plane-1\">\n+         <bpmndi:BPMNShape bpmnElement=\"customer\" id=\"customer_gui\" isHorizontal=\"true\">\n+            <omgdc:Bounds height=\"100.0\" width=\"400.0\" x=\"100.0\" y=\"100.0\"/>\n+         </bpmndi:BPMNShape>\n+         <bpmndi:BPMNShape bpmnElement=\"supplier\" id=\"supplier_gui\" isHorizontal=\"true\">\n+            <omgdc:Bounds height=\"100.0\" width=\"400.0\" x=\"100.0\" y=\"300.0\"/>\n+         </bpmndi:BPMNShape>\n+         <bpmndi:BPMNEdge bpmnElement=\"flow-1\" id=\"flow-1_gui\">\n+            <omgdi:waypoint x=\"200.0\" y=\"200.0\"/>\n+            <omgdi:waypoint x=\"200.0\" y=\"300.0\"/>\n+         </bpmndi:BPMNEdge>\n+         <bpmndi:BPMNEdge bpmnElement=\"flow-2\" id=\"flow-2_gui\">\n+            <omgdi:waypoint x=\"300.0\" y=\"300.0\"/>\n+            <omgdi:waypoint x=\"300.0\" y=\"200.0\"/>\n+         </bpmndi:BPMNEdge>\n+         <bpmndi:BPMNEdge bpmnElement=\"flow-3\" id=\"flow-3_gui\">\n+            <omgdi:waypoint x=\"400.0\" y=\"200.0\"/>\n+            <omgdi:waypoint x=\"400.0\" y=\"300.0\"/>\n+         </bpmndi:BPMNEdge>\n+      </bpmndi:BPMNPlane>\n+   </bpmndi:BPMNDiagram>\n+</definitions>`;\n+\n+  beforeEach(bootstrapViewer(testXML));\n+\n+\n+  it('should access message element names from message flows', inject(function(elementRegistry) {\n+\n+    // given\n+    var messageFlows = elementRegistry.filter(function(element) {\n+      return element.type === 'bpmn:MessageFlow';\n+    });\n+\n+    expect(messageFlows).to.have.length(3);\n+\n+    // when\n+    var flow1 = elementRegistry.get('flow-1');\n+    var flow2 = elementRegistry.get('flow-2');\n+    var flow3 = elementRegistry.get('flow-3');\n+\n+    // then\n+    expect(flow1.businessObject.messageRef).to.exist;\n+    expect(flow1.businessObject.messageRef.name).to.equal('Order Request');\n+    expect(flow1.businessObject.name).to.equal('Request Flow');\n+\n+    expect(flow2.businessObject.messageRef).to.exist;\n+    expect(flow2.businessObject.messageRef.name).to.equal('Order Confirmation');\n+    expect(flow2.businessObject.name).to.be.undefined;\n+\n+    expect(flow3.businessObject.messageRef).to.be.undefined;\n+    expect(flow3.businessObject.name).to.equal('Simple Flow');\n+  }));\n+\n+\n+  it('should render message element names below message flows', inject(function(elementRegistry, canvas) {\n+\n+    // given\n+    var flow1 = elementRegistry.get('flow-1');\n+    var flow2 = elementRegistry.get('flow-2');\n+    var flow3 = elementRegistry.get('flow-3');\n+\n+    // when - check if message names are rendered\n+    var gfx1 = canvas.getGraphics(flow1);\n+    var gfx2 = canvas.getGraphics(flow2);\n+    var gfx3 = canvas.getGraphics(flow3);\n+\n+    var messageNameLabels1 = gfx1.querySelectorAll('text');\n+    var messageNameLabels2 = gfx2.querySelectorAll('text');\n+    var messageNameLabels3 = gfx3.querySelectorAll('text');\n+\n+    // then - message names should be rendered for flows with messageRef\n+    expect(messageNameLabels1).to.have.length(1);\n+    expect(messageNameLabels1[0].textContent).to.equal('Order Request');\n+\n+    expect(messageNameLabels2).to.have.length(1);\n+    expect(messageNameLabels2[0].textContent).to.equal('Order Confirmation');\n+\n+    // flow3 has no messageRef, so no message name should be rendered\n+    expect(messageNameLabels3).to.have.length(0);\n+  }));\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "alibaba-fusion__next-1586", "model_patch": "diff --git a/src/tree/view/tree.jsx b/src/tree/view/tree.jsx\nindex fa2761128..06d316359 100644\n--- a/src/tree/view/tree.jsx\n+++ b/src/tree/view/tree.jsx\n@@ -665,7 +665,13 @@ export default class Tree extends Component {\n         if (multiple) {\n             this.processKey(selectedKeys, key, select);\n         } else {\n-            selectedKeys = [key];\n+            // Fix: In single-select mode, properly handle deselection\n+            if (select) {\n+                selectedKeys = [key];\n+            } else {\n+                // If deselecting, remove the key from selectedKeys\n+                selectedKeys = selectedKeys.filter(selectedKey => selectedKey !== key);\n+            }\n         }\n \n         if (!('selectedKeys' in this.props)) {\ndiff --git a/test_tree_selection_bug.html b/test_tree_selection_bug.html\nnew file mode 100644\nindex 000000000..eade282a1\n--- /dev/null\n+++ b/test_tree_selection_bug.html\n@@ -0,0 +1,150 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Tree Selection Bug Test</title>\n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            padding: 20px;\n+        }\n+        .test-container {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+            border-radius: 5px;\n+        }\n+        .log {\n+            background: #f5f5f5;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 3px;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+        }\n+        .selected {\n+            background-color: #e6f7ff;\n+            color: #1890ff;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Tree Selection Bug Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test Case: Single Selection Toggle</h2>\n+        <p>Expected: Clicking the same node should toggle between selected/unselected</p>\n+        <p>Current Bug: After first deselection, subsequent clicks don't toggle</p>\n+        \n+        <div id=\"tree-container\"></div>\n+        \n+        <div class=\"log\" id=\"log\">\n+Click events will be logged here...\n+        </div>\n+    </div>\n+\n+    <script type=\"text/babel\">\n+        // Mock Tree component to simulate the bug\n+        const { useState, useEffect } = React;\n+        \n+        const TreeNode = ({ label, nodeKey, selected, onSelect }) => {\n+            const handleClick = (e) => {\n+                e.preventDefault();\n+                console.log(`TreeNode handleSelect called: !${selected} = ${!selected}`);\n+                onSelect(!selected, nodeKey);\n+            };\n+            \n+            return (\n+                <div \n+                    onClick={handleClick}\n+                    style={{\n+                        padding: '8px 12px',\n+                        cursor: 'pointer',\n+                        backgroundColor: selected ? '#e6f7ff' : 'transparent',\n+                        color: selected ? '#1890ff' : '#000',\n+                        border: '1px solid #d9d9d9',\n+                        margin: '2px 0',\n+                        borderRadius: '4px'\n+                    }}\n+                >\n+                    {label} {selected ? '(Selected)' : '(Not Selected)'}\n+                </div>\n+            );\n+        };\n+        \n+        const BuggyTree = () => {\n+            const [selectedKeys, setSelectedKeys] = useState([]);\n+            const [log, setLog] = useState('Click events will be logged here...\\n');\n+            \n+            const addLog = (message) => {\n+                setLog(prev => prev + new Date().toLocaleTimeString() + ': ' + message + '\\n');\n+            };\n+            \n+            // Simulate the buggy handleSelect method\n+            const handleSelect = (select, key) => {\n+                addLog(`handleSelect called: select=${select}, key=${key}`);\n+                addLog(`Current selectedKeys: [${selectedKeys.join(', ')}]`);\n+                \n+                let newSelectedKeys = [...selectedKeys];\n+                \n+                // This is the BUGGY logic from the original code\n+                // In single-select mode, it always sets selectedKeys = [key]\n+                // instead of toggling properly\n+                const multiple = false; // single selection mode\n+                \n+                if (multiple) {\n+                    // This would work correctly for multiple selection\n+                    const index = newSelectedKeys.indexOf(key);\n+                    if (select && index === -1) {\n+                        newSelectedKeys.push(key);\n+                    } else if (!select && index > -1) {\n+                        newSelectedKeys.splice(index, 1);\n+                    }\n+                } else {\n+                    // BUG: Always sets to [key] regardless of current state\n+                    newSelectedKeys = [key];\n+                }\n+                \n+                addLog(`New selectedKeys: [${newSelectedKeys.join(', ')}]`);\n+                addLog(`Selected value in callback: ${select}`);\n+                addLog('---');\n+                \n+                setSelectedKeys(newSelectedKeys);\n+            };\n+            \n+            useEffect(() => {\n+                document.getElementById('log').textContent = log;\n+            }, [log]);\n+            \n+            return (\n+                <div>\n+                    <TreeNode \n+                        label=\"Node 1\" \n+                        nodeKey=\"node1\"\n+                        selected={selectedKeys.indexOf('node1') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                    <TreeNode \n+                        label=\"Node 2\" \n+                        nodeKey=\"node2\"\n+                        selected={selectedKeys.indexOf('node2') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                    <TreeNode \n+                        label=\"Node 3\" \n+                        nodeKey=\"node3\"\n+                        selected={selectedKeys.indexOf('node3') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                </div>\n+            );\n+        };\n+        \n+        ReactDOM.render(<BuggyTree />, document.getElementById('tree-container'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_tree_selection_fixed.html b/test_tree_selection_fixed.html\nnew file mode 100644\nindex 000000000..75bf55ef3\n--- /dev/null\n+++ b/test_tree_selection_fixed.html\n@@ -0,0 +1,196 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Tree Selection Fixed Test</title>\n+    <script src=\"https://unpkg.com/react@16/umd/react.development.js\"></script>\n+    <script src=\"https://unpkg.com/react-dom@16/umd/react-dom.development.js\"></script>\n+    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            padding: 20px;\n+        }\n+        .test-container {\n+            margin: 20px 0;\n+            padding: 20px;\n+            border: 1px solid #ccc;\n+            border-radius: 5px;\n+        }\n+        .log {\n+            background: #f5f5f5;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 3px;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+            max-height: 300px;\n+            overflow-y: auto;\n+        }\n+        .selected {\n+            background-color: #e6f7ff;\n+            color: #1890ff;\n+        }\n+        .test-result {\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 3px;\n+            font-weight: bold;\n+        }\n+        .test-pass {\n+            background-color: #f6ffed;\n+            color: #52c41a;\n+            border: 1px solid #b7eb8f;\n+        }\n+        .test-fail {\n+            background-color: #fff2f0;\n+            color: #ff4d4f;\n+            border: 1px solid #ffccc7;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Tree Selection Fixed Test</h1>\n+    \n+    <div class=\"test-container\">\n+        <h2>Test Case: Single Selection Toggle (FIXED)</h2>\n+        <p>Expected: Clicking the same node should toggle between selected/unselected</p>\n+        \n+        <div id=\"tree-container\"></div>\n+        \n+        <div class=\"log\" id=\"log\">\n+Click events will be logged here...\n+        </div>\n+        \n+        <div id=\"test-results\"></div>\n+    </div>\n+\n+    <script type=\"text/babel\">\n+        const { useState, useEffect } = React;\n+        \n+        const TreeNode = ({ label, nodeKey, selected, onSelect }) => {\n+            const handleClick = (e) => {\n+                e.preventDefault();\n+                console.log(`TreeNode handleSelect called: !${selected} = ${!selected}`);\n+                onSelect(!selected, nodeKey);\n+            };\n+            \n+            return (\n+                <div \n+                    onClick={handleClick}\n+                    style={{\n+                        padding: '8px 12px',\n+                        cursor: 'pointer',\n+                        backgroundColor: selected ? '#e6f7ff' : 'transparent',\n+                        color: selected ? '#1890ff' : '#000',\n+                        border: '1px solid #d9d9d9',\n+                        margin: '2px 0',\n+                        borderRadius: '4px'\n+                    }}\n+                >\n+                    {label} {selected ? '(Selected)' : '(Not Selected)'}\n+                </div>\n+            );\n+        };\n+        \n+        const FixedTree = () => {\n+            const [selectedKeys, setSelectedKeys] = useState([]);\n+            const [log, setLog] = useState('Click events will be logged here...\\n');\n+            const [testResults, setTestResults] = useState([]);\n+            \n+            const addLog = (message) => {\n+                setLog(prev => prev + new Date().toLocaleTimeString() + ': ' + message + '\\n');\n+            };\n+            \n+            const addTestResult = (testName, passed, details) => {\n+                setTestResults(prev => [...prev, { testName, passed, details }]);\n+            };\n+            \n+            // Simulate the FIXED handleSelect method\n+            const handleSelect = (select, key) => {\n+                addLog(`handleSelect called: select=${select}, key=${key}`);\n+                addLog(`Current selectedKeys: [${selectedKeys.join(', ')}]`);\n+                \n+                let newSelectedKeys = [...selectedKeys];\n+                \n+                // This is the FIXED logic\n+                const multiple = false; // single selection mode\n+                \n+                if (multiple) {\n+                    const index = newSelectedKeys.indexOf(key);\n+                    if (select && index === -1) {\n+                        newSelectedKeys.push(key);\n+                    } else if (!select && index > -1) {\n+                        newSelectedKeys.splice(index, 1);\n+                    }\n+                } else {\n+                    // FIXED: In single-select mode, properly handle deselection\n+                    if (select) {\n+                        newSelectedKeys = [key];\n+                    } else {\n+                        // If deselecting, remove the key from selectedKeys\n+                        newSelectedKeys = newSelectedKeys.filter(selectedKey => selectedKey !== key);\n+                    }\n+                }\n+                \n+                addLog(`New selectedKeys: [${newSelectedKeys.join(', ')}]`);\n+                addLog(`Selected value in callback: ${select}`);\n+                \n+                // Test validation\n+                if (select && newSelectedKeys.includes(key)) {\n+                    addTestResult(`Select ${key}`, true, `${key} correctly added to selection`);\n+                } else if (!select && !newSelectedKeys.includes(key)) {\n+                    addTestResult(`Deselect ${key}`, true, `${key} correctly removed from selection`);\n+                } else if (select && !newSelectedKeys.includes(key)) {\n+                    addTestResult(`Select ${key}`, false, `${key} should be selected but isn't`);\n+                } else if (!select && newSelectedKeys.includes(key)) {\n+                    addTestResult(`Deselect ${key}`, false, `${key} should be deselected but isn't`);\n+                }\n+                \n+                addLog('---');\n+                \n+                setSelectedKeys(newSelectedKeys);\n+            };\n+            \n+            useEffect(() => {\n+                document.getElementById('log').textContent = log;\n+            }, [log]);\n+            \n+            useEffect(() => {\n+                const resultsDiv = document.getElementById('test-results');\n+                resultsDiv.innerHTML = testResults.map(result => \n+                    `<div class=\"test-result ${result.passed ? 'test-pass' : 'test-fail'}\">\n+                        ${result.passed ? '\u2705' : '\u274c'} ${result.testName}: ${result.details}\n+                    </div>`\n+                ).join('');\n+            }, [testResults]);\n+            \n+            return (\n+                <div>\n+                    <TreeNode \n+                        label=\"Node 1\" \n+                        nodeKey=\"node1\"\n+                        selected={selectedKeys.indexOf('node1') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                    <TreeNode \n+                        label=\"Node 2\" \n+                        nodeKey=\"node2\"\n+                        selected={selectedKeys.indexOf('node2') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                    <TreeNode \n+                        label=\"Node 3\" \n+                        nodeKey=\"node3\"\n+                        selected={selectedKeys.indexOf('node3') > -1}\n+                        onSelect={handleSelect}\n+                    />\n+                </div>\n+            );\n+        };\n+        \n+        ReactDOM.render(<FixedTree />, document.getElementById('tree-container'));\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

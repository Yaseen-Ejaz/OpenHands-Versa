31] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 15:23:31] \"GET /src/ol/geom/flat/linechunk.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 15:23:31] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 200 -\ndiff --git a/src/ol/source/ImageArcGISRest.js b/src/ol/source/ImageArcGISRest.js\nindex 084d585b7..095966506 100644\n--- a/src/ol/source/ImageArcGISRest.js\n+++ b/src/ol/source/ImageArcGISRest.js\n@@ -31,7 +31,7 @@ import {createCanvasContext2D} from '../dom.js';\n  * @property {import(\"../proj.js\").ProjectionLike} [projection] Projection. Default is the view projection.\n  * The projection code must contain a numeric end portion separated by :\n  * or the entire code must form a valid ArcGIS SpatialReference definition.\n- * @property {number} [ratio=1.5] Ratio. `1` means image requests are the size of the map viewport,\n+ * @property {number} [ratio=1] Ratio. `1` means image requests are the size of the map viewport,\n  * `2` means twice the size of the map viewport, and so on.\n  * @property {Array<number>} [resolutions] Resolutions. If specified, requests will be made for\n  * these resolutions only.\n@@ -127,7 +127,7 @@ class ImageArcGISRest extends ImageSource {\n      * @private\n      * @type {number}\n      */\n-    this.ratio_ = options.ratio !== undefined ? options.ratio : 1.5;\n+    this.ratio_ = options.ratio !== undefined ? options.ratio : 1;\n   }\n \n   /**\ndiff --git a/test/browser/spec/ol/source/ImageArcGISRest.test.js b/test/browser/spec/ol/source/ImageArcGISRest.test.js\nindex 03001410e..ceca95160 100644\n--- a/test/browser/spec/ol/source/ImageArcGISRest.test.js\n+++ b/test/browser/spec/ol/source/ImageArcGISRest.test.js\n@@ -42,7 +42,7 @@ describe('ol/source/ImageArcGISRest', function () {\n       expect(uri.hostname).to.be('example.com');\n       expect(uri.pathname).to.be('/MapServer/export');\n       const queryData = uri.searchParams;\n-      expect(queryData.get('BBOX')).to.be('5.5,2.25,-9.5,0.75');\n+      expect(queryData.get('BBOX')).to.be('3,2,-7,1');\n       expect(queryData.get('FORMAT')).to.be('PNG32');\n       expect(queryData.get('IMAGESR')).to.be('3857');\n       expect(queryData.get('BBOXSR')).to.be('3857');\n@@ -76,7 +76,7 @@ describe('ol/source/ImageArcGISRest', function () {\n       expect(uri.hostname).to.be('example.com');\n       expect(uri.pathname).to.be('/ImageServer/exportImage');\n       const queryData = uri.searchParams;\n-      expect(queryData.get('BBOX')).to.be('5.5,2.25,-9.5,0.75');\n+      expect(queryData.get('BBOX')).to.be('3,2,-7,1');\n       expect(queryData.get('FORMAT')).to.be('PNG32');\n       expect(queryData.get('IMAGESR')).to.be('3857');\n       expect(queryData.get('BBOXSR')).to.be('3857');\ndiff --git a/test_ratio_comprehensive.js b/test_ratio_comprehensive.js\nnew file mode 100644\nindex 000000000..273fd2b70\n--- /dev/null\n+++ b/test_ratio_comprehensive.js\n@@ -0,0 +1,274 @@\n+/**\n+ * Comprehensive test for ImageArcGISRest ratio issue\n+ * Tests the behavior of different ratio values with scaling and rotation\n+ */\n+\n+import ImageArcGISRest from './src/ol/source/ImageArcGISRest.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+\n+// Test configuration\n+const testConfig = {\n+    url: 'https://sampleserver6.arcgisonline.com/ArcGIS/rest/services/USA/MapServer',\n+    projection: getProjection('EPSG:3857'),\n+    extent: [-11000000, 4500000, -10000000, 5000000], // Test extent\n+    resolution: 1000,\n+    pixelRatios: [1, 1.5, 2], // Simulate different device pixel ratios\n+    ratios: [1, 1.5, 2], // Different ratio values to test\n+};\n+\n+/**\n+ * Test the extent calculation with different ratio and pixel ratio combinations\n+ */\n+function testExtentCalculation() {\n+    console.log('=== Testing Extent Calculation ===');\n+    \n+    const results = [];\n+    \n+    testConfig.ratios.forEach(ratio => {\n+        testConfig.pixelRatios.forEach(pixelRatio => {\n+            const source = new ImageArcGISRest({\n+                url: testConfig.url,\n+                ratio: ratio\n+            });\n+            \n+            const image = source.getImageInternal(\n+                testConfig.extent,\n+                testConfig.resolution,\n+                pixelRatio,\n+                testConfig.projection\n+            );\n+            \n+            if (image) {\n+                const imageExtent = image.getExtent();\n+                const originalWidth = testConfig.extent[2] - testConfig.extent[0];\n+                const originalHeight = testConfig.extent[3] - testConfig.extent[1];\n+                const imageWidth = imageExtent[2] - imageExtent[0];\n+                const imageHeight = imageExtent[3] - imageExtent[1];\n+                \n+                const result = {\n+                    ratio: ratio,\n+                    pixelRatio: pixelRatio,\n+                    originalExtent: testConfig.extent,\n+                    imageExtent: imageExtent,\n+                    widthRatio: imageWidth / originalWidth,\n+                    heightRatio: imageHeight / originalHeight,\n+                    expectedRatio: ratio,\n+                    isCorrect: Math.abs((imageWidth / originalWidth) - ratio) < 0.001\n+                };\n+                \n+                results.push(result);\n+                \n+                console.log(`Ratio: ${ratio}, PixelRatio: ${pixelRatio}`);\n+                console.log(`  Original extent: [${testConfig.extent.join(', ')}]`);\n+                console.log(`  Image extent: [${imageExtent.map(x => x.toFixed(2)).join(', ')}]`);\n+                console.log(`  Width ratio: ${result.widthRatio.toFixed(3)} (expected: ${ratio})`);\n+                console.log(`  Height ratio: ${result.heightRatio.toFixed(3)} (expected: ${ratio})`);\n+                console.log(`  Correct: ${result.isCorrect}`);\n+                console.log('');\n+            }\n+        });\n+    });\n+    \n+    return results;\n+}\n+\n+/**\n+ * Test URL generation with different parameters\n+ */\n+function testUrlGeneration() {\n+    console.log('=== Testing URL Generation ===');\n+    \n+    testConfig.ratios.forEach(ratio => {\n+        testConfig.pixelRatios.forEach(pixelRatio => {\n+            const source = new ImageArcGISRest({\n+                url: testConfig.url,\n+                ratio: ratio\n+            });\n+            \n+            const image = source.getImageInternal(\n+                testConfig.extent,\n+                testConfig.resolution,\n+                pixelRatio,\n+                testConfig.projection\n+            );\n+            \n+            if (image) {\n+                const url = new URL(image.src_);\n+                const bbox = url.searchParams.get('BBOX');\n+                const size = url.searchParams.get('SIZE');\n+                const dpi = url.searchParams.get('DPI');\n+                \n+                console.log(`Ratio: ${ratio}, PixelRatio: ${pixelRatio}`);\n+                console.log(`  URL: ${image.src_}`);\n+                console.log(`  BBOX: ${bbox}`);\n+                console.log(`  SIZE: ${size}`);\n+                console.log(`  DPI: ${dpi}`);\n+                console.log('');\n+            }\n+        });\n+    });\n+}\n+\n+/**\n+ * Test default ratio value\n+ */\n+function testDefaultRatio() {\n+    console.log('=== Testing Default Ratio ===');\n+    \n+    const source = new ImageArcGISRest({\n+        url: testConfig.url\n+        // No ratio specified - should use default\n+    });\n+    \n+    // Access private ratio_ property for testing\n+    const defaultRatio = source.ratio_;\n+    console.log(`Default ratio: ${defaultRatio}`);\n+    console.log(`Expected default: 1.5`);\n+    console.log(`Is correct: ${defaultRatio === 1.5}`);\n+    \n+    return defaultRatio;\n+}\n+\n+/**\n+ * Test ratio override\n+ */\n+function testRatioOverride() {\n+    console.log('=== Testing Ratio Override ===');\n+    \n+    const testRatio = 1;\n+    const source = new ImageArcGISRest({\n+        url: testConfig.url,\n+        ratio: testRatio\n+    });\n+    \n+    const actualRatio = source.ratio_;\n+    console.log(`Set ratio: ${testRatio}`);\n+    console.log(`Actual ratio: ${actualRatio}`);\n+    console.log(`Is correct: ${actualRatio === testRatio}`);\n+    \n+    return actualRatio === testRatio;\n+}\n+\n+/**\n+ * Simulate the issue scenario\n+ */\n+function simulateIssueScenario() {\n+    console.log('=== Simulating Issue Scenario ===');\n+    \n+    // Scenario 1: Computer scaling at 150% (pixelRatio = 1.5) with default ratio\n+    console.log('Scenario 1: 150% computer scaling with default ratio (1.5)');\n+    const source1 = new ImageArcGISRest({\n+        url: testConfig.url\n+        // Using default ratio 1.5\n+    });\n+    \n+    const image1 = source1.getImageInternal(\n+        testConfig.extent,\n+        testConfig.resolution,\n+        1.5, // 150% scaling\n+        testConfig.projection\n+    );\n+    \n+    if (image1) {\n+        const extent1 = image1.getExtent();\n+        console.log(`  Image extent: [${extent1.map(x => x.toFixed(2)).join(', ')}]`);\n+        console.log(`  This should show potential misalignment issues`);\n+    }\n+    \n+    // Scenario 2: Same scaling but with ratio = 1 (workaround)\n+    console.log('Scenario 2: 150% computer scaling with ratio = 1 (workaround)');\n+    const source2 = new ImageArcGISRest({\n+        url: testConfig.url,\n+        ratio: 1\n+    });\n+    \n+    const image2 = source2.getImageInternal(\n+        testConfig.extent,\n+        testConfig.resolution,\n+        1.5, // 150% scaling\n+        testConfig.projection\n+    );\n+    \n+    if (image2) {\n+        const extent2 = image2.getExtent();\n+        console.log(`  Image extent: [${extent2.map(x => x.toFixed(2)).join(', ')}]`);\n+        console.log(`  This should work correctly`);\n+    }\n+    \n+    // Compare the two scenarios\n+    if (image1 && image2) {\n+        const extent1 = image1.getExtent();\n+        const extent2 = image2.getExtent();\n+        \n+        const width1 = extent1[2] - extent1[0];\n+        const width2 = extent2[2] - extent2[0];\n+        const height1 = extent1[3] - extent1[1];\n+        const height2 = extent2[3] - extent2[1];\n+        \n+        console.log('Comparison:');\n+        console.log(`  Default ratio (1.5) image size: ${width1.toFixed(2)} x ${height1.toFixed(2)}`);\n+        console.log(`  Workaround ratio (1) image size: ${width2.toFixed(2)} x ${height2.toFixed(2)}`);\n+        console.log(`  Size difference: ${((width1 - width2) / width2 * 100).toFixed(1)}%`);\n+    }\n+}\n+\n+/**\n+ * Run all tests\n+ */\n+function runAllTests() {\n+    console.log('Starting comprehensive ImageArcGISRest ratio tests...\\n');\n+    \n+    try {\n+        const defaultRatio = testDefaultRatio();\n+        console.log('');\n+        \n+        const overrideSuccess = testRatioOverride();\n+        console.log('');\n+        \n+        const extentResults = testExtentCalculation();\n+        console.log('');\n+        \n+        testUrlGeneration();\n+        console.log('');\n+        \n+        simulateIssueScenario();\n+        console.log('');\n+        \n+        // Summary\n+        console.log('=== Test Summary ===');\n+        console.log(`Default ratio is 1.5: ${defaultRatio === 1.5}`);\n+        console.log(`Ratio override works: ${overrideSuccess}`);\n+        console.log(`Total extent calculations tested: ${extentResults.length}`);\n+        \n+        const correctCalculations = extentResults.filter(r => r.isCorrect).length;\n+        console.log(`Correct extent calculations: ${correctCalculations}/${extentResults.length}`);\n+        \n+        // Identify problematic combinations\n+        const problematicCombinations = extentResults.filter(r => !r.isCorrect);\n+        if (problematicCombinations.length > 0) {\n+            console.log('Problematic combinations:');\n+            problematicCombinations.forEach(r => {\n+                console.log(`  Ratio: ${r.ratio}, PixelRatio: ${r.pixelRatio}`);\n+            });\n+        }\n+        \n+        return {\n+            defaultRatio,\n+            overrideSuccess,\n+            extentResults,\n+            problematicCombinations\n+        };\n+        \n+    } catch (error) {\n+        console.error('Test failed with error:', error);\n+        return null;\n+    }\n+}\n+\n+// Export for use in other contexts\n+export { runAllTests, testDefaultRatio, testRatioOverride, simulateIssueScenario };\n+\n+// Run tests if this file is executed directly\n+if (typeof window === 'undefined') {\n+    runAllTests();\n+}\n\\ No newline at end of file\ndiff --git a/test_ratio_fix.js b/test_ratio_fix.js\nnew file mode 100644\nindex 000000000..29cfacdc4\n--- /dev/null\n+++ b/test_ratio_fix.js\n@@ -0,0 +1,52 @@\n+/**\n+ * Test to verify the ImageArcGISRest ratio fix\n+ */\n+\n+import ImageArcGISRest from './src/ol/source/ImageArcGISRest.js';\n+\n+describe('ImageArcGISRest Ratio Fix', function() {\n+  \n+  it('should have default ratio of 1 instead of 1.5', function() {\n+    const source = new ImageArcGISRest({\n+      url: 'https://example.com/MapServer'\n+    });\n+    \n+    // Access the private ratio_ property for testing\n+    const actualRatio = source.ratio_;\n+    \n+    // The fix should change the default from 1.5 to 1\n+    expect(actualRatio).to.equal(1);\n+  });\n+  \n+  it('should still allow custom ratio values', function() {\n+    const customRatio = 2;\n+    const source = new ImageArcGISRest({\n+      url: 'https://example.com/MapServer',\n+      ratio: customRatio\n+    });\n+    \n+    const actualRatio = source.ratio_;\n+    expect(actualRatio).to.equal(customRatio);\n+  });\n+  \n+  it('should handle ratio of 0 (edge case)', function() {\n+    const source = new ImageArcGISRest({\n+      url: 'https://example.com/MapServer',\n+      ratio: 0\n+    });\n+    \n+    const actualRatio = source.ratio_;\n+    expect(actualRatio).to.equal(0);\n+  });\n+  \n+  it('should handle undefined ratio (use default)', function() {\n+    const source = new ImageArcGISRest({\n+      url: 'https://example.com/MapServer',\n+      ratio: undefined\n+    });\n+    \n+    const actualRatio = source.ratio_;\n+    expect(actualRatio).to.equal(1); // Should use new default\n+  });\n+  \n+});\n\\ No newline at end of file\ndiff --git a/test_ratio_issue.html b/test_ratio_issue.html\nnew file mode 100644\nindex 000000000..946785127\n--- /dev/null\n+++ b/test_ratio_issue.html\n@@ -0,0 +1,192 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>ImageArcGISRest Ratio Issue Test</title>\n+    <style>\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .test-container {\n+            margin-bottom: 30px;\n+            border: 1px solid #ccc;\n+            padding: 15px;\n+        }\n+        .map {\n+            width: 400px;\n+            height: 300px;\n+            border: 1px solid #000;\n+            margin: 10px 0;\n+        }\n+        .controls {\n+            margin: 10px 0;\n+        }\n+        button {\n+            margin: 5px;\n+            padding: 5px 10px;\n+        }\n+        .info {\n+            background: #f0f0f0;\n+            padding: 10px;\n+            margin: 10px 0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>ImageArcGISRest Ratio Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Test Instructions:</h3>\n+        <p>1. Change your browser zoom to 150% (Ctrl/Cmd + Plus)</p>\n+        <p>2. Compare the alignment of layers with different ratio values</p>\n+        <p>3. Test rotation to see if layers stay aligned</p>\n+        <p>4. Expected: ratio=1 should work correctly, ratio=1.5 should show misalignment</p>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 1: Default Ratio (1.5) - Should show misalignment at 150% zoom</h3>\n+        <div id=\"map1\" class=\"map\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap('map1', 15)\">Rotate +15\u00b0</button>\n+            <button onclick=\"rotateMap('map1', -15)\">Rotate -15\u00b0</button>\n+            <button onclick=\"resetRotation('map1')\">Reset Rotation</button>\n+        </div>\n+        <div id=\"info1\" class=\"info\">Ratio: 1.5 (default)</div>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 2: Ratio = 1 - Should work correctly</h3>\n+        <div id=\"map2\" class=\"map\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap('map2', 15)\">Rotate +15\u00b0</button>\n+            <button onclick=\"rotateMap('map2', -15)\">Rotate -15\u00b0</button>\n+            <button onclick=\"resetRotation('map2')\">Reset Rotation</button>\n+        </div>\n+        <div id=\"info2\" class=\"info\">Ratio: 1 (workaround)</div>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 3: Ratio = 2 - Should show misalignment</h3>\n+        <div id=\"map3\" class=\"map\"></div>\n+        <div class=\"controls\">\n+            <button onclick=\"rotateMap('map3', 15)\">Rotate +15\u00b0</button>\n+            <button onclick=\"rotateMap('map3', -15)\">Rotate -15\u00b0</button>\n+            <button onclick=\"resetRotation('map3')\">Reset Rotation</button>\n+        </div>\n+        <div id=\"info3\" class=\"info\">Ratio: 2 (should show issues)</div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import {ImageArcGISRest, OSM} from './src/ol/source.js';\n+        import {Image as ImageLayer, Tile as TileLayer} from './src/ol/layer.js';\n+\n+        const url = 'https://sampleserver6.arcgisonline.com/ArcGIS/rest/services/USA/MapServer';\n+        \n+        const center = [-10997148, 4569099];\n+        const zoom = 4;\n+\n+        // Store map instances globally for rotation functions\n+        window.maps = {};\n+\n+        // Test 1: Default ratio (1.5)\n+        const map1 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        ratio: 1.5, // Default value - should show issues\n+                        params: {},\n+                        url: url,\n+                    }),\n+                }),\n+            ],\n+            target: 'map1',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+        window.maps['map1'] = map1;\n+\n+        // Test 2: Ratio = 1 (workaround)\n+        const map2 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        ratio: 1, // Workaround value - should work correctly\n+                        params: {},\n+                        url: url,\n+                    }),\n+                }),\n+            ],\n+            target: 'map2',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+        window.maps['map2'] = map2;\n+\n+        // Test 3: Ratio = 2\n+        const map3 = new Map({\n+            layers: [\n+                new TileLayer({\n+                    source: new OSM(),\n+                }),\n+                new ImageLayer({\n+                    source: new ImageArcGISRest({\n+                        ratio: 2, // Higher ratio - should show issues\n+                        params: {},\n+                        url: url,\n+                    }),\n+                }),\n+            ],\n+            target: 'map3',\n+            view: new View({\n+                center: center,\n+                zoom: zoom,\n+            }),\n+        });\n+        window.maps['map3'] = map3;\n+\n+        // Global rotation functions\n+        window.rotateMap = function(mapId, degrees) {\n+            const map = window.maps[mapId];\n+            const view = map.getView();\n+            const currentRotation = view.getRotation();\n+            view.setRotation(currentRotation + (degrees * Math.PI / 180));\n+        };\n+\n+        window.resetRotation = function(mapId) {\n+            const map = window.maps[mapId];\n+            const view = map.getView();\n+            view.setRotation(0);\n+        };\n+\n+        // Add zoom level indicator\n+        function updateZoomInfo() {\n+            const browserZoom = Math.round(window.devicePixelRatio * 100);\n+            document.title = `ImageArcGISRest Ratio Test - Browser Zoom: ${browserZoom}%`;\n+            \n+            // Add zoom info to page\n+            const zoomInfo = document.createElement('div');\n+            zoomInfo.className = 'info';\n+            zoomInfo.innerHTML = `<strong>Current Browser Zoom: ${browserZoom}%</strong> (Change to 150% to reproduce the issue)`;\n+            document.body.insertBefore(zoomInfo, document.body.firstChild);\n+        }\n+\n+        updateZoomInfo();\n+        \n+        // Update zoom info when window is resized (zoom changed)\n+        window.addEventListener('resize', updateZoomInfo);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_ratio_simple.js b/test_ratio_simple.js\nnew file mode 100644\nindex 000000000..e41539be2\n--- /dev/null\n+++ b/test_ratio_simple.js\n@@ -0,0 +1,155 @@\n+/**\n+ * Simple test to verify the default ratio value and demonstrate the issue\n+ */\n+\n+// Test the default ratio value by examining the source code\n+import fs from 'fs';\n+import path from 'path';\n+\n+function testDefaultRatioInSource() {\n+    console.log('=== Testing Default Ratio in Source Code ===');\n+    \n+    const sourceFile = path.join(process.cwd(), 'src/ol/source/ImageArcGISRest.js');\n+    const content = fs.readFileSync(sourceFile, 'utf8');\n+    \n+    // Look for the line that sets the default ratio\n+    const ratioLineMatch = content.match(/this\\.ratio_\\s*=\\s*options\\.ratio\\s*!==\\s*undefined\\s*\\?\\s*options\\.ratio\\s*:\\s*([\\d.]+);/);\n+    \n+    if (ratioLineMatch) {\n+        const defaultRatio = parseFloat(ratioLineMatch[1]);\n+        console.log(`Found default ratio in source: ${defaultRatio}`);\n+        console.log(`Expected: 1.5`);\n+        console.log(`Current default is problematic: ${defaultRatio === 1.5}`);\n+        return defaultRatio;\n+    } else {\n+        console.log('Could not find ratio assignment in source code');\n+        return null;\n+    }\n+}\n+\n+function testDocumentationConsistency() {\n+    console.log('\\n=== Testing Documentation Consistency ===');\n+    \n+    const sourceFile = path.join(process.cwd(), 'src/ol/source/ImageArcGISRest.js');\n+    const content = fs.readFileSync(sourceFile, 'utf8');\n+    \n+    // Look for the documentation of the ratio parameter\n+    const docMatch = content.match(/@property\\s+\\{number\\}\\s+\\[ratio=([\\d.]+)\\]/);\n+    \n+    if (docMatch) {\n+        const docRatio = parseFloat(docMatch[1]);\n+        console.log(`Documentation states default ratio: ${docRatio}`);\n+        return docRatio;\n+    } else {\n+        console.log('Could not find ratio documentation');\n+        return null;\n+    }\n+}\n+\n+function analyzeRatioUsageInExamples() {\n+    console.log('\\n=== Analyzing Ratio Usage in Examples ===');\n+    \n+    const examplesDir = path.join(process.cwd(), 'examples');\n+    const files = fs.readdirSync(examplesDir).filter(f => f.endsWith('.js'));\n+    \n+    const ratioUsages = [];\n+    \n+    files.forEach(file => {\n+        const filePath = path.join(examplesDir, file);\n+        const content = fs.readFileSync(filePath, 'utf8');\n+        \n+        // Look for ImageArcGISRest usage with ratio parameter\n+        const arcgisMatch = content.match(/new\\s+ImageArcGISRest\\s*\\(\\s*\\{[^}]*ratio\\s*:\\s*([\\d.]+)[^}]*\\}/);\n+        if (arcgisMatch) {\n+            const ratio = parseFloat(arcgisMatch[1]);\n+            ratioUsages.push({ file, ratio });\n+            console.log(`${file}: uses ratio = ${ratio}`);\n+        }\n+    });\n+    \n+    if (ratioUsages.length === 0) {\n+        console.log('No explicit ratio usage found in examples');\n+    } else {\n+        const ratioValues = ratioUsages.map(u => u.ratio);\n+        const uniqueRatios = [...new Set(ratioValues)];\n+        console.log(`Unique ratio values used in examples: ${uniqueRatios.join(', ')}`);\n+        \n+        // Check if examples are using the workaround\n+        const usingWorkaround = ratioUsages.filter(u => u.ratio === 1);\n+        if (usingWorkaround.length > 0) {\n+            console.log(`Examples using ratio=1 workaround: ${usingWorkaround.map(u => u.file).join(', ')}`);\n+        }\n+    }\n+    \n+    return ratioUsages;\n+}\n+\n+function checkOtherImageSources() {\n+    console.log('\\n=== Checking Other Image Sources ===');\n+    \n+    const sources = ['ImageWMS.js', 'ImageCanvas.js'];\n+    \n+    sources.forEach(sourceFile => {\n+        const filePath = path.join(process.cwd(), 'src/ol/source', sourceFile);\n+        \n+        if (fs.existsSync(filePath)) {\n+            const content = fs.readFileSync(filePath, 'utf8');\n+            const ratioMatch = content.match(/this\\.ratio_\\s*=\\s*options\\.ratio\\s*!==\\s*undefined\\s*\\?\\s*options\\.ratio\\s*:\\s*([\\d.]+);/);\n+            \n+            if (ratioMatch) {\n+                const defaultRatio = parseFloat(ratioMatch[1]);\n+                console.log(`${sourceFile}: default ratio = ${defaultRatio}`);\n+            } else {\n+                console.log(`${sourceFile}: no ratio parameter found`);\n+            }\n+        }\n+    });\n+}\n+\n+function generateIssueAnalysis() {\n+    console.log('\\n=== Issue Analysis ===');\n+    \n+    console.log('Problem: ImageArcGISRest default ratio of 1.5 causes layer-map misalignment');\n+    console.log('Scenarios:');\n+    console.log('1. Computer scaling != 100% (e.g., 150%) + ratio != 1 \u2192 misalignment');\n+    console.log('2. Map rotation + ratio != 1 \u2192 misalignment after rotation');\n+    console.log('');\n+    console.log('Current workaround: Set ratio = 1');\n+    console.log('Proposed fix: Change default ratio from 1.5 to 1');\n+    console.log('');\n+    console.log('Impact analysis:');\n+    console.log('- Examples already use ratio = 1, so they expect this behavior');\n+    console.log('- Changing default to 1 will fix the issue for new users');\n+    console.log('- Existing code that relies on default 1.5 might see different behavior');\n+    console.log('- However, the current default causes bugs, so fixing it is justified');\n+}\n+\n+// Run all tests\n+function runTests() {\n+    console.log('ImageArcGISRest Ratio Issue Analysis\\n');\n+    \n+    const sourceRatio = testDefaultRatioInSource();\n+    const docRatio = testDocumentationConsistency();\n+    const exampleUsages = analyzeRatioUsageInExamples();\n+    checkOtherImageSources();\n+    generateIssueAnalysis();\n+    \n+    console.log('\\n=== Summary ===');\n+    console.log(`Source code default ratio: ${sourceRatio}`);\n+    console.log(`Documentation default ratio: ${docRatio}`);\n+    console.log(`Examples using explicit ratios: ${exampleUsages.length}`);\n+    \n+    if (exampleUsages.length > 0) {\n+        const workaroundExamples = exampleUsages.filter(u => u.ratio === 1);\n+        console.log(`Examples using ratio=1 workaround: ${workaroundExamples.length}`);\n+    }\n+    \n+    return {\n+        sourceRatio,\n+        docRatio,\n+        exampleUsages,\n+        needsFix: sourceRatio === 1.5\n+    };\n+}\n+\n+runTests();\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

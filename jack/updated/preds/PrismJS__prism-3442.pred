1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 10:11:13] \"GET /components/prism-markup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 10:11:13] \"GET /components/prism-core.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 10:13:47] \"GET /test_quotes_issue.html HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 10:13:47] \"GET /themes/prism.css HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 10:13:47] \"GET /components/prism-markup.js HTTP/1.1\" 200 -\n+127.0.0.1 - - [04/Mar/2026 10:13:47] \"GET /components/prism-core.js HTTP/1.1\" 304 -\ndiff --git a/test_current_behavior.js b/test_current_behavior.js\nnew file mode 100644\nindex 00000000..a94b46c3\n--- /dev/null\n+++ b/test_current_behavior.js\n@@ -0,0 +1,29 @@\n+// Test script to analyze current behavior\n+const fs = require('fs');\n+\n+// Load Prism\n+global.Prism = { languages: {}, hooks: { add: () => {} } };\n+require('./components/prism-core.js');\n+require('./components/prism-markup.js');\n+\n+// Test cases\n+const testCases = [\n+    '<google-chart data=\\'[[\"Month\", \"Days\"], [\"Jan\", 31]]\\'></google-chart>',\n+    '<div data-config=\\'{\"key\": \"value\", \"number\": 42}\\'></div>',\n+    '<div data-config=\"{\\'key\\': \\'value\\', \\'number\\': 42}\"></div>',\n+    '<div class=\"test\" id=\\'myid\\' data-simple=value></div>'\n+];\n+\n+console.log('Current behavior analysis:');\n+console.log('=========================');\n+\n+testCases.forEach((testCase, index) => {\n+    console.log(`\\nTest case ${index + 1}: ${testCase}`);\n+    \n+    try {\n+        const tokens = Prism.tokenize(testCase, Prism.languages.markup);\n+        console.log('Tokens:', JSON.stringify(tokens, null, 2));\n+    } catch (error) {\n+        console.log('Error:', error.message);\n+    }\n+});\n\\ No newline at end of file\ndiff --git a/test_quotes_issue.html b/test_quotes_issue.html\nnew file mode 100644\nindex 00000000..17a0c304\n--- /dev/null\n+++ b/test_quotes_issue.html\n@@ -0,0 +1,35 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+    <meta charset=\"UTF-8\">\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+    <title>Test Quotes in HTML Attributes</title>\n+    <link href=\"themes/prism.css\" rel=\"stylesheet\" />\n+</head>\n+<body>\n+    <h1>Test Cases for Quotes in HTML Attributes</h1>\n+    \n+    <h2>Issue Case: Quotes inside JSON in attribute</h2>\n+    <pre><code class=\"language-markup\">&lt;google-chart data='[[\"Month\", \"Days\"], [\"Jan\", 31]]'&gt;&lt;/google-chart&gt;</code></pre>\n+    \n+    <h2>Other Test Cases</h2>\n+    \n+    <h3>Double quotes inside single-quoted attribute</h3>\n+    <pre><code class=\"language-markup\">&lt;div data-config='{\"key\": \"value\", \"number\": 42}'&gt;&lt;/div&gt;</code></pre>\n+    \n+    <h3>Single quotes inside double-quoted attribute</h3>\n+    <pre><code class=\"language-markup\">&lt;div data-config=\"{'key': 'value', 'number': 42}\"&gt;&lt;/div&gt;</code></pre>\n+    \n+    <h3>Mixed quotes in complex JSON</h3>\n+    <pre><code class=\"language-markup\">&lt;div data-complex='{\"items\": [{\"name\": \"Item 1\", \"desc\": \"It'\\''s great\"}, {\"name\": \"Item 2\"}]}'&gt;&lt;/div&gt;</code></pre>\n+    \n+    <h3>Normal attributes (should still work)</h3>\n+    <pre><code class=\"language-markup\">&lt;div class=\"test\" id='myid' data-simple=value&gt;&lt;/div&gt;</code></pre>\n+    \n+    <h3>Escaped quotes</h3>\n+    <pre><code class=\"language-markup\">&lt;div title=\"He said \\\"Hello\\\" to me\"&gt;&lt;/div&gt;</code></pre>\n+\n+    <script src=\"components/prism-core.js\"></script>\n+    <script src=\"components/prism-markup.js\"></script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/tests/languages/aspnet/page-directive_feature.test b/tests/languages/aspnet/page-directive_feature.test\nindex a65a5c59..21681c8b 100644\n--- a/tests/languages/aspnet/page-directive_feature.test\n+++ b/tests/languages/aspnet/page-directive_feature.test\n@@ -15,72 +15,56 @@\n [\n \t[\"page-direc
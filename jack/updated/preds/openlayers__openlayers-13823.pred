{"instance_id": "openlayers__openlayers-13823", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..6c3b739df\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,25 @@\n+\n+> ol@6.14.2-dev serve-examples\n+> webpack serve --config examples/webpack/config.mjs --mode development\n+\n+<i> [webpack-dev-server] Project is running at:\n+<i> [webpack-dev-server] Loopback: http://localhost:8080/\n+<i> [webpack-dev-server] Content not from webpack is served from '/workspace/openlayers__openlayers__/public' directory\n+Browserslist: caniuse-lite is outdated. Please run:\n+  npx update-browserslist-db@latest\n+  Why you should do it regularly: https://github.com/browserslist/update-db#readme\n+591 assets\n+760 modules\n+webpack 5.73.0 compiled successfully in 5190 ms\n+593 assets\n+760 modules\n+webpack 5.73.0 compiled successfully in 837 ms\n+593 assets\n+760 modules\n+webpack 5.73.0 compiled successfully in 699 ms\n+593 assets\n+760 modules\n+webpack 5.73.0 compiled successfully in 646 ms\n+593 assets\n+760 modules\n+webpack 5.73.0 compiled successfully in 738 ms\ndiff --git a/src/ol/renderer/canvas/ImageLayer.js b/src/ol/renderer/canvas/ImageLayer.js\nindex aec92d876..ab91fe384 100644\n--- a/src/ol/renderer/canvas/ImageLayer.js\n+++ b/src/ol/renderer/canvas/ImageLayer.js\n@@ -172,8 +172,11 @@ class CanvasImageLayerRenderer extends CanvasLayerRenderer {\n     const scale =\n       (pixelRatio * imageResolution) / (viewResolution * imagePixelRatio);\n \n-    let width = Math.round(size[0] * pixelRatio);\n-    let height = Math.round(size[1] * pixelRatio);\n+    // Use image pixel ratio for canvas sizing to avoid unnecessary memory usage\n+    // when image pixel ratio differs from display pixel ratio\n+    const canvasPixelRatio = imagePixelRatio;\n+    let width = Math.round(size[0] * canvasPixelRatio);\n+    let height = Math.round(size[1] * canvasPixelRatio);\n     const rotation = viewState.rotation;\n     if (rotation) {\n       const size = Math.round(Math.sqrt(width * width + height * height));\n@@ -186,8 +189,8 @@ class CanvasImageLayerRenderer extends CanvasLayerRenderer {\n       this.pixelTransform,\n       frameState.size[0] / 2,\n       frameState.size[1] / 2,\n-      1 / pixelRatio,\n-      1 / pixelRatio,\n+      1 / canvasPixelRatio,\n+      1 / canvasPixelRatio,\n       rotation,\n       -width / 2,\n       -height / 2\n@@ -241,7 +244,8 @@ class CanvasImageLayerRenderer extends CanvasLayerRenderer {\n       (imagePixelRatio * (viewCenter[1] - imageExtent[3])) / imageResolution\n     );\n \n-    this.renderedResolution = (imageResolution * pixelRatio) / imagePixelRatio;\n+    this.renderedResolution =\n+      (imageResolution * canvasPixelRatio) / imagePixelRatio;\n \n     const dw = img.width * transform[0];\n     const dh = img.height * transform[3];\ndiff --git a/test_pixel_ratio_issue.js b/test_pixel_ratio_issue.js\nnew file mode 100644\nindex 000000000..b1cd9f37e\n--- /dev/null\n+++ b/test_pixel_ratio_issue.js\n@@ -0,0 +1,169 @@\n+/**\n+ * Test to demonstrate the pixel ratio memory issue in ImageLayer renderer\n+ */\n+\n+import CanvasImageLayerRenderer from './src/ol/renderer/canvas/ImageLayer.js';\n+import ImageLayer from './src/ol/layer/Image.js';\n+import ImageStatic from './src/ol/source/ImageStatic.js';\n+import ImageWrapper from './src/ol/Image.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+\n+// Mock image source that simulates WMS with pixel ratio 1\n+class MockImageSource extends ImageStatic {\n+  constructor(options) {\n+    super(options);\n+    this.mockPixelRatio_ = options.mockPixelRatio || 1;\n+  }\n+\n+  getImageInternal(extent, resolution, pixelRatio, projection) {\n+    // Force pixel ratio to simulate WMS source behavior\n+    return super.getImageInternal(extent, resolution, this.mockPixelRatio_, projection);\n+  }\n+}\n+\n+function createMockFrameState(pixelRatio, size = [400, 300]) {\n+  const projection = getProjection('EPSG:3857');\n+  return {\n+    pixelRatio: pixelRatio,\n+    time: Date.now(),\n+    viewState: {\n+      center: [0, 0],\n+      projection: projection,\n+      resolution: 156543.03392804097,\n+      rotation: 0,\n+    },\n+    animate: false,\n+    coordinateToPixelTransform: [1, 0, 0, 1, 0, 0],\n+    extent: [-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244],\n+    index: 0,\n+    layerStatesArray: [{}],\n+    layerIndex: 0,\n+    pixelToCoordinateTransform: [1, 0, 0, 1, 0, 0],\n+    size: size,\n+    viewHints: [],\n+  };\n+}\n+\n+function testPixelRatioMemoryIssue() {\n+  console.log('=== Testing Pixel Ratio Memory Issue ===\\n');\n+\n+  const projection = getProjection('EPSG:3857');\n+  const extent = [-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244];\n+\n+  // Create a simple test image\n+  const canvas = document.createElement('canvas');\n+  canvas.width = 256;\n+  canvas.height = 256;\n+  const ctx = canvas.getContext('2d');\n+  ctx.fillStyle = '#ff0000';\n+  ctx.fillRect(0, 0, 256, 256);\n+  const imageUrl = canvas.toDataURL();\n+\n+  // Test cases with different display pixel ratios\n+  const testCases = [\n+    { displayPixelRatio: 1.0, description: 'Normal display (1x)' },\n+    { displayPixelRatio: 2.0, description: 'HiDPI display (2x)' },\n+    { displayPixelRatio: 3.0, description: 'Very high DPI display (3x)' }\n+  ];\n+\n+  testCases.forEach(testCase => {\n+    console.log(`\\n--- ${testCase.description} ---`);\n+\n+    // Create source with pixel ratio 1 (simulating WMS)\n+    const source = new MockImageSource({\n+      url: imageUrl,\n+      imageExtent: extent,\n+      projection: projection,\n+      mockPixelRatio: 1 // This simulates WMS source with pixel ratio 1\n+    });\n+\n+    const layer = new ImageLayer({ source: source });\n+    const renderer = new CanvasImageLayerRenderer(layer);\n+\n+    // Create mock frame state\n+    const frameState = createMockFrameState(testCase.displayPixelRatio);\n+\n+    // Create a mock image with pixel ratio 1\n+    const mockImage = new ImageWrapper(\n+      extent,\n+      156543.03392804097,\n+      1, // Image pixel ratio is 1 (WMS source)\n+      imageUrl,\n+      null,\n+      (image, src) => { image.getImage().src = src; }\n+    );\n+\n+    // Set the mock image\n+    renderer.image_ = mockImage;\n+\n+    // Mock the context and canvas\n+    const mockCanvas = document.createElement('canvas');\n+    const mockContext = mockCanvas.getContext('2d');\n+    renderer.context = mockContext;\n+    renderer.useContainer = function() {\n+      // Mock implementation\n+    };\n+\n+    // Call renderFrame to see canvas sizing\n+    try {\n+      renderer.renderFrame(frameState, document.createElement('div'));\n+\n+      const canvasWidth = mockCanvas.width;\n+      const canvasHeight = mockCanvas.height;\n+      const mapSize = frameState.size;\n+      const displayPixelRatio = frameState.pixelRatio;\n+      const imagePixelRatio = mockImage.getPixelRatio();\n+\n+      // Expected canvas size should be based on image pixel ratio, not display pixel ratio\n+      const expectedWidth = mapSize[0] * imagePixelRatio;\n+      const expectedHeight = mapSize[1] * imagePixelRatio;\n+      \n+      // Actual canvas size (current implementation uses display pixel ratio)\n+      const actualWidth = canvasWidth;\n+      const actualHeight = canvasHeight;\n+\n+      // Memory calculation (4 bytes per pixel for RGBA)\n+      const expectedMemory = expectedWidth * expectedHeight * 4;\n+      const actualMemory = actualWidth * actualHeight * 4;\n+      const memoryWaste = actualMemory - expectedMemory;\n+      const wasteRatio = actualMemory / expectedMemory;\n+\n+      console.log(`Display Pixel Ratio: ${displayPixelRatio}`);\n+      console.log(`Image Pixel Ratio: ${imagePixelRatio}`);\n+      console.log(`Map Size: ${mapSize[0]} x ${mapSize[1]}`);\n+      console.log(`Expected Canvas Size: ${expectedWidth} x ${expectedHeight}`);\n+      console.log(`Actual Canvas Size: ${actualWidth} x ${actualHeight}`);\n+      console.log(`Expected Memory: ${(expectedMemory / 1024).toFixed(1)} KB`);\n+      console.log(`Actual Memory: ${(actualMemory / 1024).toFixed(1)} KB`);\n+      console.log(`Memory Waste: ${(memoryWaste / 1024).toFixed(1)} KB`);\n+      console.log(`Waste Ratio: ${wasteRatio.toFixed(2)}x`);\n+\n+      if (imagePixelRatio === 1 && displayPixelRatio > 1 && wasteRatio > 1.5) {\n+        console.log('\u274c ISSUE DETECTED: Canvas is unnecessarily large!');\n+      } else {\n+        console.log('\u2705 Memory usage is optimal');\n+      }\n+\n+    } catch (error) {\n+      console.error('Error during test:', error);\n+    }\n+  });\n+}\n+\n+// Run the test\n+if (typeof document !== 'undefined') {\n+  // Browser environment\n+  document.addEventListener('DOMContentLoaded', testPixelRatioMemoryIssue);\n+} else {\n+  // Node environment - create minimal DOM\n+  const { JSDOM } = require('jsdom');\n+  const dom = new JSDOM('<!DOCTYPE html><html><body></body></html>');\n+  global.document = dom.window.document;\n+  global.window = dom.window;\n+  global.HTMLCanvasElement = dom.window.HTMLCanvasElement;\n+  global.Image = dom.window.Image;\n+  \n+  testPixelRatioMemoryIssue();\n+}\n+\n+export { testPixelRatioMemoryIssue };\n\\ No newline at end of file\ndiff --git a/test_pixel_ratio_memory_issue.html b/test_pixel_ratio_memory_issue.html\nnew file mode 100644\nindex 000000000..f3e2ba976\n--- /dev/null\n+++ b/test_pixel_ratio_memory_issue.html\n@@ -0,0 +1,156 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Pixel Ratio Memory Issue Test</title>\n+    <style>\n+        body { margin: 0; padding: 20px; font-family: Arial, sans-serif; }\n+        .test-container { margin: 20px 0; }\n+        .map { width: 400px; height: 300px; border: 1px solid #ccc; margin: 10px 0; }\n+        .info { background: #f0f0f0; padding: 10px; margin: 10px 0; }\n+        .results { background: #e8f5e8; padding: 10px; margin: 10px 0; }\n+        .error { background: #ffe8e8; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Image Layer Pixel Ratio Memory Issue Test</h1>\n+    \n+    <div class=\"info\">\n+        <h3>Test Description:</h3>\n+        <p>This test demonstrates the memory issue where image layers with pixel ratio 1 create canvases sized for display pixel ratio instead of image pixel ratio.</p>\n+        <p>On HiDPI devices (pixel ratio > 1), this results in unnecessarily large canvases consuming 4x more memory.</p>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 1: Normal Pixel Ratio (1.0)</h3>\n+        <div id=\"map1\" class=\"map\"></div>\n+        <div id=\"results1\" class=\"results\"></div>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 2: HiDPI Pixel Ratio (2.0)</h3>\n+        <div id=\"map2\" class=\"map\"></div>\n+        <div id=\"results2\" class=\"results\"></div>\n+    </div>\n+\n+    <div class=\"test-container\">\n+        <h3>Test 3: Very High Pixel Ratio (3.0)</h3>\n+        <div id=\"map3\" class=\"map\"></div>\n+        <div id=\"results3\" class=\"results\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import ImageLayer from './src/ol/layer/Image.js';\n+        import ImageWMS from './src/ol/source/ImageWMS.js';\n+        import ImageStatic from './src/ol/source/ImageStatic.js';\n+        import {get as getProjection} from './src/ol/proj.js';\n+\n+        // Mock WMS source that simulates a source with pixel ratio 1\n+        class MockImageSource extends ImageStatic {\n+            constructor(options) {\n+                super(options);\n+                this.mockPixelRatio_ = options.mockPixelRatio || 1;\n+            }\n+\n+            getImageInternal(extent, resolution, pixelRatio, projection) {\n+                // Force pixel ratio to 1 to simulate WMS with pixel ratio 1\n+                return super.getImageInternal(extent, resolution, this.mockPixelRatio_, projection);\n+            }\n+        }\n+\n+        function createTestMap(containerId, displayPixelRatio, resultsId) {\n+            // Create a simple test image (1x1 pixel data URL)\n+            const canvas = document.createElement('canvas');\n+            canvas.width = 256;\n+            canvas.height = 256;\n+            const ctx = canvas.getContext('2d');\n+            ctx.fillStyle = '#4CAF50';\n+            ctx.fillRect(0, 0, 256, 256);\n+            ctx.fillStyle = '#2196F3';\n+            ctx.fillRect(64, 64, 128, 128);\n+            const imageUrl = canvas.toDataURL();\n+\n+            const projection = getProjection('EPSG:3857');\n+            const extent = [-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244];\n+\n+            const source = new MockImageSource({\n+                url: imageUrl,\n+                imageExtent: extent,\n+                projection: projection,\n+                mockPixelRatio: 1 // Simulate WMS source with pixel ratio 1\n+            });\n+\n+            const layer = new ImageLayer({\n+                source: source\n+            });\n+\n+            const map = new Map({\n+                target: containerId,\n+                pixelRatio: displayPixelRatio, // This is the display pixel ratio\n+                layers: [layer],\n+                view: new View({\n+                    center: [0, 0],\n+                    zoom: 2,\n+                    projection: projection\n+                })\n+            });\n+\n+            // Wait for the image to load and then analyze canvas size\n+            source.on('imageloadend', function() {\n+                setTimeout(() => {\n+                    analyzeCanvasSize(map, layer, displayPixelRatio, resultsId);\n+                }, 100);\n+            });\n+\n+            return map;\n+        }\n+\n+        function analyzeCanvasSize(map, layer, displayPixelRatio, resultsId) {\n+            const resultsDiv = document.getElementById(resultsId);\n+            const renderer = layer.getRenderer();\n+            const canvas = renderer.context.canvas;\n+            const image = renderer.image_;\n+            \n+            const mapSize = map.getSize();\n+            const expectedCanvasSize = [mapSize[0] * displayPixelRatio, mapSize[1] * displayPixelRatio];\n+            const actualCanvasSize = [canvas.width, canvas.height];\n+            const imagePixelRatio = image ? image.getPixelRatio() : 'N/A';\n+            \n+            // Calculate memory usage (assuming 4 bytes per pixel for RGBA)\n+            const expectedMemory = expectedCanvasSize[0] * expectedCanvasSize[1] * 4;\n+            const actualMemory = actualCanvasSize[0] * actualCanvasSize[1] * 4;\n+            const memoryRatio = actualMemory / expectedMemory;\n+\n+            const isMemoryWasted = imagePixelRatio === 1 && displayPixelRatio > 1 && memoryRatio > 1.5;\n+\n+            resultsDiv.innerHTML = `\n+                <strong>Analysis Results:</strong><br>\n+                Display Pixel Ratio: ${displayPixelRatio}<br>\n+                Image Pixel Ratio: ${imagePixelRatio}<br>\n+                Map Size: ${mapSize[0]} x ${mapSize[1]}<br>\n+                Expected Canvas Size: ${expectedCanvasSize[0]} x ${expectedCanvasSize[1]}<br>\n+                Actual Canvas Size: ${actualCanvasSize[0]} x ${actualCanvasSize[1]}<br>\n+                Expected Memory: ${(expectedMemory / 1024).toFixed(1)} KB<br>\n+                Actual Memory: ${(actualMemory / 1024).toFixed(1)} KB<br>\n+                Memory Ratio: ${memoryRatio.toFixed(2)}x<br>\n+                <strong style=\"color: ${isMemoryWasted ? 'red' : 'green'}\">\n+                    ${isMemoryWasted ? '\u274c MEMORY WASTED!' : '\u2705 Memory usage optimal'}\n+                </strong>\n+            `;\n+\n+            if (isMemoryWasted) {\n+                resultsDiv.classList.add('error');\n+            }\n+        }\n+\n+        // Create test maps with different pixel ratios\n+        const map1 = createTestMap('map1', 1.0, 'results1');\n+        const map2 = createTestMap('map2', 2.0, 'results2');\n+        const map3 = createTestMap('map3', 3.0, 'results3');\n+\n+        // Add global reference for debugging\n+        window.testMaps = { map1, map2, map3 };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/verify_fix.js b/verify_fix.js\nnew file mode 100644\nindex 000000000..bdfb1baed\n--- /dev/null\n+++ b/verify_fix.js\n@@ -0,0 +1,164 @@\n+/**\n+ * Simple verification script to test the pixel ratio memory fix\n+ */\n+\n+import CanvasImageLayerRenderer from './src/ol/renderer/canvas/ImageLayer.js';\n+import ImageLayer from './src/ol/layer/Image.js';\n+import ImageStatic from './src/ol/source/ImageStatic.js';\n+import ImageWrapper from './src/ol/Image.js';\n+import {get as getProjection} from './src/ol/proj.js';\n+\n+// Create a minimal DOM environment for testing\n+if (typeof document === 'undefined') {\n+  // Simple mock DOM for Node.js testing\n+  global.document = {\n+    createElement: function(tag) {\n+      if (tag === 'canvas') {\n+        return {\n+          width: 0,\n+          height: 0,\n+          getContext: function() {\n+            return {\n+              clearRect: function() {},\n+              drawImage: function() {},\n+              restore: function() {}\n+            };\n+          }\n+        };\n+      }\n+      return {};\n+    }\n+  };\n+  global.window = {};\n+  global.HTMLCanvasElement = function() {};\n+  global.Image = function() { \n+    this.width = 256; \n+    this.height = 256; \n+  };\n+}\n+\n+function createMockFrameState(displayPixelRatio, size = [400, 300]) {\n+  const projection = getProjection('EPSG:3857');\n+  return {\n+    pixelRatio: displayPixelRatio,\n+    time: Date.now(),\n+    viewState: {\n+      center: [0, 0],\n+      projection: projection,\n+      resolution: 156543.03392804097,\n+      rotation: 0,\n+    },\n+    animate: false,\n+    coordinateToPixelTransform: [1, 0, 0, 1, 0, 0],\n+    extent: [-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244],\n+    index: 0,\n+    layerStatesArray: [{ opacity: 1 }],\n+    layerIndex: 0,\n+    pixelToCoordinateTransform: [1, 0, 0, 1, 0, 0],\n+    size: size,\n+    viewHints: [],\n+  };\n+}\n+\n+function testPixelRatioFix() {\n+  console.log('=== Verifying Pixel Ratio Memory Fix ===\\n');\n+\n+  const projection = getProjection('EPSG:3857');\n+  const extent = [-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244];\n+\n+  // Test case: HiDPI display (2x) with WMS image (1x pixel ratio)\n+  console.log('Test Case: HiDPI display (2x) with WMS image (1x pixel ratio)');\n+  \n+  const source = new ImageStatic({\n+    url: 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChAI9jU77zgAAAABJRU5ErkJggg==',\n+    imageExtent: extent,\n+    projection: projection\n+  });\n+\n+  const layer = new ImageLayer({ source: source });\n+  const renderer = new CanvasImageLayerRenderer(layer);\n+\n+  // Create frame state with display pixel ratio 2\n+  const frameState = createMockFrameState(2.0, [400, 300]);\n+\n+  // Create mock image with pixel ratio 1 (simulating WMS)\n+  const mockImage = new ImageWrapper(\n+    extent,\n+    156543.03392804097,\n+    1, // Image pixel ratio is 1 (WMS source)\n+    'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChAI9jU77zgAAAABJRU5ErkJggg==',\n+    null,\n+    (image, src) => { \n+      const img = image.getImage();\n+      img.width = 256;\n+      img.height = 256;\n+      img.src = src; \n+    }\n+  );\n+\n+  // Set the mock image\n+  renderer.image_ = mockImage;\n+\n+  // Mock the canvas and context\n+  const mockCanvas = document.createElement('canvas');\n+  const mockContext = mockCanvas.getContext('2d');\n+  renderer.context = mockContext;\n+  \n+  // Mock useContainer method\n+  renderer.useContainer = function() {\n+    // Mock implementation - do nothing\n+  };\n+\n+  // Mock other required methods\n+  renderer.preRender = function() {};\n+  renderer.postRender = function() {};\n+  renderer.getBackground = function() { return null; };\n+\n+  try {\n+    // Call renderFrame to test canvas sizing\n+    renderer.renderFrame(frameState, document.createElement('div'));\n+\n+    const canvasWidth = mockCanvas.width;\n+    const canvasHeight = mockCanvas.height;\n+    const mapSize = frameState.size;\n+    const displayPixelRatio = frameState.pixelRatio;\n+    const imagePixelRatio = mockImage.getPixelRatio();\n+\n+    console.log(`Display Pixel Ratio: ${displayPixelRatio}`);\n+    console.log(`Image Pixel Ratio: ${imagePixelRatio}`);\n+    console.log(`Map Size: ${mapSize[0]} x ${mapSize[1]}`);\n+    console.log(`Canvas Size: ${canvasWidth} x ${canvasHeight}`);\n+\n+    // Expected canvas size should be based on image pixel ratio (1x), not display pixel ratio (2x)\n+    const expectedWidth = mapSize[0] * imagePixelRatio; // 400 * 1 = 400\n+    const expectedHeight = mapSize[1] * imagePixelRatio; // 300 * 1 = 300\n+\n+    console.log(`Expected Canvas Size: ${expectedWidth} x ${expectedHeight}`);\n+\n+    // Memory calculation (4 bytes per pixel for RGBA)\n+    const expectedMemory = expectedWidth * expectedHeight * 4;\n+    const actualMemory = canvasWidth * canvasHeight * 4;\n+\n+    console.log(`Expected Memory: ${(expectedMemory / 1024).toFixed(1)} KB`);\n+    console.log(`Actual Memory: ${(actualMemory / 1024).toFixed(1)} KB`);\n+\n+    // Verify the fix\n+    if (canvasWidth === expectedWidth && canvasHeight === expectedHeight) {\n+      console.log('\u2705 SUCCESS: Canvas is correctly sized using image pixel ratio!');\n+      console.log('\u2705 Memory usage is now optimal');\n+      return true;\n+    } else {\n+      console.log('\u274c FAILURE: Canvas is still using display pixel ratio');\n+      console.log(`\u274c Expected: ${expectedWidth}x${expectedHeight}, Got: ${canvasWidth}x${canvasHeight}`);\n+      return false;\n+    }\n+\n+  } catch (error) {\n+    console.error('\u274c Error during test:', error.message);\n+    return false;\n+  }\n+}\n+\n+// Run the verification\n+const success = testPixelRatioFix();\n+process.exit(success ? 0 : 1);\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

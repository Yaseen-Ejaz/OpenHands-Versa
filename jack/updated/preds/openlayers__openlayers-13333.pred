6 14:13:12] \"GET /src/ol/style.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/Image.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/render/canvas/Instruction.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/TextPlacement.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/geom/flat/straightchunk.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/render/VectorContext.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/geom/flat/textpath.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/Icon.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/Text.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/IconImage.js HTTP/1.1\" 304 -\n+127.0.0.1 - - [04/Mar/2026 14:13:12] \"GET /src/ol/style/IconOrigin.js HTTP/1.1\" 304 -\ndiff --git a/src/ol/renderer/webgl/TileLayer.js b/src/ol/renderer/webgl/TileLayer.js\nindex ed48cc2a6..8f8bde609 100644\n--- a/src/ol/renderer/webgl/TileLayer.js\n+++ b/src/ol/renderer/webgl/TileLayer.js\n@@ -23,7 +23,7 @@ import {\n   getKey as getTileCoordKey,\n } from '../../tilecoord.js';\n import {fromUserExtent} from '../../proj.js';\n-import {getIntersection, isEmpty} from '../../extent.js';\n+import {getIntersection, intersects, isEmpty} from '../../extent.js';\n import {getUid} from '../../util.js';\n import {numberSafeCompareFunction} from '../../array.js';\n import {toSize} from '../../size.js';\n@@ -323,6 +323,13 @@ class WebGLTileLayerRenderer extends WebGLLayerRenderer {\n     for (let x = tileRange.minX; x <= tileRange.maxX; ++x) {\n       for (let y = tileRange.minY; y <= tileRange.maxY; ++y) {\n         const tileCoord = createTileCoord(z, x, y, this.tempTileCoord_);\n+\n+        // Check if this tile coordinate intersects with the render extent\n+        const tileExtent = tileGrid.getTileCoordExtent(tileCoord);\n+        if (!intersects(extent, tileExtent)) {\n+          continue;\n+        }\n+\n         const cacheKey = getCacheKey(tileSource, tileCoord);\n \n         /**\ndiff --git a/test_comprehensive_webgl.html b/test_comprehensive_webgl.html\nnew file mode 100644\nindex 000000000..e830be840\n--- /dev/null\n+++ b/test_comprehensive_webgl.html\n@@ -0,0 +1,101 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Comprehensive WebGL Tile Extent Test</title>\n+    <style>\n+        .map-container {\n+            display: flex;\n+            gap: 20px;\n+            margin: 20px;\n+        }\n+        .map {\n+            width: 300px;\n+            height: 200px;\n+            border: 2px solid #333;\n+        }\n+        .map-info {\n+            margin-bottom: 10px;\n+            font-weight: bold;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h2>Comprehensive WebGL Tile Extent Test</h2>\n+    <p>Testing WebGL tile rendering with different extent configurations.</p>\n+    \n+    <div class=\"map-container\">\n+        <div>\n+            <div class=\"map-info\">Map 1: No extent limit</div>\n+            <div id=\"map1\" class=\"map\"></div>\n+        </div>\n+        <div>\n+            <div class=\"map-info\">Map 2: Limited extent</div>\n+            <div id=\"map2\" class=\"map\"></div>\n+        </div>\n+        <div>\n+            <div class=\"map-info\">Map 3: Very small extent</div>\n+            <div id=\"map3\" class=\"map\"></div>\n+        </div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Map 1: No extent limit (should work normally)\n+        const map1 = new Map({\n+            target: 'map1',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new OSM()\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        // Map 2: Limited extent (should only show tiles within extent)\n+        const limitedExtent = [\n+            -1000000, 5000000, 2000000, 7000000\n+        ];\n+        const map2 = new Map({\n+            target: 'map2',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new OSM(),\n+                    extent: limitedExtent\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([0, 50]),\n+                zoom: 3\n+            })\n+        });\n+\n+        // Map 3: Very small extent (should show minimal tiles)\n+        const verySmallExtent = [\n+            500000, 6000000, 600000, 6100000\n+        ];\n+        const map3 = new Map({\n+            target: 'map3',\n+            layers: [\n+                new WebGLTileLayer({\n+                    source: new OSM(),\n+                    extent: verySmallExtent\n+                })\n+            ],\n+            view: new View({\n+                center: fromLonLat([0, 0]),\n+                zoom: 2\n+            })\n+        });\n+\n+        console.log('All maps created successfully');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_simple_webgl.html b/test_simple_webgl.html\nnew file mode 100644\nindex 000000000..9a26d84c3\n--- /dev/null\n+++ b/test_simple_webgl.html\n@@ -0,0 +1,49 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Simple WebGL Tile Test</title>\n+    <style>\n+        #map {\n+            width: 400px;\n+            height: 300px;\n+            border: 2px solid red;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h3>Simple WebGL Tile Test</h3>\n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+\n+        // Create a WebGL tile layer with a very limited extent\n+        // This extent is intentionally small to force tiles outside it\n+        const veryLimitedExtent = [\n+            1000000,  // min X \n+            6000000,  // min Y \n+            1100000,  // max X (very small area)\n+            6100000   // max Y \n+        ];\n+\n+        const webglLayer = new WebGLTileLayer({\n+            source: new OSM(),\n+            extent: veryLimitedExtent\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [webglLayer],\n+            view: new View({\n+                center: [0, 0], // Center outside the extent\n+                zoom: 2\n+            })\n+        });\n+\n+        console.log('Map created with very limited extent:', veryLimitedExtent);\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_webgl_extent_issue.html b/test_webgl_extent_issue.html\nnew file mode 100644\nindex 000000000..1b245daa2\n--- /dev/null\n+++ b/test_webgl_extent_issue.html\n@@ -0,0 +1,91 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>WebGL Tile Extent Issue Test</title>\n+    <style>\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        body {\n+            font-family: Arial, sans-serif;\n+            margin: 20px;\n+        }\n+        .info {\n+            margin-bottom: 10px;\n+            padding: 10px;\n+            background-color: #f0f0f0;\n+            border-radius: 4px;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <div class=\"info\">\n+        <h3>WebGL Tile Layer Extent Issue Test</h3>\n+        <p>This test demonstrates the issue where WebGL tiles render blue error images outside the original extent.</p>\n+        <p>Expected: Tiles should only render within the specified extent.</p>\n+        <p>Actual: Blue error tiles may appear outside the extent.</p>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import WebGLTileLayer from './src/ol/layer/WebGLTile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create a limited extent (roughly covering Europe)\n+        const limitedExtent = [\n+            -2000000, // min X (roughly -18 degrees longitude)\n+            4000000,  // min Y (roughly 30 degrees latitude)\n+            3000000,  // max X (roughly 27 degrees longitude)\n+            8000000   // max Y (roughly 60 degrees latitude)\n+        ];\n+\n+        // Create a regular tile layer for comparison\n+        const regularTileLayer = new TileLayer({\n+            source: new OSM(),\n+            extent: limitedExtent,\n+            opacity: 0.5\n+        });\n+\n+        // Create a WebGL tile layer with limited extent\n+        const webglTileLayer = new WebGLTileLayer({\n+            source: new OSM(),\n+            extent: limitedExtent,\n+            style: {\n+                color: ['*', ['band', 1], [1, 1, 1, 1]]\n+            }\n+        });\n+\n+        const map = new Map({\n+            target: 'map',\n+            layers: [\n+                regularTileLayer,\n+                webglTileLayer\n+            ],\n+            view: new View({\n+                center: fromLonLat([10, 50]), // Center of Europe\n+                zoom: 4\n+            })\n+        });\n+\n+        // Add some debugging info\n+        console.log('Limited extent:', limitedExtent);\n+        console.log('Map created with WebGL tile layer');\n+        \n+        // Log when tiles are loaded\n+        webglTileLayer.getSource().on('tileloadend', function(event) {\n+            console.log('WebGL tile loaded:', event.tile.getTileCoord());\n+        });\n+        \n+        webglTileLayer.getSource().on('tileloaderror', function(event) {\n+            console.log('WebGL tile error:', event.tile.getTileCoord());\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "openlayers__openlayers-12962", "model_patch": "diff --git a/server.log b/server.log\nnew file mode 100644\nindex 000000000..19ee6d286\n--- /dev/null\n+++ b/server.log\n@@ -0,0 +1,17 @@\n+\n+> ol@6.9.1-dev serve-examples\n+> webpack serve --config examples/webpack/config.mjs --mode development\n+\n+<i> [webpack-dev-server] Project is running at:\n+<i> [webpack-dev-server] Loopback: http://localhost:8080/\n+<i> [webpack-dev-server] Content not from webpack is served from '/workspace/openlayers__openlayers__/public' directory\n+Browserslist: caniuse-lite is outdated. Please run:\n+  npx browserslist@latest --update-db\n+  Why you should do it regularly: https://github.com/browserslist/browserslist#browsers-data-updating\n+Use of eval is strongly discouraged, as it poses security risks and may cause issues with minification\n+568 assets\n+798 modules\n+webpack 5.61.0 compiled successfully in 10556 ms\n+570 assets\n+798 modules\n+webpack 5.61.0 compiled successfully in 972 ms\ndiff --git a/src/ol/renderer/canvas/Layer.js b/src/ol/renderer/canvas/Layer.js\nindex 6edcbe459..91d66baf9 100644\n--- a/src/ol/renderer/canvas/Layer.js\n+++ b/src/ol/renderer/canvas/Layer.js\n@@ -96,7 +96,8 @@ class CanvasLayerRenderer extends LayerRenderer {\n     if (\n       target &&\n       target.style.opacity === cssOpacity(opacity) &&\n-      target.className === layerClassName\n+      target.className === layerClassName &&\n+      target === this.container\n     ) {\n       const canvas = target.firstElementChild;\n       if (canvas instanceof HTMLCanvasElement) {\ndiff --git a/test_opacity_fix.html b/test_opacity_fix.html\nnew file mode 100644\nindex 000000000..085907861\n--- /dev/null\n+++ b/test_opacity_fix.html\n@@ -0,0 +1,50 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Opacity Fix Test</title>\n+    <style>\n+        body {\n+            margin: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #console {\n+            background: #f0f0f0;\n+            padding: 10px;\n+            margin: 20px 0;\n+            border: 1px solid #ccc;\n+            height: 300px;\n+            overflow-y: auto;\n+            font-family: monospace;\n+            white-space: pre-wrap;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Layer Opacity Container Reuse Fix Test</h1>\n+    <p>This test verifies that the fix for layer opacity stacking issues works correctly.</p>\n+    \n+    <div id=\"console\"></div>\n+    \n+    <script type=\"module\">\n+        // Override console.log to display in our div\n+        const consoleDiv = document.getElementById('console');\n+        const originalLog = console.log;\n+        const originalError = console.error;\n+        \n+        console.log = function(...args) {\n+            originalLog.apply(console, args);\n+            consoleDiv.textContent += args.join(' ') + '\\n';\n+            consoleDiv.scrollTop = consoleDiv.scrollHeight;\n+        };\n+        \n+        console.error = function(...args) {\n+            originalError.apply(console, args);\n+            consoleDiv.textContent += 'ERROR: ' + args.join(' ') + '\\n';\n+            consoleDiv.scrollTop = consoleDiv.scrollHeight;\n+        };\n+        \n+        // Import and run the test\n+        import('./test_opacity_fix.js');\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file\ndiff --git a/test_opacity_fix.js b/test_opacity_fix.js\nnew file mode 100644\nindex 000000000..082d534f8\n--- /dev/null\n+++ b/test_opacity_fix.js\n@@ -0,0 +1,129 @@\n+/**\n+ * Test for layer opacity stacking issue fix\n+ * This test verifies that multiple layers with identical opacity values\n+ * do not incorrectly reuse containers.\n+ */\n+\n+import Map from './src/ol/Map.js';\n+import View from './src/ol/View.js';\n+import TileLayer from './src/ol/layer/Tile.js';\n+import OSM from './src/ol/source/OSM.js';\n+import TileArcGISRest from './src/ol/source/TileArcGISRest.js';\n+import {fromLonLat} from './src/ol/proj.js';\n+\n+// Test function to verify container reuse behavior\n+function testOpacityContainerReuse() {\n+  console.log('Testing opacity container reuse fix...');\n+  \n+  // Create a map container\n+  const mapDiv = document.createElement('div');\n+  mapDiv.id = 'test-map';\n+  mapDiv.style.width = '400px';\n+  mapDiv.style.height = '300px';\n+  document.body.appendChild(mapDiv);\n+\n+  // Create basemap\n+  const basemap = new TileLayer({\n+    source: new OSM()\n+  });\n+\n+  // Create three layers with identical opacity\n+  const layer1 = new TileLayer({\n+    source: new OSM(), // Using OSM for simplicity in testing\n+    opacity: 0.5\n+  });\n+\n+  const layer2 = new TileLayer({\n+    source: new OSM(),\n+    opacity: 0.5\n+  });\n+\n+  const layer3 = new TileLayer({\n+    source: new OSM(),\n+    opacity: 0.5\n+  });\n+\n+  // Create map\n+  const map = new Map({\n+    target: 'test-map',\n+    layers: [basemap, layer1, layer2, layer3],\n+    view: new View({\n+      center: fromLonLat([0, 0]),\n+      zoom: 2\n+    })\n+  });\n+\n+  // Wait for initial render\n+  setTimeout(() => {\n+    console.log('Map rendered, checking layer containers...');\n+    \n+    // Get the layer renderers\n+    const layerRenderers = map.getRenderer().layerRenderers_;\n+    \n+    // Check that each layer has its own container\n+    const containers = [];\n+    let allContainersUnique = true;\n+    \n+    layerRenderers.forEach((renderer, index) => {\n+      if (renderer.container) {\n+        console.log(`Layer ${index} container:`, renderer.container);\n+        \n+        // Check if this container was already used by another layer\n+        if (containers.includes(renderer.container)) {\n+          console.error(`ERROR: Layer ${index} is reusing a container from another layer!`);\n+          allContainersUnique = false;\n+        } else {\n+          containers.push(renderer.container);\n+        }\n+      }\n+    });\n+    \n+    if (allContainersUnique) {\n+      console.log('\u2705 SUCCESS: All layers have unique containers');\n+    } else {\n+      console.log('\u274c FAILURE: Some layers are sharing containers');\n+    }\n+    \n+    // Test opacity changes\n+    console.log('Testing opacity changes...');\n+    layer1.setOpacity(0.6);\n+    layer2.setOpacity(0.5); // Keep same\n+    layer3.setOpacity(0.4);\n+    \n+    setTimeout(() => {\n+      console.log('Opacity changed, re-checking containers...');\n+      \n+      const newContainers = [];\n+      let stillUnique = true;\n+      \n+      layerRenderers.forEach((renderer, index) => {\n+        if (renderer.container) {\n+          if (newContainers.includes(renderer.container)) {\n+            console.error(`ERROR: After opacity change, Layer ${index} is reusing a container!`);\n+            stillUnique = false;\n+          } else {\n+            newContainers.push(renderer.container);\n+          }\n+        }\n+      });\n+      \n+      if (stillUnique) {\n+        console.log('\u2705 SUCCESS: After opacity changes, all layers still have unique containers');\n+      } else {\n+        console.log('\u274c FAILURE: After opacity changes, some layers are sharing containers');\n+      }\n+      \n+      // Clean up\n+      document.body.removeChild(mapDiv);\n+      console.log('Test completed');\n+    }, 1000);\n+    \n+  }, 2000);\n+}\n+\n+// Run the test when DOM is ready\n+if (document.readyState === 'loading') {\n+  document.addEventListener('DOMContentLoaded', testOpacityContainerReuse);\n+} else {\n+  testOpacityContainerReuse();\n+}\n\\ No newline at end of file\ndiff --git a/test_opacity_issue.html b/test_opacity_issue.html\nnew file mode 100644\nindex 000000000..9a8c2df3b\n--- /dev/null\n+++ b/test_opacity_issue.html\n@@ -0,0 +1,153 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Layer Opacity Stacking Issue Test</title>\n+    <style>\n+        body {\n+            margin: 0;\n+            padding: 20px;\n+            font-family: Arial, sans-serif;\n+        }\n+        #map {\n+            width: 800px;\n+            height: 600px;\n+            border: 1px solid #ccc;\n+        }\n+        .controls {\n+            margin: 20px 0;\n+        }\n+        .layer-control {\n+            margin: 10px 0;\n+            padding: 10px;\n+            border: 1px solid #ddd;\n+            background: #f9f9f9;\n+        }\n+        .opacity-display {\n+            font-weight: bold;\n+            color: #333;\n+        }\n+    </style>\n+</head>\n+<body>\n+    <h1>Layer Opacity Stacking Issue Test</h1>\n+    <p>This test reproduces the issue where multiple layers with identical opacity values cause the top-most layer to appear opaque.</p>\n+    \n+    <div class=\"controls\">\n+        <div class=\"layer-control\">\n+            <label>Layer 1 Opacity: <span id=\"opacity1-display\" class=\"opacity-display\">0.5</span></label>\n+            <input type=\"range\" id=\"opacity1\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\">\n+        </div>\n+        <div class=\"layer-control\">\n+            <label>Layer 2 Opacity: <span id=\"opacity2-display\" class=\"opacity-display\">0.5</span></label>\n+            <input type=\"range\" id=\"opacity2\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\">\n+        </div>\n+        <div class=\"layer-control\">\n+            <label>Layer 3 Opacity: <span id=\"opacity3-display\" class=\"opacity-display\">0.5</span></label>\n+            <input type=\"range\" id=\"opacity3\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\">\n+        </div>\n+        <button id=\"reset-identical\">Set All to 0.5 (Reproduce Issue)</button>\n+        <button id=\"reset-different\">Set Different Values (0.49, 0.50, 0.51)</button>\n+    </div>\n+    \n+    <div id=\"map\"></div>\n+    \n+    <div style=\"margin-top: 20px;\">\n+        <h3>Expected Behavior:</h3>\n+        <p>All three layers should be semi-transparent and blend together, allowing the basemap to show through.</p>\n+        <h3>Bug Behavior (6.8.0+):</h3>\n+        <p>When all layers have identical opacity (0.5), the top layer appears opaque relative to other layers.</p>\n+    </div>\n+\n+    <script type=\"module\">\n+        import Map from './src/ol/Map.js';\n+        import View from './src/ol/View.js';\n+        import TileLayer from './src/ol/layer/Tile.js';\n+        import OSM from './src/ol/source/OSM.js';\n+        import TileArcGISRest from './src/ol/source/TileArcGISRest.js';\n+        import {fromLonLat} from './src/ol/proj.js';\n+\n+        // Create basemap\n+        const basemap = new TileLayer({\n+            source: new OSM()\n+        });\n+\n+        // Create three ArcGIS REST tile layers with different colors/services\n+        const layer1 = new TileLayer({\n+            source: new TileArcGISRest({\n+                url: 'https://services.arcgisonline.com/ArcGIS/rest/services/USA_Topo_Maps/MapServer'\n+            }),\n+            opacity: 0.5\n+        });\n+\n+        const layer2 = new TileLayer({\n+            source: new TileArcGISRest({\n+                url: 'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer'\n+            }),\n+            opacity: 0.5\n+        });\n+\n+        const layer3 = new TileLayer({\n+            source: new TileArcGISRest({\n+                url: 'https://services.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer'\n+            }),\n+            opacity: 0.5\n+        });\n+\n+        // Create map\n+        const map = new Map({\n+            target: 'map',\n+            layers: [basemap, layer1, layer2, layer3],\n+            view: new View({\n+                center: fromLonLat([-74.0, 40.7]), // New York\n+                zoom: 10\n+            })\n+        });\n+\n+        // Control handlers\n+        const opacity1Slider = document.getElementById('opacity1');\n+        const opacity2Slider = document.getElementById('opacity2');\n+        const opacity3Slider = document.getElementById('opacity3');\n+        const opacity1Display = document.getElementById('opacity1-display');\n+        const opacity2Display = document.getElementById('opacity2-display');\n+        const opacity3Display = document.getElementById('opacity3-display');\n+\n+        function updateOpacity(layer, slider, display) {\n+            const value = parseFloat(slider.value);\n+            layer.setOpacity(value);\n+            display.textContent = value.toFixed(2);\n+        }\n+\n+        opacity1Slider.addEventListener('input', () => updateOpacity(layer1, opacity1Slider, opacity1Display));\n+        opacity2Slider.addEventListener('input', () => updateOpacity(layer2, opacity2Slider, opacity2Display));\n+        opacity3Slider.addEventListener('input', () => updateOpacity(layer3, opacity3Slider, opacity3Display));\n+\n+        document.getElementById('reset-identical').addEventListener('click', () => {\n+            [opacity1Slider, opacity2Slider, opacity3Slider].forEach(slider => {\n+                slider.value = '0.5';\n+                slider.dispatchEvent(new Event('input'));\n+            });\n+        });\n+\n+        document.getElementById('reset-different').addEventListener('click', () => {\n+            opacity1Slider.value = '0.49';\n+            opacity2Slider.value = '0.50';\n+            opacity3Slider.value = '0.51';\n+            [opacity1Slider, opacity2Slider, opacity3Slider].forEach(slider => {\n+                slider.dispatchEvent(new Event('input'));\n+            });\n+        });\n+\n+        // Log container reuse for debugging\n+        const originalUseContainer = map.getRenderer().layerRenderers_[1].useContainer;\n+        map.getRenderer().layerRenderers_.forEach((renderer, index) => {\n+            if (renderer.useContainer) {\n+                const originalMethod = renderer.useContainer;\n+                renderer.useContainer = function(target, transform, opacity) {\n+                    console.log(`Layer ${index} useContainer called with opacity: ${opacity}, cssOpacity: ${target ? target.style.opacity : 'no target'}`);\n+                    return originalMethod.call(this, target, transform, opacity);\n+                };\n+            }\n+        });\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

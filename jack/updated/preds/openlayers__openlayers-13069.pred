{"instance_id": "openlayers__openlayers-13069", "model_patch": "diff --git a/src/ol/source/GeoTIFF.js b/src/ol/source/GeoTIFF.js\nindex 88b81a665..d05068be7 100644\n--- a/src/ol/source/GeoTIFF.js\n+++ b/src/ol/source/GeoTIFF.js\n@@ -74,6 +74,7 @@ import {fromCode as unitsFromCode} from '../proj/Units.js';\n  * @property {function():number} getTileHeight Get the pixel height of image tiles.\n  * @property {function():number|null} getGDALNoData Get the nodata value (or null if none).\n  * @property {function():number} getSamplesPerPixel Get the number of samples per pixel.\n+ * @property {function(number=):Object|null} getGDALMetadata Get GDAL metadata for a specific band or all bands.\n  */\n \n let workerPool;\n@@ -451,6 +452,26 @@ class GeoTIFFSource extends DataTile {\n           : image.getSamplesPerPixel();\n         const level = imageCount - (imageIndex + 1);\n \n+        // Extract GDAL metadata for normalization if not already specified\n+        if (imageIndex === 0) { // Only extract from the first (highest resolution) image\n+          const sourceInfo = this.sourceInfo_[sourceIndex];\n+          if (sourceInfo.min === undefined || sourceInfo.max === undefined) {\n+            try {\n+              const metadata = image.getGDALMetadata(0);\n+              if (metadata) {\n+                if (sourceInfo.min === undefined && metadata.STATISTICS_MINIMUM) {\n+                  sourceInfo.min = parseFloat(metadata.STATISTICS_MINIMUM);\n+                }\n+                if (sourceInfo.max === undefined && metadata.STATISTICS_MAXIMUM) {\n+                  sourceInfo.max = parseFloat(metadata.STATISTICS_MAXIMUM);\n+                }\n+              }\n+            } catch (error) {\n+              // Ignore errors in metadata extraction, fall back to default behavior\n+            }\n+          }\n+        }\n+\n         if (!sourceExtent) {\n           sourceExtent = getBoundingBox(image);\n         }\ndiff --git a/test_gdal_metadata.html b/test_gdal_metadata.html\nnew file mode 100644\nindex 000000000..851c727d5\n--- /dev/null\n+++ b/test_gdal_metadata.html\n@@ -0,0 +1,162 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>GDAL Metadata Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        .console { background: #f0f0f0; padding: 10px; margin: 10px 0; border-radius: 5px; }\n+        button { padding: 10px 20px; margin: 5px; }\n+    </style>\n+</head>\n+<body>\n+    <h1>GDAL Metadata Test for GeoTIFF Normalization</h1>\n+    \n+    <button onclick=\"runTests()\">Run Tests</button>\n+    <button onclick=\"clearConsole()\">Clear Console</button>\n+    \n+    <div id=\"console\" class=\"console\">\n+        <strong>Console Output:</strong><br>\n+        <div id=\"output\"></div>\n+    </div>\n+\n+    <script type=\"module\">\n+        import GeoTIFFSource from './src/ol/source/GeoTIFF.js';\n+        import {fromUrl as tiffFromUrl} from 'geotiff';\n+\n+        const outputDiv = document.getElementById('output');\n+        \n+        // Override console.log to display in the page\n+        const originalLog = console.log;\n+        const originalError = console.error;\n+        \n+        console.log = function(...args) {\n+            originalLog.apply(console, args);\n+            outputDiv.innerHTML += args.join(' ') + '<br>';\n+        };\n+        \n+        console.error = function(...args) {\n+            originalError.apply(console, args);\n+            outputDiv.innerHTML += '<span style=\"color: red;\">ERROR: ' + args.join(' ') + '</span><br>';\n+        };\n+\n+        window.clearConsole = function() {\n+            outputDiv.innerHTML = '';\n+        };\n+\n+        // Test 1: Check if we can access getGDALMetadata method\n+        async function testGDALMetadataAccess() {\n+            console.log('=== Test 1: GDAL Metadata Access ===');\n+            \n+            try {\n+                // Use the existing test file\n+                const tiff = await tiffFromUrl('test/browser/spec/ol/source/images/0-0-0.tif');\n+                const image = await tiff.getImage(0);\n+                \n+                console.log('Image loaded successfully');\n+                console.log('Image has getGDALMetadata method:', typeof image.getGDALMetadata === 'function');\n+                \n+                if (typeof image.getGDALMetadata === 'function') {\n+                    const metadata = image.getGDALMetadata(0);\n+                    console.log('GDAL Metadata for band 0:', metadata);\n+                    \n+                    if (metadata) {\n+                        console.log('STATISTICS_MAXIMUM:', metadata.STATISTICS_MAXIMUM);\n+                        console.log('STATISTICS_MINIMUM:', metadata.STATISTICS_MINIMUM);\n+                        console.log('STATISTICS_MEAN:', metadata.STATISTICS_MEAN);\n+                        console.log('STATISTICS_STDDEV:', metadata.STATISTICS_STDDEV);\n+                    } else {\n+                        console.log('No GDAL metadata found in this test file');\n+                    }\n+                }\n+            } catch (error) {\n+                console.error('Error in testGDALMetadataAccess:', error);\n+            }\n+        }\n+\n+        // Test 2: Test current normalization behavior\n+        async function testCurrentNormalization() {\n+            console.log('=== Test 2: Current Normalization Behavior ===');\n+            \n+            try {\n+                const source = new GeoTIFFSource({\n+                    sources: [\n+                        {\n+                            url: 'test/browser/spec/ol/source/images/0-0-0.tif',\n+                            // Not specifying min/max to see current default behavior\n+                        },\n+                    ],\n+                });\n+                \n+                console.log('GeoTIFF source created');\n+                console.log('Normalize enabled:', source.normalize_);\n+                \n+                // Wait for source to be ready\n+                source.on('change', () => {\n+                    if (source.getState() === 'ready') {\n+                        console.log('Source is ready');\n+                        console.log('Source info:', source.sourceInfo_);\n+                        \n+                        // Try to get a tile to see normalization in action\n+                        const tile = source.getTile(0, 0, 0);\n+                        source.on('tileloadend', () => {\n+                            console.log('Tile loaded');\n+                            const data = tile.getData();\n+                            console.log('Data type:', data.constructor.name);\n+                            console.log('Data length:', data.length);\n+                            console.log('First few values:', Array.from(data.slice(0, 10)));\n+                        });\n+                        tile.load();\n+                    } else if (source.getState() === 'error') {\n+                        console.error('Source error:', source.getError());\n+                    }\n+                });\n+                \n+            } catch (error) {\n+                console.error('Error in testCurrentNormalization:', error);\n+            }\n+        }\n+\n+        // Test 3: Test with explicit min/max values\n+        async function testExplicitMinMax() {\n+            console.log('=== Test 3: Explicit Min/Max Values ===');\n+            \n+            try {\n+                const source = new GeoTIFFSource({\n+                    sources: [\n+                        {\n+                            url: 'test/browser/spec/ol/source/images/0-0-0.tif',\n+                            min: 50,\n+                            max: 200,\n+                        },\n+                    ],\n+                });\n+                \n+                console.log('GeoTIFF source created with explicit min/max');\n+                \n+                source.on('change', () => {\n+                    if (source.getState() === 'ready') {\n+                        console.log('Source is ready');\n+                        console.log('Source info min:', source.sourceInfo_[0].min);\n+                        console.log('Source info max:', source.sourceInfo_[0].max);\n+                    } else if (source.getState() === 'error') {\n+                        console.error('Source error:', source.getError());\n+                    }\n+                });\n+                \n+            } catch (error) {\n+                console.error('Error in testExplicitMinMax:', error);\n+            }\n+        }\n+\n+        // Run all tests\n+        window.runTests = async function() {\n+            clearConsole();\n+            await testGDALMetadataAccess();\n+            await new Promise(resolve => setTimeout(resolve, 1000)); // Wait a bit between tests\n+            await testCurrentNormalization();\n+            await new Promise(resolve => setTimeout(resolve, 1000));\n+            await testExplicitMinMax();\n+        };\n+    </script>\n+</body>\n+</html>\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

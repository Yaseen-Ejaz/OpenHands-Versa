{"instance_id": "bpmn-io__bpmn-js-1570", "model_patch": "diff --git a/test_viewport_jump.js b/test_viewport_jump.js\nnew file mode 100644\nindex 00000000..a47e028a\n--- /dev/null\n+++ b/test_viewport_jump.js\n@@ -0,0 +1,139 @@\n+/**\n+ * Test to reproduce the viewport jumping issue when wrapping a process in a pool\n+ */\n+\n+import {\n+  bootstrapModeler,\n+  inject\n+} from './test/TestHelper';\n+\n+import modelingModule from './lib/features/modeling';\n+import replaceModule from './lib/features/replace';\n+import coreModule from './lib/core';\n+\n+describe('Viewport Jump Issue - Pool Wrapping', function() {\n+\n+  var testModules = [\n+    coreModule,\n+    modelingModule,\n+    replaceModule\n+  ];\n+\n+  // Simple BPMN diagram with a process (no pool)\n+  var diagramXML = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_1\" targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:startEvent id=\"StartEvent_1\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:startEvent>\n+    <bpmn:task id=\"Task_1\" name=\"Task 1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"StartEvent_1\" targetRef=\"Task_1\" />\n+    <bpmn:sequenceFlow id=\"SequenceFlow_2\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n+        <dc:Bounds x=\"100\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"78\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"350\" y=\"100\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"136\" y=\"118\" />\n+        <di:waypoint x=\"200\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_2_di\" bpmnElement=\"SequenceFlow_2\">\n+        <di:waypoint x=\"300\" y=\"118\" />\n+        <di:waypoint x=\"350\" y=\"118\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+  beforeEach(bootstrapModeler(diagramXML, {\n+    modules: testModules\n+  }));\n+\n+  it('should reproduce viewport jump when wrapping process in pool', inject(function(canvas, elementRegistry, bpmnReplace, modeling) {\n+\n+    // given\n+    var rootElement = canvas.getRootElement();\n+    console.log('Root element:', rootElement);\n+    \n+    // Get initial viewport state\n+    var initialViewbox = canvas.viewbox();\n+    console.log('Initial viewbox:', initialViewbox);\n+    \n+    // Scroll to a specific position to make the jump more visible\n+    canvas.scroll({ dx: 100, dy: 50 });\n+    var scrolledViewbox = canvas.viewbox();\n+    console.log('Scrolled viewbox:', scrolledViewbox);\n+\n+    // when - wrap the process in a pool by creating a collaboration\n+    // This simulates the \"wrap in pool\" operation\n+    var collaboration = modeling.makeCollaboration();\n+    console.log('Created collaboration:', collaboration);\n+    \n+    // Get viewbox after wrapping\n+    var afterWrapViewbox = canvas.viewbox();\n+    console.log('After wrap viewbox:', afterWrapViewbox);\n+\n+    // then - check if viewport jumped\n+    var viewboxChanged = (\n+      Math.abs(afterWrapViewbox.x - scrolledViewbox.x) > 1 ||\n+      Math.abs(afterWrapViewbox.y - scrolledViewbox.y) > 1\n+    );\n+    \n+    console.log('Viewport changed:', viewboxChanged);\n+    console.log('X difference:', Math.abs(afterWrapViewbox.x - scrolledViewbox.x));\n+    console.log('Y difference:', Math.abs(afterWrapViewbox.y - scrolledViewbox.y));\n+\n+    // This test should fail initially, demonstrating the bug\n+    expect(viewboxChanged).to.be.false; // We expect no viewport change\n+  }));\n+\n+  it('should preserve viewport when replacing elements', inject(function(canvas, elementRegistry, bpmnReplace) {\n+\n+    // given\n+    var task = elementRegistry.get('Task_1');\n+    \n+    // Get initial viewport state\n+    var initialViewbox = canvas.viewbox();\n+    console.log('Initial viewbox before replace:', initialViewbox);\n+    \n+    // Scroll to a specific position\n+    canvas.scroll({ dx: 200, dy: 100 });\n+    var scrolledViewbox = canvas.viewbox();\n+    console.log('Scrolled viewbox before replace:', scrolledViewbox);\n+\n+    // when - replace task with user task (simple replacement)\n+    var newElement = bpmnReplace.replaceElement(task, {\n+      type: 'bpmn:UserTask'\n+    });\n+    \n+    // Get viewbox after replacement\n+    var afterReplaceViewbox = canvas.viewbox();\n+    console.log('After replace viewbox:', afterReplaceViewbox);\n+\n+    // then - check if viewport jumped\n+    var viewboxChanged = (\n+      Math.abs(afterReplaceViewbox.x - scrolledViewbox.x) > 1 ||\n+      Math.abs(afterReplaceViewbox.y - scrolledViewbox.y) > 1\n+    );\n+    \n+    console.log('Viewport changed after replace:', viewboxChanged);\n+\n+    // This should pass - simple replacements shouldn't cause viewport jumps\n+    expect(viewboxChanged).to.be.false;\n+  }));\n+\n+});\n\\ No newline at end of file", "model_name_or_path": "llm.claude4"}

{"instance_id": "bpmn-io__bpmn-js-1172", "model_patch": "diff --git a/lib/import/BpmnTreeWalker.js b/lib/import/BpmnTreeWalker.js\nindex 79aef1d9..06c18487 100644\n--- a/lib/import/BpmnTreeWalker.js\n+++ b/lib/import/BpmnTreeWalker.js\n@@ -356,8 +356,18 @@ export default function BpmnTreeWalker(handler, translate) {\n     visitIfDi(dataObject, context);\n   }\n \n-  function handleBoundaryEvent(dataObject, context) {\n-    visitIfDi(dataObject, context);\n+  function handleBoundaryEvent(boundaryEvent, context) {\n+    visitIfDi(boundaryEvent, context);\n+\n+    // defer handling of associations\n+    // affected types:\n+    //\n+    //   * bpmn:BoundaryEvent (inherits from bpmn:CatchEvent)\n+    //\n+    deferred.push(function() {\n+      forEach(boundaryEvent.dataInputAssociations, contextual(handleDataAssociation, context));\n+      forEach(boundaryEvent.dataOutputAssociations, contextual(handleDataAssociation, context));\n+    });\n   }\n \n   function handleLane(lane, context) {\ndiff --git a/test/spec/import/elements/BoundaryEventAssociationSpec.js b/test/spec/import/elements/BoundaryEventAssociationSpec.js\nnew file mode 100644\nindex 00000000..92b6efa9\n--- /dev/null\n+++ b/test/spec/import/elements/BoundaryEventAssociationSpec.js\n@@ -0,0 +1,126 @@\n+import {\n+  bootstrapViewer,\n+  inject\n+} from 'test/TestHelper';\n+\n+describe('import - boundary event associations', function() {\n+\n+  it('should import boundary event association with data object', function(done) {\n+\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+    <bpmn:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObject_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    // given\n+    bootstrapViewer(xml)(function(err) {\n+\n+      // when\n+      inject(function(elementRegistry) {\n+\n+        var association = elementRegistry.get('Association_1');\n+        var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+        var dataObject = elementRegistry.get('DataObject_1');\n+\n+        // then\n+        expect(boundaryEvent).to.exist;\n+        expect(dataObject).to.exist;\n+        expect(association).to.exist;\n+\n+        done(err);\n+      })();\n+\n+    });\n+  });\n+\n+  it('should import boundary event data associations', function(done) {\n+\n+    var xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:dataOutputAssociation id=\"DataOutputAssociation_1\">\n+        <bpmn:targetRef>DataObject_1</bpmn:targetRef>\n+      </bpmn:dataOutputAssociation>\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"DataOutputAssociation_1_di\" bpmnElement=\"DataOutputAssociation_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    // given\n+    bootstrapViewer(xml)(function(err) {\n+\n+      // when\n+      inject(function(elementRegistry) {\n+\n+        var dataAssociation = elementRegistry.get('DataOutputAssociation_1');\n+        var boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+        var dataObject = elementRegistry.get('DataObject_1');\n+\n+        // then\n+        expect(boundaryEvent).to.exist;\n+        expect(dataObject).to.exist;\n+        expect(dataAssociation).to.exist;\n+\n+        done(err);\n+      })();\n+\n+    });\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_boundary_association.js b/test_boundary_association.js\nnew file mode 100644\nindex 00000000..2982e226\n--- /dev/null\n+++ b/test_boundary_association.js\n@@ -0,0 +1,167 @@\n+/**\n+ * Test to reproduce the boundary event association issue\n+ */\n+\n+import BpmnModeler from './lib/Modeler';\n+import { expect } from 'chai';\n+\n+describe('Boundary Event Association Issue', function() {\n+\n+  let modeler;\n+\n+  beforeEach(function() {\n+    modeler = new BpmnModeler({\n+      container: document.createElement('div')\n+    });\n+  });\n+\n+  afterEach(function() {\n+    modeler.destroy();\n+  });\n+\n+  it('should render boundary event associations on import', function(done) {\n+    \n+    // BPMN XML with a boundary event that has an association to a data object\n+    const bpmnXml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\">\n+      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>\n+    </bpmn:task>\n+    <bpmn:endEvent id=\"EndEvent_1\">\n+      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>\n+    </bpmn:endEvent>\n+    <bpmn:sequenceFlow id=\"SequenceFlow_1\" sourceRef=\"Task_1\" targetRef=\"EndEvent_1\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+    <bpmn:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObject_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"EndEvent_1_di\" bpmnElement=\"EndEvent_1\">\n+        <dc:Bounds x=\"400\" y=\"118\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"SequenceFlow_1_di\" bpmnElement=\"SequenceFlow_1\">\n+        <di:waypoint x=\"300\" y=\"140\" />\n+        <di:waypoint x=\"400\" y=\"136\" />\n+      </bpmndi:BPMNEdge>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    modeler.importXML(bpmnXml, function(err) {\n+      if (err) {\n+        return done(err);\n+      }\n+\n+      const elementRegistry = modeler.get('elementRegistry');\n+      const canvas = modeler.get('canvas');\n+\n+      // Check that all elements are imported\n+      const task = elementRegistry.get('Task_1');\n+      const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+      const dataObject = elementRegistry.get('DataObject_1');\n+      const association = elementRegistry.get('Association_1');\n+\n+      expect(task).to.exist;\n+      expect(boundaryEvent).to.exist;\n+      expect(dataObject).to.exist;\n+      \n+      // This should exist but currently fails due to the bug\n+      expect(association, 'Association should be imported and rendered').to.exist;\n+\n+      // Check that the association is visually rendered\n+      if (association) {\n+        const associationGfx = canvas.getGraphics(association);\n+        expect(associationGfx, 'Association should have graphics/visual representation').to.exist;\n+      }\n+\n+      done();\n+    });\n+  });\n+\n+  it('should handle boundary event data associations during import', function(done) {\n+    \n+    // Test with data input/output associations on boundary events\n+    const bpmnXml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:dataOutputAssociation id=\"DataOutputAssociation_1\">\n+        <bpmn:targetRef>DataObject_1</bpmn:targetRef>\n+      </bpmn:dataOutputAssociation>\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"DataOutputAssociation_1_di\" bpmnElement=\"DataOutputAssociation_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+    modeler.importXML(bpmnXml, function(err) {\n+      if (err) {\n+        return done(err);\n+      }\n+\n+      const elementRegistry = modeler.get('elementRegistry');\n+      const canvas = modeler.get('canvas');\n+\n+      // Check that all elements are imported\n+      const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+      const dataObject = elementRegistry.get('DataObject_1');\n+      const dataAssociation = elementRegistry.get('DataOutputAssociation_1');\n+\n+      expect(boundaryEvent).to.exist;\n+      expect(dataObject).to.exist;\n+      \n+      // This should exist but currently fails due to the bug\n+      expect(dataAssociation, 'Data association should be imported and rendered').to.exist;\n+\n+      done();\n+    });\n+  });\n+\n+});\n\\ No newline at end of file\ndiff --git a/test_boundary_fix.html b/test_boundary_fix.html\nnew file mode 100644\nindex 00000000..249bcc8e\n--- /dev/null\n+++ b/test_boundary_fix.html\n@@ -0,0 +1,174 @@\n+<!DOCTYPE html>\n+<html>\n+<head>\n+    <title>Boundary Event Association Test</title>\n+    <style>\n+        body { font-family: Arial, sans-serif; margin: 20px; }\n+        #canvas { border: 1px solid #ccc; height: 400px; width: 800px; }\n+        .test-section { margin: 20px 0; }\n+        button { margin: 5px; padding: 10px; }\n+        .result { margin: 10px 0; padding: 10px; border-radius: 4px; }\n+        .success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }\n+        .error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }\n+    </style>\n+</head>\n+<body>\n+    <h1>Boundary Event Association Test</h1>\n+    \n+    <div class=\"test-section\">\n+        <h2>Test 1: Boundary Event with Regular Association</h2>\n+        <button onclick=\"testRegularAssociation()\">Load Test 1</button>\n+        <div id=\"result1\" class=\"result\"></div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <h2>Test 2: Boundary Event with Data Association</h2>\n+        <button onclick=\"testDataAssociation()\">Load Test 2</button>\n+        <div id=\"result2\" class=\"result\"></div>\n+    </div>\n+\n+    <div class=\"test-section\">\n+        <h2>Visual Canvas</h2>\n+        <div id=\"canvas\"></div>\n+    </div>\n+\n+    <script src=\"dist/bpmn-modeler.development.js\"></script>\n+    <script>\n+        const modeler = new BpmnJS({\n+            container: '#canvas'\n+        });\n+\n+        function testRegularAssociation() {\n+            const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+    <bpmn:association id=\"Association_1\" sourceRef=\"BoundaryEvent_1\" targetRef=\"DataObject_1\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"Association_1_di\" bpmnElement=\"Association_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+            modeler.importXML(xml, function(err) {\n+                const resultDiv = document.getElementById('result1');\n+                if (err) {\n+                    resultDiv.className = 'result error';\n+                    resultDiv.innerHTML = 'Error: ' + err.message;\n+                    return;\n+                }\n+\n+                const elementRegistry = modeler.get('elementRegistry');\n+                const association = elementRegistry.get('Association_1');\n+                const boundaryEvent = elementRegistry.get('BoundaryEvent_1');\n+                const dataObject = elementRegistry.get('DataObject_1');\n+\n+                if (association && boundaryEvent && dataObject) {\n+                    resultDiv.className = 'result success';\n+                    resultDiv.innerHTML = 'SUCCESS: All elements imported correctly!<br>' +\n+                        'Boundary Event: ' + (boundaryEvent ? '\u2713' : '\u2717') + '<br>' +\n+                        'Data Object: ' + (dataObject ? '\u2713' : '\u2717') + '<br>' +\n+                        'Association: ' + (association ? '\u2713' : '\u2717');\n+                } else {\n+                    resultDiv.className = 'result error';\n+                    resultDiv.innerHTML = 'FAILURE: Missing elements<br>' +\n+                        'Boundary Event: ' + (boundaryEvent ? '\u2713' : '\u2717') + '<br>' +\n+                        'Data Object: ' + (dataObject ? '\u2713' : '\u2717') + '<br>' +\n+                        'Association: ' + (association ? '\u2713' : '\u2717');\n+                }\n+            });\n+        }\n+\n+        function testDataAssociation() {\n+            const xml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n+<bpmn:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" \n+                  xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" \n+                  xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" \n+                  xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" \n+                  xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" \n+                  id=\"Definitions_1\" \n+                  targetNamespace=\"http://bpmn.io/schema/bpmn\">\n+  <bpmn:process id=\"Process_1\" isExecutable=\"false\">\n+    <bpmn:task id=\"Task_1\" name=\"Test Task\" />\n+    <bpmn:boundaryEvent id=\"BoundaryEvent_1\" name=\"Signal Event\" attachedToRef=\"Task_1\">\n+      <bpmn:dataOutputAssociation id=\"DataOutputAssociation_1\">\n+        <bpmn:targetRef>DataObject_1</bpmn:targetRef>\n+      </bpmn:dataOutputAssociation>\n+      <bpmn:signalEventDefinition />\n+    </bpmn:boundaryEvent>\n+    <bpmn:dataObjectReference id=\"DataObject_1\" name=\"Test Data\" />\n+  </bpmn:process>\n+  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n+    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Process_1\">\n+      <bpmndi:BPMNShape id=\"Task_1_di\" bpmnElement=\"Task_1\">\n+        <dc:Bounds x=\"200\" y=\"100\" width=\"100\" height=\"80\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"BoundaryEvent_1_di\" bpmnElement=\"BoundaryEvent_1\">\n+        <dc:Bounds x=\"232\" y=\"162\" width=\"36\" height=\"36\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNShape id=\"DataObject_1_di\" bpmnElement=\"DataObject_1\">\n+        <dc:Bounds x=\"350\" y=\"250\" width=\"36\" height=\"50\" />\n+      </bpmndi:BPMNShape>\n+      <bpmndi:BPMNEdge id=\"DataOutputAssociation_1_di\" bpmnElement=\"DataOutputAssociation_1\">\n+        <di:waypoint x=\"268\" y=\"180\" />\n+        <di:waypoint x=\"350\" y=\"275\" />\n+      </bpmndi:BPMNEdge>\n+    </bpmndi:BPMNPlane>\n+  </bpmndi:BPMNDiagram>\n+</bpmn:definitions>`;\n+\n+            modeler.importXML(xml, function(err) {\n+                const resultDiv = document.getElementById('result2');\n+                if (err) {\n+                    resultDiv.className = 'result error';\n+                    resultDiv.innerHTML = 'Error: ' + err.message;\n+                    return;\n+                }\n+\n+                const elementRegistry = modeler.get('elementRegistry');\n+                const dataAssociation = elementRegistry.get('DataOutput